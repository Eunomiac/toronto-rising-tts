--[[
  Storyteller Dashboard live push (Global VM only).

  One-way messages to the dashboard server through the TTS Tools gateway (port 39998):
    { type = "dashboard", v = 1, topic = "pcSeat", color, json }  — slim seat snapshot (JSON string)
    { type = "dashboard", v = 1, topic = "projects" }             — project list changed; refetch
    { type = "dashboard", v = 1, topic = <world slice>, json }    — phase / scene / clock / soundscape / seats
    { type = "dashboard", v = 1, topic = "notice", json }         — `{ text }`: a refusal the Storyteller must see
                                                                    (TTS broadcasts hide behind the blindfold)
  Messages must stay flat: a nested table in sendExternalMessage never reaches the gateway, so
  payloads travel as a JSON string field.
  No handshake, session id or sequence number: the dashboard refetches its full snapshot on
  game load, and each message carries its whole seat or slice.

  `DashPush.seat` is the last step of `Sync.player`, so every per-seat mutation reaches the
  dashboard through the seat announcer. World slices are marked dirty from `UpdateUIDisplays`
  and a few bypass paths, then built and sent together after a short delay
  (`DashPush.markWorldDirty`). Unchanged payloads are not resent.
  Design: .dev/Storyteller Dashboard Docs/Live Push Channel.md
]]

local DashPush = {}

local C = require("lib.constants")
local U = require("lib.util")

--- Last sent encoded seat payload per color.
--- @type table<string, string>
local lastSeatPayload = {}

local warnedSendMissing = false

--- @param message table
--- @return boolean sent
local function send(message)
  ---@diagnostic disable-next-line: undefined-global
  if sendExternalMessage == nil then
    if not warnedSendMissing then
      warnedSendMissing = true
      print("[DashPush] sendExternalMessage is unavailable — Storyteller Dashboard live updates are off (TTS Tools extension not connected).")
    end
    return false
  end
  ---@diagnostic disable-next-line: undefined-global
  sendExternalMessage(message)
  return true
end

--- Push one PC seat's slim snapshot when it differs from the last one sent.
--- Storyteller and colors without a PC are ignored.
--- @param color string
function DashPush.seat(color)
  if not U.isIn(color, C.PlayerColors) then
    return
  end
  local pid = C.GetPlayerIDOrNil(color)
  if pid == nil or pid == C.StorytellerID then
    return
  end
  local data = require("dashboard.pc_sheet").slimSeatSnapshot(color)
  local encoded = JSON.encode(data)
  if lastSeatPayload[color] == encoded then
    require("lib.sync_trace").report("DashPush.seat", { color = color, outcome = "skipped" })
    return
  end
  if send({ type = "dashboard", v = 1, topic = "pcSeat", color = color, json = encoded }) then
    lastSeatPayload[color] = encoded
    require("lib.sync_trace").report("DashPush.seat", {
      color = color,
      bytes = tostring(#encoded),
      outcome = "sent",
    })
  end
end

--- Tell the dashboard the project list changed (it refetches projects on demand).
function DashPush.projects()
  send({ type = "dashboard", v = 1, topic = "projects" })
end

--- Show a refusal or failure on the dashboard (scene Play blocked by dice on the table, a transition that
--- failed under the blindfold). Callers still alert in TTS.
--- @param text string
function DashPush.notice(text)
  if type(text) ~= "string" or text == "" then
    error("DashPush.notice: text must be a non-empty string", 2)
  end
  send({ type = "dashboard", v = 1, topic = "notice", json = JSON.encode({ text = text }) })
end

--- Marks within this window share one flush, so a burst of syncs sends each slice at most once.
local WORLD_FLUSH_DELAY_SEC = 0.25

--- Last sent encoded payload per world slice.
--- @type table<string, string>
local lastWorldPayload = {}

--- @type table<string, boolean>
local dirtyWorld = {}

local worldFlushPending = false

local function elapsedMs(started)
  return math.floor((os.clock() - started) * 1000 + 0.5)
end

local function flushWorld()
  worldFlushPending = false
  local W = require("dashboard.world_snapshot")
  local Trace = require("lib.sync_trace")
  local dirty = dirtyWorld
  dirtyWorld = {}
  for _, slice in ipairs(W.SLICES) do
    if dirty[slice] == true then
      local buildStarted = os.clock()
      local snapshot = W.build(slice)
      local buildMs = elapsedMs(buildStarted)
      local encodeStarted = os.clock()
      local encoded = JSON.encode(snapshot)
      local encodeMs = elapsedMs(encodeStarted)
      if lastWorldPayload[slice] == encoded then
        Trace.report("DashPush.world", {
          slice = slice,
          buildMs = tostring(buildMs),
          encodeMs = tostring(encodeMs),
          bytes = tostring(#encoded),
          outcome = "skipped",
        })
      else
        local sendStarted = os.clock()
        local sent = send({ type = "dashboard", v = 1, topic = slice, json = encoded })
        local sendMs = elapsedMs(sendStarted)
        if sent then
          lastWorldPayload[slice] = encoded
        end
        Trace.report("DashPush.world", {
          slice = slice,
          buildMs = tostring(buildMs),
          encodeMs = tostring(encodeMs),
          sendMs = tostring(sendMs),
          bytes = tostring(#encoded),
          outcome = sent and "sent" or "send_unavailable",
        })
        if buildMs >= 250 or encodeMs >= 250 or sendMs >= 250 then
          print(string.format(
            "[DashPushSlow] %s build=%d ms encode=%d ms send=%d ms bytes=%d",
            slice,
            buildMs,
            encodeMs,
            sendMs,
            #encoded
          ))
        end
      end
    end
  end
end

--- Explicit diagnostic: measure one world slice's build and encode costs, then optionally send it.
--- Ordinary dashboard updates do not call this.
--- @param slice string
--- @param mode string|nil `build`, `encode`, or `send`
--- @return table
function DashPush.debugMeasureWorldSlice(slice, mode)
  local W = require("dashboard.world_snapshot")
  if not U.isIn(slice, W.SLICES) then
    error("DashPush.debugMeasureWorldSlice: unknown slice " .. tostring(slice), 2)
  end
  mode = tostring(mode or "encode")
  if mode ~= "build" and mode ~= "encode" and mode ~= "send" then
    error("DashPush.debugMeasureWorldSlice: mode must be build, encode, or send", 2)
  end
  local t0 = os.clock()
  local snapshot = W.build(slice)
  local t1 = os.clock()
  print(string.format(
    "[DashPushProbe] %s BUILD %d ms",
    slice,
    math.floor((t1 - t0) * 1000 + 0.5)
  ))
  if mode == "build" then
    return {
      slice = slice,
      buildMs = math.floor((t1 - t0) * 1000 + 0.5),
    }
  end
  local encoded = JSON.encode(snapshot)
  local t2 = os.clock()
  print(string.format(
    "[DashPushProbe] %s ENCODE %d ms, %d bytes",
    slice,
    math.floor((t2 - t1) * 1000 + 0.5),
    #encoded
  ))
  local sent = false
  local sendMs = 0
  if mode == "send" then
    local sendStarted = os.clock()
    sent = send({ type = "dashboard", v = 1, topic = slice, json = encoded })
    sendMs = math.floor((os.clock() - sendStarted) * 1000 + 0.5)
    print(string.format("[DashPushProbe] %s SEND %d ms, sent=%s", slice, sendMs, tostring(sent)))
  end
  return {
    slice = slice,
    buildMs = math.floor((t1 - t0) * 1000 + 0.5),
    encodeMs = math.floor((t2 - t1) * 1000 + 0.5),
    bytes = #encoded,
    sendMs = sendMs,
    sent = sent,
  }
end

--- Mark world slices for the next coalesced push. O(1) per slice; building, encoding and the
--- unchanged-payload check happen once in the flush.
--- @param slices table<string, boolean> set of slice names from `dashboard.world_snapshot` `SLICES`
function DashPush.markWorldDirty(slices)
  local W = require("dashboard.world_snapshot")
  for slice, on in pairs(slices) do
    if not U.isIn(slice, W.SLICES) then
      error("DashPush.markWorldDirty: unknown slice " .. tostring(slice), 2)
    end
    if on == true then
      dirtyWorld[slice] = true
    end
  end
  if worldFlushPending or next(dirtyWorld) == nil then
    return
  end
  worldFlushPending = true
  U.await(flushWorld, WORLD_FLUSH_DELAY_SEC)
end

--- Mark every world slice (game load, full UI refresh).
function DashPush.markAllWorldDirty()
  local W = require("dashboard.world_snapshot")
  local all = {}
  for _, slice in ipairs(W.SLICES) do
    all[slice] = true
  end
  DashPush.markWorldDirty(all)
end

return DashPush
