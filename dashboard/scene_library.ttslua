--[[
  Storyteller Dashboard scene library bridge (Global VM only).

  The dashboard keeps the master copy of the scene library (`data/scene-library.json`). TTS does not store
  that library. It plays a scene from the body in `playScene`, keeps the scene on the table, and hands
  back the live scene (and one departing snapshot) through `snapshot`. Old saves may still hold a `scenes`
  map until `ackImport`.

  - `snapshot(keys?)`  the live scene, a departing snapshot, and (until import) leftover save rows
                       (E2E fixture rows `e2e_*` are left out)
  - `upsert(cmd)`      checks a row TTS could play; a linked live scene only takes a new title
  - `setStatus(cmd)`   no-op except refusing End-via-status for the scene on the table
  - `remove(key)`      refuses deleting the scene on the table; otherwise no-op
  - `ackImport()`      drops a leftover save library after the dashboard has copied it
  - `ackWriteBack(key)` drops the departing snapshot after the dashboard has saved it

  Row contract: .dev/Storyteller Dashboard Docs/Scene Import Guide.md
  Design: .dev/Storyteller Dashboard Docs/Listening to TTS.md § Scene library
]]

local Lib = {}

local S = require("core.state")
local SceneLibrary = require("core.scene_library")

local KEY_PATTERN = "^[a-zA-Z][a-zA-Z0-9_]*$"

--- In-game library list and the dashboard's scene slice (`liveTitle`, `liveLinked`).
local function afterLibraryWrite()
  S.validateState()
  require("core.storyteller_scenes_panel").refresh()
  require("dashboard.push").markWorldDirty({ scene = true })
end

--- E2E playbook fixture rows (`e2e_*`, written straight into state by `DEBUG.ensureSceneLibraryStub`) stay in TTS:
--- the dashboard would otherwise merge them into its master library file.
--- @param key any
--- @return boolean
local function isTestRowKey(key)
  return type(key) == "string" and string.match(key, "^e2e_") ~= nil
end

--- @param key string
--- @param row table
--- @return table
local function publicRow(key, row)
  return {
    title = type(row.title) == "string" and row.title or key,
    placementMode = row.placementMode == "scatter" and "scatter" or "standard",
    receivesLiveWrites = row.receivesLiveWrites == true,
    status = SceneLibrary.STATUSES[row.status] and row.status or "ongoing",
    sessionScene = row.sessionScene,
  }
end

--- The scene on the table, in the same shape as a library row.
--- @return string|nil
--- @return table|nil
local function liveRow()
  if not SceneLibrary.hasLiveSceneOnTable() then
    return nil, nil
  end
  local key = S.getStateVal("sceneLibrary", "lastAppliedKey")
  if isTestRowKey(key) then
    return nil, nil
  end
  local live = S.getStateVal("sessionScene")
  if type(live) ~= "table" then
    return nil, nil
  end
  local PresentDayClock = require("core.present_day_clock")
  local sessionScene = PresentDayClock.cloneSessionSceneForLibraryMirror(live)
  if type(sessionScene) ~= "table" then
    return nil, nil
  end
  local title = S.getStateVal("sceneLibrary", "liveTitle")
  return key, publicRow(key, {
    title = type(title) == "string" and title ~= "" and title or key,
    placementMode = sessionScene.placementMode,
    receivesLiveWrites = S.getStateVal("sceneLibrary", "linked") == true,
    status = "ongoing",
    sessionScene = sessionScene,
  })
end

--- @param keys table|nil array of scene keys; nil for the live scene, a departing snapshot, and leftover save rows
--- @return table `{ order, liveKey, departedKey, legacy, scenes }`
function Lib.snapshot(keys)
  local out = {}
  local function put(key, row)
    if type(key) == "string" and not isTestRowKey(key) and type(row) == "table" and out[key] == nil then
      out[key] = row
    end
  end
  local liveKey, live = liveRow()
  local pending = S.getStateVal("sceneLibrary", "pendingWriteBack")
  local departedKey = type(pending) == "table" and type(pending.key) == "string" and pending.key or nil
  local want = nil
  if type(keys) == "table" then
    want = {}
    for _, key in ipairs(keys) do
      if type(key) == "string" then
        want[key] = true
      end
    end
  end
  local function wanted(key)
    return want == nil or want[key] == true
  end
  if liveKey ~= nil and wanted(liveKey) then
    put(liveKey, live)
  end
  if departedKey ~= nil and not isTestRowKey(departedKey) and wanted(departedKey) then
    put(departedKey, publicRow(departedKey, pending))
  end
  local legacy = SceneLibrary.legacyLibraryPending()
  local order = {}
  if legacy then
    local scenes = S.getStateVal("sceneLibrary", "scenes") or {}
    for _, key in ipairs(S.getStateVal("sceneLibrary", "order") or {}) do
      if type(key) == "string" and not isTestRowKey(key) and type(scenes[key]) == "table" then
        order[#order + 1] = key
        if wanted(key) then
          put(key, scenes[key])
        end
      end
    end
    for key, row in pairs(scenes) do
      if wanted(key) then
        put(key, row)
      end
    end
  end
  return {
    order = order,
    liveKey = liveKey,
    departedKey = not isTestRowKey(departedKey) and departedKey or nil,
    legacy = legacy,
    scenes = out,
  }
end

--- Checks a dashboard row. Does not store it. A linked scene on the table only takes a new title.
--- @param cmd table `{ key, title, placementMode, sessionScene }`
--- @return string|nil error
function Lib.upsert(cmd)
  local key = cmd.key
  if type(key) ~= "string" or string.match(key, KEY_PATTERN) == nil then
    return "upsertScene: the key must start with a letter and use only letters, digits and underscores."
  end
  local title = type(cmd.title) == "string" and string.gsub(string.gsub(cmd.title, "^%s+", ""), "%s+$", "") or ""
  if title == "" then
    return "upsertScene: the scene needs a title."
  end
  if SceneLibrary.resolveMirrorSceneKey() == key then
    S.setStateVal(title, "sceneLibrary", "liveTitle")
    afterLibraryWrite()
    return nil
  end
  if cmd.placementMode ~= "standard" and cmd.placementMode ~= "scatter" then
    return "upsertScene: placementMode must be standard or scatter."
  end
  if type(cmd.sessionScene) ~= "table" then
    return "upsertScene: sessionScene must be an object."
  end
  local rowErr = SceneLibrary.validateRow(cmd.placementMode, cmd.sessionScene)
  if rowErr ~= nil then
    return "upsertScene: " .. rowErr
  end
  if cmd.status ~= nil and not SceneLibrary.STATUSES[cmd.status] then
    return "upsertScene: unknown status `" .. tostring(cmd.status) .. "`."
  end
  return nil
end

--- Dashboard status edits (template choice, archive, ending a deck scene that is not on the table). Ending the
--- scene on the table goes through End Scene, which also clears the table.
--- @param cmd table `{ key, status }`
--- @return string|nil error
function Lib.setStatus(cmd)
  if cmd.status == "ended" and SceneLibrary.hasLiveSceneOnTable()
    and S.getStateVal("sceneLibrary", "lastAppliedKey") == cmd.key then
    return "setSceneStatus: that scene is on the table; use End Scene."
  end
  if SceneLibrary.legacyLibraryPending() then
    local err = SceneLibrary.setStatus(cmd.key, cmd.status)
    if err ~= nil then
      return "setSceneStatus: " .. err
    end
  end
  return nil
end

--- @param key string
--- @return string|nil error
function Lib.remove(key)
  if SceneLibrary.hasLiveSceneOnTable() and S.getStateVal("sceneLibrary", "lastAppliedKey") == key then
    return "That scene is on the table; end it before deleting it."
  end
  if SceneLibrary.legacyLibraryPending() and type(S.getStateVal("sceneLibrary", "scenes", key)) == "table" then
    local order = {}
    for _, k in ipairs(S.getStateVal("sceneLibrary", "order") or {}) do
      if k ~= key then
        order[#order + 1] = k
      end
    end
    S.setStateVal(order, "sceneLibrary", "order")
    S.setStateVal(nil, "sceneLibrary", "scenes", key)
    afterLibraryWrite()
  end
  return nil
end

--- The dashboard has copied any leftover save library. Further saves omit it.
function Lib.ackImport()
  S.setStateVal(true, "sceneLibrary", "legacyImported")
  S.setStateVal(nil, "sceneLibrary", "scenes")
  S.setStateVal(nil, "sceneLibrary", "order")
  return nil
end

--- The dashboard has saved the scene that left the table.
--- @param key string
function Lib.ackWriteBack(key)
  local pending = S.getStateVal("sceneLibrary", "pendingWriteBack")
  if type(pending) == "table" and pending.key == key then
    S.setStateVal(nil, "sceneLibrary", "pendingWriteBack")
    require("dashboard.push").markWorldDirty({ scene = true })
  end
  return nil
end

return Lib
