--[[
  Storyteller Dashboard Scenes tab commands (Global VM only).

  `Dash.apply(jsonText)` runs one op or an array of ops in order and stops at the first failure.
  Ops call the same mutation + sync entry points as the in-game HUD; the live push channel then
  carries the resulting world slices back to the dashboard, so replies are only `{ ok, error? }`.

  Ops (field `op`):
    phaseAdvance                          next top-level phase (Intermission → Play → Spotlight → End)
    playSubPhase      subPhase            Main / Downtime (leaving Memoriam restores the interrupted scene)
    memoriam          payload             enter Memoriam: { subjectKey, date, location, skyboxKey + panel
                                          or justSmoke, assignments } (same payload as the TTS modal)
    sessionNum        num                 session number (Intermission blindfold images follow)
    sessionName       name                session title
    spotlightRotate   delta               turn the carousel (Spotlight phase only)
    spotlightFront    color               bring that PC to the front
    realTime          running, speed?     live real-time clock on/off and narrative minutes per minute
    clockTo           datetime            animate the live scene clock to a datetime
    presentDay        datetime            set chronicle present day
    musicMood         mood                background music mood (`main` / `combat` / `intrigue`)
    musicSilent                           suppress background music
    locationMusic     key                 site background playlist (`casaLoma`, `gioEstate`, `gioCatacombs`)
    laneVolume        lane, volume        Storyteller lane volume 0..1
    featuredPlay      key                 featured track
    featuredStop                          stop featured, background resumes
    ambience          key                 location ambience (`none` stops it)
    stopAll                               silence every soundscape layer
    seatPresence      seat, present       narrative presence of an occupied seat (never disconnection); lighting
                                          a seated NPC's seat takes their copy off the stage
    location          districtKey?, siteKey   change the live location behind a blindfold
    skybox            key                 sky override (`none` = the site's own sky)
    topFog            on                  top fog on / off
    lighting          presetKey           `AdminDark` / `AdminStandard` / `AdminBright`
    table             key                 table layout (`Table A`, `Table B`, `Scatter`, …)
    conditions        ids                 scene conditions (`sessionScene.conditions`), hosted on present PCs
    weatherOverride   rain, wind, thunder hold weather until the next dawn (wind 0–3)
                      release             back to the schedule (or the scene's authored weather)
    stage             changes?, clear?, reset?
                                          stage NPCs: characterKey → { u, v, lightMode? } or { remove = true }
                                          (control-board u, v); `clear` empties the stage, `reset` starts from
                                          the table's library row. One op = one animated figurine move.
    scatterPlace      characterKey, kind, group?
                                          Scatter: move an NPC (`kind` npc; no group = off) or PC (`kind` pc,
                                          characterKey = the PC's charKey) into a scatter group 1–6
    genericAdd        keys, labels?       spawn generic NPCs (catalog keys) named by the Storyteller
    playScene         key, clockMode?     select a library scene and apply it to the table
    endScene                              end the live scene
    upsertScene       key, title, placementMode, sessionScene
                                          write a dashboard library row (`dashboard/scene_library.ttslua`)
    deleteScene       key                 delete a library row (not the scene on the table)
    unlinkScene                           stop live writes into the table's library row
    forkScene         newTitle, oldTitle? the table continues as a new row; the old row keeps a snapshot

  Several in-game entry points are Steam-gated to the Storyteller; ops that reach them pass the
  connected Storyteller player and fail when the Storyteller is not in the game.

  Design: .dev/Storyteller Dashboard Docs/Listening to TTS.md § Commands
]]

local Dash = {}

local C = require("lib.constants")
local U = require("lib.util")
local S = require("core.state")

--- @param payload table
--- @return string
local function encodeReply(payload)
  if JSON == nil or type(JSON.encode) ~= "function" then
    error("dashboard.scenes: JSON.encode unavailable")
  end
  return JSON.encode(payload)
end

--- @return any|nil player
local function storytellerPlayer()
  for _, p in ipairs(Player.getPlayers()) do
    if U.isStorytellerSteamPlayer(p) then
      return p
    end
  end
  return nil
end

--- @param ok boolean
--- @param message string|nil
--- @return string|nil error
local function soundResult(ok, message)
  local SS = require("core.soundscape")
  SS.commitEagerSteadyState(ok)
  UpdateUIDisplays({ soundscape = true })
  if not ok then
    return tostring(message or "Soundscape command failed.")
  end
  return nil
end

--- @param dt any
--- @return table|nil
local function datetimeArg(dt)
  if type(dt) ~= "table" then
    return nil
  end
  local out = {
    year = tonumber(dt.year),
    month = tonumber(dt.month),
    day = tonumber(dt.day),
    hour = tonumber(dt.hour),
    minute = tonumber(dt.minute),
  }
  if out.year == nil or out.month == nil or out.day == nil or out.hour == nil or out.minute == nil then
    return nil
  end
  return out
end

--- Hold rain / wind / thunder until the next dawn, or release back to the schedule (or the scene's own
--- authored weather).
--- @param cmd table `{ rain, wind, thunder }` or `{ release = true }`
--- @return string|nil error
local function weatherOverride(cmd)
  local ChronicleWeather = require("lib.chronicle_weather")
  if cmd.release == true then
    ChronicleWeather.clearOverride()
    if S.getStateVal("sessionScene", "chronicleWeatherManualHold") == true then
      require("core.scenes").applyActiveSceneSoundscapeFromSession()
      return nil
    end
  else
    local dawn = require("core.narrative_clock_lerp").resolveDawnDuskTarget(S.getStateVal("sessionScene", "clock"), 0, true)
    if dawn == nil then
      return "The scene clock has no date, so there is no dawn to hold the weather until."
    end
    local err = ChronicleWeather.setOverride(cmd.rain, cmd.wind, cmd.thunder == true, dawn)
    if err ~= nil then
      return err
    end
  end
  local ok, message = ChronicleWeather.applyScheduledWeather({ force = true })
  UpdateUIDisplays({ soundscape = true, gameStateOverlay = true })
  require("dashboard.push").markWorldDirty({ scene = true })
  if not ok then
    return tostring(message)
  end
  return nil
end

--- @param cmd table
--- @return string|nil error
local function applyCommand(cmd)
  local op = cmd.op

  if op == "phaseAdvance" then
    local Phases = require("core.phases")
    if Phases.isAdvancing() then
      return "A phase change is already running."
    end
    if Phases.advanceNext() ~= true then
      return "TTS refused the phase change (see the in-game Storyteller alert)."
    end
    return nil
  end
  if op == "playSubPhase" then
    -- Same routing as the in-game Main / Downtime buttons: leaving Memoriam restores the scene it interrupted.
    if cmd.subPhase == C.PlaySubPhases.MEMORIAM then
      return "Enter Memoriam with the Memoriam set-up (op `memoriam`)."
    end
    local Memoriam = require("core.memoriam")
    if Memoriam.isActive() then
      Memoriam.applyExit({ mode = "restore", player = storytellerPlayer() })
      return nil
    end
    if require("core.phases").setPlaySubPhase(cmd.subPhase) ~= true then
      return "Could not switch to subphase `" .. tostring(cmd.subPhase) .. "`."
    end
    return nil
  end
  if op == "memoriam" then
    if type(cmd.payload) ~= "table" then
      return "memoriam needs the set-up payload."
    end
    if require("core.memoriam").applyEnter(cmd.payload) ~= true then
      return "TTS refused the Memoriam (see the in-game Storyteller alert)."
    end
    return nil
  end

  if op == "spotlightRotate" then
    return require("core.spotlight").rotateBy(cmd.delta)
  end
  if op == "spotlightFront" then
    return require("core.spotlight").bringToFront(cmd.color)
  end

  if op == "realTime" then
    return require("core.storyteller_scenes_panel").setLiveRealTimeClock(cmd.running == true, tonumber(cmd.speed))
  end
  if op == "clockTo" then
    local dt = datetimeArg(cmd.datetime)
    if dt == nil then
      return "clockTo needs a full datetime."
    end
    local ok, err = require("core.narrative_clock_lerp").startToTarget(dt)
    if not ok then
      return tostring(err)
    end
    return nil
  end
  if op == "presentDay" then
    local dt = datetimeArg(cmd.datetime)
    if dt == nil then
      return "presentDay needs a full datetime."
    end
    local ok, err = require("core.present_day_clock").setPresentDay(dt)
    if not ok then
      return tostring(err)
    end
    UpdateUIDisplays({ gameStateOverlay = true })
    return nil
  end

  local SS = require("core.soundscape")
  if op == "musicMood" then
    return soundResult(SS.setMusicMood(cmd.mood))
  end
  if op == "musicSilent" then
    return soundResult(SS.setLocationMusic("none"))
  end
  if op == "locationMusic" then
    if type(cmd.key) ~= "string" or cmd.key == "none" then
      return "locationMusic needs a playlist key."
    end
    return soundResult(SS.setLocationMusic(cmd.key))
  end
  if op == "laneVolume" then
    local volume = tonumber(cmd.volume)
    if volume == nil then
      return "laneVolume needs a volume."
    end
    local ok, message = SS.setStorytellerLaneVolume(cmd.lane, math.max(0, math.min(1, volume)))
    UpdateUIDisplays({ soundscape = true })
    if not ok then
      return tostring(message)
    end
    return nil
  end
  if op == "featuredPlay" then
    local ok, message = SS.playFeaturedMusic(cmd.key)
    UpdateUIDisplays({ soundscape = true })
    if not ok then
      return tostring(message)
    end
    return nil
  end
  if op == "featuredStop" then
    local ok, message = SS.stopFeaturedMusic()
    UpdateUIDisplays({ soundscape = true })
    if not ok then
      return tostring(message)
    end
    return nil
  end
  if op == "ambience" then
    return soundResult(SS.setLocationAudio(type(cmd.key) == "string" and cmd.key or "none"))
  end
  if op == "stopAll" then
    return soundResult(SS.stopAll())
  end

  local Panel = require("core.storyteller_scenes_panel")
  if op == "seatPresence" then
    -- A seated NPC may stand on the stage only while their seat is dark: lighting the seat takes them off it.
    if cmd.present == true and U.isIn(cmd.seat, C.NPCSeats or {}) then
      local characterKey = S.getStateVal("seatLayout", "occupiedNPCSlots", cmd.seat)
      local placements = S.getStateVal("sessionScene", "npcWorld", "placements")
      if type(characterKey) == "string" and type(placements) == "table" and type(placements[characterKey]) == "table" then
        local err = require("core.npc_gameboard_apply").applyStageChanges({ [characterKey] = { remove = true } })
        if err then
          return err
        end
      end
    end
    return Panel.setLiveSeatPresence(cmd.seat, cmd.present == true)
  end
  if op == "location" then
    if type(cmd.siteKey) ~= "string" then
      return "location needs a siteKey."
    end
    return Panel.setLiveLocation(cmd.districtKey, cmd.siteKey)
  end
  if op == "skybox" then
    if cmd.key == "none" then
      return Panel.setLiveSkybox(nil)
    end
    return Panel.setLiveSkybox(cmd.key)
  end
  if op == "topFog" then
    Panel.setLiveTopFog(cmd.on == true)
    return nil
  end
  if op == "lighting" then
    return Panel.setLiveLighting(cmd.presetKey)
  end
  if op == "table" then
    return Panel.setLiveTable(cmd.key)
  end
  if op == "conditions" then
    return Panel.setLiveSceneConditions(cmd.ids)
  end
  if op == "weatherOverride" then
    return weatherOverride(cmd)
  end

  if op == "stage" then
    local opts = { clear = cmd.clear == true }
    if cmd.reset == true then
      local SceneLibrary = require("core.scene_library")
      local key = SceneLibrary.resolveMirrorSceneKey() or S.getStateVal("sceneLibrary", "lastAppliedKey")
      local row = type(key) == "string" and S.getStateVal("sceneLibrary", "scenes", key) or nil
      local session = type(row) == "table" and row.sessionScene or nil
      local npcWorld = type(session) == "table" and session.npcWorld or nil
      if type(npcWorld) ~= "table" then
        return "The scene on the table has no library row to reset the stage from."
      end
      opts.base = U.clone(type(npcWorld.placements) == "table" and npcWorld.placements or {}, true)
    end
    local err = require("core.npc_gameboard_apply").applyStageChanges(cmd.changes, opts)
    require("dashboard.push").markWorldDirty({ scene = true })
    return err
  end
  if op == "scatterPlace" then
    local ScatterMode = require("core.scatter_mode")
    if not ScatterMode.isActive() then
      return "Scatter is not on."
    end
    require("dashboard.push").markWorldDirty({ seats = true, scene = true })
    if cmd.kind == "pc" then
      if type(cmd.group) ~= "number" then
        return "A PC always stands in a scatter group; pick one."
      end
      ScatterMode.movePcToGroup(cmd.characterKey, cmd.group)
      return nil
    end
    return ScatterMode.moveNpcToGroup(cmd.characterKey, type(cmd.group) == "number" and cmd.group or nil)
  end
  if op == "genericAdd" then
    return require("core.generic_npcs").importNamed(cmd.keys, cmd.labels)
  end

  if op == "upsertScene" then
    return require("dashboard.scene_library").upsert(cmd)
  end
  if op == "deleteScene" then
    return require("dashboard.scene_library").remove(cmd.key)
  end
  if op == "unlinkScene" then
    local _, err = Panel.unlinkLiveMirror()
    require("dashboard.push").markWorldDirty({ scene = true })
    return err
  end
  if op == "forkScene" then
    local SceneLibrary = require("core.scene_library")
    if not SceneLibrary.hasLiveSceneOnTable() then
      return "There is no scene on the table to fork."
    end
    local source = SceneLibrary.resolveMirrorSceneKey() or S.getStateVal("sceneLibrary", "lastAppliedKey")
    local _, err = Panel.forkLiveScene(source, cmd.newTitle, cmd.oldTitle)
    require("dashboard.push").markWorldDirty({ scene = true })
    return err
  end

  if op == "sessionNum" or op == "sessionName" then
    local player = storytellerPlayer()
    if player == nil then
      return "The Storyteller must be in the game for this command."
    end
    if op == "sessionNum" then
      local n = math.floor(tonumber(cmd.num) or 0)
      if n < 1 then
        return "The session number must be 1 or more."
      end
      HUD_sessionNumInput(player, tostring(n), "dashboard")
    else
      HUD_sessionNameInput(player, type(cmd.name) == "string" and cmd.name or "", "dashboard")
    end
    return nil
  end

  if op == "playScene" or op == "endScene" then
    local player = storytellerPlayer()
    if player == nil then
      return "The Storyteller must be in the game for this command."
    end
    if op == "endScene" then
      Panel.endSceneNarrative(player)
      return nil
    end
    if type(cmd.key) ~= "string" or type(S.getStateVal("sceneLibrary", "scenes", cmd.key)) ~= "table" then
      return "No library scene `" .. tostring(cmd.key) .. "`."
    end
    S.setStateVal(cmd.key, "sceneLibrary", "activeKey")
    S.validateState()
    Panel.refresh()
    Panel.applyActiveLibraryScene(player, type(cmd.clockMode) == "string" and cmd.clockMode or "scene")
    return nil
  end

  return "Unknown op: " .. tostring(op)
end

--- @param jsonText string one op object or an array of ops
--- @return string JSON `{ ok = true }` or `{ ok = false, error = string }`
function Dash.apply(jsonText)
  if type(jsonText) ~= "string" or jsonText == "" then
    return encodeReply({ ok = false, error = "Expected command JSON" })
  end
  local parsed = JSON.decode(jsonText)
  if type(parsed) ~= "table" then
    return encodeReply({ ok = false, error = "Command JSON did not decode to a table" })
  end
  local list = type(parsed.op) == "string" and { parsed } or parsed
  if #list == 0 then
    return encodeReply({ ok = false, error = "Expected command JSON" })
  end
  for i = 1, #list do
    local err = applyCommand(list[i])
    if err ~= nil then
      return encodeReply({ ok = false, error = err, failedIndex = i })
    end
  end
  return encodeReply({ ok = true })
end

return Dash
