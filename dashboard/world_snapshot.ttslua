--[[
  Storyteller Dashboard world slices (Global VM only).

  Each builder returns one whole slice of live table state for a push topic. `DashPush` encodes
  them, skips unchanged ones, and sends the rest; `GlobalDashboardWorldSnapshot` returns all of
  them for a dashboard tab that opens mid-session. Builders only read state.

    phase       phase, Play subphase, session number/name, Memoriam active
    scene       live library scene (and its own location), location, table, lighting, skybox override,
                top fog, scene conditions, weather, Storyteller weather override
    clock       clock anchor: scene / present-day / Downtime clocks, which one runs, speed
    soundscape  music, location, featured, intro, weather layers, lane volumes
    seats       PC and NPC seat occupancy and presence, stage NPCs, generic NPCs in the scene, Scatter
                groups, spotlight carousel
    rolls       each PC's live roll (or the last resolved one held for broadcast), the three Storyteller
                drawer slots, the live Storyteller (NPC) roll with the actions its panel allows,
                Werewolf NPC keys, and the seats with an Oblivion-Rouse dice bag

  Design: .dev/Storyteller Dashboard Docs/Live Push Channel.md
]]

local W = {}

local C = require("lib.constants")
local S = require("core.state")

--- Push topics, in send order.
W.SLICES = { "phase", "scene", "clock", "soundscape", "seats", "rolls" }

--- @param clock table|nil
--- @return table|nil
local function clockDatetime(clock)
  if type(clock) ~= "table" then
    return nil
  end
  return {
    year = tonumber(clock.year),
    month = tonumber(clock.month),
    day = tonumber(clock.day),
    hour = tonumber(clock.hour),
    minute = tonumber(clock.minute),
  }
end

--- @param v any
--- @return number|nil
local function round2(v)
  local n = tonumber(v)
  if n == nil then
    return nil
  end
  return math.floor(n * 100 + 0.5) / 100
end

--- Board positions keep four places: two places can put a token half a slot off its snap on the dashboard's stage.
--- @param v any
--- @return number|nil
local function round4(v)
  local n = tonumber(v)
  if n == nil then
    return nil
  end
  return math.floor(n * 10000 + 0.5) / 10000
end

local function buildPhase()
  local memoriamSkyboxKey = nil
  if S.getStateVal("memoriam", "active") == true then
    local payload = S.getStateVal("memoriam", "payload")
    if type(payload) == "table" and type(payload.skyboxKey) == "string" and payload.skyboxKey ~= "" then
      memoriamSkyboxKey = payload.skyboxKey
    end
  end
  return {
    phase = S.getStateVal("currentPhase"),
    subPhase = S.getStateVal("playSubPhase"),
    sessionNum = tonumber(S.getStateVal("sessionNum")),
    sessionName = S.getStateVal("sessionName") or "",
    sessionStartDowntime = S.getStateVal("sessionStartDowntime") == true,
    memoriamActive = S.getStateVal("memoriam", "active") == true,
    memoriamSkyboxKey = memoriamSkyboxKey,
  }
end

local function buildScene()
  local SceneLibrary = require("core.scene_library")
  local liveKey = SceneLibrary.hasLiveSceneOnTable() and S.getStateVal("sceneLibrary", "lastAppliedKey") or nil
  local ss = S.getStateVal("sessionScene") or {}
  local snd = S.getStateVal("soundscape") or {}
  local override = require("lib.chronicle_weather").activeOverride()
  local conditions = {}
  for i, id in ipairs(type(ss.conditions) == "table" and ss.conditions or {}) do
    conditions[i] = id
  end
  -- Leaving a Memoriam returns to this scene when the interrupted bundle was kept.
  local memoriamReturnTitle = nil
  if S.getStateVal("memoriam", "active") == true and type(S.getStateVal("memoriam", "returnSessionScene")) == "table" then
    memoriamReturnTitle = S.getStateVal("memoriam", "returnTitle") or S.getStateVal("memoriam", "returnSceneKey")
  end
  local pending = S.getStateVal("sceneLibrary", "pendingWriteBack")
  local departedKey = type(pending) == "table" and type(pending.key) == "string" and pending.key or nil
  local authoredDistrict = S.getStateVal("sceneLibrary", "authoredDistrictKey")
  local authoredSite = S.getStateVal("sceneLibrary", "authoredSiteKey")
  return {
    liveKey = liveKey,
    liveTitle = type(liveKey) == "string" and S.getStateVal("sceneLibrary", "liveTitle") or nil,
    liveLinked = type(liveKey) == "string" and S.getStateVal("sceneLibrary", "linked") == true,
    departedKey = departedKey,
    memoriamReturnTitle = memoriamReturnTitle,
    library = (type(authoredDistrict) == "string" or type(authoredSite) == "string") and {
      districtKey = authoredDistrict,
      siteKey = authoredSite,
    } or nil,
    conditions = conditions,
    weatherOverride = override and {
      rain = override.rain,
      wind = override.wind,
      thunder = override.thunder == true,
      untilDatetime = clockDatetime(override.untilDatetime),
    } or nil,
    districtKey = ss.districtKey,
    siteKey = ss.siteKey,
    tableKey = ss.tableKey,
    placementMode = ss.placementMode,
    lightingPresetKey = ss.lightingPresetKey,
    skyboxOverride = ss.skyboxOverride,
    topFog = ss.isTopFogActive == true,
    weather = {
      weather = snd.weather,
      rain = snd.rain,
      wind = snd.wind,
      thunder = snd.thunderEnabled == true,
      indoors = snd.isIndoors == true,
    },
  }
end

local function buildClock()
  local Phases = require("core.phases")
  local downtime = Phases.isPlayDowntime() == true
  local sceneClock = S.getStateVal("sessionScene", "clock")
  local downtimeClock = S.getStateVal("downtimeClock")
  local active = downtime and downtimeClock or sceneClock
  local speed = 0
  local catchUp = false
  if type(active) == "table" then
    speed = tonumber(active.realTimeSpeed) or 1
    catchUp = active.catchUpToPresentDay == true
  end
  local running = type(active) == "table"
    and active.useRealTime == true
    and speed > 0
    and require("core.game_state_overlay").isTickerRunning() == true
  -- Night-block sun times and scheduled temperature for the running clock's date and hour; they only
  -- change at hour rollovers, which already re-push this slice.
  local now = clockDatetime(active)
  local dusk, dawn, temperatureC
  if now ~= nil and now.year ~= nil then
    local Lerp = require("core.narrative_clock_lerp")
    dusk = clockDatetime(Lerp.resolveDawnDuskTarget(now, 0, false))
    dawn = clockDatetime(Lerp.resolveDawnDuskTarget(now, 0, true))
    local resolved = require("lib.chronicle_weather").resolveForClock(now.month, now.day, now.hour)
    temperatureC = type(resolved) == "table" and tonumber(resolved.tempC) or nil
  end
  return {
    activeClock = downtime and "downtime" or "scene",
    running = running,
    speed = speed,
    catchUpToPresentDay = catchUp,
    isPresentDay = type(sceneClock) == "table" and sceneClock.isPresentDay == true,
    scene = clockDatetime(sceneClock),
    downtime = downtime and clockDatetime(downtimeClock) or nil,
    presentDay = clockDatetime(require("core.present_day_clock").getPresentDay()),
    dusk = dusk,
    dawn = dawn,
    temperatureC = temperatureC,
  }
end

local function buildSoundscape()
  local snd = S.getStateVal("soundscape") or {}
  local lanes = {}
  for _, row in ipairs(require("core.soundscape").getPlayingLanesForUi()) do
    lanes[#lanes + 1] = {
      id = row.id,
      volume = round2(row.appliedVolume),
      naturalVolume = round2(row.naturalVolume),
      ducked = row.isDucked == true,
      active = row.active == true,
    }
  end
  return {
    musicMode = snd.backgroundMusicMode,
    musicMood = snd.musicMood,
    musicEnabled = snd.backgroundMusicEnabled == true,
    musicSuppressed = snd.backgroundMusicSuppressed == true,
    locationMusic = snd.locationMusic,
    location = snd.location,
    siteSilent = snd.siteSilent == true,
    featuredKey = snd.featuredMusic,
    featuredActive = snd.featuredActive == true,
    sessionIntroKey = snd.sessionIntroKey,
    sessionIntroActive = snd.sessionIntroActive == true,
    lanes = lanes,
  }
end

--- @param seatKey string
--- @param row table|nil
--- @param isPc boolean
--- @return table
local function seatRow(seatKey, row, isPc)
  row = type(row) == "table" and row or {}
  local out = {
    seat = seatKey,
    kind = isPc and "pc" or "npc",
    tableSlot = tonumber(row.tableSlot),
    isPresent = row.isPresent ~= false,
  }
  if isPc then
    local pid = C.GetPlayerIDOrNil(seatKey)
    out.playerId = pid
    out.charKey = pid ~= nil and C.PlayerData[pid] ~= nil and C.PlayerData[pid].charKey or nil
    out.absentFromSession = row.absentFromSession == true
    out.playingNpcKey = row.isPlayingNPC == true and row.npcCharacterKey or nil
    out.signal = require("core.objects").GetSignalFireState(seatKey) == "on"
  else
    out.characterKey = row.slotEmpty ~= true and row.characterKey or nil
    out.slotEmpty = row.slotEmpty == true or row.characterKey == nil
  end
  return out
end

local function buildSeats()
  local slots = S.getStateVal("sessionScene", "seatSlots") or {}
  local seats = {}
  for _, color in ipairs(C.PlayerColors) do
    seats[#seats + 1] = seatRow(color, slots[color], true)
  end
  for _, seatKey in ipairs(C.NPCSeats) do
    seats[#seats + 1] = seatRow(seatKey, slots[seatKey], false)
  end
  local stage = {}
  local placements = S.getStateVal("sessionScene", "npcWorld", "placements") or {}
  for characterKey, p in pairs(placements) do
    if type(p) == "table" then
      stage[#stage + 1] = {
        characterKey = characterKey,
        u = round4(p.u),
        v = round4(p.v),
        lightMode = p.npcLightMode,
      }
    end
  end
  table.sort(stage, function(a, b)
    return tostring(a.characterKey) < tostring(b.characterKey)
  end)
  local generics = {}
  for key, row in pairs(S.getStateVal("sessionScene", "npcWorld", "genericMembership") or {}) do
    if type(row) == "table" then
      generics[#generics + 1] = { characterKey = key, name = row.displayName or key, tier = row.tier, keptId = row.keptId }
    end
  end
  table.sort(generics, function(a, b)
    return a.characterKey < b.characterKey
  end)
  local scatter = {}
  local pack = S.getStateVal("sessionScene", "scatterPlacements")
  if type(pack) == "table" then
    local ScatterLayout = require("lib.scatter_layout")
    for i = 1, ScatterLayout.groupCount() do
      local area = pack[ScatterLayout.areaKeyForGroup(i)]
      local pcs, npcs = {}, {}
      if type(area) == "table" then
        for pcKey, row in pairs(type(area.centerCharacters) == "table" and area.centerCharacters or {}) do
          pcs[#pcs + 1] = { characterKey = pcKey, slot = type(row) == "table" and tonumber(row.slot) or nil }
        end
        for npcKey, row in pairs(type(area.orbitCharacters) == "table" and area.orbitCharacters or {}) do
          npcs[#npcs + 1] = { characterKey = npcKey, slot = type(row) == "table" and tonumber(row.slot) or nil }
        end
      end
      local bySlot = function(a, b)
        return (a.slot or 99) < (b.slot or 99)
      end
      table.sort(pcs, bySlot)
      table.sort(npcs, bySlot)
      scatter[#scatter + 1] = { group = i, pcs = pcs, npcs = npcs }
    end
  end
  local spotlight = S.getStateVal("spotlight") or {}
  local NpcTrackers = require("core.npc_trackers")
  return {
    seats = seats,
    stage = stage,
    generics = generics,
    scatter = scatter,
    trackers = NpcTrackers.snapshotForKeys(NpcTrackers.sceneCastKeys()),
    spotlightOrder = spotlight.order or {},
    spotlightFrontIndex = tonumber(spotlight.frontIndex),
  }
end

local POOL_KINDS = { "normal", "hunger", "rouse", "oblivRouse", "bloodSurgeRouse", "werewolf", "rage" }

--- @param pool table|nil
--- @return table counts by die kind (zeros omitted)
local function poolCounts(pool)
  local normalized = require("lib.dice_kinds").normalizePool(pool)
  local out = {}
  for _, kind in ipairs(POOL_KINDS) do
    local n = tonumber(normalized[kind]) or 0
    if n > 0 then
      out[kind] = n
    end
  end
  return out
end

--- @param face table|nil one `diceFaces` row
--- @return string die kind
local function faceKind(face)
  local row = type(face) == "table" and face or {}
  return row.kind or (row.isHunger == true and "hunger" or "normal")
end

--- @param faces table|nil
--- @return table one row per die, in the roll's face order (the dashboard's reroll picks use that index)
local function diceRows(faces)
  local out = {}
  for i, face in ipairs(type(faces) == "table" and faces or {}) do
    local row = type(face) == "table" and face or {}
    out[i] = {
      value = tonumber(row.value),
      kind = faceKind(row),
    }
  end
  return out
end

--- A finished roll's pool, counted from its dice (history keeps the faces, not the pool).
--- @param faces table|nil
--- @return table counts by die kind
local function poolFromFaces(faces)
  local out = {}
  for _, face in ipairs(type(faces) == "table" and faces or {}) do
    local kind = faceKind(face)
    out[kind] = (out[kind] or 0) + 1
  end
  return out
end

--- A finished roll's difficulty, recovered from its history entry (successes − margin).
--- @param entry table roll history entry
--- @return number|nil
local function historyDifficulty(entry)
  local result = type(entry.result) == "table" and entry.result or nil
  local margin = result ~= nil and tonumber(result.margin) or nil
  local successes = result ~= nil and tonumber(result.successes) or nil
  return (margin ~= nil and successes ~= nil) and (successes - margin) or nil
end

--- @param roll table
--- @return table|nil
local function resultRow(roll)
  local result = roll.result
  if type(result) ~= "table" then
    return nil
  end
  return {
    resultClass = result.resultClass,
    successes = tonumber(result.successes),
    margin = tonumber(result.margin),
    text = require("core.roll_ui").resultText(roll.rollType, result, roll.difficulty),
  }
end

--- The player's last finished roll (already broadcast), with its result and dice from the roll history.
--- @param color string
--- @param snapshot table `storytellerRolls.pcDash[color]`
--- @return table roll-shaped record for pcRollRow
local function finishedPcRoll(color, snapshot)
  local entry = require("core.storyteller_rolls").findHistoryEntry(color, snapshot.rollId) or {}
  local finished = {}
  for key, value in pairs(snapshot) do
    finished[key] = value
  end
  finished.result = type(entry.result) == "table" and entry.result or nil
  finished.diceFaces = entry.diceFaces
  finished.difficulty = historyDifficulty(entry)
  return finished
end

--- @param color string
--- @param pid string|nil
--- @param roll table live active roll, or the player's last finished roll
--- @param done boolean true for the finished roll (only Broadcast again / Dismiss apply)
--- @return table
local function pcRollRow(color, pid, roll, done)
  local RUI = require("core.roll_ui")
  return {
    color = color,
    name = RUI.characterName(color),
    rollId = roll.id or roll.rollId,
    rollType = roll.rollType,
    phase = roll.phase,
    initiator = roll.initiator,
    label = roll.label,
    pool = poolCounts(roll.pool),
    difficulty = tonumber(roll.difficulty),
    conditions = pid ~= nil and RUI.formatEffectiveRollConditionLabels(pid, roll) or "",
    result = resultRow(roll),
    pending = roll.pendingResolution,
    wpReroll = type(roll.willpower) == "table" and roll.willpower.wpRerollWave == true or nil,
    done = done,
    canModifyPool = not done and require("core.roll_controller").canPostRollModifyPool(color, roll) == true,
    dice = diceRows(roll.diceFaces),
  }
end

local function buildRolls()
  local root = S.getStateVal("storytellerRolls") or {}
  local pcDash = type(root.pcDash) == "table" and root.pcDash or {}
  local pcs = {}
  for _, color in ipairs(C.PlayerColors) do
    local pid = S.getPlayerID(color)
    local active = pid ~= nil and S.getStateVal("playerData", pid, "hud", "rollData", "active") or nil
    if type(active) == "table" then
      pcs[#pcs + 1] = pcRollRow(color, pid, active, false)
    elseif type(pcDash[color]) == "table" then
      pcs[#pcs + 1] = pcRollRow(color, pid, finishedPcRoll(color, pcDash[color]), true)
    end
  end

  local slots = {}
  for i = 1, 3 do
    local slot = type(root.slots) == "table" and root.slots[i] or nil
    if type(slot) == "table" and slot.cleared ~= true then
      local row = {
        index = i,
        rollId = slot.rollId,
        label = slot.label,
        rollType = slot.rollType,
        phase = slot.confirmed == true and C.RollPhase.RESOLVED or slot.phase,
        live = root.liveSlotIndex == i,
        canBroadcast = slot.confirmed == true and type(slot.rollId) == "string" and slot.rollId ~= "",
        pendingBroadcast = slot.pendingBroadcast == true,
      }
      local entry = row.canBroadcast and require("core.storyteller_rolls").findHistoryEntry("Black", slot.rollId) or nil
      if type(entry) == "table" then
        local difficulty = historyDifficulty(entry)
        row.result = resultRow({ rollType = entry.rollType, result = entry.result, difficulty = difficulty })
        row.difficulty = difficulty
        row.dice = diceRows(entry.diceFaces)
        row.pool = poolFromFaces(entry.diceFaces)
      end
      slots[#slots + 1] = row
    end
  end

  local live = nil
  local blackPid = S.getPlayerID("Black")
  local active = blackPid ~= nil and S.getStateVal("playerData", blackPid, "hud", "rollData", "active") or nil
  if type(active) == "table" then
    local RUI = require("core.roll_ui")
    local meta = type(active.meta) == "table" and active.meta or {}
    live = {
      rollId = active.id,
      rollType = active.rollType,
      label = active.label,
      npcCharacterKey = active.npcCharacterKey,
      slot = tonumber(active.stDrawerSlot),
      phase = active.phase,
      hint = RUI.phaseHint(active, "Black"),
      wpReroll = type(active.willpower) == "table" and active.willpower.wpRerollWave == true or nil,
      pool = poolCounts(active.pool),
      difficulty = tonumber(active.difficulty),
      result = resultRow(active),
      dice = diceRows(active.diceFaces),
      actions = RUI.stRollPanelActions(active),
      secret = meta.secretDice == true,
      quiet = meta.suppressBroadcast == true,
      bloodSurge = meta.bloodSurgeActive == true,
    }
  end

  local DashRolls = require("dashboard.rolls")
  local werewolves = {}
  for key in pairs(DashRolls.werewolfKeys()) do
    werewolves[#werewolves + 1] = key
  end
  table.sort(werewolves)

  return {
    pcs = pcs,
    storyteller = {
      canInitiate = require("core.storyteller_rolls").canInitiate(),
      slots = slots,
      live = live,
    },
    werewolves = werewolves,
    oblivionSeats = DashRolls.oblivionSeats(),
  }
end

local BUILDERS = {
  phase = buildPhase,
  scene = buildScene,
  clock = buildClock,
  soundscape = buildSoundscape,
  seats = buildSeats,
  rolls = buildRolls,
}

--- @param slice string one of `W.SLICES`
--- @return table
function W.build(slice)
  local builder = BUILDERS[slice]
  if builder == nil then
    error("dashboard.world_snapshot: unknown slice " .. tostring(slice), 2)
  end
  return builder()
end

--- Every slice, keyed by topic name.
--- @return table<string, table>
function W.snapshot()
  local out = {}
  for _, slice in ipairs(W.SLICES) do
    out[slice] = W.build(slice)
  end
  return out
end

return W
