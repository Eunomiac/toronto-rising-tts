--[[
  Storyteller Dashboard PCs tab — Page 2 (disciplines, powers, rituals, ceremonies) and
  Page 3 (backgrounds, merits, flaws) apply ops plus the `projectStakes` snapshot field.
  Registered into dashboard.pc_sheet; every op returns nil on success or a plain-English error.
  Ops write state only — Dash.apply announces the seat (Sync.player) after the batch.
  Page 2 limits mirror lib/csheet_page2_xml.ttslua (it errors past them).
]]

local M = {}

local C = require("lib.constants")
local S = require("core.state")
local PSC = require("lib.pc_sheet_collect")
local PCAdv = require("lib.pc_advantages")
local Projects = require("core.projects")
local Portraits = require("lib.npc_portrait_assets")
local Coterie = require("core.coterie")
local CoterieHydrate = require("lib.coterie_hydrate")

function M.portraitOptions(owner)
  local out, seen = {}, {}
  local catalog = require("lib.unique_character_catalog")
  for _, assignments in pairs(Portraits) do
    local asset = assignments[owner]
    if asset and not seen[asset] then
      seen[asset] = true
      local key = asset:match("^npcPortrait_(.+)$")
      out[#out + 1] = { value = asset, label = catalog[key] and catalog[key].fullName or key }
    end
  end
  table.sort(out, function(a, b) return a.label < b.label end)
  return out
end

local MAX_DISCIPLINES = 6
local MAX_TITLE_DOTS = 6
local ADVANTAGE_CATEGORY = { backgrounds = true, merits = true, flaws = true }
local RITUAL_HOST = { rituals = "bloodSorcery", ceremonies = "oblivion" }
local RITUAL_HOST_LABEL = { rituals = "Blood Sorcery", ceremonies = "Oblivion" }

local function trim(value)
  if type(value) ~= "string" then
    return ""
  end
  return (value:gsub("^%s+", ""):gsub("%s+$", ""))
end

local function clampInt(value, lo, hi)
  local n = math.floor(tonumber(value) or lo)
  return math.max(lo, math.min(hi, n))
end

local function disciplines(pid)
  local discs = S.getStateVal("playerData", pid, "stats", "disciplines")
  if type(discs) ~= "table" then
    return nil
  end
  return discs
end

local function ownedCount(discs)
  local n = 0
  for key, row in pairs(discs or {}) do
    if PSC.DISCIPLINE_DOT_KEYS[key] == true and type(row) == "table" then
      n = n + 1
    end
  end
  return n
end

local function ownedRow(pid, key)
  local discs = disciplines(pid)
  local row = discs and discs[key] or nil
  if type(row) ~= "table" then
    return nil
  end
  return row
end

local function listCount(list)
  return type(list) == "table" and #list or 0
end

--- Page 2 holds 5 + 5 when both kinds exist, otherwise up to 10 of one kind.
local function validRitualCounts(rituals, ceremonies)
  if rituals > 0 and ceremonies > 0 then
    return rituals <= 5 and ceremonies <= 5
  end
  return rituals <= 10 and ceremonies <= 10
end

--- @return table|nil entry
--- @return string|nil err
local function powerFromCommand(raw, maxLevel)
  if type(raw) ~= "table" then
    return nil, "Missing entry"
  end
  local name = trim(raw.name)
  if name == "" then
    return nil, "Name is required"
  end
  return {
    name = name,
    level = clampInt(raw.level, 1, maxLevel),
    notes = trim(raw.notes),
  }, nil
end

--- Write `entry` at `index` (1-based) or append; keep any stored `source`.
local function upsertListEntry(list, index, entry)
  local idx = tonumber(index)
  if idx ~= nil then
    idx = math.floor(idx)
    local existing = list[idx]
    if type(existing) ~= "table" then
      return "That entry no longer exists — refresh and try again"
    end
    entry.source = existing.source
    list[idx] = entry
    return nil
  end
  list[#list + 1] = entry
  return nil
end

local function removeListEntry(list, index)
  local idx = math.floor(tonumber(index) or 0)
  if type(list) ~= "table" or idx < 1 or idx > #list then
    return "That entry no longer exists — refresh and try again"
  end
  table.remove(list, idx)
  return nil
end

local function stringLines(raw)
  local out = {}
  if type(raw) ~= "table" then
    return out
  end
  for i = 1, #raw do
    local line = raw[i]
    if type(line) == "string" and not line:match("^%s*$") then
      out[#out + 1] = line
    end
  end
  return out
end

--- Live advantage row addressed by category + 1-based index; `expectName` guards against
--- the list shifting under the dashboard (another edit landed first).
--- @return table|nil entry
--- @return string|nil err
local function advantageAt(pid, category, index, expectName)
  if ADVANTAGE_CATEGORY[category] ~= true then
    return nil, "Unknown advantage type"
  end
  local idx = math.floor(tonumber(index) or 0)
  local entry = PCAdv.getEntries(pid, category)[idx]
  if type(entry) ~= "table" then
    return nil, "That entry no longer exists — refresh and try again"
  end
  if type(expectName) == "string" and entry.name ~= expectName then
    return nil, "That entry changed in TTS — refresh and try again"
  end
  return entry, nil
end

--- Overlay the modal fields onto `base` (keeps fields the modal does not edit, e.g. `blank`, `active`).
--- @return table|nil entry
--- @return string|nil err
local function advantageFromCommand(raw, base, owner)
  if type(raw) ~= "table" then
    return nil, "Missing entry"
  end
  local name = trim(raw.name)
  if name == "" then
    return nil, "Name is required"
  end
  local entry = {}
  for k, v in pairs(base or {}) do
    entry[k] = v
  end
  entry.name = name
  entry.focus = trim(raw.focus)
  entry.max = clampInt(raw.max, 1, MAX_TITLE_DOTS)
  entry.base = clampInt(raw.base, 0, entry.max)
  entry.temp = clampInt(raw.temp, 0, MAX_TITLE_DOTS)
  entry.disabled = clampInt(raw.disabled, 0, MAX_TITLE_DOTS)
  entry.description = stringLines(raw.description)
  entry.rules = stringLines(raw.rules)
  local portrait = trim(raw.portrait)
  if portrait ~= "" then
    local assigned = false
    for _, option in ipairs(M.portraitOptions(owner)) do
      if option.value == portrait then assigned = true end
    end
    if not assigned then return nil, "That portrait is not assigned to this recipient in the character export. Run FULL after updating the sheet." end
  end
  entry.portrait = portrait ~= "" and portrait or nil
  if raw.sheetDisplay == false then
    entry.sheetDisplay = false
  else
    entry.sheetDisplay = nil
  end
  local source = raw.source
  local book = type(source) == "table" and trim(source.book) or ""
  local page = type(source) == "table" and math.floor(tonumber(source.page) or 0) or 0
  if book ~= "" or page > 0 then
    entry.source = { book = book, page = page }
  else
    entry.source = nil
  end
  return entry, nil
end

M.ops = {}

M.ops.disciplineAdd = function(color, pid, cmd)
  local key = cmd.key
  if PSC.DISCIPLINE_DOT_KEYS[key] ~= true then
    return "Unknown discipline"
  end
  local discs = disciplines(pid) or {}
  if type(discs[key]) == "table" then
    return "That discipline is already on the sheet"
  end
  if ownedCount(discs) >= MAX_DISCIPLINES then
    return "Page 2 holds at most 6 disciplines"
  end
  discs[key] = { base = 1, temp = 0, powers = {} }
  S.setStateVal(discs, "playerData", pid, "stats", "disciplines")
  return nil
end

M.ops.disciplineRemove = function(color, pid, cmd)
  local key = cmd.key
  if ownedRow(pid, key) == nil then
    return "That discipline is not on the sheet"
  end
  S.setStateVal(nil, "playerData", pid, "stats", "disciplines", key)
  return nil
end

M.ops.disciplinePowerUpsert = function(color, pid, cmd)
  local row = ownedRow(pid, cmd.key)
  if row == nil then
    return "That discipline is not on the sheet"
  end
  local entry, err = powerFromCommand(cmd.power, 5)
  if entry == nil then
    return err
  end
  if type(row.powers) ~= "table" then
    row.powers = {}
  end
  local writeErr = upsertListEntry(row.powers, cmd.index, entry)
  if writeErr ~= nil then
    return writeErr
  end
  S.setStateVal(row.powers, "playerData", pid, "stats", "disciplines", cmd.key, "powers")
  return nil
end

M.ops.disciplinePowerRemove = function(color, pid, cmd)
  local row = ownedRow(pid, cmd.key)
  if row == nil then
    return "That discipline is not on the sheet"
  end
  local err = removeListEntry(row.powers, cmd.index)
  if err ~= nil then
    return err
  end
  S.setStateVal(row.powers, "playerData", pid, "stats", "disciplines", cmd.key, "powers")
  return nil
end

M.ops.ritualUpsert = function(color, pid, cmd)
  local kind = cmd.kind
  local hostKey = RITUAL_HOST[kind]
  if hostKey == nil then
    return "Unknown ritual kind"
  end
  local row = ownedRow(pid, hostKey)
  if row == nil then
    return "Add " .. RITUAL_HOST_LABEL[kind] .. " to the sheet first"
  end
  local entry, err = powerFromCommand(cmd.entry, 5)
  if entry == nil then
    return err
  end
  if type(row[kind]) ~= "table" then
    row[kind] = {}
  end
  if tonumber(cmd.index) == nil then
    local rituals = listCount((ownedRow(pid, RITUAL_HOST.rituals) or {}).rituals)
    local ceremonies = listCount((ownedRow(pid, RITUAL_HOST.ceremonies) or {}).ceremonies)
    if kind == "rituals" then
      rituals = rituals + 1
    else
      ceremonies = ceremonies + 1
    end
    if not validRitualCounts(rituals, ceremonies) then
      return "Page 2 is full: it holds 10 rituals or ceremonies of one kind, or 5 of each"
    end
  end
  local writeErr = upsertListEntry(row[kind], cmd.index, entry)
  if writeErr ~= nil then
    return writeErr
  end
  S.setStateVal(row[kind], "playerData", pid, "stats", "disciplines", hostKey, kind)
  return nil
end

M.ops.ritualRemove = function(color, pid, cmd)
  local kind = cmd.kind
  local hostKey = RITUAL_HOST[kind]
  if hostKey == nil then
    return "Unknown ritual kind"
  end
  local row = ownedRow(pid, hostKey)
  if row == nil then
    return "Add " .. RITUAL_HOST_LABEL[kind] .. " to the sheet first"
  end
  local err = removeListEntry(row[kind], cmd.index)
  if err ~= nil then
    return err
  end
  S.setStateVal(row[kind], "playerData", pid, "stats", "disciplines", hostKey, kind)
  return nil
end

--- Add (no index) or edit (index + fromType) an advantage. Changing type moves the
--- entry from `fromType` to the end of `type`.
M.ops.advantageUpsert = function(color, pid, cmd)
  local category = cmd.type
  if ADVANTAGE_CATEGORY[category] ~= true then
    return "Unknown advantage type"
  end
  if tonumber(cmd.index) == nil then
    local entry, err = advantageFromCommand(cmd.entry, nil, C.PlayerData[pid].charKey)
    if entry == nil then
      return err
    end
    if PCAdv.addEntry(pid, category, entry) == nil then
      return "Could not add the advantage"
    end
    return nil
  end
  local fromType = type(cmd.fromType) == "string" and cmd.fromType or category
  local existing, findErr = advantageAt(pid, fromType, cmd.index, cmd.expectName)
  if existing == nil then
    return findErr
  end
  local entry, err = advantageFromCommand(cmd.entry, existing, C.PlayerData[pid].charKey)
  if entry == nil then
    return err
  end
  if fromType == category then
    PCAdv.setEntry(pid, category, cmd.index, entry)
  else
    PCAdv.deleteEntry(pid, fromType, cmd.index)
    PCAdv.addEntry(pid, category, entry)
  end
  return nil
end

M.ops.advantageDelete = function(color, pid, cmd)
  local existing, err = advantageAt(pid, cmd.type, cmd.index, cmd.expectName)
  if existing == nil then
    return err
  end
  PCAdv.deleteEntry(pid, cmd.type, cmd.index)
  return nil
end

M.ops.advantageDotDelta = function(color, pid, cmd)
  local existing, err = advantageAt(pid, cmd.type, cmd.index, cmd.expectName)
  if existing == nil then
    return err
  end
  local field = cmd.field
  if field ~= "base" and field ~= "temp" and field ~= "disabled" then
    return "Invalid advantage dot field"
  end
  local maxDots = clampInt(existing.max or MAX_TITLE_DOTS, 1, MAX_TITLE_DOTS)
  local nextVal = clampInt((tonumber(existing[field]) or 0) + (tonumber(cmd.delta) or 0), 0, maxDots)
  S.setStateVal(nextVal, "playerData", pid, "stats", cmd.type, math.floor(tonumber(cmd.index)), field)
  return nil
end

--- `projectStakes["<name>|<focus>"] = qty` for this PC's staked advantages (Page 3 `dot_project`).
function M.snapshotFields(_color, pid, _stats)
  local catalog = C.PlayerData[pid]
  local sourceKey = type(catalog) == "table" and catalog.charKey or nil
  local stakes = {}
  if type(sourceKey) ~= "string" or sourceKey == "" then
    return { projectStakes = stakes }
  end
  for category in pairs(ADVANTAGE_CATEGORY) do
    local rows = PCAdv.listVisibleEntries(pid, category)
    for i = 1, #rows do
      local entry = rows[i].entry
      local focus = type(entry.focus) == "string" and entry.focus or ""
      local qty = Projects.stakeQtyForAdvantage(sourceKey, entry.name, focus, nil)
      if qty > 0 then
        stakes[entry.name .. "|" .. focus] = qty
      end
    end
  end
  return { projectStakes = stakes, portraitOptions = M.portraitOptions(sourceKey) }
end

local function courtArrayKey(scope, category)
  if scope ~= "coterie" and scope ~= "domain" and scope ~= "haven" then return nil end
  if not ADVANTAGE_CATEGORY[category] then return nil end
  return scope .. category:sub(1, 1):upper() .. category:sub(2)
end

local function courtEntry(cmd)
  local key = courtArrayKey(cmd.scope, cmd.fromType or cmd.type)
  local index = tonumber(cmd.index)
  local entry = key and index and S.getStateVal("coterieData", key, index)
  if type(entry) ~= "table" or entry.active == false or (entry.blank == true and entry.active ~= true) or entry.name ~= cmd.expectName then
    return nil, nil, "That Court Advantage changed. Refresh and try again."
  end
  return entry, key
end

local function retireCourtEntry(key, index, existing)
  local empty = CoterieHydrate.makeBlankEntry()
  -- Hydration groups real rows before session slots. Preserve the group and index.
  empty.blank = existing.blank == true
  Coterie.setTraitEntry(key, index, empty)
end

M.ops.courtAdvantageUpsert = function(_color, _pid, cmd)
  local key = courtArrayKey(cmd.scope, cmd.type)
  if not key then return "Unknown Court Advantage section" end
  local existing, oldKey, err
  if cmd.index ~= nil then
    existing, oldKey, err = courtEntry(cmd)
    if not existing then return err end
  end
  local entry, entryErr = advantageFromCommand(cmd.entry, existing, "coterie")
  if not entry then return entryErr end
  if existing and key == oldKey then
    Coterie.setTraitEntry(key, cmd.index, entry)
  else
    if not Coterie.activateBlankEntry(key, entry) then return "No empty Court Advantage slots remain in this section." end
    if existing then retireCourtEntry(oldKey, cmd.index, existing) end
  end
  return nil
end

M.ops.courtAdvantageDelete = function(_color, _pid, cmd)
  local entry, key, err = courtEntry(cmd)
  if not entry then return err end
  -- Keep baked XML indices stable when a real entry is removed.
  retireCourtEntry(key, cmd.index, entry)
  return nil
end

return M
