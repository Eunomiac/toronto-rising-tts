<Defaults>

  <Panel class="complicationsDisplayContainer"
    width = "2000"
    height = "500"
    position="0 -30 -250"
    rotation="85 0 180"
    pivot="0.5 0.5"
    scale = "0.1 1 0.1"
  />

  <HorizontalLayout class="complicationsDisplay"
    height = "100%"
    width = "100%"
    padding = "325 475 0 0"
  />

  <Text class="complicationsDisplayText"
    fontSize = "220"
    fontStyle = "Bold"
    outline = "#000000"
    outlineSize = "5 -5"
  />
  <Text class="redText" color = "#FF0000" />
  <Text class="goldText" color = "#C5C799" />
  <Text class="bigText" fontSize = "325" />

  <HorizontalLayout class="controlsPanel"
    visibility="Black"
    height = "100"
    width = "2500"
    color = "#00FF00"
    position="0 105 -25"
    rotation="0 0 180"
    pivot="0.5 0.5"
    scale = "0.1 0.1 0.1"
  />
  <Button class="complicationButton"
    fontSize = "60"
    fontStyle = "Bold"
    textColor = "White"
    onClick = "Global/onComplicationButtonClick"
  />
  <Button class="greenButton" color = "#00FF00" textColor = "#000000"  />
  <Button class="blueButton" color = "#0000FF" />
  <Button class="magentaButton" color = "#FF00FF" />
  <Button class="redButton" color = "#FF0000" />
  <Button class="yellowButton" color = "#FFFF00" textColor = "#000000" />
  <Button class="greenButton" color = "#00FF00" />
</Defaults>

<Panel id="complicationsDisplayContainer" class="complicationsDisplayContainer" >
  <HorizontalLayout id="complicationsDisplay" class="complicationsDisplay" >
    <Text id="text_originalMargin" class="complicationsDisplayText redText" text="−6" />
    <Text id="text_complicationsTotal" class="complicationsDisplayText bigText goldText" text="+9" />
    <Text id="text_adjustedMargin" class="complicationsDisplayText goldText" text="+3" />
  </HorizontalLayout>

</Panel>

<HorizontalLayout id="controlsPanel" class="controlsPanel" >
  <Button id="button_StopSelect" class="complicationButton yellowButton" text="Stop" />
  <Button id="button_Enhance" class="complicationButton magentaButton" text="Enhance" />
  <Button id="button_SelectRandom" class="complicationButton blueButton" text="Random" />
  <Button id="button_Negate" class="complicationButton redButton" text="Negate" />
  <Button id="button_Adjust" class="complicationButton yellowButton" text="Adjust" />
  <Button id="button_ToggleCategoryDiscard" class="complicationButton greenButton" text="Auto-Disc" />
</HorizontalLayout>