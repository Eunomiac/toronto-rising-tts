<!-- On-element animation attrs: Defaults alone snapped SlideOut on the cover (TOR-566). -->
<Panel id="overlay_blackoutPanel"
  class="overlay_blackout_panel"
  showAnimation="FadeIn"
  hideAnimation="FadeOut"
  animationDuration="5"
  raycastTarget="false" />
