<!-- Global blindfold — all clients, no visibility filter (TOR-565).
     SlideIn_Top / SlideOut_Top on the parent Panel. Image set dynamically:
     - Scene/table transitions: overlay_globalBlindfold_<1..32>
     - End → Intermission persistent: overlay_sessionEndSplash_<N>
     Session-start explode stack: ui/shared/panel_overlay_session_start.xml — never this panel.
     Lua: core/hud_overlays.ttslua (transitions); core/phases.ttslua / global_script (End→Intermission).
-->
<Defaults>
  <Panel class="global_blindfold_panel"
    active = "false"
    width = "1920"
    height = "1200"
    rectAlignment = "MiddleCenter"
    raycastTarget = "true"
    showAnimation = "SlideIn_Top"
    hideAnimation = "SlideOut_Top"
    animationDuration = "2"
    hideAnimationDelay = "0"
    color = "#000000"
  />
  <Image class="global_blindfold_image"
    active = "true"
    width = "1920"
    height = "1200"
    rectAlignment = "MiddleCenter"
    preserveAspect = "true"
    raycastTarget = "false"
    color = "White"
  />
  <Image class="global_blindfold_district_card"
    raycastTarget = "false"
    preserveAspect = "true"
    rectAlignment = "LowerLeft"
    width = "900"
    offsetXY = "50 75"
    showAnimation = "FadeIn"
    hideAnimation = "FadeOut"
    animationDuration = "1"
    showAnimationDelay = "4"
    active = "false"
    image = ""
    color = "clear"
  />
  <Image class="global_blindfold_site_card"
    raycastTarget = "false"
    preserveAspect = "true"
    rectAlignment = "LowerRight"
    width = "900"
    offsetXY = "-50 125"
    showAnimation = "FadeIn"
    hideAnimation = "FadeOut"
    animationDuration = "1"
    showAnimationDelay = "4.5"
    active = "false"
    image = ""
    color = "clear"
  />
</Defaults>

<Panel id="overlay_globalBlindfold_panel" class="global_blindfold_panel">
  <Image id="overlay_globalBlindfold" class="global_blindfold_image" image="overlay_globalBlindfold_1" />
  <Image id="overlay_district_card_display" class="global_blindfold_district_card" />
  <Image id="overlay_site_card_display" class="global_blindfold_site_card" />
</Panel>
