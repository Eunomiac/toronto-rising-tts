<!-- Global session blindfold — no visibility filter (all clients). active=true by default / on connect. -->
<!-- Lua: hideStartupLoadingOverlays() / showStartupLoadingOverlaysForPhases; session explode: core/session_explode.ttslua (Play enter). -->
<!-- Per-player transition blinds: ui/.templates/panel_overlay_blindfold.xml — root sibling beside this file (TOR-436). -->
<!-- Placed last among blindfolds in ui/Global.xml so it draws above transition blinds when both are up. -->
<!-- Parent Panel owns show/hide + FadeIn/FadeOut + raycast; child Images are stacked splash art. -->
<!-- Attribute-path static showAnimation / colors live in session_splash_* Defaults; Lua only sets song-scaled delays/durations. -->

<Defaults>
  <Panel class="global_blindfold_panel"
    active = "true"
    width = "1920"
    height = "1200"
    rectAlignment = "MiddleCenter"
    raycastTarget = "true"
    showAnimation = "FadeIn"
    hideAnimation = "FadeOut"
    animationDuration = "0.3"
    color = "#000000"
  />
  <Panel class="global_blindfold_image_panel"
    active = "true"
    width = "1920"
    height = "1200"
    rectAlignment = "MiddleCenter"
    color = "#000000"
  />
  <Image class="global_blindfold"
    active = "true"
    width = "1920"
    height = "1200"
    rectAlignment = "MiddleCenter"
    preserveAspect = "true"
    raycastTarget = "false"
  />

  <!-- Attribute session-start path (TOR-559): static show/hide + resting colors. Timing stays in Lua. -->
  <Panel class="session_splash_text_panel"
    active = "false"
    color = "rgba(1, 1, 1, 0)"
    showAnimation = "FadeIn"
  />
  <Panel class="session_splash_art_panel"
    active = "false"
    color = "rgba(1, 1, 1, 0)"
    showAnimation = "Grow"
  />
  <Panel class="session_splash_title_panel"
    active = "false"
    color = "rgba(0, 0, 0, 1)"
    showAnimation = "Grow"
  />
  <Panel class="session_splash_frame_panel"
    active = "false"
    color = "rgba(1, 1, 1, 0)"
    showAnimation = "FadeIn"
    animationDuration = "0.5"
  />
  <Image class="session_splash_pair_image"
    active = "true"
    color = "rgba(1, 1, 1, 1)"
    showAnimation = "FadeIn"
    hideAnimation = "FadeOut"
  />
  <Image class="session_splash_title_image"
    active = "true"
    color = "rgba(1, 1, 1, 1)"
    showAnimation = "FadeIn"
  />
</Defaults>

