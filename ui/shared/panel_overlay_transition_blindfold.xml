<!-- Shared scene-transition blindfold (TOR-444).
     One panel for all seats; one variant Image (image= swap); one district/site card pair.
     Phases still use ui/shared/panel_overlay_global_blindfold.xml — never this panel.

  TOR-431 / TOR-425 activation (Lua: `HO.applyBlindfoldVariantForSeatedPlayers` / `applySharedBlindfold`):
  1. Audience: `U.setVisibleTo` seated PC colors while parent still inactive.
  2. Arm children BEFORE parent `UI.show` (do not `UI.show` children):
     - `overlay_blindfold_display`: active=true, color=White, image=overlay_blindfold_N
     - With destination location: district/site cards `{active=true, color=White, image=...}`
       in one `U.setAttributes` each; without location: `{active=false, color=Clear, image=""}`.
  3. One `UI.show` on `playerHud_overlay_blindfold` (parent owns FadeIn).
  4. Re-arm the same child attrs AFTER `UI.show` — parent show re-applies XML defaults
     (display → overlay_blindfold_1; cards → inactive/Clear). Same footgun as Image-Stacks notes.

  Deactivation (`HO.syncAll` when no hudBlindfold / `HUDBF.endTransition`):
  1. `UI.hide` parent only.
  2. After ~3s, restore CHILD defaults only (not the parent): display image=overlay_blindfold_1;
     cards `{active=false, color=Clear, image=""}`.
-->
<Defaults>
  <Image class="player_overlay_transition"
    active="true"
    width="1920"
    height="1200"
    preserveAspect="true"
    raycastTarget="false"
    rectAlignment="MiddleCenter"
  />
  <Image class="player_overlay_district_card_display"
    raycastTarget="false"
    preserveAspect="true"
    rectAlignment="LowerLeft"
    width="900"
    offsetXY="50 75"
    showAnimation="FadeIn"
    hideAnimation="FadeOut"
    animationDuration="1"
    showAnimationDelay="4"
    active="false"
    image=""
    color="clear"
  />
  <Image class="player_overlay_site_card_display"
    raycastTarget="false"
    preserveAspect="true"
    rectAlignment="LowerRight"
    width="900"
    offsetXY="-50 125"
    showAnimation="FadeIn"
    hideAnimation="FadeOut"
    animationDuration="1"
    showAnimationDelay="4.5"
    active="false"
    image=""
    color="clear"
  />
</Defaults>

<Panel id="playerHud_overlay_blindfold"
  active="false"
  width="1920"
  height="1200"
  rectAlignment="MiddleCenter"
  raycastTarget="true"
  visibility="None"
  showAnimation="FadeIn"
  hideAnimation="FadeOut"
  animationDuration="2"
  hideAnimationDelay="1">
  <Image id="overlay_blindfold_display"
    image="overlay_blindfold_1"
    class="player_overlay_transition"
    color="White" />
  <Image id="overlay_district_card_display" class="player_overlay_district_card_display" />
  <Image id="overlay_site_card_display" class="player_overlay_site_card_display" />
</Panel>
