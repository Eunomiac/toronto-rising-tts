<!-- Session-start overlay — no visibility filter (all clients). active=true by default / on connect. -->
<!-- Lua: hideStartupLoadingOverlays() / showStartupLoadingOverlaysForPhases; session explode: core/session_explode.ttslua (Play enter). -->
<!-- Global transition cover: ui/shared/panel_overlay_global_blindfold.xml (TOR-565). -->
<!-- Placed before the global blindfold in ui/Global.xml so the global cover draws above when both are up. -->
<!-- Parent Panel owns show/hide + FadeIn/FadeOut + raycast; child Images are stacked splash art. -->
<!-- Attribute-path static showAnimation / colors live in session_splash_* Defaults; Lua only sets song-scaled delays/durations. -->

<Defaults>
  <Panel class="session_start_panel"
    active = "true"
    width = "1920"
    height = "1200"
    rectAlignment = "MiddleCenter"
    raycastTarget = "true"
    showAnimation = "FadeIn"
    hideAnimation = "FadeOut"
    animationDuration = "0.3"
    color = "#000000"
  />
  <Panel class="session_start_image_panel"
    active = "true"
    width = "1920"
    height = "1200"
    rectAlignment = "MiddleCenter"
    color = "#000000"
  />
  <Image class="session_start_image"
    active = "true"
    width = "1920"
    height = "1200"
    rectAlignment = "MiddleCenter"
    preserveAspect = "true"
    raycastTarget = "false"
  />

  <!-- Attribute session-start path (TOR-559): static show/hide + resting colors. Timing stays in Lua. -->
  <Panel class="session_splash_text_panel"
    active = "false"
    color = "rgba(1, 1, 1, 0)"
    showAnimation = "FadeIn"
  />
  <Panel class="session_splash_art_panel"
    active = "false"
    color = "rgba(1, 1, 1, 0)"
    showAnimation = "Grow"
  />
  <Panel class="session_splash_title_panel"
    active = "false"
    color = "rgba(0, 0, 0, 1)"
    showAnimation = "Grow"
  />
  <Panel class="session_splash_frame_panel"
    active = "false"
    color = "rgba(1, 1, 1, 0)"
    showAnimation = "FadeIn"
    animationDuration = "0.5"
  />
  <Image class="session_splash_pair_image"
    active = "true"
    color = "rgba(1, 1, 1, 1)"
    showAnimation = "FadeIn"
    hideAnimation = "FadeOut"
  />
  <Image class="session_splash_title_image"
    active = "true"
    color = "rgba(1, 1, 1, 1)"
    showAnimation = "FadeIn"
  />
</Defaults>

<Panel id="overlay_sessionStart_panel" class="session_start_panel">
  <Panel id="overlay_sessionStartSplash_panel" class="session_start_image_panel">
    <!-- image + active set together on load / Intermission sessionNum edit (inactive until then so missing art is black, not white) -->
    <Image id="overlay_sessionStartSplash" class="session_start_image" active = "false" />
  </Panel>
  <Panel id="overlay_characterIntroImagePanel_1" class="session_start_image_panel session_splash_art_panel">
    <Image id="overlay_characterIntroImage_1" class="session_start_image session_splash_pair_image" image="overlay_characterIntroImage_blackCaesar" />
  </Panel>
  <Panel id="overlay_characterIntroCaptionPanel_1" class="session_start_image_panel session_splash_text_panel">
