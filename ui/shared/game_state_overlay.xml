<!-- Center-top overlay: in-game location + date/time during Play + Downtime (see `GameStateOverlay.reconcileFromState`). -->
<!-- Lua: `core/game_state_overlay.ttslua` — `GameStateOverlay.reconcileFromState()` / `ensureTicker()`. -->

<Defaults>

  <Panel class="gameStateOverlay" height="100%" width="100%" raycastTarget="false" />

  <VerticalLayout class="gameStateOverlay_topCenter" width="900" height="170" rectAlignment="UpperCenter" childAlignment="MiddleCenter" spacing="0" padding="5 5 5 5" scale="1" offsetXY="0 20" />

  <VerticalLayout class="gameStateOverlay_topRight" width="272" height="110" rectAlignment="UpperRight" childAlignment="UpperRight" spacing="5" padding="5 5 5 5" offsetXY="2 0" />

  <Image class="gameStateOverlay_background" raycastTarget="false" preserveAspect="true" ignoreLayout="true" width="100%" rectAlignment="UpperCenter"  offsetXY="7 10" />

  <HorizontalLayout class="gameStateOverlay_location" spacing="5" childAlignment="UpperCenter" />
  <HorizontalLayout class="gameStateOverlay_weather" spacing = "5" />
  <HorizontalLayout class="gameStateOverlay_temperature"  spacing="5" childAlignment="UpperRight" />

  <Panel class="gameStateOverlay_timeSpacer" minHeight="10" preferredHeight="10" flexibleHeight="0" />


  <Text class="large_red_text" fontSize="42" fontStyle="Bold" color="#CC0000" outline="#000000" outlineSize="2 -2" alignment="MiddleCenter" />
  <Text class="med_red_text" fontSize="30" fontStyle="Bold" color="#CC0000" outline="#000000" outlineSize="2 -2" alignment="MiddleCenter" />
  <Text class="small_red_text" fontSize="18" fontStyle="Bold" color="#CC0000" outline="#000000" outlineSize="1 -1" alignment="MiddleCenter" />
  <Text class="small_white_text" fontSize="18" fontStyle="Bold" color="#FFFFFF" outline="#000000" outlineSize="1 -1" alignment="MiddleCenter" />
  <Text class="italic_text" fontStyle="Italic" />

  <Text class="bold_italic_text" fontStyle="BoldAndItalic" />
  <Text class="dark_red_text" color="#990000" />
  <Text class="bright_red_text" color="#FF0000" />
  <Text class="gold_text" color="#d3ba50" />
  <Text class="flex_tall_text" minHeight="42" preferredHeight="42" flexibleHeight="1" />
  <Text class="rigid_tall_text" minHeight="42" preferredHeight="42" flexibleHeight="0" />
  <Text class="med_white_text" fontSize="29" color="#FFFFFF" />
  <Text class="normal_text" fontStyle="Normal" />


  <!-- PLAY/DOWNTIME -> "PROLOGUE"
       Source: applyOverlayPhaseChrome("prologue") + pushBookendOverlay("PROLOGUE")
       (constants resolved: OVERLAY_SESSION_NUMBER_PROLOGUE_COLOR, OVERLAY_DATETIME_SPOTLIGHT_COLOR,
        OVERLAY_TIME_PLAY_COLOR, OVERLAY_SEPARATOR_PROLOGUE_COLOR)


      *** sessionNumber id (was sesionNumber typo) ***

       Legacy setAttributes (replaced by setClass APPLY below):
       UI.setAttributes("gameStateOverlay_sessionNumber", {
         fontStyle = "BoldAndItalic",
         color = "#990000",
       })
       APPLY: UI.setClass("gameStateOverlay_sessionNumber", "small_red_text dark_red_text bold_italic_text")
       REVERT: UI.setClass("gameStateOverlay_sessionNumber", "small_red_text")

       UI.setAttributes("gameStateOverlay_datetime", {
         color = "#d3ba50",
         fontStyle = "BoldAndItalic",
       })
       APPLY: UI.setClass("gameStateOverlay_datetime", "med_red_text gold_text bold_italic_text")
       REVERT: UI.setClass("gameStateOverlay_datetime", "med_red_text")

       UI.setAttributes("gameStateOverlay_time", {
         color = "#FF0000",
         fontSize = "42",
         fontStyle = "Bold",
       })
       APPLY: UI.setClass("gameStateOverlay_time", "large_red_text bright_red_text")
       REVERT: UI.setClass("gameStateOverlay_time", "large_red_text")

       UI.setAttributes("gameStateOverlay_districtSeparator", {
         active = "true",
         text = "– " .. compactSessionRoman(sessionNum) .. " –",
         fontStyle = "Bold",
         color = "#FF0000",
       })
       APPLY: UI.setClass("gameStateOverlay_districtSeparator", "small_red_text bright_red_text")
              UI.setAttributes("gameStateOverlay_districtSeparator", {text = "– " .. compactSessionRoman(sessionNum) .. " –"})
      REVERT: UI.setClass("gameStateOverlay_districtSeparator", "small_red_text")
              UI.setAttributes("gameStateOverlay_districtSeparator", {text = "◆"})
  -->

  <!-- PLAY/DOWNTIME
       Source: applyOverlayPhaseChrome("play") + pushEmptyLocationRow()
       (later Downtime after End scene; not session-start prologue)

       UI.setAttributes("gameStateOverlay_sessionNumber", {
         fontStyle = "Bold",
         fontSize = "18",
         color = "#CC0000",
       })
       (No change needed: The reversion above restores these attributes)

       UI.setAttributes("gameStateOverlay_datetime", {
         color = "#FF0000",
         fontStyle = "Bold",
         fontSize = "30",
       })
      APPLY: UI.setClass("gameStateOverlay_datetime", "med_red_text bright_red_text")
      REVERT: UI.setClass("gameStateOverlay_datetime", "med_red_text")

       UI.setAttributes("gameStateOverlay_time", {
         color = "#FF0000",
         fontStyle = "Bold",
         fontSize = "42",
         minHeight = "42",
         preferredHeight = "42",
         flexibleHeight = "1",
       })
       APPLY: UI.setClass("gameStateOverlay_time", "large_red_text bright_red_text flex_tall_text")
       REVERT: UI.setClass("gameStateOverlay_time", "large_red_text")

       UI.setAttributes("gameStateOverlay_districtSeparator", {
         active = "false",
         text = "◆",
         fontStyle = "Bold",
         color = "#CC0000",
       })
       (No change needed to class: Just set the text and active attributes)
  -->

  <!-- PLAY/MAIN
       Source: applyOverlayPhaseChrome("play") + reconcileLocationRowFromState()
       (same chrome as PLAY/DOWNTIME; location row diamond is active)

       *** NO changes needed here: Reverting the classes as described above will restore these default styles. The only
       exception is to change the `text` or `active` attributes. ***

       UI.setAttributes("gameStateOverlay_sessionNumber", {
         fontStyle = "Bold",
         fontSize = "18",
         color = "#CC0000",
       })
       UI.setAttributes("gameStateOverlay_datetime", {
         color = "#FF0000",
         fontStyle = "Bold",
         fontSize = "30",
       })
       UI.setAttributes("gameStateOverlay_time", {
         color = "#FF0000",
         fontStyle = "Bold",
         fontSize = "42",
         minHeight = "42",
         preferredHeight = "42",
         flexibleHeight = "1",
       })
       UI.setAttributes("gameStateOverlay_districtSeparator", {
         active = "true",
         text = "◆",
         fontStyle = "Bold",
         color = "#CC0000",
       })
  -->

  <!-- SPOTLIGHT
       Source: applyOverlayPhaseChrome("spotlight") + pushSpotlightLocationRow()
       (sessionNumber chrome is the shared Play restore block before the spotlight branch)

       UI.setAttributes("gameStateOverlay_sessionNumber", {
         fontStyle = "Bold",
         fontSize = "18",
         color = "#CC0000",
       })
       (No change needed: The reversion above restores these attributes)

       UI.setAttributes("gameStateOverlay_datetime", {
         color = "#d3ba50",
         fontStyle = "BoldAndItalic",
       })
       APPLY: UI.setClass("gameStateOverlay_datetime", "med_red_text gold_text bold_italic_text")
       REVERT: UI.setClass("gameStateOverlay_datetime", "med_red_text")

       UI.setAttributes("gameStateOverlay_time", {
         color = "#FFFFFF",
         fontSize = "29",
         minHeight = "42",
         preferredHeight = "42",
         flexibleHeight = "0",
       })
       APPLY: UI.setClass("gameStateOverlay_time", "large_red_text med_white_text rigid_tall_text")
       REVERT: UI.setClass("gameStateOverlay_time", "large_red_text")

       UI.setAttributes("gameStateOverlay_districtSeparator", {
         active = "true",
         text = sessionName,
         fontStyle = "Normal",
         color = "#CC0000",
       })
       APPLY: UI.setClass("gameStateOverlay_districtSeparator", "small_red_text normal_text")
       REVERT: UI.setClass("gameStateOverlay_districtSeparator", "small_red_text")

  -->

  <!-- END
       Source: applyOverlayPhaseChrome("prologue") + pushBookendOverlay("EPILOGUE")
       (same chrome as PROLOGUE; only the time label differs)

       *** Same changes as PROLOGUE, except for `text` values via setAttribute (never setValue) ***

       UI.setAttributes("gameStateOverlay_sessionNumber", {
         fontStyle = "BoldAndItalic",
         color = "#990000",
       })
       UI.setAttributes("gameStateOverlay_datetime", {
         color = "#d3ba50",
         fontStyle = "BoldAndItalic",
       })
       UI.setAttributes("gameStateOverlay_time", {
         color = "#FF0000",
         fontSize = "42",
         fontStyle = "Bold",
       })
       UI.setAttributes("gameStateOverlay_districtSeparator", {
         active = "true",
         text = "– " .. compactSessionRoman(sessionNum) .. " –",
         fontStyle = "Bold",
         color = "#FF0000",
       })
       -- text-only:
       -- UI.setAttributes("gameStateOverlay_sessionNumber", { text = "T O R O N T O   R I S I N G" })
       -- UI.setAttributes("gameStateOverlay_datetime", { text = spacedUppercaseSessionTitle })
       -- UI.setAttributes("gameStateOverlay_time", { text = "EPILOGUE" })
  -->


</Defaults>

<Panel id="gameStateOverlay_root" class="gameStateOverlay">

  <VerticalLayout id="gameStateOverlay_timeAndLocation" class="gameStateOverlay_topCenter">
    <Image id="gameStateOverlay_timeAndLocation_background" class="gameStateOverlay_background" image="bg_playerOverlay_timeLocation" />
    <Text id="gameStateOverlay_sessionNumber" class="small_red_text" text="− Ⅰ −" />
    <HorizontalLayout class="gameStateOverlay_location">
      <Text id="gameStateOverlay_district" class="small_white_text" text="" />
      <Text id="gameStateOverlay_districtSeparator" class="small_red_text" text="◆" />
      <Text id="gameStateOverlay_parentSite" class="small_white_text" text="" active="false" />
      <Text id="gameStateOverlay_parentSiteSeparator" class="small_red_text" text="◆" active="false" />
      <Text id="gameStateOverlay_site" class="small_white_text" text="" />
    </HorizontalLayout>
    <Text id="gameStateOverlay_datetime" class="med_red_text" text="" />
    <Panel id="gameStateOverlay_timeSpacer" class="gameStateOverlay_timeSpacer" />
    <Text id="gameStateOverlay_time" class="large_red_text" text="" />
  </VerticalLayout>

  <VerticalLayout id="gameStateOverlay_weather" class="gameStateOverlay_topRight">
    <Image class="gameStateOverlay_background" image="bg_playerOverlay_weather" />
    <HorizontalLayout class="gameStateOverlay_weather">
      <Text id="gameStateOverlay_weatherBase" class="small_red_text" text="" />
      <Text id="gameStateOverlay_weatherWind" class="small_red_text" text="" />
    </HorizontalLayout>
    <HorizontalLayout class="gameStateOverlay_temperature">
      <Text id="gameStateOverlay_temperatureC" class="large_red_text" text="" />
      <Text id="gameStateOverlay_temperatureF" class="small_red_text italic_text" text="" />
    </HorizontalLayout>

  </VerticalLayout>

</Panel>