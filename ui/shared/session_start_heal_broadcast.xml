<Defaults>

  <VerticalLayout class="sessionStartHeal_panel"
    width = "900"
    spacing = "0"
    childAlignment = "MiddleCenter"
    height = "100%" rectAlignment="MiddleCenter" showAnimation = "FadeIn" hideAnimation = "FadeOut" animationDuration = "2" childForceExpandWidth = "true" childForceExpandHeight = "true" />

  <Panel class="sessionStartHeal_spacer" flexibleWidth="1" flexibleHeight="1" preferredHeight = "0" />

  <VerticalLayout class="sessionStartHeal_screen_content" padding = "30 30 0 0" spacing = "5" childForceExpandWidth = "false" childAlignment = "UpperCenter" childForceExpandHeight = "false" />

  <VerticalLayout class="sessionStartHeal_screen_title_container" flexibleHeight = "0" preferredHeight = "100" minHeight = "100" preferredWidth = "900" childAlignment = "MiddleCenter" childForceExpandWidth = "false"/>

  <Image class="sessionStartHeal_image" preserveAspect="true"/>

  <Image class="sessionStartHeal_image_background" ignoreLayout = "true" rectAlignment = "MiddleCenter"  height = "110%" width = "150%" preserveAspect = "false" />
  <Image class="sessionStartHeal_image_border" preferredHeight = "70" preferredWidth = "900" minWidth = "900" flexibleHeight = "0" />

  <Text class="sessionStartHeal_title" fontSize = "40" fontStyle = "Bold" color = "#e6be65" />
  <Text class="sessionStartHeal_description" fontStyle = "BoldAndItalic" color = "#e6be65" preferredWidth = "550" />

  <HorizontalLayout class="sessionStartHeal_playerRow" spacing="10" childAlignment = "MiddleLeft" preferredHeight = "40" preferredWidth = "900" childForceExpandWidth = "false" />

  <Text class="sessionStartHeal_playerName" fontSize = "24" fontStyle = "Bold" color = "#e6be65" />
  <Text class="sessionStartHeal_phrase" fontSize = "24" fontStyle = "Bold" color = "#e6be65" />
  <Text class="sessionStartHeal_amount" fontSize = "34" fontStyle = "Bold" color = "#FFFFFF" />
  <Text class="sessionStartHeal_phraseEnd" fontSize = "24" fontStyle = "Bold" color = "#e6be65" />

</Defaults>

