<VerticalLayout id="sessionStartHeal_panel" class="sessionStartHeal_panel" active="false">
  <Panel id="db_sessionStartHeal_spacer_top" class="sessionStartHeal_spacer" />
  <Image id="db_sessionStartHeal_image_border_top" class="sessionStartHeal_image sessionStartHeal_image_border sessionStartHeal_image_border_top" image="resultsBorder"  />
  <VerticalLayout id="db_sessionStartHeal_screen_content" class="sessionStartHeal_screen_content">
    <Image id="sessionStartHeal_screen_content_background" class="sessionStartHeal_image sessionStartHeal_image_background" image="resultsBG" />
    <VerticalLayout id="db_sessionStartHeal_screen_title_container" class="sessionStartHeal_screen_title_container">
      <Text id="db_sessionStartHeal_title" class="sessionStartHeal_title" text="Willpower Refresh" />
      <Text id="db_sessionStartHeal_description" class="sessionStartHeal_description" text="All characters automatically heal an amount of superficial Willpower damage equal to the highest of their Resolve or Composure attributes:" />
    </VerticalLayout>
    <!-- Only activate those HorizontalLayout elements for players who have Willpower damage to heal. -->
    <HorizontalLayout id="sessionStartHeal_playerContainer_Red" class="sessionStartHeal_playerRow" active="false">
      <Text id="db_sessionStartHeal_playerName_Red" class="sessionStartHeal_playerName" text="Lord Lucien" />
      <Text id="db_sessionStartHeal_phrase_Red" class="sessionStartHeal_phrase" text="heals" />
      <Text id="sessionStartHeal_amount_Red" class="sessionStartHeal_amount" text="3" />
      <Text id="db_sessionStartHeal_phraseEnd_Red" class="sessionStartHeal_phrase" text="points of superficial Willpower damage." />
    </HorizontalLayout>
    <HorizontalLayout id="sessionStartHeal_playerContainer_Orange" class="sessionStartHeal_playerRow" active="false">
      <Text id="db_sessionStartHeal_playerName_Orange" class="sessionStartHeal_playerName" text="Seneschal Rashid" />
      <Text id="db_sessionStartHeal_phrase_Orange" class="sessionStartHeal_phrase" text="heals" />
      <Text id="sessionStartHeal_amount_Orange" class="sessionStartHeal_amount" text="3" />
      <Text id="db_sessionStartHeal_phraseEnd_Orange" class="sessionStartHeal_phrase" text="points of superficial Willpower damage." />
    </HorizontalLayout>
    <HorizontalLayout id="sessionStartHeal_playerContainer_Pink" class="sessionStartHeal_playerRow" active="false">
      <Text id="db_sessionStartHeal_playerName_Pink" class="sessionStartHeal_playerName" text="Primogen Aishe Tache" />
      <Text id="db_sessionStartHeal_phrase_Pink" class="sessionStartHeal_phrase" text="heals" />
      <Text id="sessionStartHeal_amount_Pink" class="sessionStartHeal_amount" text="3" />
      <Text id="db_sessionStartHeal_phraseEnd_Pink" class="sessionStartHeal_phrase" text="points of superficial Willpower damage." />
    </HorizontalLayout>
    <HorizontalLayout id="sessionStartHeal_playerContainer_Brown" class="sessionStartHeal_playerRow" active="false">
      <Text id="db_sessionStartHeal_playerName_Brown" class="sessionStartHeal_playerName" text="Primogen Fomórach" />
      <Text id="db_sessionStartHeal_phrase_Brown" class="sessionStartHeal_phrase" text="heals" />
      <Text id="sessionStartHeal_amount_Brown" class="sessionStartHeal_amount" text="3" />
      <Text id="db_sessionStartHeal_phraseEnd_Brown" class="sessionStartHeal_phrase" text="points of superficial Willpower damage." />
    </HorizontalLayout>
    <HorizontalLayout id="sessionStartHeal_playerContainer_Purple" class="sessionStartHeal_playerRow" active="false">
      <Text id="db_sessionStartHeal_playerName_Purple" class="sessionStartHeal_playerName" text="Sheriff Black Caesar" />
      <Text id="db_sessionStartHeal_phrase_Purple" class="sessionStartHeal_phrase" text="heals" />
      <Text id="sessionStartHeal_amount_Purple" class="sessionStartHeal_amount" text="3" />
      <Text id="db_sessionStartHeal_phraseEnd_Purple" class="sessionStartHeal_phrase" text="points of superficial Willpower damage." />
    </HorizontalLayout>
  </VerticalLayout>
  <Image id="db_sessionStartHeal_image_border_bottom" class="sessionStartHeal_image sessionStartHeal_image_border sessionStartHeal_image_border_bottom" image="resultsBorderBottom"  />
  <Panel id="db_sessionStartHeal_spacer_bottom" class="sessionStartHeal_spacer" />
</VerticalLayout>