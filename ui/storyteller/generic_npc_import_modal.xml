<!-- Generic NPC import label override modal (TOR-560). Source: ui/storyteller/generic_npc_import_modal.xml -->
<Defaults>
  <VerticalLayout class="genericImport_modal"
    rectAlignment="MiddleCenter"
    width="720"
    height="640"
    padding="20 20 20 20"
    color="#000000EE"
    childAlignment="UpperCenter"
    spacing="10"
    childForceExpandWidth="true"
    childForceExpandHeight="false"
  />
  <Text class="genericImport_title"
    alignment="MiddleCenter"
    color="#cb995c"
    fontStyle="Bold"
    fontSize="26"
    preferredHeight="40"
  />
  <Text class="genericImport_hint"
    alignment="MiddleCenter"
    color="#AAAAAA"
    fontSize="14"
    preferredHeight="28"
  />
  <HorizontalLayout class="genericImport_row"
    preferredHeight="40"
    minHeight="40"
    spacing="10"
    childForceExpandWidth="false"
    childForceExpandHeight="true"
    childAlignment="MiddleLeft"
  />
  <Text class="genericImport_key"
    alignment="MiddleLeft"
    color="#FFFFFF"
    fontSize="14"
    preferredWidth="220"
    minWidth="180"
  />
  <InputField class="genericImport_label"
    fontSize="16"
    preferredHeight="36"
    minHeight="36"
    flexibleWidth="1"
    colors="#222222|#333333|#111111|#555555"
    textColor="#FFFFFF"
  />
  <HorizontalLayout class="genericImport_buttons"
    preferredHeight="48"
    minHeight="48"
    spacing="16"
    childForceExpandWidth="false"
    childAlignment="MiddleCenter"
  />
  <Button class="genericImport_btn"
    preferredWidth="160"
    preferredHeight="44"
    fontSize="18"
    fontStyle="Bold"
    textColor="#FFFFFF"
  />
</Defaults>

