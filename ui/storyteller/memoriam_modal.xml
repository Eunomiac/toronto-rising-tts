<Defaults>

  <VerticalLayout class="memoriam_modal_container"
    rectAlignment = "MiddleCenter"
    width = "1240"
    height = "800"
    padding = "20 20 20 20"
    color = "#000000"
    childAlignment = "UpperCenter"
    spacing = "10"
    childForceExpandWidth = "true"
    childForceExpandHeight = "false"
   />

  <Text class="memoriam_modal_title"
    alignment = "MiddleCenter"
    color = "#cb995c"
    fontStyle = "Bold"
    fontSize = "24"
  />

  <Dropdown class="memoriam_modal_pc_selection"
    flexibleWidth = "0"
    preferredWidth = "200"
    minWidth = "200"
    preferredHeight = "40"
    width = "200"
    height = "40"
    onValueChanged = "HUD_memoriamModalPcDropdown"
  />

  <VerticalLayout class="memoriam_modal_period_selection"
    preferredHeight = "150"
    flexibleHeight = "0"
    spacing = "0"
    padding = "0 0 0 0"
    childAlignment = "UpperCenter"
    childForceExpandWidth = "true"
    childForceExpandHeight = "true"
  />

  <Text class="memoriam_modal_selected_date"
    alignment = "LowerCenter"
    color = "#FFFFFF"
    fontSize = "30"
    fontStyle = "BoldAndItalic"
    preferredHeight = "40"
  />
  <Text class="memoriam_modal_selected_location"
    alignment = "MiddleCenter"
    color = "#FFFFFF"
    fontSize = "24"
    fontStyle = "BoldAndItalic"
    preferredHeight = "30"
  />

  <HorizontalLayout class="memoriam_modal_period_indicator_bar"
    childForceExpandHeight = "true"
    childForceExpandWidth = "false"
    spacing = "0"
    padding = "10 10 0 0"
    childAlignment = "MiddleLeft"
    preferredHeight = "40"
  />

  <Panel class="memoriam_modal_period_indicator"
    flexibleHeight = "1"
    flexibleWidth = "0"
  />

  <Slider class="memoriam_modal_period_selection_slider"
    minValue = "0"
    maxValue = "5000"
    wholeNumbers = "true"
    direction = "LeftToRight"
    value = "0"
    onValueChanged = "HUD_memoriamModalSlider"
    flexibleHeight = "1"
    flexibleWidth = "1"
    preferredHeight = "40"
  />

  <GridLayout class="memoriam_modal_scene_selection_grid"
    padding = "0 0 0 0"
    spacing = "0 0"
    cellSize = "85 40"
    startCorner = "UpperLeft"
    startAxis = "Vertical"
    childAlignment = "MiddleCenter"
    constraint = "FixedRowCount"
    constraintCount = "4"
    childForceExpandWidth = "true"
    childForceExpandHeight = "true"
  />

  <Button class="memoriam_modal_scene_selection_button"
    textAlignment = "MiddleCenter"
    fontSize = "10"
    fontStyle = "Bold"
    onClick = "HUD_memoriamModalSceneButton"
  />

  <Button class="selection_button_idle"
    color = "#999999"
    colors = "#999999|#999999|#999999|#999999" />

  <Button class="selection_button_highlighted"
    color = "#FFFF00"
    colors = "#FFFF00|#FFFF00|#FFFF00|#FFFF00" />

  <Button class="selection_button_selected"
    color = "#00FF00"
    colors = "#00FF00|#00FF00|#00FF00|#00FF00" />

  <VerticalLayout class="memoriam_modal_npc_assignment"
    childForceExpandWidth = "false"
    childAlignment = "MiddleCenter"
  />
  <HorizontalLayout class="memoriam_modal_npc_assignment"
    spacing = "20"
    padding = "10 10 10 10"
  />
  <Text class="memoriam_modal_npc_assignment_label"
    fontSize = "24"
    fontStyle = "Bold"
    color = "#FFFFFF"
    minWidth = "400"
    alignment = "MiddleLeft"
  />
  <Text class="memoriam_modal_npc_assignment_value"
    fontSize = "24"
    fontStyle = "Bold"
    color = "#cb995c"
    minWidth = "400"
    alignment = "MiddleLeft"
  />
  <Button class="memoriam_modal_npc_assignment_button"
    flexibleWidth = "0"
    minWidth = "30"
    preferredWidth = "30"
  />

  <Button class="memoriam_npc"
    onClick = "HUD_memoriamModalNpcPick"
  />

</Defaults>

