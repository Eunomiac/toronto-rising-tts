<Defaults>

  <Panel class="at_full_container" height = "100%" width = "100%" color = "#000000" />
  <Panel class="at_full_panel" height = "100%" width = "100%" />
  <Panel class="at_top_panel" active = "false" />
  <Image class="at_full_image" height = "100%" preserveAspect = "true" pivot = "0.5 0.5" active = "false" />
  <Image class="image_cyan" image="anim_full_cyan" />
  <Image class="image_red" image="anim_full_red" />
  <Image class="image_yellow" image="anim_full_yellow" />
  <Image class="image_green" image="anim_full_green" />
  <Image class="image_violet" image="anim_full_violet" />

  <Panel class="at_full_indicator" height = "20" width = "20"
    ignoreLayout = "true"
    rectAlignment = "MiddleCenter" />
  <Panel class="indicator_cyan" color = "#00FFFF" />
  <Panel class="indicator_red" color = "#FF0000" />
  <Panel class="indicator_yellow" color = "#FFFF00" />
  <Panel class="indicator_green" color = "#00FF00" />
  <Panel class="indicator_violet" color = "#FF00FF" />


</Defaults>

<!--

*** Animation Attributes ***
  showAnimation - "None", "Grow", "FadeIn", "SlideIn_Left", "SlideIn_Right", "SlideIn_Top", "SlideIn_Bottom"
  hideAnimation = "None", "Shrink", "FadeOut", "SlideOut_Left", "SlideOut_Right", "SlideOut_Top", "SlideOut_Bottom"
  showAnimationDelay = float
  hideAnimationDelay = float
  animationDuration = float

UISet({"at_@_#_image"}, {pivot = "0.5 0.5"}, {["@"] = {1, 2, 3, 4, 5}, ["#"] = {"a", "b", "c", "d", "e"}})
UISet({"at_@_#_image"}, {active = "false"}, {["@"] = {1, 2, 3, 4, 5}, ["#"] = {"a", "b", "c", "d", "e"}})

UI.show("animation_tester")
UI.hide("animation_tester")
UI.setAttributes("animation_tester", { active = "false" })
UI.show("at_1_a_panel")
UISet({"at_@_#_panel"}, {active = "false"}, {["#"] = {"a", "b", "c", "d", "e"}, ["@"] = {1, 2, 3, 4, 5}})

segmentDuration = 20
segmentGap = -10
halfPoint = segmentDuration / 2
fadeDuration = segmentDuration / 8

-- Following times are normalized to segmentDuration = 100

FADE_DURATION = 10
BASE_TIMESTAMPS = {
  startPanelA = 0,
  startPanelB = 20,
  fadeInImage = 50,
  fadeOutImage = 70,
  endPanelB = 100,
  endPanelA = 100
}

-- Helper function to convert normalized time to segmentDuration
function normalizeTime(time)
  return time * (segmentDuration / 100)
end

-- Convert to XML animation attributes given two command timings - 0 and halfPoint (for hiding)
ANIM_ATTRIBUTES = {
  ["a_panel"] = {
    active = "false",
    showAnimation = "SlideIn_Left",
    startAnimationDelay = normalizeTime(BASE_TIMESTAMPS.startPanelA),
    animationDuration = normalizeTime(BASE_TIMESTAMPS.endPanelA - BASE_TIMESTAMPS.startPanelA),
  },
  ["b_panel"] = {
    active = "true",
    showAnimation = "Grow",
    startAnimationDelay = normalizeTime(BASE_TIMESTAMPS.startPanelB),
    animationDuration = normalizeTime(BASE_TIMESTAMPS.endPanelB - BASE_TIMESTAMPS.startPanelB),
  },
  ["b_image"] = {
    active = "true",
    showAnimation = "FadeIn",
    hideAnimation = "FadeOut",
    startAnimationDelay = normalizeTime(BASE_TIMESTAMPS.fadeInImage),
    animationDuration = normalizeTime(FADE_DURATION),
    hideAnimationDelay = normalizeTime(BASE_TIMESTAMPS.fadeOutImage - 50),
  }
}

-- Write attributes to elements
UISet({"at_#_a_panel"}, ANIM_ATTRIBUTES["a_panel"], {["#"] = {1, 2, 3, 4, 5}})
UISet({"at_#_b_panel"}, ANIM_ATTRIBUTES["b_panel"], {["#"] = {1, 2, 3, 4, 5}})
UISet({"at_#_b_image"}, ANIM_ATTRIBUTES["b_image"], {["#"] = {1, 2, 3, 4, 5}})

interval = segmentDuration + segmentGap

U.chain({
  function()
    UI.show("at_1_a_panel")
    U.await(function() UI.hide("at_1_b_image") end, halfPoint)
    return interval
  end,
  function()
    UI.show("at_2_a_panel")
    U.await(function() UI.hide("at_2_b_image") end, halfPoint)
    return interval
  end,
  function()
    UI.show("at_3_a_panel")
    U.await(function() UI.hide("at_3_b_image") end, halfPoint)
    return interval
  end,
  function()
    UI.show("at_4_a_panel")
    U.await(function() UI.hide("at_4_b_image") end, halfPoint)
    return interval
  end,
  function()
    UI.show("at_5_a_panel")
    U.await(function() UI.hide("at_5_b_image") end, halfPoint)
    return interval
  end
})

testAnimation = "SlideIn_Left"
durations = {5, 10, 20, 30, 60}
animationGap = 3
colors = {"cyan", "red", "yellow", "green", "violet"}

function animatePanelChain(i)
  return function()
    UI.hide("at_1_a_panel")
    UISet("at_1_a_panel", { showAnimation = "None", animationDuration = 0 })
    UISet("at_1_a_image", { offsetXY = "1920 0", image = "anim_full_" .. colors[i], showAnimation = testAnimation, animationDuration = durations[i], showAnimationDelay = 0, active = "true" })
    UI.show("at_1_a_panel")
    U.await(function() UI.hide("at_1_a_panel") end, durations[i])
    return durations[i] + animationGap
  end
end

funcChain = {}

for i = 1, 5 do
  funcChain[i] = animatePanelChain(i)
end

U.chain(funcChain)

UI.hide("at_1_a_panel")
UISet("at_1_a_panel", { showAnimation = "None", animationDuration = 0 })
UISet("at_1_a_image", { showAnimation = "Grow", animationDuration = duration, showAnimationDelay = 0, active = "true" })
UI.show("at_1_a_panel")
-->

