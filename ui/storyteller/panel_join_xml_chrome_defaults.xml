<!-- Defaults for join-minimal chrome wrapper (TOR-439). -->
<!-- Mirrors storyteller_panel_root / storyteller_panel_column so Phases matches full ST chrome. -->

<Defaults>
  <Panel class="join_xml_chrome_root"
    visibility="Host"
    ignoreLayout="true"
    rectAlignment="UpperLeft"
    offsetXY="20 -20"
    width="520"
    height="720"
    color="rgba(0,0,0,0.85)"
  />
  <VerticalLayout class="storyteller_panel_column"
    color="rgba(0, 0, 0, 0.8)"
    spacing="6"
    padding="6 6 6 6"
    childForceExpandWidth="true"
    flexibleWidth="1"
    minWidth="0"
    preferredWidth="0"
  />
</Defaults>
