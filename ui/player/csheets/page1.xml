<!-- Agent guidance: .dev/PC Data & Tracking/Character Sheet Modifications.md; lib/json/PCS.json -->
<!--
  Page 1 overlays on blank CustomImage face.
  Dot ids: dot_<key>_<1..5> — script sets active + image (dot_yellow / dot_white / dot_grey / dot_red).
  Box ids: box_<tracker>_<1..10> — script sets active + image (box_white / box_grey_slash / box_red_x / box_purple / box_red).
  Blood Potency uses dot_large size class with asset name dot_red.
-->
<Include src="csheet_defaults.xml" />

<Panel id="paper_root" class="page_root">

  <Button id="pageInner" class="page_navigation page_inner_right" />

  <!--
  Desire (TOR-97): live text only via onValueChanged / onEndEdit → GlobalSetPlayerDesire.
  Unset (whitespace-only) → state "" + class "player_desire player_desire_unset".
  Runtime class changes must use UI.setClass (not setAttributes class).
  -->
  <InputField id="player_desire" class="player_desire player_desire_unset"
    onValueChanged="onDesireChanged" onEndEdit="onDesireEndEdit" />

