  <Text class="npc_attack" fontSize="22" preferredHeight="28" alignment="MiddleLeft" />
  <VerticalLayout class="npc_powers_list" spacing="4" childForceExpandWidth="true" childForceExpandHeight="false" />
  <HorizontalLayout class="npc_power_row" preferredHeight="32" spacing="0" childForceExpandWidth="false" childForceExpandHeight="false" childAlignment="MiddleLeft" />
  <Text class="npc_power_category" fontSize="22" preferredHeight="30" alignment="MiddleLeft" />
  <HorizontalLayout class="npc_power_names" spacing="0" childForceExpandWidth="false" childForceExpandHeight="false" childAlignment="MiddleLeft" />
