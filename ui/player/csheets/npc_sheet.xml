<!--
  PC-as-NPC face sheet (TOR-95) — double-wide tile (PAGE_1 + PAGE_2 span).
  Fill rules: lib/json/pc-as-npc-template.jsonc
  Left pane: identity, trackers, pools, attacks, powers, elder/methuselah, special abilities.
  Right pane: Advantages + Roleplay Notes.
  Root scaling matches PC `page_root` (csheet_defaults), width doubled for two panes.
-->
<Defaults>
  <Text color="#FFFFFF" fontStyle="Bold" resizeTextForBestFit="true" resizeTextMinSize="14" resizeTextMaxSize="36" horizontalOverflow="Wrap" verticalOverflow="Truncate" />
  <Panel class="npc_sheet_root" active="true" rectAlignment="MiddleCenter" width="3090" height="2000" scale="0.1 0.1 0.1" position="0 0 -13" rotation="0 0 180" pivot="0.5 0.5" />
  <HorizontalLayout class="npc_sheet_halves" width="100%" height="100%" spacing="0" childForceExpandWidth="true" childForceExpandHeight="true" padding="40 40 80 60" />
  <VerticalLayout class="npc_page_pane" preferredWidth="1505" flexibleWidth="1" height="100%" spacing="12" childForceExpandWidth="true" childForceExpandHeight="false" childAlignment="UpperCenter" padding="20 30 20 20" />
  <Text class="npc_name_title" fontSize="42" preferredHeight="48" alignment="MiddleCenter" />
  <Text class="npc_clan_sect_rank" fontSize="28" preferredHeight="36" alignment="MiddleCenter" />
  <Text class="npc_kind_subkind_coterie" fontSize="26" preferredHeight="34" alignment="MiddleCenter" />
  <HorizontalLayout class="npc_status_row" preferredHeight="34" spacing="20" childForceExpandWidth="true" childForceExpandHeight="false" />
  <Text class="npc_sect_status" fontSize="24" alignment="MiddleLeft" />
  <Text class="npc_clan_status" fontSize="24" alignment="MiddleRight" />
  <Text class="npc_section_label" fontSize="30" preferredHeight="40" alignment="MiddleLeft" color="#c5c799" />
  <Text class="npc_tracker_label" fontSize="22" preferredWidth="100" alignment="MiddleLeft" />
  <HorizontalLayout class="npc_tracker_block" preferredHeight="36" spacing="6" childForceExpandWidth="false" childForceExpandHeight="false" childAlignment="MiddleLeft" />
  <HorizontalLayout class="npc_tracker_slots" preferredHeight="36" spacing="2" childForceExpandWidth="false" childForceExpandHeight="false" childAlignment="MiddleLeft" />
  <Image class="npc_tracker_dot" preferredHeight="28" preferredWidth="28" preserveAspect="true" raycastTarget="false" active="false" />
  <Image class="npc_tracker_box" preferredHeight="32" preferredWidth="32" preserveAspect="true" raycastTarget="false" active="false" />
  <HorizontalLayout class="npc_trackers_row" preferredHeight="36" spacing="16" childForceExpandWidth="false" childForceExpandHeight="false" childAlignment="MiddleLeft" />
  <HorizontalLayout class="npc_standard_pool_row" preferredHeight="34" spacing="16" childForceExpandWidth="true" childForceExpandHeight="false" />
  <Text class="npc_standard_pool" fontSize="24" alignment="MiddleCenter" />
  <HorizontalLayout class="npc_exceptional_pool_columns" preferredHeight="120" spacing="12" childForceExpandWidth="true" childForceExpandHeight="false" />
