<!-- Player HUD Overlays defaults -->
<!-- Agent guidance: .dev/TTS_BUNDLING_SETUP.md (generator); .dev/HUDs & Overlays/Player HUD Overview.md (overlays). -->
<!-- TTS: UI.show / UI.hide play showAnimation / hideAnimation. Each element needs BOTH attributes on -->
<!-- the same class merge — splitting fade into two classes that both set showAnimation broke hides -->
<!-- (hideAnimation never set; FadeOut/Shrink assigned incorrectly as showAnimation). -->

<Defaults>
  <Image class="player_overlay"
    active="false"
    width="1920"
    height="1200"
    preserveAspect="true"
    raycastTarget="false"
    rectAlignment="MiddleCenter"
  />

  <Image class="squeeze_overlay"
    height="100%"
    preserveAspect="false"
  />

  <!-- Transition blindfold Panel: same art box as overlay_globalBlindfold (root sibling in Global.xml, TOR-436).

  Testing possible bug with slide animations. Temp change
   from `showAnimation="SlideIn_Top"` and `hideAnimation="SlideOut_Top"`.
   -->
  <Panel class="playerHud_blindfoldOverlay"
    active="false"
    width="1920"
    height="1200"
    rectAlignment="MiddleCenter"
    raycastTarget="true"
    showAnimation="FadeIn"
    hideAnimation="FadeOut"
    animationDuration="2"
    hideAnimationDelay="1"
  />

  <Image class="overlay_anim_fade"
    showAnimation="FadeIn"
    hideAnimation="FadeOut"
    animationDuration="0.3"
  />
  <Image class="overlay_anim_grow"
    showAnimation="FadeIn"
    hideAnimation="FadeOut"
    animationDuration="0.35"
  />
  <Image class="overlay_anim_slide_top"
    showAnimation="FadeIn"
    hideAnimation="FadeOut"
    animationDuration="1"
  />

  <Panel class="playerHud_overlay_camera"
    width="622"
    height="204"
    rectAlignment="LowerRight"
    offsetXY="0 0"
  />

  <Panel class="cameraControls_left"
    width="417"
    height="100%"
    rectAlignment="MiddleLeft"
    offsetXY="0 0"
    padding="10 40 10 10"
  />

  <Panel class="cameraControls_right"
    width="205"
    height="100%"
    rectAlignment="MiddleRight"
    offsetXY="0 0"
    padding="20 30 10 10"
  />

  <Image class="popoutControl_camera"
    raycastTarget="true"
    rectAlignment="LowerRight"
    height="100"
    width="100"
    color="rgba(1, 1, 1, 1)" />

  <Image class="alpha_control"
    color="rgba(1, 1, 1, 0.15)"
    raycastTarget="true"
    onMouseEnter="HUD_alphaControl_hoverOn"
    onMouseExit="HUD_alphaControl_hoverOff"
  />

  <Image class="camera_control"
    raycastTarget="true"
    onClick="HUD_cameraControl_click"
  />


  <!-- Per-seat lower-left location card popout (see `ui/.templates/panel_overlay_location.xml`). Hover lives on `popout_locationPanel_<Color>` only; root does not raycast. -->
  <Panel class="playerHud_overlay_location" height="800" width="1000" rectAlignment="LowerLeft" offsetXY="0 0" raycastTarget="false" />

  <Image class="popoutControl_location" raycastTarget="true" rectAlignment="LowerLeft" height="100" width="100" color="rgba(1, 1, 1, 1)" />

  <Image class="gameStateOverlay_district" rectAlignment="UpperLeft" width="800" offsetXY="0 0" active="false" />
  <Image class="gameStateOverlay_site" rectAlignment="LowerLeft" width="800" offsetXY="300 0" active="false" />

  <!-- Destination District/Site cards over scene-transition blindfolds (TOR-425). Tune animationDelay on these classes to stagger vs blindfold slide. -->
  <Image class="player_overlay_district_card_display"
    raycastTarget="false"
    preserveAspect="true"
    rectAlignment="LowerLeft"
    width="900"
    offsetXY="50 75"
    showAnimation="FadeIn"
    hideAnimation="FadeOut"
    animationDuration="1"
    showAnimationDelay="4"
    active = "false"
    image = ""
    color = "clear"
  />
  <Image class="player_overlay_site_card_display"
    raycastTarget="false"
    preserveAspect="true"
    rectAlignment="LowerRight"
    width="900"
    offsetXY="-50 125"
    showAnimation="FadeIn"
    hideAnimation="FadeOut"
    animationDuration="1"
    showAnimationDelay="4.5"
    active = "false"
    image = ""
    color = "clear"
  />
</Defaults>
