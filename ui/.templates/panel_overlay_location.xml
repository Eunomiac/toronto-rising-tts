<!-- TARGET: ui/player/panel_overlay_location.xml -->
<!-- Agent guidance: .dev/TTS_BUNDLING_SETUP.md (generator); .dev/HUDs & Overlays/Player HUD Overview.md (map panels). -->
<!-- TOR-444: district card stack collapsed to one Image + image= (session district is shared chronicle state). -->
<!-- Visibility: TTS `UI.show` / `UI.hide` play showAnimation/hideAnimation (tts-api UI API/Attributes.md). -->

<Panel id="gameStateOverlay_location_@@color@@" class="playerHud_overlay_location" visibility="@@color@@" raycastTarget="false">

  <Image id="popout_locationPanel_@@color@@" class="popoutControl_location" image="popoutControl_location"
    onMouseEnter="HUD_locationOverlay_hoverOn"
    onMouseExit="HUD_locationOverlay_hoverOff" />

  <Panel id="gameStateOverlay_locationPanel_@@color@@" class="gameStateOverlay_locationPanel" active="false" raycastTarget="false">

    <!-- District card: Lua sets `image` to districtCard_<key> then activates. -->
    <Image class="gameStateOverlay_district" id="gameStateOverlay_districtCard_current_@@color@@" active="false" image="" />

    <!-- Site card: default inactive + empty `image`; Lua sets `image` then activates (see `core/hud_player.ttslua`). -->
    <Image class="gameStateOverlay_site" id="gameStateOverlay_siteCard_current_@@color@@" active="false" image="" />
  </Panel>
</Panel>
