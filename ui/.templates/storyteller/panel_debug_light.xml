      </Panel>
      <Panel id="db_intensity_container_bottom" class="debug_light_control_container_bottom">
        <Text id="debug_light_slider_label_left_intensity" class="debug_light_slider_label slider_label_left">0.00</Text>
        <Text id="debug_light_slider_label_center_intensity" class="debug_light_slider_label slider_label_center">3.23</Text>
        <Text id="debug_light_slider_label_right_intensity" class="debug_light_slider_label slider_label_right">10.00</Text>
      </Panel>
    </VerticalLayout>
    <VerticalLayout id="db_angle_container" class="debug_light_control_container">
