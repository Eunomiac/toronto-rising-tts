      </Panel>
      <Panel id="db_angle_container_bottom" class="debug_light_control_container_bottom">
        <Text id="debug_light_slider_label_left_angle" class="debug_light_slider_label slider_label_left">0</Text>
        <Text id="debug_light_slider_label_center_angle" class="debug_light_slider_label slider_label_center">90</Text>
        <Text id="debug_light_slider_label_right_angle" class="debug_light_slider_label slider_label_right">180</Text>
      </Panel>
