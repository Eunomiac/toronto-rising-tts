    <VerticalLayout id="scatterModeControlGroup1_container_@@color@@" class="scatterModeControl_group_container">
      <HorizontalLayout id="db_scatterModeControlGroup1_selectorContainer_@@color@@" class="scatterModeControl_selectorContainer">
        <!-- AGENT: This image is an interactive button. By default, its image is "scatterGroupSelector_inactive". However, the button for the scatter group that this PC is currently occupying should be set to "scatterGroupSelector_active".
        - ON HOVER: change the image to "scatterGroupSelector_hover", then revert on hover-off.
        - ON CLICK: move the PC to the scatter group they clicked on (no-op if they click on the group they're currently occupying — the strip stays open). On a real move, update selectors and pcRows for all colors, then close the strip for that player only. -->
        <Image id="scatterModeControlGroup1_selector_@@color@@" class="scatterModeControl_selector" image="scatterGroupSelector_inactive" onClick="HUD_scatterModeControl_selectorClick" onMouseEnter="HUD_scatterModeControl_selectorHoverOn" onMouseExit="HUD_scatterModeControl_selectorHoverOff" />
      </HorizontalLayout>
