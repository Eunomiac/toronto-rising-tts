  <!-- AGENT: scatterModeControlToggleHit is the visible toggle Image (inactive + hover assets).
    A pad Panel keeps click/hover working when that Image is hidden (strip open).
    - Not Scatter: Hit active=false.
    - Scatter, strip closed: Hit active=true, image=scatterGroupToggle_inactive; hover swaps image to scatterGroupToggle_hover.
    - Scatter, strip open: Hit active=false, image=scatterGroupToggle_hover (open art is baked into the strip bg); hover sets Hit active=true.
    - on CLICK: toggle the two HorizontalLayouts above. -->

  <Panel id="scatterModeControlTogglePad_@@color@@" class="scatterModeControl_toggleHit" onClick="HUD_scatterModeControl_toggleClick" onMouseEnter="HUD_scatterModeControl_toggleHoverOn" onMouseExit="HUD_scatterModeControl_toggleHoverOff">
