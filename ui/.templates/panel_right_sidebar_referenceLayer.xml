<!-- TARGET: ui/player/panel_right_sidebar_referenceLayer.xml -->
<!-- Agent guidance: .dev/TTS_BUNDLING_SETUP.md (generator); .dev/HUDs & Overlays/Player HUD Overview.md (reference layers). -->

<!--
UI.setAttributes("playerHud_referenceLayer_Red", {color = "rgba(1, 0, 0, 0.15)"})

-->
<Panel id="playerHud_referenceLayer_@@color@@" class="popupImageContainer" visibility="@@color@@">

  <!-- Project block classes come from ui/defaults_classes.xml (Global include). Do not
       Include csheet_defaults here: Global resolves paths under ui/, so ui/player/... fails,
       and nesting a second Defaults block five times per seat is unnecessary. -->

  <Defaults>

    <Panel class="princesCourt-reference"
      width = "1500"
      height = "975"
      offsetXY = "-50 0" />

    <Image rectAlignment="MiddleLeft" />

    <Image class="box"
      rectAlignment = "MiddleLeft"
      preserveAspect = "true"
      raycastTarget = "false"
      active = "true" />

    <Image class="navButton"
      height = "128"
      width = "50"
      color = "rgba(1, 1, 1, 0.25)"
      preserveAspect = "true" />

    <Image class="navButton_left"
      rectAlignment = "MiddleLeft"
      offsetXY = "-40 0" />

    <Image class="navButton_right"
      rectAlignment = "MiddleRight"
      offsetXY = "40 0" />

    <Image class="princeCourt_page"
      height = "100%"
      preserveAspect = "true" />

    <Image class="dot_large"
      rectAlignment = "UpperLeft"
      height = "60"
      width = "60"
      active = "true" />

    <Image class="box_standard"
      height = "24"
      width = "24"
      active = "true" />

    <!-- <Image class="box_text_title_dot" height = "20" width = "20" /> -->

    <VerticalLayout class="page"
      width = "710"
      padding = "8 8 50 50" />

    <VerticalLayout class="page_right"
      rectAlignment = "MiddleRight"
      offsetXY = "-20 0" />

    <VerticalLayout class="page_left"
      rectAlignment = "MiddleLeft"
      offsetXY = "20 0" />

    <Text class="box_text" resizeTextMinSize = "8" resizeTextMaxSize = "14" />
    <Text class="box_text_title_text" resizeTextMinSize = "8" resizeTextMaxSize = "14" />

    <VerticalLayout class="box_text_container" padding="5 5 0 0" />
      <HorizontalLayout class="1_dot" padding="0 20 0 0" />
  <HorizontalLayout class="2_dots" padding="0 40 0 0" />
  <HorizontalLayout class="3_dots" padding="0 60 0 0" />
  <HorizontalLayout class="4_dots" padding="0 80 0 0" />
  <HorizontalLayout class="5_dots" padding="0 100 0 0" />
  <HorizontalLayout class="6_dots" padding="0 120 0 0" />

  </Defaults>

  <!-- Nestedless refPanels live in ui/shared/panel_ref_panels_nestedless.xml (TOR-444 shared). -->

