<!-- TARGET: ui/player/panel_overlay_blindfold.xml -->
<!-- Per-player scene/table transition blindfolds only (hudBlindfold). active=false by default. -->
<!-- Phases must not drive these — use ui/shared/panel_overlay_global_blindfold.xml instead. -->
<!-- Agent guidance: .dev/TTS_BUNDLING_SETUP.md (generator); .dev/HUDs & Overlays/Player HUD Overview.md (map panels). -->
<!-- Visibility: UI.show / UI.hide on the PARENT Panel animates the panel and any active children (TOR-431). -->
<!--
  Placement (TOR-436): root Include in Global.xml beside overlay_globalBlindfold (not under HUD_PANEL_PLAYER).
  Geometry: match global blindfold — width 1920 height 1200 rectAlignment MiddleCenter (playerHud_blindfoldOverlay).
  Parent: SlideIn_Top / SlideOut_Top, duration 2, hideDelay 1.
  Children: arm active=true BEFORE parent UI.show; do not UI.show children separately.
  Cards: with location set White+image; without location keep Clear + empty image (invisible if animated).
  Hide: UI.hide(parent) → wait ~3s → restore child defaults only (not the parent).
-->

<Panel id="playerHud_overlay_blindfold_@@color@@" class="playerHud_blindfoldOverlay" visibility="@@color@@">
  <Image id="overlay_blindfold_1_@@color@@" image="overlay_blindfold_1" class="player_overlay" />
