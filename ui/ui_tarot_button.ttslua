---@diagnostic disable: lowercase-global
--[[
    Tarot Toggle Button (ui/ui_tarot_button.ttslua)

    Attached to TAROT_BUTTON_PINK. Clicking toggles Tarot drawer/deck/button
    between C.ObjectPositions on/off states via GlobalApplyTarotState (host-only).
]]

local CU = require("lib.csheet_util")

local isOn = false
local desiredOn = false

local BUTTON_WIDTH = 5000
local BUTTON_HEIGHT = 700
local TOP_BUTTON_POS = { 0, 0.18, 0 }
local BOTTOM_BUTTON_POS = { 0, -0.18, 0 }
local BOTTOM_BUTTON_ROT = { 180, 0, 0 }

--- @param event string
--- @param details table|nil
--- @return boolean
local function verboseLog(event, details)
    if Global == nil or type(Global.call) ~= "function" then
        return false
    end
    return Global.call("GlobalInteractionVerboseLog", {
        component = "TarotButton",
        event = event,
        details = type(details) == "table" and details or {},
    }) == true
end

--- @return table|nil
local function getSeatLayoutCenterPoint()
    if Global ~= nil and type(Global.call) == "function" then
        local cp = Global.call("GlobalGetSeatLayoutCenterPoint")
        if type(cp) == "table" and type(cp.x) == "number" and type(cp.y) == "number" and type(cp.z) == "number" then
            return cp
        end
    end
    return nil
end

--- @return boolean
local function isSeatLayoutReady()
    return getSeatLayoutCenterPoint() ~= nil
end

--- @param callback function
--- @param attempt number|nil
local function runWhenSeatLayoutReady(callback, attempt)
    if type(callback) ~= "function" then
        return
    end
    local startAttempt = tonumber(attempt) or 1
    if startAttempt < 1 then
        startAttempt = 1
    end
    local maxAttempts = 10
    local baseDelaySeconds = 0.1
    local maxDelaySeconds = 2.0

    local function getBackoffDelaySeconds(currentAttempt)
        local exponent = currentAttempt - 1
        local delay = baseDelaySeconds * (2 ^ exponent)
        if delay > maxDelaySeconds then
            return maxDelaySeconds
        end
        return delay
    end

    local function retry(currentAttempt)
        if isSeatLayoutReady() then
            verboseLog("seat-layout-ready", { attempt = currentAttempt })
            callback()
            return
        end
        if currentAttempt >= maxAttempts then
            verboseLog("seat-layout-timeout", { attempts = currentAttempt })
            print("[TarotButton] seatLayout.currentTableKey is not ready after retries; skipping tarot toggle.")
            return
        end
        local delaySeconds = getBackoffDelaySeconds(currentAttempt)
        verboseLog("seat-layout-wait", { attempt = currentAttempt, delaySeconds = delaySeconds })
        CU.await(function()
            retry(currentAttempt + 1)
        end, delaySeconds)
    end

    retry(startAttempt)
end

local function createClickButtons()
    self.clearButtons()
    self.createButton({
        click_function = "click_tarotToggle",
        function_owner = self,
        position = TOP_BUTTON_POS,
        height = BUTTON_HEIGHT,
        width = BUTTON_WIDTH,
        color = { 1, 1, 1, 0 },
        hover_color = { 0.7, 0.5, 1, 0.18 },
        press_color = { 0.5, 0.3, 1, 0.28 },
    })
    self.createButton({
        click_function = "click_tarotToggle",
        function_owner = self,
        position = BOTTOM_BUTTON_POS,
        rotation = BOTTOM_BUTTON_ROT,
        height = BUTTON_HEIGHT,
        width = BUTTON_WIDTH,
        color = { 1, 1, 1, 0 },
        hover_color = { 0.7, 0.5, 1, 0.18 },
        press_color = { 0.5, 0.3, 1, 0.28 },
    })
end

function onSave()
    return JSON.encode({ isOn = isOn })
end

function onLoad(savedData)
    if type(savedData) == "string" and savedData ~= "" then
        local parsed = JSON.decode(savedData)
        if type(parsed) == "table" and type(parsed.isOn) == "boolean" then
            isOn = parsed.isOn
        end
    end
    -- Keep the visible world control selectable; its two scripted buttons cover the top and bottom faces.
    self.interactable = not self.hasTag("HiddenObject")
    createClickButtons()
    verboseLog("loaded", {
        guid = self.getGUID(),
        interactable = self.interactable == true,
        hidden = self.hasTag("HiddenObject") == true,
        buttonCount = #(self.getButtons() or {}),
        savedOn = isOn,
    })
    runWhenSeatLayoutReady(function()
        local inferred = isOn
        if Global ~= nil and type(Global.call) == "function" then
            inferred = Global.call("GlobalInferTarotState", {
                buttonGuid = self.getGUID(),
                fallback = isOn,
            })
        end
        if type(inferred) == "boolean" then
            isOn = inferred
        end
        desiredOn = isOn
    end)
end

--- @param _obj Object
--- @param clickColor string
function click_tarotToggle(_obj, clickColor)
    verboseLog("click-received", {
        guid = self.getGUID(),
        clickerColor = clickColor,
        interactable = self.interactable == true,
        hidden = self.hasTag("HiddenObject") == true,
        buttonCount = #(self.getButtons() or {}),
        isOn = isOn,
        desiredOn = desiredOn,
    })
    if clickColor ~= "Pink" and clickColor ~= "Black" then
        verboseLog("click-rejected", { reason = "wrong-clicker-color", clickerColor = clickColor })
        print("[TarotButton] Only Pink (or GM) can toggle tarot objects.")
        return
    end
    runWhenSeatLayoutReady(function()
        desiredOn = not desiredOn
        local applied = nil
        if Global ~= nil and type(Global.call) == "function" then
            applied = Global.call("GlobalApplyTarotState", {
                targetOn = desiredOn,
                buttonGuid = self.getGUID(),
                playerColor = clickColor,
            })
        end
        if type(applied) == "boolean" then
            isOn = applied
            desiredOn = applied
            verboseLog("click-applied", { clickerColor = clickColor, appliedOn = applied })
        else
            desiredOn = not desiredOn
            verboseLog("click-failed", { clickerColor = clickColor, targetOn = not desiredOn })
            print("[TarotButton] GlobalApplyTarotState failed; reverted desired state.")
        end
    end)
end

--- Emergency recovery entry called by Storyteller Debug → Reboot Interactions.
--- Rebuilds both face buttons and rehydrates local desired state without changing the live Tarot state.
--- @return table
function rebootInteractions()
    createClickButtons()
    local hidden = self.hasTag("HiddenObject") == true
    if not hidden then
        self.interactable = true
    end
    local inferred = Global.call("GlobalInferTarotState", {
        buttonGuid = self.getGUID(),
        fallback = isOn,
    })
    if type(inferred) == "boolean" then
        isOn = inferred
        desiredOn = inferred
    end
    local result = {
        guid = self.getGUID(),
        hidden = hidden,
        interactable = self.interactable == true,
        buttonCount = #(self.getButtons() or {}),
        inferredOn = isOn,
    }
    verboseLog("rebooted", result)
    return result
end
