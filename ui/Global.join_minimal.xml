<!-- Join-stress minimal Global XmlUI (TOR-439 diagnostic spike). -->
<!-- Host arms this via Phases → Arm Join XML before a struggling client connects. -->
<!-- Not the permanent save default — Remount with full embed via Refresh / Disarm. -->
<!-- Include paths: same rules as ui/Global.xml (relative to this file's directory / ui/). -->
<!-- Stacking: Global XmlUI draws later siblings above earlier ones. Keep session-start BEFORE Host chrome -->
<!-- (same as ui/Global.xml: overlay_sessionStart_panel, then HUD_PANEL_BLACK / ST toolbar). -->

<!-- 1. Tag-based defaults -->
<Include src="defaults_tags.xml" />

<!-- 2. Shared classes -->
<Include src="defaults_classes.xml" />

<!-- 3. Storyteller defaults needed by Phases join chrome -->
<Include src="storyteller/hud_storyteller_defaults.xml" />
<Include src="storyteller/panel_join_xml_chrome_defaults.xml" />

<!-- 4. Session-start overlay (Intermission cover for all clients; HUD canary). -->
<Include src="shared/panel_overlay_session_start.xml" />

<!-- 5. Slim Host chrome AFTER blindfold — Phases must draw above Intermission cover. -->
<!-- Full-screen clear root (like full ST HUD) so UpperLeft chrome is a later sibling of the Image. -->
<Panel id="HUD_PANEL_BLACK" visibility="Black|Host"
  width="1920" height="1200" rectAlignment="MiddleCenter"
  color="clear" raycastTarget="false">
  <!-- ignoreLayout: padding would turn this into a LayoutGroup and can bury children. -->
  <Panel id="joinXmlChromeRoot" visibility="Host" active="true"
    ignoreLayout="true"
    rectAlignment="UpperLeft" offsetXY="20 -20" width="520" height="720"
    color="rgba(0,0,0,0.85)">
    <Include src="storyteller/panel_phases.xml" />
  </Panel>
</Panel>
