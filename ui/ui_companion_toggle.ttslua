---@diagnostic disable: lowercase-global
--[[
    Companion Toggle Token (ui/ui_companion_toggle.ttslua)

    Object stub: require("ui.ui_companion_toggle") on tiles with GMNotes
    COMPANION_TOGGLE_A_RED / _A_BROWN / Purple siblings (same pattern as objects.dice_bag).

    Uses TTS createButton (not XmlUI). LEFT: toggle famulus on/off (Global swaps tile
    front/back images — no rotX flip). RIGHT: cycle figurine state 1↔2 if on.
    Routes via GlobalApplyCompanionToggleClick (TOR-288).
]]

local BUTTON_WIDTH = 900
local BUTTON_HEIGHT = 900
--- Local +Y above the tile top face (token stays face-up; enabled/disabled is image swap).
local BUTTON_Y = 0.2

--- @param event string
--- @param details table|nil
--- @return boolean
local function verboseLog(event, details)
    if Global == nil or type(Global.call) ~= "function" then
        return false
    end
    return Global.call("GlobalInteractionVerboseLog", {
        component = "CompanionToggle",
        event = event,
        details = type(details) == "table" and details or {},
    }) == true
end

local function createClickButtons()
    self.clearButtons()
    self.createButton({
        click_function = "click_companionToggle",
        function_owner = self,
        label = "",
        position = { 0, BUTTON_Y, 0 },
        height = BUTTON_HEIGHT,
        width = BUTTON_WIDTH,
        color = { 1, 1, 1, 0 },
        hover_color = { 0.9, 0.7, 0.5, 0.2 },
        press_color = { 0.8, 0.5, 0.3, 0.3 },
    })
end

function onLoad(_savedData)
    self.interactable = not self.hasTag("HiddenObject")
    createClickButtons()
    local rot = self.getRotation()
    verboseLog("loaded", {
        guid = self.getGUID(),
        interactable = self.interactable == true,
        hidden = self.hasTag("HiddenObject") == true,
        rotation = { x = rot.x, y = rot.y, z = rot.z },
        buttonCount = #(self.getButtons() or {}),
    })
end

--- @param _obj Object
--- @param clickColor string
--- @param altClick boolean|string|nil  true / "-2" / right-click
function click_companionToggle(_obj, clickColor, altClick)
    -- TTS createButton: alt_click true for non-left; some hosts pass string/number forms.
    local isAlt = altClick == true
        or altClick == "-2"
        or altClick == -2
        or tostring(altClick) == "true"
        or tostring(altClick) == "True"
    local rot = self.getRotation()
    verboseLog("click-received", {
        guid = self.getGUID(),
        clickerColor = clickColor,
        altClick = isAlt,
        interactable = self.interactable == true,
        hidden = self.hasTag("HiddenObject") == true,
        rotation = { x = rot.x, y = rot.y, z = rot.z },
        buttonCount = #(self.getButtons() or {}),
    })
    if Global == nil or type(Global.call) ~= "function" then
        print("[CompanionToggle] Global.call unavailable")
        return
    end
    local result = Global.call("GlobalApplyCompanionToggleClick", {
        toggleGuid = self.getGUID(),
        playerColor = clickColor,
        altClick = isAlt,
    })
    verboseLog("click-routed", {
        guid = self.getGUID(),
        clickerColor = clickColor,
        altClick = isAlt,
        result = result,
    })
end

--- Emergency recovery entry called by Storyteller Debug → Reboot Interactions.
--- @return table
function rebootInteractions()
    createClickButtons()
    local hidden = self.hasTag("HiddenObject") == true
    if not hidden then
        self.interactable = true
    end
    local rot = self.getRotation()
    local result = {
        guid = self.getGUID(),
        hidden = hidden,
        interactable = self.interactable == true,
        rotation = { x = rot.x, y = rot.y, z = rot.z },
        buttonCount = #(self.getButtons() or {}),
    }
    verboseLog("rebooted", result)
    return result
end
