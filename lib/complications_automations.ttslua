-- Registration boundary for reviewed card effects.
-- Handlers plan saved-state changes and journal operations; core.complications executes
-- the journal. They must not perform immediate world mutations or schedule callbacks.
local A = {}
local Catalog = require("lib.complications_catalog")
local entries = {}
function A.register(key, handler)
    assert(type(key)=='string' and key~="" and not entries[key], 'Duplicate/invalid automation key')
    assert(type(handler.apply)=='function' and type(handler.reverse)=='function', 'Automation needs apply and reverse')
    entries[key]=handler
end
local function keyFor(index)
    local card = Catalog[index]
    local key = card and card.automationKey
    if key ~= nil then assert(entries[key], "Unknown Complication automation key: " .. tostring(key)) end
    return key
end
function A.has(index) return keyFor(index)~=nil end
function A.validateCatalog()
    for index in pairs(Catalog) do keyFor(index) end
end
function A.run(g, guid, reverse)
    local c=g.cards[guid]
    local key=c and keyFor(c.index)
    local handler=key and entries[key]
    if not handler or not c.up or c.zone~='slot' then return false end
    g.automations=g.automations or {}
    local receipt=g.automations[guid]
    if reverse==nil then reverse=receipt~=nil end
    if reverse then
        if not receipt then return false end
        assert(receipt.key==key and type(receipt.value)=='table', "Invalid Complication automation receipt for " .. key)
        handler.reverse(g,guid,receipt.value)
        g.automations[guid]=nil
    else
        if receipt then return false end
        -- Return a serializable receipt recording exactly this source's contribution.
        -- Keep its variant even if the card is subsequently enhanced/unenhanced.
        receipt=handler.apply(g,guid,c.enhanced==true)
        if receipt==nil then return false end
        assert(type(receipt)=='table','Automation must return a saved reversal receipt')
        g.automations[guid]={key=key,value=receipt}
    end
    return true
end
return A
