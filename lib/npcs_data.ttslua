--- Storyteller Dashboard token configuration overrides (generated `lib/npc_overrides.ttslua`), keyed by NPC key:
--- `{ name?, cardScale?, seatedY? }`. Named NPCs take `name` / `cardScale` here; generic NPCs in `D.initGenericNPCs`
--- and `NPCS.registerGenericCharacter`; `seatedY` is read by `lib/figurine_seat_layout`.
D.overrides = require("lib.npc_overrides")

--- Custom Figurine card scale (`ImageScalar`) of an NPC whose override sets no `cardScale`.
D.DEFAULT_FIGURINE_SCALE = 53

for key, def in pairs(D.characters) do
  local override = D.overrides[key] or {}
  if type(override.name) == "string" then
    def.fullName = override.name
  end
  def.figurine = { scale = override.cardScale or D.DEFAULT_FIGURINE_SCALE }
end

--- @type table<string, table>|nil generic catalog key → `{ key, label }` (built by `D.initGenericNPCs`)
D.genericNpcs = nil

--- Generic catalog entry `{ key, label }` for a key like `academicsProfessor_02`; nil when unknown or without art.
--- @param fullKey string
--- @return table|nil entry
function D.resolveGenericNpcEntry(fullKey)
  if type(fullKey) ~= "string" or D.genericNpcs == nil then
    return nil
  end
  return D.genericNpcs[fullKey]
end

--- Generic NPCs available to import: every generated `lib.npc_art_urls` row with a `genericLabel` (a Generics Export
--- sheet row whose figurine has art; `npm run npc-art:draw` reports sheet rows without one).
function D.initGenericNPCs()
  local genericNpcs = {}
  for key, art in pairs(require("lib.npc_art_urls")) do
    if art.genericLabel ~= nil then
      local override = D.overrides[key]
      genericNpcs[key] = { key = key, label = (override and override.name) or art.genericLabel }
    end
  end
  for key, row in pairs(require("lib.memoriam_npc_catalog")) do
    if type(row) == "table" and row.isGeneric == true and genericNpcs[key] == nil then
      local override = D.overrides[key]
      genericNpcs[key] = { key = key, label = (type(override) == "table" and override.name) or row.label or key }
    end
  end
  if next(genericNpcs) == nil then
    error("lib.npc_art_urls has no generic NPC rows (genericLabel) — run npm run build:full")
  end
  D.genericNpcs = genericNpcs
end

--- NPC-only view of `D.characters` (excludes PCs flagged `isPC = true`).
--- Stage management — NPC spawns, stage tokens, NPC group enumeration — must use this so PC
--- characters do not generate NPC figurines or stage tokens.
--- Keyed lookups (`D.characters[key]`) and display-name resolution still use the full table.
--- @return table<string, table> characterKey -> def (NPCs only)
function D.getNpcCharacters()
    local out = {}
    for key, def in pairs(D.characters or {}) do
        if type(def) == "table" and def.isPC ~= true then
            out[key] = def
        end
    end
    return out
end

--- Lower-cased key / fullName / name -> D.characters key. `D.characters` is static after load.
--- Keys win over full names, full names over short names.
local displayNameIndex = nil

--- @return table<string, string>
local function getDisplayNameIndex()
    if displayNameIndex ~= nil then
        return displayNameIndex
    end
    local index = {}
    local function add(label, key)
        if type(label) == "string" then
            local lower = string.lower(label)
            if index[lower] == nil then
                index[lower] = key
            end
        end
    end
    local characters = D.characters or {}
    for key in pairs(characters) do
        if type(key) == "string" then
            add(key, key)
        end
    end
    for _, field in ipairs({ "fullName", "name" }) do
        for key, def in pairs(characters) do
            if type(key) == "string" and type(def) == "table" then
                add(def[field], key)
            end
        end
    end
    displayNameIndex = index
    return index
end

--- Case-insensitive display name → D.characters key (CustomUIAssets cutout name).
-- @param displayName string
-- @return string|nil
function D.resolveCharacterKeyByDisplayName(displayName)
    if type(displayName) ~= "string" then
        return nil
    end
    local needle = U.trim(displayName)
    if needle == "" then
        return nil
    end
    return getDisplayNameIndex()[string.lower(needle)]
end

--- Non-generic Memoriam NPCs join the named roster so a stage drop can spawn them.
--- `werewolf` follows variantOfUnique when the catalogued NPC is a werewolf.
local function memoriamWerewolf(key, seen)
    if seen[key] then
        return false
    end
    seen[key] = true
    local existing = D.characters[key]
    if type(existing) == "table" and existing.werewolf == true then
        return true
    end
    local row = require("lib.memoriam_npc_catalog")[key]
    if type(row) ~= "table" then
        return false
    end
    local target = row.variantOfUnique
    if type(target) ~= "string" or target == "" then
        return false
    end
    return memoriamWerewolf(target, seen)
end

local memoriamCatalog = require("lib.memoriam_npc_catalog")
for key, row in pairs(memoriamCatalog) do
    if type(key) == "string" and type(row) == "table" and row.isGeneric ~= true and D.characters[key] == nil then
        local override = D.overrides[key] or {}
        local def = {
            name = key,
            fullName = (type(override.name) == "string" and override.name) or row.label or key,
            figurine = { scale = override.cardScale or D.DEFAULT_FIGURINE_SCALE },
        }
        if memoriamWerewolf(key, {}) then
            def.werewolf = true
        end
        D.characters[key] = def
    end
end

return D
