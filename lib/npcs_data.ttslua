--[[
    Static NPC layout and character definitions for core/npcs.ttslua.
    Image URLs are not here: every NPC's art links come from generated lib/npc_art_urls.ttslua.

    Agent guidance: .dev/NPC Object Spawning & Spotlighting/NPC Object Overview.md; .dev/Chronicle Data/NPCS_*.md;
    .dev/Game State Data.jsonc (instance examples).
]]

local U = require("lib.util")

local D = {}

D.lights = {
  OFF = {
    enabled = false,
    color = Color(1, 1, 1),
    range = 100,
    intensity = 0,
    angle = 88,
    positioning = {
      deltaUp = 5,
      deltaInward = 3,
      lookAtYShift = 0.1
    }
  },
  STANDARD = {
    enabled = true,
    color = Color(1, 1, 1),
    range = 100,
    intensity = 3,
    angle = 88,
    positioning = {
      deltaUp = 5,
      deltaInward = 3,
      lookAtYShift = 0.1
    }
  },
  SPOTLIGHT = {
    enabled = true,
    color = Color(1, 1, 0.75),
    range = 130,
    intensity = 7,
    angle = 45,
    positioning = {
      deltaUp = 25,
      deltaInward = 10,
      lookAtYShift = 0.1,
    }
  },
  --- Sibling dim while another figurine in the same snap family is SPOTLIGHT (TOR-473).
  --- Not written by token flip / placement scan — runtime companion mode only.
  OFFSPOTLIGHT = {
    enabled = true,
    color = Color(1, 1, 1),
    range = 100,
    intensity = 2,
    angle = 88,
    positioning = {
      deltaUp = 5,
      deltaInward = 3,
      lookAtYShift = 0.1
    }
  }
}

