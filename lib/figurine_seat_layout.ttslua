--[[
    Figurine-anchored numbered-slot layout (lib/figurine_seat_layout.ttslua) — TOR-507.

    Occupancy lives on sessionScene.seatSlots[occupant].tableSlot.
    Geometry: slot 1 = C.Tables[].referenceFigurine; even slots walk right, odd slots >1 walk left.
    Satellites: C.SeatRoleOffsets (extraByOccupant → player → shared) for always-on furniture
    and **anchors** only.
    Pose authority: if an object has a C.ObjectPositions entry (tarot deck/drawer/button,
    CSHEET_DICE_DRAWER_*, …), layout must not place it from SeatRoleOffsets. Layout moves
    anchors, then re-applies ObjectPositions on/off (TarotToggle / DiceDrawer).
    Occupancy hide (unoccupied PC / unused NPC pile) stashes Y=-200 — including the player hand
    zone, whose cards go into the player's storage container — and records in-session Y on
    seatLayout.absentPileY
    so restore can lift table-height roles without flattening feature-hide Y
    (CSHEET pages, SIGNAL_FIRE, HUNGER_SMOKE) — TOR-512 / TOR-513.
    Cover transitions onto `isRandomSeating` tables (Table B) shuffle packed occupancy (TOR-537).
]]

local U = require("lib.util")
local C = require("lib.constants")
local S = require("core.state")
local SRI = require("lib.seat-role-identity")
local G = require("lib.guids")
local O = require("core.objects")
local FigurineFrame = require("lib.figurine_frame")

local FSL = {}

FSL.DEFAULT_TABLE_SLOTS = C.DefaultTableSlots or {
    Red = 1,
    Orange = 2,
    Pink = 3,
    Brown = 4,
    Purple = 5,
    NPC1 = 6,
    NPC2 = 7,
    NPC3 = 8,
    NPC4 = 9,
}

--- Roles owned by C.ObjectPositions — never place from SeatRoleOffsets.
local OBJECT_POSITIONS_OWNED_ROLES = {
    TAROT_DECK = true,
    TAROT_DRAWER = true,
    TAROT_BUTTON = true,
    CSHEET_DICE_DRAWER = true,
}

local HIDE_Y_FLOOR = -199
local PC_FIGURINE_Y = -55.8166
-- Must match C.SeatRoleOffsets.player.HAND_ZONE.localXZ (world-unit figurine yaw frame).
local HAND_TO_FIG_X = 0.5035
local HAND_TO_FIG_Z = 3.8752
local MAX_SLOT_ANY_TABLE = 10

local function shortestSignedDelta(fromDeg, toDeg)
    local d = toDeg - fromDeg
    while d > 180 do
        d = d - 360
    end
    while d < -180 do
        d = d + 360
    end
    return d
end

local function wrapSeg(seg, numSegments)
    local n = math.floor(tonumber(numSegments) or 1)
    if n < 1 then
        n = 1
    end
    local s = math.floor(tonumber(seg) or 1)
    s = ((s - 1) % n) + 1
    return s
end

--- Slot 1 = refSeg. Even slots walk right (decreasing segment); odd slots >1 walk left (increasing).
local function circularSegmentForSlot(refSeg, numSegments, slot)
    if slot == 1 then
        return wrapSeg(refSeg, numSegments)
    end
    if slot % 2 == 0 then
        return wrapSeg(refSeg - (slot / 2), numSegments)
    end
    return wrapSeg(refSeg + ((slot - 1) / 2), numSegments)
end

local function fanIndex(centerIndex, localSlot)
    if localSlot == 1 then
        return centerIndex
    end
    if localSlot % 2 == 0 then
        return centerIndex - (localSlot / 2)
    end
    return centerIndex + ((localSlot - 1) / 2)
end

local function isPlayerSeatKey(seatKey)
    return U.isIn(seatKey, C.PlayerColors or {})
end

local function isNpcSeatKey(seatKey)
    return U.isIn(seatKey, C.NPCSeats or {})
end

local function liveSeatSlots()
    local ss = S.getStateVal("sessionScene", "seatSlots")
    if U.Type(ss) ~= "table" then
        return {}
    end
    return ss
end

local function ensureSeatRow(ss, occupant)
    local row = ss[occupant]
    if U.Type(row) ~= "table" then
        row = {}
        ss[occupant] = row
    end
    return row
end

local function npcRowHasCharacter(row, occupiedNPCSlots, npcKey)
    if U.Type(row) == "table" then
        if row.slotEmpty == true then
            return false
        end
        if type(row.characterKey) == "string" and row.characterKey ~= "" then
            return true
        end
    end
    if U.Type(occupiedNPCSlots) == "table" then
        local occ = occupiedNPCSlots[npcKey]
        return type(occ) == "string" and occ ~= ""
    end
    return false
end

--- @param tableCfg table|nil
--- @return number
function FSL.getSlotCapacity(tableCfg)
    if U.Type(tableCfg) == "table" and type(tableCfg.slotCapacity) == "number" then
        return math.floor(tableCfg.slotCapacity)
    end
    return 9
end

--- @param tableCfg table|nil
--- @return table frame { position, rotation }
function FSL.getReferenceFigurineFrame(tableCfg)
    if U.Type(tableCfg) == "table" and U.Type(tableCfg.referenceFigurine) == "table"
        and tableCfg.referenceFigurine.position ~= nil then
        local rf = tableCfg.referenceFigurine
        return {
            position = Vector(rf.position),
            rotation = Vector(rf.rotation or { 0, 180, 0 }),
        }
    end
    local rh = tableCfg and tableCfg.referenceHand
    if U.Type(rh) ~= "table" or rh.position == nil then
        error("figurine_seat_layout: table is missing referenceFigurine and referenceHand")
    end
    local hp = Vector(rh.position)
    local hr = Vector(rh.rotation or { 0, 0, 0 })
    return {
        position = Vector({ x = hp.x + HAND_TO_FIG_X, y = PC_FIGURINE_Y, z = hp.z + HAND_TO_FIG_Z }),
        rotation = Vector({ x = 0, y = hr.y + 180, z = 0 }),
    }
end

--- @param opts table|nil `{ occupiedNPCSlots = table? }`
--- @return table[] { occupantKey, tableSlot, isPlayer }
function FSL.collectOccupants(opts)
    opts = U.Type(opts) == "table" and opts or {}
    local ss = liveSeatSlots()
    local occupiedNPC = opts.occupiedNPCSlots
    if U.Type(occupiedNPC) ~= "table" then
        occupiedNPC = S.getStateVal("seatLayout", "occupiedNPCSlots")
    end
    local out = {}
    for _, color in ipairs(C.PlayerColors or {}) do
        local row = ss[color]
        if U.Type(row) == "table" and row.absentFromSession ~= true then
            local slot = tonumber(row.tableSlot)
            if type(slot) == "number" then
                out[#out + 1] = { occupantKey = color, tableSlot = math.floor(slot), isPlayer = true }
            end
        end
    end
    for _, npc in ipairs(C.NPCSeats or {}) do
        local row = ss[npc]
        if npcRowHasCharacter(row, occupiedNPC, npc) then
            local slot = U.Type(row) == "table" and tonumber(row.tableSlot) or nil
            if type(slot) == "number" then
                out[#out + 1] = { occupantKey = npc, tableSlot = math.floor(slot), isPlayer = false }
            end
        end
    end
    return out
end

--- @param opts table|nil forwarded to collectOccupants
--- @return number 0 when nobody in session
function FSL.highestOccupiedTableSlot(opts)
    local maxSlot = 0
    local occ = FSL.collectOccupants(opts)
    for i = 1, #occ do
        if occ[i].tableSlot > maxSlot then
            maxSlot = occ[i].tableSlot
        end
    end
    return maxSlot
end

--- Family `"Table B"` → B0 when highest slot is 0–5, B1 at 6, … B4 at 9.
--- @param highestSlot number|nil
--- @return number 0..4
function FSL.tableBVariantIndexFromHighest(highestSlot)
    local h = tonumber(highestSlot) or 0
    local seats = math.max(5, h)
    local idx = seats - 5
    if idx > 4 then
        idx = 4
    end
    if idx < 0 then
        idx = 0
    end
    return idx
end

--- NPCs seated on a numbered chair.
--- @param opts table|nil forwarded to collectOccupants
--- @return number
function FSL.seatedNpcCount(opts)
    local n = 0
    local occ = FSL.collectOccupants(opts)
    for i = 1, #occ do
        if occ[i].isPlayer ~= true then
            n = n + 1
        end
    end
    return n
end

--- Family `"Table B"` always seats all 5 PCs (an unoccupied PC leaves a gap) plus one chair per
--- seated NPC: B0 with no NPCs … B4 with four. Grows further only when a chair is already beyond that.
--- @param opts table|nil
--- @return number 0..4
function FSL.tableBVariantIndex(opts)
    local byNpcs = math.min(4, FSL.seatedNpcCount(opts))
    return math.max(byNpcs, FSL.tableBVariantIndexFromHighest(FSL.highestOccupiedTableSlot(opts)))
end

--- True when this occupant currently has a tableSlot within this table's capacity.
--- @param seatKey string
--- @param tableCfg table|nil
--- @param opts table|nil
--- @return boolean
function FSL.seatIsOnTable(seatKey, tableCfg, opts)
    if U.Type(seatKey) ~= "string" or seatKey == "" then
        return false
    end
    local cap = FSL.getSlotCapacity(tableCfg)
    local occ = FSL.collectOccupants(opts)
    for i = 1, #occ do
        if occ[i].occupantKey == seatKey then
            local slot = occ[i].tableSlot
            return slot >= 1 and slot <= cap
        end
    end
    return false
end

function FSL.seedDefaultTableSlots()
    local ss = S.getStateVal("sessionScene", "seatSlots")
    if U.Type(ss) ~= "table" then
        ss = {}
        S.setStateVal(ss, "sessionScene", "seatSlots")
    end
    FSL.seedDefaultTableSlotsOnto(ss, S.getStateVal("seatLayout", "occupiedNPCSlots"))
end

--- Fill missing `tableSlot` values on a seatSlots table (library row or live).
--- @param seatSlots table
--- @param occupiedNPCSlots table|nil
function FSL.seedDefaultTableSlotsOnto(seatSlots, occupiedNPCSlots)
    local ss = seatSlots
    if U.Type(ss) ~= "table" then
        return
    end
    local occupiedNPC = U.Type(occupiedNPCSlots) == "table" and occupiedNPCSlots or {}
    local used = {}
    for occupant, row in pairs(ss) do
        if U.Type(row) == "table" and row.absentFromSession ~= true then
            local slot = tonumber(row.tableSlot)
            if type(slot) == "number" then
                used[math.floor(slot)] = occupant
            end
        end
    end
    local function claimSlot(occupant, preferred)
        local row = ensureSeatRow(ss, occupant)
        if row.absentFromSession == true then
            row.tableSlot = nil
            return
        end
        if tonumber(row.tableSlot) ~= nil then
            return
        end
        local pick = preferred
        if type(pick) ~= "number" or used[pick] ~= nil then
            pick = nil
            for slot = 1, 9 do
                if used[slot] == nil then
                    pick = slot
                    break
                end
            end
        end
        if pick == nil then
            error("sessionScene.seatSlots." .. occupant .. ".tableSlot: no free numbered slot left to seed")
        end
        row.tableSlot = pick
        used[pick] = occupant
    end
    for _, color in ipairs(C.PlayerColors or {}) do
        local row = ss[color]
        if not (U.Type(row) == "table" and row.absentFromSession == true) then
            claimSlot(color, FSL.DEFAULT_TABLE_SLOTS[color])
        end
    end
    for _, npc in ipairs(C.NPCSeats or {}) do
        if npcRowHasCharacter(ss[npc], occupiedNPC, npc) then
            claimSlot(npc, FSL.DEFAULT_TABLE_SLOTS[npc])
        end
    end
end

--- True when this table (or the Table B family) shuffles occupants on a cover transition.
--- @param tableKey string|nil
--- @return boolean
function FSL.tableUsesRandomSeating(tableKey)
    if U.Type(tableKey) ~= "string" or tableKey == "" then
        return false
    end
    local cfg = C.Tables and C.Tables[tableKey]
    if U.Type(cfg) == "table" and cfg.isRandomSeating == true then
        return true
    end
    if tableKey == "Table B" then
        local b0 = C.Tables and C.Tables["Table B0"]
        return U.Type(b0) == "table" and b0.isRandomSeating == true
    end
    return false
end

--- Shuffle all 5 PCs plus seated NPCs into chairs 1..(5 + NPCs). An unoccupied PC
--- (`absentFromSession`) draws a chair like everyone else but takes no `tableSlot`, so their
--- chair stays an empty gap at a random position. Call after `seedDefaultTableSlots`.
--- @return number chairCount
function FSL.randomizePackedOccupancy()
    FSL.seedDefaultTableSlots()
    local ss = liveSeatSlots()
    local draw = {}
    for _, color in ipairs(C.PlayerColors or {}) do
        draw[#draw + 1] = color
    end
    local occ = FSL.collectOccupants()
    for i = 1, #occ do
        if occ[i].isPlayer ~= true then
            draw[#draw + 1] = occ[i].occupantKey
        end
    end
    for i = #draw, 2, -1 do
        local j = math.random(i)
        draw[i], draw[j] = draw[j], draw[i]
    end
    local seated = {}
    for i = 1, #draw do
        local row = ensureSeatRow(ss, draw[i])
        if row.absentFromSession == true then
            row.tableSlot = nil
        else
            row.tableSlot = i
            seated[draw[i]] = true
        end
    end
    for occupant, row in pairs(ss) do
        if U.Type(row) == "table" and seated[occupant] ~= true then
            row.tableSlot = nil
        end
    end
    return #draw
end

--- @param seatSlots table|nil
--- @param occupiedNPCSlots table|nil
--- @param tableCfg table|nil
--- @param opts table|nil `{ forImport = boolean? }`
--- @return boolean ok
--- @return string|nil err
function FSL.checkOccupancy(seatSlots, occupiedNPCSlots, tableCfg, opts)
    opts = U.Type(opts) == "table" and opts or {}
    local ss = U.Type(seatSlots) == "table" and seatSlots or {}
    local cap = FSL.getSlotCapacity(tableCfg)
    if opts.forImport == true and tableCfg == nil then
        cap = MAX_SLOT_ANY_TABLE
    end
    local used = {}

    local function checkRow(occupant, row, requireSlot)
        if U.Type(row) ~= "table" then
            if requireSlot then
                return false, "sessionScene.seatSlots." .. occupant .. ".tableSlot: required for in-session occupants"
            end
            return true
        end
        if row.absentFromSession == true then
            if row.tableSlot ~= nil then
                return false, "sessionScene.seatSlots." .. occupant
                    .. ": absentFromSession cannot be set together with tableSlot"
            end
            return true
        end
        if not requireSlot then
            return true
        end
        local slot = tonumber(row.tableSlot)
        if slot == nil then
            return false, "sessionScene.seatSlots." .. occupant .. ".tableSlot: required for in-session occupants"
        end
        slot = math.floor(slot)
        if slot < 1 or slot > cap then
            return false, "sessionScene.seatSlots." .. occupant .. ".tableSlot: " .. tostring(slot)
                .. " is outside 1.." .. tostring(cap) .. " for this table"
        end
        if used[slot] ~= nil then
            return false, "sessionScene.seatSlots." .. occupant .. ".tableSlot: " .. tostring(slot)
                .. " is already used by " .. used[slot]
        end
        used[slot] = occupant
        return true
    end

    for _, color in ipairs(C.PlayerColors or {}) do
        local ok, err = checkRow(color, ss[color], true)
        if not ok then
            return false, err
        end
    end
    for _, npc in ipairs(C.NPCSeats or {}) do
        local row = ss[npc]
        local hasChar = npcRowHasCharacter(row, occupiedNPCSlots, npc)
        local ok, err = checkRow(npc, row, hasChar)
        if not ok then
            return false, err
        end
    end
    return true, nil
end

--- @param tableCfg table|nil
function FSL.validateOccupancy(tableCfg)
    local ok, err = FSL.checkOccupancy(
        liveSeatSlots(),
        S.getStateVal("seatLayout", "occupiedNPCSlots"),
        tableCfg,
        { forImport = false }
    )
    if not ok then
        error(err or "figurine_seat_layout: occupancy validation failed")
    end
end

--- @param occupantKey string
--- @param roleKey string
--- @return table|nil
function FSL.lookupOffset(occupantKey, roleKey)
    local pack = C.SeatRoleOffsets
    if U.Type(pack) ~= "table" then
        return nil
    end
    local extra = pack.extraByOccupant and pack.extraByOccupant[occupantKey]
    if U.Type(extra) == "table" and extra[roleKey] ~= nil then
        return extra[roleKey]
    end
    if isPlayerSeatKey(occupantKey) and pack.player and pack.player[roleKey] ~= nil then
        return pack.player[roleKey]
    end
    if pack.shared and pack.shared[roleKey] ~= nil then
        return pack.shared[roleKey]
    end
    return nil
end

--- World XZ from the computed figurine frame only — never live `positionToWorld`.
--- After Scatter the Unity transform can still be at the old group pose for a tick.
local function worldFromFigurineLocal(figFrame, _figObj, localXZ)
    return FigurineFrame.worldFromLocal(figFrame, localXZ)
end

local function addRot(figRot, localRot)
    local fr = Vector(figRot)
    local lr = localRot or { x = 0, y = 0, z = 0 }
    return Vector({
        x = (tonumber(fr.x) or 0) + (tonumber(lr.x) or 0),
        y = (tonumber(fr.y) or 0) + (tonumber(lr.y) or 0),
        z = (tonumber(fr.z) or 0) + (tonumber(lr.z) or 0),
    })
end

local function liveYIsHidden(y)
    local n = tonumber(y)
    return n ~= nil and n <= HIDE_Y_FLOOR
end

--- @return boolean
local function isScatterSeatLayoutActive()
    local Occupancy = require("lib.scatter_occupancy")
    return Occupancy.isScatterLayoutActive() == true
end

--- Roles whose on/off (or page show/hide) is encoded in world Y — occupancy stash must not flatten these.
--- @param roleKey string|nil
--- @return boolean
local function isFeatureHideRoleKey(roleKey)
    if type(roleKey) ~= "string" then
        return false
    end
    if roleKey == "SIGNAL_FIRE" or roleKey == "HUNGER_SMOKE" then
        return true
    end
    return string.match(roleKey, "^CSHEET_PAGE_%d+$") ~= nil
end

--- @param obj Object|nil
--- @return string|nil
local function readSatelliteRoleKey(obj)
    if obj == nil then
        return nil
    end
    local disp = SRI.readRoleColorIdentity(obj)
    if disp == nil then
        return nil
    end
    return SRI.parseRoleAndSuffix(disp)
end

--- Runtime snapshot of per-role Y taken when an occupant pile is occupancy-stashed at −200.
--- Survives Save & Play so Absent off can tell occupancy bury from page/fire/smoke hide.
--- @return table
local function absentPileYMap()
    local map = S.getStateVal("seatLayout", "absentPileY")
    if U.Type(map) ~= "table" then
        map = {}
        S.setStateVal(map, "seatLayout", "absentPileY")
    end
    return map
end

--- First occupancy hide keeps the live Y; later hides while still buried must not overwrite with −200.
--- @param occupantKey string
--- @param roleKey string|nil
--- @param y number|nil
local function captureOccupantPileY(occupantKey, roleKey, y)
    if type(occupantKey) ~= "string" or occupantKey == "" then
        return
    end
    if type(roleKey) ~= "string" or roleKey == "" then
        return
    end
    local n = tonumber(y)
    if n == nil then
        return
    end
    local map = absentPileYMap()
    local row = map[occupantKey]
    if U.Type(row) ~= "table" then
        row = {}
        map[occupantKey] = row
    end
    if row[roleKey] == nil then
        row[roleKey] = n
    end
end

--- @param occupantKey string
--- @param roleKey string|nil
--- @return number|nil
local function peekOccupantPileY(occupantKey, roleKey)
    if type(occupantKey) ~= "string" or type(roleKey) ~= "string" then
        return nil
    end
    local map = S.getStateVal("seatLayout", "absentPileY")
    if U.Type(map) ~= "table" then
        return nil
    end
    local row = map[occupantKey]
    if U.Type(row) ~= "table" then
        return nil
    end
    return tonumber(row[roleKey])
end

--- True when this occupant has occupancy-stash rows from a prior Absent bury (restore on layout).
--- @param occupantKey string
--- @return boolean
function FSL.hasOccupancyStash(occupantKey)
    if type(occupantKey) ~= "string" or occupantKey == "" then
        return false
    end
    local map = S.getStateVal("seatLayout", "absentPileY")
    if U.Type(map) ~= "table" then
        return false
    end
    local row = map[occupantKey]
    return U.Type(row) == "table" and next(row) ~= nil
end

--- Unoccupied PC (`absentFromSession`) whose pile is already parked — layout passes skip re-hiding it.
--- @param color string
--- @return boolean
function FSL.isUnoccupiedPcPileStashed(color)
    local row = liveSeatSlots()[color]
    return U.Type(row) == "table" and row.absentFromSession == true and FSL.hasOccupancyStash(color)
end

--- True when `obj` belongs to an unoccupied PC's parked pile (its `<Color>Object` tag), so a
--- non-layout restore (Scatter leave, seat presence) must leave it parked. Chairs are excluded:
--- table / Scatter layout owns chair hide.
--- @param obj Object|nil
--- @return boolean
function FSL.isInParkedPcPile(obj)
    if not U.isGameObject(obj) or obj.hasTag == nil then
        return false
    end
    for _, color in ipairs(C.PlayerColors or {}) do
        if obj.hasTag(color .. "Object") and FSL.isUnoccupiedPcPileStashed(color) then
            return readSatelliteRoleKey(obj) ~= "SEAT_CHAIR"
        end
    end
    return false
end

--- @param occupantKey string
local function clearOccupantPileY(occupantKey)
    if type(occupantKey) ~= "string" then
        return
    end
    local map = S.getStateVal("seatLayout", "absentPileY")
    if U.Type(map) == "table" then
        map[occupantKey] = nil
    end
end

--- True when the occupancy stash recorded this role at table height (it was showing before the
--- pile was buried). A buried page/fire/smoke is parked like a feature-off one, so the stash row is
--- the only record of which one to bring back.
--- @param occupantKey string
--- @param roleKey string|nil
--- @return boolean
local function wasShowingBeforeOccupancyStash(occupantKey, roleKey)
    local stashY = peekOccupantPileY(occupantKey, roleKey)
    return stashY ~= nil and not liveYIsHidden(stashY)
end

--- Occupancy stash Y vs feature-hide Y vs authored defaultY.
--- @param occupantKey string
--- @param roleKey string|nil
--- @param liveY number
--- @param defaultY number
--- @param worldY number|nil figurine frame Y (unused for Y; satellites keep authored defaultY)
--- @return number
local function resolveSatelliteY(occupantKey, roleKey, liveY, defaultY, worldY)
    local stashY = peekOccupantPileY(occupantKey, roleKey)
    if stashY ~= nil then
        if liveYIsHidden(stashY) then
            return stashY
        end
        return defaultY
    end
    -- Feature-hide off (page, fire, smoke) with no stash row — layout must not lift these.
    if isFeatureHideRoleKey(roleKey) and liveYIsHidden(liveY) then
        return liveY
    end
    return defaultY
end

local function findFigurine(occupantKey)
    local tag = occupantKey .. "Object"
    local tagged = getObjectsWithTag(tag) or {}
    for i = 1, #tagged do
        local obj = tagged[i]
        if obj ~= nil and U.isGameObject(obj) then
            local disp = SRI.readRoleColorIdentity(obj)
            if disp ~= nil then
                local roleKey = SRI.parseRoleAndSuffix(disp)
                if roleKey == "SEAT_FIGURE" then
                    return obj
                end
            end
        end
    end
    if isPlayerSeatKey(occupantKey) then
        local guid = G.GUIDS and G.GUIDS["SEAT_FIGURE_" .. string.upper(occupantKey)]
        if type(guid) == "string" then
            local obj = G.getObject(guid)
            if obj ~= nil then
                return obj
            end
        end
    end
    return nil
end

local function placeObjectExact(obj, pos, rot)
    obj.setPosition({ x = pos.x, y = pos.y, z = pos.z })
    obj.setRotation({ x = rot.x, y = rot.y, z = rot.z })
end

local function shouldSkipSatellite(obj, roleKey)
    if obj ~= nil and obj.hasTag ~= nil then
        if obj.hasTag("d10Preload") or obj.hasTag("d10") then
            return true
        end
    end
    if type(roleKey) == "string" and string.find(roleKey, "PRELOAD", 1, true) then
        return true
    end
    return false
end

local function applyOffsetToObject(obj, figFrame, figObj, offset, roleKey, occupantKey)
    local livePos = Vector(obj.getPosition())
    local world = worldFromFigurineLocal(figFrame, figObj, offset.localXZ or { x = 0, z = 0 })
    local defaultY = tonumber(offset.defaultY) or world.y
    local y = resolveSatelliteY(occupantKey, roleKey, livePos.y, defaultY, world.y)
    local rot = addRot(figFrame.rotation, offset.localRotation)
    local rotTable = { x = rot.x, y = rot.y, z = rot.z }

    if isFeatureHideRoleKey(roleKey) then
        local onPos = { x = world.x, y = defaultY, z = world.z }
        local wantOff = not wasShowingBeforeOccupancyStash(occupantKey, roleKey)
            and (O.isHiddenObject(obj) or liveYIsHidden(livePos.y) or liveYIsHidden(y))
        if wantOff then
            O.hideObject(obj, {
                snapshotPosition = onPos,
                refreshSnapshotPosition = true,
                parkRotation = rotTable,
                parkPosition = { x = world.x, y = y, z = world.z },
            })
        else
            placeObjectExact(obj, Vector({ x = world.x, y = y, z = world.z }), rot)
            if O.isHiddenObject(obj) then
                O.restoreObject(obj, {
                    position = { x = world.x, y = y, z = world.z },
                    rotation = rotTable,
                })
            end
        end
    else
        placeObjectExact(obj, Vector({ x = world.x, y = y, z = world.z }), rot)
        if O.isHiddenObject(obj) then
            O.restoreObject(obj, {
                keepWorldPose = true,
                position = { x = world.x, y = y, z = world.z },
                rotation = rotTable,
            })
        end
    end
end

--- Compute figurine frames + occupant rigid transforms for cameras.
--- @param tableCfg table
--- @param facingBounds table|nil `{ xMin, xMax }` from live table
--- @param opts table|nil forwarded to collectOccupants
--- @return table `{ framesBySlot, seatRigidByKey, slot1Rigid, occupants }`
function FSL.computeSlotFrames(tableCfg, facingBounds, opts)
    local refFig = FSL.getReferenceFigurineFrame(tableCfg)
    local center = Vector(tableCfg.centerPoint)
    local cap = FSL.getSlotCapacity(tableCfg)
    local framesBySlot = {}
    local shape = tableCfg.shape
    local facingShape = C.TableShapes and C.TableShapes.FACING
    local refSeg = tableCfg.referenceSeatSegment

    if shape == facingShape then
        local refSide = 180
        local refIndex = 3
        if U.Type(refSeg) == "table" then
            refSide = tonumber(refSeg.side) or refSide
            refIndex = tonumber(refSeg.index) or refIndex
        end
        local oppSide = (refSide + 180) % 360
        local xMin = facingBounds and facingBounds.xMin or -40
        local xMax = facingBounds and facingBounds.xMax or 40
        local function facingFrame(side, index, nSeats)
            local deltaDeg = shortestSignedDelta(refSide, side)
            local rotated = U.frameAfterRigidYawAboutCenter(center, refFig, deltaDeg)
            local width = xMax - xMin
            local step = nSeats > 0 and (width / nSeats) or width
            local targetX = xMin + (index - 0.5) * step
            local desired = Vector({ x = targetX, y = rotated.position.y, z = rotated.position.z })
            local shift = desired - rotated.position
            local frame = U.frameAfterRigidYawAboutCenter(center, refFig, deltaDeg)
            frame.position = frame.position + shift
            return frame, { deltaDeg = deltaDeg, shift = shift }
        end
        for slot = 1, cap do
            local localSlot = slot
            local side = refSide
            if slot >= 6 then
                localSlot = slot - 5
                side = oppSide
            end
            local idx = fanIndex(refIndex, localSlot)
            if idx < 1 then
                idx = 1
            end
            if idx > 5 then
                idx = 5
            end
            local frame, rigid = facingFrame(side, idx, 5)
            framesBySlot[slot] = { frame = frame, rigid = rigid }
        end
    else
        local numSegments = tonumber(tableCfg.numSegments) or cap
        local angleSegmentOne = tonumber(tableCfg.angleSegmentOne) or 0
        local refSegN = tonumber(refSeg) or 1
        local dx = refFig.position.x - center.x
        local dz = refFig.position.z - center.z
        local radius = math.sqrt(dx * dx + dz * dz)
        local function circularFrame(slot)
            local seatSeg = circularSegmentForSlot(refSegN, numSegments, slot)
            local thetaK = angleSegmentOne + (seatSeg - 1) * (360 / numSegments)
            local thetaRef = angleSegmentOne + (refSegN - 1) * (360 / numSegments)
            local deltaDeg = shortestSignedDelta(thetaRef, thetaK)
            local rotated = U.frameAfterRigidYawAboutCenter(center, refFig, deltaDeg)
            local desired = Vector({
                x = center.x + math.sin(math.rad(thetaK)) * radius,
                y = rotated.position.y,
                z = center.z + math.cos(math.rad(thetaK)) * radius,
            })
            local shift = desired - rotated.position
            local frame = U.frameAfterRigidYawAboutCenter(center, refFig, deltaDeg)
            frame.position = frame.position + shift
            return frame, { deltaDeg = deltaDeg, shift = shift }
        end
        for slot = 1, cap do
            local frame, rigid = circularFrame(slot)
            framesBySlot[slot] = { frame = frame, rigid = rigid }
        end
    end

    local occupants = FSL.collectOccupants(opts)
    local seatRigidByKey = {}
    for i = 1, #occupants do
        local occ = occupants[i]
        local packed = framesBySlot[occ.tableSlot]
        if packed ~= nil then
            seatRigidByKey[occ.occupantKey] = packed.rigid
            local figOff = FSL.lookupOffset(occ.occupantKey, "SEAT_FIGURE")
            if figOff ~= nil and tonumber(figOff.defaultY) ~= nil then
                packed.frame.position = Vector({
                    x = packed.frame.position.x,
                    y = figOff.defaultY,
                    z = packed.frame.position.z,
                })
            end
        end
    end
    local slot1 = framesBySlot[1]
    return {
        framesBySlot = framesBySlot,
        seatRigidByKey = seatRigidByKey,
        slot1Rigid = slot1 and slot1.rigid or { deltaDeg = 0, shift = Vector(0, 0, 0) },
        occupants = occupants,
        referenceFigurine = refFig,
        centerPoint = center,
    }
end

--- @param occupantKey string
--- @param figFrame table
--- @param figObj Object|nil
--- @param helpers table|nil `{ skipRoleKeys?: table }`
local function layoutOccupantSatellites(occupantKey, figFrame, figObj, helpers)
    helpers = helpers or {}
    local tag = occupantKey .. "Object"
    local tagged = getObjectsWithTag(tag) or {}
    local seen = {}
    local function handle(obj, roleKey)
        if obj == nil or not U.isGameObject(obj) then
            return
        end
        local guid = obj.getGUID and obj.getGUID() or ""
        if guid ~= "" then
            if seen[guid] then
                return
            end
            seen[guid] = true
        end
        if roleKey == "SEAT_FIGURE" then
            return
        end
        if helpers.skipRoleKeys ~= nil and helpers.skipRoleKeys[roleKey] == true then
            return
        end
        -- ObjectPositions owns feature object poses — layout only moves anchors.
        if OBJECT_POSITIONS_OWNED_ROLES[roleKey] == true then
            return
        end
        if shouldSkipSatellite(obj, roleKey) then
            return
        end
        local offset = FSL.lookupOffset(occupantKey, roleKey)
        if offset == nil then
            return
        end
        if roleKey == "HAND_ZONE" then
            local world = worldFromFigurineLocal(figFrame, figObj, offset.localXZ or { x = 0, z = 0 })
            local rot = addRot(figFrame.rotation, offset.localRotation)
            local defaultY = tonumber(offset.defaultY) or world.y
            local livePos = Vector(obj.getPosition())
            local y = resolveSatelliteY(occupantKey, roleKey, livePos.y, defaultY, world.y)
            -- Saves stashed before the hand-zone hide exception still carry the HiddenObject tag;
            -- a tagged zone ignores untagged cards, so clear it before collecting the hand.
            if O.isHiddenObject(obj) then
                O.restoreObject(obj, { keepWorldPose = true })
            end
            U.movePlayerHand(occupantKey, Vector({ x = world.x, y = y, z = world.z }), rot)
            return
        end
        applyOffsetToObject(obj, figFrame, figObj, offset, roleKey, occupantKey)
    end

    for i = 1, #tagged do
        local obj = tagged[i]
        local disp = SRI.readRoleColorIdentity(obj)
        local roleKey = nil
        if disp ~= nil then
            roleKey = SRI.parseRoleAndSuffix(disp)
        end
        if roleKey ~= nil then
            handle(obj, roleKey)
        end
    end

    if isPlayerSeatKey(occupantKey) then
        local hz = U.getHandZone(occupantKey)
        if hz ~= nil then
            handle(hz, "HAND_ZONE")
        end
    end
end

local function allLayerColors()
    return { "White", "Brown", "Red", "Orange", "Yellow", "Green", "Teal", "Blue", "Purple", "Pink", "Grey", "Black" }
end

--- Park the player's hand zone at `C.HIDDEN_OBJECT_WORLD_Y` (TOR-513 / TOR-590 / TOR-631).
--- Hand zones are a hide/restore exception: `O.hideObject` would tag the zone, and a tagged zone
--- only holds objects sharing that tag. `U.movePlayerHand` stashes the in-hand cards in the
--- player's storage container; the HAND_ZONE layout move back to the table deals them back.
--- @param occupantKey string
local function stashHandZoneAndCards(occupantKey)
    local hz = U.getHandZone(occupantKey)
    if hz == nil then
        return
    end
    local parkY = C.HIDDEN_OBJECT_WORLD_Y
    local p = hz.getPosition and hz.getPosition() or nil
    if p == nil or liveYIsHidden(p.y) then
        return
    end
    captureOccupantPileY(occupantKey, "HAND_ZONE", p.y)
    local rot = hz.getRotation and Vector(hz.getRotation()) or Vector({ 0, 0, 0 })
    U.movePlayerHand(occupantKey, Vector({ x = p.x, y = parkY, z = p.z }), rot)
end

--- Occupancy-stash key: the satellite role, or the GUID for role-less objects (decks, loose cards).
--- @param obj Object
--- @param roleKey string|nil
--- @return string|nil
local function occupancyStashKey(obj, roleKey)
    if type(roleKey) == "string" and roleKey ~= "" then
        return roleKey
    end
    local guid = obj.getGUID and obj.getGUID() or nil
    if type(guid) == "string" and guid ~= "" then
        return "guid:" .. guid
    end
    return nil
end

--- Park (`visible == false`) or bring back every `<Color>Object` in an occupant's pile.
--- Park: the hand zone goes first via `U.movePlayerHand` (which stashes the in-hand cards in the
--- player's storage container); then every
--- other tagged object — decks and loose cards included — is hidden, recording its table Y in the
--- occupancy stash. Bring back runs after layout: objects
--- layout lifted unhide in place; objects layout does not own (decks, drawers, tarot) return to
--- their hide-snapshot pose only when the stash shows they were on the table; anything hidden
--- before the park (page off, tarot off, Scatter) stays hidden.
--- @param occupantKey string
--- @param visible boolean
function FSL.setOccupantPileVisible(occupantKey, visible)
    local tag = occupantKey .. "Object"
    if not visible and isPlayerSeatKey(occupantKey) then
        stashHandZoneAndCards(occupantKey)
    end
    local objs = getObjectsWithTag(tag) or {}
    for i = 1, #objs do
        local obj = objs[i]
        if not U.isGameObject(obj) then
            -- skip
        else
            local isPooledFig = obj.hasTag ~= nil and obj.hasTag("npc_figurine")
            local roleKey = readSatelliteRoleKey(obj)
            local stashKey = occupancyStashKey(obj, roleKey)
            if visible then
                if roleKey == "SEAT_CHAIR" then
                    -- Chair hide is owned by table/scatter layout, not occupancy restore.
                elseif O.isHiddenObject(obj) and not isFeatureHideRoleKey(roleKey) then
                    local p = obj.getPosition and obj.getPosition() or nil
                    if p ~= nil and not liveYIsHidden(p.y) then
                        O.restoreObject(obj, { keepWorldPose = true })
                    elseif wasShowingBeforeOccupancyStash(occupantKey, stashKey) then
                        O.restoreObject(obj)
                    end
                end
            elseif not isPooledFig then
                if isFeatureHideRoleKey(roleKey) and O.isHiddenObject(obj) then
                    -- feature-owned hide (page off, fire off, …)
                else
                    local p = obj.getPosition and obj.getPosition() or nil
                    if p ~= nil and not liveYIsHidden(p.y) then
                        captureOccupantPileY(occupantKey, stashKey, p.y)
                    end
                    O.hideObject(obj)
                end
            end
        end
    end
end

--- Re-apply ObjectPositions-owned feature poses after anchors moved. Unoccupied PC seats keep
--- their parked drawers and tarot set (their anchors are parked, but the poses use table height).
local function reconcileObjectPositionsOwnedAfterLayout()
    local parkedColors = {}
    for _, color in ipairs(C.PlayerColors or {}) do
        if FSL.isUnoccupiedPcPileStashed(color) then
            parkedColors[color] = true
        end
    end
    if parkedColors.Pink ~= true then
        require("lib.tarot_toggle").reconcileAfterSeatLayout(G.GUIDS.TAROT_BUTTON_PINK)
    end
    require("lib.dice_drawer").reconcileAfterSeatLayout({ instant = true, skipColors = parkedColors })
end

--- @param bundle table from computeSlotFrames
--- @param helpers table|nil `{ skipRoleKeys?: table }`
function FSL.applyOccupantRigs(bundle, helpers)
    helpers = helpers or {}
    local anchors = {}
    local occupied = {}

    for i = 1, #bundle.occupants do
        local occ = bundle.occupants[i]
        local packed = bundle.framesBySlot[occ.tableSlot]
        if packed == nil then
            -- Occupant’s numbered slot is outside this table’s capacity (e.g. slot 6 on B0).
        else
            occupied[occ.occupantKey] = true
            local figFrame = packed.frame
            local figObj = findFigurine(occ.occupantKey)
            if figObj ~= nil then
                placeObjectExact(figObj, figFrame.position, figFrame.rotation)
                if O.isHiddenObject(figObj) then
                    O.restoreObject(figObj, {
                        keepWorldPose = true,
                        position = {
                            x = figFrame.position.x,
                            y = figFrame.position.y,
                            z = figFrame.position.z,
                        },
                        rotation = {
                            x = figFrame.rotation.x,
                            y = figFrame.rotation.y,
                            z = figFrame.rotation.z,
                        },
                    })
                end
            else
                anchors[occ.occupantKey] = {
                    position = { x = figFrame.position.x, y = figFrame.position.y, z = figFrame.position.z },
                    rotation = { x = figFrame.rotation.x, y = figFrame.rotation.y, z = figFrame.rotation.z },
                }
            end
            layoutOccupantSatellites(occ.occupantKey, figFrame, figObj, helpers)
            if FSL.hasOccupancyStash(occ.occupantKey) then
                FSL.setOccupantPileVisible(occ.occupantKey, true)
            end
            clearOccupantPileY(occ.occupantKey)
        end
    end

    for _, color in ipairs(C.PlayerColors or {}) do
        if occupied[color] ~= true and not FSL.isUnoccupiedPcPileStashed(color) then
            FSL.setOccupantPileVisible(color, false)
        end
    end
    for _, npc in ipairs(C.NPCSeats or {}) do
        if occupied[npc] ~= true then
            FSL.setOccupantPileVisible(npc, false)
        end
    end

    S.setStateVal(anchors, "seatLayout", "virtualFigurineAnchors")
    reconcileObjectPositionsOwnedAfterLayout()
end

--- Lowest unused slot in 1..cap, or nil.
function FSL.lowestFreeTableSlot(tableCfg, opts)
    local cap = FSL.getSlotCapacity(tableCfg)
    local used = {}
    local occ = FSL.collectOccupants(opts)
    for i = 1, #occ do
        used[occ[i].tableSlot] = true
    end
    for slot = 1, cap do
        if used[slot] ~= true then
            return slot
        end
    end
    return nil
end

--- Leaf is on when highest occupied slot is at least `usedBySlot`.
--- @param componentCfg table
--- @param highestSlot number
--- @return boolean
function FSL.componentUsedByOccupied(componentCfg, highestSlot)
    if U.Type(componentCfg) ~= "table" then
        return true
    end
    local usedBySlot = tonumber(componentCfg.usedBySlot)
    if usedBySlot == nil then
        return true
    end
    return (tonumber(highestSlot) or 0) >= usedBySlot
end

--- Stable occupancy lines for layout fingerprint.
--- @param opts table|nil
--- @return string
function FSL.occupancyFingerprint(opts)
    local occ = FSL.collectOccupants(opts)
    table.sort(occ, function(a, b)
        return a.occupantKey < b.occupantKey
    end)
    local lines = { "slots:" }
    for i = 1, #occ do
        lines[#lines + 1] = occ[i].occupantKey .. "=" .. tostring(occ[i].tableSlot)
    end
    local ss = liveSeatSlots()
    local absent = {}
    for _, color in ipairs(C.PlayerColors or {}) do
        local row = ss[color]
        if U.Type(row) == "table" and row.absentFromSession == true then
            absent[#absent + 1] = color
        end
    end
    table.sort(absent)
    if #absent > 0 then
        lines[#lines + 1] = "absent:" .. table.concat(absent, ",")
    end
    return table.concat(lines, "\n")
end

local function currentTableCfg()
    local key = S.getStateVal("seatLayout", "currentTableKey")
    if type(key) == "string" and C.Tables and C.Tables[key] then
        return C.Tables[key], key
    end
    return nil, key
end

--- @param occupantKey string
--- @param slot number
--- @return boolean ok
--- @return string|nil err
function FSL.tryAssignTableSlot(occupantKey, slot)
    slot = math.floor(tonumber(slot) or 0)
    local tableCfg = currentTableCfg()
    local cap = FSL.getSlotCapacity(tableCfg)
    if slot < 1 or slot > cap then
        return false, occupantKey .. " table slot " .. tostring(slot)
            .. " is outside 1.." .. tostring(cap) .. " for this table"
    end
    local ss = liveSeatSlots()
    local occ = FSL.collectOccupants()
    for i = 1, #occ do
        if occ[i].tableSlot == slot and occ[i].occupantKey ~= occupantKey then
            return false, occupantKey .. " table slot " .. tostring(slot)
                .. " is already used by " .. occ[i].occupantKey
        end
    end
    local row = ensureSeatRow(ss, occupantKey)
    row.absentFromSession = nil
    row.tableSlot = slot
    return true, nil
end

--- Connection checkpoint: a PC who is still disconnected loses their chair (`absentFromSession`).
--- Only `core.player_connection` calls this; nothing else may unoccupy a PC seat.
--- @param color string
function FSL.markPlayerDisconnected(color)
    if not isPlayerSeatKey(color) then
        error("FSL.markPlayerDisconnected: not a player seat: " .. tostring(color))
    end
    local row = ensureSeatRow(liveSeatSlots(), color)
    row.absentFromSession = true
    row.tableSlot = nil
end

--- Connect: clear `absentFromSession` and give the PC a chair on the current table at once.
--- Fixed tables use the PC's default chair when free; random-seating tables (and a taken
--- default) use the lowest free chair. Scatter has no chairs — group membership is the seat,
--- and `S.validateState` seeds the standard chair kept for leaving Scatter.
--- @param color string
--- @return boolean ok
--- @return string|nil err
function FSL.seatConnectedPlayer(color)
    if not isPlayerSeatKey(color) then
        return false, "FSL.seatConnectedPlayer: not a player seat: " .. tostring(color)
    end
    local row = ensureSeatRow(liveSeatSlots(), color)
    row.absentFromSession = nil
    if tonumber(row.tableSlot) ~= nil then
        return true, nil
    end
    local Occupancy = require("lib.scatter_occupancy")
    if Occupancy.isScatterLayoutActive() then
        return true, nil
    end
    local tableCfg, tableKey = currentTableCfg()
    local slot = nil
    if not FSL.tableUsesRandomSeating(tableKey) then
        local preferred = FSL.DEFAULT_TABLE_SLOTS[color]
        if type(preferred) == "number" and preferred <= FSL.getSlotCapacity(tableCfg) then
            local taken = false
            local occ = FSL.collectOccupants()
            for i = 1, #occ do
                if occ[i].tableSlot == preferred then
                    taken = true
                    break
                end
            end
            if not taken then
                slot = preferred
            end
        end
    end
    slot = slot or FSL.lowestFreeTableSlot(tableCfg)
    if slot == nil then
        return false, "No free chair for " .. color .. " on " .. tostring(tableKey) .. "."
    end
    row.tableSlot = slot
    return true, nil
end

--- Absent is session-level (the player is not connected), never scene- or table-authored.
--- Before incoming seat rows (library scene, Scatter stash, Scatter → table seed) replace the
--- live ones, copy each PC's live Absent flag onto them: Absent stays Absent with no chair,
--- and a stale authored Absent is cleared (`S.validateState` seeds the missing chair).
--- @param seatSlots table incoming seat rows (mutated)
--- @param liveSeatSlotsSnapshot table|nil live `sessionScene.seatSlots` before the overwrite
function FSL.carryLiveAbsenceOnto(seatSlots, liveSeatSlotsSnapshot)
    local live = U.Type(liveSeatSlotsSnapshot) == "table" and liveSeatSlotsSnapshot or {}
    for _, color in ipairs(C.PlayerColors or {}) do
        local liveRow = live[color]
        local row = ensureSeatRow(seatSlots, color)
        if U.Type(liveRow) == "table" and liveRow.absentFromSession == true then
            row.absentFromSession = true
            row.tableSlot = nil
        else
            row.absentFromSession = nil
        end
    end
end

return FSL
