--[[
    Build initial playerData.stats from PCS chronicle data (lib/pcs_data.ttslua).
    conditions live on playerData root, not under stats.
]]
local U = require("lib.util")
local PCS = require("lib.pcs_data")

local BOOT = {}

--- Deep clone so editing `stats` never mutates the PCS JSON cache.
--- @param t table
--- @return table
local function deepCloneTable(t)
  if JSON ~= nil and type(JSON.encode) == "function" and type(JSON.decode) == "function" then
    -- pcall: JSON.encode can throw when PCS-derived tables still reference non-serializable userdata. Propagating would abort bootstrap even though shallow U.clone can still yield a usable stats snapshot.
    local ok, enc = pcall(function()
      return JSON.encode(t)
    end)
    if ok and type(enc) == "string" then
      -- pcall: JSON.decode can throw if encode produced an edge-case payload. Propagating would abort bootstrap when U.clone remains a valid fallback path.
      local ok2, dec = pcall(function()
        return JSON.decode(enc)
      end)
      if ok2 and type(dec) == "table" then
        return dec
      end
    end
  end
  return U.clone(t)
end

--- Clone discipline rows for live stats (keeps powers / rituals / ceremonies for page 2).
--- @param srcDisc table|nil
--- @return table
local function cloneDisciplines(srcDisc)
  if type(srcDisc) ~= "table" then
    return {}
  end
  return deepCloneTable(srcDisc)
end

--- Build full stats table (Part A–E) from a PCS character record.
--- @param pcsChar table|nil
--- @return table|nil
function BOOT.statsFromPcsChar(pcsChar)
  if type(pcsChar) ~= "table" then
    return nil
  end

  local stats = {
    attributes = deepCloneTable(pcsChar.attributes or {}),
    skills = deepCloneTable(pcsChar.skills or {}),
    specialties = deepCloneTable(pcsChar.specialties or {}),
    health = deepCloneTable(pcsChar.health or { base = 5, temp = 0, superficial = 0, aggravated = 0 }),
    willpower = deepCloneTable(pcsChar.willpower or { base = 5, temp = 0, superficial = 0, aggravated = 0 }),
    humanity = deepCloneTable(pcsChar.humanity or { base = 7, temp = 0, stains = 0 }),
    bloodPotency = deepCloneTable(pcsChar.bloodPotency or { base = 0, temp = 0 }),
    xp = tonumber(pcsChar.xp) or 0,
    hunger = 0,
    disciplines = cloneDisciplines(pcsChar.disciplines),
    backgrounds = deepCloneTable(pcsChar.backgrounds or {}),
    merits = deepCloneTable(pcsChar.merits or {}),
    flaws = deepCloneTable(pcsChar.flaws or {}),
    bloodline = {},
    loresheet = {},
  }
  return stats
end

--- @param arr table|nil
--- @return boolean
local function narrativeTraitArrayEmpty(arr)
  return type(arr) ~= "table" or #arr == 0
end

--- Copy page-3 narrative arrays from embedded PCS (explicit reset / debug).
--- @param stats table
--- @param charKey string
function BOOT.resetNarrativeTraitsFromPcs(stats, charKey)
  if type(stats) ~= "table" or type(charKey) ~= "string" or charKey == "" then
    return
  end
  local pcsChar = PCS.getPC(charKey)
  if type(pcsChar) ~= "table" then
    return
  end
  stats.backgrounds = deepCloneTable(pcsChar.backgrounds or {})
  stats.merits = deepCloneTable(pcsChar.merits or {})
  stats.flaws = deepCloneTable(pcsChar.flaws or {})
end

--- Seed page-3 narrative arrays from PCS only when missing or empty (preserves ST edits).
--- @param stats table
--- @param charKey string
function BOOT.hydrateNarrativeTraits(stats, charKey)
  if type(stats) ~= "table" or type(charKey) ~= "string" or charKey == "" then
    return
  end
  local pcsChar = PCS.getPC(charKey)
  if type(pcsChar) ~= "table" then
    return
  end
  if narrativeTraitArrayEmpty(stats.backgrounds) then
    stats.backgrounds = deepCloneTable(pcsChar.backgrounds or {})
  end
  if narrativeTraitArrayEmpty(stats.merits) then
    stats.merits = deepCloneTable(pcsChar.merits or {})
  end
  if narrativeTraitArrayEmpty(stats.flaws) then
    stats.flaws = deepCloneTable(pcsChar.flaws or {})
  end
end

--- Merge powers / rituals / ceremonies from PCS into live discipline rows (keep base/temp).
--- Needed when older saves stripped those fields at bootstrap.
--- @param stats table
--- @param charKey string
function BOOT.hydrateDisciplineDetails(stats, charKey)
  if type(stats) ~= "table" or type(charKey) ~= "string" or charKey == "" then
    return
  end
  local pcsChar = PCS.getPC(charKey)
  if type(pcsChar) ~= "table" or type(pcsChar.disciplines) ~= "table" then
    return
  end
  if type(stats.disciplines) ~= "table" then
    stats.disciplines = {}
  end
  for key, pcsRow in pairs(pcsChar.disciplines) do
    if type(key) == "string" and type(pcsRow) == "table" then
      local live = stats.disciplines[key]
      if type(live) ~= "table" then
        stats.disciplines[key] = deepCloneTable(pcsRow)
      else
        if live.powers == nil and pcsRow.powers ~= nil then
          live.powers = deepCloneTable(pcsRow.powers)
        end
        if live.rituals == nil and pcsRow.rituals ~= nil then
          live.rituals = deepCloneTable(pcsRow.rituals)
        end
        if live.ceremonies == nil and pcsRow.ceremonies ~= nil then
          live.ceremonies = deepCloneTable(pcsRow.ceremonies)
        end
      end
    end
  end
end

--- @param charKey string
--- @return table|nil stats table or nil if unknown key / no PCS entry
function BOOT.buildStatsForCharKey(charKey)
  if type(charKey) ~= "string" or charKey == "" then
    return nil
  end
  local pcsChar = PCS.getPC(charKey)
  return BOOT.statsFromPcsChar(pcsChar)
end

return BOOT
