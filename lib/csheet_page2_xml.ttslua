--[[
  Build character sheet page 2 UI XML: disciplines grid + optional rituals/ceremonies.
  Consumed via PAGE_DYNAMIC_XML[2] / ui.ui_csheet_page2 (object entry).

  Agent guidance: .dev/PC Data & Tracking/Character Sheet Modifications.md
]]

local M = {}

local CSHEET_DEFAULTS = require("lib.csheet_defaults_xml")
local PSC = require("lib.pc_sheet_collect")

local DISC_ORDER = {
  "animalism",
  "auspex",
  "bloodSorcery",
  "celerity",
  "dominate",
  "fortitude",
  "obfuscate",
  "oblivion",
  "potence",
  "presence",
  "protean",
}

local function xmlEscape(s)
  s = tostring(s or "")
  s = s:gsub("&", "&amp;")
  s = s:gsub("<", "&lt;")
  s = s:gsub(">", "&gt;")
  s = s:gsub('"', "&quot;")
  return s
end

--- @param discs table|nil
--- @return string[] owned keys in chronicle order
local function orderedOwnedDisciplineKeys(discs)
  local owned = {}
  if type(discs) ~= "table" then
    return owned
  end
  for _, key in ipairs(DISC_ORDER) do
    if type(discs[key]) == "table" then
      owned[#owned + 1] = key
    end
  end
  for key, row in pairs(discs) do
    if type(key) == "string" and type(row) == "table" and PSC.DISCIPLINE_DOT_KEYS[key] == true then
      local found = false
      for i = 1, #owned do
        if owned[i] == key then
          found = true
          break
        end
      end
      if not found then
        owned[#owned + 1] = key
      end
    end
  end
  return owned
end

--- Copy name/level into a table owned by this script (stats may come from Global).
--- @param entry any
--- @return table|nil
local function localRcEntry(entry)
  if type(entry) ~= "table" then
    return nil
  end
  return {
    name = entry.name,
    level = entry.level,
  }
end

--- @param discs table|nil
--- @return table[] rituals
--- @return table[] ceremonies
local function collectRitualsAndCeremonies(discs)
  local rituals = {}
  local ceremonies = {}
  if type(discs) ~= "table" then
    return rituals, ceremonies
  end
  for _, row in pairs(discs) do
    if type(row) == "table" then
      if type(row.rituals) == "table" then
        for i = 1, #row.rituals do
          local copy = localRcEntry(row.rituals[i])
          if copy ~= nil then
            rituals[#rituals + 1] = copy
          end
        end
      end
      if type(row.ceremonies) == "table" then
        for i = 1, #row.ceremonies do
          local copy = localRcEntry(row.ceremonies[i])
          if copy ~= nil then
            ceremonies[#ceremonies + 1] = copy
          end
        end
      end
    end
  end
  return rituals, ceremonies
end

--- @param powers table|nil
--- @return string one line per power level (8-space indent); same-level names joined with ◆
local function powersText(powers)
  if type(powers) ~= "table" then
    return ""
  end
  --- @type table<number, string[]>
  local byLevel = {}
  local levels = {}
  for i = 1, #powers do
    local p = powers[i]
    if type(p) == "table" then
      local level = math.floor(tonumber(p.level) or 0)
      local name = tostring(p.name or "")
      if name ~= "" then
        if byLevel[level] == nil then
          byLevel[level] = {}
          levels[#levels + 1] = level
        end
        byLevel[level][#byLevel[level] + 1] = name
      end
    end
  end
  table.sort(levels)
  local lines = {}
  for i = 1, #levels do
    local names = byLevel[levels[i]]
    table.sort(names)
    lines[#lines + 1] = "        " .. table.concat(names, " ◆ ")
  end
  return table.concat(lines, "\n")
end

--- Absolute fill offsets within the 200px disc/ritual dotline (author-tuned).
local DOT_FILL_OFFSET_XY = {
  "0 2",
  "35 2",
  "70 2",
  "105 2",
  "140 2",
}

--- @param key string
--- @param row table
--- @return string
local function buildDisciplineCell(key, row)
  local nameImg = "discName_" .. key
  local base = tonumber(row.base) or 0
  local temp = tonumber(row.temp) or 0
  local parts = {
    string.format('<VerticalLayout id="db_disc_cell_%s" class="page2_disc_cell">', key),
    string.format('  <HorizontalLayout id="db_disc_header_%s" class="page2_disc_header">', key),
    string.format(
      '    <Image id="db_disc_name_%s" image="%s" class="page2_disc_name" />',
      key,
      nameImg
    ),
    string.format('    <Panel id="db_dotline_wrap_%s" class="page2_dotline_wrap page2_dotline_wrap_disc">', key),
    string.format('      <Image id="db_dotline_bg_%s" image="page2_dotline" class="page2_dotline_bg" />', key),
    string.format('      <HorizontalLayout id="db_dot_fills_%s" class="page2_dot_fills">', key),
  }
  for slot = 1, 5 do
    -- Bake fill state into XML so remount shows dots without relying on same-frame setAttribute.
    local active, imageName = PSC.resolveDotSlotImage(key, base, temp, slot)
    if active and type(imageName) == "string" and imageName ~= "" then
      parts[#parts + 1] = string.format(
        '        <Image id="dot_%s_%d" class="dot dot_standard page2_dot_fill" offsetXY="%s" active="true" image="%s" />',
        key,
        slot,
        DOT_FILL_OFFSET_XY[slot],
        imageName
      )
    else
      parts[#parts + 1] = string.format(
        '        <Image id="dot_%s_%d" class="dot dot_standard page2_dot_fill" offsetXY="%s" active="false" />',
        key,
        slot,
        DOT_FILL_OFFSET_XY[slot]
      )
    end
  end
  parts[#parts + 1] = "      </HorizontalLayout>"
  parts[#parts + 1] = "    </Panel>"
  parts[#parts + 1] = "  </HorizontalLayout>"
  -- Powers `text` is applied via UI.setAttribute after setXml — XML attribute whitespace
  -- normalization collapses real newlines to spaces.
  parts[#parts + 1] = string.format('  <Text id="db_powers_%s" class="page2_powers_text" text="" />', key)
  parts[#parts + 1] = "</VerticalLayout>"
  return table.concat(parts, "\n")
end

--- @param cellIndex number 1..6
--- @return string
local function emptyDisciplineCell(cellIndex)
  return string.format(
    '<VerticalLayout id="db_disc_cell_empty_%d" class="page2_disc_cell" />',
    cellIndex
  )
end

--- @param entry table|nil
--- @param side string L|R
--- @param rowIndex number
--- @return string
local function buildRcRow(entry, side, rowIndex)
  local name = ""
  local level = 0
  if type(entry) == "table" then
    name = tostring(entry.name or "")
    level = math.floor(tonumber(entry.level) or 0)
  end
  local rowId = string.format("%s_%d", side, rowIndex)
  local parts = {
    string.format('<HorizontalLayout id="db_rc_row_%s" class="page2_rc_row">', rowId),
    string.format(
      '  <Panel id="db_rc_dotline_wrap_%s" class="page2_dotline_wrap page2_dotline_wrap_rc">',
      rowId
    ),
    string.format(
      '    <Image id="db_rc_dotline_bg_%s" image="page2_dotline" class="page2_dotline_bg" />',
      rowId
    ),
    string.format('    <HorizontalLayout id="db_rc_dot_fills_%s" class="page2_dot_fills">', rowId),
  }
  for slot = 1, 5 do
    if slot <= level then
      parts[#parts + 1] = string.format(
        '      <Image id="dot_rc_%s_%d_%d" class="dot dot_standard page2_dot_fill" offsetXY="%s" active="true" image="dot_yellow" />',
        side,
        rowIndex,
        slot,
        DOT_FILL_OFFSET_XY[slot]
      )
    else
      parts[#parts + 1] = string.format(
        '      <Image id="dot_rc_%s_%d_%d" class="dot dot_standard page2_dot_fill" offsetXY="%s" active="false" />',
        side,
        rowIndex,
        slot,
        DOT_FILL_OFFSET_XY[slot]
      )
    end
  end
  parts[#parts + 1] = "    </HorizontalLayout>"
  parts[#parts + 1] = "  </Panel>"
  parts[#parts + 1] = string.format(
    '  <Text id="db_rc_name_%s" class="page2_rc_name" text="%s" />',
    rowId,
    xmlEscape(name)
  )
  parts[#parts + 1] = "</HorizontalLayout>"
  return table.concat(parts, "\n")
end

--- @param stats table|nil
--- @param _seatColorRaw string|nil
--- @param _pd table|nil
--- @return string
function M.buildPage2DocumentXml(stats, _seatColorRaw, _pd)
  stats = type(stats) == "table" and stats or {}
  local discs = type(stats.disciplines) == "table" and stats.disciplines or {}
  local owned = orderedOwnedDisciplineKeys(discs)
  if #owned > 6 then
    error(string.format(
      "[csheet_page2] character has %d disciplines; page 2 layout supports at most 6",
      #owned
    ))
  end

  local cells = {}
  for i = 1, 6 do
    local key = owned[i]
    if key ~= nil then
      cells[i] = buildDisciplineCell(key, discs[key])
    else
      cells[i] = emptyDisciplineCell(i)
    end
  end

  local rituals, ceremonies = collectRitualsAndCeremonies(discs)
  if #rituals > 5 and #ceremonies > 0 then
    error(string.format("[csheet_page2] %d rituals exceed left-column capacity of 5", #rituals))
  end
  if #ceremonies > 5 and #rituals > 0 then
    error(string.format("[csheet_page2] %d ceremonies exceed right-column capacity of 5", #ceremonies))
  end
  if #rituals == 0 and #ceremonies == 0 then
    -- ok
  elseif #rituals > 0 and #ceremonies == 0 then
    if #rituals > 10 then
      error(string.format("[csheet_page2] %d rituals exceed capacity of 10", #rituals))
    end
  elseif #ceremonies > 0 and #rituals == 0 then
    if #ceremonies > 10 then
      error(string.format("[csheet_page2] %d ceremonies exceed capacity of 10", #ceremonies))
    end
  end

  -- Single page-2 Defaults block: author-tuned overrides only (no prior 280px/spacing values that could win).
  -- paper_root must not also use padded_border — that class's padding would override page_root padding.
  local parts = {
    "<Defaults>",
    '  <Panel class="page_root" childAlignment="UpperCenter" padding="50 50 110 100" />',
    '  <VerticalLayout class="page2_dynamic" padding="40 40 0 0" childAlignment="UpperCenter" childForceExpandHeight="false" childForceExpandWidth="true" spacing="0" />',
    '  <HorizontalLayout class="page2_disc_row" flexibleWidth="1" spacing="0" preferredHeight="225" flexibleHeight="0" />',
    '  <VerticalLayout class="page2_disc_cell" flexibleWidth="1" preferredHeight="280" childForceExpandWidth="false" />',
    '  <HorizontalLayout class="page2_disc_header" preferredHeight="70" flexibleHeight="0" childForceExpandWidth="false" preferredWidth="800" flexibleWidth="1" spacing="0" />',
    '  <Image class="page2_disc_name" preferredWidth="220" preferredHeight="63" flexibleWidth="0" />',
    '  <Panel class="page2_dotline_wrap" raycastTarget="false" />',
    '  <Panel class="page2_dotline_wrap_disc" padding="0 0 0 0" flexibleWidth="0" preferredWidth="200" preferredHeight="63" />',
    '  <Panel class="page2_dotline_wrap_rc" preferredWidth="280" preferredHeight="63" flexibleWidth="0" />',
    '  <Image class="page2_dotline_bg" flexibleWidth="0" preferredWidth="200" preferredHeight="0" ignoreLayout="true" width="200" />',
    '  <HorizontalLayout class="page2_dot_fills" preferredWidth="200" preferredHeight="63" ignoreLayout="false" padding="20 20 0 0" childAlignment="MiddleLeft" childForceExpandWidth="false" />',
    '  <Image class="page2_dot_fill" ignoreLayout="true" width="63" height="63" />',
    '  <Text class="page2_powers_text" alignment="UpperLeft" fontSize="28" color="#AAAAAA" fontStyle="Bold" preferredHeight="200" flexibleHeight="1" horizontalOverflow="Overflow" />',
    '  <Image class="page2_rc_divider" preferredHeight="80" flexibleHeight="0" preserveAspect="true" />',
    '  <HorizontalLayout class="page2_rc_columns" spacing="40" flexibleHeight="1" />',
    '  <VerticalLayout class="page2_rc_col" flexibleWidth="1" spacing="12" />',
    '  <HorizontalLayout class="page2_rc_row" preferredHeight="63" flexibleHeight="0" />',
    '  <Text class="page2_rc_name" alignment="MiddleLeft" fontSize="28" color="#FFFFFF" flexibleWidth="1" />',
    "</Defaults>",
    "",
    '<Panel id="paper_root" class="page_root">',
    '  <Button id="pageForward" class="page_navigation page_forward" />',
    '  <Button id="pageInner" class="page_navigation page_inner_left" />',
    "",
    '  <VerticalLayout id="page2_dynamic" class="page2_dynamic">',
    '    <HorizontalLayout id="db_disc_row_1" class="page2_disc_row">',
    cells[1],
    cells[2],
    cells[3],
    "    </HorizontalLayout>",
    '    <HorizontalLayout id="db_disc_row_2" class="page2_disc_row">',
    cells[4],
    cells[5],
    cells[6],
    "    </HorizontalLayout>",
  }

  local hasRc = #rituals > 0 or #ceremonies > 0
  if hasRc then
    local divider = "divider_ritualsAndCeremonies"
    local leftList = {}
    local rightList = {}
    if #rituals > 0 and #ceremonies > 0 then
      divider = "divider_ritualsAndCeremonies"
      leftList = rituals
      rightList = ceremonies
    elseif #rituals > 0 then
      divider = "divider_rituals"
      for i = 1, math.min(5, #rituals) do
        leftList[i] = rituals[i]
      end
      for i = 6, math.min(10, #rituals) do
        rightList[i - 5] = rituals[i]
      end
    else
      divider = "divider_ceremonies"
      for i = 1, math.min(5, #ceremonies) do
        leftList[i] = ceremonies[i]
      end
      for i = 6, math.min(10, #ceremonies) do
        rightList[i - 5] = ceremonies[i]
      end
    end

    parts[#parts + 1] = string.format(
      '    <Image id="db_rc_divider" image="%s" class="page2_rc_divider" />',
      divider
    )
    parts[#parts + 1] = '    <HorizontalLayout id="db_rc_columns" class="page2_rc_columns">'
    parts[#parts + 1] = '      <VerticalLayout id="db_rc_col_L" class="page2_rc_col">'
    for row = 1, 5 do
      parts[#parts + 1] = buildRcRow(leftList[row], "L", row)
    end
    parts[#parts + 1] = "      </VerticalLayout>"
    parts[#parts + 1] = '      <VerticalLayout id="db_rc_col_R" class="page2_rc_col">'
    for row = 1, 5 do
      parts[#parts + 1] = buildRcRow(rightList[row], "R", row)
    end
    parts[#parts + 1] = "      </VerticalLayout>"
    parts[#parts + 1] = "    </HorizontalLayout>"
  end

  parts[#parts + 1] = "  </VerticalLayout>"
  parts[#parts + 1] = "</Panel>"

  return table.concat({
    CSHEET_DEFAULTS.getXml(),
    "",
    table.concat(parts, "\n"),
    "",
  }, "\n")
end

--- @param stats table|nil
--- @return string
function M.fingerprintPage2Stats(stats)
  if type(stats) ~= "table" then
    return ""
  end
  local discs = type(stats.disciplines) == "table" and stats.disciplines or {}
  local parts = { "p2" }
  local owned = orderedOwnedDisciplineKeys(discs)
  for i = 1, #owned do
    local key = owned[i]
    local row = discs[key]
    local base = tonumber(row.base) or 0
    local temp = tonumber(row.temp) or 0
    parts[#parts + 1] = string.format("%s=%d/%d|%s", key, base, temp, powersText(row.powers))
  end
  local rituals, ceremonies = collectRitualsAndCeremonies(discs)
  local function fpList(label, list)
    parts[#parts + 1] = label
    for i = 1, #list do
      local e = list[i]
      if type(e) == "table" then
        parts[#parts + 1] = string.format(
          "%s@%s",
          tostring(e.name or ""),
          tostring(e.level or 0)
        )
      end
    end
  end
  fpList("R", rituals)
  fpList("C", ceremonies)
  return table.concat(parts, "\3")
end

--- Apply discipline power lines after XmlUI remount (setAttribute preserves `\n`; XML attrs do not).
--- @param ui table object.UI
--- @param stats table|nil
function M.applyPowersTexts(ui, stats)
  if ui == nil or type(ui.setAttribute) ~= "function" then
    return
  end
  if type(stats) ~= "table" then
    return
  end
  local discs = type(stats.disciplines) == "table" and stats.disciplines or {}
  local owned = orderedOwnedDisciplineKeys(discs)
  for i = 1, #owned do
    local key = owned[i]
    local row = discs[key]
    local body = ""
    if type(row) == "table" then
      body = powersText(row.powers)
    end
    ui.setAttribute("db_powers_" .. key, "text", body)
  end
end

return M
