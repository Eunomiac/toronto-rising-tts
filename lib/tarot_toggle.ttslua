--[[
    Tarot drawer/deck/button pose toggle (lib/tarot_toggle.ttslua)

    Host-only world I/O for Pink tarot objects. Called from GlobalApplyTarotState
    (Global script) — object scripts must not invoke this directly (P8).
]]

local C = require("lib.constants")
local G = require("lib.guids")
local OP = require("lib.object_positions_object")
local TarotObjects = require("lib.tarot_objects")

local TarotToggle = {}

local STATE_OFF = "off"
local STATE_ON = "on"

local TAROT_KEYS = {
    "TAROT_DRAWER_PINK",
    TarotObjects.GUIDS_KEY_DECK_PINK,
    "TAROT_BUTTON_PINK",
}

local currentOpToken = 0

--- @return table|nil
local function getSeatLayoutCenterPoint()
    if Global ~= nil and type(Global.call) == "function" then
        local cp = Global.call("GlobalGetSeatLayoutCenterPoint")
        if type(cp) == "table" and type(cp.x) == "number" and type(cp.y) == "number" and type(cp.z) == "number" then
            return cp
        end
    end
    return nil
end

--- @return boolean
local function isSeatLayoutReady()
    return getSeatLayoutCenterPoint() ~= nil
end

--- @param key string
--- @param buttonGuid string|nil
--- @return Object|nil
local function resolveTarotObject(key, buttonGuid)
    if key == "TAROT_BUTTON_PINK" then
        if type(buttonGuid) == "string" and buttonGuid ~= "" then
            return G.getObject(buttonGuid)
        end
        return TarotObjects.resolveByGuidsKey(key)
    end
    return TarotObjects.resolveByGuidsKey(key)
end

--- @param buttonGuid string|nil
--- @return Object|nil
local function getTarotDeck(buttonGuid)
    return resolveTarotObject(TarotObjects.GUIDS_KEY_DECK_PINK, buttonGuid)
end

--- @param targetOn boolean
--- @param buttonGuid string|nil
local function setDeckInteractable(targetOn, buttonGuid)
    local deck = getTarotDeck(buttonGuid)
    if deck ~= nil then
        deck.interactable = targetOn == true
    end
end

--- @param buttonGuid string|nil
local function returnLooseTarotCardsToDeck(buttonGuid)
    local deck = getTarotDeck(buttonGuid)
    if deck == nil then
        print("[TarotToggle] Cannot return cards: tarot deck missing.")
        return
    end
    if deck.putObject == nil then
        print("[TarotToggle] Cannot return cards: deck putObject unavailable.")
        return
    end
    local returned = 0
    for _, obj in ipairs(TarotObjects.getTaggedObjects()) do
        if TarotObjects.isLooseCard(obj, deck) then
            deck.putObject(obj)
            returned = returned + 1
        end
    end
    if returned > 0 then
        print("[TarotToggle] Returned " .. tostring(returned) .. " loose tarot card(s) to deck before hide.")
    end
end

--- @param token number
--- @return boolean
local function isTokenCurrent(token)
    return token == currentOpToken
end

--- @param obj Object
--- @param entry table
--- @return table|nil `{ x, y, z }` from resolved ObjectPositions on pose (anchor-aware)
local function snapshotOnPosition(obj, entry)
    local onPose = OP.resolveStatePose(obj, entry, STATE_ON) or entry.on
    if type(onPose) ~= "table" or type(onPose.position) ~= "table" then
        return nil
    end
    local merged = OP.mergePosition(obj, onPose.position)
    return { x = merged.x, y = merged.y, z = merged.z }
end

--- @param deck Object|nil
--- @return boolean
local function deckIsParkedHidden(deck)
    if deck == nil then
        return false
    end
    if deck.hasTag ~= nil and deck.hasTag("HiddenObject") then
        return true
    end
    local pos = deck.getPosition and deck.getPosition() or nil
    local y = pos and pos.y
    return type(y) == "number" and y <= -199
end

--- Pink deck off uses hide/restore (y = −200), not a visible shallow bury.
--- On reveal: one pose apply only (`OP.applyResolvedPose`). That path honors
--- `on.delay` (drawer opens first) and clears HiddenObject via GlobalRestoreObject
--- at the resolved anchor+height. Do not also call GlobalRestoreObject eagerly —
--- that dual-apply made the deck pop at the stash/drawer height, then snap again
--- when the delayed pose ran.
--- @param state string
--- @param token number
--- @param buttonGuid string|nil
--- @param opts table|nil `{ instant?: boolean }`
local function applyDeckState(state, token, buttonGuid, opts)
    opts = type(opts) == "table" and opts or {}
    local obj = getTarotDeck(buttonGuid)
    if obj == nil then
        print("[TarotToggle] Missing object for key: " .. tostring(TarotObjects.GUIDS_KEY_DECK_PINK))
        return
    end
    local entry = C.ObjectPositions[TarotObjects.GUIDS_KEY_DECK_PINK]
    if type(entry) ~= "table" then
        print("[TarotToggle] Missing C.ObjectPositions entry for Pink tarot deck.")
        return
    end
    local guid = type(obj.getGUID) == "function" and obj.getGUID() or nil
    if type(guid) ~= "string" or guid == "" then
        return
    end
    if not isTokenCurrent(token) then
        return
    end
    if state == STATE_OFF then
        if Global ~= nil and type(Global.call) == "function" then
            Global.call("GlobalHideObject", {
                guid = guid,
                snapshotPosition = snapshotOnPosition(obj, entry),
                refreshSnapshotPosition = true,
            })
        end
        return
    end
    local onPose = OP.resolveStatePose(obj, entry, STATE_ON) or entry.on
    if type(onPose) ~= "table" then
        print("[TarotToggle] Missing 'on' pose for Pink tarot deck.")
        return
    end
    if type(onPose.position) ~= "table"
        or onPose.position.x == nil
        or onPose.position.z == nil
        or onPose.position.y == nil
    then
        print("[TarotToggle] Pink tarot on pose missing resolved XYZ; check TAROT_DECK_ANCHOR_PINK is in-world and on.height is set.")
        return
    end
    local effectivePose = {}
    for k, v in pairs(onPose) do
        effectivePose[k] = v
    end
    effectivePose.isHidden = false
    if opts.instant == true then
        effectivePose.delay = nil
        effectivePose.transitionDelay = nil
    end
    OP.applyResolvedPose(obj, effectivePose, 0, 0, {
        shouldAbort = function()
            return not isTokenCurrent(token)
        end,
    })
end

--- @param key string
--- @param state string
--- @param token number
--- @param buttonGuid string|nil
--- @param opts table|nil `{ instant?: boolean }`
local function applyObjectState(key, state, token, buttonGuid, opts)
    opts = type(opts) == "table" and opts or {}
    if key == TarotObjects.GUIDS_KEY_DECK_PINK then
        applyDeckState(state, token, buttonGuid, opts)
        return
    end
    local obj = resolveTarotObject(key, buttonGuid)
    if obj == nil then
        print("[TarotToggle] Missing object for key: " .. tostring(key))
        return
    end
    local entry = C.ObjectPositions[key]
    if type(entry) ~= "table" then
        print("[TarotToggle] Missing C.ObjectPositions entry for key: " .. tostring(key))
        return
    end
    local pose = OP.resolveStatePose(obj, entry, state)
    if type(pose) ~= "table" then
        pose = entry[state]
    end
    if type(pose) ~= "table" then
        print("[TarotToggle] Missing '" .. tostring(state) .. "' pose for key: " .. tostring(key))
        return
    end

    local effectivePose = {}
    for k, v in pairs(pose) do
        effectivePose[k] = v
    end
    if type(effectivePose.position) == "table" then
        local hasX = effectivePose.position.x ~= nil
        local hasY = effectivePose.position.y ~= nil
        local hasZ = effectivePose.position.z ~= nil
        if not (hasX and hasY and hasZ) then
            effectivePose.position = OP.mergePosition(obj, effectivePose.position)
        end
    end
    if opts.instant == true then
        effectivePose.delay = nil
        effectivePose.transitionDelay = nil
    end
    local duration = opts.instant == true and 0 or OP.DEFAULT_TRANSITION_DURATION
    OP.applyResolvedPose(obj, effectivePose, duration, 0, {
        shouldAbort = function()
            return not isTokenCurrent(token)
        end,
    })
end

--- @param buttonGuid string|nil
local function shuffleTarotDeck(buttonGuid)
    local deck = getTarotDeck(buttonGuid)
    if deck == nil then
        return
    end
    if deck.shuffle ~= nil then
        deck.shuffle()
    elseif deck.randomize ~= nil then
        deck.randomize()
    end
end

--- @param targetOn boolean
--- @param token number
--- @param buttonGuid string|nil
--- @param opts table|nil `{ skipShuffle?: boolean, instant?: boolean }`
local function applyTarotStateNow(targetOn, token, buttonGuid, opts)
    opts = type(opts) == "table" and opts or {}
    if not isTokenCurrent(token) then
        return nil
    end
    if not targetOn then
        returnLooseTarotCardsToDeck(buttonGuid)
    end
    local state = targetOn and STATE_ON or STATE_OFF
    for i = 1, #TAROT_KEYS do
        applyObjectState(TAROT_KEYS[i], state, token, buttonGuid, opts)
    end
    setDeckInteractable(targetOn, buttonGuid)
    -- TOR-447: shuffle when activating so the drawn order is fresh after the deck settles into pose.
    if targetOn and opts.skipShuffle ~= true then
        shuffleTarotDeck(buttonGuid)
    end
    return targetOn
end

--- Host startup: align deck interactable with inferred on/off (pose may already be correct from save).
--- @param buttonGuid string|nil
--- @param fallback boolean
function TarotToggle.syncDeckInteractableFromInfer(buttonGuid, fallback)
    setDeckInteractable(TarotToggle.inferCurrentState(buttonGuid, fallback == true), buttonGuid)
end

--- Apply tarot on/off poses (host-only — guard at Global entry).
--- @param targetOn boolean
--- @param buttonGuid string|nil TAROT_BUTTON_PINK GUID from clicker object script
--- @return boolean|nil applied on-state, or nil if aborted / seat layout unavailable
function TarotToggle.applyState(targetOn, buttonGuid)
    if type(targetOn) ~= "boolean" then
        return nil
    end
    if not isSeatLayoutReady() then
        print("[TarotToggle] seatLayout.currentTableKey is not ready; skipping tarot pose application.")
        return nil
    end
    currentOpToken = currentOpToken + 1
    local token = currentOpToken
    return applyTarotStateNow(targetOn, token, buttonGuid)
end

--- After seat layout moved Pink anchors: re-assert Consult on/off from ObjectPositions
--- (no shuffle; instant pose so XZ tracks the new seat without Consult delay).
--- @param buttonGuid string|nil
--- @return boolean|nil
function TarotToggle.reconcileAfterSeatLayout(buttonGuid)
    if not isSeatLayoutReady() then
        return nil
    end
    local targetOn = TarotToggle.inferCurrentState(buttonGuid, false)
    currentOpToken = currentOpToken + 1
    return applyTarotStateNow(targetOn, currentOpToken, buttonGuid, {
        skipShuffle = true,
        instant = true,
    })
end

--- Read-only: infer on/off from hide tag / parked Y / table-top on Y (object script onLoad hydration).
--- @param buttonGuid string|nil
--- @param fallback boolean
--- @return boolean
function TarotToggle.inferCurrentState(buttonGuid, fallback)
    fallback = fallback == true
    if not isSeatLayoutReady() then
        return fallback
    end
    local deck = getTarotDeck(buttonGuid)
    if deck == nil then
        return fallback
    end
    if deckIsParkedHidden(deck) then
        return false
    end
    local entry = C.ObjectPositions.TAROT_DECK_PINK
    if type(entry) ~= "table" then
        return fallback
    end
    local onPose = OP.resolveStatePose(deck, entry, STATE_ON) or entry.on
    if type(onPose) ~= "table" then
        return fallback
    end
    local onY = onPose.position and onPose.position.y
    local currentY = deck.getPosition().y
    if type(onY) == "number" and type(currentY) == "number" then
        return currentY >= (onY - 1)
    end
    return fallback
end

return TarotToggle
