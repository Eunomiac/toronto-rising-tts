--- Groups excluded when picking palette row membership from `npcs_data` character `groups`.
--- After filtering, a single remaining group wins; if multiple remain, `pairs()` picks one.
D.PALETTE_GROUP_BLACKLIST = {
  princesCourt = true,
}

--- Stage figurine placement lerp on CONTROL_BOARD Apply (TOR-173). Tune in Save & Play without logic edits.
D.STAGE_PLACEMENT_LERP = {
  positionDurationSec = 1.2,
  modeOnlyDurationSec = 0.8,
  withinFamilyStaggerSec = 0.12,
  betweenFamilyStaggerSec = 0.35,
  --- Stretch between-family delay only (within-family stays even). No hard cap on batch size.
  staggerCandidateScale = 0.04,
  --- Optional ceiling on stagger multiplier (nil / 0 = no ceiling).
  staggerScaleMax = 5,
  lightOnDelayFrac = 0.75,
  lightOnSpringSec = 0.25,
  pathFps = 60,
  ease = "sineInOut",
}

--- Enumerate every table key and component name from C.Tables (for marker registry).
--- @return table[] { tableKey, componentKey? }
function D.enumerateTableMarkerEntries()
  local out = {}
  local keys = {}
  for tableKey, _ in pairs(C.Tables or {}) do
    keys[#keys + 1] = tableKey
  end
  table.sort(keys)
  for _, tableKey in ipairs(keys) do
    out[#out + 1] = { tableKey = tableKey, componentKey = nil }
    local cfg = C.Tables[tableKey]
    local comps = type(cfg) == "table" and cfg.components or nil
    if type(comps) == "table" then
      local compNames = {}
      for compName, _ in pairs(comps) do
        compNames[#compNames + 1] = compName
      end
      table.sort(compNames)
      for _, compName in ipairs(compNames) do
        out[#out + 1] = { tableKey = tableKey, componentKey = compName }
      end
    end
  end
  return out
end

--- @param slot number|nil
--- @return table|nil column `{ seatKey, kind, tableSlot }`
function D.seatRowColumnForTableSlot(slot)
  slot = math.floor(tonumber(slot) or 0)
  if slot < 1 then
    return nil
  end
  local cols = D.CONTROL_BOARD_SEAT_ROW and D.CONTROL_BOARD_SEAT_ROW.columns
  if type(cols) ~= "table" then
    return nil
  end
  for i = 1, #cols do
    local col = cols[i]
    if type(col) == "table" and math.floor(tonumber(col.tableSlot) or 0) == slot then
      return col
    end
  end
  return nil
end

--- @param seatKey string|nil
--- @return number|nil tableSlot
function D.tableSlotForSeatRowSeatKey(seatKey)
  if type(seatKey) ~= "string" or seatKey == "" then
    return nil
  end
  local cols = D.CONTROL_BOARD_SEAT_ROW and D.CONTROL_BOARD_SEAT_ROW.columns
  if type(cols) ~= "table" then
    return nil
  end
  for i = 1, #cols do
    local col = cols[i]
    if type(col) == "table" and col.seatKey == seatKey then
      local slot = tonumber(col.tableSlot)
      if slot ~= nil then
        return math.floor(slot)
      end
    end
  end
  return nil
end

return D
