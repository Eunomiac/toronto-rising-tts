--[[
    Static layout for the Stage Control board (CONTROL_BOARD) and the stage playfield (STAGE_BOARD).
    Polar snap families drive dashboard stage editing + stage figurine poses; stage_token tiles are
    spawned by core.stage_tokens for the spotlight hotkey. GUIDs live in lib/guids.ttslua.

    Agent: .dev/NPC Object Spawning & Spotlighting/Storyteller Gameboard Control.md
]]

local D = {}

--- GM notes prefix on stage spotlight tokens (`npcToken:<characterKey>`).
D.TOKEN_GM_PREFIX = "npcToken:"

--- Extra world Y yaw (degrees) for stage figurines vs board-relative placement yaw (Figurine_Custom front/back vs tile).
D.STAGE_FIGURINE_YAW_OFFSET_DEG = 180

--- Local Y above the CONTROL_BOARD tile surface for objects placed on it (object-local units).
D.MINIMAP_SURFACE_LOCAL_Y = 0.24

--- Spotlight tokens spawned on the Stage Control board for stage NPCs (core.stage_tokens).
D.TAG_STAGE_TOKEN = "stage_token"
D.STAGE_TOKEN_SCALE = { x = 1.5, y = 1, z = 1.5 }

--- Fallback world XZ footprint when STAGE_BOARD is not in the save yet.
D.DEFAULT_STAGE_WORLD = {
  centerX = 0,
  centerZ = 120,
  halfWidthX = 220,
  halfDepthZ = 200,
  groundY = -15,
}

--- CONTROL_BOARD snap grid: elliptical rings in board u/v; each `snapGroups` entry is one ring.
--- Top-level `origin` is the default; rings may override it with `origin = {u,v}`. Every snap faces its ring's origin.
--- `radialStagger` (optional): STAGE_BOARD / playfield world XZ inches per family step from anchor (`abs(k) * radialStagger` along each snap's radial from `origin` on STAGE; anchor k=0 unchanged). Calibrate against STAGE size (~400), not CONTROL_BOARD tile size (~40).
--- `validSnaps` (optional): `{ minU, maxU, minV, maxV }` inclusive box on board u/v; candidates outside the box are not installed (reduces unused snaps on dense rings).
--- See .dev/NPC Object Spawning & Spotlighting/Generating Snap Points For Control Board.md
D.CONTROL_BOARD_SNAP = {
  origin = { u = 0.5, v = 0.35 },
  snapGroups = {
    {
      num = 5,
      angleDelta = 7,
      rays = 8,
      groundLevel = -60,
      radialStagger = 15,
      maxU = 0.65,
      maxV = 0.45,
      origin = { u = 0.5, v = 0.3 },
      defaultLightMode = "STANDARD",
      validSnaps = {
        minU = 0.3, maxU = 0.7, minV = 0.38, maxV = 0.5 }
    }, -- CENTER, Center Left, Center Right
    {
      num = 5,
      angleDelta = 4,
      rays = 12,
      groundLevel = -57,
      radialStagger = 10,
      maxU = 0.7,
      maxV = 0.566,
      defaultLightMode = "OFF",
      validSnaps = {
        minU = 0.35, maxU = 0.65, minV = 0.5, maxV = 0.6 }
    }, -- Mid Center, Mid Left, Mid Right
    { num = 6, angleDelta = 360 / 6, rays = 1, groundLevel = -30, radialStagger = 0, maxU = 0.3, maxV = 0.65, origin = { u = 0.25, v = 0.6 }, defaultLightMode = "OFF" }, -- Far Left
    { num = 6, angleDelta = 360 / 6, rays = 1, groundLevel = -10, radialStagger = 0, maxU = 0.45, maxV = 0.85, origin = { u = 0.4, v = 0.8 }, defaultLightMode = "OFF" }, -- Far Center-Left
    { num = 6, angleDelta = 360 / 6, rays = 1, groundLevel = -10, radialStagger = 0, maxU = 0.65, maxV = 0.85, origin = { u = 0.6, v = 0.8 }, defaultLightMode = "OFF" }, -- Far Center-Right
    { num = 6, angleDelta = 360 / 6, rays = 1, groundLevel = -30, radialStagger = 0, maxU = 0.8, maxV = 0.65, origin = { u = 0.75, v = 0.6 }, defaultLightMode = "OFF" }, -- Far Right
  }
}

--- Horizontal seat row in board u/v: `Snaps.groundLevelForSnapUv` treats a placement at this `v` as a seat, not a
--- polar ring. Each column is a numbered table chair (`tableSlot`); `seatKey` is the default occupant for that chair.
D.CONTROL_BOARD_SEAT_ROW = {
  v = 0.12,
  uMin = 0.05,
  uMax = 0.35,
  columns = {
    { seatKey = "NPC4", kind = "npc", tableSlot = 9 },
    { seatKey = "NPC2", kind = "npc", tableSlot = 7 },
    { seatKey = "Purple", kind = "pc", tableSlot = 5 },
    { seatKey = "Pink", kind = "pc", tableSlot = 3 },
    { seatKey = "Red", kind = "pc", tableSlot = 1 },
    { seatKey = "Orange", kind = "pc", tableSlot = 2 },
    { seatKey = "Brown", kind = "pc", tableSlot = 4 },
    { seatKey = "NPC1", kind = "npc", tableSlot = 6 },
    { seatKey = "NPC3", kind = "npc", tableSlot = 8 },
  },
}

--- Stage figurine placement lerp on dashboard stage apply (TOR-173). Tune in Save & Play without logic edits.
D.STAGE_PLACEMENT_LERP = {
  positionDurationSec = 1.2,
  modeOnlyDurationSec = 0.8,
  withinFamilyStaggerSec = 0.12,
  betweenFamilyStaggerSec = 0.35,
  --- Stretch between-family delay only (within-family stays even). No hard cap on batch size.
  staggerCandidateScale = 0.04,
  --- Optional ceiling on stagger multiplier (nil / 0 = no ceiling).
  staggerScaleMax = 5,
  lightOnDelayFrac = 0.75,
  lightOnSpringSec = 0.25,
  pathFps = 60,
  ease = "sineInOut",
}

--- Storyteller roll for a staged NPC (TOR-738): figurine steps to the tray while the drawer is up.
--- `centerZOffset` is subtracted from the Center group's central-spot world Z. Duration reuses
--- `STAGE_PLACEMENT_LERP.positionDurationSec`.
D.ROLL_PRESENT = {
  centerZOffset = 15,
}

return D
