<!-- Per-player transition blindfolds removed (TOR-444) — shared transition blindfold: -->

<!-- include ui/shared/panel_overlay_transition_blindfold.xml -->
<!-- Shared scene-transition blindfold (TOR-444).
     One panel for all seats; one variant Image (image= swap); one district/site card pair.
     Arm audience (U.setVisibleTo PC colors) while inactive, then UI.show parent.
     Then set overlay_blindfold_display image= (UI.show re-applies XML default image=overlay_blindfold_1).
     Phases still use ui/shared/panel_overlay_global_blindfold.xml. -->
<Defaults>
  <Image class="player_overlay_transition"
    active="true"
    width="1920"
    height="1200"
    preserveAspect="true"
    raycastTarget="false"
    rectAlignment="MiddleCenter"
  />
  <Image class="player_overlay_district_card_display"
    raycastTarget="false"
    preserveAspect="true"
    rectAlignment="LowerLeft"
    width="900"
    offsetXY="50 75"
    showAnimation="FadeIn"
    hideAnimation="FadeOut"
    animationDuration="1"
    showAnimationDelay="4"
    active="false"
    image=""
    color="clear"
  />
  <Image class="player_overlay_site_card_display"
    raycastTarget="false"
    preserveAspect="true"
    rectAlignment="LowerRight"
    width="900"
    offsetXY="-50 125"
    showAnimation="FadeIn"
    hideAnimation="FadeOut"
    animationDuration="1"
    showAnimationDelay="4.5"
    active="false"
    image=""
    color="clear"
  />
</Defaults>

<Panel id="playerHud_overlay_blindfold"
  active="false"
  width="1920"
  height="1200"
  rectAlignment="MiddleCenter"
  raycastTarget="true"
  visibility="None"
  showAnimation="FadeIn"
  hideAnimation="FadeOut"
  animationDuration="2"
  hideAnimationDelay="1">
  <Image id="overlay_blindfold_display"
    image="overlay_blindfold_1"
    class="player_overlay_transition"
    color="White" />
  <Image id="overlay_district_card_display" class="player_overlay_district_card_display" />
  <Image id="overlay_site_card_display" class="player_overlay_site_card_display" />
</Panel>

<!-- /include ui/shared/panel_overlay_transition_blindfold.xml -->


<!-- 6. Startup loading screen (last among blindfolds — draws above transition blinds when both up). -->

<!-- include ui/shared/panel_overlay_global_blindfold.xml -->
<!-- Global session blindfold — no visibility filter (all clients). active=true by default / on connect. -->
<!-- Lua: hideStartupLoadingOverlays() / showStartupLoadingOverlaysForPhases (Play hide / Intermission show). -->
<!-- Per-player transition blinds: ui/.templates/panel_overlay_blindfold.xml — root sibling beside this file (TOR-436). -->
<!-- Placed last among blindfolds in ui/Global.xml so it draws above transition blinds when both are up. -->
<!--
UI.show("overlay_globalBlindfold")
-->

<!--
UI.hide("overlay_globalBlindfold")
UI.setAttributes("overlay_globalBlindfold", {color = "rgba(1, 1, 1, 0.25)"})
-->

<Image id="overlay_globalBlindfold"
  image="global_blindfold_session_1"
  active="true"
  width="1920"
  height="1200"
  preserveAspect="true"
  raycastTarget="true"
  rectAlignment="MiddleCenter"
  showAnimation="FadeIn"
  hideAnimation="FadeOut"
  animationDuration="0.3"
/>

<!-- /include ui/shared/panel_overlay_global_blindfold.xml -->


<!-- 3. Storyteller HUD (Black): admin panel + sidebar + camera defaults -->
<Panel id="HUD_PANEL_BLACK" class="hud_root_panel" visibility="Black|Host">
  <!-- 3a. Storyteller HUD defaults -->
  
<!-- include ui/storyteller/hud_storyteller_defaults.xml -->
<!-- Storyteller HUD Defaults -->
<!-- Agent guidance: .dev/HUD_FUNCTIONS.md; .dev/TTS_BUNDLING_SETUP.md; .dev/tts-api/UI API/Defaults.md. -->
<!-- Admin panel + sidebar + camera classes. Include before hud_storyteller. -->

<Defaults>

  <!-- ================================================================ -->
  <!-- Defaults Classes (shared across all storyteller panels)           -->
  <!-- ================================================================ -->

  <Text class="hud_storyteller_header" fontSize="12" color="#FFDD00" flexibleWidth="1"/>
  <Text class="hud_storyteller_label"	fontSize="11" color="#FFD700"  />

  <Row class="hud_storyteller_button_row" preferredHeight="20" minHeight="20" spacing="0" childForceExpandWidth="false" childForceExpandHeight="false" />
  <HorizontalLayout class="hud_storyteller_button_row" childAlignment="MiddleCenter" preferredHeight="30" minHeight="30" spacing="0" childForceExpandWidth="true" childForceExpandHeight="true" />


  <!-- <Button class="hud_storyteller_button"
    fontSize="12"
    height="20"
    preferredHeight="20"
    minHeight="20"
    preferredWidth="125"
    minWidth="125"
    flexibleHeight="0"
    flexibleWidth="0"
  /> -->

  <Button class="hud_storyteller_button"
    fontSize="14"
    colors="#444444|#555555|#666666|rgba(0.3,0.3,0.3,0.5)"
    textColor="#FFFFFF" />
  <Button class="hud_storyteller_button_label" width="40" preferredWidth="40" />
  <Button class="hud_storyteller_button_icon"
    fontSize="14"
    textColor="#FFFFFF"
    fontStyle="Bold"
    height="20"
    minHeight="20"
    preferredHeight="20"
    flexibleHeight="0"
    width="20"
    minWidth="20"
    preferredWidth="20"
    flexibleWidth="0"
    alignment="MiddleCenter"
  />

  <!-- <HorizontalLayout class="hud_storyteller_control_row" preferredHeight="30" minHeight="30" spacing="4" childForceExpandWidth="true" childForceExpandHeight="true" childAlignment="MiddleLeft" /> -->

  <HorizontalLayout class="hud_storyteller_control_row" />

  <InputField class="hud_storyteller_input"
    fontSize="14"
    lineType="SingleLine"
    textColor = "#000000"
  />

  <InputField class="guid_input"
    characterLimit="6"
    flexibleWidth="0"
    characterValidation="Alphanumeric"
    placeholder="GUID" />


  <Text class="hud_storyteller_header"
    minHeight="20"
    flexibleWidth="1"
    fontSize="18"
    fontStyle="Bold"
    color="#FFFFFF"
    alignment="LowerCenter" />

  <Text class="hud_storyteller_label"
    minHeight="20"
    flexibleWidth="1"
    fontSize="16"
    fontStyle="Bold"
    color="#FFD700"
    alignment="LowerCenter" />

  <Text class="hud_storyteller_row_label"
    fontSize="14"
    alignment="MiddleLeft"
  />

  <Button class="hud_storyteller_row_button"
    minHeight="20"
    fontSize="14"
    fontStyle="Bold"
    color="#FFFFFF"
    alignment="MiddleLeft" />

  <Button class="hud_storyteller_row_button_icon"
    alignment="MiddleCenter"
    width="20"
    preferredWidth="20"
    flexibleWidth="0"
    minWidth="20"
    height="20"
    preferredHeight="20"
    flexibleHeight="0"
    minHeight="20" />

  <Row class="hud_storyteller_header" height="30" preferredHeight="30" flexibleHeight="0" childForceExpandHeight="false" childForceExpandWidth="true" />
  <Cell class="hud_storyteller_wide" columnSpan="6" childForceExpandWidth="true" />
  <Cell class="hud_storyteller_label" childForceExpandWidth="true" />

  <!-- ================================================================ -->
  <!-- Admin Panel Classes (left-side button controls)                   -->
  <!-- ================================================================ -->

  <!-- Debug seat-swap row (bottom-right, left of admin twirl-down) -->
  <Button class="debug_seat_color_button"
    text=""
    width="30"
    height="30"
    minWidth="30"
    minHeight="30"
    preferredWidth="30"
    preferredHeight="30"
    flexibleWidth="0"
    flexibleHeight="0"
    fontSize="1"
    textColor="rgba(0,0,0,0)"
    padding="0 0 0 0"
    alignment="MiddleCenter"
    outline="rgba(0,0,0,0)"
    outlineSize="0 0" />

  <HorizontalLayout class="debug_seat_color_row"
    rectAlignment="LowerRight"
    offsetXY="-34 0"
    width="190"
    height="30"
    spacing="2"
    childAlignment="MiddleRight"
    childForceExpandWidth="false"
    childForceExpandHeight="false"
    ignoreLayout="true" />

  <!-- Main button column: left-aligned, half-scale, vertically stacked (TOR-396: +100 Y) -->
  <VerticalLayout class="storyteller_buttonControls"
    padding="0 0 0 0"
    spacing="1"
    rectAlignment="LowerRight"
    childAlignment="LowerRight"
    width="200"
    height="400"
    offsetXY="-70 110"
    childForceExpandWidth="true"
    childForceExpandHeight="true" />

  <!-- ================================================================ -->
  <!-- Sidebar Classes (right-side reference image toggles)             -->
  <!-- ================================================================ -->

  <!-- Reference toggle button: show/hide on mouse events -->
  <Image class="storyteller_refButton"
    onMouseDown="HUD_show"
    onMouseUp="HUD_hide"
    onMouseEnter="HUD_highlight"
    onMouseExit="HUD_dim" />




  <Panel class="rollST_root"
    rectAlignment="LowerCenter"
    width = "900"
    height = "900"
    color = "rgba(0, 0, 0.25, 1)"
    outline = "rgba(1, 1, 0, 1)"
  />

    <GridLayout class="grid_strip" cellSize = "10 20" height = "20" spacing = "6" startCorner = "UpperLeft" startAxis = "Horizontal" constraint = "FixedRowCount" constraintCount = "1" onMouseExit="HUD_gridStripMouseExit" />
  <Panel class="grid_strip_cell" outline = "#000000" outlineSize = "-1 1" onMouseEnter="HUD_gridStripCellMouseEnter" onMouseDown="HUD_gridStripCellMouseDown" onMouseUp="HUD_gridStripCellMouseUp" />
  <Panel class="grid_strip_cell_hunger" color = "rgba(1, 0, 0, 0.15)" />
  <Panel class="grid_strip_cell_normal" color = "rgba(0.5, 0.5, 0.5, 0.15)" />
  <Panel class="grid_strip_cell_difficulty" color = "rgba(0, 1, 0, 0.15)" />
  <Text class="grid_strip_cell_difficulty_text" fontSize="9" fontStyle="Bold" />
  <Text class="grid_strip_cell_hunger_text" fontSize="9" fontStyle="Bold" />
  <Text class="grid_strip_cell_normal_text" fontSize="9" fontStyle="Bold" />

</Defaults>

<!-- /include ui/storyteller/hud_storyteller_defaults.xml -->

  
<!-- include ui/storyteller/panel_pcs_defaults.xml -->
<!-- Classes for Storyteller PCs panel (`panel_pcs.xml`). Seat tint `color` stays per-Panel; ids and row label text stay on elements. -->
<!-- Agent guidance: .dev/tts-api/UI API/Defaults.md -->
<Defaults>
  <Panel class="pcs_panel_root" padding="6 6 6 6" scale="0.75" pivot="0 1" width="680" color="rgba(0, 0, 0, 0.8)" />
  <VerticalLayout class="pcs_root_vl" spacing="8" childAlignment="UpperLeft" childForceExpandWidth="false" />

  <Panel class="pcs_seat_block" padding="6 8 6 8" />
  <VerticalLayout class="pcs_seat_column" spacing="4" flexibleWidth="1" childForceExpandWidth="false" />

  <Text class="pcs_row_title" fontSize="13" fontStyle="Bold" color="#F5F5F5" />
  <Text class="pcs_char_title" fontSize="17" fontStyle="Bold" color="#FFFFFF" />
  <Text class="pcs_desire_text" fontSize="12" color="#FCE5C1" preferredWidth="480" minWidth="200" flexibleWidth="1" alignment="MiddleLeft" />

  <HorizontalLayout class="pcs_stat_row" spacing="3" height="26" childForceExpandWidth="false" />

  <Text class="pcs_prefix_wide" fontSize="11" fontStyle="Bold" color="#FFFFFF" preferredWidth="42" minWidth="42" flexibleWidth="0" alignment="MiddleLeft" />
  <Text class="pcs_prefix_desire" fontSize="11" fontStyle="Bold" color="#FFFFFF" preferredWidth="56" minWidth="56" flexibleWidth="0" alignment="MiddleLeft" />
  <Text class="pcs_prefix_hg" fontSize="11" fontStyle="Bold" color="#FFFFFF" preferredWidth="36" minWidth="36" flexibleWidth="0" alignment="MiddleLeft" />

  <Text class="pcs_track_damage" fontSize="27" fontStyle="Bold" color="#EEEEEE" preferredWidth="280" minWidth="280" flexibleWidth="0" alignment="MiddleLeft" />
  <Text class="pcs_track_hum" fontSize="27" fontStyle="Bold"  color="#E8DDFF" preferredWidth="280" minWidth="280" flexibleWidth="0" alignment="MiddleLeft" />

  <Text class="pcs_buf_agg" fontSize="11" color="#FFCCCC" preferredWidth="34" minWidth="34" flexibleWidth="0" alignment="MiddleCenter" />
  <Text class="pcs_buf_neutral" fontSize="11" color="#EEEEEE" preferredWidth="34" minWidth="34" flexibleWidth="0" alignment="MiddleCenter" />
  <Text class="pcs_buf_hum" fontSize="11" color="#EDDFFF" preferredWidth="34" minWidth="34" flexibleWidth="0" alignment="MiddleCenter" />
  <Text class="pcs_buf_xp" fontSize="11" color="#DDF0FF" preferredWidth="34" minWidth="34" flexibleWidth="0" alignment="MiddleCenter" />
  <Text class="pcs_buf_hunger" fontSize="11" color="#FFDEB5" preferredWidth="34" minWidth="34" flexibleWidth="0" alignment="MiddleCenter" />

  <Text class="pcs_xp_val" fontSize="13" color="#CCE8FF" preferredWidth="68" minWidth="64" flexibleWidth="0" alignment="MiddleLeft" />
  <Text class="pcs_hunger_val" fontSize="12" color="#FFE0C2" preferredWidth="40" minWidth="36" flexibleWidth="0" alignment="MiddleLeft" />
  <Text class="pcs_hunger_dots" fontSize="22" fontStyle="Bold" color="#FFE0C2" preferredWidth="90" minWidth="72" flexibleWidth="0" alignment="MiddleLeft" />
  <Text class="pcs_torpor_lbl" fontSize="11" color="#F0F0F0" preferredWidth="72" minWidth="72" flexibleWidth="0" alignment="MiddleLeft" />

  <!-- Shared button base; pair with a palette class. `text` and `id` stay on the element. -->
  <Button class="pcs_btn" onClick="HUD_pcPanel" textColor="#FFFFFFFF" height="26" fontSize="12" flexibleWidth="0" />
  <Button class="pcs_btn_arrow" preferredWidth="30" minWidth="30" />
  <Button class="pcs_btn_apply_64" preferredWidth="64" minWidth="64" text="Apply" />
  <Button class="pcs_btn_apply_58" preferredWidth="58" minWidth="58" text="Apply" />
  <Button class="pcs_btn_clear_52" preferredWidth="52" minWidth="52" text="Clear" />
  <Button class="pcs_btn_torpor" preferredWidth="76" minWidth="76" text="Torpor" />
  <Button class="pcs_btn_cond" preferredWidth="86" minWidth="80" fontSize="10" height="26" />
  <Button class="pcs_btn_auto_seat" preferredWidth="88" minWidth="80" fontSize="10" height="26" text="Auto-Seat" />
  <Button class="pcs_btn_connect" preferredWidth="72" minWidth="64" fontSize="10" height="26" text="Connect" />
  <Toggle class="pcs_join_toggle" preferredWidth="128" minWidth="110" fontSize="11" textColor="#FFFFFF" />

  <Button class="pcs_btn_palette_agg" colors="#662222|#883333|#991111|rgba(0.5,0.1,0.1,0.4)" />
  <Button class="pcs_btn_palette_sup" colors="#444444|#555555|#666666|rgba(0.2,0.2,0.2,0.4)" />
  <Button class="pcs_btn_palette_track_apply" colors="#225522|#336633|#44AA44|rgba(0.1,0.3,0.1,0.4)" />
  <Button class="pcs_btn_palette_hum" colors="#553377|#664488|#7755AA|rgba(0.2,0.1,0.3,0.4)" />
  <Button class="pcs_btn_palette_hum_dark" colors="#333333|#444444|#555555|rgba(0.2,0.2,0.2,0.4)" />
  <Button class="pcs_btn_palette_hum_base" colors="#111111|#222222|#333333|rgba(0.1,0.1,0.1,0.4)" />
  <Button class="pcs_btn_palette_xp" colors="#224466|#335577|#4466AA|rgba(0.1,0.2,0.3,0.4)" />
  <Button class="pcs_btn_palette_hunger" colors="#663311|#884422|#AA5522|rgba(0.3,0.15,0.05,0.4)" />
  <Button class="pcs_btn_palette_torpor" colors="#441122|#552233|#663344|rgba(0.2,0.05,0.1,0.4)" />
  <Button class="pcs_btn_palette_frenzy" colors="#662200|#883300|#AA4400|rgba(0.35,0.1,0,0.45)" />
  <Button class="pcs_btn_palette_blindfold" colors="#222233|#333344|#444466|rgba(0.12,0.12,0.2,0.45)" />
  <Button class="pcs_btn_palette_join" colors="#1A3A4A|#285060|#3A7080|rgba(0.1,0.2,0.25,0.5)" />

  <!-- Roll initiation buttons: compact, shared base size -->
  <Button class="pcs_btn_roll" preferredWidth="52" minWidth="46" fontSize="10" height="26" onClick="HUD_rollInitiate" />
  <Button class="pcs_btn_palette_roll_std"     colors="#1A3A1A|#285028|#3A7A3A|rgba(0.1,0.25,0.1,0.5)"  />
  <Button class="pcs_btn_palette_roll_simple"  colors="#1A1A3A|#282850|#3A3A7A|rgba(0.1,0.1,0.25,0.5)"  />
  <Button class="pcs_btn_palette_roll_rouse"   colors="#3A1A0A|#502810|#7A3A10|rgba(0.25,0.1,0.04,0.5)" />
  <Button class="pcs_btn_palette_roll_wp"      colors="#1A2A3A|#284050|#3A6080|rgba(0.1,0.15,0.25,0.5)" />
  <Button class="pcs_btn_palette_roll_disc"   colors="#2A1A3A|#3A2850|#553A70|rgba(0.15,0.1,0.25,0.5)" />
  <Button class="pcs_btn_palette_roll_hum"    colors="#3A2A1A|#503828|#705040|rgba(0.25,0.18,0.1,0.5)" />
  <Button class="pcs_btn_palette_roll_frenzy"  colors="#3A0A0A|#501010|#7A1010|rgba(0.25,0.04,0.04,0.5)" />
  <Button class="pcs_btn_palette_roll_remorse" colors="#2A1A3A|#3A2050|#553070|rgba(0.15,0.1,0.25,0.5)" />
</Defaults>

<!-- /include ui/storyteller/panel_pcs_defaults.xml -->

  
<!-- include ui/storyteller/panel_stats_defaults.xml -->
<!-- Classes for Storyteller Stats panel (`panel_stats.xml`). -->
<Defaults>
  <Panel class="stats_panel_root" padding="8 8 8 8" width="680" color="rgba(0, 0, 0, 0.85)" />
  <VerticalLayout class="stats_root_vl" spacing="8" childAlignment="UpperLeft" childForceExpandWidth="true" />

  <Panel class="stats_landing" padding="4 4 4 4" />
  <Text class="stats_landing_title" fontSize="14" fontStyle="Bold" color="#FFFFFF" />

  <HorizontalLayout class="stats_target_row" spacing="6" childForceExpandWidth="false" height="32" />
  <Button class="stats_target_btn" onClick="HUD_statsTarget" preferredHeight="28" fontSize="12" preferredWidth="72" minWidth="72" flexibleWidth="0"
    colors="#333355|#444466|#555577|rgba(0.1,0.1,0.2,0.5)" textColor="#FFFFFF" />

  <Panel class="stats_detail" padding="4 4 4 4" />
  <HorizontalLayout class="stats_detail_header" spacing="8" height="28" childForceExpandWidth="false" />
  <Button class="stats_back_btn" onClick="HUD_statsBack" preferredHeight="26" preferredWidth="64" flexibleWidth="0" minWidth="64" fontSize="12" textColor="#FFFFFF"
    colors="#333333|#444444|#555555|rgba(0.2,0.2,0.2,0.5)" />
  <Text class="stats_detail_title" fontSize="15" fontStyle="Bold" color="#FFD700" flexibleWidth="1" alignment="MiddleLeft" />

  <VerticalLayout class="stats_detail_body" spacing="2" childAlignment="UpperLeft" childForceExpandWidth="true" />

  <HorizontalLayout class="stats_section_header" spacing="6" height="24" childForceExpandWidth="false" childAlignment="MiddleLeft" />
  <Text class="stats_section_title" fontSize="12" fontStyle="Bold" color="#CCCCCC" flexibleWidth="1" alignment="MiddleLeft" />
  <Button class="stats_add_btn" onClick="HUD_statsAdd" text="+" preferredWidth="24" preferredHeight="24" flexibleWidth="0" minWidth="24" flexibleHeight="0" minHeight="24" fontSize="14" fontStyle="Bold"
    colors="#225522|#336633|#44AA44|rgba(0.1,0.3,0.1,0.4)" textColor="#FFFFFF" />

  <HorizontalLayout class="stats_row" spacing="6" height="22" childForceExpandWidth="false" childAlignment="MiddleLeft" />
  <Text class="stats_row_label" fontSize="11" color="#EEEEEE" flexibleWidth="1" alignment="MiddleLeft" />
  <Button class="stats_edit_btn" onClick="HUD_statsEdit" preferredWidth="22" preferredHeight="22" flexibleWidth="0" minWidth="22" flexibleHeight="0" minHeight="22" fontSize="10"
    colors="#444444|#555555|#666666|rgba(0.2,0.2,0.2,0.4)" textColor="#FFFFFF" />

  <HorizontalLayout class="stats_rating_row" spacing="6" height="24" childForceExpandWidth="false" childAlignment="MiddleLeft" />
</Defaults>

<!-- /include ui/storyteller/panel_stats_defaults.xml -->

  
<!-- include ui/storyteller/panel_projects_defaults.xml -->
<!-- Classes for Storyteller Projects panel (`panel_projects.xml`). -->
<Defaults>
  <Panel class="projects_panel_root" padding="8 8 8 8" width="680" color="rgba(0, 0, 0, 0.85)" />
  <VerticalLayout class="projects_root_vl" spacing="8" childAlignment="UpperLeft" childForceExpandWidth="true" />

  <Panel class="projects_landing" padding="4 4 4 4" />
  <Text class="projects_landing_title" fontSize="14" fontStyle="Bold" color="#FFFFFF" />

  <HorizontalLayout class="projects_target_row" spacing="6" childForceExpandWidth="false" height="32" />
  <Button class="projects_target_btn" onClick="HUD_projectsTarget" preferredHeight="28" fontSize="12" preferredWidth="72" minWidth="72" flexibleWidth="0"
    colors="#333355|#444466|#555577|rgba(0.1,0.1,0.2,0.5)" textColor="#FFFFFF" />

  <Panel class="projects_detail" padding="4 4 4 4" />
  <HorizontalLayout class="projects_detail_header" spacing="8" height="28" childForceExpandWidth="false" />
  <Button class="projects_back_btn" onClick="HUD_projectsBack" preferredHeight="26" preferredWidth="64" flexibleWidth="0" minWidth="64" fontSize="12" textColor="#FFFFFF"
    colors="#333333|#444444|#555555|rgba(0.2,0.2,0.2,0.5)" />
  <Text class="projects_detail_title" fontSize="15" fontStyle="Bold" color="#FFD700" flexibleWidth="1" alignment="MiddleLeft" />

  <VerticalLayout class="projects_detail_body" spacing="2" childAlignment="UpperLeft" childForceExpandWidth="true" />

  <HorizontalLayout class="projects_section_header" spacing="6" height="24" childForceExpandWidth="false" childAlignment="MiddleLeft" />
  <Text class="projects_section_title" fontSize="12" fontStyle="Bold" color="#CCCCCC" flexibleWidth="1" alignment="MiddleLeft" />
  <Button class="projects_add_btn" onClick="HUD_projectsAdd" text="+" preferredWidth="24" preferredHeight="24" flexibleWidth="0" minWidth="24" flexibleHeight="0" minHeight="24" fontSize="14" fontStyle="Bold"
    colors="#225522|#336633|#44AA44|rgba(0.1,0.3,0.1,0.4)" textColor="#FFFFFF" />

  <HorizontalLayout class="projects_row" spacing="6" height="22" childForceExpandWidth="false" childAlignment="MiddleLeft" />
  <Text class="projects_row_label" fontSize="11" color="#EEEEEE" flexibleWidth="1" alignment="MiddleLeft" />
  <Button class="projects_edit_btn" onClick="HUD_projectsEdit" preferredWidth="22" preferredHeight="22" flexibleWidth="0" minWidth="22" flexibleHeight="0" minHeight="22" fontSize="10"
    colors="#444444|#555555|#666666|rgba(0.2,0.2,0.2,0.4)" textColor="#FFFFFF" />
</Defaults>

<!-- /include ui/storyteller/panel_projects_defaults.xml -->


  <!-- 3b. Storyteller HUD -->
  
<!-- include ui/storyteller/hud_storyteller.xml -->
<!-- Storyteller HUD Layout -->
<!-- Agent guidance: .dev/HUD_FUNCTIONS.md; .dev/TTS_BUNDLING_SETUP.md; .dev/TESTING.md. -->
<!-- Visibility: Black (Storyteller/GM) -->
<!-- Left-side game phase controls + debug panels -->
<!-- Also includes sidebar (reference toggles) and camera bar via sub-includes -->

<Panel id="adminControls" visibility="Host">
  <HorizontalLayout class="debug_seat_color_row">
    <Button id="debugSeat_Black" class="debug_seat_color_button" colors="#1A1A1A|#2A2A2A|#0F0F0F|#1A1A1A" onClick="HUD_debugSeatColor" />
    <Button id="debugSeat_Red" class="debug_seat_color_button" colors="#B22222|#C42828|#901818|#B22222" onClick="HUD_debugSeatColor" />
    <Button id="debugSeat_Orange" class="debug_seat_color_button" colors="#E67300|#F08010|#CC6600|#E67300" onClick="HUD_debugSeatColor" />
    <Button id="debugSeat_Brown" class="debug_seat_color_button" colors="#6B4423|#7A5030|#5A3820|#6B4423" onClick="HUD_debugSeatColor" />
    <Button id="debugSeat_Pink" class="debug_seat_color_button" colors="#C71585|#D02090|#B01075|#C71585" onClick="HUD_debugSeatColor" />
    <Button id="debugSeat_Purple" class="debug_seat_color_button" colors="#5E2A7E|#6E358E|#4E2070|#5E2A7E" onClick="HUD_debugSeatColor" />
  </HorizontalLayout>
  <Button id="toggleElem_adminControlsBody" class="hud_storyteller_button hud_storyteller_button_icon" onClick="HUD_togglePanel" rectAlignment="LowerRight" width="30" height="30">►</Button>
  <VerticalLayout class="storyteller_buttonControls" visibility="Host" height="30" childForceExpandHeight="false">
  </VerticalLayout>
  <Panel id="adminControlsBody" active="false">

    <!-- ================================================================ -->
    <!-- Main Button Column (left side): Print State + debug test buttons  -->
    <!-- ================================================================ -->
    <VerticalLayout class="storyteller_buttonControls" visibility="Host" height="370">
      <Text class="hud_storyteller_header">== DEBUG ==</Text>
      <Text id="debug_lastLoadClock" fontSize="12" color="#AAAAAA" alignment="MiddleCenter" text="" />
      <Button id="debug_overlayAlpha" class="hud_storyteller_button" onClick="HUD_toggleOverlayAlpha">Overlay Alpha: Full</Button>
      <Button class="hud_storyteller_button" onClick="HUD_printState">Print State</Button>
      <Button class="hud_storyteller_button" onClick="HUD_syncAll">Sync All (force)</Button>
      <Button class="hud_storyteller_button" onClick="HUD_updateCoterieData">Update Coterie Data</Button>
      <Button class="hud_storyteller_button" onClick="HUD_clearLoadingOverlay">Clear Loading Overlay</Button>
      <Button class="hud_storyteller_button" onClick="HUD_refreshUi">Refresh UI</Button>
      <Button class="hud_storyteller_button" onClick="HUD_toggleDebugAmbient">Toggle Lights</Button>
      <Button class="hud_storyteller_button" onClick="HUD_toggleAssumePlayersConnected">Assume Players Connected</Button>
      <Button class="hud_storyteller_button" onClick="HUD_toggleRunTestPanel">RunTest</Button>
      <Button class="hud_storyteller_button" onClick="HUD_toggleAllAnchors">Toggle Anchors</Button>
      <Button class="hud_storyteller_button" onClick="HUD_toggleAllSpotlights">Toggle Spotlights</Button>
      <Button class="hud_storyteller_button" onClick="HUD_debugCameraActivate">Debug Camera</Button>
      <HorizontalLayout class="hud_storyteller_control_row">
        <Button class="hud_storyteller_button" onClick="HUD_debugLightActivate">Debug Light</Button>
        <InputField id="dl_guid" class="hud_storyteller_input guid_input" onValueChanged="HUD_debugLightGuidInput" onEndEdit="HUD_debugLightGuidInput"></InputField>
      </HorizontalLayout>
    </VerticalLayout>

    
<!-- include ui/storyteller/panel_debug_light.xml -->
<Defaults>

  <HorizontalLayout flexibleHeight="0" />
  <Text flexibleWidth="0" />
  <Button flexibleWidth="0" flexibleHeight="0" />
  <Slider minWidth="300" />
</Defaults>

<!-- Focused spotlight debug: sliders + snapshot (Host). Handlers: HUD_debugLight* in global_script. -->
<Panel id="panel_debug_light_root" active="false" color="rgba(0,0,0,0.82)" padding="10 10 10 10" width="500" scale="0.8" rectAlignment="MiddleLeft" offsetXY="100 0" raycastTarget="true">
  <VerticalLayout spacing="5" childForceExpandWidth="true" childForceExpandHeight="false">
    <Text id="dl_debug_light_label" fontSize="14" color="#FFDD00" preferredHeight="32">Debug Light</Text>

    <HorizontalLayout preferredHeight="30" childForceExpandWidth="true" spacing="6" childAlignment="MiddleLeft">
      <Text preferredWidth="110" fontSize="12" color="#CCCCCC">Light on</Text>
      <Toggle id="dl_enabled" isOn="true" onValueChanged="HUD_debugLightEnabled" flexibleWidth="1" minWidth="80">On</Toggle>
      <Button id="dl_reset_enabled" preferredWidth="30" preferredHeight="30" minWidth="30" minHeight="30" flexibleWidth="0" fontSize="12" padding="0 0 0 0" colors="#555555|#666666|#777777|#444444" onClick="HUD_debugLightResetRow">&#x21BA;</Button>
    </HorizontalLayout>

    <HorizontalLayout preferredHeight="30" childForceExpandWidth="true" spacing="6" childAlignment="MiddleLeft">
      <Text preferredWidth="110" fontSize="12" color="#CCCCCC">Range</Text>
      <Slider id="dl_range" minValue="0" maxValue="200" value="80" flexibleWidth="1" onValueChanged="HUD_debugLightSlider" />
      <Button id="dl_reset_range" preferredWidth="30" preferredHeight="30" minWidth="30" minHeight="30" flexibleWidth="0" fontSize="12" padding="0 0 0 0" colors="#555555|#666666|#777777|#444444" onClick="HUD_debugLightResetRow">&#x21BA;</Button>
    </HorizontalLayout>
    <HorizontalLayout preferredHeight="30" childForceExpandWidth="true" spacing="6" childAlignment="MiddleLeft">
      <Text preferredWidth="110" fontSize="12" color="#CCCCCC">Spot angle</Text>
      <Slider id="dl_angle" minValue="0" maxValue="180" value="90" flexibleWidth="1" onValueChanged="HUD_debugLightSlider" />
      <Button id="dl_reset_angle" preferredWidth="30" preferredHeight="30" minWidth="30" minHeight="30" flexibleWidth="0" fontSize="12" padding="0 0 0 0" colors="#555555|#666666|#777777|#444444" onClick="HUD_debugLightResetRow">&#x21BA;</Button>
    </HorizontalLayout>
    <HorizontalLayout preferredHeight="30" childForceExpandWidth="true" spacing="6" childAlignment="MiddleLeft">
      <Text preferredWidth="110" fontSize="12" color="#CCCCCC">Intensity</Text>
      <Slider id="dl_intensity" minValue="0" maxValue="12" value="1" flexibleWidth="1" onValueChanged="HUD_debugLightSlider" />
      <Button id="dl_reset_intensity" preferredWidth="30" preferredHeight="30" minWidth="30" minHeight="30" flexibleWidth="0" fontSize="12" padding="0 0 0 0" colors="#555555|#666666|#777777|#444444" onClick="HUD_debugLightResetRow">&#x21BA;</Button>
    </HorizontalLayout>
    <HorizontalLayout preferredHeight="30" childForceExpandWidth="true" spacing="6" childAlignment="MiddleLeft">
      <Text preferredWidth="110" fontSize="12" color="#CCCCCC">Hue</Text>
      <Slider id="dl_hue" minValue="0" maxValue="360" wholeNumbers="true" value="0" flexibleWidth="1" onValueChanged="HUD_debugLightSlider" />
      <Button id="dl_reset_hue" preferredWidth="30" preferredHeight="30" minWidth="30" minHeight="30" flexibleWidth="0" fontSize="12" padding="0 0 0 0" colors="#555555|#666666|#777777|#444444" onClick="HUD_debugLightResetRow">&#x21BA;</Button>
    </HorizontalLayout>
    <HorizontalLayout preferredHeight="30" childForceExpandWidth="true" spacing="6" childAlignment="MiddleLeft">
      <Text preferredWidth="110" fontSize="12" color="#CCCCCC">Saturation</Text>
      <Slider id="dl_saturation" minValue="0" maxValue="1" value="0" flexibleWidth="1" onValueChanged="HUD_debugLightSlider" />
      <Button id="dl_reset_saturation" preferredWidth="30" preferredHeight="30" minWidth="30" minHeight="30" flexibleWidth="0" fontSize="12" padding="0 0 0 0" colors="#555555|#666666|#777777|#444444" onClick="HUD_debugLightResetRow">&#x21BA;</Button>
    </HorizontalLayout>
    <HorizontalLayout preferredHeight="30" childForceExpandWidth="true" spacing="6" childAlignment="MiddleLeft">
      <Text preferredWidth="110" fontSize="12" color="#CCCCCC">Brightness</Text>
      <Slider id="dl_brightness" minValue="0" maxValue="1" value="1" flexibleWidth="1" onValueChanged="HUD_debugLightSlider" />
      <Button id="dl_reset_brightness" preferredWidth="30" preferredHeight="30" minWidth="30" minHeight="30" flexibleWidth="0" fontSize="12" padding="0 0 0 0" colors="#555555|#666666|#777777|#444444" onClick="HUD_debugLightResetRow">&#x21BA;</Button>
    </HorizontalLayout>
    <HorizontalLayout preferredHeight="30" childForceExpandWidth="true" spacing="6" childAlignment="MiddleLeft">
      <Text preferredWidth="110" fontSize="12" color="#CCCCCC">Rot X</Text>
      <Slider id="dl_rotX" minValue="-180" maxValue="180" value="0" flexibleWidth="1" onValueChanged="HUD_debugLightSlider" />
      <Button id="dl_reset_rotX" preferredWidth="30" preferredHeight="30" minWidth="30" minHeight="30" flexibleWidth="0" fontSize="12" padding="0 0 0 0" colors="#555555|#666666|#777777|#444444" onClick="HUD_debugLightResetRow">&#x21BA;</Button>
    </HorizontalLayout>
    <HorizontalLayout preferredHeight="30" childForceExpandWidth="true" spacing="6" childAlignment="MiddleLeft">
      <Text preferredWidth="110" fontSize="12" color="#CCCCCC">Rot Y</Text>
      <Slider id="dl_rotY" minValue="-180" maxValue="180" value="0" flexibleWidth="1" onValueChanged="HUD_debugLightSlider" />
      <Button id="dl_reset_rotY" preferredWidth="30" preferredHeight="30" minWidth="30" minHeight="30" flexibleWidth="0" fontSize="12" padding="0 0 0 0" colors="#555555|#666666|#777777|#444444" onClick="HUD_debugLightResetRow">&#x21BA;</Button>
    </HorizontalLayout>
    <HorizontalLayout preferredHeight="30" childForceExpandWidth="true" spacing="6" childAlignment="MiddleLeft">
      <Text preferredWidth="110" fontSize="12" color="#CCCCCC">Rot Z</Text>
      <Slider id="dl_rotZ" minValue="-180" maxValue="180" value="0" flexibleWidth="1" onValueChanged="HUD_debugLightSlider" />
      <Button id="dl_reset_rotZ" preferredWidth="30" preferredHeight="30" minWidth="30" minHeight="30" flexibleWidth="0" fontSize="12" padding="0 0 0 0" colors="#555555|#666666|#777777|#444444" onClick="HUD_debugLightResetRow">&#x21BA;</Button>
    </HorizontalLayout>
    <HorizontalLayout preferredHeight="30" childForceExpandWidth="true" spacing="6" childAlignment="MiddleLeft">
      <Text preferredWidth="110" fontSize="12" color="#CCCCCC">Distance</Text>
      <Slider id="dl_distance" minValue="-80" maxValue="80" value="0" flexibleWidth="1" onValueChanged="HUD_debugLightSlider" />
      <Button id="dl_reset_distance" preferredWidth="30" preferredHeight="30" minWidth="30" minHeight="30" flexibleWidth="0" fontSize="12" padding="0 0 0 0" colors="#555555|#666666|#777777|#444444" onClick="HUD_debugLightResetRow">&#x21BA;</Button>
    </HorizontalLayout>

    <HorizontalLayout preferredHeight="32" spacing="8" childAlignment="MiddleCenter">
      <Button class="smallButton" preferredWidth="120" fontSize="11" onClick="HUD_debugLightSnapshot">Snapshot</Button>
      <Button class="smallButton" preferredWidth="120" fontSize="11" onClick="HUD_debugLightDone">Done</Button>
    </HorizontalLayout>
  </VerticalLayout>
</Panel>

