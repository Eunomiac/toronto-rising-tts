    <Button id="rollPanelST_btnHalf" active="false" fontSize="11" preferredWidth="100" preferredHeight="30" color="rgba(0.2,0.2,0.5,1)" onClick="HUD_rollTakeHalf" text="TAKE HALF" />
    <Button id="rollPanelST_btnWP" active="false" fontSize="11" preferredWidth="140" preferredHeight="30" color="rgba(0.4,0.1,0.1,1)" onClick="HUD_rollSpendWP" text="SPEND WILLPOWER" />
    <Button id="rollPanelST_btnRecalc" active="false" fontSize="11" preferredWidth="110" preferredHeight="30" color="rgba(0.25,0.25,0.35,1)" onClick="HUD_rollRecalculate" text="RECALCULATE" />
    <Button id="rollPanelST_btnReroll" active="false" fontSize="11" preferredWidth="90" preferredHeight="30" color="rgba(0.35,0.25,0.1,1)" onClick="HUD_rollStRerollSelected" text="REROLL" interactable="false" />
    <Button id="rollPanelST_btnConfirm" active="false" fontSize="13" preferredWidth="90" preferredHeight="30" color="rgba(0.1,0.4,0.1,1)" onClick="HUD_rollConfirm" text="CONFIRM" interactable="false" />
    <Button id="rollPanelST_btnCancel" fontSize="11" preferredWidth="70" preferredHeight="30" color="rgba(0.5,0.1,0.1,1)" onClick="HUD_rollCancel" text="CANCEL" />
    <Button id="rollPanelST_btnOblivHunger" active="false" fontSize="10" preferredWidth="130" preferredHeight="28" color="rgba(0.3,0.2,0.5,1)" onClick="HUD_rollConfirmOblivChoice" text="CONFIRM — HUNGER" />
    <Button id="rollPanelST_btnOblivStain" active="false" fontSize="10" preferredWidth="120" preferredHeight="28" color="rgba(0.35,0.15,0.35,1)" onClick="HUD_rollConfirmOblivChoice" text="CONFIRM — STAIN" />
    <Button id="rollPanelST_btnBrutalFail" active="false" fontSize="10" preferredWidth="110" preferredHeight="28" color="rgba(0.4,0.15,0.1,1)" onClick="HUD_rollConfirmBrutalChoice" text="CONFIRM FAIL" />
    <Button id="rollPanelST_btnBrutalViolence" active="false" fontSize="10" preferredWidth="130" preferredHeight="28" color="rgba(0.5,0.1,0.1,1)" onClick="HUD_rollConfirmBrutalChoice" text="CONFIRM VIOLENCE" />
  </HorizontalLayout>

</Panel>
<!-- /include ui/storyteller/panel_storyteller_roll_controls.xml -->


<!-- include ui/storyteller/panel_storyteller_toolbar.xml -->
<!-- Storyteller bottom-right tool bar + pop-out panels (Black) -->
<!-- Agent guidance: .dev/HUD_FUNCTIONS.md -->

<Defaults>

  <Panel class="storyteller_panel_root"
    visibility = "Host"
    rectAlignment = "UpperLeft"
    offsetXY = "50 0"
    width = "1100"
    height = "900"
    padding = "0 0 0 0"
    childAlignment = "UpperLeft" />

  <Button class="hud_storyteller_twirldown_button"
    ignoreLayout = "true"
    height = "30"
    width = "30"
    rectAlignment = "UpperLeft" />

  <VerticalLayout class="storyteller_control_container"
    spacing="4"
    childAlignment="UpperLeft"
    childForceExpandWidth = "true"
    childForceExpandHeight = "false" />

  <HorizontalLayout class="storyteller_button_bar"
    padding = "30 400 0 0"
    flexibleHeight = "0"
    spacing= "3" />

  <Button class="storyteller_panel_button"
    colors="#444444|#555555|#666666|rgba(0.3,0.3,0.3,0.5)"
    onClick="HUD_selectStorytellerPanel"
    textColor="#FFFFFF" />

  <Panel class="storyteller_control_content"
    padding="0 0 0 0"
    childForceExpandHeight = "true"
    flexibleHeight = "1"
    childForceExpandWidth = "true" />

  <HorizontalLayout class="storyteller_three_panel_container"
    spacing="8"
    padding="0 0 0 0"
    color = "rgba(0, 0, 0, 0.85)"
    childAlignment="UpperLeft"
    childForceExpandHeight="true"
    childForceExpandWidth="true" />

  <!-- Storyteller modal panels (Scenes, Sound, Phases, …): shared semi-opaque backdrop -->
  <VerticalLayout class="storyteller_panel_column"
    color="rgba(0, 0, 0, 0.8)"
    spacing="6"
    padding="6 6 6 6"
    childForceExpandWidth="true"
    flexibleWidth = "1"
    minWidth = "0"
    preferredWidth = "0"
  />

  <Text class="body_text"
    fontSize="12"
    color="#AAAAAA"
  />

  <Text class="small_header_text"
   alignment = "MiddleCenter"
   fontStyle = "Bold"
   fontSize = "14"
   preferredWidth = "200"
   flexibleWidth = "1"
  />

  <VerticalLayout class="hud_storyteller_inner_column"
    spacing="6"
    childForceExpandWidth="true"
    childAlignment="UpperMiddle"
    minWidth = "0"
    flexibleWidth = "1"
    preferredWidth = "250" />


</Defaults>

<!--
UI.setAttributes("storytellerToolbarRoot", {width = "1100"})
-->

<!-- Master root container -->
<Panel id="storytellerToolbarRoot" class="storyteller_panel_root">

  <!-- Twirl-down Collapsible Button Toggle -->
  <Button id="toggleElem_storytellerToolbarBody" class="hud_storyteller_twirldown_button" onClick="HUD_togglePanel">►</Button>

  <!-- Toggleable full content container -->
  <VerticalLayout id="storytellerToolbarBody" class="storyteller_control_container" active="false" >

    <!-- Top navigation buttons -->
    <HorizontalLayout class="storyteller_button_bar" >
      <Button id="toggle_scenes" text="Scenes" class="storyteller_panel_button"  />
      <Button id="toggle_soundscape" text="Sound" class="storyteller_panel_button" />
      <Button id="toggle_pcs" text="PCs" class="storyteller_panel_button" />
      <Button id="toggle_phases" text="Phases" class="storyteller_panel_button" />
      <Button id="toggle_stats" text="Stats" class="storyteller_panel_button" />
      <Button id="toggle_projects" text="Projects" class="storyteller_panel_button" />
    </HorizontalLayout>

    <!-- Main content panels -->
    <Panel id="storytellerContentArea" class="storyteller_control_content" active="false">

      <!-- Scenes Panel -->
      <HorizontalLayout id="panel_scenes_host" class="storyteller_three_panel_container">
      <!--
      UI.setAttributes("panel_scenes", {})
      UI.setAttributes("panel_scenes_library", {})
      UI.setAttributes("db_third_column", {active="false"})
      -->
        
<!-- include ui/storyteller/panel_scenes.xml -->
<!-- Storyteller Scenes: lighting presets, table, seat narrative presence, location keys, clock (see core/storyteller_scenes_panel.ttslua). -->
<!-- `active` stays true while parent `panel_scenes_host` controls tab visibility. Width 596 pairs with library column inside 1200px host. -->


<VerticalLayout id="panel_scenes" class="storyteller_panel_column">
  <Text id="db_panel_scenes_header" class="hud_storyteller_header">Scenes</Text>

  <Text id="db_panel_scenes_table_header" class="hud_storyteller_label">Table Selection</Text>
  <HorizontalLayout id="db_panel_scenes_table_buttons" class="hud_storyteller_button_row" spacing="4" childForceExpandWidth="false">
    <Button id="scenes_tbl_TableA" text="Table A" minWidth="72" onClick="HUD_scenesPanel" colors="#444444|#555555|#666666|rgba(0.3,0.3,0.3,0.5)" />
    <Button id="scenes_tbl_TableB" text="Table B" minWidth="72" onClick="HUD_scenesPanel" colors="#444444|#555555|#666666|rgba(0.3,0.3,0.3,0.5)" />
