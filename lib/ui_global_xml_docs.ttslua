  <HorizontalLayout class="rollPanelST_dicePool_container" height = "40" rectAlignment = "UpperLeft" spacing = "16" childAlignment = "MiddleLeft" offsetXY = "0 -50" childForceExpandHeight = "true" childForceExpandWidth = "false" padding = "100 0 0 0" />

  <HorizontalLayout class="rollPanelST_rousePool_container" spacing="4" childAlignment="MiddleCenter" childForceExpandWidth="false" />
  <Text class="rollPanelST_rousePool_text" fontSize="24" color="#8B1A1A" />
  <HorizontalLayout class="rollPanelST_normalPool_container" spacing="2" childAlignment="MiddleCenter" childForceExpandWidth="false" />
  <Text class="rollPanelST_normalPool_text" fontSize="24" color="#FFFFFF"  />
  <Text class="rollPanelST_hungerPool_text" fontSize="24" color="#CC3333"  />
  <Text class="rollPanelST_oblivPool_text" fontSize="24" color="#5C2D7A"  />
  <Text class="rollPanelST_werewolfPool_text" fontSize="24" color="#9ACD32" />
  <Text class="rollPanelST_ragePool_text" fontSize="24" color="#FF8C00" />

  <HorizontalLayout class="rollPanelST_dicePool" height="20" rectAlignment = "UpperCenter" childAlignment = "MiddleLeft" padding = "100 0 0 0" spacing="10" childForceExpandWidth="false" />
  <Text class="grid_strip_cell_hunger_text" fontSize="9" fontStyle="Bold" color="#FFFFFF" />
  <Text class="grid_strip_cell_normal_text" fontSize="9" fontStyle="Bold" color="#FFFFFF" />
  <Text class="grid_strip_cell_difficulty_text" fontSize="9" fontStyle="Bold" color="#FFFFFF" />

  <HorizontalLayout class="rollPanelST_diceRolls_container" spacing="2" childAlignment="MiddleCenter" childForceExpandWidth="false" childForceExpandHeight="false" minHeight="48" preferredHeight="48" />
  <Panel class="rollPanelST_dieSlot" childForceExpandWidth="false" childForceExpandHeight="false" padding="1 1 1 1" color="rgba(0,0,0,0.01)" outline="rgba(0,0,0,0)" outlineSize="0 0" />
  <Image class="rollPanelST_die" active="false" preferredWidth="30" preserveAspect="True" outline="rgba(0,0,0,0)" outlineSize="0 0" />

  <HorizontalLayout class="rollPanelST_successes_container" spacing="10" height = "40" rectAlignment = "LowerCenter" childForceExpandHeight = "true" childAlignment="MiddleRight" childForceExpandWidth="false" padding="0 50 0 0" />

  <Text class="rollPanelST_successes" fontSize="18" fontStyle="Bold" color="#CCCCCC" alignment="MiddleRight" />

</Defaults>


