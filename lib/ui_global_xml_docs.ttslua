  <Text id="db_panel_scenes_library_controls_header" class="hud_storyteller_label">Scene Controls</Text>

  <GridLayout id="scenes_lib_btns_grid_1" cellSize="125 30" spacing="8 6" constraint="FixedRowCount" constraintCount="1" childAlignment="MiddleCenter" childForceExpandWidth="true" childForceExpandHeight="true">

    <Button id="scenes_lib_btn_apply_clock" class="hud_storyteller_button" text="Scene Time" onClick="HUD_scenesLibApply" colors="#4444FF|#5555FF|#6666FF|rgba(0.3,0.3,1,0.5)" textColor="#FFFFFF" />

    <Button id="scenes_lib_btn_apply_x5" class="hud_storyteller_button" text="×5 to Now" onClick="HUD_scenesLibApply" colors="#4444FF|#5555FF|#6666FF|rgba(0.3,0.3,1,0.5)" textColor="#FFFFFF" />

    <Button id="scenes_lib_btn_apply_set_present" class="hud_storyteller_button" text="SET Now" onClick="HUD_scenesLibApply" colors="#4444FF|#5555FF|#6666FF|rgba(0.3,0.3,1,0.5)" textColor="#FFFFFF" />

    <Button id="scenes_lib_btn_apply_present" class="hud_storyteller_button" text="NOW" onClick="HUD_scenesLibApply" colors="#4444FF|#5555FF|#6666FF|rgba(0.3,0.3,1,0.5)" textColor="#FFFFFF" />

  </GridLayout>

  <GridLayout id="scenes_lib_btns_grid_2" cellSize="125 30" spacing="8 6" constraint="FixedRowCount" constraintCount="1" childAlignment="MiddleCenter" childForceExpandWidth="true" childForceExpandHeight="true">

    <Button id="scenes_lib_btn_apply_present_15" class="hud_storyteller_button" text="NOW +15" onClick="HUD_scenesLibApply" colors="#4444FF|#5555FF|#6666FF|rgba(0.3,0.3,1,0.5)" textColor="#FFFFFF" />

    <Button id="scenes_lib_btn_apply_present_30" class="hud_storyteller_button" text="NOW +30" onClick="HUD_scenesLibApply" colors="#4444FF|#5555FF|#6666FF|rgba(0.3,0.3,1,0.5)" textColor="#FFFFFF" />

    <Button id="scenes_lib_btn_apply_present_60" class="hud_storyteller_button" text="NOW +60" onClick="HUD_scenesLibApply" colors="#4444FF|#5555FF|#6666FF|rgba(0.3,0.3,1,0.5)" textColor="#FFFFFF" />

    <Button id="scenes_lib_btn_apply_present_120" class="hud_storyteller_button" text="NOW +120" onClick="HUD_scenesLibApply" colors="#4444FF|#5555FF|#6666FF|rgba(0.3,0.3,1,0.5)" textColor="#FFFFFF" />

  </GridLayout>
