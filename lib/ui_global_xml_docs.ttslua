UI.setAttributes("playerHud_mapViewport_Red", {color = "rgba(1, 0, 0, 0.15)", minHeight = "3000", height = "3000", preferredHeight = "3000"})
UI.setAttributes("playerHud_mapDraggable_Red", {color = "rgba(1, 1, 0, 0.15)"})
UI.setAttributes("playerHud_corePanel_map_Red", {offsetXY = "0 -100"})
UI.setAttributes("playerHud_mapPanel_districtCard_Red", {offsetXY = "0 -300"})
UI.setAttributes("db_hud_map_hover_button_panel_wrapper_Red", {offsetXY = "0 0", color = "rgba(1, 0, 0, 0.15)", padding = "0 0 0 0", childAlignment = "UpperLeft", preferredHeight = "1300", minHeight = "1300", height = "1300"})

local viewportData = UI.getAttributes("playerHud_mapViewport_Red")
local draggableData = UI.getAttributes("playerHud_mapDraggable_Red")
local buttonWrapperPanelData = UI.getAttributes("db_hud_map_hover_button_panel_wrapper_Red")

local function prettyPrintTable(tbl, name, indent)
  indent = indent or ""
  name = name or "table"
  print(indent .. tostring(name) .. " = {")
  local nextIndent = indent .. "  "
  for k, v in pairs(tbl) do
    local keyStr = tostring(k)
    local valueStr
    if type(v) == "table" then
      prettyPrintTable(v, keyStr, nextIndent)
    else
      if type(v) == "string" then
        valueStr = '"' .. tostring(v) .. '"'
      else
        valueStr = tostring(v)
      end
      print(nextIndent .. keyStr .. " = " .. valueStr .. ",")
    end
  end
  print(indent .. "}")
end

prettyPrintTable(buttonWrapperPanelData, "buttonWrapperPanelData")
prettyPrintTable(viewportData, "viewportData")
prettyPrintTable(draggableData, "draggableData")

-->
