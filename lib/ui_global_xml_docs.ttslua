<!-- include ui/storyteller/panel_runtest.xml -->
<Defaults>
  <Panel class="panel_runtest"
    rectAlignment="LowerLeft"
    offsetXY="0 0"
    width="520"
    height="60"
    color="rgba(0,0,0,0)"
    raycastTarget="true" />
  <HorizontalLayout class="runtest_button_row"
    spacing="8"
    childAlignment="MiddleLeft"
    childForceExpandWidth="false"
    childForceExpandHeight="false" />
  <Button class="runtest_button"
    fontSize="18"
    fontStyle="Bold"
    preferredWidth="110"
    preferredHeight="40"
    minWidth="90"
    minHeight="40"
    flexibleWidth="0"
    flexibleHeight="0"
    colors="#2A4A6A|#3A5A7A|#1A3A5A|#2A4A6A"
    textColor="#FFFFFF" />
  <Text class="runtest_text"
    fontSize="22"
    fontStyle="Bold"
    color="#FFFFFF"
    alignment="MiddleLeft"
    preferredWidth="120"
    preferredHeight="40"
    flexibleWidth="0"
    flexibleHeight="0" />
  <!-- Standard (not IntegerNumber): step index (1..N) or suite id (0, A–P, E2). -->
  <InputField class="runtest_input" contentType="Standard" characterLimit="3" alignment="MiddleCenter" preferredWidth="0" minWidth="52" flexibleHeight="0" flexibleWidth="0" placeholder="1" />
</Defaults>

<Panel id="panel_runtest" class="panel_runtest" visibility="Host" active="false"> <!-- Initially inactive. Is toggled on by a button that should be added to the Storyteller's DEBUG panel. -->

  <!-- Active by default. Campaign buttons + step/suite InputField (default 1). Suite letters match RunTest("Dice", "I"). -->
  <HorizontalLayout id="panel_runtest_start" class="runtest_button_row" rectAlignment="LowerLeft" offsetXY = "20 20" width="500" height="40">
    <Button id="button_runtest_Dice" class="runtest_button" onClick="HUD_runtest">Dice</Button>
    <Button id="button_runtest_Scenes" class="runtest_button" onClick="HUD_runtest">Scenes</Button>
    <Button id="button_runtest_Gameboard" class="runtest_button" onClick="HUD_runtest">Gameboard</Button>

    <InputField id="input_runtest_step" class="runtest_input" onValueChanged="HUD_runtest_step" onEndEdit="HUD_runtest_step" text="1" />
  </HorizontalLayout>

  <!-- Once a test has started, the start HorizontalLayout is hidden and the live HorizontalLayout is revealed. "Continue" runs `RunTest()`, while "Stop" stops the test sequence. The step number is displayed in the text field. -->
  <HorizontalLayout id="panel_runtest_live" class="runtest_button_row" rectAlignment="LowerLeft" offsetXY = "20 20" width="500" height="40" active="false">
    <Button id="button_runtest_Next" class="runtest_button" onClick="HUD_runtest">Continue</Button>
    <Button id="button_runtest_Stop" class="runtest_button" onClick="HUD_runtest">Stop</Button>
    <Text id="text_runtest_step" class="runtest_text" text="Step 1" />

  </HorizontalLayout>
</Panel>
<!-- /include ui/storyteller/panel_runtest.xml -->


<!-- /include ui/storyteller/hud_storyteller.xml -->

</Panel>


<!-- 5. Dice System Panels (roll panels + ST dashboard + result broadcast) -->
<!-- Result broadcast: ui/shared/panel_roll_results.xml (via roll_panels.xml) -->
<!-- Included outside the player/ST panels so the broadcast panel is visible to all. -->

<!-- include ui/shared/roll_panels.xml -->
<!-- Roll System Panels (ui/shared/roll_panels.xml) -->
<!-- Included from ui/Global.xml at root level (outside HUD_PANEL_BLACK/PLAYER). -->
<!-- Contains three surfaces:                                                       -->
<!--   1. ST Roll Dashboard (rollDash_ST)          — Black|Host only               -->
<!--   2. Player Roll Panels — PC: ui/player/panel_roll_controls.xml (generated)   -->
<!--      ST live roll: rollPanel_Black in this file                               -->
<!--   3. Result Broadcast (rollRes_panel)         — ui/shared/panel_roll_results.xml -->
<!-- Agent guidance: .dev/Dice System/Dice System Outline.md §8, §10               -->

<Defaults>

  <!-- Outer 750 = inner 730 (DASH_LAYOUT.WIDTH) + 10px horizontal padding each side -->
  <Panel class="rollPanel_ST"
    visibility="Black|Host"
    active="False"
    rectAlignment="LowerRight"
    offsetXY="0 0"
    padding="10 10 10 10"
    width="530" />

  <Panel class="rollPanel_player"
    active="False"
    rectAlignment="MiddleRight"
    offsetXY="40 0"
    width="480"
    padding="12 10 12 10"
    childAlignment="MiddleRight"
    childForceExpandHeight="false" />

  <VerticalLayout class="rollPanel_player_content"
    spacing="6"
    childAlignment="MiddleRight"
    childForceExpandWidth="true"
    childForceExpandHeight="false"
    color="#000000" />

</Defaults>


<!-- ============================================================================ -->
<!-- 1. ST ROLL DASHBOARD                                                          -->
<!-- Shows all active player rolls. ST can set difficulty and open/confirm each.   -->
<!-- Body rows: generated ui/shared/roll_dash_generated.xml (TOR-218)              -->
<!-- ============================================================================ -->
<Panel id="rollDash_ST" class="rollPanel_ST">
  
<!-- include ui/shared/roll_dash_generated.xml -->
<!-- Generated file. Edit ui/.templates/roll/dash_body.xml and partials under ui/.templates/roll/partials/ only. -->
<!-- Regenerate: node .dev/scripts/generate_roll_dashboard_xml.js -->
<VerticalLayout id="rollDash_ST_content" spacing="4" childAlignment="UpperLeft" childForceExpandHeight="false" childForceExpandWidth="true" width="530">
<Panel
  preferredWidth="530"
  preferredHeight="30"
  color="#000000">
  <Text
    rectAlignment="MiddleRight"
    offsetXY="0 0"
    width="520"
    height="30"
    fontSize="14"
    fontStyle="Bold"
    color="#C9A84C"
    text="ACTIVE ROLLS"
    alignment="MiddleRight" />
</Panel>
<!--
UI.setAttributes("rollDash_row_Brown", {preferredHeight = "50", childAlignment = "UpperCenter", childForceExpandHeight = "false"})
-->
<Panel id="rollDash_row_Brown"
  active="False"
  preferredWidth="530"
  preferredHeight="50"
  color="#654321">

  <Defaults>
    <GridLayout class="grid_strip"  />
  <Panel class="grid_strip_cell"  />
  <Panel class="grid_strip_cell_hunger" color = "rgba(1, 0, 0, 0.15)" />
  <Panel class="grid_strip_cell_normal" color = "rgba(0.5, 0.5, 0.5, 0.15)" />
  <Panel class="grid_strip_cell_difficulty" color = "rgba(0, 1, 0, 0.15)" />
  <Text class="grid_strip_cell_text" fontSize="9" fontStyle="Bold" />
  <Panel class="grid_strip_cell_postRoll"
    outline = "#000000"
    outlineSize = "0.5 -0.5" />
  <Panel class="grid_strip_cell_postRoll_remDie" color = "rgba(0.6, 0.6, 0.6, 1)" />
  <Panel class="grid_strip_cell_postRoll_addDie" color = "rgba(0.6, 0.6, 0.6, 1)" />
  <Panel class="grid_strip_cell_postRoll_remHungerDie" color = "rgba(0.6, 0, 0, 1)" />
  <Panel class="grid_strip_cell_postRoll_addHungerDie" color = "rgba(0.6, 0, 0, 1)" />
  <Panel class="grid_strip_cell_postRoll_remStandardDie" color = "rgba(0.2667, 0.2667, 0.2667, 1)" />
  <Panel class="grid_strip_cell_postRoll_addStandardDie" color = "rgba(0.2667, 0.2667, 0.2667, 1)" />
  <Text class="grid_strip_cell_postRoll_text" color = "#FFFFFF" />
  <Text class="grid_strip_cell_label_text" color = "#FFFFFF"/>

  </Defaults>



  <Text id="rollDash_name_Brown"
    rectAlignment="MiddleLeft"
    alignment = "MiddleLeft"
    offsetXY="5 0"
    width="120"
    height="34"
    fontSize="14"
    fontStyle="Bold"
    color="#FFFFFF"
    text="Brown" />
  <Text id="rollDash_type_Brown"
    rectAlignment="UpperLeft"
    alignment = "UpperCenter"
    offsetXY="100 -3"
    width="150"
    height="16"
    fontSize="14"
    color="#FFFFFF"
    fontStyle = "Bold"
    text="" />
  <Text id="rollDash_phase_Brown"
    rectAlignment="LowerLeft"
    alignment = "LowerCenter"
    offsetXY="100 3"
    width="150"
    height="16"
    fontSize="12"
    fontStyle="Italic"
    color="#BBBBBB"
    text="" />
  <Text id="rollDash_conds_Brown"
    rectAlignment="LowerLeft"
    alignment = "LowerLeft"
    offsetXY="255 3"
    width="200"
    height="14"
    fontSize="10"
    fontStyle="Italic"
    color="#AAAAAA"
    text="" />

<!--
