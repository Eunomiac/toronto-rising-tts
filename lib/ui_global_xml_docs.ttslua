  <!-- Once the player has rolled their dice, the difficulty grid strip should be hidden and the post-roll strip should be shown.
      When a die is removed from the pool, a random die of the appropriate type should be chosen and removed (including the physical die object), then the results recalculated.
      When a die is added to the pool, a random die of the appropriate type should be chosen and added (including the physical die object), automatically randomized (as with a Storyteller roll) then the results recalculated.
      The Storyteller dash display of the dice pool should also be synced with any of these changes.
  -->

  <!--
  UI.hide("gridStrip_rollDashBrown_difficulty")
  UI.show("gridStrip_rollDashBrown_postRollModifications")

  UI.setAttributes("gridStrip_rollDashBrown_postRollModifications", {})
  UI.setAttributes("gridStrip_rollDashBrown_postRollModification_remDie", {})
  UI.setAttributes("db_gridStrip_rollDashBrown_postRollModification_remDie_text", {})
  UI.setAttributes("gridStrip_rollDashBrown_postRollModification_addDie", {})
  UI.setAttributes("gridStrip_rollDashBrown_postRollModification_addDie_text", {})
  UI.setAttributes("gridStrip_rollDashBrown_postRollModification_remHungerDie", {})
  UI.setAttributes("gridStrip_rollDashBrown_postRollModification_remHungerDie_text", {})
  UI.setAttributes("gridStrip_rollDashBrown_postRollModification_addHungerDie", {})
  UI.setAttributes("gridStrip_rollDashBrown_postRollModification_addHungerDie_text", {})
  UI.setAttributes("gridStrip_rollDashBrown_postRollModification_remStandardDie", {})
  UI.setAttributes("gridStrip_rollDashBrown_postRollModification_remStandardDie_text", {})
  UI.setAttributes("gridStrip_rollDashBrown_postRollModification_addStandardDie", {})
  UI.setAttributes("gridStrip_rollDashBrown_postRollModification_addStandardDie_text", {})
  -->
  <GridLayout id="gridStrip_rollDashPink_postRollModifications" class="grid_strip grid_strip_postRoll grid_strip_postRoll_remDie" active="false" offsetXY = "-70 0" cellSize = "10 20" height = "20" spacing = "2" startCorner = "UpperLeft" startAxis = "Horizontal" constraint = "FixedRowCount" constraintCount = "1" rectAlignment = "MiddleRight" width = "130">
    <Panel class="grid_strip_cell grid_strip_label_cell">
      <Text class="grid_strip_cell_text grid_strip_cell_label_text" text="D" alignment="MiddleRight" />
    </Panel>
    <!-- Clicking either of these buttons should ADD or REMOVE the appropriate die given the player's Hunger rating (i.e. auto-hunger on)-->
    <Panel id="gridStrip_rollDashPink_postRollModification_remDie" class="grid_strip_cell grid_strip_cell_postRoll grid_strip_postRoll_remDie" onMouseEnter="HUD_postRollCellMouseEnter" onMouseExit="HUD_postRollCellMouseExit" onMouseDown="HUD_postRollCellMouseDown" onMouseUp="HUD_postRollCellMouseUp">
      <Text id="db_gridStrip_rollDashPink_postRollModification_remDie_text" class="grid_strip_cell_text grid_strip_cell_postRoll_text" text="▼" />
    </Panel>
    <Panel id="gridStrip_rollDashPink_postRollModification_addDie" class="grid_strip_cell grid_strip_cell_postRoll grid_strip_postRoll_addDie" onMouseEnter="HUD_postRollCellMouseEnter" onMouseExit="HUD_postRollCellMouseExit" onMouseDown="HUD_postRollCellMouseDown" onMouseUp="HUD_postRollCellMouseUp">
      <Text id="db_gridStrip_rollDashPink_postRollModification_addDie_text" class="grid_strip_cell_text grid_strip_cell_postRoll_text" text="▲" />
    </Panel>
    <Panel class="grid_strip_cell grid_strip_spacer_cell" />
    <Panel class="grid_strip_cell grid_strip_label_cell">
      <Text class="grid_strip_cell_text grid_strip_cell_label_text" text="H" alignment="MiddleRight" />
    </Panel>
    <!-- Clicking either of these buttons should ADD or REMOVE a Hunger die, regardless of Hunger rating. -->
    <Panel id="gridStrip_rollDashPink_postRollModification_remHungerDie" class="grid_strip_cell grid_strip_cell_postRoll grid_strip_postRoll_remHungerDie" onMouseEnter="HUD_postRollCellMouseEnter" onMouseExit="HUD_postRollCellMouseExit" onMouseDown="HUD_postRollCellMouseDown" onMouseUp="HUD_postRollCellMouseUp">
      <Text id="db_gridStrip_rollDashPink_postRollModification_remHungerDie_text" class="grid_strip_cell_text grid_strip_cell_postRoll_text" text="▼" />
    </Panel>
    <Panel id="gridStrip_rollDashPink_postRollModification_addHungerDie" class="grid_strip_cell grid_strip_cell_postRoll grid_strip_postRoll_addHungerDie" onMouseEnter="HUD_postRollCellMouseEnter" onMouseExit="HUD_postRollCellMouseExit" onMouseDown="HUD_postRollCellMouseDown" onMouseUp="HUD_postRollCellMouseUp">
      <Text id="db_gridStrip_rollDashPink_postRollModification_addHungerDie_text" class="grid_strip_cell_text grid_strip_cell_postRoll_text grid_strip_cell_postRoll_text" text="▲" />
    </Panel>
    <Panel class="grid_strip_cell grid_strip_spacer_cell" />
    <Panel class="grid_strip_cell grid_strip_label_cell">
      <Text class="grid_strip_cell_text grid_strip_cell_label_text" text="N" alignment="MiddleRight" />
    </Panel>
    <!-- Clicking either of these buttons should ADD or REMOVE a Normal die, regardless of Hunger rating. -->
    <Panel id="gridStrip_rollDashPink_postRollModification_remStandardDie" class="grid_strip_cell grid_strip_cell_postRoll grid_strip_postRoll_remStandardDie" onMouseEnter="HUD_postRollCellMouseEnter" onMouseExit="HUD_postRollCellMouseExit" onMouseDown="HUD_postRollCellMouseDown" onMouseUp="HUD_postRollCellMouseUp">
      <Text id="db_gridStrip_rollDashPink_postRollModification_remStandardDie_text" class="grid_strip_cell_text grid_strip_cell_postRoll_text" text="▼" />
    </Panel>
    <Panel id="gridStrip_rollDashPink_postRollModification_addStandardDie" class="grid_strip_cell grid_strip_cell_postRoll grid_strip_postRoll_addStandardDie" onMouseEnter="HUD_postRollCellMouseEnter" onMouseExit="HUD_postRollCellMouseExit" onMouseDown="HUD_postRollCellMouseDown" onMouseUp="HUD_postRollCellMouseUp">
      <Text id="db_gridStrip_rollDashPink_postRollModification_addStandardDie_text" class="grid_strip_cell_text grid_strip_cell_postRoll_text" text="▲" />
    </Panel>
  </GridLayout>

  
