UI.setAttributes("scenes_lib_btns_grid_2", {padding = "50 50 0 0"})
-->
  <GridLayout id="scenes_lib_btns_grid_3" cellSize="125 30" spacing="8 6"
    padding = "50 50 0 0" constraint="FixedRowCount" constraintCount="1" childAlignment="MiddleCenter" childForceExpandWidth="true" childForceExpandHeight="true">

    <Button id="scenes_lib_btn_unlink" class="hud_storyteller_button" text="UNLINK" onClick="HUD_scenesLibUnlink" colors="#444444|#555555|#666666|rgba(0.3,0.3,0.3,0.5)" textColor="#FFFFFF" />
    <Button id="scenes_ctor_btn_fork" class="hud_storyteller_button" text="FORK" minWidth="150" onClick="HUD_scenesCtorForkOpen" colors="#444444|#555555|#666666|rgba(0.3,0.3,0.3,0.5)" textColor="#FFFFFF" />
    <Button id="scenes_lib_btn_end" class="hud_storyteller_button" text="END" onClick="HUD_scenesLibEnd" colors="#444444|#551111|#662222|rgba(0.3,0.1,0.1,0.5)" textColor="#FFFFFF" />
  </GridLayout>


  <GridLayout id="scenes_lib_btns_grid_4" cellSize="125 30" spacing="8 6" constraint="FixedRowCount" constraintCount="1" childAlignment="MiddleCenter" childForceExpandWidth="true" childForceExpandHeight="true">

    <Panel class="scenes_lib_btn_spacer" />

    <Button id="scenes_ctor_btn_import" class="hud_storyteller_button" text="Import Scene" minWidth="120" onClick="HUD_scenesCtorImportOpen" colors="#444444|#555555|#666666|rgba(0.3,0.3,0.3,0.5)" textColor="#FFFFFF" />
    <Button id="scenes_lib_btn_delete" class="hud_storyteller_button" text="Delete Scene" onClick="HUD_scenesLibDelete" colors="#444444|#555555|#666666|rgba(0.3,0.3,0.3,0.5)" textColor="#FFFFFF" />

    <Panel class="scenes_lib_btn_spacer" />

  </GridLayout>



  <Panel id="scenes_ctor_import_modal" active="false" offsetXY="0 0" width="580" minHeight="280" color="rgba(0.05,0.05,0.08,0.95)">
    <VerticalLayout id="db_panel_scenes_library_constructor_import_modal_content" padding="10 10 10 10" spacing="6" childForceExpandWidth="true" childForceExpandHeight="true">
      <Text id="db_panel_scenes_library_constructor_import_modal_header" class="hud_storyteller_label">Import Scene (JSON)</Text>
      <InputField id="scenes_ctor_import_json" minHeight="140" preferredHeight="160" flexibleHeight="1" flexibleWidth="1" fontSize="11" textColor="#222222" colors="#EEEEEE|#FFFFFF|#DDDDDD|rgba(0.9,0.9,0.9,0.98)" lineType="MultiLineSubmit" characterValidation="None" text="" onValueChanged="HUD_scenesCtorImportJsonChanged" onEndEdit="HUD_scenesCtorImportJsonChanged" />
      <Text id="scenes_ctor_import_err" fontSize="10" color="#AAAAAA" minHeight="40" text="" />
      <HorizontalLayout id="db_panel_scenes_library_constructor_import_modal_buttons" spacing="8" childForceExpandWidth="false" childAlignment="MiddleLeft">
        <Button id="scenes_ctor_import_confirm" class="hud_storyteller_button" text="Import" minWidth="96" onClick="HUD_scenesCtorImportConfirm" colors="#444444|#555555|#666666|rgba(0.3,0.3,0.3,0.5)" textColor="#FFFFFF" />
        <Button id="scenes_ctor_import_cancel" class="hud_storyteller_button" text="Cancel" minWidth="96" onClick="HUD_scenesCtorImportCancel" colors="#444444|#555555|#666666|rgba(0.3,0.3,0.3,0.5)" textColor="#FFFFFF" />
      </HorizontalLayout>
    </VerticalLayout>
  </Panel>

  <Panel id="scenes_ctor_fork_modal" active="false" offsetXY="0 0" width="520" minHeight="200" color="rgba(0.05,0.05,0.08,0.95)">
    <VerticalLayout id="db_panel_scenes_library_constructor_fork_modal_content" padding="10 10 10 10" spacing="6" childForceExpandWidth="true">
      <Text id="db_panel_scenes_library_constructor_fork_modal_header" class="hud_storyteller_label">Fork Active Scene</Text>
      <Text id="db_panel_scenes_library_constructor_fork_modal_new_title_header" fontSize="9" color="#CCCCCC">New scene title</Text>
      <InputField id="scenes_ctor_fork_title_new" class="hud_storyteller_input" textColor="#222222" colors="#EEEEEE|#FFFFFF|#DDDDDD|rgba(0.9,0.9,0.9,0.98)" lineType="SingleLine" text="" onValueChanged="HUD_scenesCtorForkTitleChanged" onEndEdit="HUD_scenesCtorForkTitleChanged" />
      <Text id="db_panel_scenes_library_constructor_fork_modal_original_title_header" fontSize="9" color="#CCCCCC">Original scene title (frozen row)</Text>
      <InputField id="scenes_ctor_fork_title_old" class="hud_storyteller_input" textColor="#222222" colors="#EEEEEE|#FFFFFF|#DDDDDD|rgba(0.9,0.9,0.9,0.98)" lineType="SingleLine" text="" onValueChanged="HUD_scenesCtorForkTitleChanged" onEndEdit="HUD_scenesCtorForkTitleChanged" />
      <HorizontalLayout id="db_panel_scenes_library_constructor_fork_modal_buttons" spacing="8" childForceExpandWidth="false" childAlignment="MiddleLeft">
        <Button id="scenes_ctor_fork_confirm" class="hud_storyteller_button" text="Fork" minWidth="96" onClick="HUD_scenesCtorForkConfirm" colors="#444444|#555555|#666666|rgba(0.3,0.3,0.3,0.5)" textColor="#FFFFFF" />
        <Button id="scenes_ctor_fork_cancel" class="hud_storyteller_button" text="Cancel" minWidth="96" onClick="HUD_scenesCtorForkCancel" colors="#444444|#555555|#666666|rgba(0.3,0.3,0.3,0.5)" textColor="#FFFFFF" />
      </HorizontalLayout>
    </VerticalLayout>
  </Panel>
</VerticalLayout>

<!-- /include ui/storyteller/panel_scenes_library.xml -->

        <!-- <Panel id="db_third_column" class="storyteller_panel_column" /> -->
      </HorizontalLayout>

      
<!-- include ui/storyteller/panel_soundscape.xml -->
<!-- Storyteller Soundscape Controls -->
<!-- Agent guidance: .dev/Soundscape & Audio/SOUNDSCAPE_UNITY_SETUP.md; .dev/HUD_FUNCTIONS.md. -->

<Panel id="panel_soundscape" active="false">
  <VerticalLayout class="storyteller_panel_column" spacing="5" padding="6 6 6 6" childForceExpandWidth="true" minWidth="520" childForceExpandHeight="false">
    <Text class="hud_storyteller_header">Sound</Text>
    <Text id="soundscapeSummary" fontSize="14" color="#DDDDDD">Music: mood/main | Featured: none | Location: none | Weather: none | Rain: none | Wind: none | Thunder: false | Indoors: false</Text>

    <Text class="hud_storyteller_label">Background music</Text>
    <HorizontalLayout class="hud_storyteller_button_row" spacing="4" childForceExpandWidth="false">
      <Button id="soundscapeMood_main" text="Main" minWidth="56" preferredWidth="56" onClick="HUD_soundscapeSetMusicMood"
        colors="#444444|#555555|#666666|rgba(0.3,0.3,0.3,0.5)" />
      <Button id="soundscapeMood_intrigue" text="Intrigue" minWidth="56" preferredWidth="56" onClick="HUD_soundscapeSetMusicMood"
        colors="#444444|#555555|#666666|rgba(0.3,0.3,0.3,0.5)" />
      <Button id="soundscapeMood_combat" text="Combat" minWidth="56" preferredWidth="56" onClick="HUD_soundscapeSetMusicMood"
        colors="#444444|#555555|#666666|rgba(0.3,0.3,0.3,0.5)" />
      <Button id="soundscapeMood_location" text="Location" minWidth="62" preferredWidth="62" onClick="HUD_soundscapeSetBackgroundLocation"
        colors="#444444|#555555|#666666|rgba(0.3,0.3,0.3,0.5)" />
    </HorizontalLayout>

    <Text class="hud_storyteller_label">Featured music</Text>
    <HorizontalLayout class="hud_storyteller_button_row" spacing="4" childForceExpandWidth="false">
      <Button id="soundscapeFeatured_TR_Full" text="TR Full" minWidth="72" onClick="HUD_soundscapePlayFeatured"
        colors="#444444|#555555|#666666|rgba(0.3,0.3,0.3,0.5)" />
      <Button id="soundscapeFeatured_TR_Intro" text="TR Intro" minWidth="72" onClick="HUD_soundscapePlayFeatured"
        colors="#444444|#555555|#666666|rgba(0.3,0.3,0.3,0.5)" />
      <Button id="soundscapeFeatured_TR_Loop" text="TR Loop" minWidth="72" onClick="HUD_soundscapePlayFeatured"
        colors="#444444|#555555|#666666|rgba(0.3,0.3,0.3,0.5)" />
      <Button id="soundscapeFeatured_STB_HouseOfTheRisingSun" text="STB" minWidth="56" onClick="HUD_soundscapePlayFeatured"
        colors="#444444|#555555|#666666|rgba(0.3,0.3,0.3,0.5)" />
      <Button text="Stop feat." minWidth="72" onClick="HUD_soundscapeStopFeatured" />
    </HorizontalLayout>

    <Text class="hud_storyteller_label">Lane volumes</Text>
    <Text id="soundscapeDuckHint" fontSize="12" color="#CCCC66"></Text>

    <HorizontalLayout spacing="6" childForceExpandWidth="true">
      <Text id="soundscapeLaneLbl_music" preferredWidth="150" minWidth="150" fontSize="14" color="#DDDDDD">Music</Text>
      <Slider id="soundscapeSlider_music" minValue="0" maxValue="1" value="0" flexibleWidth="1" onValueChanged="HUD_soundscapeLaneSlider" />
    </HorizontalLayout>
    <HorizontalLayout spacing="6" childForceExpandWidth="true">
      <Text id="soundscapeLaneLbl_location" preferredWidth="150" minWidth="150" fontSize="14" color="#DDDDDD">Location</Text>
      <Slider id="soundscapeSlider_location" minValue="0" maxValue="1" value="0" flexibleWidth="1" onValueChanged="HUD_soundscapeLaneSlider" />
    </HorizontalLayout>
    <HorizontalLayout spacing="6" childForceExpandWidth="true">
      <Text id="soundscapeLaneLbl_featured" preferredWidth="150" minWidth="150" fontSize="14" color="#DDDDDD">Featured</Text>
      <Slider id="soundscapeSlider_featured" minValue="0" maxValue="1" value="0" flexibleWidth="1" onValueChanged="HUD_soundscapeLaneSlider" />
    </HorizontalLayout>
    <HorizontalLayout spacing="6" childForceExpandWidth="true">
      <Text id="soundscapeLaneLbl_rain" preferredWidth="150" minWidth="150" fontSize="14" color="#DDDDDD">Rain</Text>
      <Slider id="soundscapeSlider_rain" minValue="0" maxValue="1" value="0" flexibleWidth="1" onValueChanged="HUD_soundscapeLaneSlider" />
    </HorizontalLayout>
    <HorizontalLayout spacing="6" childForceExpandWidth="true">
      <Text id="soundscapeLaneLbl_wind" preferredWidth="150" minWidth="150" fontSize="14" color="#DDDDDD">Wind</Text>
      <Slider id="soundscapeSlider_wind" minValue="0" maxValue="1" value="0" flexibleWidth="1" onValueChanged="HUD_soundscapeLaneSlider" />
    </HorizontalLayout>

    <HorizontalLayout class="hud_storyteller_button_row" spacing="4">
      <Button text="Inspect" minWidth="62" preferredWidth="62" onClick="HUD_soundscapeInspect" />
      <Button text="Stop All" minWidth="62" preferredWidth="62" onClick="HUD_soundscapeStopAll" />
      <Button text="Silence for save" minWidth="120" preferredWidth="120" onClick="HUD_soundscapePrepareSave" />
    </HorizontalLayout>
  </VerticalLayout>
</Panel>

<!-- /include ui/storyteller/panel_soundscape.xml -->

      
<!-- include ui/storyteller/panel_pcs.xml -->
<!-- Storyteller PCs panel: health / will / humanity / XP / hunger + torpor (Host only) -->
<!-- Classes: panel_pcs_defaults.xml — seat `color`, `id`, and button `text` stay inline per element. -->
<!-- Agent guidance: .dev/HUD_FUNCTIONS.md; .dev/PC Data & Tracking/PC Tracking & State Behavior.md


-->
<Panel id="panel_pcs" class="pcs_panel_root" active="false">
  <VerticalLayout class="pcs_root_vl">
    <!-- Brown -->
    <Panel class="pcs_seat_block" color="#6B4423">
      <VerticalLayout class="pcs_seat_column">
        <Text class="pcs_row_title" id="pcs_rowName_Brown">Brown</Text>
        <Text class="pcs_char_title" id="pcs_charFullName_Brown">—</Text>
        <HorizontalLayout class="pcs_stat_row">
          <Text class="pcs_prefix_desire">Desire:</Text>
          <Text class="pcs_desire_text" id="pcs_desire_Brown">—</Text>
          <Button class="pcs_btn pcs_btn_clear_52 pcs_btn_palette_hum_dark" id="pcs_Brown_desireClear" />
        </HorizontalLayout>
        <HorizontalLayout class="pcs_stat_row">
          <Text class="pcs_prefix_wide">Join:</Text>
          <Toggle class="pcs_join_toggle" id="pcs_deferAutoSeat_Brown" isOn="false" onValueChanged="HUD_pcsDeferAutoSeat">Defer Auto-Seat</Toggle>
          <Button class="pcs_btn pcs_btn_auto_seat pcs_btn_palette_join" id="pcs_Brown_autoSeat" />
          <Toggle class="pcs_join_toggle" id="pcs_deferConnect_Brown" isOn="false" onValueChanged="HUD_pcsDeferConnect">Defer Connect</Toggle>
          <Button class="pcs_btn pcs_btn_connect pcs_btn_palette_join" id="pcs_Brown_connect" />
        </HorizontalLayout>
        <!-- Roll initiation row: each button starts a roll of that type in SETUP -->
        <HorizontalLayout class="pcs_stat_row">
          <Text class="pcs_prefix_wide">Roll:</Text>
          <Button class="pcs_btn pcs_btn_roll pcs_btn_palette_roll_std"        id="rollBtn_standard_Brown"    text="Std"   />
          <Button class="pcs_btn pcs_btn_roll pcs_btn_palette_roll_simple"   id="rollBtn_simplecheck_Brown" text="Simple" />
          <Button class="pcs_btn pcs_btn_roll pcs_btn_palette_roll_rouse"    id="rollBtn_rouse_Brown"      text="Rouse"  />
          <Button class="pcs_btn pcs_btn_roll pcs_btn_palette_roll_wp"      id="rollBtn_willpowerroll_Brown" text="WP"   />
          <Button class="pcs_btn pcs_btn_roll pcs_btn_palette_roll_disc"    id="rollBtn_discipline_Brown" text="Disc" />
          <Button class="pcs_btn pcs_btn_roll pcs_btn_palette_roll_hum"     id="rollBtn_humanityroll_Brown" text="Hum"  />
          <Button class="pcs_btn pcs_btn_roll pcs_btn_palette_roll_frenzy"   id="rollBtn_frenzy_Brown"     text="Frenzy" />
          <Button class="pcs_btn pcs_btn_roll pcs_btn_palette_roll_remorse"  id="rollBtn_remorse_Brown"    text="Rem"    />
          <Button class="pcs_btn pcs_btn_roll pcs_btn_palette_roll_std"       id="rollBtn_launch_Brown"     text="Launch" />
          <Button class="pcs_btn pcs_btn_roll pcs_btn_palette_roll_std"       id="rollBtn_goal_Brown"       text="Goal"   />
        </HorizontalLayout>
        <HorizontalLayout class="pcs_stat_row">
          <Text class="pcs_prefix_wide">HP:</Text>
          <Text class="pcs_track_damage" id="pcs_hpTrack_Brown"></Text>
          <Button class="pcs_btn pcs_btn_arrow pcs_btn_palette_agg" id="pcs_Brown_hpAggUp" text="▲" />
          <Text class="pcs_buf_agg" id="pcs_bufHPA_Brown">+0</Text>
          <Button class="pcs_btn pcs_btn_arrow pcs_btn_palette_agg" id="pcs_Brown_hpAggDown" text="▼" />
          <Button class="pcs_btn pcs_btn_arrow pcs_btn_palette_sup" id="pcs_Brown_hpSupUp" text="▲" />
          <Text class="pcs_buf_neutral" id="pcs_bufHPS_Brown">+0</Text>
          <Button class="pcs_btn pcs_btn_arrow pcs_btn_palette_sup" id="pcs_Brown_hpSupDown" text="▼" />
          <Button class="pcs_btn pcs_btn_apply_64 pcs_btn_palette_track_apply" id="pcs_Brown_hpApply" />
        </HorizontalLayout>
        <HorizontalLayout class="pcs_stat_row">
          <Text class="pcs_prefix_wide">WP:</Text>
          <Text class="pcs_track_damage" id="pcs_wpTrack_Brown"> </Text>
          <Button class="pcs_btn pcs_btn_arrow pcs_btn_palette_agg" id="pcs_Brown_wpAggUp" text="▲" />
          <Text class="pcs_buf_agg" id="pcs_bufWPA_Brown">+0</Text>
          <Button class="pcs_btn pcs_btn_arrow pcs_btn_palette_agg" id="pcs_Brown_wpAggDown" text="▼" />
          <Button class="pcs_btn pcs_btn_arrow pcs_btn_palette_sup" id="pcs_Brown_wpSupUp" text="▲" />
          <Text class="pcs_buf_neutral" id="pcs_bufWPS_Brown">+0</Text>
          <Button class="pcs_btn pcs_btn_arrow pcs_btn_palette_sup" id="pcs_Brown_wpSupDown" text="▼" />
          <Button class="pcs_btn pcs_btn_apply_64 pcs_btn_palette_track_apply" id="pcs_Brown_wpApply" />
        </HorizontalLayout>
        <HorizontalLayout class="pcs_stat_row">
          <Text class="pcs_prefix_wide">Hum:</Text>
          <Text class="pcs_track_hum" id="pcs_humTrack_Brown"> </Text>
          <Button class="pcs_btn pcs_btn_arrow pcs_btn_palette_hum" id="pcs_Brown_humUp" text="▲" />
          <Text class="pcs_buf_hum" id="pcs_bufHum_Brown">+0</Text>
          <Button class="pcs_btn pcs_btn_arrow pcs_btn_palette_hum" id="pcs_Brown_humDown" text="▼" />
          <Button class="pcs_btn pcs_btn_apply_58 pcs_btn_palette_hum" id="pcs_Brown_humApply" />
          <Button class="pcs_btn pcs_btn_clear_52 pcs_btn_palette_hum_dark" id="pcs_Brown_humClear" />
          <Button class="pcs_btn pcs_btn_arrow pcs_btn_palette_hum_base" id="pcs_Brown_humBaseUp" text="▲" />
          <Button class="pcs_btn pcs_btn_arrow pcs_btn_palette_hum_base" id="pcs_Brown_humBaseDown" text="▼" />
        </HorizontalLayout>
        <HorizontalLayout class="pcs_stat_row">
          <Text class="pcs_prefix_wide">XP:</Text>
          <Text class="pcs_xp_val" id="pcs_xpVal_Brown">0</Text>
          <Button class="pcs_btn pcs_btn_arrow pcs_btn_palette_xp" id="pcs_Brown_xpUp" text="▲" />
          <Text class="pcs_buf_xp" id="pcs_bufXp_Brown">+0</Text>
          <Button class="pcs_btn pcs_btn_arrow pcs_btn_palette_xp" id="pcs_Brown_xpDown" text="▼" />
          <Button class="pcs_btn pcs_btn_apply_64 pcs_btn_palette_xp" id="pcs_Brown_xpApply" />
          <Text class="pcs_prefix_hg">Hg:</Text>
          <Text class="pcs_hunger_dots" id="pcs_hungerDots_Brown"></Text>
          <Button class="pcs_btn pcs_btn_arrow pcs_btn_palette_hunger" id="pcs_Brown_hungerUp" text="▲" />
          <Text class="pcs_buf_hunger" id="pcs_bufHunger_Brown">+0</Text>
          <Button class="pcs_btn pcs_btn_arrow pcs_btn_palette_hunger" id="pcs_Brown_hungerDown" text="▼" />
          <Button class="pcs_btn pcs_btn_apply_64 pcs_btn_palette_hunger" id="pcs_Brown_hungerApply" />
          <Button class="pcs_btn pcs_btn_torpor pcs_btn_palette_torpor" id="pcs_Brown_torporClear" />
          <Text class="pcs_torpor_lbl" id="pcs_torporLabel_Brown"> </Text>
          <Button class="pcs_btn pcs_btn_cond pcs_btn_palette_frenzy" id="pcs_Brown_frenzyToggle" text="Frenzy○" />
          <Button class="pcs_btn pcs_btn_cond pcs_btn_palette_blindfold" id="pcs_Brown_blindfoldToggle" text="Blind○" />
        </HorizontalLayout>
      </VerticalLayout>
    </Panel>

    <!-- Orange -->
    <Panel class="pcs_seat_block" color="#E67300">
      <VerticalLayout class="pcs_seat_column">
        <Text class="pcs_row_title" id="pcs_rowName_Orange">Orange</Text>
        <Text class="pcs_char_title" id="pcs_charFullName_Orange">—</Text>
        <HorizontalLayout class="pcs_stat_row">
