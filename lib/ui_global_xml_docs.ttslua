  <!-- Roll control panels (generated per player color) -->
  
<!-- include ui/player/panel_roll_controls.xml -->
<!-- Generated file. Edit ui/.templates/panel_roll_controls.xml only. -->
<!-- Agent guidance: .dev/TTS_BUNDLING_SETUP.md; .dev/HUDs & Overlays/Player HUD Overview.md. -->

<Panel id="rollControl_root_Brown" class="rollControl_root" visibility="Brown" active="false">
<!-- ACTIVATE for open roll -->
  <VerticalLayout class="rollControl_container">
    <HorizontalLayout class="rollControl_headerContainer">
      <Text id="rollControl_rollType_Brown" class="roll_text roll_header_text roll_type_text" text="" />
      <!-- The type of roll, in title case, e.g. "Standard Roll", "Frenzy Roll" -->
      <Panel class="rollControl_spacer" />
      <Text id="rollControl_rollInstructions_Brown" class="roll_text roll_body_text" text="" />
      <!-- Instructions for next step, in title case, e.g. "Result Ready — 'CONFIRM' When Done" -->
    </HorizontalLayout>

    <HorizontalLayout class="rollControl_rollAssembly">
      <HorizontalLayout class="rollControl_dicePoolDisplay">
        <Text id="rollControl_oblivRouseDice_Brown" class="roll_text rollControl_diceText rollControl_diceSymbols rollControl_oblivRouseDiceText" text=""/>
        <!-- One '◆' character per Oblivion Rouse Die in pool (empty string for none) -->
        <Text id="rollControl_rouseDice_Brown" class="roll_text rollControl_diceText rollControl_diceSymbols rollControl_rouseDiceText" text="" />
        <!-- One '◆' character per (non-Blood Surge) Rouse Die in pool (empty string for none) -->
        <Text id="rollControl_bloodSurgeRouseDice_Brown" class="roll_text rollControl_diceText rollControl_diceSymbols rollControl_bloodSurgeRouseDiceText" text="" />
        <!-- One '◆' character per Blood Surge Rouse Die in pool (empty string for none) -->
        <Panel class="rollControl_spacer rollControl_rouseSpacer" />
        <HorizontalLayout class="rollControl_standardDicePoolDisplay">
          <Text id="rollControl_hungerDice_Brown" class="roll_text rollControl_diceText rollControl_diceSymbols rollControl_hungerDiceText" text=""/>
          <!-- One '◆' character per Hunger Die in pool (empty string for none) -->
          <Text id="rollControl_rageDice_Brown" class="roll_text rollControl_diceText rollControl_diceSymbols rollControl_rageDiceText" text=""/>
          <!-- One '◆' character per Rage Die in pool (empty string for none) -->
          <Text id="rollControl_standardDice_Brown" class="roll_text rollControl_diceText rollControl_diceSymbols rollControl_standardDiceText" text=""/>
          <!-- One '◆' character per Normal Die in pool (empty string for none) -->
          <Text id="rollControl_wwDice_Brown" class="roll_text rollControl_diceText rollControl_diceSymbols rollControl_wwDiceText" text=""/>
          <!-- One '◆' character per Werewolf Die in pool (empty string for none) -->
        </HorizontalLayout>
        <!-- A whitespace should be introduced after every fifth die, TOTAL, displayed in the 'standardDicePoolDisplay'-->
        <Panel class="rollControl_spacer" />
      </HorizontalLayout>
    </HorizontalLayout>

    <HorizontalLayout class="rollControl_diceImageDisplayStrip">
      <HorizontalLayout id="rollControl_rouseDiceContainer_Brown" class="rollControl_diceContainer rollControl_diceContainer_small" active="false">
      <!-- ACTIVATE if Oblivion-Rouse or Rouse Dice in pool, DEACTIVATE if not -->
        <Image id="rollControl_rouseDie_1_Brown" class="rollControl_die" active="false" />
        <!-- ACTIVATE and set image, DEACTIVATE if no die -->
        <Image id="rollControl_rouseDie_2_Brown" class="rollControl_die" active="false" />
        <!-- ACTIVATE and set image, DEACTIVATE if no die -->
        <Image id="rollControl_rouseDie_3_Brown" class="rollControl_die" active="false" />
        <!-- ACTIVATE and set image, DEACTIVATE if no die -->
        <Image id="rollControl_rouseDie_4_Brown" class="rollControl_die" active="false" />
        <!-- ACTIVATE and set image, DEACTIVATE if no die -->
        <Image id="rollControl_rouseDie_5_Brown" class="rollControl_die" active="false" />
        <!-- ACTIVATE and set image, DEACTIVATE if no die -->
      </HorizontalLayout>

