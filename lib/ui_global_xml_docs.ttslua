<!-- include ui/storyteller/advantage_editor_modal.xml -->
<!-- Storyteller Advantage Editor modal (Stats panel). -->
<Panel id="statsEditor_modal"
  visibility="Black|Host"
  active="False"
  rectAlignment="MiddleCenter"
  offsetXY="0 0"
  preferredWidth="560"
  width="560"
  height="560"
  preferredHeight = "560"
  color="rgba(0.05,0.05,0.08,0.96)"
  class="statsEditor_modal">

  <VerticalLayout id="statsEditor_content" spacing="6" childForceExpandHeight="false">

    <Text id="statsEditor_title" fontSize="16" fontStyle="Bold" color="#FFD700" text="Advantage Editor" />

    <HorizontalLayout id="statsEditor_dots_row" spacing="8" preferredHeight="32" childForceExpandWidth="false">
      <Text fontSize="11" color="#CCCCCC" text="base" preferredWidth="52" />
      <InputField id="statsEditor_base" contentType="IntegerNumber" text="0" characterLimit="2" preferredWidth="48" preferredHeight="28"
        onValueChanged="HUD_statsEditorField" onEndEdit="HUD_statsEditorField" />
      <Text fontSize="11" color="#CCCCCC" text="temp" preferredWidth="52" />
      <InputField id="statsEditor_temp" contentType="IntegerNumber" text="0" characterLimit="2" preferredWidth="48" preferredHeight="28"
        onValueChanged="HUD_statsEditorField" onEndEdit="HUD_statsEditorField" />
      <Text fontSize="11" color="#CCCCCC" text="max" preferredWidth="52" />
      <InputField id="statsEditor_max" contentType="IntegerNumber" text="5" characterLimit="2" preferredWidth="48" preferredHeight="28"
        onValueChanged="HUD_statsEditorField" onEndEdit="HUD_statsEditorField" />
      <Text fontSize="11" color="#CCCCCC" text="disabled" preferredWidth="52" />
      <InputField id="statsEditor_disabled" contentType="IntegerNumber" text="0" characterLimit="2" preferredWidth="48" preferredHeight="28"
        onValueChanged="HUD_statsEditorField" onEndEdit="HUD_statsEditorField" />
    </HorizontalLayout>

    <VerticalLayout id="statsEditor_fullFields" spacing="4" childForceExpandHeight="false">
      <HorizontalLayout spacing="6" preferredHeight="30">
        <Text fontSize="11" color="#CCCCCC" text="Name" preferredWidth="72" alignment="MiddleLeft" />
        <InputField id="statsEditor_name" text="" preferredWidth="420" preferredHeight="28"
          onValueChanged="HUD_statsEditorField" onEndEdit="HUD_statsEditorField" />
      </HorizontalLayout>
      <HorizontalLayout spacing="6" preferredHeight="30">
        <Text fontSize="11" color="#CCCCCC" text="Focus" preferredWidth="72" alignment="MiddleLeft" />
        <InputField id="statsEditor_focus" text="" preferredWidth="420" preferredHeight="28"
          onValueChanged="HUD_statsEditorField" onEndEdit="HUD_statsEditorField" />
      </HorizontalLayout>
      <Text fontSize="11" color="#CCCCCC" text="Description" />
      <InputField id="statsEditor_description" lineType="MultiLineNewline" text="" preferredHeight="100" flexibleHeight="0" preferredWidth = "420"
        onValueChanged="HUD_statsEditorField" onEndEdit="HUD_statsEditorField" />
      <Text fontSize="11" color="#CCCCCC" text="Rules" />
      <InputField id="statsEditor_rules" lineType="MultiLineNewline" text="" preferredHeight="100" flexibleHeight="0"
        onValueChanged="HUD_statsEditorField" onEndEdit="HUD_statsEditorField" preferredWidth = "420" />
    </VerticalLayout>

    <HorizontalLayout spacing="8" preferredHeight="36" childAlignment="MiddleCenter">
      <Button id="statsEditor_confirm" text="OK" preferredWidth="100" preferredHeight="32" fontSize="12"
        colors="#225522|#336633|#44AA44|rgba(0.1,0.3,0.1,0.5)" textColor="#FFFFFF"
        onClick="HUD_statsEditorConfirm" />
      <Button id="statsEditor_cancel" text="Cancel" preferredWidth="100" preferredHeight="32" fontSize="12"
        colors="#333333|#444444|#555555|rgba(0.2,0.2,0.2,0.5)" textColor="#FFFFFF"
        onClick="HUD_statsEditorCancel" />
      <Button id="statsEditor_delete" text="Delete" preferredWidth="100" preferredHeight="32" fontSize="12"
        colors="#662222|#883333|#991111|rgba(0.5,0.1,0.1,0.4)" textColor="#FFFFFF"
        onClick="HUD_statsEditorDelete" />
    </HorizontalLayout>

  </VerticalLayout>
</Panel>

<!-- /include ui/storyteller/advantage_editor_modal.xml -->


<!-- include ui/storyteller/project_editor_modal.xml -->

  <Defaults>
    <Panel class="projectEditor_modal" visibility="Black|Host" active="false" rectAlignment="MiddleCenter" offsetXY="0 0" preferredWidth="760" width="760" height="500" preferredHeight="500" color="rgba(0.05,0.05,0.08,0.96)" padding="10 10 10 10" />

    <VerticalLayout class="projectEditor_content" spacing="10" childForceExpandHeight="false" childAlignment="UpperMiddle" />

    <Text class="projectEditor_title" fontSize="16" fontStyle="Bold" color="#FFD700" />

    <HorizontalLayout class="projectEditor_dots_row" spacing="8" preferredHeight="32" childForceExpandWidth="false" childAlignment="MiddleCenter" />

    <Text class="projectEditor_text_label" fontSize="14" fontStyle="Bold" alignment="MiddleRight" color="#CCCCCC" preferredWidth="30" minWidth="50"
      flexibleWidth = "0" />

    <Text class="projectEditor_text_wide" fontSize="14" color="#CCCCCC"
      flexibleWidth = "1" preferredWidth="1000" alignment="MiddleLeft" />

    <InputField class="projectEditor_integer_field" contentType="IntegerNumber" characterLimit="2" alignment="MiddleCenter" preferredWidth="0" minWidth="45" flexibleHeight="0" flexibleWidth="0" onValueChanged="HUD_projectEditorField" onEndEdit="HUD_projectEditorField" placeholder=" "  />

    <VerticalLayout class="projectEditor_fullFields" spacing="10" childForceExpandHeight="false" />

    <HorizontalLayout class="projectEditor_fullFields_row" spacing="6" preferredHeight="30" flexibleHeight="0" />

    <InputField class="projectEditor_text_field" preferredWidth="1000" preferredHeight="30" fontSize="12" onValueChanged="HUD_projectEditorField" onEndEdit="HUD_projectEditorField" flexibleHeight="0" />

    <Dropdown class="projectEditor_dropdown" onValueChanged="HUD_projectDropdown(selectedIndex)" flexibleWidth="1" preferredWidth="140" />

    <HorizontalLayout class="projectEditor_stake_row" spacing="6" preferredHeight="36" />

    <Button class="projectEditor_adv_button" preferredWidth="280" preferredHeight="32" fontSize="12" colors="#222222|#333333|#444444|#111111" textColor="#FFFFFF" textAlignment="MiddleLeft" />

    <Panel class="projectEditor_adv_picker" rectAlignment="MiddleCenter" width="420" height="420" color="rgba(0.02,0.02,0.05,0.98)" padding="8 8 8 8" />

    <VerticalLayout class="projectEditor_adv_picker_list" spacing="2" childForceExpandHeight="false" childForceExpandWidth = "true" />

    <Button class="projectEditor_adv_pick_button" minWidth = "100" preferredHeight="28" fontSize="11" colors="#1a1a22|#2a2a33|#3a3a44|#111111" textColor="#FFFFFF" textAlignment="MiddleLeft" />

    <Panel class="spacer" flexibleHeight="1" flexibleWidth="1" />

    <Button class="projectEditor_button_small" preferredWidth="45" preferredHeight="45" minWidth="45" minHeight="45" fontSize="32" fontStyle="Bold" color="#FFFF00" />

    <HorizontalLayout class="projectEditor_button_bar" spacing="8" preferredHeight="36" childAlignment="MiddleCenter" />

    <Button class="projectEditor_confirm_button" preferredWidth="100" preferredHeight="32" fontSize="12" colors="#225522|#336633|#44AA44|rgba(0.1,0.3,0.1,0.5)" textColor="#FFFFFF" onClick="HUD_projectEditorConfirm" text="OK" />

    <Button class="projectEditor_cancel_button" preferredWidth="100" preferredHeight="32" fontSize="12" colors="#333333|#444444|#555555|rgba(0.2,0.2,0.2,0.5)" textColor="#FFFFFF" onClick="HUD_projectEditorCancel" text="Cancel" />

    <Button class="projectEditor_delete_button" preferredWidth="100" preferredHeight="32" fontSize="12" colors="#662222|#883333|#991111|rgba(0.5,0.1,0.1,0.4)" textColor="#FFFFFF" onClick="HUD_projectEditorDelete" text="Delete" />

    <Button class="projectEditor_begin_button" preferredWidth="120" preferredHeight="32" fontSize="12" colors="#224466|#336699|#4488BB|rgba(0.1,0.2,0.4,0.5)" textColor="#FFFFFF" onClick="HUD_projectEditorBegin" text="Lock &amp; Begin" />

    <Button class="projectEditor_complete_button" preferredWidth="100" preferredHeight="32" fontSize="12" colors="#226666|#33AAAA|#119999|rgba(0.1,0.5,0.5,0.4)" textColor="#FFFFFF" onClick="HUD_projectEditorComplete" text="Complete" />
  </Defaults>


  <Panel id="projectEditor_modal" class="projectEditor_modal" active="false">
    <VerticalLayout id="projectEditor_content" class="projectEditor_content">

      <Text id="projectEditor_title" class="projectEditor_title" text="Project Editor" />

      <HorizontalLayout ignoreLayout="true" rectAlignment="UpperRight" width="200" height="40" childAlignment="MiddleRight" offsetXY = "20 20">
        <Text class="projectEditor_text_label" text="Owner:" alignment="MiddleLeft" />
        <Dropdown id="projectEditor_owner" class="projectEditor_dropdown" onValueChanged="HUD_projectDropdown(selectedIndex)">
            <Option selected="true"> </Option>
            <Option>Lord Lucien</Option>
            <Option>Rashid</Option>
            <Option>Aishe</Option>
            <Option>Fomorach</Option>
            <Option>Black Caesar</Option>
        </Dropdown>

      </HorizontalLayout>

      <HorizontalLayout class="projectEditor_fullFields_row">
        <Text class="projectEditor_text_label" text="Goal:" />
        <InputField id="projectEditor_goal" class="projectEditor_text_field" text="" />
      </HorizontalLayout>

      <HorizontalLayout class="projectEditor_fullFields_row">
        <Text class="projectEditor_text_label" text="Scope:" />
        <InputField id="projectEditor_scope" class="projectEditor_integer_field" text="" />

        <HorizontalLayout id="projectEditor_launchRoll_container">
          <VerticalLayout>
            <Panel class="spacer" />
            <HorizontalLayout id="projectEditor_launchRoll_row" class="projectEditor_fullFields_row" preferredHeight="20" flexibleHeight="0" childAlignment="MiddleLeft">
              <Text class="projectEditor_text_label" text="Launch Roll:" flexibleWidth="1" preferredWidth="150" />
              <InputField id="projectEditor_skill" class="projectEditor_text_field" text="" />
              <Text class="projectEditor_text_label" text="+" flexibleWidth="0" preferredWidth="10" alignment="MiddleCenter" fontSize="28" fontStyle="Bold" />
              <InputField id="projectEditor_advantage" class="projectEditor_text_field" preferredWidth="1500" text="" />
              <Text class="projectEditor_text_label" text="vs." flexibleWidth="0" preferredWidth="10"/>
              <Panel class="spacer" preferredWidth="100" flexibleWidth="1" />
            </HorizontalLayout>
            <Panel class="spacer" />
          </VerticalLayout>
          <InputField id="projectEditor_difficulty" class="projectEditor_integer_field" text="" />
          <Button id="projectEditor_launchRoll_trigger" class="projectEditor_button_small" text="R" onClick="HUD_projectEditorLaunchR" />
        </HorizontalLayout>
      </HorizontalLayout>

      <HorizontalLayout class="projectEditor_fullFields_row" childAlignment="MiddleLeft">
        <Text class="projectEditor_text_label" text="Increment:" preferredWidth="100" flexibleWidth="0" />
        <Dropdown id="projectEditor_increment" class="projectEditor_dropdown" onValueChanged="HUD_projectDropdown(selectedIndex)">
            <Option selected="true"> </Option>
            <Option>Daily</Option>
            <Option>Weekly</Option>
            <Option>Bi-Weekly</Option>
            <Option>Monthly</Option>
            <Option>Quarterly</Option>
            <Option>Yearly</Option>
            <Option>By Decade</Option>
            <Option>By Century</Option>
        </Dropdown>
        <Text class="projectEditor_text_label" text="Result:" />
        <Dropdown id="projectEditor_result" class="projectEditor_dropdown" onValueChanged="HUD_projectDropdown(selectedIndex)">
            <Option selected="true"> </Option>
            <Option>Win</Option>
            <Option>Critical Win</Option>
        </Dropdown>
        <HorizontalLayout id="projectEditor_margin_container" spacing="10">
          <Text class="projectEditor_text_label" text="Margin:" />
          <InputField id="projectEditor_margin" class="projectEditor_integer_field" text="" />
            <Panel class="spacer" />
        </HorizontalLayout>
      </HorizontalLayout>

      <HorizontalLayout class="projectEditor_fullFields_row" childAlignment="MiddleLeft">
        <Text class="projectEditor_text_label" text="Start Date:"  preferredWidth="100" flexibleWidth="0"/>
        <InputField id="projectEditor_startDate" class="projectEditor_text_field" text="" />
      </HorizontalLayout>

      <HorizontalLayout class="projectEditor_fullFields_row" childAlignment="MiddleLeft">
        <Text class="projectEditor_text_label" text="Project Die:"  preferredWidth="200" flexibleWidth="0"/>
        <Text id="projectEditor_projectDie" class="projectEditor_text_label" text="—" alignment="MiddleLeft" fontSize="32" color="#FFFFFF" />
        <Text class="projectEditor_text_label" text="Project Die Mod:"  preferredWidth="300" flexibleWidth="0"/>
        <InputField id="projectEditor_projectDieMod" class="projectEditor_integer_field" text="0" />
        <Text class="projectEditor_text_label" text="End Date:"  preferredWidth="100" flexibleWidth="0"/>
        <Text id="projectEditor_endDate" class="projectEditor_text_label" preferredWidth="600" alignment="MiddleLeft" text="" fontSize="32" color="#FFFFFF" />
      </HorizontalLayout>

      <VerticalLayout class="projectEditor_fullFields">
        <HorizontalLayout childForceExpandWidth="false" spacing="10">
          <Text class="projectEditor_text_label" text="Stake Required:" alignment="MiddleLeft" flexibleWidth="0" preferredWidth="120" />
          <Text id="projectEditor_stakeRequired" class="projectEditor_text_label" text="—" alignment="MiddleLeft" fontSize="32" color="#FFFFFF" flexibleWidth="0" preferredWidth="50" />
        <Text class="projectEditor_text_label" text="Contributors:"  preferredWidth="200" flexibleWidth="0"/>

          <InputField id="projectEditor_numContributors" class="projectEditor_integer_field" text="1" />
          <Panel class="spacer" preferredWidth="100" />
        </HorizontalLayout>

        <HorizontalLayout id="projectEditor_stakeRow_1" class="projectEditor_stake_row" active="true">
          <Dropdown id="projectEditor_stake_1_source" class="projectEditor_dropdown" preferredWidth="120" onValueChanged="HUD_projectStakeDropdown(selectedIndex)">
            <Option selected="true"> </Option>
            <Option>Lord Lucien</Option>
            <Option>Rashid</Option>
            <Option>Aishe</Option>
            <Option>Fomorach</Option>
            <Option>Black Caesar</Option>
            <Option>Coterie</Option>
          </Dropdown>
          <Button id="projectEditor_stake_1_advantage" class="projectEditor_adv_button" text="—" onClick="HUD_projectStakeAdvOpen" />
          <InputField id="projectEditor_stake_1_qty" class="projectEditor_integer_field" text="" />
        </HorizontalLayout>
        <HorizontalLayout id="projectEditor_stakeRow_2" class="projectEditor_stake_row" active="false">
          <Dropdown id="projectEditor_stake_2_source" class="projectEditor_dropdown" preferredWidth="120" onValueChanged="HUD_projectStakeDropdown(selectedIndex)">
            <Option selected="true"> </Option>
            <Option>Lord Lucien</Option>
            <Option>Rashid</Option>
            <Option>Aishe</Option>
            <Option>Fomorach</Option>
            <Option>Black Caesar</Option>
            <Option>Coterie</Option>
          </Dropdown>
          <Button id="projectEditor_stake_2_advantage" class="projectEditor_adv_button" text="—" onClick="HUD_projectStakeAdvOpen" />
          <InputField id="projectEditor_stake_2_qty" class="projectEditor_integer_field" text="" />
        </HorizontalLayout>
        <HorizontalLayout id="projectEditor_stakeRow_3" class="projectEditor_stake_row" active="false">
          <Dropdown id="projectEditor_stake_3_source" class="projectEditor_dropdown" preferredWidth="120" onValueChanged="HUD_projectStakeDropdown(selectedIndex)">
            <Option selected="true"> </Option>
