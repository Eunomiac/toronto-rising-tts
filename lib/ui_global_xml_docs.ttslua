  <!-- Shared nestedless ref popups (TOR-444); coteries remain in per-seat referenceLayer -->
  
<!-- include ui/shared/panel_ref_panels_nestedless.xml -->
<!-- Shared nestedless reference popups (TOR-444).
     One Image per sheet for all seats; audience via XmlUI visibility unions.
     Open/close: core/hud_player.ttslua applyNestedlessRefForSeat → U.showTo / U.hideFrom.
     Court / coteries stay per-seat until Phase 5. -->
<Panel id="playerHud_referenceLayer_nestedless" class="popupImageContainer">
  <Image id="playerHud_refPanel_chronicleTenets" visibility="None" active="false" class="popupImage" image="refPanel_ChronicleTenets" />
  <Image id="playerHud_refPanel_rolls" visibility="None" active="false" class="popupImage" image="refPanel_Rolls" />
  <Image id="playerHud_refPanel_physicalCombat" visibility="None" active="false" class="popupImage" image="refPanel_PhysicalCombat" />
  <Image id="playerHud_refPanel_socialCombat" visibility="None" active="false" class="popupImage" image="refPanel_SocialCombat" />
  <Image id="playerHud_refPanel_threats" visibility="None" active="false" class="popupImage" image="refPanel_Threats" />
  <Image id="playerHud_refPanel_frenzy" visibility="None" active="false" class="popupImage" image="refPanel_Frenzy" />
  <Image id="playerHud_refPanel_recovery" visibility="None" active="false" class="popupImage" image="refPanel_Recovery" />
  <Image id="playerHud_refPanel_resonance" visibility="None" active="false" class="popupImage" image="refPanel_Resonance" />
  <Image id="playerHud_refPanel_experience" visibility="None" active="false" class="popupImage" image="refPanel_Experience" />
  <Image id="playerHud_refPanel_advantages" visibility="None" active="false" class="popupImage" image="refPanel_Advantages" />
  <Image id="playerHud_refPanel_projects" visibility="None" active="false" class="popupImage" image="refPanel_Projects" />
  <Image id="playerHud_refPanel_memoriam" visibility="None" active="false" class="popupImage" image="refPanel_Memoriam" />
</Panel>

<!-- /include ui/shared/panel_ref_panels_nestedless.xml -->


  <!-- Shared Prince's Court (TOR-444) -->
  
<!-- include ui/shared/panel_ref_princes_court.xml -->
<!-- Shared Prince's Court reference (TOR-444). Generated by extract_shared_princes_court.js.
     Audience: root + page panels via U.showTo/hideFrom. Tracker ids: box_*_<PanelSeat> (no HUD viewer suffix).
-->
<Panel id="playerHud_princesCourt_sharedRoot" class="popupImageContainer">
<Defaults>

    <Panel class="princesCourt-reference"
      width = "1500"
      height = "975"
      offsetXY = "-50 0" />

    <Image rectAlignment="MiddleLeft" />

    <Image class="box"
      rectAlignment = "MiddleLeft"
      preserveAspect = "true"
      raycastTarget = "false"
      active = "true" />

    <Image class="navButton"
      height = "128"
      width = "50"
      color = "rgba(1, 1, 1, 0.25)"
      preserveAspect = "true" />

    <Image class="navButton_left"
      rectAlignment = "MiddleLeft"
      offsetXY = "-40 0" />

    <Image class="navButton_right"
      rectAlignment = "MiddleRight"
      offsetXY = "40 0" />

    <Image class="princeCourt_page"
      height = "100%"
      preserveAspect = "true" />

    <Image class="dot_large"
      rectAlignment = "UpperLeft"
      height = "60"
      width = "60"
      active = "true" />

    <Image class="box_standard"
      height = "24"
      width = "24"
      active = "true" />

    <!-- <Image class="box_text_title_dot" height = "20" width = "20" /> -->

    <VerticalLayout class="page"
      width = "710"
      padding = "8 8 50 50" />

    <VerticalLayout class="page_right"
      rectAlignment = "MiddleRight"
      offsetXY = "-20 0" />

    <VerticalLayout class="page_left"
      rectAlignment = "MiddleLeft"
      offsetXY = "20 0" />

    <Text class="box_text" resizeTextMinSize = "8" resizeTextMaxSize = "14" />
    <Text class="box_text_title_text" resizeTextMinSize = "8" resizeTextMaxSize = "14" />

    <VerticalLayout class="box_text_container" padding="5 5 0 0" />
      <HorizontalLayout class="1_dot" padding="0 20 0 0" />
  <HorizontalLayout class="2_dots" padding="0 40 0 0" />
  <HorizontalLayout class="3_dots" padding="0 60 0 0" />
  <HorizontalLayout class="4_dots" padding="0 80 0 0" />
  <HorizontalLayout class="5_dots" padding="0 100 0 0" />
  <HorizontalLayout class="6_dots" padding="0 120 0 0" />

  </Defaults>
