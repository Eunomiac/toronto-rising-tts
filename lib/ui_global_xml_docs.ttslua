<!-- include ui/shared/roll_options_modal.xml -->
<!-- Generated file. Edit ui/.templates/roll/roll_options_modal.xml and partials under ui/.templates/roll/partials/ only. -->
<!-- Regenerate: node .dev/scripts/generate_roll_options_modal_xml.js -->
<Panel id="rollOpts_modal"
  visibility="Black|Host"
  active="False"
  rectAlignment="MiddleCenter"
  offsetXY="0 0"
  width="520"
  padding="16 16 16 16"
  childForceExpandHeight="false"
  class="rollOpts_modal">

  <VerticalLayout id="db_rollOpts_modal_content" class="rollOpts_modal_content">

    <Text id="db_rollOpts_modal_title" class="rollOpts_modal_title" text="Roll Options" />

    <!-- Roll Type -->
    <Text id="db_rollOpts_modal_header_rollType" class="rollOpts_modal_header" text="Roll Type" />

    <HorizontalLayout id="db_rollOpts_modal_horiz_toggle_container_rollType_1" class="rollOpts_modal_horiz_toggle_container">
      <Button id="rollOpts_type_standard" class="rollOpts_toggle rollOpts_toggle_on" onClick="HUD_rollOptsToggle" text="Standard" />
      <Button id="rollOpts_type_discipline" class="rollOpts_toggle rollOpts_toggle_off" onClick="HUD_rollOptsToggle" text="Discipline" />
      <Button id="rollOpts_type_willpower" class="rollOpts_toggle rollOpts_toggle_off" onClick="HUD_rollOptsToggle" text="Willpower" />
      <Button id="rollOpts_type_frenzy" class="rollOpts_toggle rollOpts_toggle_off" onClick="HUD_rollOptsToggle" text="Frenzy" />
      <Button id="rollOpts_type_humanity" class="rollOpts_toggle rollOpts_toggle_off" onClick="HUD_rollOptsToggle" text="Humanity" />
    </HorizontalLayout>

    <HorizontalLayout id="db_rollOpts_modal_horiz_toggle_container_rollType_2" class="rollOpts_modal_horiz_toggle_container">
      <Button id="rollOpts_type_rouse" class="rollOpts_toggle rollOpts_toggle_off" onClick="HUD_rollOptsToggle" text="Rouse" />
      <Button id="rollOpts_type_rouseOblivion" class="rollOpts_toggle rollOpts_toggle_off" onClick="HUD_rollOptsToggle" text="O-Rouse" />
      <Button id="rollOpts_type_remorse" class="rollOpts_toggle rollOpts_toggle_off" onClick="HUD_rollOptsToggle" text="Remorse" />
      <Button id="rollOpts_type_launch" class="rollOpts_toggle rollOpts_toggle_off" onClick="HUD_rollOptsToggle" text="Launch" />
      <Button id="rollOpts_type_goal" class="rollOpts_toggle rollOpts_toggle_off" onClick="HUD_rollOptsToggle" text="Goal" />
      <Button id="rollOpts_type_simple" class="rollOpts_toggle rollOpts_toggle_off" onClick="HUD_rollOptsToggle" text="Simple" />
    </HorizontalLayout>

    <!-- Permanent -->
    <Text id="db_rollOpts_modal_header_permanent" class="rollOpts_modal_header" text="Permanent" />

    <HorizontalLayout id="db_rollOpts_modal_horiz_toggle_container_permanent" class="rollOpts_modal_horiz_toggle_container">
      <Button id="rollOpts_perm_autoApplyRouseOutcomes" class="rollOpts_toggle rollOpts_toggle_on" onClick="HUD_rollOptsToggle" text="Auto-Rouse" />
      <Button id="rollOpts_perm_autoWp" class="rollOpts_toggle rollOpts_toggle_on" onClick="HUD_rollOptsToggle" text="Auto-WP" />
      <Button id="rollOpts_perm_autoRemorse" class="rollOpts_toggle rollOpts_toggle_on" onClick="HUD_rollOptsToggle" text="Auto-Remorse" />
      <Button id="rollOpts_perm_autoHunger" class="rollOpts_toggle rollOpts_toggle_on" onClick="HUD_rollOptsToggle" text="Auto-Hunger" />
    </HorizontalLayout>

    <!-- This roll -->
    <Text id="db_rollOpts_modal_header_this_roll" class="rollOpts_modal_header" text="This Roll" />

    <HorizontalLayout id="db_rollOpts_modal_horiz_toggle_container_this_roll" class="rollOpts_modal_horiz_toggle_container">
      <Button id="rollOpts_roll_takeHalf" class="rollOpts_toggle rollOpts_toggle_off" onClick="HUD_rollOptsToggle" text="Take Half" />
      <Button id="rollOpts_roll_wpReroll" class="rollOpts_toggle rollOpts_toggle_off" onClick="HUD_rollOptsToggle" text="WP Reroll" />
      <Button id="rollOpts_roll_hungerDice" class="rollOpts_toggle rollOpts_toggle_off" onClick="HUD_rollOptsToggle" text="Hunger Dice" />
      <Button id="rollOpts_roll_crits" class="rollOpts_toggle rollOpts_toggle_off" onClick="HUD_rollOptsToggle" text="Criticals" />
    </HorizontalLayout>

    <HorizontalLayout id="db_rollOpts_modal_horiz_input_container_this_roll" class="rollOpts_modal_horiz_input_container">
      <Text id="db_rollOpts_modal_input_label_numberOfRerolls" class="rollOpts_modal_input_label" text="# WP Rerolls:" />
      <InputField id="rollOpts_roll_numberOfRerolls" class="rollOpts_modal_input_field" text="1" />
      <Text id="db_rollOpts_modal_input_label_numberOfDiceRerolled" class="rollOpts_modal_input_label" text="# Dice per Reroll:" />
      <InputField id="rollOpts_roll_numberOfDiceRerolled" class="rollOpts_modal_input_field" text="3" />
    </HorizontalLayout>

    <!-- Roll Conditions -->
    <Text id="db_rollOpts_modal_subheader_roll_conditions" class="rollOpts_modal_subheader" text="Roll Conditions" />

    <HorizontalLayout id="db_rollOpts_modal_horiz_conditions_container" class="rollOpts_conditions_container">
      <VerticalLayout id="db_rollOpts_modal_conditions_column_1" class="rollOpts_conditions_column"><Button id="rollCondition_bestialNull" class="rollOpts_toggle rollOpts_toggle_off" onClick="HUD_rollOptsToggle" text="Bestial Null" />
<Button id="rollCondition_noTakeHalf" class="rollOpts_toggle rollOpts_toggle_off" onClick="HUD_rollOptsToggle" text="No Take Half" /></VerticalLayout>
      <VerticalLayout id="db_rollOpts_modal_conditions_column_2" class="rollOpts_conditions_column"><Button id="rollCondition_canRerollHunger" class="rollOpts_toggle rollOpts_toggle_off" onClick="HUD_rollOptsToggle" text="Can Reroll Hunger" />
<Button id="rollCondition_noWPReroll" class="rollOpts_toggle rollOpts_toggle_off" onClick="HUD_rollOptsToggle" text="No WP Reroll" /></VerticalLayout>
      <VerticalLayout id="db_rollOpts_modal_conditions_column_3" class="rollOpts_conditions_column"><Button id="rollCondition_noCriticals" class="rollOpts_toggle rollOpts_toggle_off" onClick="HUD_rollOptsToggle" text="No Criticals" /></VerticalLayout>
      <VerticalLayout id="db_rollOpts_modal_conditions_column_4" class="rollOpts_conditions_column"><Button id="rollCondition_noHungerDice" class="rollOpts_toggle rollOpts_toggle_off" onClick="HUD_rollOptsToggle" text="No Hunger Dice" /></VerticalLayout>
    </HorizontalLayout>

    <HorizontalLayout id="db_rollOpts_modal_horiz_button_container" class="rollOpts_modal_horiz_button_container">
      <Button id="rollOpts_btnApply" class="rollOpts_button" color="rgba(0.15,0.35,0.15,1)" onClick="HUD_rollOptsApply" text="Apply" />
      <Button id="rollOpts_btnCancel" class="rollOpts_button" color="rgba(0.35,0.15,0.15,1)" onClick="HUD_rollOptsCancel" text="Cancel" />
    </HorizontalLayout>

  </VerticalLayout>
</Panel>

