    height="30" width="100%" outline="#cb995c" outlineSize = "2 -2" color="rgba(0, 0, 0, 1)" rectAlignment = "UpperLeft" childAlignment = "UpperLeft" childForceExpandWidth = "false" padding="10 10 0 0" spacing = "10" />

  <GridLayout class="project_header_dotline"
     cellSize = "20 20" spacing = "2" startCorner = "UpperLeft" startAxis = "Horizontal" constraint = "FixedRowCount" constraintCount = "1" childAlignment = "MiddleLeft" childForceExpandWidth = "false" childForceExpandHeight = "false" />

  <Image class="project_scope_dot"
    image="dot_yellow" minHeight="120" minWidth="120" flexibleWidth="0" flexibleHeight="0" scale="2 2" />

  <Text class="project_goal_text"
    color="#FFFFFF" fontStyle="Bold" fontSize="27" alignment="MiddleLeft" offsetXY = "10 0" preferredWidth="1000" />

  <Panel class="project_result_container" ignoreLayout="true" height="50" width="100" rectAlignment="UpperRight" offsetXY = "10 15" />

  <Image class="project_result_image" rectAlignment="MiddleCenter" width="90" scale="2" preserveAspect="true" />

  <Text class="project_result_margin"
    color="#FFFFFF" fontStyle="Bold" fontSize="40" alignment="MiddleRight" horizontalOverflow = "wrap" width = "100"/>

  <GridLayout class="project_stake_container" color="rgba(1, 0, 0, 0)"
   rectAlignment="LowerLeft" cellSize = "557 30" height="100"  width="557" spacing = "0" startCorner = "UpperLeft" startAxis="Horizontal" childAlignment = "UpperLeft" padding="0 0 0 0" constraint="FixedColumnCount" constraintCount = "1" offsetXY = "5 20"/>

  <HorizontalLayout class="project_stake_container" spacing = "15" color="rgba(1, 0, 1, 0)" childForceExpandWidth = "false" childForceExpandHeight = "true" padding="5 0 0 0" childAlignment="MiddleLeft" />

  <Text class="project_stakes_label" color="rgba(0, 0, 0, 0)" fontSize="0" active="false" />

  <GridLayout class="project_stake_dotline" color="rgba(0, 1, 0, 0)"
     cellSize = "25 25" spacing = "2" startCorner = "UpperLeft" startAxis = "Horizontal" constraint = "FixedRowCount" constraintCount = "1" childAlignment = "MiddleLeft" childForceExpandWidth = "false" childForceExpandHeight = "false" scale="0.75" preferredWidth="0" flexibleWidth="0" minWidth = "0" padding="0 0 0 0" />

  <Panel class="project_stake_spacer" flexibleWidth="1" />

  <Image class="project_stake_dot"
    image="dot_white" minHeight="120" minWidth="12" flexibleWidth="0" flexibleHeight="0" scale="2 2" />

  <Image class="project_stake_dot_other"
    image="dot_grey" />
  <Image class="project_stake_dot_coterie"
    image="dot_yellow" />

  <Text class="project_stake_label"
    color="#FFFFFF" fontStyle="Bold" fontSize="22" alignment="MiddleLeft" flexibleWidth="0" horizontalOverflow = "overflow" />

  <Text class="project_stake_label_other"
    color="#AAAAAA" fontStyle="Italic"  />
  <Text class="project_stake_label_coterie"
    color="#FFDD00"  />


  <Image class="project_die" ignoreLayout="true" rectAlignment="MiddleRight" width="500" preserveAspect="true" offsetXY = "0 -10" />
  <HorizontalLayout class="project_date_container" ignoreLayout="true" height="30" width = "550" rectAlignment="LowerRight" offsetXY = "10 -10" color="rgba(0, 0, 0, 1)" outline="#cb995c" outlineSize = "2 -2" spacing = "0" />

  <Text class="project_date_text"
    color="#FFFFFF" fontStyle="Bold" fontSize="20" alignment="MiddleCenter" preferredWidth="1000" />
  <Text class="project_increment_text"
    fontStyle="Italic" fontSize="18" color="#999999" alignment="MiddleCenter" preferredWidth="1000" />

  <Text class="project_date_start_text"
    fontStyle="Italic"
    color="#999999" />


  <HorizontalLayout class="project_stake_container" active="false" />
  <Image class="project_stake_dot" active="false" />
  <Image class="project_scope_dot" active="false" />






  <HorizontalLayout class="four_column_text" spacing="20" childForceExpandWidth="true" childForceExpandHeight="false" childAlignment="UpperCenter" />

  <VerticalLayout class="quarter_column" flexibleHeight="0" />



  <Button class="page_navigation" width="100" height="2000" ignoreLayout="true" />

  <Button class="page_back" rectAlignment="UpperLeft" onClick="onPageBack" color="clear"/>

  <Button class="page_forward" rectAlignment="UpperRight" onClick="onPageForward" color="clear"/>

  <Button class="page_inner_left" rectAlignment="UpperLeft" onClick="onPageInnerClick" color="clear"/>

  <Button class="page_inner_right" rectAlignment="UpperRight" onClick="onPageInnerClick" color="clear"/>
</Defaults>

<!-- /include ui/defaults_classes.xml -->


<!-- 3. Storyteller defaults needed by Phases join chrome -->

<!-- include ui/storyteller/hud_storyteller_defaults.xml -->
<!-- Storyteller HUD Defaults -->
<!-- Agent guidance: .dev/HUD_FUNCTIONS.md; .dev/TTS_BUNDLING_SETUP.md; .dev/tts-api/UI API/Defaults.md. -->
<!-- Admin panel + sidebar + camera classes. Include before hud_storyteller. -->

<Defaults>

  <!-- ================================================================ -->
  <!-- Defaults Classes (shared across all storyteller panels)           -->
  <!-- ================================================================ -->

  <Text class="hud_storyteller_header" fontSize="12" color="#FFDD00" flexibleWidth="1"/>
  <Text class="hud_storyteller_label"	fontSize="11" color="#FFD700"  />

  <Row class="hud_storyteller_button_row" preferredHeight="20" minHeight="20" spacing="0" childForceExpandWidth="false" childForceExpandHeight="false" />
  <HorizontalLayout class="hud_storyteller_button_row" childAlignment="MiddleCenter" preferredHeight="30" minHeight="30" spacing="0" childForceExpandWidth="true" childForceExpandHeight="true" />


  <!-- <Button class="hud_storyteller_button"
    fontSize="12"
    height="20"
    preferredHeight="20"
    minHeight="20"
    preferredWidth="125"
    minWidth="125"
    flexibleHeight="0"
    flexibleWidth="0"
  /> -->

  <Button class="hud_storyteller_button"
    fontSize="14"
    colors="#444444|#555555|#666666|rgba(0.3,0.3,0.3,0.5)"
    textColor="#FFFFFF" />
  <Button class="hud_storyteller_button_label" width="40" preferredWidth="40" />
  <Button class="hud_storyteller_button_icon"
    fontSize="14"
    textColor="#FFFFFF"
    fontStyle="Bold"
    height="20"
    minHeight="20"
    preferredHeight="20"
    flexibleHeight="0"
    width="20"
    minWidth="20"
    preferredWidth="20"
    flexibleWidth="0"
    alignment="MiddleCenter"
  />

  <!-- <HorizontalLayout class="hud_storyteller_control_row" preferredHeight="30" minHeight="30" spacing="4" childForceExpandWidth="true" childForceExpandHeight="true" childAlignment="MiddleLeft" /> -->

  <HorizontalLayout class="hud_storyteller_control_row" />

  <InputField class="hud_storyteller_input"
    fontSize="14"
    lineType="SingleLine"
    textColor = "#000000"
  />

  <InputField class="guid_input"
    characterLimit="6"
    flexibleWidth="0"
    characterValidation="Alphanumeric"
    placeholder="GUID" />


  <Text class="hud_storyteller_header"
    minHeight="20"
    flexibleWidth="1"
    fontSize="18"
    fontStyle="Bold"
    color="#FFFFFF"
    alignment="LowerCenter" />

  <Text class="hud_storyteller_label"
    minHeight="20"
    flexibleWidth="1"
    fontSize="16"
    fontStyle="Bold"
    color="#FFD700"
    alignment="LowerCenter" />

  <Text class="hud_storyteller_row_label"
    fontSize="14"
    alignment="MiddleLeft"
  />

  <Button class="hud_storyteller_row_button"
    minHeight="20"
    fontSize="14"
    fontStyle="Bold"
    color="#FFFFFF"
    alignment="MiddleLeft" />

  <Button class="hud_storyteller_row_button_icon"
    alignment="MiddleCenter"
    width="20"
    preferredWidth="20"
    flexibleWidth="0"
    minWidth="20"
    height="20"
    preferredHeight="20"
    flexibleHeight="0"
    minHeight="20" />

  <Row class="hud_storyteller_header" height="30" preferredHeight="30" flexibleHeight="0" childForceExpandHeight="false" childForceExpandWidth="true" />
  <Cell class="hud_storyteller_wide" columnSpan="6" childForceExpandWidth="true" />
  <Cell class="hud_storyteller_label" childForceExpandWidth="true" />

  <!-- ================================================================ -->
  <!-- Admin Panel Classes (left-side button controls)                   -->
  <!-- ================================================================ -->

  <!-- Debug seat-swap row (bottom-right, left of admin twirl-down) -->
  <Button class="debug_seat_color_button"
    text=""
    width="30"
    height="30"
    minWidth="30"
    minHeight="30"
    preferredWidth="30"
    preferredHeight="30"
    flexibleWidth="0"
    flexibleHeight="0"
    fontSize="1"
    textColor="rgba(0,0,0,0)"
    padding="0 0 0 0"
    alignment="MiddleCenter"
    outline="rgba(0,0,0,0)"
    outlineSize="0 0" />

  <HorizontalLayout class="debug_seat_color_row"
    rectAlignment="LowerRight"
    offsetXY="-34 0"
    width="190"
    height="30"
    spacing="2"
    childAlignment="MiddleRight"
    childForceExpandWidth="false"
    childForceExpandHeight="false"
    ignoreLayout="true" />

  <!-- Main button column: left-aligned, half-scale, vertically stacked (TOR-396: +100 Y) -->
  <VerticalLayout class="storyteller_buttonControls"
    padding="0 0 0 0"
    spacing="1"
    rectAlignment="LowerRight"
    childAlignment="LowerRight"
    width="200"
    height="400"
    offsetXY="-70 110"
    childForceExpandWidth="true"
    childForceExpandHeight="true" />

  <!-- ================================================================ -->
  <!-- Sidebar Classes (right-side reference image toggles)             -->
  <!-- ================================================================ -->

  <!-- Reference toggle button: show/hide on mouse events -->
  <Image class="storyteller_refButton"
    onMouseDown="HUD_show"
    onMouseUp="HUD_hide"
    onMouseEnter="HUD_highlight"
    onMouseExit="HUD_dim" />




  <Panel class="rollST_root"
    rectAlignment="LowerCenter"
    width = "900"
    height = "900"
    color = "rgba(0, 0, 0.25, 1)"
    outline = "rgba(1, 1, 0, 1)"
  />

    <GridLayout class="grid_strip" cellSize = "10 20" height = "20" spacing = "6" startCorner = "UpperLeft" startAxis = "Horizontal" constraint = "FixedRowCount" constraintCount = "1" onMouseExit="HUD_gridStripMouseExit" />
  <Panel class="grid_strip_cell" outline = "#000000" outlineSize = "-1 1" onMouseEnter="HUD_gridStripCellMouseEnter" onMouseDown="HUD_gridStripCellMouseDown" onMouseUp="HUD_gridStripCellMouseUp" />
  <Panel class="grid_strip_cell_hunger" color = "rgba(1, 0, 0, 0.15)" />
  <Panel class="grid_strip_cell_normal" color = "rgba(0.5, 0.5, 0.5, 0.15)" />
  <Panel class="grid_strip_cell_difficulty" color = "rgba(0, 1, 0, 0.15)" />
  <Text class="grid_strip_cell_difficulty_text" fontSize="9" fontStyle="Bold" />
  <Text class="grid_strip_cell_hunger_text" fontSize="9" fontStyle="Bold" />
  <Text class="grid_strip_cell_normal_text" fontSize="9" fontStyle="Bold" />

</Defaults>

<!-- /include ui/storyteller/hud_storyteller_defaults.xml -->


<!-- include ui/storyteller/panel_join_xml_chrome_defaults.xml -->
<!-- Defaults for join-minimal chrome wrapper (TOR-439). -->
<!-- Mirrors storyteller_panel_root / storyteller_panel_column so Phases matches full ST chrome. -->

<Defaults>
  <Panel class="join_xml_chrome_root"
    visibility="Host"
    ignoreLayout="true"
    rectAlignment="UpperLeft"
    offsetXY="20 -20"
    width="520"
    height="720"
    color="rgba(0,0,0,0.85)"
  />
  <VerticalLayout class="storyteller_panel_column"
    color="rgba(0, 0, 0, 0.8)"
    spacing="6"
    padding="6 6 6 6"
    childForceExpandWidth="true"
    flexibleWidth="1"
    minWidth="0"
    preferredWidth="0"
  />
</Defaults>

<!-- /include ui/storyteller/panel_join_xml_chrome_defaults.xml -->


<!-- 4. Global session blindfold (Intermission cover for all clients). -->

<!-- include ui/shared/panel_overlay_global_blindfold.xml -->
<!-- Global session blindfold — no visibility filter (all clients). active=true by default / on connect. -->
<!-- Lua: hideStartupLoadingOverlays() / showStartupLoadingOverlaysForPhases (Play hide / Intermission show). -->
<!-- Per-player transition blinds: ui/.templates/panel_overlay_blindfold.xml — root sibling beside this file (TOR-436). -->
<!-- Placed last among blindfolds in ui/Global.xml so it draws above transition blinds when both are up. -->
<!--
UI.show("overlay_globalBlindfold")
-->

<!--
UI.hide("overlay_globalBlindfold")
UI.setAttributes("overlay_globalBlindfold", {color = "rgba(1, 1, 1, 0.25)"})
-->

<Image id="overlay_globalBlindfold"
  image="global_blindfold_session_1"
  active="true"
  width="1920"
  height="1200"
  preserveAspect="true"
  raycastTarget="true"
  rectAlignment="MiddleCenter"
  showAnimation="FadeIn"
  hideAnimation="FadeOut"
  animationDuration="0.3"
/>

<!-- /include ui/shared/panel_overlay_global_blindfold.xml -->


<!-- 5. Slim Host chrome AFTER blindfold — Phases must draw above Intermission cover. -->
<!-- Full-screen clear root (like full ST HUD) so UpperLeft chrome is a later sibling of the Image. -->
<Panel id="HUD_PANEL_BLACK" visibility="Black|Host"
  width="1920" height="1200" rectAlignment="MiddleCenter"
  color="clear" raycastTarget="false">
  <!-- ignoreLayout: padding would turn this into a LayoutGroup and can bury children. -->
  <Panel id="joinXmlChromeRoot" visibility="Host" active="true"
    ignoreLayout="true"
    rectAlignment="UpperLeft" offsetXY="20 -20" width="520" height="720"
    color="rgba(0,0,0,0.85)">
    
<!-- include ui/storyteller/panel_phases.xml -->
<!--
UI.setAttributes("input_sessionNum", {minHeight = "30", fontStyle = "Bold"})
-->

<Panel id="panel_phases" active="false">
  <VerticalLayout class="storyteller_panel_column" spacing="6" padding="6 6 6 6" childForceExpandWidth="false">
    <Text class="hud_storyteller_header">Session phase</Text>
    <Text id="phase_currentLabel" fontSize="16" fontStyle="Bold" color="#FFFFFF" text="Intermission" />
    <Text fontSize="12" color="#AAAAAA">Advance loops Intermission → Play → Spotlight → End. Play subphases switch freely.</Text>
    <HorizontalLayout class="hud_storyteller_button_row" spacing="4" childForceExpandWidth="false">
      <Button id="phase_Advance" text="Advance →" minWidth="120" preferredWidth="120" onClick="HUD_phaseAdvance"
        colors="#444444|#555555|#666666|rgba(0.3,0.3,0.3,0.5)" textColor="#FFFFFF" />
    </HorizontalLayout>
    <Text fontSize="12" color="#AAAAAA">Play subphase</Text>
    <HorizontalLayout id="phase_subphaseRow" class="hud_storyteller_button_row" spacing="4" childForceExpandWidth="false">
      <Button id="phase_sub_Main" text="Main" minWidth="72" preferredWidth="72" onClick="HUD_setPlaySubPhase"
        colors="#444444|#555555|#666666|rgba(0.3,0.3,0.3,0.5)" textColor="#FFFFFF" />
      <Button id="phase_sub_Downtime" text="Downtime" minWidth="72" preferredWidth="72" onClick="HUD_setPlaySubPhase"
        colors="#444444|#555555|#666666|rgba(0.3,0.3,0.3,0.5)" textColor="#FFFFFF" />
      <Button id="phase_sub_Memoriam" text="Memoriam" minWidth="72" preferredWidth="72" onClick="HUD_setPlaySubPhase"
        colors="#444444|#555555|#666666|rgba(0.3,0.3,0.3,0.5)" textColor="#FFFFFF" />
    </HorizontalLayout>
    <Text fontSize="14" fontStyle="Bold" color="#AAAAAA">Session number</Text>
    <InputField id="input_sessionNum" characterValidation="Integer" text="1" minWidth="80" preferredWidth="80"
      onValueChanged="HUD_sessionNumInput" onEndEdit="HUD_sessionNumInput" />
    <Text fontSize="14" fontStyle="Bold" color="#AAAAAA">Join controls</Text>
    <Text fontSize="12" color="#AAAAAA">Defer setXML skips automatic Global UI rebuild. Arm colds HUD/assets/pools; restore in order with the buttons below.</Text>
    <HorizontalLayout class="hud_storyteller_button_row" spacing="4" childForceExpandWidth="false">
      <Toggle id="phase_deferSetXml" isOn="false" onValueChanged="HUD_phaseDeferSetXml"
        minWidth="160" preferredWidth="180" textColor="#FFFFFF">Defer setXML</Toggle>
      <Button id="phase_armJoinXml" text="Arm Join XML" minWidth="140" preferredWidth="140" onClick="HUD_phaseArmJoinXml"
        colors="#444444|#555555|#666666|rgba(0.3,0.3,0.3,0.5)" textColor="#FFFFFF" />
    </HorizontalLayout>
    <Text id="phase_joinXmlStatus" fontSize="11" color="#FFDD00" text="Join: hud:full | assets:full | pools:warm" />
    <Text fontSize="12" color="#AAAAAA">Staged restore (after Arm): 1 Assets → 2 HUD → 3 Emitters → 4 Figurines</Text>
    <HorizontalLayout class="hud_storyteller_button_row" spacing="4" childForceExpandWidth="false">
      <Button id="phase_restoreJoinAssets" text="1 Assets" minWidth="90" preferredWidth="90" onClick="HUD_phaseRestoreJoinAssets"
        colors="#444444|#555555|#666666|rgba(0.3,0.3,0.3,0.5)" textColor="#FFFFFF" />
      <Button id="phase_restoreJoinHud" text="2 HUD" minWidth="80" preferredWidth="80" onClick="HUD_phaseRestoreJoinHud"
        colors="#444444|#555555|#666666|rgba(0.3,0.3,0.3,0.5)" textColor="#FFFFFF" />
      <Button id="phase_restoreJoinEmitters" text="3 Emitters" minWidth="100" preferredWidth="100" onClick="HUD_phaseRestoreJoinEmitters"
        colors="#444444|#555555|#666666|rgba(0.3,0.3,0.3,0.5)" textColor="#FFFFFF" />
      <Button id="phase_restoreJoinFigurines" text="4 Figurines" minWidth="110" preferredWidth="110" onClick="HUD_phaseRestoreJoinFigurines"
        colors="#444444|#555555|#666666|rgba(0.3,0.3,0.3,0.5)" textColor="#FFFFFF" />
    </HorizontalLayout>
    <HorizontalLayout class="hud_storyteller_button_row" spacing="4" childForceExpandWidth="false">
      <Button id="phase_refreshXml" text="Refresh XML (=2 HUD)" minWidth="180" preferredWidth="180" onClick="HUD_phaseRefreshXml"
        colors="#444444|#555555|#666666|rgba(0.3,0.3,0.3,0.5)" textColor="#FFFFFF" />
    </HorizontalLayout>
  </VerticalLayout>
</Panel>

<!-- /include ui/storyteller/panel_phases.xml -->

  </Panel>
</Panel>
]=]

-- CustomUIAssets names referenced by expanded join-minimal XmlUI.
M.minimalAssetNames = {
    "dot_grey",
    "dot_white",
    "dot_yellow",
    "global_blindfold_session_1",
}

--- @return string
function M.getFull()
    return M.full
end

--- @return string
function M.getMinimal()
    return M.minimal
end

--- @return table array of CustomUIAssets name strings for join-minimal XmlUI
function M.getMinimalAssetNames()
    return M.minimalAssetNames
end

return M
