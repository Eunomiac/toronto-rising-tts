 -- #region Camera Modes

-- Camera Modes
-- These are the camera modes that can be used to control the camera. This object contains the mode as the key, and either "bySeat" if the camera angle should be determined by the table seating functionality, or "universal" if the camera angle is the same for all players.
C.CameraModes = {
  default = "bySeat",
  sheet = "bySeat",
  roll = "bySeat",
  diceTray = "bySeat",
  compulsions = "bySeat",
  districtCard = "universal",
  siteCard = "universal",
  npcCenter = "universal",
  npcNearLeft = "universal",
  npcNearRight = "universal",
  npcFarLeft = "universal",
  npcFarRight = "universal",
  wide = "universal",
  wideFacing = "universal"
}

-- Reference Color Red Camera Angles
-- These are the camera angle definitions that are defined for the Red seat, but that will need to be rotated and defined for each of the other player seats.
-- Each of these derived camera angles should be written into two locations in game state:
--    - "gameState.playerData[playerID].cameraAngles[cameraMode]": each camera angle should be written to each player's playerData leaving the mode name unchanged (e.g. "default", "facing", "sheet", "roll", etc.)
--    - "gameState.seatLayout.universalCameraAngles[cameraMode + seatKey]": each camera angle should also be made available to all players, by writing it to the seatLayout.universalCameraAngles object, with the seat key appended to the mode name (e.g. "facing" -> "facingBrown", "roll" -> "rollRed").
-- `M.setCamera(..., "roll")` reads the seat's playerData / `rollBrown` layout keys — not a leftover unsuffixed `universalCameraAngles.roll` (TOR-605).

--[[ To be clear, after R.resolveSeatObjectsFromTable() is called, the "universal" camera modes will include one of every entry in C.UniversalCameraAngles, plus the following: "facingRed", "facingBrown", "facingOrange", "facingPink" and "facingPurple", as well as some number of "facingNPC1", "facingNPC2", "facingNPC3" and "facingNPC4" depending on which slots are open in the seatToPositionMap of the new table configuration -- and then the same for "sheetRed", "sheetBrown", ... and "diceTrayRed", "diceTrayBrown", ... etc. ]]

--- World-space position of the reference seat hand zone when `C.ReferenceCameraAngles` was authored.
--- `lib.rotational-seat-layout` adds the **XZ** of
--- `(activeTable.referenceFigurine.position - C.CameraAuthoringReferenceFigurinePosition)`
--- to camera **position** for presets with `isRelativeToReferenceHandPosition == true`.
--- Look-at **Y** stays at the authored `C.ReferenceCameraAngles` value (sheets keep authored height).
--- Keep in sync with the canonical layout table (currently `Table A` slot-1 figurine).
C.CameraAuthoringReferenceHandPosition = Vector({ 0.00, 3.22, -76.61 })
C.CameraAuthoringReferenceFigurinePosition = Vector({ 0.5035, -55.8166, -72.7348 })

--- Default occupant → numbered tableSlot (Red at slot 1, Orange right, Pink left). Live saves seed missing slots from this map.
--- Tables with `isRandomSeating = true` seat PCs from `seatLayout.sessionChairs` instead (seeded from this map).
C.DefaultTableSlots = {
  Red = 1,
  Orange = 2,
  Pink = 3,
  Brown = 4,
  Purple = 5,
  NPC1 = 6,
  NPC2 = 7,
  NPC3 = 8,
  NPC4 = 9,
}

C.SeatRoleOffsets = require("lib.seat_role_offsets")

local FIGURINE_FROM_HAND_DX = 0.5035
local FIGURINE_FROM_HAND_DZ = 3.8752
local FIGURINE_DEFAULT_Y = -55.8166

local function referenceFigurineFromHand(rh)
  local hp = rh.position
  local hy = 0
  if type(rh.rotation) == "table" then
    hy = rh.rotation.y or 0
  end
  return {
    position = Vector({ x = hp.x + FIGURINE_FROM_HAND_DX, y = FIGURINE_DEFAULT_Y, z = hp.z + FIGURINE_FROM_HAND_DZ }),
    rotation = Vector({ x = 0, y = hy + 180, z = 0 }),
  }
end

