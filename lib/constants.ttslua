    G.GUIDS.TAROT_BUTTON_ANCHOR_OFF_PINK,
    G.GUIDS.TAROT_DRAWER_ANCHOR_ON_PINK,
    G.GUIDS.TAROT_DRAWER_ANCHOR_OFF_PINK,
    G.GUIDS.TAROT_DECK_ANCHOR_PINK,
    G.GUIDS.COMPANION_TOGGLE_TOKEN_A_BROWN,
    G.GUIDS.DICEBAG_OBLIVROUSE_PURPLE,
    G.GUIDS.COMPANION_TOGGLE_TOKEN_A_PURPLE,
    G.GUIDS.COMPANION_TOGGLE_TOKEN_B_PURPLE,
    G.GUIDS.COMPANION_TOGGLE_TOKEN_C_PURPLE,
  },
  -- Derived from C.ReferenceCameraAngles (and aligned with C.UniversalCameraAngles runtime merge behavior).
  -- This avoids duplicating mode-key lists in multiple places.
  cameraModes = deriveTableSourceCameraModes()
}

