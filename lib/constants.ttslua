-- #region Districts

-- Districts and sites are generated from the Districts & Sites workbook (`npm run locations:import`).
local LocationsCatalog = require("lib.locations_catalog")
C.Districts = LocationsCatalog.Districts

-- #endregion

-- #region Skyboxes
-- Sentinel for `sessionScene.skyboxOverride` / picker: force random `C.GenericSkyboxes` (ignore site `skybox`).
C.SKYBOX_GENERIC_KEY = "Generic"

-- Catalog of skybox assets (AUTO-GENERATED module). Regenerate: npm run skyboxes:import
-- Site `skybox` fields reference these by key; resolve via `C.Skyboxes[key].url`.
-- `isShown = false` keeps the asset in the catalog but omits it from the Scenes skybox picker.
-- `C.MemoriamSkyboxes` is keyed by skybox key; each entry has `characters`, panels A–D, `splashText`, and ten `npcs` (`name`, `fullName` from SKYBOXMEMORIAMCSV). Transition covers use Custom Asset `memoriamBlindfold_<skyboxKey>`, not a catalog URL field.
local SkyboxesCatalog = require("lib.skyboxes_catalog")
C.Skyboxes = SkyboxesCatalog.Skyboxes
C.GenericSkyboxes = SkyboxesCatalog.GenericSkyboxes
C.MemoriamSkyboxes = SkyboxesCatalog.MemoriamSkyboxes

-- Memoriam panel art lives in assets/Memoriam (`memoriamPanel_<skyboxKey>_<a|b|c|d>.jpg`, synced to Steam Cloud) and reaches
-- Lua as AUTO-GENERATED `lib/cloud_memoriam_panels.ttslua` (job `memoriamPanels`; regenerate: npm run cloud-asset-sync).
-- That module is the URL authority for `panelA`–`panelD`.`url` (filled at load). The sheet does not supply panel URLs.
-- Memoriam NPC figurine / token art comes from `lib/npc_art_urls.ttslua` (keyed `mem_<stem>`), like every other NPC.
local CloudMemoriamPanels = require("lib.cloud_memoriam_panels")

local MEMORIAM_PANEL_KEYS = { "panelA", "panelB", "panelC", "panelD" }
local MEMORIAM_PANEL_KEY_BY_LETTER = { a = "panelA", b = "panelB", c = "panelC", d = "panelD" }

--- @param value any
--- @return string
local function trimmedString(value)
  if type(value) ~= "string" then
    return ""
  end
  return (string.gsub(string.gsub(value, "^%s+", ""), "%s+$", ""))
end

--- Hosted URL from a generated Cloud module row, or "" when the key or URL is missing.
--- @param cloudTable table|nil
--- @param key string|nil
--- @return string
local function cloudCatalogURL(cloudTable, key)
  if type(cloudTable) ~= "table" or type(key) ~= "string" or key == "" then
    return ""
  end
  local row = cloudTable[key]
  if type(row) ~= "table" then
    return ""
  end
  return trimmedString(row.URL)
end

--- Writes `cloudPanels["<skyboxKey>_<letter>"].URL` into `catalog[skyboxKey][panelX].url`.
--- Keys that name no catalog period, or a panel that period does not define, are reported — not applied.
--- @param catalog table `C.MemoriamSkyboxes`
--- @param cloudPanels table `lib/cloud_memoriam_panels.ttslua`
--- @return integer linked
--- @return string[] unmatched  sorted cloud keys with no catalog target
local function applyMemoriamCloudPanelUrls(catalog, cloudPanels)
  local linked = 0
  local unmatched = {}
  for cloudKey, _ in pairs(cloudPanels) do
    local skyboxKey, letter = string.match(tostring(cloudKey), "^(.-)_(%a)$")
    local panelKey = letter and MEMORIAM_PANEL_KEY_BY_LETTER[string.lower(letter)] or nil
    local entry = skyboxKey and catalog[skyboxKey] or nil
    local panel = (panelKey and type(entry) == "table") and entry[panelKey] or nil
    local url = cloudCatalogURL(cloudPanels, cloudKey)
    if type(panel) == "table" and url ~= "" then
      panel.url = url
      linked = linked + 1
    else
      unmatched[#unmatched + 1] = tostring(cloudKey)
    end
  end
  table.sort(unmatched)
  return linked, unmatched
end

--- Catalog panels (`"<skyboxKey>.<panelKey>"`) whose `url` is still blank after the Cloud merge — sorted.
--- @return string[]
function C.getMemoriamPanelsWithoutArt()
  local missing = {}
  for skyboxKey, entry in pairs(C.MemoriamSkyboxes) do
    if type(entry) == "table" then
      for i = 1, #MEMORIAM_PANEL_KEYS do
        local panelKey = MEMORIAM_PANEL_KEYS[i]
        local panel = entry[panelKey]
        if type(panel) == "table" and trimmedString(panel.url) == "" then
          missing[#missing + 1] = tostring(skyboxKey) .. "." .. panelKey
        end
      end
    end
  end
  table.sort(missing)
  return missing
end

--- Skybox background URL for one Memoriam panel (the value the Memoriam apply path hands to `Backgrounds.setCustomURL`).
--- Errors when the period, the panel, or its art is missing so a bad Advance payload cannot fail silently.
--- @param skyboxKey string  `C.MemoriamSkyboxes` key (e.g. `blackCaesar37`)
--- @param panelKey string  `panelA` … `panelD`
--- @return string url
function C.resolveMemoriamPanelURL(skyboxKey, panelKey)
  local entry = type(skyboxKey) == "string" and C.MemoriamSkyboxes[skyboxKey] or nil
  if type(entry) ~= "table" then
    error("Memoriam skybox `" .. tostring(skyboxKey) .. "` is missing from the catalog")
  end
  local panel = type(panelKey) == "string" and entry[panelKey] or nil
  if type(panel) ~= "table" then
    error("Memoriam skybox `" .. skyboxKey .. "` has no panel `" .. tostring(panelKey) .. "`")
  end
  local url = trimmedString(panel.url)
  if url == "" then
    error(
      "Memoriam skybox `" .. skyboxKey .. "`." .. panelKey
        .. " has no art — add `memoriamPanel_" .. skyboxKey .. "_" .. string.lower(string.sub(panelKey, -1)) .. ".jpg` to assets/Memoriam and run npm run cloud-asset-sync"
    )
  end
  return url
end

do
  local linked, unmatched = applyMemoriamCloudPanelUrls(C.MemoriamSkyboxes, CloudMemoriamPanels)
  local missing = C.getMemoriamPanelsWithoutArt()
  local summary = string.format(
    "[constants] Memoriam panel art: %d linked from Cloud, %d catalog panel(s) still without art (C.getMemoriamPanelsWithoutArt)",
    linked,
    #missing
  )
  if #unmatched > 0 then
    summary = summary
      .. string.format("; %d Cloud file(s) match no catalog period/panel: ", #unmatched)
      .. table.concat(unmatched, ", ")
  end
  print(summary)
end


--- @param entry table|nil
--- @return number
local function memoriamSkyboxStartYear(entry)
  if type(entry) ~= "table" or type(entry.startYear) ~= "number" then
    return 0
  end
  return entry.startYear
end

--- @param entry table|nil
--- @return number
local function memoriamSkyboxEndYear(entry)
  if type(entry) ~= "table" then
    return 0
  end
  if type(entry.endYear) == "number" then
    return entry.endYear
  end
  return memoriamSkyboxStartYear(entry)
end

--- Build `character → { skyboxKey, ... }` lists from `C.MemoriamSkyboxes`, sorted by `startYear`, then `endYear`, then key.
--- @param catalog table
--- @return table
local function buildMemoriamSkyboxKeysByCharacter(catalog)
  if type(catalog) ~= "table" then
    error("MemoriamSkyboxes catalog is missing")
  end
  local byCharacter = {}
  for key, entry in pairs(catalog) do
    if type(key) == "string" and type(entry) == "table" and type(entry.characters) == "table" then
      for i = 1, #entry.characters do
        local character = entry.characters[i]
        if type(character) == "string" and character ~= "" then
          local list = byCharacter[character]
          if list == nil then
            list = {}
            byCharacter[character] = list
          end
          local alreadyListed = false
          for j = 1, #list do
            if list[j] == key then
              alreadyListed = true
              break
            end
          end
          if not alreadyListed then
            list[#list + 1] = key
          end
        end
      end
    end
  end
  for _, keys in pairs(byCharacter) do
    table.sort(keys, function(a, b)
      local startA = memoriamSkyboxStartYear(catalog[a])
      local startB = memoriamSkyboxStartYear(catalog[b])
      if startA ~= startB then
        return startA < startB
      end
      local endA = memoriamSkyboxEndYear(catalog[a])
      local endB = memoriamSkyboxEndYear(catalog[b])
      if endA ~= endB then
        return endA < endB
      end
      return a < b
    end)
  end
  return byCharacter
end

-- Ordered Memoriam skybox keys per character (`lucien`, `aishe`, …). Shared rows appear on every listed character.
C.MemoriamSkyboxKeysByCharacter = buildMemoriamSkyboxKeysByCharacter(C.MemoriamSkyboxes)

-- #region Sites

-- Sites (`lib/locations_catalog.ttslua`, generated from the SITES tab's "Parsing for TTS Output" columns).
-- Every site has `name`, `soundscape.location`, `isIndoors`, `weatherDucking` and `isTopFogActive`; `district` points at a
-- `C.Districts` entry; site card art is the Custom UI asset `siteCard_<key>`.
-- Optional `conditions` (sites and districts): manual condition ids applied while the location is live (`core/conditions.ttslua`).
-- Optional `offsetXY` ("<x> <y>"): map pin position on the city map.
-- Optional `skybox` (string): catalog key into `C.Skyboxes`. Applied via `Scenes.reconcileSkyboxFromState` when this site is live
-- (`sessionScene.siteKey`) and `sessionScene.skyboxOverride` is unset. When omitted, a random entry from `C.GenericSkyboxes` is used.

-- Optional `isSilent = true`: full ambient mute (background, location ambience, weather); featured music may still be played via Storyteller action. Merge with `Soundscape.applyContext(Soundscape.contextFromSite(site))`.
-- Optional `soundscape.backgroundMusic.playlist = "none"`: silence background music only (location ambience and weather still apply). Omit `backgroundMusic` to use catalog default mood (`main`).
-- `isTopFogActive` (boolean): `SceneLibrary.applySiteTopFogToSessionScene` writes `sessionScene.isTopFogActive` on location apply.
-- `weatherDucking` (number 0..1): outdoor-only weather volume multiplier via `Soundscape.applyContext` (`state.siteWeatherDucking`). Indoor sites ignore this and fully silence weather (and hide the weather panel). When omitted on an outdoor site, the outdoor catalog default applies.
-- Optional `mappable` (boolean, default true): when false, active PCs' map pins hide at this scene site; absent PCs may keep a cached mappable offset.

--- @return string|nil trimmed non-empty URL from `C.GenericSkyboxes`, or nil
function C.pickRandomGenericSkyboxURL()
  local generics = C.GenericSkyboxes
  if type(generics) ~= "table" then
    return nil
  end
  local count = #generics
  if count < 1 then
    return nil
  end
  local pick = generics[math.random(count)]
  if type(pick) ~= "string" then
    return nil
  end
  pick = string.gsub(string.gsub(pick, "^%s+", ""), "%s+$", "")
  if pick == "" then
    return nil
  end
  return pick
end

--- @param key any
--- @return boolean
function C.isValidSkyboxKey(key)
  if type(key) ~= "string" or key == "" then
    return false
  end
  key = string.gsub(string.gsub(key, "^%s+", ""), "%s+$", "")
  if key == "" then
    return false
  end
  if key == C.SKYBOX_GENERIC_KEY then
    return true
  end
  local entry = C.Skyboxes[key]
  if type(entry) ~= "table" or type(entry.url) ~= "string" then
    return false
  end
  local url = string.gsub(string.gsub(entry.url, "^%s+", ""), "%s+$", "")
  return url ~= ""
end

--- Resolves a catalog / Generic skybox key to a TTS background URL.
--- `"Generic"` returns nil — caller should use `C.pickRandomGenericSkyboxURL`.
--- @param key string|nil
--- @return string|nil url
function C.resolveSkyboxURLFromKey(key)
  if type(key) ~= "string" then
    return nil
  end
  key = string.gsub(string.gsub(key, "^%s+", ""), "%s+$", "")
  if key == "" or key == C.SKYBOX_GENERIC_KEY then
    return nil
  end
  local entry = C.Skyboxes[key]
  if type(entry) ~= "table" or type(entry.url) ~= "string" then
    return nil
  end
  local url = string.gsub(string.gsub(entry.url, "^%s+", ""), "%s+$", "")
  if url == "" then
    return nil
  end
  return url
end

--- Resolves the TTS background (`Backgrounds.setCustomURL`) for a site key.
--- Uses `C.Sites[siteKey].skybox` catalog key → `C.Skyboxes[key].url` when present;
--- otherwise picks randomly from `C.GenericSkyboxes`.
--- Scene-level override is handled separately via `sessionScene.skyboxOverride` in `Scenes.reconcileSkyboxFromState`.
--- @param siteKey string|nil
--- @return string|nil url
function C.resolveSkyboxURLForSite(siteKey)
  if type(siteKey) ~= "string" then
    return nil
  end
  siteKey = string.gsub(string.gsub(siteKey, "^%s+", ""), "%s+$", "")
  if siteKey == "" then
    return nil
  end

  local site = C.Sites[siteKey]
  if type(site) == "table" and type(site.skybox) == "string" then
    local authored = string.gsub(string.gsub(site.skybox, "^%s+", ""), "%s+$", "")
    if authored ~= "" then
      local url = C.resolveSkyboxURLFromKey(authored)
      if url ~= nil then
        return url
      end
      print("[constants] resolveSkyboxURLForSite: unknown skybox key `" .. authored .. "` for site `" .. siteKey .. "`.")
    end
  end

  return C.pickRandomGenericSkyboxURL()
end

--- Ordered Memoriam catalog entries for a character key (`lucien`, `aishe`, `fomorach`, `blackCaesar`, `rashid`, …).
--- Sorted by `startYear` ascending, then `endYear` ascending, then skybox key. Unknown or blank character returns `{}`.
--- @param characterKey string|nil
--- @return table
function C.getMemoriamSkyboxesForCharacter(characterKey)
  if type(characterKey) ~= "string" or characterKey == "" then
    return {}
  end
  local keys = C.MemoriamSkyboxKeysByCharacter[characterKey]
  if type(keys) ~= "table" then
    return {}
  end
  local out = {}
  for i = 1, #keys do
    local skyboxKey = keys[i]
    local entry = C.MemoriamSkyboxes[skyboxKey]
    if type(entry) ~= "table" then
      error("Memoriam skybox `" .. tostring(skyboxKey) .. "` is missing from the catalog")
    end
    out[#out + 1] = entry
  end
  return out
end

--- Resolves `C.Districts` table key for a district object reference from `C.Sites[*].district`.
--- @param district table|nil
--- @return string|nil
function C.resolveDistrictKeyForDistrictTable(district)
  if type(district) ~= "table" then
    return nil
  end
  for key, dist in pairs(C.Districts or {}) do
    if dist == district then
      return key
    end
  end
  return nil
end

--- Whether a site supports map pin placement (`mappable` defaults true when omitted).
--- @param site table|nil
--- @return boolean
function C.isSiteMappable(site)
  if type(site) ~= "table" then
    return false
  end
  if site.mappable == false then
    return false
  end
  return true
end



C.Sites = LocationsCatalog.Sites

-- #endregion

-- #region Weather
--[[
`lib/tr_weather_schedule.ttslua` (generated from the Toronto Rising sheet's WEATHER tab by `npm run weather:import`) holds an entry for every month of the year, each with an `avgTemp` and a `weather` table.
The `weather` table contains one entry for each day of the month. Each of those entries is a 24-element array of five-character codes, representing the weather conditions for that hour.
To derive the weather for a given hour from its five-character code, the hour's code should be parsed as follows:

- Character 1 & Character 2: Base weather string. Lookup in `C.WEATHER.Base`. Each entry contains a descriptive text string to be added to the associated element in the HUD, the audio key for the rain emitter, and a boolean indicating whether there is thunder.
- Character 3: Temperature delta. Lookup in `C.WEATHER.TemperatureDelta`, then add to `"avgTemp"` for the month. This value is in Celsius, so convert to Fahrenheit by multiplying by 1.8 and adding 32 to provide both temperatures in the HUD.
- Character 4: Humidity. Lookup in `C.WEATHER.Humidity` (parsed for weather codes; not shown on the overlay HUD).
- Character 5: Wind. Lookup in `C.WEATHER.Wind`. Each entry contains a descriptive text string to be added to the associated HUD element, as well as two audio keys for the wind emitter: `"windAudioIfWarm"` and `"windAudioIfCold"`. The warm audio key is used if the temperature is above `C.WEATHER.WARM_TEMPERATURE_THRESHOLD`, the cold audio key is used if the temperature is at or below.
]]

C.WEATHER = {
  WARM_TEMPERATURE_THRESHOLD = 0,
  Base = {
    xx = {
      text = "Clear",
      rainAudio = "silent",
      isThunder = false
    },
    xf = {
      text = "Foggy",
      rainAudio = "silent",
      isThunder = false
    },
    bx = {
      text = "Blizzard",
      rainAudio = "silent",
      isThunder = false
    },
    bf = {
      text = "Whiteout",
      rainAudio = "silent",
      isThunder = false
    },
    cx = {
      text = "Overcast",
      rainAudio = "silent",
      isThunder = false
    },
    cf = {
      text = "Thick Fog",
      rainAudio = "silent",
      isThunder = false
    },
    px = {
      text = "Downpour",
      rainAudio = "rainHeavy",
      isThunder = false
    },
    pf = {
      text = "Foggy Downpour",
      rainAudio = "rainHeavy",
      isThunder = false
    },
    sx = {
      text = "Snowing",
      rainAudio = "silent",
      isThunder = false
    },
    sf = {
      text = "Whiteout",
      rainAudio = "silent",
      isThunder = false
    },
    tx = {
      text = "Thunderstorm",
      rainAudio = "rainHeavy",
      isThunder = true
    },
    tf = {
      text = "Thunderstorm",
      rainAudio = "rainHeavy",
      isThunder = true
    },
    wx = {
      text = "Raining",
      rainAudio = "rainLight",
      isThunder = false
    },
    wf = {
      text = "Drizzle",
      rainAudio = "rainLight",
      isThunder = false
    }
  },
  TemperatureDelta = {
    ["0"] = 0,
    A = 1,
    B = 2,
    C = 3,
    D = 4,
    E = 5,
    F = 6,
    G = 7,
    H = 8,
    I = 9,
    J = 10,
    K = 11,
    L = 12,
    M = 13,
    N = 14,
    O = 15,
    P = 16,
    Q = 17,
    R = 18,
    S = 19,
    T = 20,
    U = 21,
    V = 22,
    W = 23,
    X = 24,
    Y = 25,
    Z = 26,
    a = -1,
    b = -2,
    c = -3,
    d = -4,
    e = -5,
    f = -6,
    g = -7,
    h = -8,
    i = -9,
    j = -10,
    k = -11,
    l = -12,
    m = -13,
    n = -14,
    o = -15,
    p = -16,
    q = -17,
    r = -18,
    s = -19,
    t = -20,
    u = -21,
    v = -22,
    w = -23,
    x = -24,
    y = -25,
    z = -26
  },
  Humidity = {
    x = nil, -- Humidity is parsed from the weather code but is not shown on the overlay HUD.
    d = " ◆ Dry",
    h = " ◆ Humid",
    m = " ◆ Muggy",
    s = " ◆ Stifling"
  },
  Wind = {
    x = {
      textIfWarm = " ◆ Still",
      textIfCold = " ◆ Still",
      windAudioIfWarm = "silent",
      windAudioIfCold = "silent"
    },
    s = {
