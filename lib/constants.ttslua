C.BlindfoldVariantCount = 32

--- When an object is hidden from every PC seat, also hide from spectators (White/Grey). Never use this list to *grant* visibility to White/Grey alone.
C.HideFromPcSeatsAndSpectators = {
  "Brown", "Orange", "Red", "Pink", "Purple", "White", "Grey",
}

--- World Y for objects parked off-table via `O.hideObject` / `O.restoreObject`.
C.HIDDEN_OBJECT_WORLD_Y = -200

--- Resolve playerRef to a storage / Steam ID string (Storyteller normalized to C.StorytellerID).
-- Accepts a TTS Player, steam id key, nickname key in C.PlayerIDs, seat color, playerName, charKey, or "Host"/"Storyteller".
-- @param playerRef Player|string
-- @return string
C.GetPlayerID = function(playerRef)
  if playerRef == nil then
    error("Invalid player reference: nil")
  end

  if type(playerRef) == "userdata" then
    ---@cast playerRef Player
    if playerRef.steam_id == nil then
      error("Invalid player reference: not a Player (missing steam_id)")
    end
    local sid = tostring(playerRef.steam_id)
    if sid == C.StorytellerID then
      return C.StorytellerID
    end
    return sid
  end

  if type(playerRef) ~= "string" then
    error("Invalid player reference: " .. tostring(playerRef))
  end

  if C.PlayerIDs[playerRef] then
    return C.PlayerIDs[playerRef]
  end
  if C.PlayerData[playerRef] then
    return playerRef
  end

  local lr = string.lower(playerRef)
  if lr == "host" or lr == "storyteller" then
    if Player ~= nil and type(Player.getAvailableColors) == "function" then
      for _, color in ipairs(Player.getAvailableColors()) do
        local p = Player[color]
        if p ~= nil and p.steam_id ~= nil and tostring(p.steam_id) == C.StorytellerID then
          return C.StorytellerID
        end
      end
    end
    return C.StorytellerID
  end

  for playerID, playerData in pairs(C.PlayerData) do
    if type(playerData) == "table" then
      local col, nm, ck = playerData.color, playerData.playerName, playerData.charKey
      if (type(col) == "string" and string.lower(col) == lr)
          or (type(nm) == "string" and string.lower(nm) == lr)
          or (type(ck) == "string" and string.lower(ck) == lr) then
        return playerID
      end
    end
  end
  error("Invalid player reference: " .. tostring(playerRef))
end

--- Same resolution rules as `C.GetPlayerID`, but returns nil instead of erroring (for soft lookups).
--- @param playerRef Player|string|nil
--- @return string|nil
C.GetPlayerIDOrNil = function(playerRef)
  if playerRef == nil then
    return nil
  end

  if type(playerRef) == "userdata" then
    ---@cast playerRef Player
    if playerRef.steam_id == nil then
      return nil
    end
    local sid = tostring(playerRef.steam_id)
    if sid == C.StorytellerID then
      return C.StorytellerID
    end
    return sid
  end

  if type(playerRef) ~= "string" then
    return nil
  end

  if C.PlayerIDs[playerRef] then
    return C.PlayerIDs[playerRef]
  end
  if C.PlayerData[playerRef] then
    return playerRef
  end

  local lr = string.lower(playerRef)
  if lr == "host" or lr == "storyteller" then
    if Player ~= nil and type(Player.getAvailableColors) == "function" then
      for _, color in ipairs(Player.getAvailableColors()) do
        local p = Player[color]
        if p ~= nil and p.steam_id ~= nil and tostring(p.steam_id) == C.StorytellerID then
          return C.StorytellerID
        end
      end
    end
    return C.StorytellerID
  end

  for playerID, playerData in pairs(C.PlayerData) do
    if type(playerData) == "table" then
      local col, nm, ck = playerData.color, playerData.playerName, playerData.charKey
      if (type(col) == "string" and string.lower(col) == lr)
          or (type(nm) == "string" and string.lower(nm) == lr)
          or (type(ck) == "string" and string.lower(ck) == lr) then
        return playerID
      end
    end
  end
  return nil
end

--- Current TTS seat color for this player (Host may not be seated at Black).
-- @param playerRef Player|string
-- @return string|nil
C.GetPlayerColor = function(playerRef)
  if playerRef == nil then
    return nil
  end

  local playerID = nil
  if type(playerRef) == "userdata" then
    ---@cast playerRef Player
    if playerRef.steam_id ~= nil and tostring(playerRef.steam_id) == C.StorytellerID then
      playerID = C.StorytellerID
    elseif playerRef.steam_id ~= nil then
      playerID = tostring(playerRef.steam_id)
    else
      return playerRef.color
    end
  else
    playerID = C.GetPlayerIDOrNil(playerRef)
    if type(playerID) ~= "string" then
      return nil
    end
  end

  if Player ~= nil and type(Player.getAvailableColors) == "function" then
    for _, color in ipairs(Player.getAvailableColors()) do
      local p = Player[color]
      if p ~= nil and p.steam_id ~= nil and tostring(p.steam_id) == playerID then
        return color
      end
    end
  end

  if type(playerRef) == "userdata" then
    ---@cast playerRef Player
    if playerRef.color ~= nil then
      return playerRef.color
    end
  end
  return nil
end

-- #endregion

-- #region Base Constants
-- NPC Seats
-- The up-to-four table slots for NPCs, identified by the tags NPC1, NPC2, NPC3, NPC4
C.NPCSeats = {
  "NPC1", "NPC2", "NPC3", "NPC4"
}

-- Game Phases (VTM5E / Toronto Rising) — TOR-143
-- Top-level sequence: Intermission → Play → Spotlight → End → Intermission.
-- Play subphases (free switch): Main / Downtime / Memoriam — see C.PlaySubPhases.
-- Stored in state as currentPhase / playSubPhase; validated via U.isIn.
C.Phases = {
  INTERMISSION = "Intermission",
  PLAY = "Play",
  SPOTLIGHT = "Spotlight",
  END = "End",
}

--- Ordered top-level advance loop (Storyteller Dashboard next-phase button).
C.PhaseSequence = {
  C.Phases.INTERMISSION,
  C.Phases.PLAY,
  C.Phases.SPOTLIGHT,
  C.Phases.END,
}

--- Subphases of Play only (default on enter Play = MAIN).
C.PlaySubPhases = {
  MAIN = "Main",
  DOWNTIME = "Downtime",
  MEMORIAM = "Memoriam",
}

--- Featured track for Intermission ambient (looping TR Loop only; no Intro→Loop handoff).
C.IntermissionThemeFeaturedKey = "TR_Loop"

--- Session-start overture key and length live on the sound catalog
--- (`TR_SessionStart<sessionNum>` via Catalog.sessionIntroKeyForSession).
C.SessionStartBlindfoldLeadSec = 2
--- After OutdoorDim / HUD work behind the cover, wait this long before the splash
--- so TTS can finish lighting applies (TOR-536). Seat lights snap instantly on Play enter.
C.SessionStartPlayEnterSettleSec = 2

--- Spotlight phase uses a dedicated environment (Table A + Spotlight skybox), not a scene library row.

