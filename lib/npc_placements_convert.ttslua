--[[
    Legacy `sessionScene.npcWorld.byArea` (the pre-gameboard area slot maps) is no longer converted: the stage layout
    lives only in `npcWorld.placements`. `S.validateState` passes the live scene and every library row through
    `rejectLegacyByArea`, which prints any NPCs it held (so the Storyteller can place them again) and drops it.
    Agent: `.dev/NPC Object Spawning & Spotlighting/Storyteller Gameboard Control.md`
]]

local Convert = {}

--- Drops `sessionScene.npcWorld.byArea`, printing each character it held.
--- @param sessionScene table|nil
--- @param where string scene label for the console line
--- @return boolean dropped true when byArea held any character
function Convert.rejectLegacyByArea(sessionScene, where)
    local npcWorld = type(sessionScene) == "table" and sessionScene.npcWorld or nil
    if type(npcWorld) ~= "table" or npcWorld.byArea == nil then
        return false
    end
    local dropped = {}
    if type(npcWorld.byArea) == "table" then
        for areaKey, slots in pairs(npcWorld.byArea) do
            if type(slots) == "table" then
                for _, row in pairs(slots) do
                    if type(row) == "table" and type(row.characterKey) == "string" and row.characterKey ~= "" then
                        dropped[#dropped + 1] = row.characterKey .. " (" .. tostring(areaKey) .. ")"
                    end
                end
            end
        end
    end
    npcWorld.byArea = nil
    if #dropped == 0 then
        return false
    end
    table.sort(dropped)
    print(
        "[state] " .. where .. ": dropped legacy npcWorld.byArea stage rows, which are no longer converted. "
            .. "Place these NPCs on the stage again: " .. table.concat(dropped, ", ")
    )
    return true
end

return Convert
