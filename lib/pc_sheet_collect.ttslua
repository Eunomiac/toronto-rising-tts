--[[
  Character sheet UI diff collection (pure functions, no core.* requires).
  Used by object scripts (ui/ui_csheet) and Global (GlobalCollectSheetImageUpdates).
  Mutation / sync / HUD overlay logic stays in lib.pc_stats.

  Agent guidance: .dev/PC Data & Tracking/PC Tracking & State Behavior.md; .dev/TTS_BUNDLING_SETUP.md
]]

local PSC = {}

--- Tracker glyphs / sheet images from Global (`GlobalRegisterTrackerDisplay` on `_G.TRACKER_DISPLAY`).
--- @return table|nil
local function getMergedTrackerDisplay()
  local g = rawget(_G, "TRACKER_DISPLAY")
  if type(g) == "table" then
    return g
  end
  return nil
end

--- Which automated UI id updates apply per sheet page (`CSHEET_PAGE_<n>_<COLOR>`).
--- Add rows when you add page 3..8 XML: `"main"` = attrs/skills/trackers/BP/humanity (no discipline dots);
--- `"disciplines"` = discipline dot-lines only; `"none"` = skip this pipeline.
PSC.SHEET_PAGE_UPDATE_PROFILE = {
  [1] = "main",
  [2] = "disciplines",
}

PSC.DISCIPLINE_DOT_KEYS = {
  animalism = true,
  auspex = true,
  bloodSorcery = true,
  celerity = true,
  dominate = true,
  fortitude = true,
  obfuscate = true,
  oblivion = true,
  potence = true,
  presence = true,
  protean = true,
}

--- @param elementId string
--- @return string|nil discipline key from dot_<key>_<n> or legacy dot_on|off_<key>_<n>
function PSC.disciplineKeyFromDotElementId(elementId)
  if type(elementId) ~= "string" then
    return nil
  end
  local k1 = select(3, elementId:find("^dot_on_(.+)_(%d+)$"))
  if k1 ~= nil then
    return k1
  end
  local k2 = select(3, elementId:find("^dot_off_(.+)_(%d+)$"))
  if k2 ~= nil then
    return k2
  end
  return select(3, elementId:find("^dot_(.+)_(%d+)$"))
end

--- Sum resolved condition stat deltas for aggregate trackers (health, willpower, humanity).
--- @param stats table
--- @param resolvedStatChanges table|nil merged statChanges from condition_effects
--- @param statKey string
--- @return number
function PSC.effectiveTempForAggregate(stats, resolvedStatChanges, statKey)
  local baseT = 0
  if type(stats) == "table" and type(stats[statKey]) == "table" then
    baseT = tonumber(stats[statKey].temp) or 0
  end
  local add = 0
  if type(resolvedStatChanges) == "table" then
    add = tonumber(resolvedStatChanges[statKey]) or 0
  end
  return baseT + add
end

--- @param stats table
--- @param resolvedStatChanges table|nil merged statChanges from condition_effects
--- @param dotKey string attribute/skill/discipline key
--- @return number
function PSC.effectiveTempForDot(stats, resolvedStatChanges, dotKey)
  local baseT = 0
  if type(stats) == "table" then
    if type(stats.attributes) == "table" and type(stats.attributes[dotKey]) == "table" then
      baseT = tonumber(stats.attributes[dotKey].temp) or 0
    elseif type(stats.skills) == "table" and type(stats.skills[dotKey]) == "table" then
      baseT = tonumber(stats.skills[dotKey].temp) or 0
    elseif type(stats.disciplines) == "table" and type(stats.disciplines[dotKey]) == "table" then
      baseT = tonumber(stats.disciplines[dotKey].temp) or 0
    elseif dotKey == "bloodPotency" and type(stats.bloodPotency) == "table" then
      baseT = tonumber(stats.bloodPotency.temp) or 0
    end
  end
  local add = 0
  if type(resolvedStatChanges) == "table" then
    add = tonumber(resolvedStatChanges[dotKey]) or 0
  end
  return baseT + add
end

--- Max tracker boxes: base + temp + merged condition statChanges.
--- Shared by damage overflow, remorse pool, derived condition derive, and EffectiveStats.
--- @param stats table|nil
--- @param resolvedStatChanges table|nil
--- @param trackerKey string health|willpower|humanity
--- @return number
function PSC.trackerMaxFromStats(stats, resolvedStatChanges, trackerKey)
  local base = 0
  if type(stats) == "table" and type(stats[trackerKey]) == "table" then
    base = tonumber(stats[trackerKey].base) or 0
  end
  return base + PSC.effectiveTempForAggregate(stats, resolvedStatChanges, trackerKey)
end

--- Dot-line rating: base + temp + condition delta, clamped.
--- @param stats table|nil
--- @param resolvedStatChanges table|nil
--- @param dotKey string
--- @param clampMax number|nil default 5
--- @return number
function PSC.dotRatingFromStats(stats, resolvedStatChanges, dotKey, clampMax)
  local base = 0
  if type(stats) == "table" then
    if dotKey == "bloodPotency" and type(stats.bloodPotency) == "table" then
      base = tonumber(stats.bloodPotency.base) or 0
    elseif type(stats.attributes) == "table" and type(stats.attributes[dotKey]) == "table" then
      base = tonumber(stats.attributes[dotKey].base) or 0
    elseif type(stats.skills) == "table" and type(stats.skills[dotKey]) == "table" then
      base = tonumber(stats.skills[dotKey].base) or 0
    elseif type(stats.disciplines) == "table" and type(stats.disciplines[dotKey]) == "table" then
      base = tonumber(stats.disciplines[dotKey].base) or 0
    end
  end
  local maxRating = tonumber(clampMax) or 5
  local rating = base + PSC.effectiveTempForDot(stats, resolvedStatChanges, dotKey)
  return math.max(0, math.min(maxRating, math.floor(rating)))
end

--- Image asset for a painted fill slot (blank-base sheets).
--- @param key string
--- @param base number
--- @param eff number temp+condition delta
--- @param slot number 1..5
--- @return boolean active
--- @return string|nil imageName
function PSC.resolveDotSlotImage(key, base, eff, slot)
  local rating = base + eff
  local fillImage = "dot_yellow"
  if key == "bloodPotency" then
    fillImage = "dot_red"
  end
  if slot <= base and slot <= rating then
    return true, fillImage
  end
  if eff > 0 and slot > base and slot <= rating then
    return true, "dot_white"
  end
  if eff < 0 and slot > rating and slot <= base then
    return true, "dot_grey"
  end
  return false, nil
end

--- Build XML attribute updates for character sheet objects.
--- Blank-base contract: one Image per slot (`dot_<key>_<n>`, `box_<tracker>_<i>`); set active + image.
--- @param stats table
--- @param resolvedStatChanges table|nil merged statChanges from condition_effects
--- @param pageNum number|nil sheet index from object name; see `PSC.SHEET_PAGE_UPDATE_PROFILE`
--- @return table[] list of { id = string, attributes = { active = "true"|"false", image?: string } }
function PSC.collectSheetImageUpdates(stats, resolvedStatChanges, pageNum)
  local updates = {}
  --- @param imageName string|nil when set, applied as `image` (custom-ui asset name)
  local function add(id, active, imageName)
    local attrs = { active = active and "true" or "false" }
    if active and type(imageName) == "string" and imageName ~= "" then
      attrs.image = imageName
    end
    updates[#updates + 1] = { id = id, attributes = attrs }
  end

  if type(stats) ~= "table" then
    return updates
  end

  local pageProfile = nil
  if pageNum ~= nil then
    pageProfile = PSC.SHEET_PAGE_UPDATE_PROFILE[pageNum] or "none"
    if pageProfile == "none" then
      return updates
    end
  end

  local function paintDotKey(key, kind)
    local base = 0
    if kind == "bloodPotency" then
      base = tonumber(stats.bloodPotency.base) or 0
    elseif kind == "attributes" then
      base = tonumber(stats.attributes[key].base) or 0
    elseif kind == "skills" then
      base = tonumber(stats.skills[key].base) or 0
    elseif kind == "disciplines" then
      base = tonumber(stats.disciplines[key].base) or 0
    end
    local eff = PSC.effectiveTempForDot(stats, resolvedStatChanges, key)
    for slot = 1, 5 do
      local active, imageName = PSC.resolveDotSlotImage(key, base, eff, slot)
      add("dot_" .. key .. "_" .. slot, active, imageName)
    end
  end

  if pageProfile == "main" or pageProfile == nil then
    if type(stats.attributes) == "table" then
      for k, _ in pairs(stats.attributes) do
        paintDotKey(k, "attributes")
      end
    end
    if type(stats.skills) == "table" then
      for k, _ in pairs(stats.skills) do
        paintDotKey(k, "skills")
      end
    end
    if type(stats.bloodPotency) == "table" then
      paintDotKey("bloodPotency", "bloodPotency")
    end

    local function boxFill(which, trackerKey)
      local tr = stats[which]
      if type(tr) ~= "table" then
        return
      end
      local td = getMergedTrackerDisplay()
      local layerImg = type(td) == "table" and type(td.sheetImages) == "table" and td.sheetImages[trackerKey] or nil
      local function boxImg(layer, fallback)
        if type(layerImg) == "table" then
          local v = layerImg[layer]
          if type(v) == "string" and v ~= "" then
            return v
          end
        end
        return fallback
      end
      local maxB = (tonumber(tr.base) or 0) + PSC.effectiveTempForAggregate(stats, resolvedStatChanges, which)
      local cells = {}
      if which == "humanity" then
        local lineLen = maxB
        local stains = tonumber(tr.stains) or 0
        for i = 1, 10 do
          cells[i] = nil
        end
        for i = 1, lineLen do
          cells[i] = "filled"
        end
        local sIdx = 10
        for _ = 1, stains do
          if sIdx < 1 then
            break
          end
          if cells[sIdx] == "filled" then
            cells[sIdx] = "impaired"
            break
          end
          cells[sIdx] = "stain"
          sIdx = sIdx - 1
        end
        for i = 1, 10 do
          local layer = cells[i]
          if layer == "filled" then
            add("box_humanity_" .. i, true, boxImg("filled", "box_white"))
          elseif layer == "stain" then
            add("box_humanity_" .. i, true, boxImg("stain", "box_purple"))
          elseif layer == "impaired" then
            add("box_humanity_" .. i, true, boxImg("impaired", "box_red"))
          else
            add("box_humanity_" .. i, false)
          end
        end
        return
      end

      local sup = tonumber(tr.superficial) or 0
      local agg = tonumber(tr.aggravated) or 0
      local idx = 1
      for _ = 1, agg do
        if idx <= maxB then
          cells[idx] = "aggravated"
          idx = idx + 1
        end
      end
      for _ = 1, sup do
        if idx <= maxB then
          cells[idx] = "superficial"
          idx = idx + 1
        end
      end
      while idx <= maxB do
        cells[idx] = "undamaged"
        idx = idx + 1
      end
      for i = 1, 10 do
        local layer = cells[i]
        if layer == "aggravated" then
          add("box_" .. trackerKey .. "_" .. i, true, boxImg("aggravated", "box_red_x"))
        elseif layer == "superficial" then
          add("box_" .. trackerKey .. "_" .. i, true, boxImg("superficial", "box_grey_slash"))
        elseif layer == "undamaged" then
          add("box_" .. trackerKey .. "_" .. i, true, boxImg("undamaged", "box_white"))
        else
          add("box_" .. trackerKey .. "_" .. i, false)
        end
      end
    end

    boxFill("health", "health")
    boxFill("willpower", "willpower")
    if type(stats.humanity) == "table" then
      boxFill("humanity", "humanity")
    end
  end

  if pageProfile == "disciplines" or pageProfile == nil then
    if type(stats.disciplines) == "table" then
      for k, _ in pairs(stats.disciplines) do
        if PSC.DISCIPLINE_DOT_KEYS[k] == true then
          paintDotKey(k, "disciplines")
        end
      end
    end
    -- Ritual / ceremony row fills: ids from page2 builder `dot_rc_<side>_<row>_<slot>`
    local function paintRcList(list, side)
      if type(list) ~= "table" then
        return
      end
      for row = 1, 5 do
        local entry = list[row]
        local level = 0
        if type(entry) == "table" then
          level = math.floor(tonumber(entry.level) or 0)
        end
        for slot = 1, 5 do
          local id = string.format("dot_rc_%s_%d_%d", side, row, slot)
          if slot <= level then
            add(id, true, "dot_yellow")
          else
            add(id, false)
          end
        end
      end
    end
    local rituals = {}
    local ceremonies = {}
    if type(stats.disciplines) == "table" then
      for _, row in pairs(stats.disciplines) do
        if type(row) == "table" then
          if type(row.rituals) == "table" then
            for i = 1, #row.rituals do
              rituals[#rituals + 1] = row.rituals[i]
            end
          end
          if type(row.ceremonies) == "table" then
            for i = 1, #row.ceremonies do
              ceremonies[#ceremonies + 1] = row.ceremonies[i]
            end
          end
        end
      end
    end
    if #rituals > 0 or #ceremonies > 0 then
      if #rituals > 0 and #ceremonies > 0 then
        paintRcList(rituals, "L")
        paintRcList(ceremonies, "R")
      else
        local only = #rituals > 0 and rituals or ceremonies
        local left = {}
        local right = {}
        for i = 1, math.min(5, #only) do
          left[i] = only[i]
        end
        for i = 6, math.min(10, #only) do
          right[i - 5] = only[i]
        end
        paintRcList(left, "L")
        paintRcList(right, "R")
      end
    end
  end

  if pageNum ~= nil and pageProfile ~= nil then
    -- Profile already gated which sections ran; return as-is.
    return updates
  end

  return updates
end

--- Build Global HUD attribute updates for Prince's Court page-1 tracker columns (shared tree, TOR-444).
--- One Image per cell: `box_<kind>_<i>_<panelSeat>` with `image` + `active` (no on/agg/sup siblings).
--- @param stats table|nil when nil, every box in the column is hidden
--- @param resolvedStatChanges table|nil merged statChanges from condition_effects
--- @param panelSeatColor string column seat (Purple, Pink, …)
--- @param hudSeatColor string|nil ignored (call-site compat)
--- @return table[] list of { id = string, attributes = { active = "true"|"false", image?: string } }
function PSC.collectPrincesCourtTrackerUpdates(stats, resolvedStatChanges, panelSeatColor, hudSeatColor)
  local suffix = "_" .. tostring(panelSeatColor)
  local updates = {}

  local function push(id, active, imageName)
    local attrs = { active = active and "true" or "false" }
    if active and type(imageName) == "string" and imageName ~= "" then
      attrs.image = imageName
    end
    updates[#updates + 1] = { id = id, attributes = attrs }
  end

  local function defaultBoxImg(layer)
    if layer == "aggravated" then
      return "box_red_x"
    end
    if layer == "superficial" then
      return "box_grey_slash"
    end
    if layer == "undamaged" or layer == "filled" then
      return "box_white"
    end
    if layer == "stain" then
      return "box_purple"
    end
    if layer == "impaired" then
      return "box_red"
    end
    return "box_white"
  end

  if type(stats) ~= "table" then
    for _, trackerKey in ipairs({ "health", "willpower", "humanity" }) do
      for i = 1, 10 do
        push("box_" .. trackerKey .. "_" .. i .. suffix, false)
      end
    end
    for i = 1, 5 do
      push("box_hunger_" .. i .. suffix, false)
    end
    return updates
  end

  local function fillDamageTracker(which, trackerKey)
    local tr = stats[which]
    if type(tr) ~= "table" then
      for i = 1, 10 do
        push("box_" .. trackerKey .. "_" .. i .. suffix, false)
      end
      return
    end
    local maxB = (tonumber(tr.base) or 0) + PSC.effectiveTempForAggregate(stats, resolvedStatChanges, which)
    local sup = tonumber(tr.superficial) or 0
    local agg = tonumber(tr.aggravated) or 0
    local cells = {}
    local idx = 1
    for _ = 1, agg do
      if idx <= maxB then
        cells[idx] = "aggravated"
        idx = idx + 1
      end
    end
    for _ = 1, sup do
      if idx <= maxB then
        cells[idx] = "superficial"
        idx = idx + 1
      end
    end
    while idx <= maxB do
      cells[idx] = "undamaged"
      idx = idx + 1
    end
    for i = 1, 10 do
      local layer = cells[i]
      if layer == nil then
        push("box_" .. trackerKey .. "_" .. i .. suffix, false)
      else
        push("box_" .. trackerKey .. "_" .. i .. suffix, true, defaultBoxImg(layer))
      end
    end
  end

  fillDamageTracker("health", "health")
  fillDamageTracker("willpower", "willpower")

  if type(stats.humanity) == "table" then
    local hu = stats.humanity
    local lineLen = (tonumber(hu.base) or 0) + PSC.effectiveTempForAggregate(stats, resolvedStatChanges, "humanity")
    local stains = tonumber(hu.stains) or 0
    local slots = {}
    for i = 1, 10 do
      slots[i] = "empty"
    end
    for i = 1, lineLen do
      slots[i] = "on"
    end
    local sIdx = 10
    for _ = 1, stains do
      if sIdx < 1 then
        break
      end
      if slots[sIdx] == "on" then
        slots[sIdx] = "impaired"
        break
      end
      slots[sIdx] = "stain"
      sIdx = sIdx - 1
    end
    for i = 1, 10 do
      if slots[i] == "on" then
        push("box_humanity_" .. i .. suffix, true, defaultBoxImg("filled"))
      elseif slots[i] == "stain" then
        push("box_humanity_" .. i .. suffix, true, defaultBoxImg("stain"))
      elseif slots[i] == "impaired" then
        push("box_humanity_" .. i .. suffix, true, defaultBoxImg("impaired"))
      else
        push("box_humanity_" .. i .. suffix, false)
      end
    end
  else
    for i = 1, 10 do
      push("box_humanity_" .. i .. suffix, false)
    end
  end

  local hunger = math.max(0, math.min(5, math.floor(tonumber(stats.hunger) or 0)))
  for i = 1, 5 do
    push("box_hunger_" .. i .. suffix, i <= hunger, "box_red")
  end

  return updates
end

return PSC
