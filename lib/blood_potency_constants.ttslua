--[[
  Blood Potency lookup tables for derived stats and CSHEET decal URLs (object-bundle safe).
  Canonical source — lib.constants re-exports these for Global; object scripts must require
  this module directly (not lib.constants).

  Decal art: assets/CSheets/Blood Potency/bloodPotency_<variant>.png → lib/cloud_blood_potency.ttslua
  (job `bloodPotencyDecals`; npm run cloud-asset-sync). That generated module is a flat table, safe in object bundles.
  Agent guidance: .dev/TTS_BUNDLING_SETUP.md
]]

local CloudBloodPotency = require("lib.cloud_blood_potency")

local BPC = {}

BPC.BloodPotency = {
  [0] = {
    bloodSurge = 1,
    mending = 1,
    discBonus = 0,
    discReroll = 0,
    baneSeverity = 0
  },
  [1] = {
    bloodSurge = 2,
    mending = 1,
    discBonus = 0,
    discReroll = 1,
    baneSeverity = 2
  },
  [2] = {
    bloodSurge = 2,
    mending = 2,
    discBonus = 1,
    discReroll = 1,
    baneSeverity = 2
  },
  [3] = {
    bloodSurge = 3,
    mending = 2,
    discBonus = 1,
    discReroll = 2,
    baneSeverity = 3
  },
  [4] = {
    bloodSurge = 3,
    mending = 3,
    discBonus = 2,
    discReroll = 2,
    baneSeverity = 3
  },
  [5] = {
    bloodSurge = 4,
    mending = 3,
    discBonus = 2,
    discReroll = 3,
    baneSeverity = 4
  },
  [6] = {
    bloodSurge = 4,
    mending = 3,
    discBonus = 3,
    discReroll = 3,
    baneSeverity = 4
  },
  [7] = {
    bloodSurge = 5,
    mending = 3,
    discBonus = 3,
    discReroll = 4,
    baneSeverity = 5
  },
  [8] = {
    bloodSurge = 5,
    mending = 4,
    discBonus = 4,
    discReroll = 4,
    baneSeverity = 5
  },
  [9] = {
    bloodSurge = 6,
    mending = 4,
    discBonus = 4,
    discReroll = 5,
    baneSeverity = 6
  },
  [10] = {
    bloodSurge = 6,
    mending = 5,
    discBonus = 5,
    discReroll = 5,
    baneSeverity = 6
  }
}

-- Variant key = statKey .. value, e.g. "bloodSurge3".
-- Object AttachedDecal.name values are static slot keys (bloodSurge, mending, …); reconcile swaps url only.
BPC.BloodPotencyDecalUrls = {}
for key, row in pairs(CloudBloodPotency) do
  BPC.BloodPotencyDecalUrls[key] = row.URL
end

BPC.BloodPotencyDecalSlots = {
  page1 = { "bloodSurge", "mending" },
  page2 = { "baneSeverity", "discBonus", "discReroll" },
}

return BPC
