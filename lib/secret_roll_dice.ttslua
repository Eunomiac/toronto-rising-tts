--[[
    Secret Storyteller rolls (lib/secret_roll_dice.ttslua)

    The physical dice of a secret roll are hidden from players from the moment they spawn. Players
    glimpse a random handful of them while the first throw is in the air, and every rerolled die while
    it is rerolled; the result banner shows only the dice the result itself gives away.

    Pure rules only (no world I/O): `core/global_script.ttslua` applies the reveals, `core/roll_ui.ttslua`
    filters the banner. Contract: `.dev/Dice System/Roll Broadcast Messages.md` § Secret rolls.
]]

local C = require("lib.constants")
local DK = require("lib.dice_kinds")

local SRD = {}

--- Seconds a glimpsed die stays visible after its toss: hidden again before it lands.
SRD.REVEAL_SECONDS = 0.9

--- Bounds on how many dice of a first throw players glimpse: from max(1, min(3, 25% of the pool)) to
--- min(pool, max(8, 75% of the pool)).
--- @param poolSize number
--- @return number low
--- @return number high
function SRD.revealCountRange(poolSize)
    local n = math.floor(tonumber(poolSize) or 0)
    if n <= 0 then
        return 0, 0
    end
    local low = math.max(1, math.min(3, math.floor(n * 0.25)))
    local high = math.min(n, math.max(8, math.floor(n * 0.75)))
    return math.min(low, high), high
end

--- A random subset of `items` sized within `SRD.revealCountRange(#items)`.
--- @param items table array
--- @return table array
function SRD.pickRevealed(items)
    local low, high = SRD.revealCountRange(#items)
    if high == 0 then
        return {}
    end
    local shuffled = {}
    for i, item in ipairs(items) do
        shuffled[i] = item
    end
    local count = math.random(low, high)
    for i = 1, count do
        local j = math.random(i, #shuffled)
        shuffled[i], shuffled[j] = shuffled[j], shuffled[i]
    end
    local out = {}
    for i = 1, count do
        out[i] = shuffled[i]
    end
    return out
end

local HUNGER_OF = {
    [DK.KIND_NORMAL] = DK.KIND_HUNGER,
    [DK.KIND_WEREWOLF] = DK.KIND_RAGE,
}
local NORMAL_OF = {
    [DK.KIND_HUNGER] = DK.KIND_NORMAL,
    [DK.KIND_RAGE] = DK.KIND_WEREWOLF,
}

--- @param face table
--- @return string
local function faceKind(face)
    if type(face.kind) == "string" then
        return face.kind
    end
    return face.isHunger == true and DK.KIND_HUNGER or DK.KIND_NORMAL
end

--- The dice a secret roll's result banner shows: successes and criticals only, as rolled. A messy
--- critical shows them all as Hunger (Rage) dice; a bestial failure shows them as normal dice plus every
--- Hunger (Rage) 1; a total failure shows nothing (a total bestial failure, just its Hunger 1s). Rouse
--- dice pass through: the banner shows those from their own outcome strips.
--- @param diceFaces table|nil face records (`value`, `kind`)
--- @param resultClass string|nil `C.ResultClass` value
--- @return table face records
function SRD.broadcastFaces(diceFaces, resultClass)
    local bestial = resultClass == C.ResultClass.BESTIAL_FAILURE or resultClass == C.ResultClass.TOTAL_BESTIAL_FAILURE
    local messy = resultClass == C.ResultClass.MESSY_CRITICAL
    local out = {}
    local function add(value, kind)
        out[#out + 1] = { value = value, kind = kind, isHunger = kind == DK.KIND_HUNGER }
    end
    for _, face in ipairs(type(diceFaces) == "table" and diceFaces or {}) do
        local kind = faceKind(face)
        local value = tonumber(face.value) or 0
        local isHungerKind = NORMAL_OF[kind] ~= nil
        if not isHungerKind and HUNGER_OF[kind] == nil then
            add(face.value, kind)
        elseif bestial and value >= 6 then
            add(value, NORMAL_OF[kind] or kind)
        elseif bestial and value == 1 and isHungerKind then
            add(value, kind)
        elseif not bestial and resultClass ~= C.ResultClass.TOTAL_FAILURE and value >= 6 then
            add(value, messy and (HUNGER_OF[kind] or kind) or kind)
        end
    end
    return out
end

return SRD
