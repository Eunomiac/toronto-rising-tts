{
  "name": "toronto-rising-complications",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:worker": "wrangler dev",
    "catalog": "node scripts/generate-catalog.mjs",
    "assets": "node scripts/sync-assets.mjs",
    "prebuild": "npm run catalog && npm run assets",
    "build": "tsc -b && vite build",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "oxlint",
    "preview": "vite preview",
    "publish": "wrangler deploy",
    "deploy": "npm run build && npm run publish"
  },
  "dependencies": {
    "@gsap/react": "^2.1.2",
    "gsap": "^3.15.1",
    "partyserver": "^0.5.10",
    "partysocket": "^1.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261117.1",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "oxlint": "^1.90.0",
    "probe-image-size": "^7.5.0",
    "sass": "^1.108.2",
    "typescript": "~7.0.2",
    "vite": "^8.3.6",
    "vitest": "^4.1.12",
    "wrangler": "^4.163.0"
  }
}
