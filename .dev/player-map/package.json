{
  "name": "toronto-rising-player-map",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "data:build": "node scripts/build-map-data.mjs",
    "data:refresh": "node scripts/build-map-data.mjs --refresh-sheet",
    "data:check": "node scripts/build-map-data.mjs --check",
    "dev": "npm run data:build && vite",
    "build": "npm run data:build && tsc -b && vite build && node scripts/check-production-debug-boundary.mjs",
    "preview": "vite preview",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run && node --test scripts/lib/svg-geometry.test.mjs scripts/lib/normalize-districts.test.mjs scripts/lib/public-data.test.mjs worker/index.test.mjs",
    "test:browser": "playwright test",
    "test:debug-notes:browser": "playwright test --config playwright.debug.config.ts",
    "check": "npm run data:check && npm run typecheck && npm run test && npm run build && npm run test:browser && npm run test:debug-notes:browser",
    "deploy:dry-run": "npm run build && wrangler deploy --dry-run",
    "deploy": "npm run check && wrangler deploy"
  },
  "dependencies": {
    "@gsap/react": "^2.1.2",
    "gsap": "^3.15.1",
    "maplibre-gl": "^6.17.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.9",
    "@turf/area": "^7.4.0",
    "@turf/buffer": "^7.4.0",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "fast-xml-parser": "^5.12.0",
    "jsdom": "^29.1.1",
    "polygon-clipping": "^0.15.7",
    "sass": "^1.108.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.7",
    "vitest": "^4.1.12",
    "wrangler": "^4.160.0"
  }
}
