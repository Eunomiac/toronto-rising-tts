{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "toronto-rising-player-map",
  "main": "worker/index.js",
  "compatibility_date": "2026-11-10",
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  },
  // Create with: wrangler secret put PLAYER_MAP_PUSH_SECRET
  // SESSION_PINS keeps the last live pin snapshot indefinitely (until the next live POST).
  "kv_namespaces": [
    {
      "binding": "SESSION_PINS",
      "id": "f4ac8ec426c0444bbe46b752958feb47"
    }
  ],
  "vars": {}
}
