{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "toronto-rising-player-map",
  "main": "worker/index.js",
  "compatibility_date": "2026-11-10",
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  },
  // Create with: wrangler secret put PLAYER_MAP_PUSH_SECRET
  // Optional durable store: wrangler kv namespace create SESSION_PINS
  // then bind id below as SESSION_PINS (memory fallback works for single-isolate smoke).
  "vars": {}
}
