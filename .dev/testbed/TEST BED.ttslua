-- #region COPY TABLE MATERIAL (Custom Model)
-- Self-contained: Execute this file (or the call below) from the IDE — no Save & Play.
-- Uses global C + TTS getObjectFromGUID only.

--- Read Custom Model material fields from one playfield table and apply them to
--- every other table in C.Tables, plus all table leaf components.
--- TTS API key is `fresnel_strength` (misspelled in the engine).
--- @param sourceTableKey string e.g. "Table A"
--- @return boolean
function applyTableMaterialFrom(sourceTableKey)
  if type(sourceTableKey) ~= "string" or sourceTableKey == "" then
    error("[TEST BED] applyTableMaterialFrom: pass a table key string (e.g. \"Table A\")")
  end
  if C == nil or type(C.Tables) ~= "table" then
    error("[TEST BED] applyTableMaterialFrom: C.Tables is not available")
  end

  local sourceCfg = C.Tables[sourceTableKey]
  if type(sourceCfg) ~= "table" or type(sourceCfg.guid) ~= "string" or sourceCfg.guid == "" then
    error("[TEST BED] applyTableMaterialFrom: unknown table key: " .. tostring(sourceTableKey))
  end

  local sourceObj = getObjectFromGUID(sourceCfg.guid)
  if sourceObj == nil then
    error("[TEST BED] applyTableMaterialFrom: source object missing for " .. sourceTableKey .. " guid=" .. sourceCfg
    .guid)
  end
  if sourceObj.getCustomObject == nil then
    error("[TEST BED] applyTableMaterialFrom: source has no getCustomObject: " .. sourceTableKey)
  end

  local sourceCustom = sourceObj.getCustomObject()
  if type(sourceCustom) ~= "table" then
    error("[TEST BED] applyTableMaterialFrom: source getCustomObject() did not return a table")
  end

  local function copySpecularColor(c)
    if c == nil then
      return nil
    end
    local r = c.r or c[1]
    local g = c.g or c[2]
    local b = c.b or c[3]
    if type(r) ~= "number" or type(g) ~= "number" or type(b) ~= "number" then
      return c
    end
    return { r = r, g = g, b = b }
  end

  local material = {
    diffuse = sourceCustom.diffuse,
    normal = sourceCustom.normal,
    specular_intensity = sourceCustom.specular_intensity,
    specular_color = copySpecularColor(sourceCustom.specular_color),
    specular_sharpness = sourceCustom.specular_sharpness,
    fresnel_strength = sourceCustom.fresnel_strength,
  }

  local sc = material.specular_color
  local scStr = "?"
  if type(sc) == "table" then
    scStr = string.format("{r=%.3f, g=%.3f, b=%.3f}", sc.r or 0, sc.g or 0, sc.b or 0)
  end
  print(string.format(
    "[TEST BED] applyTableMaterialFrom source=%s\n  diffuse=%s\n  normal=%s\n  specular_intensity=%s\n  specular_color=%s\n  specular_sharpness=%s\n  fresnel_strength=%s",
    sourceTableKey,
    tostring(material.diffuse),
    tostring(material.normal),
    tostring(material.specular_intensity),
    scStr,
    tostring(material.specular_sharpness),
    tostring(material.fresnel_strength)
  ))

  local function applyToObject(obj, label)
    if obj == nil then
      print("[TEST BED]   SKIP missing object: " .. tostring(label))
      return false
    end
    if obj.getCustomObject == nil or obj.setCustomObject == nil or obj.reload == nil then
      print("[TEST BED]   SKIP not a custom object: " .. tostring(label))
      return false
    end
    local co = obj.getCustomObject()
    if type(co) ~= "table" then
      print("[TEST BED]   SKIP getCustomObject failed: " .. tostring(label))
      return false
    end
    co.diffuse = material.diffuse
    co.normal = material.normal
    co.specular_intensity = material.specular_intensity
    co.specular_color = material.specular_color
    co.specular_sharpness = material.specular_sharpness
    co.fresnel_strength = material.fresnel_strength
    obj.setCustomObject(co)
    obj.reload()
    print("[TEST BED]   OK " .. tostring(label))
    return true
  end

  local applied = 0
  local skipped = 0

  for tableKey, cfg in pairs(C.Tables) do
    if type(cfg) == "table" and type(cfg.guid) == "string" and cfg.guid ~= "" then
      if tableKey ~= sourceTableKey then
        if applyToObject(getObjectFromGUID(cfg.guid), "table:" .. tostring(tableKey)) then
          applied = applied + 1
        else
          skipped = skipped + 1
        end
      end
      if type(cfg.components) == "table" then
        for componentName, componentCfg in pairs(cfg.components) do
          if type(componentCfg) == "table" and type(componentCfg.guid) == "string" and componentCfg.guid ~= "" then
            local label = "component:" .. tostring(tableKey) .. "|" .. tostring(componentName)
            if applyToObject(getObjectFromGUID(componentCfg.guid), label) then
              applied = applied + 1
            else
              skipped = skipped + 1
            end
          end
        end
      end
    end
  end

  print(string.format(
    "[TEST BED] applyTableMaterialFrom done — applied=%d skipped=%d (source table body left unchanged)",
    applied,
    skipped
  ))
  return true
end

applyTableMaterialFrom("Table B1")

-- #endregion COPY TABLE MATERIAL (Custom Model)

