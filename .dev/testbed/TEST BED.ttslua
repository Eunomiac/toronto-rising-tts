-- #region HOT-PATCH DEBUG.printTable (no Save & Play)
-- Prefer core/debug after Save & Play. This region only reinstalls if DEBUG is already a table.
-- Note: this file also defines a different indent-based printTable() helper above; do not overwrite it.

if type(DEBUG) ~= "table" then
  DEBUG = {}
end

--- Pretty-print a table (or other value) to the TTS console.
-- @usage lua DEBUG.printTable({ a = 1 }, "smoke")
function DEBUG.printTable(value, label)
  local text
  if type(DEBUG.encodePretty) == "function" then
    text = DEBUG.encodePretty(value)
  elseif type(value) == "table" then
    text = JSON.encode_pretty(value)
    if text == nil then
      error("DEBUG.printTable: JSON.encode_pretty returned nil (unencodable table?)")
    end
  else
    text = tostring(value)
  end
  if type(label) == "string" and label ~= "" then
    print("[DEBUG.printTable] " .. label)
  end
  print(text)
  return text
end

print("[TEST BED] DEBUG.printTable hot-patched — try: lua DEBUG.printTable({ a = 1, nested = { b = true } }, \"smoke\")")
-- DEBUG.printTable({ a = 1, nested = { b = true } }, "smoke")

-- #endregion HOT-PATCH DEBUG.printTable (no Save & Play)

-- #region HOT-PATCH DEBUG.AnimateXML (no Save & Play)
-- Self-contained: select this region from the IDE to install, then select a call to run.
-- Uses global DEBUG + U.Lerp / U.chain / U.setAttribute (mod must already be loaded).
--
-- Ease names (same as U.Lerp / applyEase):
--   linear, powerIn, powerOut, powerInOut, sineIn, sineOut, sineInOut, back, bounce
--   speedUp  (U.Lerp-only legacy t²)
-- easeStrength is U.Lerp's easeIntensity (default 1). 0 = linear; 1 = standard; >1 = stronger
--   (power exponent, back overshoot, bounce count). Ignored by sine* except as a mix vs linear.

if type(DEBUG) ~= "table" then
  DEBUG = {}
end

--- Slide an XmlUI element from offsetXY 0 0 to 1000 0, then pause 1s and snap back.
-- `rate` is a frame stride: 0 or 1 writes XML every frame; 5 writes every fifth frame.
-- @param id string XmlUI element id
-- @param duration number Seconds for the slide
-- @param rate number Frames between XML writes (0 or 1 = every frame)
-- @param ease string Ease curve name (see region header)
-- @param easeStrength? number Optional ease intensity (default 1)
-- @usage DEBUG.AnimateXML("gameStateOverlay_timeAndLocation", 2, 1, "sineInOut", 1)
function DEBUG.AnimateXML(id, duration, rate, ease, easeStrength)
  if type(id) ~= "string" or id == "" then
    error("[DEBUG.AnimateXML] id must be a non-empty string")
  end
  if type(duration) ~= "number" or duration <= 0 then
    error("[DEBUG.AnimateXML] duration must be a positive number of seconds")
  end
  if rate == nil then
    rate = 1
  end
  if type(rate) ~= "number" or rate < 0 then
    error("[DEBUG.AnimateXML] rate must be a non-negative frame stride (0 or 1 = every frame)")
  end
  if ease == nil or ease == "" then
    ease = "sineInOut"
  end
  if type(ease) ~= "string" then
    error("[DEBUG.AnimateXML] ease must be a string (e.g. \"sineInOut\")")
  end
  if easeStrength == nil then
    easeStrength = 1
  end
  if type(easeStrength) ~= "number" then
    error("[DEBUG.AnimateXML] easeStrength must be a number (U.Lerp easeIntensity)")
  end
  if U == nil or type(U.Lerp) ~= "function" or type(U.chain) ~= "function" then
    error("[DEBUG.AnimateXML] U.Lerp / U.chain are not loaded — Save & Play the mod first")
  end

  local stride = 1
  if rate > 1 then
    stride = math.max(1, math.floor(rate + 0.5))
  end
  local endX = 1000

  DEBUG._animateXmlGen = (DEBUG._animateXmlGen or 0) + 1
  local gen = DEBUG._animateXmlGen
  local writeCount = 0
  local frameIndex = 0

  local function applyOffset(x)
    if DEBUG._animateXmlGen ~= gen then
      return
    end
    writeCount = writeCount + 1
    U.setAttribute(id, "offsetXY", string.format("%.2f 0", x))
  end

  local rateLabel
  if stride == 1 then
    rateLabel = "every frame"
  else
    rateLabel = string.format("every %d frames", stride)
  end

  U.chain({
    function()
      U.setAttributes(id, {
        active = "true",
        ignoreLayout = "true",
        rectAlignment = "MiddleLeft",
        offsetXY = "0 0",
      })
      print(string.format(
        "[DEBUG.AnimateXML] %s  0 0 → %d 0  over %.2fs  %s  ease=%s  strength=%.2f",
        id,
        endX,
        duration,
        rateLabel,
        ease,
        easeStrength
      ))
      return 0
    end,
    function()
      return U.Lerp(function(x)
        if DEBUG._animateXmlGen ~= gen then
          return
        end
        frameIndex = frameIndex + 1
        if (frameIndex - 1) % stride ~= 0 then
          return
        end
        applyOffset(x)
      end, 0, endX, duration, false, ease, easeStrength)
    end,
    function()
      applyOffset(endX)
      print(string.format(
        "[DEBUG.AnimateXML] at endpoint (%d XML writes). Holding 1s.",
        writeCount
      ))
      return 1
    end,
    function()
      if DEBUG._animateXmlGen ~= gen then
        return
      end
      U.setAttribute(id, "offsetXY", "0 0")
      print("[DEBUG.AnimateXML] reset to 0 0")
    end,
  }, { maxWait = math.max(60, duration + 5) })
end

print(
"[TEST BED] DEBUG.AnimateXML hot-patched — edit and run: DEBUG.AnimateXML(\"your_element_id\", 2, 1, \"sineInOut\", 1)")
UI.show("overlay_sessionStartSplash")
UI.setAttributes("overlay_sessionStartSplash", { scale = "1.5" })
