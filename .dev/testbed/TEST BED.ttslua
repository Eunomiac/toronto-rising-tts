--- Place the player 30 units above their default camera position, yaw toward the NPC on the horizon,
--- then switch to FirstPerson so they can pitch up manually.
--- @param player Player
--- @param npcPositionVector Vector|table
function lookAtNPC(player, npcPositionVector)
  local yCoord = 30
  local playerDefaultCameraPosition = C.ReferenceCameraAngles.default.position-- (clone player's "default" camera data from state)
  local cameraPosition = Vector(playerDefaultCameraPosition):setAt("y", yCoord)
  local npcPosition = Vector(npcPositionVector):setAt("y", yCoord)

  -- Same-height direction from eye toward NPC (Y cancels; heading is horizontal yaw).
  local headingVector = npcPosition - cameraPosition
  local yawAngle = U.cycle(headingVector:heading("y"), 0, 360)

  U.chain({
    function()
      player.lookAt({
        position = cameraPosition,
        pitch = 0,
        yaw = yawAngle
      })
      return 0.25
    end,
    function()
      player.setCameraMode("FirstPerson")
    end,
  })
end


player = Player.getPlayers()[1]
tableKey = "Table B0"
