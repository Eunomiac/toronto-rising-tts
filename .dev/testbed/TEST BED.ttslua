-- Define a function that prints to console the size of a given table
local function printTableSize(table)
  local size = 0
  for _ in pairs(table) do
    size = size + 1
  end
  print("Table size: " .. size)
end

printTableSize(D.genericNpcs)



-- #region HOT-PATCH DEBUG.explodeImage (no Save & Play)
-- Self-contained: select this region from the IDE to install, then select a call to run.

function RunIntroSequence(songDuration, isPlayingAudio)
  -- TTS showAnimation only retriggers after a document remount. Pair 1's caption
  -- panel is FadeIn + no animationDuration in XML Defaults; this function writes
  -- SlideIn_Left and a scaled duration. If those Lua attrs are still on the HUD
  -- (or the overlay is missing), remount and ask for a second Execute Code.

  startTime = os.time()
  songStartTime = 0

  if isTestingEnding == nil then
    isTestingEnding = false
  end
  do
    local canaryId = "overlay_characterIntroCaptionPanel_1"
    local overlayActive, showAnim, animDur
    if UI ~= nil and type(UI.getAttribute) == "function" then
      overlayActive = UI.getAttribute("overlay_sessionStart_panel", "active")
      showAnim = UI.getAttribute(canaryId, "showAnimation")
      animDur = UI.getAttribute(canaryId, "animationDuration")
    end
    local hudMissing = overlayActive == nil
    local hudDirty = showAnim == "SlideIn_Left"
      or (animDur ~= nil and tostring(animDur) ~= "")
    if hudMissing or hudDirty then
      if type(HUD_phaseRefreshXml) ~= "function" then
        error("RunIntroSequence: HUD_phaseRefreshXml is missing — Save & Play the mod first")
      end
      HUD_phaseRefreshXml()
      print("HUD refresh complete. Call RunIntroSequence again to start the animation.")
      return
    end
  end

  function playStartAudio()
    -- Intermission → Play audio only (same path as Advance). No cover / phase / lights.
    -- Requires the live Global bundle (Soundscape). No Save & Play for this snippet.
    -- Omit the key so Music C uses TR_SessionStart<sessionNum> from the catalog.
    if isPlayingAudio == false then
      print("playStartAudio: isPlayingAudio is false, skipping audio")
      return
    end
    if type(Soundscape) ~= "table" or type(Soundscape.stopFeaturedMusic) ~= "function" then
      error("playStartAudio: Soundscape is not loaded — Save & Play the mod first")
    end
    if type(Soundscape.playSessionIntro) ~= "function" then
      error("playStartAudio: Soundscape.playSessionIntro missing — Save & Play the mod first")
    end
    local fadeSec = 0.5
    local okStop, stopMsg = Soundscape.stopFeaturedMusic({
      fadeSeconds = fadeSec,
      resumeBackground = false,
    })
    if okStop ~= true then
      print("playStartAudio: Loop fade-out failed: " .. tostring(stopMsg))
    end
    local okPlay, playMsg = Soundscape.playSessionIntro(nil, { fadeSeconds = 0 })
    if okPlay ~= true then
      error("playStartAudio: " .. tostring(playMsg or "playSessionIntro failed"))
    end
    if type(Soundscape.commitEagerSteadyState) == "function" then
      Soundscape.commitEagerSteadyState(true)
    end
  end

  function resetStartAudio()
    if type(Soundscape) ~= "table" then
      error("resetStartAudio: Soundscape is not loaded — Save & Play the mod first")
    end
    if type(Soundscape.stopSessionIntro) == "function" then
      Soundscape.stopSessionIntro()
    end
    if type(Soundscape.stopAll) == "function" then
      Soundscape.stopAll()
    end
    if type(Soundscape.playFeaturedMusic) ~= "function" then
      error("resetStartAudio: Soundscape.playFeaturedMusic missing — Save & Play the mod first")
    end
    local key = "TR_Loop"
    if type(C) == "table" and type(C.IntermissionThemeFeaturedKey) == "string" and C.IntermissionThemeFeaturedKey ~= "" then
      key = C.IntermissionThemeFeaturedKey
    end
    local ok, msg = Soundscape.playFeaturedMusic(key, {
      incomingFadeSeconds = 2,
    })
    if ok ~= true then
      error("resetStartAudio: " .. tostring(msg or "playFeaturedMusic failed"))
    end
    if type(Soundscape.commitEagerSteadyState) == "function" then
      Soundscape.commitEagerSteadyState(true)
    end
  end

  function currentTime()
    if startTime == nil or startTime == 0 then
      startTime = os.time()
    end
    local elapsed = os.time() - startTime
    -- Round to two decimal places
    return math.floor((elapsed * 100) + 0.5) / 100
  end

  function currentSongTime()
    if songStartTime == nil or songStartTime == 0 then
      songStartTime = os.time()
    end
    local elapsed = os.time() - songStartTime
    -- Round to two decimal places
    return math.floor((elapsed * 100) + 0.5) / 100
  end

  function runNumTitleSequence(sequencePrefix, sequenceSuffix, timeRatio, sessionNum)
    -- local containerPanelID = sequencePrefix .. "Panel_" .. sequenceSuffix
    local numTitleSequenceDuration = 10 * timeRatio

    local containerID = sequencePrefix .. "Panel_" .. sequenceSuffix
    local bgPanelID = sequencePrefix .. "BgPanel"
    local bgImageID = sequencePrefix .. "_bg"
    local imagePanelID = sequencePrefix .. "ImagePanel"
    local imageID = sequencePrefix
    local imageRef = sequencePrefix .. "_" .. sessionNum

    local FULL_DURATION = 40 * timeRatio
    local LEAD_IN_BG_GROW_DURATION = 20 * timeRatio
    local LEAD_IN_BG_IMAGE_DURATION = 27 * timeRatio
    local LEAD_IN_TEXT_GROW_DURATION = 27 * timeRatio
    local LEAD_IN_TEXT_IMAGE_DURATION = 27 * timeRatio
    local BG_GROW_DURATION_EXTRA = 16 * timeRatio
    local IMAGE_GROW_DURATION_EXTRA = 8 * timeRatio

    local bgPanelGrowthDuration = FULL_DURATION - LEAD_IN_BG_GROW_DURATION + BG_GROW_DURATION_EXTRA
    local bgPanelStartDelay = LEAD_IN_BG_GROW_DURATION
    local bgImageFadeInDuration = 0.5
    local bgImageStartDelay = LEAD_IN_BG_IMAGE_DURATION

    local imagePanelGrowthDuration = FULL_DURATION - LEAD_IN_TEXT_GROW_DURATION + IMAGE_GROW_DURATION_EXTRA
    local imagePanelStartDelay = LEAD_IN_TEXT_GROW_DURATION
    local imageFadeInDuration = 0.5
    local imageStartDelay = LEAD_IN_TEXT_IMAGE_DURATION



    UI.setAttributes(containerID, {
      color = "rgba(0, 0, 0, 0)",
      scale = "5",
      active = "true",
      hideAnimation = "FadeOut",
      animationDuration = 1
    })
    UI.setAttributes(bgPanelID, {
      active = "true",
      color = "rgba(0, 0, 0, 0)",
      scale = "1",
      showAnimation = "Grow",
      showAnimationDelay = bgPanelStartDelay,
      animationDuration = bgPanelGrowthDuration,
    })
    UI.setAttributes(bgImageID, {
      active = "false",
      scale = "3",
      showAnimation = "FadeIn",
      showAnimationDelay = bgImageStartDelay,
      hideAnimation = "FadeOut",
      animationDuration = bgImageFadeInDuration,
    })
    UI.setAttributes(imagePanelID, {
      active = "true",
      color = "rgba(0, 0, 0, 0)",
      scale = "1",
      showAnimation = "Grow",
      showAnimationDelay = imagePanelStartDelay,
      animationDuration = imagePanelGrowthDuration,
    })
    UI.setAttributes(imageID, {
      active = "false",
      scale = "1",
      showAnimation = "FadeIn",
      hideAnimation = "FadeOut",
      animationDuration = imageFadeInDuration,
      showAnimationDelay = imageStartDelay,
      image = imageRef
    })

    local chainFunctions = {
      function()
        print("SHOW Num Title Sequence " .. sequenceSuffix .. " at t: " .. currentTime() .. " (song time: " .. currentSongTime() .. ")")
        UI.show(containerID)
        UI.show(bgImageID)
        UI.show(imageID)
        return numTitleSequenceDuration
      end
    }

    if sequenceSuffix == "7" then
      table.insert(chainFunctions, function()
        local delayTime = (FULL_DURATION - numTitleSequenceDuration) * 0.95
        print("DELAYING Overlay Hide Num Title Sequence " .. sequenceSuffix .. " by " .. delayTime .. " at t: " .. currentTime() .. " (song time: " .. currentSongTime() .. ")")
        return delayTime
      end)
      table.insert(chainFunctions, function()
        print("HIDE Entire Overlay at t: " .. currentTime() .. " (song time: " .. currentSongTime() .. ")")
        UI.show("overlay_sessionStart_blackoutPanel")
        return 1.5
      end)
      table.insert(chainFunctions, function()
        UI.setAttribute("overlay_sessionStart_panel", "active", "false")
        return 0.5
      end)
      table.insert(chainFunctions, function()
        UI.hide("overlay_sessionStart_blackoutPanel")
        return 1
      end)
      table.insert(chainFunctions, function()
        HUD_phaseRefreshXml()
        return
      end)
    end

    U.chain(chainFunctions, { maxWait = 1000 })
  end

-- local thisTimeRatio = 1
-- startTime = os.time()
-- songStartTime = os.time()
-- U.chain({
--   function()
--     runNumTitleSequence("overlay_sessionNumber", "6", thisTimeRatio, 1)
--     return 10 * thisTimeRatio
--   end,
--   function()
--     runNumTitleSequence("overlay_sessionTitle", "7", thisTimeRatio, 1)
--     return 10 * thisTimeRatio
--   end
-- })


  function runCharacterSequence(sequenceNumber, timeRatio)
    local textPanelID = "overlay_characterIntroCaptionPanel_" .. sequenceNumber
    local imagePanelID = "overlay_characterIntroImagePanel_" .. sequenceNumber
    local textID = "overlay_characterIntroCaption_" .. sequenceNumber
    local imageID = "overlay_characterIntroImage_" .. sequenceNumber

    local textPanelData = {
      [1] = {
        showAnimation = "SlideIn_Left",
        offsetXY = "900 0",
        scale = "1"
      },
      [2] = {
        showAnimation = "Grow",
        offsetXY = "0 0",
        scale = "0.9"
      },
      [3] = {
        showAnimation = "Grow",
        offsetXY = "0 0",
        scale = "0.9"
      },
      [4] = {
        showAnimation = "SlideIn_Right",
        offsetXY = "-900 0",
        scale = "1"
      },
      [5] = {
        showAnimation = "SlideIn_Bottom",
        offsetXY = "0 500",
        scale = "1"
      }
    }

    UI.setAttributes(textPanelID, {active = "false", showAnimation = textPanelData[sequenceNumber].showAnimation, animationDuration = 60 * timeRatio})
    UI.setAttributes(textID, {active = "true", showAnimation = "FadeIn", showAnimationDelay = 34 * timeRatio, animationDuration = 4, hideAnimation = "FadeOut", hideAnimationDelay = 0, offsetXY = textPanelData[sequenceNumber].offsetXY, scale = textPanelData[sequenceNumber].scale})
    UI.setAttributes(imagePanelID, {active = "false", showAnimation = "Grow", animationDuration = 35 * timeRatio})
    UI.setAttributes(imageID, {active = "true", showAnimation = "FadeIn", showAnimationDelay = 27 * timeRatio, animationDuration = 0.5, scale = "1", hideAnimationDelay = 1.5, hideAnimation = "FadeOut"})

    U.chain({
      function()
        print("SHOW Character Sequence " .. sequenceNumber .. " at t: " .. currentTime() .. (isSongStarted and " (song time: " .. currentSongTime() .. ")" or ""))
        UI.show(textPanelID)
        UI.show(imagePanelID)
        if sequenceNumber == 1 then
          -- timeRatio 0 (songDuration shorter than the unscalable tail) skips Music C.
          if timeRatio > 0 then
            U.await(function()
              songStartTime = os.time()
              isSongStarted = true
              print("PLAY START AUDIO at t: " .. currentTime())
              playStartAudio()
            end, startAudioDelay * timeRatio)
          end
        end
        return 31 * timeRatio
      end,
      function()
        print("HIDE TEXT Character Sequence " .. sequenceNumber .. " at t: " .. currentTime() .. " (song time: " .. currentSongTime() .. ")")
        UI.hide(textID)
      end
    })
  end

  function runSequences(timeRatio, characterSequences)
    if timeRatio == nil then
      timeRatio = 1
    end
    local characterSequenceDuration = 20 * timeRatio
    -- Number/title keep a floor so Quick Transition (timeRatio 0) still plays the tail.
    local numTitleSequenceMaxDuration = 10
    local numTitleSequenceMinDuration = 0
    local numTitleSequenceScalableDuration = numTitleSequenceMaxDuration - numTitleSequenceMinDuration
    local numTitleSequenceDuration = (numTitleSequenceScalableDuration * timeRatio) + numTitleSequenceMinDuration
    local numTitleSequenceTimeRatio = numTitleSequenceDuration / 10
    if characterSequences == nil then
      characterSequences = {1, 2, 3, 4, 5}
    end
    local chainFunctions = {}

    if isTestingEnding then
      table.insert(chainFunctions, function()
        runCharacterSequence(5, timeRatio)
        return characterSequenceDuration
      end)
    else
      for _, characterSequence in ipairs(characterSequences) do
        table.insert(chainFunctions, function()
          runCharacterSequence(characterSequence, timeRatio)
          return characterSequenceDuration
        end)
      end
    end

    table.insert(chainFunctions, function()
        runNumTitleSequence("overlay_sessionNumber", "6", numTitleSequenceTimeRatio, 1)
        return numTitleSequenceDuration
      end)
    table.insert(chainFunctions, function()
        runNumTitleSequence("overlay_sessionTitle", "7", numTitleSequenceTimeRatio, 1)
        return numTitleSequenceDuration
      end)

    U.chain(chainFunctions, {maxWait = 1000})
  end

  function runIntroSequenceStandalone(songDur)
    isSongStarted = false
    startTime = os.time()
    songStartTime = 0
    -- Overlay starts hidden after a previous run (UI.hide at title end). Show it
    -- before any character UI.show or showAnimation never has a visible parent.
    UI.show("overlay_sessionStart_panel")
    UI.hide("adminControls")
    UI.hide("panel_STcamera")

    -- Measured at timeRatio = 1:
    local unscaledFullDuration = 148.4 -- total animation length
    local unscalableTime = 1 -- residual length when all * timeRatio terms are zeroed
    local songStartDelay = 27 -- lead-in before audio; also scales as songStartDelay * timeRatio
    startAudioDelay = songStartDelay

    if songDur == nil then
      runSequences(1)
      return
    end

    -- With ratio r:
    --   animEnds(r)  = unscalableTime + r * (unscaledFullDuration - unscalableTime)
    --   songStarts(r)= r * songStartDelay
    --   songEnds(r)  = r * songStartDelay + songDur
    -- Want songEnds(r) == animEnds(r):
    --   songDur - unscalableTime
    --     = r * ((unscaledFullDuration - unscalableTime) - songStartDelay)
    --   r = (songDur - unscalableTime)
    --       / ((unscaledFullDuration - songStartDelay) - unscalableTime)
    --
    -- Denominator intuition: at r=1, song-to-end window is (140.7 - 27) = 113.7;
    -- of that, 15.5 is fixed, so only 98.2 scales with r.
    local scalableSongWindow = (unscaledFullDuration - songStartDelay) - unscalableTime
    if scalableSongWindow <= 0 then
      error("runIntroSequence: scalable song window must be > 0")
    end
    local timeRatio
    if songDur < unscalableTime then
      -- Same as production Quick Transition: timeRatio 0 (unscalable tail only).
      timeRatio = 0
    else
      timeRatio = (songDur - unscalableTime) / scalableSongWindow
    end
    print(
      "runIntroSequence: songDur="
        .. tostring(songDur)
        .. " timeRatio="
        .. tostring(timeRatio)
        .. " animEnds="
        .. tostring(unscalableTime + timeRatio * (unscaledFullDuration - unscalableTime))
        .. " songEnds="
        .. tostring(timeRatio * songStartDelay + songDur)
    )
    runSequences(timeRatio)
  end
  runIntroSequenceStandalone(songDuration)
end

-- First Execute Code remounts if the HUD still has leftover Lua attrs; second starts the splash.
-- Duration comes from the current session's catalog track when Soundscape is loaded.
local function sessionIntroDurationForTestBed()
  if type(Soundscape) ~= "table" or type(Soundscape.describeSessionIntro) ~= "function" then
    return nil
  end
  local diag = Soundscape.describeSessionIntro()
  local dur = type(diag) == "table" and tonumber(diag.catalogDuration) or nil
  if dur ~= nil and dur > 0 then
    return dur
  end
  return nil
end
RunIntroSequence(sessionIntroDurationForTestBed())

DEBUG.resetToIntermission()
HUD_phaseRefreshXml()
