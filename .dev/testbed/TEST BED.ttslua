U.chain({
    function() print("Diagnostic stagger started"); return 0.12 end,
    function() print("Diagnostic stagger completed"); return 0 end
})

function DiagnoseComplicationsLocks()
  local g = S.getStateVal("complications")
  if not g then print("No active Complications game"); return end

  local lines = {}
  local function add(text) lines[#lines + 1] = text end
  local function value(v) return tostring(v) end
  local function object(guid)
      if type(guid) ~= "string" or guid == "" then return nil end
      return getObjectFromGUID(guid)
  end
  local function describe(o)
      if not o then return "NOT FOUND" end
      return "guid=" .. o.getGUID()
          .. " type=" .. value(o.tag)
          .. " locked=" .. value(o.getLock())
          .. " interactable=" .. value(o.interactable)
          .. " faceDown=" .. value(o.is_face_down)
          .. " spawning=" .. value(o.spawning)
          .. " loading=" .. value(o.loading_custom)
  end

  add("=== Complications lock diagnostic ===")
  add("mode=" .. value(g.mode)
      .. " hidden=" .. value(g.hidden)
      .. " exhausted=" .. value(g.exhausted)
      .. " ending=" .. value(g.ending))
  add("step=" .. value(g.operationIndex)
      .. " operations=" .. #g.operations
      .. " error=" .. value(g.error))
  add("participant=" .. value(g.target and g.target.color)
      .. " selected=" .. value(g.selected))

  local zones = {}
  for _, card in pairs(g.cards or {}) do
      local zone = card.zone or "unknown"
      zones[zone] = (zones[zone] or 0) + 1
  end
  for zone, count in pairs(zones) do
      add("Saved cards in " .. zone .. ": " .. count)
  end

  add("playClone=" .. value(g.playClone)
      .. " -> " .. describe(object(g.playClone)))
  for zone, guid in pairs(g.pileGuids or {}) do
      add("Tracked " .. zone .. "=" .. value(guid)
          .. " -> " .. describe(object(guid)))
  end

  for i = 1, 10 do
      local guid = g.slots[i] or g.slots[tostring(i)]
      local card = guid and g.cards[guid]
      add("Slot " .. i .. " savedGUID=[" .. value(guid) .. "]")
      if card then
          add("  zone=" .. value(card.zone)
              .. " up=" .. value(card.up)
              .. " enhanced=" .. value(card.enhanced)
              .. " clone=" .. value(card.clone))
          local visibleGuid = card.enhanced and card.clone or guid
          add("  visible: " .. describe(object(visibleGuid)))
      else
          add("  NO SAVED CARD RECORD")
      end
  end

  local b = getObjectFromGUID(G.GUIDS.COMPLICATIONS_BOARD)
  add("Board: " .. describe(b))
  if b then
      add("Board button text="
          .. value(b.UI.getAttribute("button_StopSelect", "text")))
  end

  print(table.concat(lines, "\n"))
end

DiagnoseComplicationsLocks()

-- #region scene-stall-isolation
-- Register this function once with Execute Code, then run one commented example at a time.
-- Stop after the first action whose HEARTBEAT 0 or HEARTBEAT 250 line is delayed by the hang.
-- Every action except the production Scatter move re-applies the current saved intent; it does
-- not change scenes or move a player to a different group.
function SceneStallProbe(action, pcKey)
  local spec = {}
  if type(pcKey) == "string" and pcKey ~= "" then
    spec.pcKey = pcKey
  end
  local result = DEBUG.sceneStallProbe(action, spec)
  print(DEBUG.encodePretty(result))
  return result
end

-- Run these first. A delayed baseline means the table is already busy before a probe begins.
