-- #region hand-park-watch
--- Isolated hand-mover test: calls U.movePlayerHand directly (no seat layout, no transition,
--- no connection change), then watches every moved card for `frames` frames and prints each
--- time a card's lock, Y, hand membership or tag changes. Use to see whether TTS itself undoes
--- the park/unpark after the function returns, and on which frame.
---   mode "park"   — move the hand zone straight to parkY at its current X/Z (remembers the pose)
---   mode "unpark" — move it back to the pose remembered by the last "park" for that color
function HandParkWatch(color, mode, opts)
  opts = type(opts) == "table" and opts or {}
  mode = mode or "park"
  local frames = opts.frames or 90
  local parkY = opts.parkY or 200
  HandParkWatchPoses = HandParkWatchPoses or {}

  local function fmt(v)
    return string.format("(%.2f, %.2f, %.2f)", v.x, v.y, v.z)
  end

  local function handGuidSet()
    local set = {}
    local player = Player[color]
    if player ~= nil and player.getHandObjects ~= nil then
      for _, o in ipairs(player.getHandObjects() or {}) do
        set[o.getGUID()] = true
      end
    end
    return set
  end

  local function snapshot(card, inHand)
    local p = card.getPosition()
    return {
      locked = card.getLock() == true,
      y = p.y,
      pos = p,
      inHand = inHand[card.getGUID()] == true,
      tagged = card.hasTag("LockedCard" .. color),
    }
  end

  local function describe(s)
    return string.format("locked=%s inHand=%s tagged=%s pos=%s",
      tostring(s.locked), tostring(s.inHand), tostring(s.tagged), fmt(s.pos))
  end

  local hz = U.getHandZone(color)
  if hz == nil then
    print("[HandParkWatch] no hand zone for " .. tostring(color))
    return
  end

  local target, rot
  if mode == "park" then
    local p = hz.getPosition()
    HandParkWatchPoses[color] = { position = Vector(p), rotation = Vector(hz.getRotation()) }
    target = Vector({ x = p.x, y = parkY, z = p.z })
    rot = Vector(hz.getRotation())
  elseif mode == "unpark" then
    local saved = HandParkWatchPoses[color]
    if saved == nil then
      print("[HandParkWatch] no remembered pose for " .. color .. " — run a \"park\" first")
      return
    end
    target = saved.position
    rot = saved.rotation
  else
    print("[HandParkWatch] mode must be \"park\" or \"unpark\"")
    return
  end

  local moved = U.movePlayerHand(color, target, rot, "TEST BED " .. mode)
  local cards = moved.cards or {}

  local last = {}
  local lines = { string.format("=== HandParkWatch %s %s — %d card(s) moved; zone now %s ===",
    color, mode, #cards, fmt(hz.getPosition())) }
  local inHand = handGuidSet()
  for _, card in ipairs(cards) do
    local s = snapshot(card, inHand)
    last[card.getGUID()] = s
    lines[#lines + 1] = string.format("  frame 0  %s  %s", card.getGUID(), describe(s))
  end
  print(table.concat(lines, "\n"))

  local frame = 0
  local function tick()
    frame = frame + 1
    local changes = {}
    local held = handGuidSet()
    for _, card in ipairs(cards) do
      if card ~= nil and not card.isDestroyed() then
        local g = card.getGUID()
        local s = snapshot(card, held)
        local prev = last[g]
        if prev == nil or s.locked ~= prev.locked or s.inHand ~= prev.inHand or s.tagged ~= prev.tagged
          or math.abs(s.y - prev.y) > 0.25 then
          changes[#changes + 1] = string.format("  frame %d  %s  %s", frame, g, describe(s))
        end
        last[g] = s
      end
    end
    if #changes > 0 then
      print(table.concat(changes, "\n"))
    end
    if frame < frames then
      Wait.frames(tick, 1)
    else
      print(string.format("=== HandParkWatch %s %s — done after %d frames (no line = no change) ===", color, mode, frames))
    end
  end
  Wait.frames(tick, 1)
end

