-- #region catalogued-npc-figurines
function DumpCataloguedNpcFigurines(zones, isPrintingToFile, path)
  -- Dump live catalogued NPC figurines (NPCS.characters) to a Lua table file, indexed by GUID.
  -- Also stores the table on the global NpcFigurineCatalogDump for the copy helper below.
  if isPrintingToFile == nil then
    isPrintingToFile = true
  end
  if zones == nil then
    zones = { "preload", "stage" }
  end
  local CONFIG = {
    defaultPath = "debug_logs/catalogued_npc_figurines.lua",
    preloadYMax = -150,
  }

  local function luaQuote(s)
    s = tostring(s or "")
    s = string.gsub(s, "\\", "\\\\")
    s = string.gsub(s, "\"", "\\\"")
    s = string.gsub(s, "\r", "\\r")
    s = string.gsub(s, "\n", "\\n")
    s = string.gsub(s, "\t", "\\t")
    return '"' .. s .. '"'
  end

  local function encodeScalar(value)
    local t = type(value)
    if t == "nil" then
      return "nil"
    end
    if t == "boolean" then
      if value then
        return "true"
      end
      return "false"
    end
    if t == "number" then
      return tostring(value)
    end
    return luaQuote(value)
  end

  local FIELD_ORDER = { "guid", "key", "fullName", "inPreloadZone", "lightingMode" }

  local function encodeRow(row, indent)
    local pad = string.rep("  ", indent)
    local inner = string.rep("  ", indent + 1)
    local parts = { "{\n" }
    for i = 1, #FIELD_ORDER do
      local field = FIELD_ORDER[i]
      parts[#parts + 1] = inner .. field .. " = " .. encodeScalar(row[field]) .. ",\n"
    end
    parts[#parts + 1] = pad .. "}"
    return table.concat(parts)
  end

  local function encodeDump(byGuid)
    local guids = {}
    for guid in pairs(byGuid) do
      guids[#guids + 1] = guid
    end
    table.sort(guids)
    local parts = {
      "-- Catalogued NPC figurines (NPCS.characters with a live figurine).\n",
      "-- Generated by DumpCataloguedNpcFigurines.\n",
      "NpcFigurineCatalogDump = {\n",
    }
    for i = 1, #guids do
      local guid = guids[i]
      parts[#parts + 1] = "  [" .. luaQuote(guid) .. "] = " .. encodeRow(byGuid[guid], 1) .. ",\n"
    end
    parts[#parts + 1] = "}\n"
    return table.concat(parts)
  end

  local function displayNameFor(key, fig)
    local def = NPCS.characters and NPCS.characters[key]
    if type(def) == "table" and type(def.fullName) == "string" and def.fullName ~= "" then
      return def.fullName
    end
    if type(DEBUG) == "table" and type(DEBUG.objectDisplayName) == "function" then
      local n = DEBUG.objectDisplayName(fig)
      if type(n) == "string" and n ~= "" then
        return n
      end
    end
    if fig ~= nil and fig.getName ~= nil then
      local n = tostring(fig.getName() or "")
      if n ~= "" then
        return n
      end
    end
    return tostring(key or "")
  end

  local function lightingModeFor(rec)
    if type(rec) ~= "table" then
      return ""
    end
    local mode = rec.npcLightMode
    if type(rec.lightGuid) == "string" and rec.lightGuid ~= "" then
      local applied = S.getStateVal("lights", NPCS.lightRegistryName(rec.lightGuid))
      if type(applied) == "string" and applied ~= "" then
        mode = applied
      end
    end
    if type(mode) == "string" then
      return mode
    end
    return ""
  end

  local function inPreloadZoneFor(rec, fig)
    if type(rec) == "table" then
      return rec.areaKey == NPCS.PRELOAD_AREA_KEY
    end
    if fig == nil or fig.getPosition == nil then
      return false
    end
    local pos = fig.getPosition()
    local y = pos and tonumber(pos.y)
    return y ~= nil and y <= CONFIG.preloadYMax
  end

  local function addRow(byGuid, fig, key, rec)
    local inPreloadZone = inPreloadZoneFor(rec, fig)
    local function tableContains(tbl, val)
      for i = 1, #tbl do
        if tbl[i] == val then return true end
      end
      return false
    end
    if inPreloadZone and not tableContains(zones, "preload") then
      return
    end
    if not inPreloadZone and not tableContains(zones, "stage") then
      return
    end
    if fig == nil or fig.getGUID == nil then
      return
    end
    local guid = tostring(fig.getGUID() or "")
    if guid == "" or byGuid[guid] ~= nil then
      return
    end
    byGuid[guid] = {
      guid = guid,
      key = tostring(key or ""),
      fullName = displayNameFor(key, fig),
      inPreloadZone = inPreloadZoneFor(rec, fig),
      lightingMode = lightingModeFor(rec),
    }
  end

  local catalog = NPCS.characters
  if type(catalog) ~= "table" then
    error("DumpCataloguedNpcFigurines: NPCS.characters is missing — Save & Play first")
  end

  local byGuid = {}
  local catalogCount = 0
  local missingFig = 0
  for key, def in pairs(catalog) do
    if type(key) == "string" and type(def) == "table" then
      catalogCount = catalogCount + 1
      local rec = NPCS.getInstanceRecord(key)
      local fig = nil
      if type(rec) == "table" and type(rec.figurineGuid) == "string" and rec.figurineGuid ~= "" then
        fig = G.getObject(rec.figurineGuid)
      end
      if fig ~= nil then
        addRow(byGuid, fig, key, rec)
      else
        missingFig = missingFig + 1
      end
    end
  end

  local tagged = getObjectsWithTag("npc_figurine") or {}
  for i = 1, #tagged do
    local fig = tagged[i]
    if NPCS.isPooledFigurineObject(fig) then
      local key = NPCS.resolveNpcNameFromFigurine(fig)
      if type(key) == "string" and catalog[key] ~= nil then
        addRow(byGuid, fig, key, NPCS.getInstanceRecord(key))
      end
    end
  end

  local liveCount = 0
  local preloadCount = 0
  for _, row in pairs(byGuid) do
    liveCount = liveCount + 1
    if row.inPreloadZone == true then
      preloadCount = preloadCount + 1
    end
  end

  NpcFigurineCatalogDump = byGuid

  local outPath = path
  if type(outPath) ~= "string" or outPath == "" then
    outPath = CONFIG.defaultPath
  end
  local body = encodeDump(byGuid)
  if isPrintingToFile then
    DEBUG.writeWorkspaceFile(outPath, body, "none", false)
  else
    print(string.format(
      "[DumpCataloguedNpcFigurines] catalog=%d live=%d missingFig=%d inPreload=%d -> .dev/.debug/%s",
      catalogCount, liveCount, missingFig, preloadCount, outPath
    ))
    return byGuid
  end
end
-- #endregion catalogued-npc-figurines

-- #region setFigurineHeight
function setFigurineHeight(zones, height)
  -- his function takes the return value from DumpCataloguedNpcFigurines and sets the y-value of each figurine's position to the given value.
  if zones == nil then
    zones = { "stage" }
  end
  for guid, rec in pairs(DumpCataloguedNpcFigurines(zones, false)) do
    local fig = G.getObject(guid)
    if fig ~= nil then
      fig.setPosition({fig.getPosition().x, height, fig.getPosition().z})
    end
  end
end

setFigurineHeight({"stage"}, -65)
