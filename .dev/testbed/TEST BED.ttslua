-- #region storyteller-trays
function ShowStorytellerDiceTrays()
  local SLOT_KEYS = {
    [1] = "DICE_DRAWER_STORYTELLER_1",
    [2] = "DICE_DRAWER_STORYTELLER_2",
    [3] = "DICE_DRAWER_STORYTELLER_3",
  }
  local LIGHT_REFS = {
    [1] = "storytellerDiceLight1",
    [2] = "storytellerDiceLight2",
    [3] = "storytellerDiceLight3",
  }

  local function currentTable()
    local key = S.getStateVal("seatLayout", "currentTableKey")
    if type(key) ~= "string" or C.Tables[key] == nil then
      key = "Table A"
    end
    return key, C.Tables[key]
  end

  local function layoutEntry(tableCfg, guid)
    local entries = type(tableCfg) == "table" and tableCfg.objectPositions or nil
    if type(entries) ~= "table" or type(guid) ~= "string" then
      return nil
    end
    for i = 1, #entries do
      local entry = entries[i]
      if type(entry) == "table" and entry.guid == guid then
        return entry
      end
    end
    return nil
  end

  local function revealedY(slot)
    local entry = C.ObjectPositions[SLOT_KEYS[slot]]
    local pos = type(entry) == "table" and type(entry.on) == "table" and entry.on.position or nil
    local y = type(pos) == "table" and tonumber(pos.y) or nil
    if y == nil then
      return -0.64
    end
    return y
  end

  local function snapLight(slot, x, z)
    local data = type(L.LIGHTMODES) == "table" and L.LIGHTMODES[LIGHT_REFS[slot]] or nil
    local guid = type(data) == "table" and data.guid or nil
    local light = type(guid) == "string" and G.getObject(guid) or nil
    if light == nil then
      return
    end
    local pos = light.getPosition()
    if pos == nil or type(pos.y) ~= "number" then
      return
    end
    light.setPosition({ x = x, y = pos.y, z = z })
  end

  local tableKey, tableCfg = currentTable()
  if type(tableCfg) == "table" and tableCfg.shape == C.TableShapes.SCATTER then
    print("[TestBed] " .. tableKey .. " has no Storyteller tray homes. Switch to a normal table first.")
    return
  end

  print("[TestBed] Placing Storyteller trays for " .. tostring(tableKey))
  for slot = 1, 3 do
    local guid = G.GetStorytellerDiceDrawerGUID(slot)
    local obj = type(guid) == "string" and G.getObject(guid) or nil
    local entry = layoutEntry(tableCfg, guid)
    local partial = type(entry) == "table" and entry.position or nil
    local rot = type(entry) == "table" and entry.rotation or nil
    if obj == nil or type(partial) ~= "table" or type(partial.x) ~= "number" or type(partial.z) ~= "number" then
      print("[TestBed] Slot " .. tostring(slot) .. " is missing its tray or this table's X/Z.")
    else
      local position = { x = partial.x, y = revealedY(slot), z = partial.z }
      local rotation = {
        x = type(rot) == "table" and (tonumber(rot.x) or 0) or 0,
        y = type(rot) == "table" and (tonumber(rot.y) or 0) or 0,
        z = type(rot) == "table" and (tonumber(rot.z) or 0) or 0,
      }
      O.restoreObject(obj, {
        position = position,
        rotation = rotation,
        locked = true,
        interactable = false,
      })
      snapLight(slot, position.x, position.z)
      print(string.format(
        "[TestBed] Tray %d (%s) at x=%.2f y=%.2f z=%.2f",
        slot,
        guid,
        position.x,
        position.y,
        position.z
      ))
    end
  end
end

ShowStorytellerDiceTrays()
