-- #endregion
-- #region time-save-decode
--- Times JSON.encode / JSON.decode of the Global save state while the table is idle.
--- Reports both os.clock and os.time so a CPU-time clock would show up as a mismatch.
function TimeSaveDecode(repeats)
  repeats = tonumber(repeats) or 1
  local results = {}

  local function timed(label, fn)
    local clock0, wall0 = os.clock(), os.time()
    local value = fn()
    results[#results + 1] = string.format(
      "[TimeSaveDecode] %s: os.clock %.3fs, os.time %ds",
      label,
      os.clock() - clock0,
      os.time() - wall0
    )
    return value
  end

  local saveText = timed("JSON.encode (save state)", function()
    return JSON.encode(S.getGameState(true))
  end)
  results[#results + 1] = string.format("[TimeSaveDecode] save text: %d chars", #saveText)

  for i = 1, repeats do
    timed(string.format("JSON.decode (save state) run %d", i), function()
      return JSON.decode(saveText)
    end)
  end

  local steps = {}
  for i = 1, #results do
    local line = results[i]
    steps[#steps + 1] = function()
      print(line)
    end
  end
  U.chain(steps)
end
