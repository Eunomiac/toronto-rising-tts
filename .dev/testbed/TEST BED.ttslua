-- #region XML

--- Prefer DEBUG helpers (Save & Play loads core/debug). Thin aliases keep region Execute working.
local function prettyPrintXml(rawXml)
  if DEBUG ~= nil and type(DEBUG.prettyPrintXml) == "function" then
    return DEBUG.prettyPrintXml(rawXml)
  end
  return rawXml or ""
end

local function objectDisplayName(obj)
  if DEBUG ~= nil and type(DEBUG.objectDisplayName) == "function" then
    return DEBUG.objectDisplayName(obj)
  end
  return "(unnamed)"
end

--- Read an object's **runtime** UI XML (`object.UI.getXml()`), pretty-print, write under `.dev/.debug/`.
--- Prefer: `lua DEBUG.dumpObjectXmlToFile("802d14")` after Save & Play.
--- @param objectGuid string Object GUID
--- @param relativePath string|nil
--- @return boolean ok
function dumpObjectXmlToFile(objectGuid, relativePath)
  if DEBUG ~= nil and type(DEBUG.dumpObjectXmlToFile) == "function" then
    return DEBUG.dumpObjectXmlToFile(objectGuid, relativePath)
  end
  print("dumpObjectXmlToFile: DEBUG.dumpObjectXmlToFile missing — Save & Play first")
  return false
end

dumpObjectXmlToFile("c0f4b5")
--- Sanitize an element id for debug_logs filenames.
--- @param value string
--- @return string
local function sanitizeUiDumpPathSegment(value)
  return tostring(value):gsub("[^%w_%-]", "_")
end

local function xmlEscapeAttr(value)
  return tostring(value):gsub("&", "&amp;"):gsub('"', "&quot;"):gsub("<", "&lt;")
end

local function xmlEscapeText(value)
  return tostring(value):gsub("&", "&amp;"):gsub("<", "&lt;"):gsub(">", "&gt;")
end

local function sortedAttributeKeys(attrs)
  local keys = {}
  if type(attrs) ~= "table" then
    return keys
  end
  for key in pairs(attrs) do
    keys[#keys + 1] = key
  end
  table.sort(keys, function(a, b)
    return tostring(a) < tostring(b)
  end)
  return keys
end

local function xmlNodeToPretty(node, indent)
  indent = indent or 0
  if type(node) ~= "table" then
    return string.rep("  ", indent) .. tostring(node)
  end
  local tag = node.tag or "Unknown"
  local attrParts = {}
  for _, key in ipairs(sortedAttributeKeys(node.attributes)) do
    attrParts[#attrParts + 1] = tostring(key) .. '="' .. xmlEscapeAttr(node.attributes[key]) .. '"'
  end
  local attrStr = table.concat(attrParts, " ")
  local pad = string.rep("  ", indent)
  local openTag = pad .. "<" .. tag .. (attrStr ~= "" and (" " .. attrStr) or "")
  local children = node.children
  local value = node.value
  local hasChildren = type(children) == "table" and #children > 0
  local hasValue = value ~= nil and tostring(value) ~= ""
  if not hasChildren and not hasValue then
    return openTag .. " />"
  end
  local lines = { openTag .. ">" }
  if hasValue then
    lines[#lines + 1] = pad .. "  " .. xmlEscapeText(value)
  end
  if hasChildren then
    for childIndex = 1, #children do
      lines[#lines + 1] = xmlNodeToPretty(children[childIndex], indent + 1)
    end
  end
  lines[#lines + 1] = pad .. "</" .. tag .. ">"
  return table.concat(lines, "\n")
end

local function findXmlTableNodeById(nodes, elementId)
  if type(nodes) ~= "table" then
    return nil
  end
  local list = nodes.tag and { nodes } or nodes
  for index = 1, #list do
    local node = list[index]
    if type(node) == "table" then
      local attrs = node.attributes
      if type(attrs) == "table" and tostring(attrs.id) == elementId then
        return node
      end
      if type(node.children) == "table" then
        local found = findXmlTableNodeById(node.children, elementId)
        if found ~= nil then
          return found
        end
      end
    end
  end
  return nil
end

local function extractXmlElementById(xml, elementId)
  if type(xml) ~= "string" or type(elementId) ~= "string" or elementId == "" then
    return nil, "invalid input"
  end
  local idPos = xml:find('id="' .. elementId .. '"', 1, true)
  if idPos == nil then
    idPos = xml:find("id='" .. elementId .. "'", 1, true)
  end
  if idPos == nil then
    return nil, "element id not found: " .. elementId
  end
  local openStart = idPos
  while openStart > 1 and xml:sub(openStart, openStart) ~= "<" do
    openStart = openStart - 1
  end
  if xml:sub(openStart, openStart) ~= "<" then
    return nil, "could not locate opening tag for id: " .. elementId
  end
  local openEnd = xml:find(">", openStart, true)
  if openEnd == nil then
    return nil, "malformed opening tag"
  end
  local openTag = xml:sub(openStart, openEnd)
  local tagName = openTag:match("^<(%w+)")
  if tagName == nil then
    return nil, "could not read tag name"
  end
  if openTag:match("/%s*>$") then
    return openTag
  end
  local closeTag = "</" .. tagName .. ">"
  local depth = 1
  local scanPos = openEnd + 1
  local openNeedle = "<" .. tagName
  while scanPos <= #xml do
    local nextOpen = xml:find(openNeedle, scanPos, true)
    local nextClose = xml:find(closeTag, scanPos, true)
    if nextClose == nil then
      return nil, "unclosed element: " .. elementId
    end
    if nextOpen ~= nil and nextOpen < nextClose then
      local nestedOpenEnd = xml:find(">", nextOpen, true)
      if nestedOpenEnd == nil then
        return nil, "malformed nested tag"
      end
      local nestedOpenTag = xml:sub(nextOpen, nestedOpenEnd)
      if not nestedOpenTag:match("/%s*>$") then
        depth = depth + 1
      end
      scanPos = nestedOpenEnd + 1
    else
      depth = depth - 1
      if depth == 0 then
        return xml:sub(openStart, nextClose + #closeTag - 1)
      end
      scanPos = nextClose + #closeTag
    end
  end
  return nil, "scan ended before close"
end

--- Dump one Global UI element (by xml `id`) to debug_logs/ as pretty XML.
--- Usage (TTS chat): lua dumpGlobalUiXmlElement("rollControl_root_Brown")
--- @param elementId string Global UI element id attribute
--- @return boolean ok
function dumpGlobalUiXmlElement(elementId)
  if type(elementId) ~= "string" or elementId == "" then
    print("[test-bed] dumpGlobalUiXmlElement: elementId required")
    return false
  end
  if UI == nil or type(UI.getXml) ~= "function" then
    print("[test-bed] dumpGlobalUiXmlElement: Global UI unavailable")
    return false
  end

  local prettyXml = nil
  local source = nil
  local err = nil

  local fullXml = UI.getXml()
  if type(fullXml) == "string" and fullXml ~= "" then
    local fragment, extractErr = extractXmlElementById(fullXml, elementId)
    if type(fragment) == "string" then
      prettyXml = prettyPrintXml(fragment)
      source = "UI.getXml"
    else
      err = extractErr
    end
  end

  if prettyXml == nil and type(UI.getXmlTable) == "function" then
    local ok, xmlTable = pcall(function()
      return UI.getXmlTable()
    end)
    if ok and type(xmlTable) == "table" then
      local node = findXmlTableNodeById(xmlTable, elementId)
      if node ~= nil then
        prettyXml = xmlNodeToPretty(node, 0) .. "\n"
        source = "UI.getXmlTable"
        err = nil
      end
    end
  end

  if prettyXml == nil then
    print("[test-bed] dumpGlobalUiXmlElement: failed for id=" .. elementId .. " (" .. tostring(err or "not found") .. ")")
    return false
  end

  local stamp = (type(os) == "table" and type(os.date) == "function") and os.date("!%Y-%m-%dT%H:%M:%SZ") or "runtime"
  local outPath = "debug_logs/ui_element_" .. sanitizeUiDumpPathSegment(elementId) .. ".xml"
  local header = table.concat({
    "<!-- Global UI dump from TEST BED.ttslua -->",
    "<!-- element id: " .. elementId .. " -->",
    "<!-- source: " .. tostring(source) .. " -->",
    "<!-- generated: " .. stamp .. " -->",
    "",
  }, "\n")
  local ok = writeLog(outPath, header .. prettyXml)
  if ok then
    print("[test-bed] dumpGlobalUiXmlElement: wrote " .. outPath .. " (" .. tostring(source) .. ")")
  end
  return ok
end

-- #endregion XML

--- Case-sensitive substring search over all spawned objects; writes GUID lines to the workspace debug folder.
--- Prefer: `lua DEBUG.getObjectsByName("CSHEET")` after Save & Play.
--- @param substring string Non-empty substring (plain text, not a Lua pattern).
--- @param relativePath string|nil Optional path under .dev/.debug.
function getObjectsByName(substring, relativePath)
  if DEBUG ~= nil and type(DEBUG.getObjectsByName) == "function" then
    return DEBUG.getObjectsByName(substring, relativePath)
  end
  print("getObjectsByName: DEBUG.getObjectsByName missing — Save & Play first")
end

-- #endregion

-- #region NPC WORLD FUNCTIONS

-- Quick GM Notes scan — no require. Console: lua scanGmNotes("SEAT_FIGURE_NPC1")
function scanGmNotes(want)
  want = string.upper(tostring(want or ""))
  local out = {}
  for _, o in ipairs(getObjects() or {}) do
    if o ~= nil and o.getGMNotes ~= nil then
      local gm = o.getGMNotes()
      if type(gm) == "string" then
        local gmu = string.upper(string.match(gm, "^%s*(.-)%s*$") or "")
        if gmu == want then
          local g = o.getGUID ~= nil and o.getGUID() or "?"
          out[#out + 1] = g
          print(g .. "  " .. gm)
        end
      end
    end
  end
  print(#out .. " hit(s)")
  return out
end

--- One-shot: print which NPC seat workshop objects are missing (chair, figure anchor, two seat lights).
--- Optional: warns if `SEAT_FIGURE_NPC*` exists but lacks the `NPC#Object` tag (NPCS.resolveSeatFigurineObject uses tags).
function checkNpcSeatWorldObjects()
  local rows = {
    { seatKey = "NPC1", tag = "NPC1Object", chair = "75aa53", figure = "df88fd", light1 = "ca058d", light2 = "dad7c0" },
    { seatKey = "NPC2", tag = "NPC2Object", chair = "3d6084", figure = "43e314", light1 = "813c68", light2 = "a7b80b" },
    { seatKey = "NPC3", tag = "NPC3Object", chair = "bae868", figure = "16316e", light1 = "af7e58", light2 = "f0d6b5" },
    { seatKey = "NPC4", tag = "NPC4Object", chair = "6bcded", figure = "977ba7", light1 = "e1f9b6", light2 = "bc9f58" },
  }

  local function hasTag(obj, want)
    if obj == nil or obj.getTags == nil then
      return false
    end
    local tags = obj.getTags() or {}
    for i = 1, #tags do
      if tags[i] == want then
        return true
      end
    end
    return false
  end

  local function line(kind, seatKey, role, guid, extra)
    print(string.format("[npc-seat-check] %-5s %-14s %-18s %s %s", kind, seatKey, role, tostring(guid), extra or ""))
  end

  local missingAny = false
  for r = 1, #rows do
    local row = rows[r]
    local checks = {
      { role = "SEAT_CHAIR",   guid = row.chair },
      { role = "SEAT_FIGURE",  guid = row.figure },
      { role = "SEAT_LIGHT_1", guid = row.light1 },
      { role = "SEAT_LIGHT_2", guid = row.light2 },
    }
    for i = 1, #checks do
      local c = checks[i]
      local obj = G.getObject(c.guid)
      if obj == nil then
        missingAny = true
        line("MISS", row.seatKey, c.role, c.guid, "(G.getObject nil)")
      else
        if c.role == "SEAT_FIGURE" then
          obj.interactable = true
        end
        line("OK  ", row.seatKey, c.role, c.guid, "")
      end
    end
    local fig = G.getObject(row.figure)
    if fig ~= nil and not hasTag(fig, row.tag) then
      line("WARN", row.seatKey, "SEAT_FIGURE tag", row.figure,
        "expected tag '" .. row.tag .. "' for NPCS.resolveSeatFigurineObject")
    end
    local tagged = getObjectsWithTag(row.tag)
    if type(tagged) ~= "table" or #tagged == 0 then
      missingAny = true
      line("MISS", row.seatKey, "tagged objects", "", "no objects with tag '" .. row.tag .. "'")
    else
      line("OK  ", row.seatKey, "tagged objects", "", tostring(#tagged) .. " with tag '" .. row.tag .. "'")
    end
  end

  if missingAny then
    print("[npc-seat-check] DONE: one or more required pieces missing (see MISS lines).")
  else
    print("[npc-seat-check] DONE: all GUID checks passed; review WARN lines if any.")
  end
end

--- One-shot cleanup: all NPC figurines + paired lights in the world, then clear NPC instance state.
--- Run from External Editor console:  lua destroyAllNpcWorldObjects()
function destroyAllNpcWorldObjects()
  local TAG_FIG = "npc_figurine"
  local TAG_LIT = "npc_light"
  local destroyed = { figurines = 0, lights = 0 }
  local seenGuids = {}

  local function destroyOne(obj, bucket)
    if obj == nil or obj.destruct == nil then
      return
    end
    local guid = obj.getGUID ~= nil and obj.getGUID() or nil
    if guid ~= nil and guid ~= "" then
      if seenGuids[guid] then
        return
      end
      seenGuids[guid] = true
    end
    if obj.getLock ~= nil and obj.getLock() then
      obj.setLock(false)
    end
    obj.destruct()
    destroyed[bucket] = destroyed[bucket] + 1
  end

  for _, obj in ipairs(getObjectsWithTag(TAG_FIG) or {}) do
    destroyOne(obj, "figurines")
  end
  for _, obj in ipairs(getObjectsWithTag(TAG_LIT) or {}) do
    destroyOne(obj, "lights")
  end

  -- Clear state so restored GUIDs / instances do not reference deleted objects.
  -- local S = require("core.state")
  S.setStateVal({}, "npcs", "instances")

  local lights = S.getStateVal("lights") or {}
  for regName, _ in pairs(lights) do
    if type(regName) == "string" and string.sub(regName, 1, 9) == "npcLight_" then
      lights[regName] = nil
    end
  end
  S.setStateVal(lights, "lights")
  S.setStateVal({}, "seatLayout", "occupiedNPCSlots")

  print(string.format(
    "[TR] destroyAllNpcWorldObjects: figurines=%d lights=%d (state cleared)",
    destroyed.figurines,
    destroyed.lights
  ))
  return destroyed
end

--- One-shot: destroy figurines, pooled spotlights, and control-board tokens for the
--- three Memoriam-only NPCs already removed from `lib/npcs_data.ttslua`.
--- Does not touch relationship portraits (e.g. `jervaisDeLaCroixPortrait`).
---
--- Load this function (select this block and Execute), then from console:
---   lua destroyMemoriamNpcWorldObjects(true)   -- list only
---   lua destroyMemoriamNpcWorldObjects()       -- destroy, then Save the game
---
--- @param dryRun boolean|nil when true, print matches and skip destroy/state writes
function destroyMemoriamNpcWorldObjects(dryRun)
  local TARGETS = {
    { key = "agnesBellanger", fullName = "Agnes Bellanger" },
    { key = "jervaisDeLaCroix", fullName = "Jervais de la Croix" },
    { key = "ladyAvelineDubois", fullName = "Lady Aveline Dubois" },
  }

  local byKey = {}
  for i = 1, #TARGETS do
    byKey[TARGETS[i].key] = TARGETS[i]
  end

  local function displayName(obj)
    if obj == nil then
      return ""
    end
    if obj.getName ~= nil then
      local n = tostring(obj.getName() or "")
      if n ~= "" then
        return n
      end
    end
    if obj.getData ~= nil then
      local data = obj.getData() or {}
      return tostring(data.Nickname or "")
    end
    return ""
  end

  local function gmNotes(obj)
    if obj == nil or obj.getGMNotes == nil then
      return ""
    end
    return tostring(obj.getGMNotes() or "")
  end

  local function hasTag(obj, tag)
    return obj ~= nil and obj.hasTag ~= nil and obj.hasTag(tag) == true
  end

  local function isNpcSeatFigurineTag(obj)
    return hasTag(obj, "NPC1Object")
      or hasTag(obj, "NPC2Object")
      or hasTag(obj, "NPC3Object")
      or hasTag(obj, "NPC4Object")
  end

  local function matchTarget(obj)
    local notes = gmNotes(obj)
    local name = displayName(obj)
    for i = 1, #TARGETS do
      local t = TARGETS[i]
      if notes == ("npcInstance:" .. t.key) then
        return t.key, "figurine", "gmNotes npcInstance"
      end
      if notes == ("npcToken:" .. t.key) then
        return t.key, "token", "gmNotes npcToken"
      end
      if name == ("NPC Light " .. t.key) then
        return t.key, "light", "nickname NPC Light"
      end
      local seatedNotes = string.match(notes, "^SEAT_FIGURE_") ~= nil
      local figurineLike = hasTag(obj, "npc_figurine") or isNpcSeatFigurineTag(obj) or seatedNotes
      if figurineLike and (name == t.key or name == t.fullName) then
        return t.key, "figurine", "figurine name"
      end
      if hasTag(obj, "npc_light") and name == ("NPC Light " .. t.key) then
        return t.key, "light", "tag npc_light"
      end
      if hasTag(obj, "npc_control_token") and notes == ("npcToken:" .. t.key) then
        return t.key, "token", "tag npc_control_token"
      end
    end
    return nil, nil, nil
  end

  local seen = {}
  local rows = {}
  local lightGuidsToClear = {}

  local function queue(obj, key, kind, via)
    if obj == nil or obj.getGUID == nil then
      return
    end
    local guid = obj.getGUID()
    if type(guid) ~= "string" or guid == "" or seen[guid] then
      return
    end
    seen[guid] = true
    if kind == "light" then
      lightGuidsToClear[#lightGuidsToClear + 1] = guid
    end
    rows[#rows + 1] = {
      obj = obj,
      guid = guid,
      key = key,
      kind = kind,
      via = via,
      name = displayName(obj),
      gmNotes = gmNotes(obj),
    }
  end

  local instances = S.getStateVal("npcs", "instances") or {}
  for i = 1, #TARGETS do
    local key = TARGETS[i].key
    local rec = instances[key]
    if type(rec) == "table" then
      if type(rec.figurineGuid) == "string" and rec.figurineGuid ~= "" then
        queue(G.getObject(rec.figurineGuid), key, "figurine", "instance.figurineGuid")
      end
      if type(rec.lightGuid) == "string" and rec.lightGuid ~= "" then
        lightGuidsToClear[#lightGuidsToClear + 1] = rec.lightGuid
        queue(G.getObject(rec.lightGuid), key, "light", "instance.lightGuid")
      end
    end
  end

  for _, tag in ipairs({ "npc_figurine", "npc_light", "npc_control_token" }) do
    for _, obj in ipairs(getObjectsWithTag(tag) or {}) do
      local key, kind, via = matchTarget(obj)
      if key ~= nil then
        queue(obj, key, kind, via .. " / tag " .. tag)
      end
    end
  end

  -- Seated figurines may have dropped `npc_figurine` while GM Notes are SEAT_FIGURE_*.
  local all = getObjects() or {}
  for i = 1, #all do
    local key, kind, via = matchTarget(all[i])
    if key ~= nil then
      queue(all[i], key, kind, via .. " / getObjects")
    end
  end

  table.sort(rows, function(a, b)
    if a.key == b.key then
      if a.kind == b.kind then
        return a.guid < b.guid
      end
      return a.kind < b.kind
    end
    return a.key < b.key
  end)

  local counts = { figurine = 0, light = 0, token = 0 }
  print(string.format(
    "[memoriam-npc-wipe] matches=%d dryRun=%s (scanned getObjects=%d)",
    #rows,
    tostring(dryRun == true),
    #all
  ))
  for i = 1, #rows do
    local r = rows[i]
    counts[r.kind] = (counts[r.kind] or 0) + 1
    print(string.format(
      "  %d. %s %s guid=%s via=%s name=%q gmNotes=%q",
      i, r.key, r.kind, r.guid, r.via, r.name, r.gmNotes
    ))
  end
  print(string.format(
    "[memoriam-npc-wipe] figurines=%d lights=%d tokens=%d",
    counts.figurine, counts.light, counts.token
  ))

  -- Preload only repairs lights for keys still in D.characters. These three are
  -- already gone from npcs_data, so missing npc_light objects will not spawn.
  local foundKind = {}
  for i = 1, #rows do
    local r = rows[i]
    foundKind[r.key] = foundKind[r.key] or {}
    foundKind[r.key][r.kind] = true
  end
  local missingLights = {}
  for i = 1, #TARGETS do
    local key = TARGETS[i].key
    if foundKind[key] ~= nil and foundKind[key].figurine == true and foundKind[key].light ~= true then
      missingLights[#missingLights + 1] = key
    end
  end
  if #missingLights > 0 then
    print("[memoriam-npc-wipe] no npc_light in the world for: " .. table.concat(missingLights, ", "))
    print("[memoriam-npc-wipe] preload will not spawn those lights (NPC is no longer in npcs_data)")
  end

  if dryRun == true then
    print("[memoriam-npc-wipe] dry run; call destroyMemoriamNpcWorldObjects() to destroy")
    return rows
  end

  local destroyed = 0
  for i = 1, #rows do
    local obj = rows[i].obj
    if obj ~= nil then
      if obj.getLock ~= nil and obj.getLock() then
        obj.setLock(false)
      end
      if obj.destruct ~= nil then
        obj.destruct()
        destroyed = destroyed + 1
      end
    end
  end

  instances = S.getStateVal("npcs", "instances") or {}
  for i = 1, #TARGETS do
    instances[TARGETS[i].key] = nil
  end
  S.setStateVal(instances, "npcs", "instances")

  local lights = S.getStateVal("lights") or {}
  for i = 1, #lightGuidsToClear do
    lights["npcLight_" .. lightGuidsToClear[i]] = nil
  end
  S.setStateVal(lights, "lights")

  local occupied = S.getStateVal("seatLayout", "occupiedNPCSlots") or {}
  for seatKey, occupant in pairs(occupied) do
    if type(occupant) == "string" and byKey[occupant] ~= nil then
      occupied[seatKey] = false
    end
  end
  S.setStateVal(occupied, "seatLayout", "occupiedNPCSlots")

  local sessionScene = S.getStateVal("sessionScene")
  if type(sessionScene) == "table" and type(sessionScene.npcWorld) == "table"
      and type(sessionScene.npcWorld.placements) == "table" then
    local placements = sessionScene.npcWorld.placements
    for i = 1, #TARGETS do
      placements[TARGETS[i].key] = nil
    end
    S.setStateVal(placements, "sessionScene", "npcWorld", "placements")
  end

  print(string.format(
    "[memoriam-npc-wipe] destroyed=%d — Save the game so these objects stay gone",
    destroyed
  ))
  return rows
end

-- destroyMemoriamNpcWorldObjects(true)
destroyMemoriamNpcWorldObjects()

-- #endregion

-- #region OBJECTS LOOKUP (by GM Notes, Display Name)
local GM_NOTES_QUERY = "STORAGE_TOME_PINK" -- edit before execute
local GM_NOTES_EXACT_MATCH = false         -- true = full GM Notes string must equal query

local function gmNotesLookupFormatVec(v)
  if v == nil then
    return "nil"
  end
  return string.format("(%.3f, %.3f, %.3f)", v.x, v.y, v.z)
end

local function gmNotesLookupTags(obj)
  if obj == nil or obj.getTags == nil then
    return {}
  end
  local tags = obj.getTags()
  if type(tags) ~= "table" then
    return {}
  end
  local out = {}
  for i = 1, #tags do
    out[i] = tostring(tags[i])
  end
  table.sort(out)
  return out
end

--- Print GUID, tags, position, rotation for every object whose GM Notes match `query`.
--- @param query string|nil defaults to GM_NOTES_QUERY
--- @param exactMatch boolean|nil defaults to GM_NOTES_EXACT_MATCH
--- @return Object[]
function FindObjectsByGmNotes(query, exactMatch)
  query = query or GM_NOTES_QUERY
  if exactMatch == nil then
    exactMatch = GM_NOTES_EXACT_MATCH == true
  end
  if type(query) ~= "string" or query == "" then
    print("[gm-notes lookup] Set GM_NOTES_QUERY to a non-empty string.")
    return {}
  end

  local all = getObjects()
  if type(all) ~= "table" then
    print("[gm-notes lookup] getObjects() returned nil.")
    return {}
  end

  local matches = {}
  for _, obj in ipairs(all) do
    if obj ~= nil and obj.getGMNotes ~= nil then
      local notes = tostring(obj.getGMNotes() or "")
      local hit
      if exactMatch then
        hit = notes == query
      else
        hit = string.find(notes, query, 1, true) ~= nil
      end
      if hit then
        matches[#matches + 1] = obj
      end
    end
  end

  table.sort(matches, function(a, b)
    local ga = a.getGUID and tostring(a.getGUID() or "") or ""
    local gb = b.getGUID and tostring(b.getGUID() or "") or ""
    return ga < gb
  end)

  print(string.format(
    "[gm-notes lookup] query=%q exact=%s scanned=%d found=%d",
    query,
    tostring(exactMatch),
    #all,
    #matches
  ))

  for i, obj in ipairs(matches) do
    local guid = obj.getGUID and tostring(obj.getGUID() or "?") or "?"
    local name = obj.getName and tostring(obj.getName() or "") or ""
    local notes = obj.getGMNotes and tostring(obj.getGMNotes() or "") or ""
    local pos = obj.getPosition and obj.getPosition() or nil
    local rot = obj.getRotation and obj.getRotation() or nil
    local tags = gmNotesLookupTags(obj)
    print(string.format("--- [%d] guid=%s ---", i, guid))
    print("  name: " .. name)
    print("  gmNotes: " .. notes)
    print("  position: " .. gmNotesLookupFormatVec(pos))
    print("  rotation: " .. gmNotesLookupFormatVec(rot))
    print("  tags (" .. tostring(#tags) .. "): " .. (#tags > 0 and table.concat(tags, ", ") or "(none)"))
  end

  if #matches == 0 then
    print("[gm-notes lookup] no objects matched.")
  end

  return matches
end

local function findObjectByDisplayName(displayName)
  if type(displayName) ~= "string" or displayName == "" then
    return nil
  end
  local target = string.upper(displayName)
  for _, obj in ipairs(getAllObjects() or {}) do
    if obj ~= nil then
      if obj.getGMNotes ~= nil then
        local gm = string.upper(tostring(obj.getGMNotes() or ""))
        if gm == target then
          return obj
        end
      end
      local objName = string.upper((obj.getName and obj.getName()) or "")
      if objName == target then
        return obj
      end
      local data = obj.getData and obj.getData() or {}
      local nickname = string.upper(data.Nickname or "")
      if nickname == target then
        return obj
      end
    end
  end
  return nil
end
