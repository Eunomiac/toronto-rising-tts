  print("[TEST BED] Connected clients:")
  for i, player in ipairs(players) do
    local name = player.steam_name or "Unknown"
    local steam_id = player.steam_id or "Unknown"
    print(string.format("  [%d] %s: %s", i, name, steam_id))
  end
end

