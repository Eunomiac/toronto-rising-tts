-- Parses a string like "Mar 28 2026" into an os.time() timestamp (midnight local)
function getTimeStamp(dateString)
  -- Map three-letter months to their numeric values
  local monthMap = {
    Jan = 1, Feb = 2, Mar = 3, Apr = 4, May = 5, Jun = 6,
    Jul = 7, Aug = 8, Sep = 9, Oct = 10, Nov = 11, Dec = 12
  }
  -- Match strings like "Mar 28 2026"
  local monthStr, day, year = dateString:match("^(%a%a%a)%s+(%d+)%s+(%d+)$")
  if not (monthStr and day and year) then
    error("Invalid date string: " .. tostring(dateString))
  end
  local month = monthMap[monthStr]
  if not month then
    error("Invalid month: " .. tostring(monthStr))
  end
  -- Build the date table for os.time (hour/min/sec = 0)
  local t = {
    year = tonumber(year),
    month = month,
    day = tonumber(day),
    hour = 0,
    min = 0,
    sec = 0
  }
  return os.time(t)
end

-- Example usage:
local ts = getTimeStamp("Jul 30 2026")
print(ts)

