-- #region dump-object-xml
-- Writes the object's live UI XML (what the sheet is showing now) to .dev/.debug/.
-- This is object.UI.getXml(), not the bundled source file.
function DumpObjectXml(guid, relativePath)
  return DEBUG.dumpObjectXmlToFile(guid, relativePath)
end

