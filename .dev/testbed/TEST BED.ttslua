-- SCANS & PRINTS ALL LIGHTS
-- finds lights by looking for Custom_Assetbundle with the GUID 1667980476488958906, regardless of tag or other elements
function ScanAllLights(isDestroying)
  if isDestroying == nil then
    isDestroying = false
  end
  -- Unique URL fragment of the NPC spotlight Custom_Assetbundle (not a TTS tag).
  local SPOTLIGHT_UGC = "1667980476488958906"

  local function fmtPos(obj)
      if obj == nil or obj.getPosition == nil then
          return "?"
      end
      local p = obj.getPosition()
      if p == nil then
          return "?"
      end
      return string.format("%.2f, %.2f, %.2f", p.x or 0, p.y or 0, p.z or 0)
  end

  local function bundleUrl(obj)
      if obj == nil or obj.getCustomObject == nil then
          return ""
      end
      local co = obj.getCustomObject()
      if type(co) ~= "table" then
          return ""
      end
      return tostring(co.assetbundle or co.AssetbundleURL or co.assetbundleURL or "")
  end

  local function hasRealLight(obj)
      if obj == nil then
          return false
      end
      local getOne = obj.getComponentInChildren
      if type(getOne) ~= "function" then
          return false
      end
      local comp = getOne("Light")
      if comp == nil or comp.get == nil then
          return false
      end
      local a = comp.get("spotAngle")
      local r = comp.get("range")
      local i = comp.get("intensity")
      return type(a) == "number" and type(r) == "number" and type(i) == "number"
  end

  function listAllSpotlights()
      local prefab = {}
      local otherLight = {}
      local objs = getObjects() or {}
      for i = 1, #objs do
          local o = objs[i]
          if o ~= nil then
              local url = bundleUrl(o)
              local isPrefab = string.find(url, SPOTLIGHT_UGC, 1, true) ~= nil
              local isLight = hasRealLight(o)
              if isPrefab or isLight then
                  local row = {
                      guid = tostring(o.getGUID and o.getGUID() or ""),
                      name = tostring(o.getName and o.getName() or ""),
                      kind = tostring(o.tag or ""),
                      pos = fmtPos(o),
                      url = url,
                      light = isLight,
                      prefab = isPrefab,
                  }
                  if isPrefab then
                      prefab[#prefab + 1] = row
                  else
                      otherLight[#otherLight + 1] = row
                  end
                  if isDestroying then
                      o.destruct()
                  end
              end
          end
      end
      local function dump(title, rows)
          print(string.format("[%s] count=%d", title, #rows))
          for i = 1, #rows do
              local r = rows[i]
              print(string.format(
                  "  %s | %s | %s | (%s) | light=%s | url=%s",
                  r.guid, r.name, r.kind, r.pos, tostring(r.light), r.url
              ))
          end
      end
      dump("NPC spotlight prefab (bundle URL)", prefab)
      dump("other objects with a real Unity Light", otherLight)
  end

  listAllSpotlights()
end

-- SCANS & PRINTS ALL FIGURINES
function ScanAllFigurines(isDestroying)
  isDestroying = isDestroying or false
  local function fmtPos(obj)
    if obj == nil or obj.getPosition == nil then
        return "?"
    end
    local p = obj.getPosition()
    if p == nil then
        return "?"
    end
    return string.format("%.2f, %.2f, %.2f", p.x or 0, p.y or 0, p.z or 0)
  end

  local function isFigurine(obj)
    if obj == nil then
        return false, ""
    end
    local typeVal = string.lower(tostring(obj.type or ""))
    local tagVal = string.lower(tostring(obj.tag or ""))
    local nameVal = string.lower(tostring(obj.name or ""))
    if string.find(typeVal, "figurine", 1, true)
        or string.find(tagVal, "figurine", 1, true)
        or nameVal == "figurine_custom"
        or nameVal == "figurine"
    then
        return true, tostring(obj.type or obj.tag or obj.name or "")
    end
    if obj.getCustomObject ~= nil then
        local co = obj.getCustomObject()
        if type(co) == "table" then
            local image = co.image or co.ImageURL
            if type(image) == "string" and image ~= "" and (co.mesh == nil or co.mesh == "") then
                return true, "custom-image"
            end
        end
    end
    return false, ""
  end

  function listAllFigurines()
    local rows = {}
    local objs = getObjects() or {}
    for i = 1, #objs do
        local o = objs[i]
        local ok, kind = isFigurine(o)
        if ok then
            local image = ""
            if o.getCustomObject ~= nil then
                local co = o.getCustomObject()
                if type(co) == "table" then
                    image = tostring(co.image or co.ImageURL or "")
                end
            end

            rows[#rows + 1] = {
                guid = tostring(o.getGUID and o.getGUID() or ""),
                nick = tostring(o.getName and o.getName() or ""),
                kind = kind,
                pos = fmtPos(o),
                image = image,
            }
            if isDestroying then
              o.destruct()
            end
        end
    end
    print(string.format("[figurines] count=%d", #rows))
    for i = 1, #rows do
        local r = rows[i]
        print(string.format("  %s | %s | %s | (%s) | %s", r.guid, r.nick, r.kind, r.pos, r.image))
    end
  end

  listAllFigurines()
end

