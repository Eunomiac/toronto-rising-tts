  position = C.ReferenceCameraAngles.default.position:add(Vector({0, 100, 0})),
  pitch = 0,
  yaw = 90,
  distance = 0
})
useCase3({
  position = C.ReferenceCameraAngles.default.position:scale(Vector({1, 0, 1})),
  pitch = 0,
  yaw = 270,
  distance = 0
})

