-- #region hand-card-probe
--- Mirrors U.movePlayerHand's held-card detection (collectHandCards in lib/util.ttslua):
--- card-like objects from handZone.getObjects() plus Player[color].getHandObjects(), deduped.
--- Also lists every Card/Deck within `radius` of the zone that detection MISSED, so a locked
--- parked hand shows whether its cards are still "in" the hand.
--- opts.unlockAndRecheck = true: unlock the missed nearby cards, wait, and probe again.
function ProbeHandCards(color, opts)
  opts = type(opts) == "table" and opts or {}
  local radius = opts.radius or 12
  local recheckDelay = opts.recheckDelay or 0.5

  local function isHandCardLike(obj)
    if obj == nil or not U.isGameObject(obj) then return false end
    return obj.tag == "Card" or obj.tag == "Deck" or obj.type == "Card" or obj.type == "Deck"
  end

  local function fmt(v)
    return string.format("(%.2f, %.2f, %.2f)", v.x, v.y, v.z)
  end

  local function describe(obj, hzPos)
    local p = obj.getPosition()
    local dist = Vector.distance(Vector(p), Vector(hzPos))
    return string.format("%s  %-24s locked=%s  pos=%s  dist=%.2f",
      obj.getGUID(), tostring(obj.getName() ~= "" and obj.getName() or obj.tag),
      tostring(obj.getLock()), fmt(p), dist)
  end

  local function probe(label)
    local hz = U.getHandZone(color)
    if hz == nil then
      print("[ProbeHandCards] no hand zone for " .. tostring(color))
      return {}
    end
    local hzPos = hz.getPosition()
    local lines = {}
    local function add(s) lines[#lines + 1] = s end

    add(string.format("=== ProbeHandCards %s (%s) — zone %s pos=%s rot=%s scale=%s ===",
      color, label, hz.getGUID(), fmt(hzPos), fmt(hz.getRotation()), fmt(hz.getScale())))

    local seen, detected = {}, {}
    local function consider(obj, source)
      if not isHandCardLike(obj) then return end
      local g = obj.getGUID()
      if seen[g] then
        seen[g] = seen[g] .. "+" .. source
        return
      end
      seen[g] = source
      detected[#detected + 1] = obj
    end

    local zoneObjs = hz.getObjects() or {}
    for _, o in ipairs(zoneObjs) do consider(o, "zone") end
    local player = Player[color]
    local handObjs = (player ~= nil and player.getHandObjects ~= nil) and (player.getHandObjects() or {}) or {}
    for _, o in ipairs(handObjs) do consider(o, "hand") end

    add(string.format("zone.getObjects()=%d  player.getHandObjects()=%d  detected cards=%d",
      #zoneObjs, #handObjs, #detected))
    for _, o in ipairs(detected) do
      add("  DETECTED [" .. seen[o.getGUID()] .. "]  " .. describe(o, hzPos))
    end

    local missed = {}
    for _, o in ipairs(getObjects()) do
      if isHandCardLike(o) and not seen[o.getGUID()] then
        if Vector.distance(Vector(o.getPosition()), Vector(hzPos)) <= radius then
          missed[#missed + 1] = o
        end
      end
    end
    add(string.format("cards within %.1f of zone NOT detected: %d", radius, #missed))
    for _, o in ipairs(missed) do
      add("  MISSED  " .. describe(o, hzPos))
    end

    print(table.concat(lines, "\n"))
    return missed
  end

  local missed = probe("as-is")
  if opts.unlockAndRecheck and #missed > 0 then
    U.chain({
      function()
        for _, o in ipairs(missed) do o.setLock(false) end
        return recheckDelay
      end,
      function()
        probe("after unlocking missed cards")
      end,
    })
  end
end


