function getGNotesForObjectsTagged(tag)
  for _, obj in ipairs(getObjectsWithTag(tag) or {}) do
    print("GMNotes for object " ..
    (obj.getName() or "") ..
    " (" .. (obj.getGUID() or "") .. "): " .. (obj.getGMNotes and obj.getGMNotes() or "[no GMNotes method]"))
  end
end

function printTable(tbl, indent)
  indent = indent or 0
  local formatting = string.rep("  ", indent)
  if type(tbl) ~= "table" then
    print(formatting .. tostring(tbl))
    return
  end
  print(formatting .. "{")
  for k, v in pairs(tbl) do
    local keyStr = tostring(k)
    if type(v) == "table" then
      print(formatting .. "  [" .. keyStr .. "] = ")
      printTable(v, indent + 2)
    else
      print(formatting .. "  [" .. keyStr .. "] = " .. tostring(v))
    end
  end
  print(formatting .. "}")
end

function scaleNPCTokens()
  for _, o in ipairs(getObjectsWithTag("npc_control_token") or {}) do if o ~= nil and o.getCustomObject ~= nil and o.setCustomObject ~= nil then
      local p = o:getCustomObject(); if type(p) == "table" then
        p.thickness = 0.03; o:setCustomObject(p); if o.reload ~= nil then o:reload() end
      end
    end end
end

function auditNpcFigurineDuplicates()
  local TAGS = {
    "npc_figurine",
    "NPC1Object",
    "NPC2Object",
    "NPC3Object",
    "NPC4Object",
  }

  local seen = {}
  local rows = {}

  local function add(obj, via)
    if obj == nil or obj.getGUID == nil then return end
    local guid = obj.getGUID()
    if seen[guid] then return end
    seen[guid] = true
    local name = obj.getName and tostring(obj.getName() or "") or ""
    local notes = obj.getGMNotes and tostring(obj.getGMNotes() or "") or ""
    local p = obj.getPosition and obj.getPosition() or nil
    rows[#rows + 1] = {
      guid = guid,
      name = name,
      gmNotes = notes,
      via = via,
      y = p and math.floor(p.y + 0.5) or "?",
    }
  end

  for _, tag in ipairs(TAGS) do
    for _, obj in ipairs(getObjectsWithTag(tag) or {}) do
      add(obj, "tag:" .. tag)
    end
  end

  for _, obj in ipairs(getObjects() or {}) do
    if obj ~= nil and obj.getGMNotes ~= nil then
      local notes = tostring(obj.getGMNotes() or "")
      if string.sub(notes, 1, 12) == "npcInstance:" then
        add(obj, "scan:npcInstance")
      elseif string.sub(notes, 1, 12) == "SEAT_FIGURE_" then
        add(obj, "scan:SEAT_FIGURE")
      end
    end
  end

  print("[npc-fig-audit] " .. #rows .. " unique object(s)")
  for i, r in ipairs(rows) do
    print(string.format(
      "  %d. guid=%s y=%s via=%s name=%q gmNotes=%q",
      i, r.guid, tostring(r.y), r.via, r.name, r.gmNotes
    ))
  end

  local byNotes = {}
  local byInstance = {}
  local bySeatFigure = {}

  for _, r in ipairs(rows) do
    if r.gmNotes ~= "" then
      byNotes[r.gmNotes] = byNotes[r.gmNotes] or {}
      table.insert(byNotes[r.gmNotes], r)
    end
    local inst = string.match(r.gmNotes, "^npcInstance:(.+)$")
    if inst then
      byInstance[inst] = byInstance[inst] or {}
      table.insert(byInstance[inst], r)
    end
    local seat = string.match(r.gmNotes, "^(SEAT_FIGURE_%u%d+)$")
    if seat then
      bySeatFigure[seat] = bySeatFigure[seat] or {}
      table.insert(bySeatFigure[seat], r)
    end
  end

  local groups = 0
  local function report(label, bucket)
    for key, list in pairs(bucket) do
      if #list > 1 then
        groups = groups + 1
        print("[DUPLICATE " .. label .. "] " .. key .. " x" .. #list)
        for _, r in ipairs(list) do
          print("    guid=" .. r.guid .. " y=" .. tostring(r.y) .. " name=" .. r.name .. " via=" .. r.via)
        end
      end
    end
  end

  report("gmNotes", byNotes)
  report("npcInstance", byInstance)
  report("SEAT_FIGURE", bySeatFigure)

  if groups == 0 then
    print("[npc-fig-audit] OK — no duplicate npcInstance / SEAT_FIGURE / identical gmNotes")
  else
    print("[npc-fig-audit] WARN — " .. groups .. " duplicate group(s)")
  end
end

function updateCustomModelByGUID(guid, overrides, scale)
  if type(guid) == "table" then
    for _, single_guid in ipairs(guid) do
      updateCustomModelByGUID(single_guid, overrides, scale)
    end
    return
  end
  local obj = G.getObject(guid)

  if obj == nil then
    print("No object found with GUID: " .. tostring(guid))
    return
  end

  local params = obj.getCustomObject()

  if params == nil then
    print("Object with GUID " .. tostring(guid) .. " does not appear to be a Custom Object.")
    return
  end

  for key, value in pairs(overrides) do
    params[key] = value
  end

  -- Blank strings are usually not useful here.
  -- nil removes/omits the optional field.
  if params.normal == "" then
    params.normal = nil
  end

  if params.collider == "" then
    params.collider = nil
  end

  obj.setCustomObject(params)
  if scale then
    obj.setScale(scale)
  end
  obj.reload()

  print("Updated custom model: " .. tostring(guid))
end

function getMaterialSettingsForTable(tableRef)
  local cfg = C.Tables[tableRef]
  if cfg == nil or not cfg.guid then
    return nil
  end

  local obj = G.getObject(cfg.guid)
  if obj == nil or obj.getCustomObject == nil then
    return nil
  end

  local params = obj.getCustomObject()
  if params == nil then
    return nil
  end

  print("Material settings for " .. tableRef .. ":")
  for k, v in pairs(params) do
    print("  " .. tostring(k) .. ": " .. tostring(v))
  end
  return params
end

function applyMaterialSettingsToAllTables(specIntensity, specColor, specSharpness, fresnelStrength, castShadows)
  local updateObjectMaterial = function(obj)
    if obj ~= nil and obj.getCustomObject ~= nil and obj.setCustomObject ~= nil then
      local params = obj:getCustomObject()
      if params ~= nil then
        params.specular_intensity = specIntensity
        params.specular_color = specColor
        params.specular_sharpness = specSharpness
        params.fresnel_strength = fresnelStrength
        params.cast_shadows = castShadows
        obj:setCustomObject(params)
        obj:reload()
      end
    end
  end

  local nTables = 0
  for _ in pairs(C.Tables) do nTables = nTables + 1 end
  for tableKey, tableEntry in pairs(C.Tables) do
    local guid = tableEntry.guid
    if type(guid) == "string" and guid ~= "" then
      local obj = G.getObject(guid)
      updateObjectMaterial(obj)
    end

    -- Check for components
    local nComponents = 0
    if type(tableEntry.components) == "table" then
      for _ in pairs(tableEntry.components) do nComponents = nComponents + 1 end
    end
    if type(tableEntry) == "table" and type(tableEntry.components) == "table" then
      for compName, compEntry in pairs(tableEntry.components) do
        if type(compEntry.guid) == "string" and compEntry.guid ~= "" then
          local compObj = G.getObject(compEntry.guid)
          updateObjectMaterial(compObj)
        end
      end
    end
  end
end

-- applyMaterialSettingsToAllTables(0, Color(1, 0.82, 0.45), 6.5, 0.5, true)

-- #region AUDIT OF PLAYER SEATING CODE EXECUTION SANDBOX

-- ## AUDIT OF PLAYER SEATING CODE EXECUTION SANDBOX

-- =============================================================================
-- Player seat layout audit — phased runbook (Host, Save & Play after bundle, no loose d10)
--
-- RUNBOOK:
--   Step 1. Save & Play (bundled Global + TEST BED).
--   Step 2. Execute this file. Only uncommented PlayerSeatAudit_*() calls at the bottom run.
--   Step 3. Uncomment one phase at a time in the launchpad; re-Execute after each pass.
--
-- Phase 3 (NPC simplified path):
--   Blocks call `syncTableSimplified` (same path as production `SyncTable` / `SetTableTo`).
--   P3_0 — helper registration banner
--   P3_1 — Table A (Apply myleneHamelin to NPC1 on control board before P3_1)
--   P3_2 — Table B1
--   P3_3 — Table B3 (seats NPC2/NPC3 via assignNpcToSeat)
--   P3_4 — summary banner
--
-- Phase 4 (PC simplified path; after Phase 3 passes):
--   P4_1 — Table A PC hand zones + compareLayoutPaths
--   P4_2 — Table B2 PC hand zones
--   P4_3 — Table C (FACING) PC hand zones
-- =============================================================================

function Phase3_fail(msg)
  printHeader("[Phase3] FAIL " .. tostring(msg), 3)
end

function Phase3_pass(msg)
  print("[Phase3] PASS " .. tostring(msg))
end

function Phase4_fail(msg)
  printHeader("[Phase4] FAIL " .. tostring(msg), 3)
end

function Phase4_pass(msg)
  print("[Phase4] PASS " .. tostring(msg))
end

function Phase3_npcChairY(seatKey)
  local guid = G.GUIDS["SEAT_CHAIR_" .. tostring(seatKey)]
  if type(guid) ~= "string" or guid == "" then
    return nil
  end
  local obj = G.getObject(guid)
  if obj == nil or obj.getPosition == nil then
    return nil
  end
  return obj.getPosition().y
end

function Phase3_assertChairHidden(seatKey)
  local y = Phase3_npcChairY(seatKey)
  if y == nil or y > -100 then
    Phase3_fail("chair not hidden " .. tostring(seatKey) .. " y=" .. tostring(y))
    return false
  end
  Phase3_pass("chair hidden " .. tostring(seatKey))
  return true
end

function Phase3_assertChairVisible(seatKey)
  local y = Phase3_npcChairY(seatKey)
  if y == nil or y < -100 then
    Phase3_fail("chair not visible " .. tostring(seatKey) .. " y=" .. tostring(y))
    return false
  end
  Phase3_pass("chair visible " .. tostring(seatKey) .. " y=" .. string.format("%.2f", y))
  return true
end

function Phase3_assertVirtualAnchor(seatKey)
  local va = S.getStateVal("seatLayout", "virtualHandZoneAnchors", seatKey)
  if type(va) ~= "table" or va.position == nil then
    Phase3_fail("missing virtualHandZoneAnchors." .. tostring(seatKey))
    return false
  end
  Phase3_pass("virtual anchor " .. tostring(seatKey))
  return true
end

function Phase3_assertOccupied(seatKey, wantOccupied)
  local occ = S.getStateVal("seatLayout", "occupiedNPCSlots", seatKey)
  local isOcc = occ ~= nil and occ ~= false
  if isOcc ~= wantOccupied then
    Phase3_fail(
      "occupiedNPCSlots." .. tostring(seatKey)
      .. " want=" .. tostring(wantOccupied)
      .. " got=" .. tostring(occ)
    )
    return false
  end
  Phase3_pass("occupiedNPCSlots." .. tostring(seatKey) .. "=" .. tostring(wantOccupied))
  return true
end

function Phase3_assertCurrentTable(tableKey)
  local cur = S.getStateVal("seatLayout", "currentTableKey")
  if cur ~= tableKey then
    Phase3_fail("currentTableKey want=" .. tostring(tableKey) .. " got=" .. tostring(cur))
    return false
  end
  Phase3_pass("currentTableKey=" .. tostring(tableKey))
  return true
end

-- @param assignments table<string,string> e.g. { NPC1 = "myleneHamelin" }
function Phase3_seedOccupancy(assignments)
  assignments = type(assignments) == "table" and assignments or {}
  local occupied = {}
  for _, sk in ipairs(C.NPCSeats or {}) do
    occupied[sk] = false
  end
  local seatSlots = S.getStateVal("sessionScene", "seatSlots") or {}
  for _, sk in ipairs(C.NPCSeats or {}) do
    local ck = assignments[sk]
    if type(ck) == "string" and ck ~= "" then
      occupied[sk] = ck
      seatSlots[sk] = { characterKey = ck, slotEmpty = false, isPresent = true }
    else
      seatSlots[sk] = { slotEmpty = true, isPresent = true }
    end
  end
  S.setStateVal(seatSlots, "sessionScene", "seatSlots")
  S.setStateVal(occupied, "seatLayout", "occupiedNPCSlots")
  S.validateState()
end

--- Seat a pooled NPC at a table seat (same end state as gameboard Apply for layout purposes).
--- @param seatKey string
--- @param characterKey string
--- @return boolean
function Phase3_assignNpcToSeat(seatKey, characterKey)
  if type(NPCS) ~= "table" or type(NPCS.assignNpcToSeat) ~= "function" then
    Phase3_fail("NPCS.assignNpcToSeat missing — Save & Play after bundle")
    return false
  end
  if type(NPCS.characters) ~= "table" or NPCS.characters[characterKey] == nil then
    Phase3_fail("unknown NPC character '" .. tostring(characterKey) .. "'")
    return false
  end
  local ok, err = NPCS.assignNpcToSeat(characterKey, seatKey, {
    deferLayoutSync = true,
    blockAreaBound = true,
  })
  if ok ~= true then
    Phase3_fail(
      "assignNpcToSeat "
      .. tostring(characterKey)
      .. "@"
      .. tostring(seatKey)
      .. ": "
      .. tostring(err)
    )
    return false
  end
  Phase3_pass("seated " .. tostring(characterKey) .. " at " .. tostring(seatKey))
  return true
end

--- @param seatKey string
--- @param characterKey string
--- @return boolean
function Phase3_assertFigurineAtSeat(seatKey, characterKey)
  local inst = (S.getStateVal("npcs", "instances") or {})[characterKey]
  if type(inst) ~= "table" then
    Phase3_fail("no instance for " .. tostring(characterKey))
    return false
  end
  if inst.areaKey ~= "seat" or inst.seatedSeatKey ~= seatKey then
    Phase3_fail(
      tostring(characterKey)
      .. " instance not at "
      .. tostring(seatKey)
      .. " (areaKey="
      .. tostring(inst.areaKey)
      .. " seatedSeatKey="
      .. tostring(inst.seatedSeatKey)
      .. ")"
    )
    return false
  end
  local fig = G.getObject(inst.figurineGuid or "")
  if fig == nil or fig.getPosition == nil then
    Phase3_fail("figurine missing for " .. tostring(characterKey))
    return false
  end
  local y = fig.getPosition().y
  if y < -100 then
    Phase3_fail("figurine hidden for " .. tostring(characterKey) .. " y=" .. tostring(y))
    return false
  end
  Phase3_pass("figurine visible at " .. tostring(seatKey) .. " (" .. tostring(characterKey) .. ")")
  return true
end

function Phase3_assertAll(checks)
  local ok = true
  for i = 1, #checks do
    if checks[i]() ~= true then
      ok = false
    end
  end
  return ok
end

function Phase4_assertHandZoneVisible(seatKey)
  local hz = U.getHandZone(seatKey)
  if hz == nil or hz.getPosition == nil then
    Phase4_fail("hand zone missing for " .. tostring(seatKey))
    return false
  end
  local y = hz.getPosition().y
  if y < -100 then
    Phase4_fail("hand zone hidden " .. tostring(seatKey) .. " y=" .. tostring(y))
    return false
  end
  Phase4_pass("hand zone visible " .. tostring(seatKey) .. " y=" .. string.format("%.2f", y))
  return true
end

function Phase4_assertPcHandZonesForTable(tableKey)
  local cfg = C.Tables and C.Tables[tableKey]
  if type(cfg) ~= "table" or type(cfg.seatToPositionMap) ~= "table" then
    Phase4_fail("unknown table '" .. tostring(tableKey) .. "'")
    return false
  end
  local checks = {}
  for i = 1, #(C.PlayerColors or {}) do
    local sk = C.PlayerColors[i]
    if cfg.seatToPositionMap[sk] ~= nil then
      checks[#checks + 1] = function()
        return Phase4_assertHandZoneVisible(sk)
      end
    end
  end
  return Phase3_assertAll(checks)
end

function Phase4_assertCompareLayoutPaths(tableKey)
  if type(compareLayoutPaths) ~= "function" then
    Phase4_fail("compareLayoutPaths missing — Save & Play after bundle")
    return false
  end
  local summary = compareLayoutPaths(tableKey)
  local pc = type(summary) == "table" and summary.pcOnly or nil
  if type(pc) == "table" and pc.ok == true then
    Phase4_pass("compareLayoutPaths PC hand frames PASS (" .. tostring(tableKey) .. ")")
    return true
  end
  Phase4_fail("compareLayoutPaths PC hand frames FAIL (" .. tostring(tableKey) .. ")")
  return false
end

function Phase4_syncSimplified(tableKey)
  if type(syncTableSimplified) ~= "function" then
    Phase4_fail("syncTableSimplified missing — Save & Play after bundle")
    return nil
  end
  local computed = syncTableSimplified(tableKey, { force = true })
  if computed == nil then
    Phase4_fail("syncTableSimplified(" .. tostring(tableKey) .. ") returned nil — loose dice on table?")
    return nil
  end
  Phase4_pass("syncTableSimplified(" .. tostring(tableKey) .. ") ran")
  return computed
end

function PlayerSeatAudit_P3_0()
  printHeader("Phase 3 helpers registered (Phase3_*, Phase4_*)", 2)
end

function PlayerSeatAudit_P3_1()
  U.chain({
    function()
      printHeader("Phase 3 — Block 1: NPC1 on Table A", 1)
    end,
    function()
      if type(syncTableSimplified) ~= "function" then
        Phase3_fail("syncTableSimplified missing — Save & Play after bundle")
        return
      end
      local occ = S.getStateVal("seatLayout", "occupiedNPCSlots", "NPC1")
      if occ == nil or occ == false then
        Phase3_fail("NPC1 not occupied — Apply myleneHamelin to NPC1 on control board first")
        return
      end
      local inst = (S.getStateVal("npcs", "instances") or {})["myleneHamelin"]
      if type(inst) ~= "table" or inst.areaKey ~= "seat" or inst.seatedSeatKey ~= "NPC1" then
        Phase3_fail(
          "myleneHamelin instance not seated at NPC1 (areaKey=seat) — use gameboard Apply, not Phase3_seedOccupancy"
        )
        return
      end
      Phase3_pass("NPC1 preflight ok occupied=" .. tostring(occ))
    end,
    function()
      local computed = syncTableSimplified("Table A", { force = true })
      if computed == nil then
        Phase3_fail("syncTableSimplified(Table A) returned nil — loose dice on table?")
        return
      end
      Phase3_pass("syncTableSimplified(Table A) ran")
    end,
    function()
      Phase3_assertAll({
        function() return Phase3_assertCurrentTable("Table A") end,
        function() return Phase3_assertOccupied("NPC1", true) end,
        function() return Phase3_assertOccupied("NPC2", false) end,
        function() return Phase3_assertOccupied("NPC3", false) end,
        function() return Phase3_assertOccupied("NPC4", false) end,
        function() return Phase3_assertVirtualAnchor("NPC1") end,
        function() return Phase3_assertChairVisible("NPC1") end,
        function() return Phase3_assertChairHidden("NPC2") end,
        function() return Phase3_assertChairHidden("NPC3") end,
        function() return Phase3_assertChairHidden("NPC4") end,
      })
    end,
    function()
      printHeader("[HUMAN] Block 1 done — uncomment PlayerSeatAudit_P3_2() and re-Execute.", 3)
    end,
  })
end

function PlayerSeatAudit_P3_2()
  U.chain({
    function()
      printHeader("Phase 3 — Block 2: Table B1", 1)
    end,
    function()
      local computed = syncTableSimplified("Table B1", { force = true })
      if computed == nil then
        Phase3_fail("syncTableSimplified(Table B1) returned nil — loose dice on table?")
        return
      end
      Phase3_pass("syncTableSimplified(Table B1) ran")
    end,
    function()
      Phase3_assertAll({
        function() return Phase3_assertCurrentTable("Table B1") end,
        function() return Phase3_assertOccupied("NPC1", true) end,
        function() return Phase3_assertVirtualAnchor("NPC1") end,
        function() return Phase3_assertChairVisible("NPC1") end,
        function() return Phase3_assertChairHidden("NPC2") end,
        function() return Phase3_assertChairHidden("NPC3") end,
        function() return Phase3_assertChairHidden("NPC4") end,
      })
    end,
    function()
      printHeader("[HUMAN] Block 2 done — uncomment PlayerSeatAudit_P3_3() and re-Execute.", 3)
    end,
  })
end

function PlayerSeatAudit_P3_3()
  U.chain({
    function()
      printHeader("Phase 3 — Block 3: NPC1–3 on Table B3", 1)
    end,
    function()
      if type(syncTableSimplified) ~= "function" then
        Phase3_fail("syncTableSimplified missing — Save & Play after bundle")
        return
      end
      if not Phase3_assignNpcToSeat("NPC2", "adrianVarga") then
        return
      end
      if not Phase3_assignNpcToSeat("NPC3", "zuriOluwusi") then
        return
      end
    end,
    function()
      local computed = syncTableSimplified("Table B3", { force = true })
      if computed == nil then
        Phase3_fail("syncTableSimplified(Table B3) returned nil — loose dice on table?")
        return
      end
      Phase3_pass("syncTableSimplified(Table B3) ran")
    end,
    function()
      Phase3_assertAll({
        function() return Phase3_assertCurrentTable("Table B3") end,
        function() return Phase3_assertOccupied("NPC1", true) end,
        function() return Phase3_assertOccupied("NPC2", true) end,
        function() return Phase3_assertOccupied("NPC3", true) end,
        function() return Phase3_assertOccupied("NPC4", false) end,
        function() return Phase3_assertVirtualAnchor("NPC1") end,
        function() return Phase3_assertVirtualAnchor("NPC2") end,
        function() return Phase3_assertVirtualAnchor("NPC3") end,
        function() return Phase3_assertChairVisible("NPC1") end,
        function() return Phase3_assertChairVisible("NPC2") end,
        function() return Phase3_assertChairVisible("NPC3") end,
        function() return Phase3_assertChairHidden("NPC4") end,
        function() return Phase3_assertFigurineAtSeat("NPC1", "myleneHamelin") end,
        function() return Phase3_assertFigurineAtSeat("NPC2", "adrianVarga") end,
        function() return Phase3_assertFigurineAtSeat("NPC3", "zuriOluwusi") end,
      })
    end,
    function()
      printHeader("[HUMAN] Block 3 done — uncomment PlayerSeatAudit_P3_4() and re-Execute.", 3)
    end,
  })
end

function PlayerSeatAudit_P3_4()
  U.chain({
    function()
      printHeader("Phase 3 — Block 4: Summary", 1)
    end,
    function()
      local cur = S.getStateVal("seatLayout", "currentTableKey")
      local occ = S.getStateVal("seatLayout", "occupiedNPCSlots") or {}
      print("[Phase3] currentTableKey=" .. tostring(cur))
      for _, sk in ipairs(C.NPCSeats or {}) do
        print("[Phase3] occupiedNPCSlots." .. sk .. "=" .. tostring(occ[sk]))
      end
      printHeader("[Phase3] ALL PASS — Phase 3 matrix complete if every prior block showed PASS only.", 2)
      printHeader("[HUMAN] Uncomment PlayerSeatAudit_P4_1() to begin Phase 4 (PC simplified path).", 3)
    end,
  })
end

function PlayerSeatAudit_P4_1()
  U.chain({
    function()
      printHeader("Phase 4 — Block 1: PC seats on Table A", 1)
    end,
    function()
      Phase4_syncSimplified("Table A")
    end,
    function()
