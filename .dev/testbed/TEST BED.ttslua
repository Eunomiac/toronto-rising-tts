function unattachCamera(object, offset)
  player = Player.getPlayers()[1]
  if offset == nil then
    offset = Vector({0,0,0})
  end
  local tempObject = object.clone()
  player.attachCameraToObject({object = tempObject, offset = offset})
  tempObject.destroy()
end

-- Initial Player Camera: ThirdPerson mode, 20 units above origin, pitch/yaw/distance 0
function initCamera()
  player = Player.getPlayers()[1]
  player.setCameraMode("ThirdPerson")
  player.lookAt({position = Vector({0, 20, 0}), pitch = 0, yaw = 0, distance = 0})
end
initCamera()

-- Use Case #1: We want to change their Yaw and Position, then set to FirstPerson.
function useCase1()
  player = Player.getPlayers()[1]
  yaw = 180
  position = Vector({0, 90, 0})
  player.lookAt({position = position, pitch = 0, yaw = yaw, distance = 0})
  -- player.setCameraMode("FirstPerson")
end
useCase1()

-- Use Case #2: We want to change _only_ their Yaw, then set to FirstPerson.
function useCase2()
  player = Player.getPlayers()[1]
  yaw = 180
  player.lookAt({position = Vector({0, 20, 0}), pitch = 0, yaw = yaw, distance = 0})
  player.setCameraMode("FirstPerson")
end
useCase2()

-- Use Case #3: Using an attachment object to force a position change.
function useCase3(lookAtParameters)
  player = Player.getPlayers()[1]
  attachObject = getObjectFromGUID("207413")
  attachObject.setPosition(lookAtParameters.position)
  U.chain({
    function()
      player.attachCameraToObject({object = attachObject, offset = Vector({0, 0, 0})})
      return 0.25
    end,
    function()
      unattachCamera(attachObject)
      return 0.25
    end,
    function()
      player.lookAt(lookAtParameters)
    end
  })
end
useCase3({
  position = C.ReferenceCameraAngles.default.position,
  pitch = 0,
  yaw = 90,
  distance = 0
})
