end

local function ToggleSoundEmitters(override)
  local function isVisible(emitter)
    return emitter.getPosition().y > 0
  end

  local soundEmitters = {
    G.getObject(G.GUIDS.SOUNDSCAPE_MUSIC_A),
    G.getObject(G.GUIDS.SOUNDSCAPE_MUSIC_B),
    G.getObject(G.GUIDS.SOUNDSCAPE_MUSIC_C),
    G.getObject(G.GUIDS.SOUNDSCAPE_FEATURED_A),
    G.getObject(G.GUIDS.SOUNDSCAPE_FEATURED_B),
    G.getObject(G.GUIDS.SOUNDSCAPE_LOCATION_A),
    G.getObject(G.GUIDS.SOUNDSCAPE_LOCATION_B),
    G.getObject(G.GUIDS.SOUNDSCAPE_WEATHER_RAIN),
    G.getObject(G.GUIDS.SOUNDSCAPE_WEATHER_WIND),
    G.getObject(G.GUIDS.SOUNDSCAPE_WEATHER_THUNDER),
    G.getObject("5855d5"),
    G.getObject("81c6cf"),
  }

  for _, soundEmitter in ipairs(soundEmitters) do
    if soundEmitter ~= nil then
      local toggleState = not isVisible(soundEmitter)
      if override ~= nil then
        toggleState = override
      end
      if toggleState then
        soundEmitter.setPosition(Vector({ soundEmitter.getPosition().x, 5, soundEmitter.getPosition().z }))
      else
        soundEmitter.setPosition(Vector({ soundEmitter.getPosition().x, -100, soundEmitter.getPosition().z }))
      end
    end
  end
end

getObjectFromGUID("a0766e").setInvisibleTo({})

ToggleSoundEmitters()

function setObjectsInteractable(isInteractable)
  -- Default to true if not explicitly set to false
  if isInteractable == nil then isInteractable = true end

  for _, guid in ipairs(C.LockedObjects or {}) do
    local obj = G.getObject(guid)
    if obj ~= nil then
      obj.interactable = isInteractable
    end
  end
end

setObjectsInteractable(false)
