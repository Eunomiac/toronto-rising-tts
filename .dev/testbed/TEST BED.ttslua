function assignCardGMNotes(deckGUID, cardNames)
  local deck = getObjectFromGUID(deckGUID)
  assert(deck and deck.type == "Deck", "No deck found with GUID: " .. tostring(deckGUID))
  assert(type(cardNames) == "table", "cardNames must be a table.")

  -- Repeated indices are allowed because names are the unique keys.
  local entries = {}
  for name, index in pairs(cardNames) do
      assert(type(index) == "number" and index >= 1 and index % 1 == 0,
          "Card indices must be positive integers.")
      assert(type(name) == "string" and name ~= "", "Each card needs a name.")
      table.insert(entries, {index = index, name = name})
  end
  table.sort(entries, function(a, b)
      if a.index ~= b.index then return a.index < b.index end
      local first, second = a.name:lower(), b.name:lower()
      if first ~= second then return first < second end
      return a.name < b.name
  end)

  local data = deck.getData()
  local cards = data.ContainedObjects
  assert(cards and #cards > 0, "Deck has no contained card data.")
  assert(#cards == #entries,
      "Count mismatch: deck has " .. #cards .. " cards; table has " .. #entries .. ".")

  -- CardID = sheet identifier * 100 + zero-based sheet slot.
  -- Map by sheet slot, not current stack position, so shuffling is harmless.
  local sheet, seen = nil, {}
  for _, card in ipairs(cards) do
      local id = card.CardID
      assert(type(id) == "number" and id >= 0 and id % 1 == 0, "Invalid custom CardID.")
      local cardSheet = math.floor(id / 100)
      sheet = sheet or cardSheet
      assert(sheet == cardSheet, "Use one rarity sheet at a time, before combining decks.")
      local slot = id % 100 + 1
      assert(slot <= #entries and not seen[slot],
          "Expected one card per consecutive sheet slot, starting at slot 1.")
      seen[slot] = true
      local entry = entries[slot]
      -- Strip one trailing ASCII letter preceded by a space, e.g. " A".
      -- Other endings ("Three", "III", "A-C", etc.) remain intact.
      local cleanName = entry.name:gsub(" [A-Za-z]$", "")
      card.GMNotes = tostring(entry.index) .. ":" .. cleanName
  end

  -- Build the replacement safely above the original before removing it.
  local position = deck.getPosition()
  local wasLocked = deck.getLock()
  data.GUID = nil -- Request a new deck GUID; keep the contained card data.
  data.Locked = true
  return spawnObjectData({
      data = data,
      position = {x = position.x, y = position.y + 3, z = position.z},
      callback_function = function(replacement)
          destroyObject(deck)
          replacement.setPosition(position)
          replacement.setLock(wasLocked)
          print("Assigned GM Notes to " .. #cards ..
              " cards. Replacement deck GUID: " .. replacement.getGUID())
      end
  })
end

function assignEnhancedCardGMNotes(deckGUID, cardNames)
  local deck = getObjectFromGUID(deckGUID)
  assert(deck and deck.type == "Deck", "No deck found with GUID: " .. tostring(deckGUID))
  assert(type(cardNames) == "table", "cardNames must be a table.")

  -- Repeated indices are allowed because names are the unique keys.
  local entries = {}
  for name, index in pairs(cardNames) do
      assert(type(index) == "number" and index >= 1 and index % 1 == 0,
          "Card indices must be positive integers.")
      assert(type(name) == "string" and name ~= "", "Each card needs a name.")
      table.insert(entries, {index = index, name = name})
  end
  table.sort(entries, function(a, b)
      if a.index ~= b.index then return a.index < b.index end
      local first, second = a.name:lower(), b.name:lower()
      if first ~= second then return first < second end
      return a.name < b.name
  end)

  local data = deck.getData()
  local cards = data.ContainedObjects
  assert(cards and #cards > 0, "Deck has no contained card data.")
  assert(#cards == #entries,
      "Count mismatch: deck has " .. #cards .. " cards; table has " .. #entries .. ".")

  -- CardID = sheet identifier * 100 + zero-based sheet slot.
  -- Map by sheet slot, not current stack position, so shuffling is harmless.
  local sheet, seen = nil, {}
  for _, card in ipairs(cards) do
      local id = card.CardID
      assert(type(id) == "number" and id >= 0 and id % 1 == 0, "Invalid custom CardID.")
      local cardSheet = math.floor(id / 100)
      sheet = sheet or cardSheet
      assert(sheet == cardSheet, "Use one rarity sheet at a time, before combining decks.")
      local slot = id % 100 + 1
      assert(slot <= #entries and not seen[slot],
          "Expected one card per consecutive sheet slot, starting at slot 1.")
      seen[slot] = true
      local entry = entries[slot]
      -- Strip one trailing ASCII letter preceded by a space, e.g. " A".
      -- Other endings ("Three", "III", "A-C", etc.) remain intact.
      local cleanName = entry.name:gsub(" [A-Za-z]$", "")
      card.GMNotes = tostring(entry.index) .. ":" .. cleanName .. ":Enhanced"
  end

  -- Build the replacement safely above the original before removing it.
  local position = deck.getPosition()
  local wasLocked = deck.getLock()
  data.GUID = nil -- Request a new deck GUID; keep the contained card data.
  data.Locked = true
  return spawnObjectData({
      data = data,
      position = {x = position.x, y = position.y + 3, z = position.z},
      callback_function = function(replacement)
          destroyObject(deck)
          replacement.setPosition(position)
          replacement.setLock(wasLocked)
          print("Assigned GM Notes to " .. #cards ..
              " cards. Replacement deck GUID: " .. replacement.getGUID())
      end
  })
end


