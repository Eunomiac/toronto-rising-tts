  pitch = 0,
  yaw = 90,
  distance = 0
}
player.setCameraMode("ThirdPerson")
player.lookAt(lookAtParameters)
attachObject.setPosition(lookAtParameters.position)
player.setCameraMode("FirstPerson")
player.attachCameraToObject({object = attachObject})


