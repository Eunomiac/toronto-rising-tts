-- #region pixel-snap-coordinates
-- Photoshop coordinates are measured from the top-left of the image.
-- Local coordinates are measured from the center of the object.
-- Left/right follow X. Top/bottom follow Z.
SnapPixelCoordinates = {
  deck = {514, 383},
  discard = {2016, 383},
  slot1 = {262, 1085},
  slot2 = {763, 1085},
  slot3 = {1264, 1085},
  slot4 = {1765, 1085},
  slot5 = {2266, 1085},
  slot6 = {262, 1690},
  slot7 = {763, 1690},
  slot8 = {1264, 1690},
  slot9 = {1765, 1690},
  slot10 = {2266, 1690},
}

TargetBoardPixelSize = {2527, 2010}
TargetBoardLocalSize = {2.514, 2}

function DetermineLocalCoordinates(objGUID)
  local function formatNumber(n)
    local text = string.format("%.3f", n)
    local negative = string.sub(text, 1, 1) == "-"
    if negative then
      text = string.sub(text, 2)
    end
    text = string.gsub(text, "0+$", "")
    text = string.gsub(text, "%.$", "")
    if text == "" or text == "0" then
      return "0"
    end
    if negative then
      return "-" .. text
    end
    return text
  end

  local function encodeString(s)
    s = string.gsub(s, "\\", "\\\\")
    s = string.gsub(s, "\"", "\\\"")
    return "\"" .. s .. "\""
  end

  local function orderedNames(coords)
    local preferred = { "deck", "discard" }
    for i = 1, 10 do
      preferred[#preferred + 1] = "slot" .. tostring(i)
    end
    local seen = {}
    local names = {}
    for i = 1, #preferred do
      local name = preferred[i]
      if coords[name] ~= nil then
        names[#names + 1] = name
        seen[name] = true
      end
    end
    local extra = {}
    for name in pairs(coords) do
      if not seen[name] then
        extra[#extra + 1] = name
      end
    end
    table.sort(extra)
    for i = 1, #extra do
      names[#names + 1] = extra[i]
    end
    return names
  end

  if type(objGUID) ~= "string" or objGUID == "" then
    error("DetermineLocalCoordinates: pass the object's GUID string")
  end
  if getObjectFromGUID(objGUID) == nil then
    error("DetermineLocalCoordinates: no object with GUID " .. objGUID)
  end
  if type(TargetBoardPixelSize) ~= "table"
    or tonumber(TargetBoardPixelSize[1]) == nil
    or tonumber(TargetBoardPixelSize[2]) == nil
    or tonumber(TargetBoardPixelSize[1]) == 0
    or tonumber(TargetBoardPixelSize[2]) == 0
  then
    error("DetermineLocalCoordinates: set TargetBoardPixelSize to { width, height } in pixels")
  end
  if type(TargetBoardLocalSize) ~= "table"
    or tonumber(TargetBoardLocalSize[1]) == nil
    or tonumber(TargetBoardLocalSize[2]) == nil
  then
    error("DetermineLocalCoordinates: set TargetBoardLocalSize to { width, height } in local units")
  end
  if type(SnapPixelCoordinates) ~= "table" then
    error("DetermineLocalCoordinates: set SnapPixelCoordinates to a table of { x, y } pixel pairs")
  end

  local imageWidth = TargetBoardPixelSize[1]
  local imageHeight = TargetBoardPixelSize[2]
  local localWidth = TargetBoardLocalSize[1]
  local localHeight = TargetBoardLocalSize[2]
  local names = orderedNames(SnapPixelCoordinates)
  local localCoords = {}
  local outside = {}

  for i = 1, #names do
    local name = names[i]
    local pixel = SnapPixelCoordinates[name]
    if type(pixel) ~= "table" or tonumber(pixel[1]) == nil or tonumber(pixel[2]) == nil then
      error("DetermineLocalCoordinates: " .. tostring(name) .. " needs a { x, y } pixel pair")
    end
    local localX = ((pixel[1] / imageWidth) - 0.5) * localWidth
    local localZ = (0.5 - (pixel[2] / imageHeight)) * localHeight
    localCoords[name] = { x = localX, y = 0, z = localZ }
    if math.abs(localX) > math.abs(localWidth) / 2 + 0.001 or math.abs(localZ) > math.abs(localHeight) / 2 + 0.001 then
      outside[#outside + 1] = name
    end
  end

  local lines = {
    "{",
    "  \"guid\": " .. encodeString(objGUID) .. ",",
    "  \"pixelSize\": { \"x\": " .. formatNumber(imageWidth) .. ", \"y\": " .. formatNumber(imageHeight) .. " },",
    "  \"localSize\": { \"x\": " .. formatNumber(localWidth) .. ", \"z\": " .. formatNumber(localHeight) .. " },",
    "  \"snapPoints\": {",
  }
  for i = 1, #names do
    local name = names[i]
    local point = localCoords[name]
    local comma = i < #names and "," or ""
    lines[#lines + 1] = "    " .. encodeString(name) .. ": { \"x\": "
      .. formatNumber(point.x) .. ", \"y\": " .. formatNumber(point.y) .. ", \"z\": " .. formatNumber(point.z)
      .. " }" .. comma
  end
  lines[#lines + 1] = "  }"
  lines[#lines + 1] = "}"
  local body = table.concat(lines, "\n") .. "\n"

  local safeGuid = string.gsub(objGUID, "[^%w_%-]", "_")
  local relativePath = "snap-points/" .. safeGuid .. "-from-pixels.json"
  DEBUG.writeWorkspaceFile(relativePath, body, "none", true)

  local note = string.format(
    "DetermineLocalCoordinates: wrote %d points for %s from local size %s x %s. File .dev/.debug/%s",
    #names,
    objGUID,
    formatNumber(localWidth),
    formatNumber(localHeight),
    relativePath
  )
  if #outside > 0 then
    note = note .. ". Outside the board: " .. table.concat(outside, ", ")
  end
  print(note)
  return localCoords
end

DetermineLocalCoordinates("8f6e58")
-- #endregion

-- #region tag-deck-cards
--- Adds each tag to every card stored inside a deck. Cards in a deck are not live
--- objects, so this rewrites their saved data and rebuilds the deck in place.
--- The rebuilt deck gets a new GUID; the print line reports it.
function TagCardsInDeck(deckGuid, tags)
  local function trim(text)
    return (string.gsub(text, "^%s*(.-)%s*$", "%1"))
  end

  local function normalizeTags(raw)
    if type(raw) ~= "table" then
      error("TagCardsInDeck: pass a table-array of tag strings")
    end
    local out = {}
    local seen = {}
    for i = 1, #raw do
      local tag = raw[i]
      if type(tag) ~= "string" then
        error("TagCardsInDeck: tag " .. tostring(i) .. " is not a string")
      end
      tag = trim(tag)
      if tag == "" then
        error("TagCardsInDeck: tag " .. tostring(i) .. " is empty")
      end
      if not seen[tag] then
        seen[tag] = true
        out[#out + 1] = tag
      end
    end
    if #out == 0 then
      error("TagCardsInDeck: pass at least one tag")
    end
    return out
  end

  local function mergeTags(existing, toAdd)
    local merged = {}
    local seen = {}
    if type(existing) == "table" then
      for i = 1, #existing do
        local tag = existing[i]
        if type(tag) == "string" and tag ~= "" and not seen[tag] then
          seen[tag] = true
          merged[#merged + 1] = tag
        end
      end
    end
    local added = 0
    for i = 1, #toAdd do
      local tag = toAdd[i]
      if not seen[tag] then
        seen[tag] = true
        merged[#merged + 1] = tag
        added = added + 1
      end
    end
    return merged, added
  end

  if type(deckGuid) ~= "string" or deckGuid == "" then
    error("TagCardsInDeck: pass the deck GUID string")
  end

  local wanted = normalizeTags(tags)
  local deck = getObjectFromGUID(deckGuid)
  if deck == nil then
    error("TagCardsInDeck: no object with GUID " .. deckGuid)
  end

  local tagList = table.concat(wanted, ", ")

  -- A one-card deck collapses into a Card. Tag that card directly.
  if deck.type == "Card" then
    local added = 0
    for i = 1, #wanted do
      if not deck.hasTag(wanted[i]) then
        deck.addTag(wanted[i])
        added = added + 1
      end
    end
    print(string.format(
      "TagCardsInDeck: %s is a single card. Added %d new tag(s): %s",
      deckGuid,
      added,
      tagList
    ))
    return added
  end

  if deck.type ~= "Deck" then
    error("TagCardsInDeck: " .. deckGuid .. " is a " .. tostring(deck.type) .. ", not a deck")
  end

  local data = deck.getData()
  local cards = data and data.ContainedObjects
  if type(cards) ~= "table" or #cards == 0 then
    error("TagCardsInDeck: deck " .. deckGuid .. " has no contained cards")
  end

  local cardsChanged = 0
  local tagsAdded = 0
  for i = 1, #cards do
    local merged, added = mergeTags(cards[i].Tags, wanted)
    cards[i].Tags = merged
    tagsAdded = tagsAdded + added
    if added > 0 then
      cardsChanged = cardsChanged + 1
    end
  end

  if tagsAdded == 0 then
    print(string.format(
      "TagCardsInDeck: all %d cards in %s already have %s. Deck left unchanged.",
      #cards,
      deckGuid,
      tagList
    ))
    return 0
  end

  local position = deck.getPosition()
  local rotation = deck.getRotation()
  local wasLocked = deck.getLock()
  data.GUID = nil
  data.Locked = true

  spawnObjectData({
    data = data,
    position = { x = position.x, y = position.y + 3, z = position.z },
    rotation = { x = rotation.x, y = rotation.y, z = rotation.z },
    callback_function = function(replacement)
      destroyObject(deck)
      replacement.setPosition(position)
      replacement.setRotation(rotation)
      replacement.setLock(wasLocked)
      print(string.format(
        "TagCardsInDeck: added %s to %d of %d cards. The deck was rebuilt so those tags stay on the cards. Old GUID %s, new GUID %s.",
        tagList,
        cardsChanged,
        #cards,
        deckGuid,
        replacement.getGUID()
      ))
    end,
  })
end

