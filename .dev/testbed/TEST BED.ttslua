-- #region dump-global-xml-element
--- Read the live global UI (UI.getXml), keep the element with this id and everything inside it,
--- pretty-print it, and write .dev/.debug/debug_logs/global_xml_<id>.xml (same path each run).
function DumpGlobalXmlElement(elementId, relativePath)
  local function nextTag(xml, pos)
    local lt = string.find(xml, "<", pos, true)
    if lt == nil then
      return nil
    end
    local n = #xml
    if string.sub(xml, lt, lt + 3) == "<!--" then
      local endAt = string.find(xml, "-->", lt + 4, true)
      if endAt == nil then
        return n + 1, string.sub(xml, lt), lt
      end
      return endAt + 3, string.sub(xml, lt, endAt + 2), lt
    end
    if string.sub(xml, lt, lt + 8) == "<![CDATA[" then
      local endAt = string.find(xml, "]]>", lt + 9, true)
      if endAt == nil then
        return n + 1, string.sub(xml, lt), lt
      end
      return endAt + 3, string.sub(xml, lt, endAt + 2), lt
    end
    local i = lt + 1
    local quote = nil
    while i <= n do
      local b = string.byte(xml, i)
      if quote ~= nil then
        if b == quote then
          quote = nil
        end
      elseif b == 34 or b == 39 then
        quote = b
      elseif b == 62 then
        return i + 1, string.sub(xml, lt, i), lt
      end
      i = i + 1
    end
    return n + 1, string.sub(xml, lt), lt
  end

  local function parseTag(tag)
    if string.sub(tag, 1, 1) ~= "<" or string.sub(tag, 2, 2) == "!" or string.sub(tag, 2, 2) == "?" then
      return nil
    end
    if string.sub(tag, 1, 2) == "</" then
      local name = string.match(tag, "^</([%w_%-]+)")
      if name == nil then
        return nil
      end
      return { kind = "close", name = name }
    end
    local name = string.match(tag, "^<([%w_%-]+)")
    if name == nil then
      return nil
    end
    local kind = "open"
    if string.match(tag, "/%s*>$") ~= nil then
      kind = "empty"
    end
    local id = string.match(tag, '%sid%s*=%s*"([^"]*)"')
    if id == nil then
      id = string.match(tag, "%sid%s*=%s*'([^']*)'")
    end
    return { kind = kind, name = name, id = id }
  end

  local function extractElement(xml, id)
    local pos = 1
    local n = #xml
    local foundStart = nil
    local foundEnd = nil
    local matchCount = 0
    local depth = 0
    local matchName = nil
    while pos <= n do
      local nextPos, tag, startIndex = nextTag(xml, pos)
      if tag == nil then
        break
      end
      local info = parseTag(tag)
      if info ~= nil then
        if depth == 0 then
          if info.kind ~= "close" and info.id == id then
            matchCount = matchCount + 1
            if foundStart == nil then
              foundStart = startIndex
              if info.kind == "empty" then
                foundEnd = nextPos - 1
              else
                matchName = info.name
                depth = 1
              end
            end
          end
        elseif info.name == matchName then
          if info.kind == "open" then
            depth = depth + 1
          elseif info.kind == "close" then
            depth = depth - 1
            if depth == 0 then
              foundEnd = nextPos - 1
              matchName = nil
            end
          end
        end
      end
      pos = nextPos
    end
    if foundStart == nil then
      return nil, 0, false
    end
    local unclosed = foundEnd == nil
    if unclosed then
      foundEnd = n
    end
    return string.sub(xml, foundStart, foundEnd), matchCount, unclosed
  end

  if type(elementId) ~= "string" or elementId == "" then
    print("DumpGlobalXmlElement: pass the element id, for example DumpGlobalXmlElement(\"HUD_PANEL_PLAYER\")")
    return false
  end
  if UI == nil or type(UI.getXml) ~= "function" then
    print("DumpGlobalXmlElement: UI.getXml is not available")
    return false
  end
  if DEBUG == nil or type(DEBUG.prettyPrintXml) ~= "function" or type(DEBUG.writeWorkspaceFile) ~= "function" then
    print("DumpGlobalXmlElement: DEBUG.prettyPrintXml / writeWorkspaceFile missing — Save & Play first")
    return false
  end

  local fullXml = UI.getXml()
  if type(fullXml) ~= "string" or fullXml == "" then
    print("DumpGlobalXmlElement: UI.getXml() returned nothing")
    return false
  end

  local fragment, matchCount, unclosed = extractElement(fullXml, elementId)
  if fragment == nil then
    print("DumpGlobalXmlElement: no element with id=\"" .. elementId .. "\" in the global UI")
    return false
  end

  local safeId = string.gsub(elementId, "[^%w_%-]", "_")
  if type(relativePath) ~= "string" or relativePath == "" then
    relativePath = "debug_logs/global_xml_" .. safeId .. ".xml"
  end

  local headerLines = {
    "<!--",
    "  DumpGlobalXmlElement",
    "  elementId=" .. elementId,
    "  source=UI.getXml()",
    "  matches=" .. tostring(matchCount),
  }
  if unclosed then
    headerLines[#headerLines + 1] = "  warning=opening tag was not closed before the end of the global XML"
  end
  if matchCount > 1 then
    headerLines[#headerLines + 1] = "  note=more than one element uses this id; this file is the first one"
  end
  headerLines[#headerLines + 1] = "-->"
  headerLines[#headerLines + 1] = ""

  local body = table.concat(headerLines, "\n") .. DEBUG.prettyPrintXml(fragment)
  if string.sub(body, -1) ~= "\n" then
    body = body .. "\n"
  end
  local ok = DEBUG.writeWorkspaceFile(relativePath, body, "none", true)
  if ok then
    local extra = ""
    if matchCount > 1 then
      extra = string.format(" — %d elements share this id; file has the first", matchCount)
    end
    if unclosed then
      extra = extra .. " — element was not closed"
    end
    print(string.format(
      "DumpGlobalXmlElement: wrote .dev/.debug/%s (%d chars)%s",
      relativePath,
      #fragment,
      extra
    ))
  end
  return ok
end
