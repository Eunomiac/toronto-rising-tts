-- #region AUDIT OF D10 OBJECTS

function countD10PreloadObjects(tag)
  local objs = getObjectsWithTag(tag)
  local count = 0
  if objs ~= nil then
    count = #objs
  end
  print("Number of objects with tag '" .. tag .. "': " .. count)
  return count
end

-- countD10PreloadObjects("d10preload")
-- countD10PreloadObjects("d10")

function destroyObjectsWithTag(tag)
  local objs = getObjectsWithTag(tag)
  if objs ~= nil then
    for _, obj in ipairs(objs) do
      obj:destroy()
    end
  end
end

-- destroyObjectsWithTag("d10preload")
-- destroyObjectsWithTag("d10")

--- Print world Y for every object tagged `d10` (guid + name when available).
function printD10WorldYCoordinates()
  local objs = getObjectsWithTag("d10") or {}
  print(string.format("[TEST BED] d10 objects: %d", #objs))
  for i, obj in ipairs(objs) do
    if obj ~= nil and obj.getPosition ~= nil then
      local pos = obj.getPosition()
      local y = type(pos) == "table" and type(pos.y) == "number" and pos.y or nil
      local guid = obj.getGUID ~= nil and obj.getGUID() or "?"
      local name = obj.getName ~= nil and obj.getName() or "?"
      if y ~= nil then
        print(string.format("  [%d] y=%.4f  guid=%s  name=%s", i, y, tostring(guid), tostring(name)))
      else
        print(string.format("  [%d] y=?  guid=%s  name=%s", i, tostring(guid), tostring(name)))
      end
    end
  end
end

function checkLiveDice()
  for _, o in ipairs(getObjectsWithTag("d10") or {}) do
    local pos = o.getPosition()
    local x = string.format("%.2f", pos.x)
    local y = string.format("%.2f", pos.y)
    local z = string.format("%.2f", pos.z)
    print(o.getName() ..
    " (" .. o.getGUID() .. ") {" .. x .. ", " .. y .. ", " .. z .. "} TAGS: [" .. table.concat(o.getTags(), ", ") .. "]")
  end
end

