player.clearSelectedObjects()

player.lookAt({pitch = -20})


local function lookAt(angleRef)
  local lookAtParameters = {
    position = C.ReferenceCameraAngles[angleRef].position,
    pitch = C.ReferenceCameraAngles[angleRef].pitch,
    yaw = C.ReferenceCameraAngles[angleRef].yaw,
    distance = C.ReferenceCameraAngles[angleRef].distance
  }
  player.lookAt(lookAtParameters)
end

local chainFunctions = {}

for angleRef, angleData in pairs(C.ReferenceCameraAngles) do
  table.insert(chainFunctions, function()
    print("Looking at " .. angleRef)
    return 1
  end)
  table.insert(chainFunctions, function()
    lookAt(angleRef)
    return 3
  end)
end

lookAt("default")

U.chain(chainFunctions)



