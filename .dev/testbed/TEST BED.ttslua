-- #region attach-snap-points
function AttachSnapPoints(objGUID, snapPoints)
  local function vectorToTable(v)
    if v == nil then
      return nil
    end
    local x = tonumber(v.x)
    local y = tonumber(v.y)
    local z = tonumber(v.z)
    if x == nil then x = tonumber(v[1]) end
    if y == nil then y = tonumber(v[2]) end
    if z == nil then z = tonumber(v[3]) end
    if x == nil or y == nil or z == nil then
      return nil
    end
    return { x = x, y = y, z = z }
  end

  local function tagsToArray(tags, index, strict)
    if type(tags) ~= "table" then
      if strict then
        error("AttachSnapPoints: snap point " .. tostring(index) .. " tags must be a list of strings")
      end
      return nil
    end
    local out = {}
    for i = 1, #tags do
      local tag = tags[i]
      if type(tag) ~= "string" or tag == "" then
        if strict then
          error("AttachSnapPoints: snap point " .. tostring(index) .. " tag " .. tostring(i) .. " must be a non-empty string")
        end
      else
        out[#out + 1] = tag
      end
    end
    return out
  end

  local function isSnapPointList(value)
    if type(value) ~= "table" then
      return false
    end
    if value.position ~= nil then
      return false
    end
    local highest = 0
    for key in pairs(value) do
      if type(key) ~= "number" or key < 1 or key ~= math.floor(key) then
        return false
      end
      if key > highest then
        highest = key
      end
    end
    return highest == #value
  end

  local function pointForAssign(point, index)
    if type(point) ~= "table" then
      error("AttachSnapPoints: snap point " .. tostring(index) .. " is not a table")
    end
    local position = vectorToTable(point.position)
    if position == nil then
      error("AttachSnapPoints: snap point " .. tostring(index) .. " needs a position")
    end
    local assigned = { position = position }
    if point.rotation ~= nil then
      local rotation = vectorToTable(point.rotation)
      if rotation == nil then
        error("AttachSnapPoints: snap point " .. tostring(index) .. " has a rotation that is not a vector")
      end
      assigned.rotation = rotation
      assigned.rotation_snap = true
    elseif point.rotation_snap ~= nil then
      if type(point.rotation_snap) ~= "boolean" then
        error("AttachSnapPoints: snap point " .. tostring(index) .. " rotation_snap must be true or false")
      end
      assigned.rotation_snap = point.rotation_snap
    end
    if point.tags ~= nil then
      assigned.tags = tagsToArray(point.tags, index, true)
    end
    return assigned
  end

  -- Face corners in local space, relative to the object center.
  -- Left/right follow X. Top/bottom follow Z. Y stays 0 so the four points mirror around the center.
  local function faceCorners(size)
    local halfX = size.x / 2
    local halfZ = size.z / 2
    return {
      topLeft = { x = -halfX, y = 0, z = halfZ },
      topRight = { x = halfX, y = 0, z = halfZ },
      bottomLeft = { x = -halfX, y = 0, z = -halfZ },
      bottomRight = { x = halfX, y = 0, z = -halfZ },
    }
  end

  local function axisBox(bounds)
    if type(bounds) ~= "table" or bounds.size == nil then
      error("AttachSnapPoints: object returned no bounding box")
    end
    local size = vectorToTable(bounds.size)
    if size == nil then
      error("AttachSnapPoints: bounding box has no size")
    end
    return {
      size = size,
      offset = vectorToTable(bounds.offset) or { x = 0, y = 0, z = 0 },
      corners = faceCorners(size),
    }
  end

  local function divideByScale(component, scaleComponent, axis)
    if type(scaleComponent) ~= "number" or scaleComponent == 0 then
      error("AttachSnapPoints: cannot remove scale on " .. axis .. " because it is 0")
    end
    return component / scaleComponent
  end

  -- Rotation is taken out first (getBoundsNormalized), then each axis is divided by scale.
  -- That is the collider box the object would have at scale {1, 1, 1}.
  local function boxWithoutScale(box, scale)
    local size = {
      x = divideByScale(box.size.x, scale.x, "X"),
      y = divideByScale(box.size.y, scale.y, "Y"),
      z = divideByScale(box.size.z, scale.z, "Z"),
    }
    local offset = {
      x = divideByScale(box.offset.x, scale.x, "X"),
      y = divideByScale(box.offset.y, scale.y, "Y"),
      z = divideByScale(box.offset.z, scale.z, "Z"),
    }
    return {
      size = size,
      offset = offset,
      corners = faceCorners(size),
    }
  end

  -- Three decimal places, then drop leftover zeros: 106.699999 -> 106.7, not 106.700.
  local function formatNumber(n)
    local text = string.format("%.3f", n)
    local negative = string.sub(text, 1, 1) == "-"
    if negative then
      text = string.sub(text, 2)
    end
    text = string.gsub(text, "0+$", "")
    text = string.gsub(text, "%.$", "")
    if text == "" or text == "0" then
      return "0"
    end
    if negative then
      return "-" .. text
    end
    return text
  end

  local function formatVec(v)
    return formatNumber(v.x) .. ", " .. formatNumber(v.y) .. ", " .. formatNumber(v.z)
  end

  local function encodeString(s)
    s = string.gsub(s, "\\", "\\\\")
    s = string.gsub(s, "\"", "\\\"")
    s = string.gsub(s, "%c", function(ch)
      if ch == "\n" then return "\\n" end
      if ch == "\r" then return "\\r" end
      if ch == "\t" then return "\\t" end
      return string.format("\\u%04x", string.byte(ch))
    end)
    return "\"" .. s .. "\""
  end

  local function isVectorTable(t)
    local count = 0
    for key in pairs(t) do
      if key ~= "x" and key ~= "y" and key ~= "z" then
        return false
      end
      count = count + 1
    end
    return count == 3
  end

  local function isArrayTable(t)
    local count = 0
    for key in pairs(t) do
      if type(key) ~= "number" or key < 1 or key ~= math.floor(key) then
        return false
      end
      count = count + 1
    end
    return count == #t
  end

  local KEY_RANK = {
    guid = 1,
    name = 2,
    applied = 3,
    count = 4,
    scale = 5,
    boundingBox = 6,
    boundingBoxWithoutScale = 7,
    snapPoints = 8,
    size = 10,
    offset = 11,
    corners = 12,
    topLeft = 20,
    topRight = 21,
    bottomLeft = 22,
    bottomRight = 23,
    position = 30,
    rotation = 31,
    rotation_snap = 32,
    tags = 33,
    x = 40,
    y = 41,
    z = 42,
  }

  local function sortedKeys(t)
    local keys = {}
    for key in pairs(t) do
      keys[#keys + 1] = key
    end
    table.sort(keys, function(a, b)
      local rankA = KEY_RANK[a] or 1000
      local rankB = KEY_RANK[b] or 1000
      if rankA ~= rankB then
        return rankA < rankB
      end
      return tostring(a) < tostring(b)
    end)
    return keys
  end

  local encodeJson
  encodeJson = function(value, depth)
    local kind = type(value)
    if kind == "number" then
      return formatNumber(value)
    end
    if kind == "boolean" then
      return value and "true" or "false"
    end
    if kind == "string" then
      return encodeString(value)
    end
    if kind ~= "table" then
      error("AttachSnapPoints: cannot write a " .. kind .. " to the snap-point file")
    end
    if isVectorTable(value) then
      return "{ \"x\": " .. formatNumber(value.x)
        .. ", \"y\": " .. formatNumber(value.y)
        .. ", \"z\": " .. formatNumber(value.z) .. " }"
    end
    local pad = string.rep("  ", depth)
    local inner = string.rep("  ", depth + 1)
    if isArrayTable(value) then
      if #value == 0 then
        return "[]"
      end
      local lines = { "[" }
      for i = 1, #value do
        local comma = i < #value and "," or ""
        lines[#lines + 1] = inner .. encodeJson(value[i], depth + 1) .. comma
      end
      lines[#lines + 1] = pad .. "]"
      return table.concat(lines, "\n")
    end
    local keys = sortedKeys(value)
    if #keys == 0 then
      return "{}"
    end
    local lines = { "{" }
    for i = 1, #keys do
      local key = keys[i]
      local comma = i < #keys and "," or ""
      lines[#lines + 1] = inner
        .. encodeString(tostring(key))
        .. ": "
        .. encodeJson(value[key], depth + 1)
        .. comma
    end
    lines[#lines + 1] = pad .. "}"
    return table.concat(lines, "\n")
  end

  local function snapshotPoints(obj)
    local raw = obj.getSnapPoints() or {}
    local list = {}
    for i, point in ipairs(raw) do
      local entry = {}
      local position = vectorToTable(point.position)
      if position ~= nil then
        entry.position = position
      end
      if point.rotation ~= nil then
        local rotation = vectorToTable(point.rotation)
        if rotation ~= nil then
          entry.rotation = rotation
        end
      end
      if point.rotation_snap ~= nil then
        entry.rotation_snap = point.rotation_snap == true
      end
      if type(point.tags) == "table" then
        entry.tags = tagsToArray(point.tags, i, false) or {}
      end
      list[#list + 1] = entry
    end
    return list
  end

  if type(objGUID) ~= "string" or objGUID == "" then
    error("AttachSnapPoints: pass the object's GUID string")
  end
  local obj = getObjectFromGUID(objGUID)
  if obj == nil then
    error("AttachSnapPoints: no object with GUID " .. objGUID)
  end

  local applied = false
  if snapPoints ~= nil then
    if not isSnapPointList(snapPoints) then
      error("AttachSnapPoints: snapPoints must be a list, like { { position = { x = 0, y = 0, z = 0 } } }. An empty list clears the object.")
    end
    local assigned = {}
    for i = 1, #snapPoints do
      assigned[i] = pointForAssign(snapPoints[i], i)
    end
    local ok = obj.setSnapPoints(assigned)
    if ok == false then
      error("AttachSnapPoints: setSnapPoints returned false for " .. objGUID)
    end
    applied = true
  end

  local current = snapshotPoints(obj)
  local name = DEBUG.objectDisplayName(obj)
  local scale = vectorToTable(obj.getScale())
  if scale == nil then
    error("AttachSnapPoints: " .. objGUID .. " returned no scale")
  end
  if obj.getBoundsNormalized == nil then
    error("AttachSnapPoints: " .. objGUID .. " has no getBoundsNormalized")
  end
  local boundingBox = axisBox(obj.getBoundsNormalized())
  local boundingBoxWithoutScale = boxWithoutScale(boundingBox, scale)
  local safeGuid = string.gsub(objGUID, "[^%w_%-]", "_")
  local relativePath = "snap-points/" .. safeGuid .. ".json"
  local body = encodeJson({
    guid = objGUID,
    name = name,
    applied = applied,
    count = #current,
    scale = scale,
    boundingBox = boundingBox,
    boundingBoxWithoutScale = boundingBoxWithoutScale,
    snapPoints = current,
  }, 0)
  if string.sub(body, -1) ~= "\n" then
    body = body .. "\n"
  end
  DEBUG.writeWorkspaceFile(relativePath, body, "none", true)
  local boxNote = string.format(
    "size (%s); scale (%s); unit-scale size (%s)",
    formatVec(boundingBox.size),
    formatVec(scale),
    formatVec(boundingBoxWithoutScale.size)
  )
  if applied then
    print(string.format(
      "AttachSnapPoints: replaced snap points on %s (%s) with %d point(s). %s. Wrote .dev/.debug/%s",
      name,
      objGUID,
      #current,
      boxNote,
      relativePath
    ))
  else
    print(string.format(
      "AttachSnapPoints: left %s (%s) unchanged (%d point(s)). %s. Wrote .dev/.debug/%s",
      name,
      objGUID,
      #current,
      boxNote,
      relativePath
    ))
  end
  return current
end

