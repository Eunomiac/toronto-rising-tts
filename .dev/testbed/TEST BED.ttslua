-- #region set-pc-ambition
function SetPcAmbition(charKey, ambitionText)
  local function trim(s)
    if type(s) ~= "string" then
      return ""
    end
    return (string.match(s, "^%s*(.-)%s*$")) or ""
  end

  local function steamIdForCharKey(key)
    if type(key) ~= "string" or key == "" or type(C) ~= "table" or type(C.PlayerData) ~= "table" then
      return nil
    end
    for steamId, row in pairs(C.PlayerData) do
      if type(row) == "table" and row.charKey == key then
        return steamId
      end
    end
    return nil
  end

  local key = tostring(charKey or "")
  local text = trim(ambitionText)
  local steamId = steamIdForCharKey(key)
  if steamId == nil then
    print("[SetPcAmbition] No C.PlayerData row with charKey=" .. key)
    return false
  end

  local before = S.getStateVal("playerData", steamId, "ambition")
  S.setStateVal(text, "playerData", steamId, "ambition")
  local after = S.getStateVal("playerData", steamId, "ambition")
  print(string.format(
    "[SetPcAmbition] %s (%s): %q -> %q",
    key,
    tostring(steamId),
    tostring(before),
    tostring(after)
  ))
  return true
end

