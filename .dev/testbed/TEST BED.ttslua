-- #region get-player-camera-angles
function GetPlayerCameraAngles(color)
  -- Seat-layout camera presets already live in gameState (playerData[id].cameraAngles).
  -- No printToFile / logStateToFile round-trip is needed — read and return the tables.
  local CONFIG = {
    includeBlack = true,
    printResult = true,
  }

  local function copyAngle(src)
    if type(src) ~= "table" then
      return src
    end
    local pos = src.position
    local copied = {
      cameraMode = src.cameraMode,
      pitch = src.pitch,
      yaw = src.yaw,
      distance = src.distance,
    }
    if pos ~= nil then
      copied.position = {
        x = tonumber(pos.x) or tonumber(pos[1]) or 0,
        y = tonumber(pos.y) or tonumber(pos[2]) or 0,
        z = tonumber(pos.z) or tonumber(pos[3]) or 0,
      }
    end
    return copied
  end

  local function copyAngleMap(src)
    if type(src) ~= "table" then
      return nil
    end
    local out = {}
    for modeKey, modeVal in pairs(src) do
      out[modeKey] = copyAngle(modeVal)
    end
    return out
  end

  local function colorsToCollect()
    if type(color) == "string" and color ~= "" then
      return { color }
    end
    local list = {}
    for _, seat in ipairs(C.PlayerColors or {}) do
      list[#list + 1] = seat
    end
    if CONFIG.includeBlack then
      list[#list + 1] = "Black"
    end
    return list
  end

  local byColor = {}
  for _, seat in ipairs(colorsToCollect()) do
    local angles = copyAngleMap(S.getPlayerVal(seat, "cameraAngles"))
    if type(angles) == "table" then
      byColor[seat] = angles
    end
  end

  if CONFIG.printResult then
    DEBUG.printTable(byColor, "player camera angles")
  end
  return byColor
end

