-- #region tag-stranded-hand-cards
--- One-time recovery for cards parked before U.movePlayerHand tagged them: tags every locked
--- Card/Deck near a PARKED hand zone with LockedCard<Color>, so the next Absent-off restore
--- collects them. Does nothing unless the zone is parked (Y <= -195). Moves nothing.
function TagStrandedHandCards(color, radius)
  radius = radius or 16
  local tag = "LockedCard" .. color
  local hz = U.getHandZone(color)
  if hz == nil then
    print("[TagStrandedHandCards] no hand zone for " .. tostring(color))
    return
  end
  local hzPos = hz.getPosition()
  if hzPos.y > -195 then
    print(string.format("[TagStrandedHandCards] %s hand zone is not parked (y=%.2f); nothing to do", color, hzPos.y))
    return
  end
  local tagged = {}
  for _, o in ipairs(getObjects()) do
    local isCard = o.tag == "Card" or o.tag == "Deck" or o.type == "Card" or o.type == "Deck"
    if isCard and o.getLock() and o.getPosition().y <= -195
      and Vector.distance(Vector(o.getPosition()), Vector(hzPos)) <= radius then
      if not o.hasTag(tag) then
        o.addTag(tag)
      end
      tagged[#tagged + 1] = o.getGUID()
    end
  end
  print(string.format("[TagStrandedHandCards] %s: %d card(s) tagged %s: %s",
    color, #tagged, tag, table.concat(tagged, ", ")))
end

