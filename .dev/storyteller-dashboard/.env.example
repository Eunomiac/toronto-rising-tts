ASSET_REVIEW_WRITE_URL=
ASSET_REVIEW_WRITE_SECRET=
# Deck of Complications web app (TOR-796)
COMPLICATIONS_API_URL=https://toronto-rising-complications.toronto-rising-player-map.workers.dev
COMPLICATIONS_HOST_SECRET=
# Public Player Map live pins (Dashboard → Worker). Leave blank to disable the relay.
PLAYER_MAP_ENDPOINT=https://toronto-rising-player-map.<your-subdomain>.workers.dev
PLAYER_MAP_SESSION_CODE=
PLAYER_MAP_PUSH_SECRET=
