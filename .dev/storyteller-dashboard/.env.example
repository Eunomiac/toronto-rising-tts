OPENAI_VECTOR_STORE_ID=
OPENAI_TEXT_MODEL=gpt-4.1-mini
OPENAI_IMAGE_MODEL=gpt-image-1
PORT=8788
# NPC stat write-back to the Toronto Rising sheet (scripts/npc-stats/apps-script/Code.gs)
NPC_SHEET_WRITE_URL=
NPC_SHEET_WRITE_SECRET=
