--[[
    On-demand NPC figurine + paired light spawning (TOR-707).

    Named and generic NPCs share this spawner. Objects are created with one `spawnObjectData` call each
    (full `CustomImage` for figurines, `NPC_LIGHT_OBJECT_DATA_DEFAULTS` for lights) at the under-table park
    pose; `core/npcs.ttslua` hides them, records the instance, and moves them to their stage / seat / Scatter pose.

    Image URLs for every NPC (named, generic, Memoriam) come from generated `lib/npc_art_urls.ttslua`
    (`npm run npc-art:generate`, GitHub-hosted).
    Spec: .dev/NPC Object Spawning & Spotlighting/NPC Object Overview.md
]]

local U = require("lib.util")
local C = require("lib.constants")
local ART = require("lib.npc_art_urls")
local NLIGHT = require("lib.npcs_light_spawn_defaults")

local NpcSpawn = {}

NpcSpawn.TAG_FIG = "npc_figurine"
NpcSpawn.TAG_LIT = "npc_light"
NpcSpawn.TAG_GENERIC = "generic_npc"
NpcSpawn.GM_PREFIX = "npcInstance:"
NpcSpawn.LIGHT_NICKNAME_PREFIX = "NPC Light "

--- World offset from the figurine park pose to its light (keeps the pair apart while parked).
local LIGHT_PARK_OFFSET = { x = 3, y = 8, z = 3 }

--- @return table `{ x, y, z }` under-table park pose for freshly spawned figurines
function NpcSpawn.parkPosition()
    return { x = 0, y = C.HIDDEN_OBJECT_WORLD_Y, z = 0 }
end

--- Front / back figurine image URLs for one NPC key. Raises when the key has no art.
--- @param characterKey string
--- @return string front
--- @return string back
function NpcSpawn.figurineUrls(characterKey)
    local art = ART[characterKey]
    if type(art) ~= "table" then
        error(
            "[NpcSpawn] No art for "
                .. tostring(characterKey)
                .. " in lib/npc_art_urls.ttslua (add its figurine under assets/images/NPCs/, run npm run npc-art:generate, commit and push).",
            2
        )
    end
    return art.figurine.front, art.figurine.back
end

--- Spawn one `Figurine_Custom` at the park pose with images, identity, and lock set in the spawn data.
--- @param characterKey string
--- @param opts table `{ displayName: string, imageScalar: number, isGeneric?: boolean }`
--- @return Object
function NpcSpawn.spawnFigurine(characterKey, opts)
    local isGeneric = opts.isGeneric == true
    local front, back = NpcSpawn.figurineUrls(characterKey)
    local tags = { NpcSpawn.TAG_FIG }
    if isGeneric then
        tags[#tags + 1] = NpcSpawn.TAG_GENERIC
    end
    local park = NpcSpawn.parkPosition()
    ---@diagnostic disable-next-line: undefined-global
    local fig = spawnObjectData({
        data = {
            Name = "Figurine_Custom",
            Transform = {
                posX = park.x, posY = park.y, posZ = park.z,
                rotX = 0, rotY = 180, rotZ = 0,
                scaleX = 1, scaleY = 1, scaleZ = 1,
            },
            Nickname = opts.displayName,
            GMNotes = NpcSpawn.GM_PREFIX .. characterKey,
            Tags = tags,
            Locked = true,
            Tooltip = true,
            Hands = false,
            CustomImage = {
                ImageURL = front,
                ImageSecondaryURL = back,
                ImageScalar = opts.imageScalar,
                WidthScale = 0,
                CustomFigurine = { UseMinimalCollider = false, MirroredBack = false },
            },
        },
    })
    if fig == nil then
        error("[NpcSpawn] spawnObjectData returned nil for figurine " .. tostring(characterKey), 2)
    end
    return fig
end

--- Spawn the paired `npc_light` AssetBundle at the light park pose.
--- @param characterKey string
--- @return Object
function NpcSpawn.spawnLight(characterKey)
    local data = U.clone(NLIGHT.NPC_LIGHT_OBJECT_DATA_DEFAULTS, true)
    data.GUID = ""
    data.Nickname = NpcSpawn.LIGHT_NICKNAME_PREFIX .. tostring(characterKey)
    data.Tags = { NpcSpawn.TAG_LIT }
    local park = NpcSpawn.parkPosition()
    ---@diagnostic disable-next-line: undefined-global
    local lit = spawnObjectData({
        data = data,
        position = {
            park.x + LIGHT_PARK_OFFSET.x,
            park.y + LIGHT_PARK_OFFSET.y,
            park.z + LIGHT_PARK_OFFSET.z,
        },
    })
    if lit == nil then
        error("[NpcSpawn] spawnObjectData returned nil for light " .. tostring(characterKey), 2)
    end
    return lit
end

--- True once a spawned figurine has finished spawning and its custom image mesh has loaded.
--- @param fig Object|nil
--- @return boolean
function NpcSpawn.figurineLoaded(fig)
    return U.isGameObject(fig) and fig.spawning ~= true and fig.loading_custom ~= true
end

return NpcSpawn
