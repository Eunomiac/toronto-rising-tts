--[[
    Scene world reconcile (core/scenes.ttslua)

    Lighting intent is `sessionScene.lightingPresetKey` (a `C.LightModes` key); `currentScene` is a label only
    (`default`, `dark`, `standard`, `bright`). Also owns top fog, skybox, and the no-scene / Play-session restore.

    Integration: `U.applyLightingPreset` for ambient + `spotlights`.

    Agent guidance: .dev/TESTING.md (scene tests); .dev/AVAILABLE_FUNCTIONS.md.
]]

local Scenes = {}
local U = require("lib.util")
local S = require("core.state")
local C = require("lib.constants")
local G = require("lib.guids")
local Soundscape = require("core.soundscape")
local SceneLibrary = require("core.scene_library")
local RSL = require("lib.rotational-seat-layout")
local ChronicleWeather = require("lib.chronicle_weather")

--- Default table when no live library scene is on the table (TOR-151).
Scenes.DEFAULT_NO_SCENE_TABLE_KEY = "Table B"

--- Last scene+transition fingerprint successfully applied to the live world (incremental sync skips when unchanged).
local lastSceneReconcileFingerprint = nil
local lastTopFogReconcileFingerprint = nil
local lastSkyboxReconcileFingerprint = nil

--- AssetBundle fog emitters (`TOP_FOG`, `BOTTOM_FOG`): TTS UI “Looping Effect” 1/2 → API indexes 0/1.
Scenes.FOG_LOOP_OFF_INDEX = 0 -- Looping Effect 1 (inactive)
Scenes.FOG_LOOP_ON_INDEX = 1 -- Looping Effect 2 (active)

--- Play fog emitter looping effect. Does not use TTS object `setState`.
--- @param guid string|nil
--- @param active boolean
--- @param opts table|nil `{ label?: string, force?: boolean }`
--- @return boolean
function Scenes.applyFogEmitterLooping(guid, active, opts)
    opts = type(opts) == "table" and opts or {}
    local label = type(opts.label) == "string" and opts.label or "fog"
    if type(guid) ~= "string" or guid == "" then
        print("[Scenes] applyFogEmitterLooping: missing GUID for " .. label)
        return false
    end
    local obj = U.getObject(guid, true)
    if obj == nil then
        print("[Scenes] applyFogEmitterLooping: no object for " .. label .. " guid " .. guid)
        return false
    end
    local ab = obj.AssetBundle
    if ab == nil or type(ab.playLoopingEffect) ~= "function" then
        print("[Scenes] applyFogEmitterLooping: " .. label .. " has no AssetBundle.playLoopingEffect")
        return false
    end
    local wantIdx = active == true and Scenes.FOG_LOOP_ON_INDEX or Scenes.FOG_LOOP_OFF_INDEX
    if opts.force ~= true and type(ab.getLoopingEffectIndex) == "function" then
        local current = tonumber(ab.getLoopingEffectIndex())
        if current == wantIdx then
            return true
        end
    end
    ab.playLoopingEffect(wantIdx)
    return true
end

-- ============================================================================
-- HELPER FUNCTIONS
-- ============================================================================

--- Applies ambient lighting settings to TTS global lighting (and optional `spotlights` on `C.LightModes` rows).
--- @param ambientSettings table Table containing ambient lighting properties
-- @param transitionTime number Optional. Duration for smooth transition (0 = instant)
local function applyAmbientLighting(ambientSettings, transitionTime)
    if ambientSettings == nil then return end

    transitionTime = transitionTime or 0

    -- `C.LightModes` rows may include `spotlights` (registered refs → partial mode tables); those apply here too.
    -- Global Lighting fields still use `U.changeLighting` inside `U.applyLightingPreset`.
    U.applyLightingPreset(ambientSettings, { spotlightTransitionTime = transitionTime })
end

--- Trimmed `sessionScene.siteKey`, or `""` when absent.
--- @return string
local function trimmedSessionSiteKey()
    local siteKey = S.getStateVal("sessionScene", "siteKey")
    if type(siteKey) ~= "string" then
        return ""
    end
    return string.gsub(string.gsub(siteKey, "^%s+", ""), "%s+$", "")
end

--- Resolved default lighting preset when no narrative location is active.
--- @return string
local function resolveNoLocationLightingPresetKey()
    local defaultKey = C.DefaultNoLocationLightingPresetKey
    if type(defaultKey) ~= "string" or defaultKey == "" or not C.isValidLightModeKey(defaultKey) then
        defaultKey = "OutdoorDim"
    end
    return defaultKey
end

--- @return boolean
function Scenes.hasActiveSessionLocation()
    return trimmedSessionSiteKey() ~= ""
end

--- When `sessionScene.siteKey` is absent, persist the no-location default on `lightingPresetKey`.
--- @return boolean true when state was updated
function Scenes.syncSessionLightingPresetForLocation()
    if Scenes.hasActiveSessionLocation() then
        return false
    end
    local defaultKey = resolveNoLocationLightingPresetKey()
    local currentKey = S.getStateVal("sessionScene", "lightingPresetKey")
    if type(currentKey) == "string" then
        currentKey = string.gsub(string.gsub(currentKey, "^%s+", ""), "%s+$", "")
    else
        currentKey = ""
    end
    if currentKey == defaultKey then
        return false
    end
    S.setStateVal(defaultKey, "sessionScene", "lightingPresetKey")
    return true
end

--- Resolves ambient preset for reconciliation: Intermission dark → no-location default → lightingPresetKey → default.
--- @return table preset, string key, string source
function Scenes.resolveLightingPresetFromState()
    local phase = S.getStateVal("currentPhase")
    if phase == C.Phases.INTERMISSION and C.LightModes.AdminDark ~= nil then
        return C.LightModes.AdminDark, "AdminDark", "intermissionPhase"
    end

    local defaultKey = resolveNoLocationLightingPresetKey()

    if not Scenes.hasActiveSessionLocation() then
        return C.LightModes[defaultKey], defaultKey, "noLocationDefault"
    end

    local key = S.getStateVal("sessionScene", "lightingPresetKey")
    if type(key) == "string" then
        key = string.gsub(string.gsub(key, "^%s+", ""), "%s+$", "")
        if key ~= "" and C.isValidLightModeKey(key) then
            return C.LightModes[key], key, "lightingPresetKey"
        end
        if key ~= "" then
            print("[Scenes] Unknown sessionScene.lightingPresetKey: " .. key)
        end
    end

    return C.LightModes[defaultKey], defaultKey, "default"
end

-- ============================================================================
-- PUBLIC API
-- ============================================================================

--- Clears incremental scene reconcile memory so the next `reconcileFromState` always applies (e.g. world drift).
function Scenes.invalidateReconcileCache()
    lastSceneReconcileFingerprint = nil
    lastTopFogReconcileFingerprint = nil
    lastSkyboxReconcileFingerprint = nil
end

--- Reconciles top fog emitter from `sessionScene.isTopFogActive`.
--- AssetBundle Looping Effect 2 = on (index 1), Looping Effect 1 = off (index 0).
--- @param opts table|nil `{ force = boolean }`
--- @return boolean
function Scenes.reconcileTopFogFromState(opts)
    opts = type(opts) == "table" and opts or {}
    local force = opts.force == true

    local sessionScene = S.getStateVal("sessionScene")
    if type(sessionScene) ~= "table" then
        return true
    end
    local active = sessionScene.isTopFogActive == true
    local fp = active and "1" or "0"
    if not force and lastTopFogReconcileFingerprint == fp then
        return true
    end

    local guid = G.GUIDS and G.GUIDS.TOP_FOG
    local ok = Scenes.applyFogEmitterLooping(guid, active, {
        label = "TOP_FOG",
        force = force,
    })
    if ok then
        lastTopFogReconcileFingerprint = fp
    end
    return ok
end

--- Reconciles TTS table background (skybox) from `sessionScene.skyboxOverride` (catalog key or `"Generic"`)
--- or `sessionScene.siteKey` via `C.resolveSkyboxURLForSite` (site `skybox` key → `C.Skyboxes[key].url`, else random generic).
--- @param opts table|nil `{ force = boolean }`
--- @return boolean
function Scenes.reconcileSkyboxFromState(opts)
    opts = type(opts) == "table" and opts or {}
    local force = opts.force == true

    -- Memoriam: panel art URL from Cloud/catalog (TOR-101 / TOR-564), or the Just Smoke skybox (TOR-642).
    local Memoriam = require("core.memoriam")
    if Memoriam.isActive() then
        local mem = S.getStateVal("memoriam")
        local payload = type(mem) == "table" and mem.payload or nil
        local fingerprint = nil
        local resolveURL = nil
        if type(payload) == "table" and payload.justSmoke == true then
            fingerprint = "memoriam:justSmoke"
            resolveURL = Memoriam.justSmokeSkyboxURL
        elseif type(payload) == "table" and type(payload.skyboxKey) == "string" and type(payload.panel) == "string" then
            fingerprint = "memoriam:" .. payload.skyboxKey .. ":" .. payload.panel
            resolveURL = function()
                return C.resolveMemoriamPanelURL(payload.skyboxKey, payload.panel)
            end
        end
        if fingerprint ~= nil then
            if not force and lastSkyboxReconcileFingerprint == fingerprint then
                return true
            end
            local url = resolveURL()
            if Backgrounds == nil or type(Backgrounds.setCustomURL) ~= "function" then
                print("[Scenes] reconcileSkyboxFromState: Backgrounds.setCustomURL unavailable.")
                return false
            end
            local ok = Backgrounds.setCustomURL(url)
            if ok ~= true then
                print("[Scenes] reconcileSkyboxFromState: Backgrounds.setCustomURL failed for Memoriam `"
                    .. fingerprint .. "`.")
                return false
            end
            lastSkyboxReconcileFingerprint = fingerprint
            return true
        end
    end

    local override = S.getStateVal("sessionScene", "skyboxOverride")
    if type(override) == "string" then
        override = string.gsub(string.gsub(override, "^%s+", ""), "%s+$", "")
        if override == "" then
            override = nil
        end
    else
        override = nil
    end

    local siteKey = S.getStateVal("sessionScene", "siteKey")
    if type(siteKey) ~= "string" then
        siteKey = ""
    end
    siteKey = string.gsub(string.gsub(siteKey, "^%s+", ""), "%s+$", "")

    local url = nil
    local fingerprint = nil
    if type(override) == "string" then
        fingerprint = "override:" .. override
        if override == C.SKYBOX_GENERIC_KEY then
            url = C.pickRandomGenericSkyboxURL()
        else
            url = C.resolveSkyboxURLFromKey(override)
            if url == nil then
                print("[Scenes] reconcileSkyboxFromState: unknown skyboxOverride key `" .. override .. "`.")
                return false
            end
        end
    elseif siteKey ~= "" then
        url = C.resolveSkyboxURLForSite(siteKey)
        fingerprint = "site:" .. siteKey
    else
        lastSkyboxReconcileFingerprint = nil
        return true
    end

    if not force and lastSkyboxReconcileFingerprint == fingerprint then
        return true
    end

    if type(url) ~= "string" or url == "" then
        if type(override) == "string" then
            print("[Scenes] reconcileSkyboxFromState: no skybox URL for override `" .. override .. "`.")
        elseif siteKey ~= "" then
            print("[Scenes] reconcileSkyboxFromState: no skybox URL for site `" .. siteKey .. "`.")
        else
            print("[Scenes] reconcileSkyboxFromState: skyboxOverride is empty.")
        end
        return false
    end

    if Backgrounds == nil or type(Backgrounds.setCustomURL) ~= "function" then
        print("[Scenes] reconcileSkyboxFromState: Backgrounds.setCustomURL unavailable.")
        return false
    end

    local ok = Backgrounds.setCustomURL(url)
    if ok ~= true then
        if type(override) == "string" then
            print("[Scenes] reconcileSkyboxFromState: Backgrounds.setCustomURL failed for skyboxOverride `" .. override .. "`.")
        else
            print("[Scenes] reconcileSkyboxFromState: Backgrounds.setCustomURL failed for site `" .. siteKey .. "`.")
        end
        return false
    end

    lastSkyboxReconcileFingerprint = fingerprint
    return true
end

--- Reconciles live scene effects from persisted scene state.
--- This is the only scene module path that writes to the live world.
--- @param opts table|nil `{ force = boolean }` — when `force`, fingerprint short-circuit is skipped.
--- @return boolean
function Scenes.reconcileFromState(opts)
    opts = type(opts) == "table" and opts or {}
    local force = opts.force == true

    Scenes.syncSessionLightingPresetForLocation()

    local sceneName = Scenes.getCurrentScene()
    if type(sceneName) ~= "string" or sceneName == "" then
        sceneName = "default"
        S.setStateVal(sceneName, "currentScene")
    end
    local transition = S.getStateVal("sceneTransition")
    local transitionTime = 0
    local allowDelays = false
    if type(transition) == "table" then
        transitionTime = tonumber(transition.duration) or 0
        allowDelays = transition.allowDelays == true
    end

    local preset, presetKey, presetSource = Scenes.resolveLightingPresetFromState()
    local siteKey = trimmedSessionSiteKey()
    local desiredFingerprint = tostring(presetKey)
        .. "\t"
        .. tostring(presetSource)
        .. "\t"
        .. tostring(sceneName)
        .. "\t"
        .. siteKey
        .. "\t"
        .. tostring(transitionTime)
        .. "\t"
        .. (allowDelays and "1" or "0")

    if not force and lastSceneReconcileFingerprint == desiredFingerprint then
        require("lib.sync_trace").report("Scenes.reconcileFromState", {
            force = "false",
            outcome = "skipped",
        })
        return true
    end

    if preset ~= nil then
        applyAmbientLighting(preset, transitionTime)
    end

    lastSceneReconcileFingerprint = desiredFingerprint
    require("lib.sync_trace").report("Scenes.reconcileFromState", {
        force = tostring(force),
        outcome = "ran",
    })
    return true
end

--- Current scene label (`default`, `dark`, `standard`, `bright`); lighting intent is `sessionScene.lightingPresetKey`.
-- @return string|nil
function Scenes.getCurrentScene()
    return S.getStateVal("currentScene")
end

--- Initializes the scenes module
-- Called from global.ttslua onLoad().
function Scenes.onLoad()
    print("Scenes: Module loaded.")

    local savedScene = Scenes.getCurrentScene()
    if type(savedScene) ~= "string" or savedScene == "" then
        print("Scenes: No saved scene found, selecting default.")
        S.setStateVal("default", "currentScene")
    else
        print("Scenes: Restoring saved scene state: " .. savedScene)
    end
    S.setStateVal(nil, "sceneTransition")
    Scenes.syncSessionLightingPresetForLocation()
    Scenes.reconcileFromState()
end

--- State only: scene label back to `default`, no transition (Reset Game).
function Scenes.resetScene()
    S.setStateVal("default", "currentScene")
    S.setStateVal(nil, "sceneTransition")
end

-- ============================================================================
-- NO-SCENE DEFAULT + PLAY-SESSION RESTORE (TOR-151 / TOR-152)
-- ============================================================================

local LIVE_CLOCK_DATETIME_KEYS = { "hour", "minute", "day", "month", "year" }

--- @param s string|nil
--- @return string
local function trimSceneKey(s)
    if type(s) ~= "string" then
        return ""
    end
    return string.gsub(string.gsub(s, "^%s+", ""), "%s+$", "")
end

--- Overlay-only: stop real-time and clear live datetime fields (library / present-day clock untouched).
local function clearLiveClockDatetimeForOverlay()
    local ck = S.getStateVal("sessionScene", "clock")
    if type(ck) ~= "table" then
        ck = {}
    end
    ck.useRealTime = false
    for _, k in ipairs(LIVE_CLOCK_DATETIME_KEYS) do
        ck[k] = nil
    end
    S.setStateVal(ck, "sessionScene", "clock")
end

--- Activate all PC seats that are not Absent (`absentFromSession`).
--- Outside Play/Main, narrative presence should not leave scene-inactive piles parked.
--- Preserve per-seat `characterKey` / `tableSlot` / Absent flags when already authored.
local function applyDefaultPcSeatPresence()
    local seatSlots = S.getStateVal("sessionScene", "seatSlots")
    if type(seatSlots) ~= "table" then
        seatSlots = {}
    end
    local seatPresent = {}
    for _, color in ipairs(C.PlayerColors or {}) do
        local row = seatSlots[color]
        if type(row) ~= "table" then
            row = {}
        end
        local absent = row.absentFromSession == true
        row.isPresent = not absent
        row.isPlayingNPC = false
        row.npcCharacterKey = nil
        seatSlots[color] = row
        seatPresent[color] = not absent
    end
    local bundle = S.getStateVal("sessionScene") or {}
    bundle.seatSlots = seatSlots
    bundle.seatPresent = seatPresent
    SceneLibrary.syncNpcRoleOverrideFromSeatSlots(bundle)
    S.setStateVal(bundle, "sessionScene")
end

--- No-scene baseline: empty every NPC `seatSlots` row so `S.validateState` → `normalizeLiveSessionSceneSeatSlots`
--- does not re-hydrate `occupiedNPCSlots` from a prior scene's `characterKey` (that undid occupied-slot clear
--- and kept Table B resolving to B1+ with seated figurines). TOR-278 / TOR-389.
local function clearNpcSeatSlotsForNoScene()
    local seatSlots = S.getStateVal("sessionScene", "seatSlots")
    if type(seatSlots) ~= "table" then
        seatSlots = {}
    end
    for _, seatKey in ipairs(C.NPCSeats or {}) do
        seatSlots[seatKey] = { slotEmpty = true, isPresent = true }
    end
    local bundle = S.getStateVal("sessionScene") or {}
    bundle.seatSlots = seatSlots
    S.setStateVal(bundle, "sessionScene")
end

local function clearLiveNpcWorldPlacements()
    local npcWorld = S.getStateVal("sessionScene", "npcWorld")
    if type(npcWorld) ~= "table" then
        npcWorld = {}
    end
    npcWorld.placements = {}
    npcWorld.byArea = {}
    S.setStateVal(npcWorld, "sessionScene", "npcWorld")
end

--- Drop live stage rows, Scatter orbit rows, and the Scatter→table restore stash.
--- Leaving Scatter otherwise writes those NPCs back onto the stage (Play → Spotlight).
local function discardLiveNpcLayout()
    clearLiveNpcWorldPlacements()
    local ScatterLayout = require("lib.scatter_layout")
    if type(ScatterLayout.emptyPlacements) == "function" then
        S.setStateVal(ScatterLayout.emptyPlacements(), "sessionScene", "scatterPlacements")
    else
        S.setStateVal({}, "sessionScene", "scatterPlacements")
    end
    S.setStateVal(nil, "seatLayout", "scatterRestore")
    if S.getStateVal("sessionScene", "placementMode") == "scatter" then
        local Occupancy = require("lib.scatter_occupancy")
        local tableKey = S.getStateVal("seatLayout", "currentTableKey")
        local stillOnScatterTable = type(Occupancy.isScatterTableKey) == "function"
            and Occupancy.isScatterTableKey(tableKey) == true
        if not stillOnScatterTable then
            S.setStateVal("standard", "sessionScene", "placementMode")
        end
    end
end

function Scenes.discardLiveNpcLayout()
    discardLiveNpcLayout()
end

--- Persisted + eager apply: Main BGM only, no location/weather (TOR-151 / TOR-152 no-scene branch).
--- @param opts table|nil `{ skipMoodIfAlreadyMain?: boolean }` — skip restarting Main only when Main is already the audible BGM bed
local function mainMoodAlreadyAudible()
    if S.getStateVal("soundscape", "musicMood") ~= "main" then
        return false
    end
    -- Ravenwing-style sites: leftover mood key is still "main" while playlist none suppresses BGM
    -- and the location lane carries the bed — must call setMusicMood("main") to restore Main.
    if S.getStateVal("soundscape", "backgroundMusicSuppressed") == true then
        return false
    end
    if S.getStateVal("soundscape", "siteSilent") == true then
        return false
    end
    if S.getStateVal("soundscape", "backgroundMusicEnabled") ~= true then
        return false
    end
    -- Site-specific BGM playlist on the music lanes (not mood Main), even if musicMood was left at "main".
    if S.getStateVal("soundscape", "backgroundMusicMode") == "locationMusic" then
        return false
    end
    return true
end

local function applyMainOnlySoundscapeIntent(opts)
    opts = type(opts) == "table" and opts or {}
    local skipMood = opts.skipMoodIfAlreadyMain == true and mainMoodAlreadyAudible()
    S.setStateVal("main", "soundscape", "musicMood")
    S.setStateVal(nil, "soundscape", "lastAppliedSiteKey")
    S.setStateVal(nil, "soundscape", "lastAppliedDistrictKey")
    Soundscape.setLocationAudio("none")
    if not skipMood then
        Soundscape.setMusicMood("main")
    end
    Soundscape.setWeatherCondition("none")
    if type(Soundscape.silenceInactiveMusicChannel) == "function" then
        Soundscape.silenceInactiveMusicChannel()
    end
    if type(Soundscape.markReconciledToCurrentState) == "function" then
        Soundscape.markReconciledToCurrentState()
    end
    -- TOR-346: overlay reads lastApplied*; refresh after those keys clear (staged fadeIn path).
    local Sync = require("core.sync")
    if type(Sync.ui) == "function" then
        Sync.ui({ gameStateOverlay = true })
    end
end

--- Public wrapper for staged Play enter (fade window already open) or callers that deferred soundscape.
--- @param opts table|nil forwarded to `applyMainOnlySoundscapeIntent`
function Scenes.applyMainOnlySoundscape(opts)
    applyMainOnlySoundscapeIntent(opts)
end

--- Strip live narrative without the End-scene table/skybox/audio default (TOR-98 Spotlight enter).
--- Detach library, empty NPC world/seats, clear location/weather extras, stop the overlay ticker.
--- Does **not** set Table B0, pick a random generic skybox, or change Main music.
--- @param opts table|nil `{ reason?: string }`
--- @return boolean
function Scenes.clearLiveNarrativeForPhaseTransition(opts)
    opts = type(opts) == "table" and opts or {}
    -- TOR-101: when Memoriam LUT/overlay exists, reverse it here under the same cover.
    -- Downtime: when a dedicated clock/overlay ships, reverse it here (no Linear issue yet).

    local PresentDayClock = require("core.present_day_clock")
    if type(PresentDayClock.cancelCatchUpOnLiveClock) == "function" then
        PresentDayClock.cancelCatchUpOnLiveClock()
    end
    local flushKey = nil
    if type(SceneLibrary.resolveMirrorSceneKey) == "function" then
        flushKey = SceneLibrary.resolveMirrorSceneKey()
    end
    if type(flushKey) ~= "string" or flushKey == "" then
        flushKey = S.getStateVal("sceneLibrary", "lastAppliedKey")
    end
    if type(flushKey) == "string" and flushKey ~= "" and type(PresentDayClock.flushLibraryRowClock) == "function" then
        PresentDayClock.flushLibraryRowClock(flushKey)
    end

    SceneLibrary.detachLiveTableFromLibraryMirror()

    local StorytellerScenesPanel = require("core.storyteller_scenes_panel")
    if type(StorytellerScenesPanel.deselectPendingPreview) == "function" then
        StorytellerScenesPanel.deselectPendingPreview({ silent = true, clearActiveKey = true })
    end

    S.setStateVal(nil, "sessionScene", "districtKey")
    S.setStateVal(nil, "sessionScene", "siteKey")
    S.setStateVal({}, "sessionScene", "conditions")
    S.setStateVal({}, "sessionScene", "soundscapeNarrative")
    S.setStateVal(false, "sessionScene", "isTopFogActive")

    discardLiveNpcLayout()
    do
        local GenericNpcs = require("core.generic_npcs")
        GenericNpcs.destroyAllLiveAndClearMembership()
    end
    clearNpcSeatSlotsForNoScene()
    -- Outside Play/Main, inactive scene seats must come back (Spotlight enter path).
    applyDefaultPcSeatPresence()
    if type(SceneLibrary.syncOccupiedNpcSlotsFromSeatSlots) == "function" then
        SceneLibrary.syncOccupiedNpcSlotsFromSeatSlots(S.getStateVal("sessionScene"))
    end
    clearLiveClockDatetimeForOverlay()

    local GameStateOverlay = require("core.game_state_overlay")
    if type(GameStateOverlay.stopTicker) == "function" then
        GameStateOverlay.stopTicker()
    end
    if type(GameStateOverlay.resetRealTimeCarry) == "function" then
        GameStateOverlay.resetRealTimeCarry()
    end

    S.validateState()
    return true
end

--- Random generic skybox when no narrative site is active (TOR-151).
--- @return boolean
local function applyRandomGenericSkybox()
    local url = C.pickRandomGenericSkyboxURL()
    if type(url) ~= "string" or url == "" then
        return false
    end
    if Backgrounds == nil or type(Backgrounds.setCustomURL) ~= "function" then
        return false
    end
    local ok = Backgrounds.setCustomURL(url)
    if ok == true then
        lastSkyboxReconcileFingerprint = "__no_scene_generic__"
    end
    return ok == true
end

--- @return string[] seat colors whose hosted conditions changed
local function reconcileHostedConditionsSkipPresentation()
    return require("core.conditions").reconcileHostedForSession({ skipPresentation = true })
end

--- Announce seats whose hosted conditions changed (sheets, PCs row, dashboard push); run after
--- `Sync.full`, which already applied lights / overlays for every seat.
--- @param colors string[]
local function announceHostedConditionSeats(colors)
    local Sync = require("core.sync")
    for _, color in ipairs(colors) do
        Sync.player(color)
    end
end

--- @param reason string|nil
--- @param opts table|nil `{ skipSoundscape?: boolean }` — set when caller already eager-applied + primed soundscape
local function syncFullFromMutation(reason, opts)
    opts = type(opts) == "table" and opts or {}
    local Sync = require("core.sync")
    if type(Sync.full) == "function" then
        Sync.full({
            reason = reason or "scenes",
            skipSoundscape = opts.skipSoundscape == true,
        })
    end
end

--- Writes live `sessionScene` / `seatLayout` fields for the no-scene steady state (no world I/O).
--- @param opts table|nil `{ activateGenericSkybox?: boolean }`
local function mutateDefaultNoSceneSessionState(opts)
    opts = type(opts) == "table" and opts or {}
    S.setStateVal(Scenes.DEFAULT_NO_SCENE_TABLE_KEY, "sessionScene", "tableKey")
    S.setStateVal(nil, "sessionScene", "districtKey")
    S.setStateVal(nil, "sessionScene", "siteKey")
    if opts.activateGenericSkybox == true then
        S.setStateVal(C.SKYBOX_GENERIC_KEY, "sessionScene", "skyboxOverride")
    else
        S.setStateVal(nil, "sessionScene", "skyboxOverride")
    end
    S.setStateVal({}, "sessionScene", "conditions")
    S.setStateVal({}, "sessionScene", "soundscapeNarrative")
    S.setStateVal(false, "sessionScene", "isTopFogActive")
    S.setStateVal("OutdoorDim", "sessionScene", "lightingPresetKey")
    clearLiveNpcWorldPlacements()
    do
        local GenericNpcs = require("core.generic_npcs")
        GenericNpcs.destroyAllLiveAndClearMembership()
    end
    clearNpcSeatSlotsForNoScene()
    applyDefaultPcSeatPresence()
    SceneLibrary.syncOccupiedNpcSlotsFromSeatSlots(S.getStateVal("sessionScene"))
    clearLiveClockDatetimeForOverlay()
    Scenes.syncSessionLightingPresetForLocation()
    S.validateState()
end

--- Builds the merged soundscape context (site + narrative) for a sessionScene bundle without applying it.
--- @param sessionScene table|nil
--- @return table merged applyContext-style table
function Scenes.buildSoundscapeContextForSession(sessionScene)
    local merged = {}
    local sKey = trimSceneKey(type(sessionScene) == "table" and sessionScene.siteKey or nil)
    if sKey ~= "" then
        local site = C.Sites[sKey]
        if type(site) == "table" and type(Soundscape.contextFromSite) == "function" then
            merged = Soundscape.contextFromSite(site, sKey) or {}
        end
    end
    if type(Soundscape.mergeSessionSceneNarrativeIntoContext) == "function" then
        merged = Soundscape.mergeSessionSceneNarrativeIntoContext(sessionScene, merged)
    end
    return merged
end

--- Incoming rain/wind preview for a sessionScene bundle, for the blindfold-down fade-out comparison (TOR-147).
--- @param sessionScene table|nil
--- @return table `{ rain, rainVolume, wind, windVolume }`
function Scenes.computeIncomingWeatherPreview(sessionScene)
    local merged = Scenes.buildSoundscapeContextForSession(sessionScene)
    if type(Soundscape.previewIncomingWeather) == "function" then
        return Soundscape.previewIncomingWeather(merged)
    end
    return { rain = "none", rainVolume = 0, wind = "none", windVolume = 0 }
end

--- No-scene (End scene) ambient: Main music only, no location/weather. Exposed so the staged transition
--- can fade it in after the heavy default-environment reconcile completes (TOR-147).
function Scenes.applyNoSceneSoundscape()
    applyMainOnlySoundscapeIntent()
end

--- Soundscape for an on-table scene: site + narrative merge + chronicle weather when scheduled (TOR-152).
function Scenes.applyActiveSceneSoundscapeFromSession()
    local merged = Scenes.buildSoundscapeContextForSession(S.getStateVal("sessionScene"))

    local primeSoundscapeReconcile = false
    if type(Soundscape.applyContext) == "function" and next(merged) ~= nil then
        Soundscape.applyContext(merged)
        primeSoundscapeReconcile = true
    end
    -- A Storyteller weather override outranks a scene's authored weather until it lapses at dawn.
    if S.getStateVal("sessionScene", "chronicleWeatherManualHold") ~= true or ChronicleWeather.activeOverride() ~= nil then
        if type(ChronicleWeather.applyScheduledWeather) == "function" then
            ChronicleWeather.applyScheduledWeather({ force = false })
            primeSoundscapeReconcile = false
        end
    end
    if primeSoundscapeReconcile and type(Soundscape.markReconciledToCurrentState) == "function" then
        Soundscape.markReconciledToCurrentState()
    end
    if type(Soundscape.silenceInactiveMusicChannel) == "function" then
        Soundscape.silenceInactiveMusicChannel()
    end
    -- TOR-346: Sync.full(skipSoundscape) may have painted overlay from stale lastApplied*;
    -- re-reconcile after applyContext writes the new site keys (staged fadeIn).
    local Sync = require("core.sync")
    if type(Sync.ui) == "function" then
        Sync.ui({ gameStateOverlay = true })
    end
    require("dashboard.push").markWorldDirty({ soundscape = true, scene = true })
end

--- Applies the defined no-scene environment: Table B0 (dynamic Table B, zero NPC seats), five PCs, empty NPC world, OutdoorDim, Main only.
--- Does not mutate library rows, PC map pins, or present-day clock.
--- @param opts table|nil `{ reason?: string, skipTransitionBlindfold?: boolean, skipSoundscape?: boolean, activateGenericSkybox?: boolean, randomizeSeating?: boolean }`
---   `skipSoundscape` defers the Main ambient apply to the caller (staged transition fade-in, TOR-147).
---   `activateGenericSkybox` persists picker Generic (`C.SKYBOX_GENERIC_KEY`); `Sync.full` applies one random generic URL.
--- @return boolean
function Scenes.applyDefaultNoSceneEnvironment(opts)
    opts = type(opts) == "table" and opts or {}
    require("lib.sync_trace").report("Scenes.applyDefaultNoSceneEnvironment", {
        reason = tostring(opts.reason or ""),
        outcome = "ran",
    })

    -- Must detach before mutating live sessionScene / Sync.full, or `hasLiveSceneOnTable` stays true
    -- (overlay shows Jan 1 2026 defaults) and mirror would write cleared keys into the library row (TOR-362).
    SceneLibrary.detachLiveTableFromLibraryMirror()

    mutateDefaultNoSceneSessionState(opts)

    if opts.skipSoundscape ~= true then
        applyMainOnlySoundscapeIntent()
    end

    local tk = Scenes.DEFAULT_NO_SCENE_TABLE_KEY
    if C.Tables[tk] ~= nil or RSL.isDynamicTableFamilyKey(tk) then
        RSL.SetTableTo(tk, {
            skipTransitionBlindfold = opts.skipTransitionBlindfold == true,
            randomizeSeating = opts.randomizeSeating == true,
        })
    end

    if opts.activateGenericSkybox ~= true then
        applyRandomGenericSkybox()
    end
    local hostedChangedSeats = reconcileHostedConditionsSkipPresentation()

    local GameStateOverlay = require("core.game_state_overlay")
    if type(GameStateOverlay.stopTicker) == "function" then
        GameStateOverlay.stopTicker()
    end
    if type(GameStateOverlay.resetRealTimeCarry) == "function" then
        GameStateOverlay.resetRealTimeCarry()
    end

    syncFullFromMutation(opts.reason or "default_no_scene", { skipSoundscape = true })
    announceHostedConditionSeats(hostedChangedSeats)

    if type(GameStateOverlay.reconcileFromState) == "function" then
        GameStateOverlay.reconcileFromState()
    end

    -- TOR-293: disconnected PCs stay dark in no-scene even though narratively present.
    local PlayerConnection = require("core.player_connection")
    PlayerConnection.reconcileEffectivePresence(nil)

    return true
end

--- Reconciles the physical world to the persisted on-table `sessionScene` (load / Start→Play).
--- @param opts table|nil `{ reason?: string, skipTransitionBlindfold?: boolean }`
--- @return boolean
function Scenes.restoreActiveSceneWorld(opts)
    opts = type(opts) == "table" and opts or {}
    if SceneLibrary.hasLiveSceneOnTable() ~= true then
        return Scenes.applyDefaultNoSceneEnvironment(opts)
    end
    require("lib.sync_trace").report("Scenes.restoreActiveSceneWorld", {
        reason = tostring(opts.reason or ""),
        outcome = "ran",
    })

    local tk = trimSceneKey(S.getStateVal("sessionScene", "tableKey"))
    if tk ~= "" and (C.Tables[tk] ~= nil or RSL.isDynamicTableFamilyKey(tk)) then
        RSL.SetTableTo(tk, { skipTransitionBlindfold = opts.skipTransitionBlindfold == true })
    end

    Scenes.applyActiveSceneSoundscapeFromSession()
    local hostedChangedSeats = reconcileHostedConditionsSkipPresentation()

    local MapPins = require("core.map_pins")
    MapPins.onSceneApplied()

    local GameStateOverlay = require("core.game_state_overlay")
    if type(GameStateOverlay.resetRealTimeCarry) == "function" then
        GameStateOverlay.resetRealTimeCarry()
    end

    syncFullFromMutation(opts.reason or "restore_active_scene", { skipSoundscape = true })
    announceHostedConditionSeats(hostedChangedSeats)

    if type(GameStateOverlay.stopTicker) == "function" then
        GameStateOverlay.stopTicker()
    end
    if type(GameStateOverlay.ensureTicker) == "function" then
        GameStateOverlay.ensureTicker()
    end

    return true
end

--- Play entry: restore on-table scene or apply no-scene default (TOR-152 / TOR-143).
--- @param opts table|nil forwarded to restore/default helpers
--- @return boolean
function Scenes.reconcilePlaySessionOnEnter(opts)
    local phase = S.getStateVal("currentPhase")
    if phase ~= C.Phases.PLAY then
        return false
    end
    if SceneLibrary.hasLiveSceneOnTable() then
        return Scenes.restoreActiveSceneWorld(opts)
    end
    return Scenes.applyDefaultNoSceneEnvironment(opts)
end

return Scenes
