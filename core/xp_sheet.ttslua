--[[
  Page 6 Experience Log: paint, pagination, bake-mismatch warn.
  Global VM — called via GlobalPaintXpLogPage6 / GlobalXpLogNavigate.

  The mid-week bake lays out one row per gain and spend that existed then.
  Paint copies the live log into those rows (current session and older ones).
  A session or extra row the bake did not create stays stored and is warned once;
  it cannot appear until the next bake and Save & Play.
]]

local S = require("core.state")
local U = require("lib.util")
local C = require("lib.constants")
local CI = require("lib.csheet_identity")
local XD = require("lib.xp_display")
local XpLog = require("core.xp_log")
local Bake = require("lib.csheet_xp_log_baked")

local XpSheet = {}

--- @type table<string, boolean>
local warnedBakeMismatch = {}

--- One warning per seat and gap (a session, or a row overflow, the bake cannot draw).
--- @type table<string, boolean>
local warnedStructureGap = {}

--- Current-session overflow is warned once per seat (paint runs on any log edit).
--- @type table<string, boolean>
local warnedLiveCap = {}

local function bakePack()
  return Bake.getPack and Bake.getPack() or Bake
end

local function liveSessionId()
  local bake = bakePack()
  return math.floor(tonumber(bake.bakedForSessionNum) or 1)
end

--- @param color string
--- @return Object|nil
local function findPage6Object(color)
  local tag = CI.seatColorObjectTag(color)
  if tag == nil then
    return nil
  end
  local tagged = getObjectsWithTag(tag)
  if U.Type(tagged) ~= "table" then
    return nil
  end
  for i = 1, #tagged do
    local obj = tagged[i]
    if obj ~= nil and obj.getGMNotes ~= nil then
      local notes = tostring(obj.getGMNotes() or "")
      if notes:match("CSHEET_PAGE_6_") then
        return obj
      end
    end
  end
  return nil
end

--- @param obj Object
--- @param id string
--- @param attrs table
local function setObjAttrs(obj, id, attrs)
  if obj == nil or obj.UI == nil then
    return
  end
  if type(obj.UI.setAttributes) == "function" then
    obj.UI.setAttributes(id, attrs)
  else
    for k, v in pairs(attrs) do
      obj.UI.setAttribute(id, k, tostring(v))
    end
  end
end

--- @param pid string
--- @return string|nil
local function charKeyForPid(pid)
  local staticRow = C.PlayerData[pid]
  if U.Type(staticRow) == "table" and type(staticRow.charKey) == "string" and staticRow.charKey ~= "" then
    return staticRow.charKey
  end
  return nil
end

--- Baked older-session slot counts, keyed by session number.
--- The count is how many row elements the sheet XML actually has.
--- @param pid string
--- @return table<number, table>
local function bakedSessionsByNum(pid)
  local bake = bakePack()
  local ck = charKeyForPid(pid)
  local entry = ck and bake.byCharKey and bake.byCharKey[ck] or nil
  local sessions = entry and entry.sessions or {}
  local byNum = {}
  for i = 1, #sessions do
    local s = sessions[i]
    if type(s) == "table" then
      byNum[math.floor(tonumber(s.sessionNum) or 0)] = s
    end
  end
  return byNum
end

--- Rows the sheet can show: log length, capped by elements the bake created.
--- @param block table|nil
--- @param binName string
--- @param slotCap number
--- @return number
local function visibleBinCount(block, binName, slotCap)
  if block == nil or slotCap <= 0 then
    return 0
  end
  local rows = block[binName]
  local n = U.Type(rows) == "table" and #rows or 0
  if n > slotCap then
    return slotCap
  end
  return n
end

--- @param obj Object
--- @param token string
--- @param block table
--- @param sessionNum number
local function paintSessionHeader(obj, token, block, sessionNum)
  setObjAttrs(obj, "xp_sessionNum_" .. token, {
    text = XD.sessionTitleUpper(block.sessionDisplay, sessionNum),
  })
  setObjAttrs(obj, "xp_sessionDate_" .. token, {
    text = XD.formatShortDate(block.date),
  })
  setObjAttrs(obj, "xp_summation_" .. token, {
    text = XD.formatSummation(block.prevTotal, block.gainTotal, block.spendTotal),
  })
  setObjAttrs(obj, "xp_total_" .. token, {
    text = tostring(math.floor(tonumber(block.newTotal) or 0)) .. " XP",
  })
end

--- Fill or hide one side's existing row slots. `side` is "gain" or "spend".
--- @param obj Object
--- @param token string
--- @param side string
--- @param rows table
--- @param slotCap number
local function paintBinRows(obj, token, side, rows, slotCap)
  local itemPrefix = side == "spend" and "xp_item_right_" or "xp_item_left_"
  local numPrefix = side == "spend" and "xp_spendNum_" or "xp_gainNum_"
  local descPrefix = side == "spend" and "xp_spendDesc_" or "xp_gainDesc_"
  local sign = side == "spend" and "−" or "+"
  for i = 1, slotCap do
    local row = rows[i]
    local itemId = itemPrefix .. token .. "_" .. tostring(i)
    if row ~= nil then
      setObjAttrs(obj, itemId, { active = "true" })
      setObjAttrs(obj, numPrefix .. token .. "_" .. tostring(i), {
        text = sign .. tostring(row.amount) .. " XP",
      })
      setObjAttrs(obj, descPrefix .. token .. "_" .. tostring(i), {
        text = tostring(row.description or ""),
      })
    else
      setObjAttrs(obj, itemId, { active = "false" })
    end
  end
end

--- @param color string
--- @param detailKey string
--- @param message string
local function warnStructureGap(color, detailKey, message)
  local id = tostring(color) .. "\1" .. detailKey
  if warnedStructureGap[id] then
    return
  end
  warnedStructureGap[id] = true
  XpLog.warnStoryteller(message)
end

--- Build ordered session list for pagination (newest first): live + older sessions.
--- Older sessions use the live log, limited to the rows the bake created.
--- With no log table at all, keep the baked line counts so the sheet is not blanked.
--- @param pid string
--- @return table array of { sessionNum, lineCount, isLive }
local function buildSessionMeta(pid)
  local liveN = liveSessionId()
  local meta = {}
  local liveBlock = XpLog.getSessionBlock(pid, math.floor(tonumber(S.getStateVal("sessionNum")) or liveN))
  local liveGains = 0
  local liveSpends = 0
  if liveBlock ~= nil then
    liveGains = math.min(#(liveBlock.gains or {}), XD.LIVE_SLOT_CAP)
    liveSpends = math.min(#(liveBlock.spends or {}), XD.LIVE_SLOT_CAP)
  end
  -- Always include live shell (even empty) so title can show when entries exist.
  if liveGains > 0 or liveSpends > 0 then
    meta[#meta + 1] = {
      sessionNum = liveN,
      lineCount = XD.sessionLineCount(liveGains, liveSpends),
      isLive = true,
    }
  end

  local hasLog = U.Type(S.getStateVal("playerData", pid, "xp")) == "table"
  local baked = bakedSessionsByNum(pid)
  local finishedNums = {}
  for sn, _ in pairs(baked) do
    finishedNums[#finishedNums + 1] = sn
  end
  table.sort(finishedNums, function(a, b)
    return a > b
  end)
  local finished = {}
  for i = 1, #finishedNums do
    local sn = finishedNums[i]
    local s = baked[sn]
    -- Finished = any key below the live session (includes negative pre-session keys).
    if sn < liveN and type(s) == "table" then
      local gainSlots = math.floor(tonumber(s.gainCount) or 0)
      local spendSlots = math.floor(tonumber(s.spendCount) or 0)
      local g = gainSlots
      local sp = spendSlots
      if hasLog then
        local block = XpLog.getSessionBlock(pid, sn)
        g = visibleBinCount(block, "gains", gainSlots)
        sp = visibleBinCount(block, "spends", spendSlots)
      end
      if g > 0 or sp > 0 then
        finished[#finished + 1] = {
          sessionNum = sn,
          lineCount = XD.sessionLineCount(g, sp),
          isLive = false,
        }
      end
    end
  end
  table.sort(finished, function(a, b)
    return a.sessionNum > b.sessionNum
  end)
  for i = 1, #finished do
    meta[#meta + 1] = finished[i]
  end
  return meta
end

--- Pack sessions into pages of PAGE_LINE_BUDGET lines; sessions do not split.
--- @param meta table
--- @return table array of pages, each page = array of sessionNums
local function paginate(meta)
  local pages = {}
  local page = {}
  local used = 0
  for i = 1, #meta do
    local s = meta[i]
    local need = s.lineCount
    if need > XD.PAGE_LINE_BUDGET then
      need = XD.PAGE_LINE_BUDGET
    end
    if #page > 0 and used + need > XD.PAGE_LINE_BUDGET then
      pages[#pages + 1] = page
      page = {}
      used = 0
    end
    page[#page + 1] = s.sessionNum
    used = used + need
  end
  if #page > 0 then
    pages[#pages + 1] = page
  end
  if #pages == 0 then
    pages[1] = {}
  end
  return pages
end

local function warnBakeIfNeeded(color)
  local bake = bakePack()
  local stateSession = math.floor(tonumber(S.getStateVal("sessionNum")) or 1)
  local baked = math.floor(tonumber(bake.bakedForSessionNum) or 1)
  if stateSession == baked then
    return
  end
  local key = tostring(baked) .. "->" .. tostring(stateSession)
  if warnedBakeMismatch[key] then
    return
  end
  warnedBakeMismatch[key] = true
  XpLog.warnStoryteller(
    string.format(
      "Page 6 XP bake is for session %d but gameState sessionNum is %d. Run mid-week bake (npm run csheet-xp-log:bake) then Save & Play. Finished sessions since the last bake will not show on the sheet.",
      baked,
      stateSession
    )
  )
end

--- Paint live placeholder block from gameState current session into baked live ids.
--- @param obj Object
--- @param pid string
local function paintLiveBlock(obj, pid)
  local liveN = liveSessionId()
  local liveTok = XD.sessionIdToken(liveN)
  local stateSession = math.floor(tonumber(S.getStateVal("sessionNum")) or liveN)
  local block = XpLog.getSessionBlock(pid, stateSession)
  if block == nil then
    setObjAttrs(obj, "xp_title_line_" .. liveTok, { active = "false" })
    setObjAttrs(obj, "xp_listing_wrapper_" .. liveTok, { active = "false" })
    for i = 1, XD.LIVE_SLOT_CAP do
      setObjAttrs(obj, "xp_item_left_" .. liveTok .. "_" .. i, { active = "false" })
      setObjAttrs(obj, "xp_item_right_" .. liveTok .. "_" .. i, { active = "false" })
    end
    return
  end

  local gains = block.gains or {}
  local spends = block.spends or {}
  local hasEntries = #gains > 0 or #spends > 0
  if not hasEntries then
    setObjAttrs(obj, "xp_title_line_" .. liveTok, { active = "false" })
    setObjAttrs(obj, "xp_listing_wrapper_" .. liveTok, { active = "false" })
    return
  end

  -- Activate live shell here; applyPagination may refine which page is visible.
  setObjAttrs(obj, "xp_title_line_" .. liveTok, { active = "true" })
  setObjAttrs(obj, "xp_listing_wrapper_" .. liveTok, { active = "true" })
  paintSessionHeader(obj, liveTok, block, stateSession)
  paintBinRows(obj, liveTok, "gain", gains, XD.LIVE_SLOT_CAP)
  paintBinRows(obj, liveTok, "spend", spends, XD.LIVE_SLOT_CAP)

  if (#gains > XD.LIVE_SLOT_CAP or #spends > XD.LIVE_SLOT_CAP) and warnedLiveCap[pid] ~= true then
    warnedLiveCap[pid] = true
    XpLog.warnStoryteller(
      "More than " .. tostring(XD.LIVE_SLOT_CAP) .. " gain/spend lines this session — extras are hidden on page 6."
    )
  end
end

--- Apply which session blocks are active for the current page index.
--- @param obj Object
--- @param pid string
--- @param pageIndex number 1-based
local function applyPagination(obj, pid, pageIndex)
  local meta = buildSessionMeta(pid)
  local pages = paginate(meta)
  local page = pages[pageIndex] or pages[1] or {}
  local onPage = {}
  for i = 1, #page do
    onPage[page[i]] = true
  end

  local liveN = liveSessionId()
  local allNums = { liveN }
  for i = 1, #meta do
    allNums[#allNums + 1] = meta[i].sessionNum
  end
  -- Unique
  local seen = {}
  for i = 1, #allNums do
    local sn = allNums[i]
    if not seen[sn] then
      seen[sn] = true
      local tok = XD.sessionIdToken(sn)
      local active = onPage[sn] == true
      setObjAttrs(obj, "xp_title_line_" .. tok, { active = active and "true" or "false" })
      setObjAttrs(obj, "xp_listing_wrapper_" .. tok, { active = active and "true" or "false" })
    end
  end

  -- Bottom chevron (backward): older pages. Top chevron (forward): newer / toward page 1.
  local showOlder = pageIndex < #pages
  local showNewer = pageIndex > 1
  setObjAttrs(obj, "xp_navigate_backward", { active = showOlder and "true" or "false" })
  setObjAttrs(obj, "xp_navigate_forward", { active = showNewer and "true" or "false" })
end

--- Copy older sessions from the live log into the row elements the bake created.
--- Bounded by this seat's baked row counts. The page 6 fingerprint already skips
--- the call when the log has not changed. A page turn and the on-table repaint
--- still run, because an earlier paint can land before the sheet UI is ready.
--- @param obj Object
--- @param color string
--- @param pid string
local function paintFinishedFromState(obj, color, pid)
  local log = S.getStateVal("playerData", pid, "xp")
  if U.Type(log) ~= "table" then
    return
  end
  local liveN = liveSessionId()
  local stateSession = math.floor(tonumber(S.getStateVal("sessionNum")) or liveN)
  local baked = bakedSessionsByNum(pid)
  local bakedSeen = {}

  for sn, meta in pairs(baked) do
    if sn < liveN and type(meta) == "table" then
      bakedSeen[sn] = true
      local gainSlots = math.floor(tonumber(meta.gainCount) or 0)
      local spendSlots = math.floor(tonumber(meta.spendCount) or 0)
      local block = XpLog.getSessionBlock(pid, sn)
      local gains = block and block.gains or {}
      local spends = block and block.spends or {}
      local token = XD.sessionIdToken(sn)
      if block ~= nil and (#gains > 0 or #spends > 0) then
        paintSessionHeader(obj, token, block, sn)
      end
      paintBinRows(obj, token, "gain", gains, gainSlots)
      paintBinRows(obj, token, "spend", spends, spendSlots)
      if #gains > gainSlots or #spends > spendSlots then
        warnStructureGap(
          color,
          "rows-" .. tostring(sn),
          string.format(
            "Session %d has more Experience Log lines than this character sheet was built with. The extra lines are saved, but they stay hidden until you bake page 6 again (npm run csheet-xp-log:bake) and Save & Play.",
            sn
          )
        )
      end
    end
  end

  -- A brand-new older session has no XML yet. Skip this when the chronicle session
  -- has already moved past the bake — that case has its own warning.
  if stateSession ~= liveN then
    return
  end
  for key, block in pairs(log) do
    local sn = tonumber(key)
    if sn ~= nil and U.Type(block) == "table" then
      sn = math.floor(sn)
      local gains = block.gains or {}
      local spends = block.spends or {}
      if sn < liveN and not bakedSeen[sn] and (#gains > 0 or #spends > 0) then
        local title = block.sessionDisplay
        if type(title) ~= "string" or title == "" then
          title = "Session " .. tostring(sn)
        end
        warnStructureGap(
          color,
          "session-" .. tostring(sn),
          string.format(
            "%s is in the Experience Log but was not on the character sheet when it was last baked. It is saved. Bake page 6 again (npm run csheet-xp-log:bake) and Save & Play to show it.",
            title
          )
        )
      end
    end
  end
end

--- @param color string
--- @return boolean
function XpSheet.paintForColor(color)
  if type(color) ~= "string" or color == "" then
    return false
  end
  warnBakeIfNeeded(color)
  local pid = C.GetPlayerID(color)
  if type(pid) ~= "string" then
    return false
  end
  local obj = findPage6Object(color)
  if obj == nil then
    return false
  end
  paintLiveBlock(obj, pid)
  paintFinishedFromState(obj, color, pid)
  local pageIndex = math.floor(tonumber(S.getStateVal("playerData", pid, "xpLogPage")) or 1)
  if pageIndex < 1 then
    pageIndex = 1
  end
  applyPagination(obj, pid, pageIndex)
  return true
end

--- @param color string
--- @param direction string
---   "back" / "older" = bottom chevron (navigate_down) → older sessions (higher page index)
---   "forward" / "newer" = top chevron (navigate_up) → newer sessions (toward page 1)
--- @return boolean
function XpSheet.navigate(color, direction)
  if type(color) ~= "string" then
    return false
  end
  local pid = C.GetPlayerID(color)
  if type(pid) ~= "string" then
    return false
  end
  local meta = buildSessionMeta(pid)
  local pages = paginate(meta)
  local pageIndex = math.floor(tonumber(S.getStateVal("playerData", pid, "xpLogPage")) or 1)
  -- Visibility in applyPagination: backward when pageIndex < #pages, forward when pageIndex > 1.
  -- Match that: bottom/back = older, top/forward = newer.
  if direction == "back" or direction == "older" or direction == "backward" then
    pageIndex = pageIndex + 1
  elseif direction == "forward" or direction == "newer" then
    pageIndex = pageIndex - 1
  end
  if pageIndex < 1 then
    pageIndex = 1
  end
  if pageIndex > #pages then
    pageIndex = #pages
  end
  S.setStateVal(pageIndex, "playerData", pid, "xpLogPage")
  return XpSheet.paintForColor(color)
end

--- Parked page 6 should reopen on the newest session (page 1).
--- @param color string
--- @return boolean
function XpSheet.resetToFirstPage(color)
  if type(color) ~= "string" or color == "" then
    return false
  end
  local pid = C.GetPlayerID(color)
  if type(pid) ~= "string" then
    return false
  end
  S.setStateVal(1, "playerData", pid, "xpLogPage")
  return XpSheet.paintForColor(color)
end

return XpSheet
