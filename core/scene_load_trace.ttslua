--[[
    One-shot timing report for scene Preload, covered scene transitions, and Scatter group moves.

    Recording is off until one of those actions calls `start`. Ordinary reconcile and layout
    paths only check `isRecording()` and return. The host Lua time (`os.clock`) includes work
    that blocks inside a call, such as a figurine `reload()`. It does not include engine downloads
    that continue after the call returns, except where a chain step's wait is itself a mark.

    `finishAndPrint` prints one block and, inside Tabletop Simulator, rewrites
    `.dev/.debug/scene-load-report.txt` with the recent reports.
]]

local Trace = {}

local HISTORY_LIMIT = 6
local SLOW_NPC_MS = 50
local DETAIL_LIMIT = 30

local clockFn = os.clock
local history = {}
local open = nil
local nextId = 0

--- @param fn function|nil
function Trace._setClock(fn)
    clockFn = fn or os.clock
end

function Trace._reset()
    history = {}
    open = nil
    nextId = 0
end

--- Identity of the open report. A later action replaces it, so delayed callbacks must compare this
--- before finishing.
--- @return number|nil
function Trace.currentId()
    return open and open.id or nil
end

--- @return boolean
function Trace.isRecording()
    return open ~= nil
end

--- @return string|nil
function Trace.kind()
    return open and open.kind or nil
end

local function now()
    return clockFn()
end

local function roundMs(ms)
    return math.floor((tonumber(ms) or 0) + 0.5)
end

--- @param fields table|nil
--- @return string
local function fieldSuffix(fields)
    if type(fields) ~= "table" then
        return ""
    end
    local parts = {}
    if fields.count ~= nil then
        parts[#parts + 1] = "count " .. tostring(fields.count)
    end
    if fields.budgetSec ~= nil then
        local budget = tonumber(fields.budgetSec) or 0
        if budget <= 0 then
            parts[#parts + 1] = "image-wait budget already expired (" .. tostring(budget) .. "s)"
        else
            parts[#parts + 1] = "image-wait budget " .. tostring(budget) .. "s"
        end
    end
    if type(fields.detail) == "string" and fields.detail ~= "" then
        parts[#parts + 1] = fields.detail
    end
    if #parts == 0 then
        return ""
    end
    return " — " .. table.concat(parts, "; ")
end

local function copyFields(fields)
    local out = {}
    if type(fields) ~= "table" then
        return out
    end
    for key, value in pairs(fields) do
        out[key] = value
    end
    return out
end

local function remember(report)
    history[#history + 1] = report
    while #history > HISTORY_LIMIT do
        table.remove(history, 1)
    end
end

local function writeHistoryFile()
    ---@diagnostic disable-next-line: undefined-global
    if type(sendExternalMessage) ~= "function" then
        return
    end
    ---@diagnostic disable-next-line: undefined-global
    sendExternalMessage({
        type = "write",
        content = Trace.reportText(),
        name = "scene-load-report.txt",
        format = "none",
    })
end

--- Close the open report. Does not print.
--- @param fields table|nil
--- @return table|nil
function Trace.finish(fields)
    if open == nil then
        return nil
    end
    local ended = now()
    local extra = copyFields(fields)
    local report = open
    report.totalMs = (ended - report.t0) * 1000
    report.ok = extra.ok ~= false
    report.interrupted = extra.interrupted == true
    report.detail = extra.detail
    open = nil
    remember(report)
    return report
end

--- @param fields table|nil
--- @return table|nil
function Trace.finishAndPrint(fields)
    local report = Trace.finish(fields)
    if report == nil then
        return nil
    end
    print(Trace.format(report))
    writeHistoryFile()
    return report
end

--- Begin a report. An open report is closed and printed as interrupted.
--- @param kind string
--- @param fields table|nil `{ label?, note?, schedule? }`
--- @return table|nil interrupted report
function Trace.start(kind, fields)
    local interrupted = nil
    if open ~= nil then
        interrupted = Trace.finishAndPrint({
            ok = false,
            interrupted = true,
            detail = "interrupted by " .. tostring(kind),
        })
    end
    nextId = nextId + 1
    local t = now()
    open = {
        id = nextId,
        kind = tostring(kind or "timing"),
        fields = copyFields(fields),
        t0 = t,
        last = t,
        marks = {},
        npcs = {},
        npcOrder = {},
    }
    return interrupted
end

--- Wall time since the previous mark (or since start).
--- @param name string
--- @param fields table|nil `{ count?, budgetSec?, detail? }`
function Trace.mark(name, fields)
    if open == nil then
        return
    end
    local t = now()
    open.marks[#open.marks + 1] = {
        name = tostring(name or "mark"),
        ms = (t - open.last) * 1000,
        fields = copyFields(fields),
    }
    open.last = t
end

--- Merge one NPC observation into the open report.
--- Pass `ms` to count a call. Omit `ms` to refresh flags (for example image-load state after a wait)
--- without adding another call.
--- @param key string
--- @param fields table
function Trace.noteNpc(key, fields)
    if open == nil or type(key) ~= "string" or key == "" or type(fields) ~= "table" then
        return
    end
    local row = open.npcs[key]
    if row == nil then
        row = {
            key = key,
            calls = 0,
            ms = 0,
            reused = false,
            spawned = false,
            reloaded = false,
            parked = false,
            loading = false,
            spawning = false,
        }
        open.npcs[key] = row
        open.npcOrder[#open.npcOrder + 1] = key
    end
    if fields.ms ~= nil then
        row.calls = row.calls + 1
        row.ms = row.ms + (tonumber(fields.ms) or 0)
    end
    if fields.reused == true then row.reused = true end
    if fields.spawned == true then row.spawned = true end
    if fields.reloaded == true then row.reloaded = true end
    if fields.parked == true then row.parked = true end
    if fields.loading ~= nil then row.loading = fields.loading == true end
    if fields.spawning ~= nil then row.spawning = fields.spawning == true end
    if type(fields.action) == "string" then row.action = fields.action end
    if fields.areaKey ~= nil then row.areaKey = fields.areaKey end
    if fields.slot ~= nil then row.slot = fields.slot end
    if fields.imageScalar ~= nil then row.imageScalar = fields.imageScalar end
    if fields.targetScalar ~= nil then row.targetScalar = fields.targetScalar end
end

local function scalarMismatch(row)
    if type(row.imageScalar) ~= "number" or type(row.targetScalar) ~= "number" then
        return false
    end
    return math.abs(row.imageScalar - row.targetScalar) > 0.05
end

local function npcInteresting(row)
    return row.spawned == true
        or row.reloaded == true
        or row.loading == true
        or row.spawning == true
        or scalarMismatch(row)
        or (tonumber(row.ms) or 0) >= SLOW_NPC_MS
end

local function npcDetail(row)
    local flags = {}
    if type(row.action) == "string" and row.action ~= "" then
        flags[#flags + 1] = row.action
    end
    if row.spawned == true then flags[#flags + 1] = "spawned" end
    if row.reused == true then flags[#flags + 1] = "reused" end
    if row.parked == true then flags[#flags + 1] = "parked" end
    if row.reloaded == true then flags[#flags + 1] = "image reload" end
    if row.loading == true then flags[#flags + 1] = "still loading" end
    if row.spawning == true then flags[#flags + 1] = "still spawning" end
    if scalarMismatch(row) then
        flags[#flags + 1] = string.format("scalar %.3g→%.3g", row.imageScalar, row.targetScalar)
    end
    if row.calls > 1 then
        flags[#flags + 1] = tostring(row.calls) .. " calls"
    end
    return string.format("  NPC %-24s %6d ms  %s", row.key, roundMs(row.ms), table.concat(flags, ", "))
end

--- @param report table
--- @return string
function Trace.format(report)
    if type(report) ~= "table" then
        return "[SceneLoad] (empty)"
    end
    local fields = type(report.fields) == "table" and report.fields or {}
    local label = type(fields.label) == "string" and fields.label ~= "" and (" " .. fields.label) or ""
    local status = ""
    if report.interrupted == true then
        status = " INTERRUPTED"
    elseif report.ok == false then
        status = " FAILED"
    end
    local lines = {
        string.format("[SceneLoad] %s%s — %d ms%s", tostring(report.kind or "timing"), label, roundMs(report.totalMs), status),
    }
    if type(fields.schedule) == "string" and fields.schedule ~= "" then
        lines[#lines + 1] = "  " .. fields.schedule
    end
    if type(fields.note) == "string" and fields.note ~= "" then
        lines[#lines + 1] = "  " .. fields.note
    end
    if type(report.detail) == "string" and report.detail ~= "" then
        lines[#lines + 1] = "  " .. report.detail
    end
    local marks = type(report.marks) == "table" and report.marks or {}
    for i = 1, #marks do
        local mark = marks[i]
        lines[#lines + 1] = string.format(
            "  %6d ms  %s%s",
            roundMs(mark.ms),
            tostring(mark.name or "mark"),
            fieldSuffix(mark.fields)
        )
    end
    local npcs = type(report.npcs) == "table" and report.npcs or {}
    local order = type(report.npcOrder) == "table" and report.npcOrder or {}
    if #order > 0 then
        local calls, reused, spawned, parked, reloaded, loading, spawning, mismatch, npcMs = 0, 0, 0, 0, 0, 0, 0, 0, 0
        local interesting = {}
        for i = 1, #order do
            local row = npcs[order[i]]
            if type(row) == "table" then
                calls = calls + (row.calls or 0)
                npcMs = npcMs + (row.ms or 0)
                if row.reused then reused = reused + 1 end
                if row.spawned then spawned = spawned + 1 end
                if row.parked then parked = parked + 1 end
                if row.reloaded then reloaded = reloaded + 1 end
                if row.loading then loading = loading + 1 end
                if row.spawning then spawning = spawning + 1 end
                if scalarMismatch(row) then mismatch = mismatch + 1 end
                if npcInteresting(row) then
                    interesting[#interesting + 1] = row
                end
            end
        end
        lines[#lines + 1] = string.format(
            "  NPCs: %d calls, reused %d, spawned %d, parked %d, image reload %d, still loading %d, still spawning %d, scalar mismatch %d, NPC Lua time %d ms",
            calls, reused, spawned, parked, reloaded, loading, spawning, mismatch, roundMs(npcMs)
        )
        table.sort(interesting, function(a, b)
            return (tonumber(a.ms) or 0) > (tonumber(b.ms) or 0)
        end)
        local shown = math.min(#interesting, DETAIL_LIMIT)
        for i = 1, shown do
            lines[#lines + 1] = npcDetail(interesting[i])
        end
        if #interesting > shown then
            lines[#lines + 1] = "  … " .. tostring(#interesting - shown) .. " more NPCs omitted"
        end
    end
    return table.concat(lines, "\n")
end

--- @return string
function Trace.reportText()
    if #history == 0 then
        return "[SceneLoad] No scene, preload, or Scatter timing has been recorded yet."
    end
    local chunks = {}
    for i = 1, #history do
        chunks[#chunks + 1] = Trace.format(history[i])
    end
    return table.concat(chunks, "\n\n")
end

--- @return table
function Trace.history()
    return history
end

return Trace
