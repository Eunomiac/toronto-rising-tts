--[[
    Spotlight tokens on the Stage Control board are retired.

    `reconcileFromState` destroys any token still tagged for the old hold-to-spotlight
    hotkey. It does not spawn replacements. Each staged NPC keeps its one normal light;
    that light is not a separate spotlight-only object.
]]

local StageTokens = {}

local C = require("lib.constants")
local G = require("lib.guids")
local U = require("lib.util")
local DATA = require("lib.npc_gameboard_data")
local ART = require("lib.npc_art_urls")
local Board = require("core.npc_gameboard_board")
local ScatterOccupancy = require("lib.scatter_occupancy")
local Pool = require("core.npc_preload_pool")

local TAG = DATA.TAG_STAGE_TOKEN
local OFFSTAGE_TAG = "stage_token_offstage"
local OFFSTAGE_ROW = {}
local GM_PREFIX = DATA.TOKEN_GM_PREFIX
local TOKEN_LIFT_LOCAL_Y = 0.05
--- World units between token centers in a row, extra gap between stage areas, and between rows.
local TOKEN_SPACING = 3
local AREA_GAP = 1
local ROW_SPACING = 3
--- World units from the board's edge to the first token center.
local EDGE_MARGIN = 2
--- Spare slots past the sorted layout, for a newcomer whose slot an older token still holds.
local SPARE_SLOTS = 16

--- @type table<string, string>|nil characterKey → token GUID; rebuilt from the tag on the first pass after load.
local tokenGuidByKey = nil
--- @type table<string, string> characterKey → row signature last applied to the world.
local appliedSigByKey = {}

--- @return table
local function stateModule()
    return require("core.state")
end

--- @param obj Object|nil
--- @return string|nil characterKey
local function characterKeyForToken(obj)
    if not U.isGameObject(obj) or obj.hasTag == nil or obj.hasTag(TAG) ~= true then
        return nil
    end
    local notes = obj.getGMNotes and obj.getGMNotes() or ""
    if type(notes) ~= "string" or string.sub(notes, 1, #GM_PREFIX) ~= GM_PREFIX then
        return nil
    end
    local key = string.sub(notes, #GM_PREFIX + 1)
    return key ~= "" and key or nil
end

--- @param key string
--- @return table|nil `{ front, back }`
local function tokenArt(key)
    local art = ART[key]
    if type(art) ~= "table" then
        return nil
    end
    return art.token
end

--- @param obj Object
--- @param key string
--- @return boolean true when the saved token still shows the NPC's current art at the current scale
local function tokenCurrent(obj, key)
    local art = tokenArt(key)
    local custom = obj.getCustomObject()
    return art ~= nil
        and type(custom) == "table"
        and custom.image == art.front
        and custom.image_bottom == art.back
        and math.abs(obj.getScale().x - DATA.STAGE_TOKEN_SCALE.x) < 0.01
end

--- Cold path: once per load, adopt tokens already on the table. Duplicates, and tokens whose art or
--- scale has changed since they were spawned, are destroyed so the next pass respawns them.
local function ensureIndex()
    if tokenGuidByKey ~= nil then
        return
    end
    tokenGuidByKey = {}
    appliedSigByKey = {}
    for _, obj in ipairs(getObjectsWithTag(TAG) or {}) do
        local key = characterKeyForToken(obj)
        if key == nil or tokenGuidByKey[key] ~= nil or not tokenCurrent(obj, key) then
            obj.destruct()
        else
            tokenGuidByKey[key] = obj.getGUID()
            obj.tooltip = true
            obj.setInvisibleTo(C.HideFromPcSeatsAndSpectators)
        end
    end
end

--- @param key string
--- @return string
local function displayName(key)
    local def = require("core.npcs").characters[key]
    return type(def) == "table" and (def.fullName or def.name) or key
end

--- The only part of a placement row a token follows after spawning.
--- @param row table placement row
--- @return string
local function rowSig(key, row)
    local art = tokenArt(key)
    local presentation = row == OFFSTAGE_ROW and "offstage" or tostring(row.npcLightMode)
    return presentation .. "|" .. tostring(art and art.front or "")
end

--- @param row table
--- @return Vector face up when lit, face down when dark
local function tokenRotation(row)
    return Vector(0, 0, row.npcLightMode ~= "OFF" and 0 or 180)
end

--- Apply the board role when spawning a token or moving it between stage and offstage.
local function applyRole(obj, key, row)
    local offstage = row == OFFSTAGE_ROW
    obj.setName(displayName(key) .. (offstage and " (Offstage)" or ""))
    if offstage then
        obj.addTag(OFFSTAGE_TAG)
    else
        obj.removeTag(OFFSTAGE_TAG)
    end
    obj.setLock(offstage)
end

--- Row slots for the stage cast and a separate column for parked preload NPCs.
--- @param board Object
--- @param rows table
--- @return table<string, Vector> slotByKey
--- @return Vector[] stageSpare
--- @return function offstageSlot
local function layoutSlots(board, rows)
    local entries = {}
    local offstage = {}
    for key, row in pairs(rows) do
        if row == OFFSTAGE_ROW then
            offstage[#offstage + 1] = { key = key, name = displayName(key) }
        else
            local area = ScatterOccupancy.polarAreaNameAt(row.u, row.v)
            entries[#entries + 1] = {
                key = key,
                rank = area and ScatterOccupancy.polarAreaRank(area) or math.huge,
                name = displayName(key),
            }
        end
    end
    table.sort(entries, function(a, b)
        if a.rank ~= b.rank then
            return a.rank < b.rank
        end
        if a.name ~= b.name then
            return a.name < b.name
        end
        return a.key < b.key
    end)
    table.sort(offstage, function(a, b)
        if a.name ~= b.name then return a.name < b.name end
        return a.key < b.key
    end)
    local bounds = board.getBounds()
    local leftX = bounds.center.x + bounds.size.x / 2 - EDGE_MARGIN
    local rightX = bounds.center.x - bounds.size.x / 2 + EDGE_MARGIN
    local stageRightX = #offstage > 0 and math.min(leftX, rightX + TOKEN_SPACING + AREA_GAP) or rightX
    local y = Board.worldOnControlBoard(board, 0.5, 0.5, { extraLocalY = TOKEN_LIFT_LOCAL_Y }).y
    local firstZ = bounds.center.z - bounds.size.z / 2 + EDGE_MARGIN
    local rowsPerColumn = math.max(1, math.floor((bounds.size.z - 2 * EDGE_MARGIN) / ROW_SPACING) + 1)
    local x = leftX
    local z = firstZ
    local function offstageSlot(index)
        local col = math.floor((index - 1) / rowsPerColumn)
        local row = (index - 1) % rowsPerColumn
        -- Locked overflow tiles continue beside the board if its right column is full.
        local offstageX = col == 0 and rightX or rightX - 2 * EDGE_MARGIN - col * TOKEN_SPACING
        return Vector(offstageX, y, firstZ + row * ROW_SPACING)
    end
    local function nextSlot(gap)
        x = x - gap
        if x < stageRightX then
            x = leftX
            z = z + ROW_SPACING
        end
        local slot = Vector(x, y, z)
        x = x - TOKEN_SPACING
        return slot
    end
    local slotByKey = {}
    local prevRank = nil
    for _, entry in ipairs(entries) do
        slotByKey[entry.key] = nextSlot((prevRank ~= nil and entry.rank ~= prevRank) and AREA_GAP or 0)
        prevRank = entry.rank
    end
    for index, entry in ipairs(offstage) do
        slotByKey[entry.key] = offstageSlot(index)
    end
    local spare = {}
    for i = 1, SPARE_SLOTS do
        spare[i] = nextSlot(i == 1 and AREA_GAP or 0)
    end
    return slotByKey, spare, offstageSlot
end

--- @param slot Vector
--- @param taken Vector[]
--- @return boolean true when a token already stands on `slot`
local function slotTaken(slot, taken)
    local reach = TOKEN_SPACING / 2
    for _, pos in ipairs(taken) do
        local dx = pos.x - slot.x
        local dz = pos.z - slot.z
        if dx * dx + dz * dz < reach * reach then
            return true
        end
    end
    return false
end

--- @param key string
--- @param position Vector
--- @param row table
--- @return Object|nil
local function spawnToken(key, position, row)
    local art = tokenArt(key)
    if art == nil then
        print(
            "[StageTokens] no token art for `" .. key .. "` in lib/npc_art_urls.ttslua — no spotlight token on the Stage Control board."
        )
        return nil
    end
    local scale = DATA.STAGE_TOKEN_SCALE
    local obj = spawnObject({
        type = "Custom_Tile",
        position = position,
        rotation = tokenRotation(row),
        scale = { scale.x, scale.y, scale.z },
        sound = false,
    })
    obj.setCustomObject({
        image = art.front,
        image_bottom = art.back,
        type = 2,
        thickness = 0.1,
        stackable = false,
        stretch = true,
    })
    applyRole(obj, key, row)
    obj.tooltip = true
    obj.setGMNotes(GM_PREFIX .. key)
    obj.addTag(TAG)
    obj.setInvisibleTo(C.HideFromPcSeatsAndSpectators)
    return obj
end

--- Spotlight tokens are retired. This pass only removes any that are still on the board.
--- The normal NPC light stays; the hold-to-spotlight hotkey no longer spawns or uses tokens.
--- @param _opts table|nil
function StageTokens.reconcileFromState(_opts)
    local tagged = getObjectsWithTag(TAG) or {}
    for _, obj in ipairs(tagged) do
        if U.isGameObject(obj) and obj.destruct ~= nil then
            obj.destruct()
        end
    end
    tokenGuidByKey = {}
    appliedSigByKey = {}
end

--- Re-read an NPC's display name onto their spotlight token (generic NPC renamed).
--- Tokens are no longer spawned, so a leftover name refresh is a no-op once they are gone.
--- @param _key string
function StageTokens.refreshName(_key)
end


--- @param obj Object|nil
--- @return string|nil characterKey when `obj` is a spotlight token
StageTokens.characterKeyForToken = characterKeyForToken

--- A parked token can be inspected by the Storyteller but cannot drive the light preview.
function StageTokens.characterKeyForSpotlight(obj)
    local key = characterKeyForToken(obj)
    if key ~= nil and not obj.hasTag(OFFSTAGE_TAG) then
        return key
    end
    return nil
end

return StageTokens
