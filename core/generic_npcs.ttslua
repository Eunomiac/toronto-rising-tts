--[[
    Generic NPC import / despawn (TOR-560).

    The Storyteller Dashboard names and imports them (`importNamed`) into scene membership. Like named
    NPCs, the reconciler spawns each figurine + light on demand (`core/npc_spawn.ttslua`) when it is
    placed on the stage (TOR-707). Spotlight tokens on the Stage Control board come from
    `core.stage_tokens` once the NPC stands on the stage.
    Catalog: D.genericNpcs (the genericLabel rows of generated lib.npc_art_urls).
    Agent guidance: .dev/NPC Object Spawning & Spotlighting/Generic NPCs.md;
    Dashboard catalogue: .dev/Storyteller Dashboard Docs/Generic NPCs.md.
]]

local G = require("lib.guids")
local U = require("lib.util")
local S = require("core.state")
local DATA = require("lib.npcs_data")

local GenericNpcs = {}

local function npcsModule()
    return require("core.npcs")
end

--- @return table
local function getMembership()
    local npcWorld = S.getStateVal("sessionScene", "npcWorld")
    if type(npcWorld) ~= "table" then
        return {}
    end
    local membership = npcWorld.genericMembership
    if type(membership) ~= "table" then
        return {}
    end
    return membership
end

--- @param membership table
local function setMembership(membership)
    local npcWorld = S.getStateVal("sessionScene", "npcWorld")
    if type(npcWorld) ~= "table" then
        npcWorld = { placements = {} }
    end
    npcWorld.genericMembership = membership
    S.setStateVal(npcWorld, "sessionScene", "npcWorld")
end

--- @param fullKey string
--- @return boolean
function GenericNpcs.isMember(fullKey)
    local membership = getMembership()
    return type(fullKey) == "string" and type(membership[fullKey]) == "table"
end

--- Parse comma-delimited catalog keys; resolve via D.genericNpcs.
--- @param keysString string
--- @return table[] validRows { key, label, entry }
--- @return string[] invalidKeys
--- @return string[] duplicateKeys already in membership
function GenericNpcs.parseImportKeys(keysString)
    local valid = {}
    local invalid = {}
    local duplicates = {}
    local seen = {}
    if type(keysString) ~= "string" then
        return valid, { tostring(keysString) }, duplicates
    end
    local membership = getMembership()
    for raw in string.gmatch(keysString, "[^,]+") do
        local key = U.trim(raw)
        if key ~= "" and not seen[key] then
            seen[key] = true
            local entry = DATA.resolveGenericNpcEntry(key)
            if entry == nil then
                invalid[#invalid + 1] = key
            elseif type(membership[key]) == "table" then
                duplicates[#duplicates + 1] = key
            else
                valid[#valid + 1] = {
                    key = key,
                    label = entry.label,
                    entry = entry,
                }
            end
        end
    end
    return valid, invalid, duplicates
end

--- Despawn figurine and light for one catalog key; unregister from NPCS.characters.
--- @param characterKey string
--- @param opts table|nil { keepMembership?: boolean }
function GenericNpcs.destroyLiveKey(characterKey, opts)
    opts = type(opts) == "table" and opts or {}
    if type(characterKey) ~= "string" or characterKey == "" then
        return
    end
    local NPCS = npcsModule()
    NPCS.despawnNpc(characterKey, { skipSeatSync = true })
    NPCS.unregisterGenericCharacter(characterKey)

    if opts.keepMembership ~= true then
        local membership = getMembership()
        membership[characterKey] = nil
        setMembership(membership)
        local placements = S.getStateVal("sessionScene", "npcWorld", "placements")
        if type(placements) == "table" and placements[characterKey] ~= nil then
            placements[characterKey] = nil
            S.setStateVal(placements, "sessionScene", "npcWorld", "placements")
        end
        require("dashboard.push").markWorldDirty({ seats = true })
    end
end

--- @return string[] sorted membership keys
local function membershipKeys()
    local keys = {}
    for key, _ in pairs(getMembership()) do
        if type(key) == "string" then
            keys[#keys + 1] = key
        end
    end
    table.sort(keys)
    return keys
end

--- Despawn all live generics for current membership (does not clear membership table).
function GenericNpcs.destroyAllLiveObjectsKeepMembership()
    for _, key in ipairs(membershipKeys()) do
        GenericNpcs.destroyLiveKey(key, { keepMembership = true })
    end
end

--- Despawn all live generics and clear membership (clear the stage / unload from scene).
function GenericNpcs.destroyAllLiveAndClearMembership()
    for _, key in ipairs(membershipKeys()) do
        GenericNpcs.destroyLiveKey(key, { keepMembership = false })
    end
    setMembership({})
end

--- Stat tier names the Storyteller Dashboard keeps a stat block for on each generic type.
local TIERS = { weak = true, average = true, gifted = true, deadly = true, superhuman = true }

--- A kept character's id (the dashboard's `kept:<id>` stats record; TTS keeps no list of them).
--- @param id any
--- @return boolean
local function isKeptId(id)
    return type(id) == "string" and #id <= 12 and string.match(id, "^[a-z0-9]+$") ~= nil
end

--- Storyteller Dashboard: add generic NPCs to the scene with the names the Storyteller typed.
--- Membership + roster registration only; the reconciler spawns each one when it is placed on the stage.
--- @param keys string[] catalog keys
--- @param labels table|nil key → display name
--- @param tiers table|nil key → stat tier (`weak` / `average` / `gifted` / `deadly` / `superhuman`); omitted = no tier
--- @param kept table|nil key → kept character id; a kept character rolls from its own block, so it has no tier
--- @return string|nil error
function GenericNpcs.importNamed(keys, labels, tiers, kept)
    if type(keys) ~= "table" or #keys < 1 then
        return "Pick at least one generic NPC."
    end
    local valid, invalid, duplicates = GenericNpcs.parseImportKeys(table.concat(keys, ","))
    if #invalid > 0 then
        return "Unknown generic NPC: " .. table.concat(invalid, ", ")
    end
    if #duplicates > 0 then
        return "Already in this scene: " .. table.concat(duplicates, ", ")
    end
    labels = type(labels) == "table" and labels or {}
    tiers = type(tiers) == "table" and tiers or {}
    for key, tier in pairs(tiers) do
        if not TIERS[tier] then
            return "Unknown stat tier `" .. tostring(tier) .. "` for " .. tostring(key) .. "."
        end
    end
    kept = type(kept) == "table" and kept or {}
    for key, id in pairs(kept) do
        if not isKeptId(id) then
            return "Bad kept character id `" .. tostring(id) .. "` for " .. tostring(key) .. "."
        end
    end
    local membership = getMembership()
    local NPCS = npcsModule()
    for i = 1, #valid do
        local key = valid[i].key
        local displayName = labels[key]
        if type(displayName) ~= "string" or string.match(displayName, "^%s*$") then
            displayName = valid[i].label or key
        end
        displayName = U.trim(displayName)
        NPCS.registerGenericCharacter(key, displayName)
        local keptId = kept[key]
        membership[key] = { key = key, displayName = displayName, tier = keptId == nil and tiers[key] or nil, keptId = keptId }
    end
    setMembership(membership)
    require("dashboard.push").markWorldDirty({ seats = true })
    print("[GenericNpcs] Imported " .. tostring(#valid) .. " generic NPC(s).")
    return nil
end

--- Storyteller Dashboard: rename a generic NPC already in the scene (membership, figurine, spotlight token).
--- @param characterKey string
--- @param displayName string
--- @return string|nil error
function GenericNpcs.rename(characterKey, displayName)
    local membership = getMembership()
    local row = membership[characterKey]
    if type(row) ~= "table" then
        return "No generic NPC `" .. tostring(characterKey) .. "` in this scene."
    end
    local name = U.trim(displayName)
    if name == "" then
        return "A generic NPC needs a name."
    end
    row.displayName = name
    setMembership(membership)
    local NPCS = npcsModule()
    local def = NPCS.characters[characterKey]
    if type(def) == "table" then
        def.fullName = name
    end
    local rec = NPCS.getInstanceRecord(characterKey)
    local fig = type(rec) == "table" and G.getObject(rec.figurineGuid or "") or nil
    if U.isGameObject(fig) then
        fig.setName(name)
    end
    require("core.stage_tokens").refreshName(characterKey)
    require("dashboard.push").markWorldDirty({ seats = true })
    return nil
end

--- Storyteller Dashboard: change the stat tier of a generic NPC already in the scene (`nil` clears it).
--- @param characterKey string
--- @param tier string|nil
--- @return string|nil error
function GenericNpcs.setTier(characterKey, tier)
    local membership = getMembership()
    local row = membership[characterKey]
    if type(row) ~= "table" then
        return "No generic NPC `" .. tostring(characterKey) .. "` in this scene."
    end
    if tier ~= nil and not TIERS[tier] then
        return "Unknown stat tier `" .. tostring(tier) .. "`."
    end
    row.tier = tier
    setMembership(membership)
    require("core.stage_tokens").reconcileFromState()
    require("dashboard.push").markWorldDirty({ seats = true })
    return nil
end

--- Storyteller Dashboard: keep a generic NPC in the scene as a character (`keptId`), or turn that off (`nil`).
--- Its trackers move with it: a kept character's live in tonight's map, a plain generic's in the scene.
--- @param characterKey string
--- @param keptId string|nil
--- @return string|nil error
function GenericNpcs.setKept(characterKey, keptId)
    local membership = getMembership()
    local row = membership[characterKey]
    if type(row) ~= "table" then
        return "No generic NPC `" .. tostring(characterKey) .. "` in this scene."
    end
    if keptId ~= nil and not isKeptId(keptId) then
        return "Bad kept character id `" .. tostring(keptId) .. "`."
    end
    if row.keptId == keptId then
        return nil
    end
    require("core.npc_trackers").relocate(characterKey, function()
        row.keptId = keptId
        row.trackers = nil
        if keptId ~= nil then
            row.tier = nil
        end
        setMembership(membership)
    end)
    require("dashboard.push").markWorldDirty({ seats = true })
    return nil
end

--- Register every membership key in `NPCS.characters` (scene apply / save restore). Spawns nothing.
function GenericNpcs.registerFromMembership()
    local membership = getMembership()
    local NPCS = npcsModule()
    for _, key in ipairs(membershipKeys()) do
        local entry = DATA.resolveGenericNpcEntry(key)
        if type(entry) == "table" then
            local row = membership[key]
            local displayName = (type(row) == "table" and row.displayName) or entry.label or key
            NPCS.registerGenericCharacter(key, displayName)
        else
            print("[GenericNpcs] registerFromMembership: unknown catalog key " .. key)
        end
    end
end

return GenericNpcs
