--[[
    Objects the session-start save packs into G.GUIDS.HIDDEN_STORAGE.
    gameState.stagedObjects[guid] remembers where each one was, and whether it was hidden.
]]

local S = require("core.state")
local G = require("lib.guids")
local C = require("lib.constants")
local U = require("lib.util")

local Staged = {}

local guidKeys = nil

local function ensureGuidKeys()
    if guidKeys ~= nil then
        return
    end
    guidKeys = {}
    local function walk(node, prefix)
        if type(node) ~= "table" then
            return
        end
        for key, value in pairs(node) do
            local label
            if prefix == "" then
                label = tostring(key)
            elseif type(key) == "number" then
                label = prefix .. "[" .. tostring(key) .. "]"
            else
                label = prefix .. "." .. tostring(key)
            end
            if type(value) == "string" and value ~= "" then
                guidKeys[value] = label
            elseif type(value) == "table" then
                walk(value, label)
            end
        end
    end
    walk(G.GUIDS, "")
end

function Staged.guidKey(guid)
    ensureGuidKeys()
    if type(guid) ~= "string" then
        return ""
    end
    return guidKeys[guid] or ""
end

--- Seat layout identity for a packed satellite, or nil for tables, decks, and spotlight pieces.
--- @return string|nil occupantKey
--- @return string|nil roleKey
function Staged.seatIdentity(guid)
    local key = Staged.guidKey(guid)
    if key == "" or string.find(key, "TABLES.", 1, true) == 1
        or string.find(key, "COMPLICATIONS", 1, true) == 1
        or string.find(key, "SPOTLIGHT_", 1, true) == 1 then
        return nil
    end
    local role, suffix = string.match(key, "^(.*)_((?:NPC[1-4])|(?:BROWN|ORANGE|RED|PINK|PURPLE))$")
    if role == nil or role == "" then
        return nil
    end
    local occupant = suffix
    if suffix == "BROWN" then occupant = "Brown"
    elseif suffix == "ORANGE" then occupant = "Orange"
    elseif suffix == "RED" then occupant = "Red"
    elseif suffix == "PINK" then occupant = "Pink"
    elseif suffix == "PURPLE" then occupant = "Purple"
    end
    return occupant, role
end

function Staged.snapshot(guid)
    local map = S.getStateVal("stagedObjects")
    if type(map) ~= "table" or type(guid) ~= "string" then
        return nil
    end
    local row = map[guid]
    if type(row) ~= "table" then
        return nil
    end
    return row
end

function Staged.forget(guid)
    local map = S.getStateVal("stagedObjects")
    if type(map) == "table" then
        map[guid] = nil
    end
end

local function bag()
    if type(G.GUIDS) ~= "table" or type(G.GUIDS.HIDDEN_STORAGE) ~= "string" or G.GUIDS.HIDDEN_STORAGE == "" then
        return nil
    end
    return getObjectFromGUID(G.GUIDS.HIDDEN_STORAGE)
end

function Staged.isContained(guid)
    if type(guid) ~= "string" or guid == "" then
        return false
    end
    local container = bag()
    if container == nil or container.getObjects == nil then
        return false
    end
    for _, item in ipairs(container.getObjects() or {}) do
        if type(item.guid) == "string" and string.lower(item.guid) == string.lower(guid) then
            return true
        end
    end
    return false
end

--- Joining players have not reached the release step yet. Leave the bag closed.
function Staged.deferExtraction()
    return S.getStateVal("connectionControls", "sessionStartJoin") == true
        and S.getStateVal("connectionControls", "sessionStartJoinStagedReady") ~= true
end

local function vec(value)
    if type(value) ~= "table" then
        return nil
    end
    if type(value.x) ~= "number" or type(value.y) ~= "number" or type(value.z) ~= "number" then
        return nil
    end
    return { x = value.x, y = value.y, z = value.z }
end

local function csheetPageNumber(guid)
    local _, role = Staged.seatIdentity(guid)
    if type(role) ~= "string" then
        return nil
    end
    return tonumber(string.match(role, "^CSHEET_PAGE_(%d+)$"))
end

local function sheetShownY()
    local entry = C.ObjectPositions and C.ObjectPositions.CSHEET_PAGE
    local y = entry and entry.on and entry.on.position and entry.on.position.y
    if type(y) == "number" then
        return y
    end
    return 3.20
end

local function withY(position, y)
    local pose = vec(position)
    if pose == nil then
        return nil
    end
    pose.y = y
    return pose
end

local function applyReleased(obj, row)
    local O = require("core.objects")
    local guid = obj.getGUID and obj.getGUID() or nil
    local page = csheetPageNumber(guid)
    -- Pages 1 and 2 are the open spread. Later pages stay under the table.
    -- Which pages were open when the copy was built does not matter.
    if page == 1 or page == 2 then
        O.restoreObject(obj, {
            position = withY(row.position, sheetShownY()),
            rotation = vec(row.rotation),
            locked = true,
            invisibleTo = {},
        })
        return
    end
    if page ~= nil and page >= 3 then
        O.hideObject(obj, {
            parkPosition = withY(row.position, C.HIDDEN_OBJECT_WORLD_Y),
            parkRotation = vec(row.rotation),
        })
        return
    end
    if row.wasHidden ~= true then
        O.restoreObject(obj, {
            position = vec(row.position),
            rotation = vec(row.rotation),
            locked = row.locked == true,
            interactable = row.interactable == true,
        })
        return
    end
    O.hideObject(obj, {
        parkPosition = vec(row.position),
        parkRotation = vec(row.rotation),
    })
end

--- Page 4 paints its portraits before the sheet's own image files have downloaded.
--- Reapply the page UI later, from the HUD refresh step, after that first paint has settled.
--- @param obj Object
--- @param done function
local function remountPage4Ui(obj, done)
    local finished = false
    local function finish()
        if finished then
            return
        end
        finished = true
        done()
    end
    if not U.isGameObject(obj) or obj.UI == nil or type(obj.UI.getXml) ~= "function" or type(obj.UI.setXml) ~= "function" then
        finish()
        return
    end
    local started = os.clock()
    local xml = nil
    U.chain({
        function()
            return function()
                local elapsed = os.clock() - started
                if obj.UI ~= nil and obj.UI.loading == true and elapsed < 20 then
                    return false
                end
                return true
            end
        end,
        function()
            if obj.UI == nil or type(obj.UI.getXml) ~= "function" then
                return
            end
            local current = obj.UI.getXml()
            if type(current) ~= "string" or current == "" then
                return
            end
            xml = current
            obj.UI.setXml("")
            return 0.1
        end,
        function()
            if xml ~= nil and obj.UI ~= nil and type(obj.UI.setXml) == "function" then
                obj.UI.setXml(xml)
            end
        end,
    }, {
        maxWait = 25,
        onComplete = function()
            finish()
        end,
    })
end

--- Reapply every page 4 sheet that is already out of the bag. Returns a wait test for U.chain.
--- @return function
function Staged.remountReleasedPage4Sheets()
    local pending = {}
    local colors = { "BROWN", "ORANGE", "RED", "PINK", "PURPLE" }
    for i = 1, #colors do
        local guid = type(G.GUIDS) == "table" and G.GUIDS["CSHEET_PAGE_4_" .. colors[i]] or nil
        local occupant = Staged.seatIdentity(guid)
        local obj = type(guid) == "string" and getObjectFromGUID(guid) or nil
        if not U.isGameObject(obj) then
            print("[StagedObjects] Page 4 for " .. tostring(occupant or colors[i]) .. " is not in the world.")
        else
            pending[guid] = true
            remountPage4Ui(obj, function()
                pending[guid] = nil
                print("[StagedObjects] Reapplied page 4 UI for " .. tostring(occupant) .. ".")
            end)
        end
    end
    return function()
        return next(pending) == nil
    end
end

--- Take out objects that step 2 should place. Returns a wait test for U.chain.
--- @return function
function Staged.beginRelease()
    local map = S.getStateVal("stagedObjects")
    local pending = {}
    local container = bag()
    if type(map) == "table" then
        for guid, row in pairs(map) do
            if type(guid) == "string" and type(row) == "table" and (row.wasHidden ~= true or row.releaseHidden == true) then
                if getObjectFromGUID(guid) ~= nil then
                    Staged.forget(guid)
                elseif Staged.isContained(guid) then
                    if container == nil or container.takeObject == nil then
                        error("[StagedObjects] Hidden storage bag is missing; cannot release " .. guid)
                    end
                    pending[guid] = true
                    local takenGuid = guid
                    local takenRow = row
                    container.takeObject({
                        guid = takenGuid,
                        position = vec(takenRow.position),
                        rotation = vec(takenRow.rotation),
                        smooth = false,
                        callback_function = function(obj)
                            if not U.isGameObject(obj) then
                                pending[takenGuid] = nil
                                error("[StagedObjects] Hidden storage returned no object for " .. takenGuid)
                            end
                            applyReleased(obj, takenRow)
                            Staged.forget(takenGuid)
                            pending[takenGuid] = nil
                        end,
                    })
                else
                    print("[StagedObjects] " .. guid .. " was neither in the world nor in hidden storage.")
                    Staged.forget(guid)
                end
            end
        end
    end
    local count = 0
    for _ in pairs(pending) do
        count = count + 1
    end
    print(string.format("[StagedObjects] Releasing %d stored objects.", count))
    return function()
        return next(pending) == nil
    end
end

return Staged
