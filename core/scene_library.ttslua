--[[
    Scene library helpers for `gameState.sceneLibrary`. The Storyteller Dashboard keeps the master copy and
    writes rows through `dashboard/scene_library.ttslua` (`upsertScene`); TTS plays them, mirrors the live
    table into the linked row, and moves `status` on play / End Scene. Row contract:
    `.dev/Storyteller Dashboard Docs/Scene Import Guide.md`.
    Rebuilds `sessionScene.npcRoleOverride` from PC `seatSlots` via `syncNpcRoleOverrideFromSeatSlots`.
    `syncOccupiedNpcSlotsFromSeatSlots` derives `seatLayout.occupiedNPCSlots` from NPC seat rows (scene Apply, TOR-389).

    Agent guidance: `core/state.ttslua` (`sceneLibrary`, `sessionScene`); `lib.constants` (`C.PlayerColors`, `C.NPCSeats`).
]]

local SceneLibrary = {}

local C = require("lib.constants")
local U = require("lib.util")

--- @param v any
--- @return boolean
local function isNonEmptyString(v)
    return type(v) == "string" and string.match(v, "%S") ~= nil
end

--- True when `sceneKey` is the selected library row but is not the scene currently linked to live state.
--- @param sceneKey string|nil defaults to sceneLibrary.activeKey
--- @return boolean
function SceneLibrary.isPendingSelection(sceneKey)
    local S = require("core.state")
    local key = sceneKey or S.getStateVal("sceneLibrary", "activeKey")
    if not isNonEmptyString(key)
        or type(S.getStateVal("sceneLibrary", "scenes", key)) ~= "table" then
        return false
    end
    return key ~= S.getStateVal("sceneLibrary", "lastAppliedKey")
end

--- Rebuilds `sessionScene.npcRoleOverride` from PC `seatSlots` only (authoritative).
--- Shape: sparse map keyed by `C.PlayerColors`; value is a non-empty NPC `characterKey` string
--- when that seat has `isPlayingNPC == true` and `npcCharacterKey` is set; absent keys mean no override.
--- @param sessionScene table|nil
function SceneLibrary.syncNpcRoleOverrideFromSeatSlots(sessionScene)
    if type(sessionScene) ~= "table" then
        return
    end
    local slots = sessionScene.seatSlots
    if type(slots) ~= "table" then
        sessionScene.npcRoleOverride = {}
        return
    end
    local o = {}
    for _, color in ipairs(C.PlayerColors or {}) do
        local row = slots[color]
        if type(row) == "table" and row.isPlayingNPC == true and isNonEmptyString(row.npcCharacterKey) then
            local nk = string.gsub(row.npcCharacterKey, "^%s+", "")
            nk = string.gsub(nk, "%s+$", "")
            if nk ~= "" then
                o[color] = nk
            end
        end
    end
    sessionScene.npcRoleOverride = o
end

--- Derive `seatLayout.occupiedNPCSlots` from a `sessionScene` bundle's NPC `seatSlots` rows.
--- Incoming scene Apply must run this before `S.validateState` so stale live assignments are not
--- re-hydrated into `sessionScene` by `normalizeLiveSessionSceneSeatSlots` (TOR-389).
--- @param sessionScene table|nil when nil, reads live `gameState.sessionScene`
function SceneLibrary.syncOccupiedNpcSlotsFromSeatSlots(sessionScene)
    local S = require("core.state")
    if sessionScene == nil then
        sessionScene = S.getStateVal("sessionScene")
    end
    local ss = type(sessionScene) == "table" and sessionScene.seatSlots or nil
    local occupied = {}
    for _, seatKey in ipairs(C.NPCSeats or {}) do
        local assigned = false
        if type(ss) == "table" then
            local row = ss[seatKey]
            if type(row) == "table"
                and row.slotEmpty ~= true
                and type(row.characterKey) == "string"
                and row.characterKey ~= "" then
                occupied[seatKey] = row.characterKey
                assigned = true
            end
        end
        if not assigned then
            occupied[seatKey] = false
        end
    end
    S.setStateVal(occupied, "seatLayout", "occupiedNPCSlots")
end

local NARRATIVE_CLOCK_DATETIME_KEYS = { "year", "month", "day", "hour", "minute" }

--- Counts how many of year/month/day/hour/minute are numeric on `clock`.
--- @param clock table|nil
--- @return integer
local function countNarrativeClockDatetimeFields(clock)
    if type(clock) ~= "table" then
        return 0
    end
    local c = 0
    for _, k in ipairs(NARRATIVE_CLOCK_DATETIME_KEYS) do
        if tonumber(clock[k]) ~= nil then
            c = c + 1
        end
    end
    return c
end

--- Validates `sessionScene.clock` for library rows and scene Apply.
--- Datetime fields are never defaulted: all five must be authored together, or all omitted (present-day only).
--- Historical scenes (`isPresentDay == false`) require a full datetime.
--- @param clock table|nil
--- @return boolean ok
--- @return string|nil err
function SceneLibrary.validateSessionSceneClock(clock)
    if type(clock) ~= "table" then
        return false, "sessionScene.clock: required object."
    end
    if clock.isPresentDay ~= true and clock.isPresentDay ~= false then
        return false, "sessionScene.clock.isPresentDay: required boolean."
    end
    local dtCount = countNarrativeClockDatetimeFields(clock)
    if dtCount > 0 and dtCount < 5 then
        return false,
            "sessionScene.clock: set all of hour, minute, day, month, and year together, or omit all five (datetime defaults are never applied)."
    end
    if clock.isPresentDay == false and not U.narrativeClockHasDatetime(clock) then
        return false,
            "sessionScene.clock: hour, minute, day, month, and year are required when isPresentDay is false."
    end
    return true, nil
end

--- Numbered chairs for a standard-placement row: every seated PC and seated NPC holds a distinct `tableSlot`
--- inside the table's capacity (`FSL.checkOccupancy`). A dynamic `Table B` key is sized for this row's own NPC
--- seats. Scatter rows have no chairs and always pass.
--- @param placementMode string|nil
--- @param sessionScene table
--- @return boolean ok
--- @return string|nil err
function SceneLibrary.checkRowOccupancy(placementMode, sessionScene)
    if placementMode == "scatter" then
        return true, nil
    end
    local FSL = require("lib.figurine_seat_layout")
    local RSL = require("lib.rotational-seat-layout")
    local slots = sessionScene.seatSlots
    local occupied = {}
    for _, npc in ipairs(C.NPCSeats or {}) do
        local row = type(slots) == "table" and slots[npc] or nil
        if type(row) == "table" and type(row.characterKey) == "string" and row.characterKey ~= "" then
            occupied[npc] = row.characterKey
        end
    end
    local tableKey = sessionScene.tableKey
    local tableCfg = nil
    if type(tableKey) == "string" then
        if C.Tables and C.Tables[tableKey] then
            tableCfg = C.Tables[tableKey]
        elseif RSL.isDynamicTableFamilyKey(tableKey) then
            local variant = FSL.tableBVariantIndex({
                seatSlots = type(slots) == "table" and slots or {},
                occupiedNPCSlots = occupied,
            })
            tableCfg = C.Tables[RSL.resolveTableKey(tableKey, { occupiedSlotIndex = variant })]
        end
    end
    return FSL.checkOccupancy(slots, occupied, tableCfg, { forImport = true })
end

--- A library row TTS can play: valid clock, a known lighting preset, and (standard placement) numbered chairs.
--- Checked when the Storyteller Dashboard writes a row (`upsertScene`); scene Apply re-checks clock and chairs.
--- @param placementMode string `standard` or `scatter`
--- @param sessionScene table
--- @return string|nil error
function SceneLibrary.validateRow(placementMode, sessionScene)
    local okClock, errClock = SceneLibrary.validateSessionSceneClock(sessionScene.clock)
    if not okClock then
        return errClock
    end
    local lp = sessionScene.lightingPresetKey
    if not isNonEmptyString(lp) or not C.isValidLightModeKey((string.gsub(string.gsub(lp, "^%s+", ""), "%s+$", ""))) then
        return "sessionScene.lightingPresetKey: `" .. tostring(lp) .. "` is not a lighting preset (C.LightModes)."
    end
    local okOcc, errOcc = SceneLibrary.checkRowOccupancy(placementMode, sessionScene)
    if not okOcc then
        return errOcc or "sessionScene.seatSlots: numbered chairs are missing or clash."
    end
    return nil
end

--- Allocate `baseKey_2`, `baseKey_3`, … not already present in `sceneLibrary.scenes`.
--- @param baseKey string
--- @param scenes table|nil
--- @return string
function SceneLibrary.allocateForkSceneKey(baseKey, scenes)
    local base = type(baseKey) == "string" and baseKey ~= "" and baseKey or "scene"
    local map = type(scenes) == "table" and scenes or {}
    local n = 2
    while true do
        local candidate = base .. "_" .. tostring(n)
        if map[candidate] == nil then
            return candidate
        end
        n = n + 1
        if n > 9999 then
            return base .. "_" .. tostring(os.time())
        end
    end
end

--- Derives top fog from `C.Sites[siteKey]` and writes `sessionScene.isTopFogActive`.
--- Explicit `site.isTopFogActive` wins; otherwise indoor sites default off, outdoor on.
--- @param siteKey string|nil
function SceneLibrary.applySiteTopFogToSessionScene(siteKey)
    if type(siteKey) ~= "string" then
        return
    end
    siteKey = string.gsub(string.gsub(siteKey, "^%s+", ""), "%s+$", "")
    if siteKey == "" then
        return
    end
    local site = C.Sites[siteKey]
    if type(site) ~= "table" then
        return
    end
    local fogActive = nil
    if site.isTopFogActive == true or site.isTopFogActive == false then
        fogActive = site.isTopFogActive
    elseif site.isIndoors == true then
        fogActive = false
    elseif site.isIndoors == false then
        fogActive = true
    end
    if fogActive == nil then
        return
    end
    local S = require("core.state")
    S.setStateVal(fogActive, "sessionScene", "isTopFogActive")
end

--- Resolves which library row should receive live `sessionScene` mirrors.
--- Prefers `activeKey` when linked (fork / post-apply selection). Falls back to `lastAppliedKey`
--- so selecting another row for a pending Apply does not stop mirroring the scene currently on the table.
--- @return string|nil sceneKey
function SceneLibrary.resolveMirrorSceneKey()
    local S = require("core.state")
    local function isLinked(key)
        return type(key) == "string" and key ~= ""
            and type(S.getStateVal("sceneLibrary", "scenes", key)) == "table"
            and S.getStateVal("sceneLibrary", "scenes", key, "receivesLiveWrites") == true
    end
    local active = S.getStateVal("sceneLibrary", "activeKey")
    if isLinked(active) then
        return active
    end
    local lastApplied = S.getStateVal("sceneLibrary", "lastAppliedKey")
    if isLinked(lastApplied) then
        return lastApplied
    end
    return nil
end

--- Stops live→library mirroring after End scene / no-scene apply.
--- First writes the live scene into its linked row one last time (edits that only ran a narrow sync, such as
--- Dashboard stage moves, have not been mirrored yet), so callers must detach before clearing live state.
--- Then clears `lastAppliedKey` and all `receivesLiveWrites` so Sync cannot write cleared live
--- location into a library row (TOR-145 / TOR-362). TOR-449: End scene then clears `activeKey`
--- via `deselectPendingPreview({ clearActiveKey = true })` — preview is for scenes about to enter.
function SceneLibrary.detachLiveTableFromLibraryMirror()
    local S = require("core.state")
    SceneLibrary.mirrorActiveLibrarySessionSceneFromLiveIfLinked()
    local K = SceneLibrary.resolveMirrorSceneKey()
    if type(K) ~= "string" or K == "" then
        K = S.getStateVal("sceneLibrary", "lastAppliedKey")
    end
    if type(K) ~= "string" or K == "" then
        K = S.getStateVal("sceneLibrary", "activeKey")
    end
    SceneLibrary.setExclusiveLiveMirror(nil)
    S.setStateVal(nil, "sceneLibrary", "lastAppliedKey")
    if type(K) == "string" and K ~= ""
        and type(S.getStateVal("sceneLibrary", "scenes", K)) == "table"
    then
        S.setStateVal(K, "sceneLibrary", "activeKey")
    else
        S.setStateVal(nil, "sceneLibrary", "activeKey")
    end
end

--- Sets `receivesLiveWrites = true` on exactly one library row; clears the flag on all others.
--- @param sceneKey string|nil When nil/empty, clears mirroring on every row.
function SceneLibrary.setExclusiveLiveMirror(sceneKey)
    local S = require("core.state")
    local target = type(sceneKey) == "string" and sceneKey or ""
    target = string.gsub(string.gsub(target, "^%s+", ""), "%s+$", "")
    local scenes = S.getStateVal("sceneLibrary", "scenes")
    if type(scenes) ~= "table" then
        return
    end
    for sk, _ in pairs(scenes) do
        if type(sk) == "string" then
            local linked = target ~= "" and sk == target
            S.setStateVal(linked, "sceneLibrary", "scenes", sk, "receivesLiveWrites")
        end
    end
end

--- When the mirror row (`resolveMirrorSceneKey`) is linked, deep-clone live `sessionScene` into that row.
--- Invoked from `Sync.full` after reconcilers so one mutation batch ends with an up-to-date library mirror.
--- Lazy-requires `core.state` to avoid cycles during `state` module initialization.
function SceneLibrary.mirrorActiveLibrarySessionSceneFromLiveIfLinked()
    local S = require("core.state")
    local PresentDayClock = require("core.present_day_clock")
    local K = SceneLibrary.resolveMirrorSceneKey()
    if K == nil then
        return
    end
    local live = S.getStateVal("sessionScene")
    if type(live) ~= "table" then
        return
    end
    -- Strip TOR-142 ×5 catch-up runtime fields before library writeback.
    local toStore = PresentDayClock.cloneSessionSceneForLibraryMirror(live)
    if type(toStore) ~= "table" then
        return
    end
    S.setStateVal(toStore, "sceneLibrary", "scenes", K, "sessionScene")
end

--- True when a library scene is currently on the table (`lastAppliedKey` + row exists).
--- Used for Play-session restore vs default no-scene (TOR-151 / TOR-152) and map-pin visibility (TOR-245).
--- @return boolean
function SceneLibrary.hasLiveSceneOnTable()
    local S = require("core.state")
    local key = S.getStateVal("sceneLibrary", "lastAppliedKey")
    if type(key) ~= "string" or key == "" then
        return false
    end
    return type(S.getStateVal("sceneLibrary", "scenes", key)) == "table"
end

--- Library scene lifecycle (`row.status`). A row without one counts as `new`.
--- `new` → `ongoing` when it first goes live; `ongoing` → `ended` on End Scene. `template` rows never go live:
--- the dashboard plays a dated copy instead.
SceneLibrary.STATUSES = { new = true, ongoing = true, ended = true, template = true }

--- @param sceneKey string
--- @return string|nil status `nil` when the row does not exist
function SceneLibrary.statusOf(sceneKey)
    local S = require("core.state")
    local row = type(sceneKey) == "string" and S.getStateVal("sceneLibrary", "scenes", sceneKey) or nil
    if type(row) ~= "table" then
        return nil
    end
    return SceneLibrary.STATUSES[row.status] and row.status or "new"
end

--- @param sceneKey string
--- @param status string one of `SceneLibrary.STATUSES`
--- @return string|nil error
function SceneLibrary.setStatus(sceneKey, status)
    local S = require("core.state")
    if not SceneLibrary.STATUSES[status] then
        return "Unknown scene status: " .. tostring(status)
    end
    if type(sceneKey) ~= "string" or type(S.getStateVal("sceneLibrary", "scenes", sceneKey)) ~= "table" then
        return "No library scene `" .. tostring(sceneKey) .. "`."
    end
    if S.getStateVal("sceneLibrary", "scenes", sceneKey, "status") ~= status then
        S.setStateVal(status, "sceneLibrary", "scenes", sceneKey, "status")
    end
    return nil
end

--- Rows the in-game Scenes panel lists: templates and ended scenes stay on the dashboard.
--- @return table keys in library order
function SceneLibrary.playableOrder()
    local S = require("core.state")
    local out = {}
    for _, key in ipairs(S.getStateVal("sceneLibrary", "order") or {}) do
        local status = SceneLibrary.statusOf(key)
        if status ~= nil and status ~= "template" and status ~= "ended" then
            out[#out + 1] = key
        end
    end
    return out
end

return SceneLibrary
