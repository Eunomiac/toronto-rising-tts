--[[
  Full-screen player HUD overlay Images (conditions + hunger).
  Visibility: UI.show / UI.hide (triggers XML showAnimation / hideAnimation per TTS API).
  Blindfolds (TOR-431): animate the parent Panel `playerHud_overlay_blindfold_<Color>`;
  arm child Images (variant + optional District/Site cards) before UI.show — do not UI.show children.
  Hunger tiers also clear/set `active` after hide/show (TOR-340): UI.hide alone can fail to
  stick for `visibility="<Color>"` panels when that seat is empty. Other overlays still avoid
  mixing active with show/hide unless a similar off-seat hide bug appears.
]]
---@diagnostic disable: undefined-global

local HO = {}

local C = require("lib.constants")
local S = require("core.state")
local O = require("core.objects")
local U = require("lib.util")

--- elementId -> last visibility we applied (incremental UI.show / UI.hide)
local lastVisible = {}

--- Per-seat desired overlay inputs fingerprint (skip full reconcile when unchanged).
local lastDesiredVisibilityFpBySeat = {}

--- seatColor -> delay id unused after TOR-444 shared blindfold (kept nil).
local pendingBlindfoldChildCleanupBySeat = {}

--- Parent Panel hide: animationDuration 2 + hideAnimationDelay 1 (playerHud_blindfoldOverlay).
local BLINDFOLD_HIDE_CHILD_CLEANUP_SEC = 3

--- Tier assets overlay_hunger_0 .. overlay_hunger_5 (one Image per seat + image=; TOR-444).

--- seatColor -> last applied hunger Custom UI image name (guarded setAttribute).
local lastHungerImageBySeat = {}

--- Blindfold art variants overlay_blindfold_1 .. overlay_blindfold_N (asset names; one shared Image).
local BLINDFOLD_VARIANTS = {}
for v = 1, C.BlindfoldVariantCount do
  BLINDFOLD_VARIANTS[v] = v
end

local SHARED_BLINDFOLD_PANEL = "playerHud_overlay_blindfold"
local SHARED_BLINDFOLD_DISPLAY = "overlay_blindfold_display"
local SHARED_BLINDFOLD_DISTRICT = "overlay_district_card_display"
local SHARED_BLINDFOLD_SITE = "overlay_site_card_display"

--- @return string
local function blindfoldPanelId()
  return SHARED_BLINDFOLD_PANEL
end

--- @param elementId string
--- @return boolean
local function isExclusiveBlindfoldElementId(elementId)
  return elementId == SHARED_BLINDFOLD_DISPLAY
    or (type(elementId) == "string" and string.match(elementId, "^overlay_blindfold_%d+") ~= nil)
end

--- @param seatColor string
--- @return string
local function hungerOverlayIdForSeat(seatColor)
  return "overlay_hunger_" .. seatColor
end

--- @param seatColor string
--- @return string[]
local function allManagedOverlayIdsForSeat(seatColor)
  if type(seatColor) ~= "string" then
    return {}
  end
  return {
    "overlay_health_impaired_" .. seatColor,
    "overlay_humanity_impaired_" .. seatColor,
    "overlay_stained_" .. seatColor,
    "overlay_frenzy_" .. seatColor,
    hungerOverlayIdForSeat(seatColor),
  }
end

--- @param playerID string|nil
--- @param seatColor string
--- @return number 0..5
local function resolveHungerLevel(playerID, seatColor)
  local hg = 0
  if type(playerID) == "string" and playerID ~= "" and playerID ~= C.StorytellerID then
    hg = tonumber(S.getStateVal("playerData", playerID, "stats", "hunger")) or 0
  elseif type(seatColor) == "string" then
    hg = tonumber(S.getPlayerVal(seatColor, "hunger")) or 0
  end
  if hg < 0 then
    hg = 0
  end
  if hg > 5 then
    hg = 5
  end
  return hg
end

--- Merge condition hudChanges and hunger overlay for one seat.
--- @param playerID string|nil
--- @param seatColor string
--- @return table<string, boolean> ids that should be visible
local function computeDesiredVisibility(playerID, seatColor)
  local want = {}
  if type(playerID) == "string" and playerID ~= "" and playerID ~= C.StorytellerID then
    local Conditions = require("core.conditions")
    local resolved = Conditions.resolveForPlayer(playerID)
    if type(resolved.hudElementIds) == "table" then
      for elId, on in pairs(resolved.hudElementIds) do
        if on and type(elId) == "string" then
          want[elId] = true
        end
      end
    end
  end

  -- Hunger: one Image per seat always shown (tier via image=); level encoded in fingerprint.
  if type(seatColor) == "string" then
    want[hungerOverlayIdForSeat(seatColor)] = true
  end

  return want
end

--- @param seatColor string
--- @return string
local function overlayInputFingerprintForSeat(seatColor)
  if type(seatColor) ~= "string" then
    return ""
  end
  local playerID = S.getPlayerID(seatColor)
  local want = computeDesiredVisibility(playerID, seatColor)
  local keys = {}
  for elId, on in pairs(want) do
    if on == true and type(elId) == "string" then
      keys[#keys + 1] = elId
    end
  end
  table.sort(keys)
  return seatColor .. ":" .. table.concat(keys, ",") .. ":h" .. tostring(resolveHungerLevel(playerID, seatColor))
end

--- Stable fingerprint of overlay visibility inputs for all player seat rows.
--- @return string
function HO.computeOverlayInputFingerprint()
  local lines = {}
  for _, seatColor in ipairs(C.PlayerColors or {}) do
    lines[#lines + 1] = overlayInputFingerprintForSeat(seatColor)
  end
  return table.concat(lines, "\n")
end

--- Clears per-seat desired-overlay input fingerprints (pair with `Sync.full({ force = true })`).
function HO.invalidateOverlayInputCache()
  lastDesiredVisibilityFpBySeat = {}
  lastHungerImageBySeat = {}
end

--- Hunger uses one Image per seat (`overlay_hunger_<Seat>`) + `image=overlay_hunger_N` (TOR-444).
--- Always show + active=true (tier 0..5); guarded image write; clear image cache via invalidateSeatCache.
--- @param seatColor string
--- @param level number 0..5
local function applyHungerOverlay(seatColor, level)
  if type(seatColor) ~= "string" then
    return
  end
  local lv = tonumber(level)
  if lv == nil then
    lv = 0
  end
  if lv < 0 then
    lv = 0
  end
  if lv > 5 then
    lv = 5
  end
  local eid = hungerOverlayIdForSeat(seatColor)
  local imageRef = "overlay_hunger_" .. lv
  if lastHungerImageBySeat[seatColor] ~= imageRef then
    if UI ~= nil and UI.setAttribute ~= nil then
      UI.setAttribute(eid, "image", imageRef)
    end
    lastHungerImageBySeat[seatColor] = imageRef
  end
  UI.show(eid)
  U.setAttribute(eid, "active", "true")
  lastVisible[eid] = true
end

--- @param playerID string|nil
--- @param seatColor string
--- @return number 0..5
local function desiredHungerLevelFromWant(_want, seatColor)
  if type(seatColor) ~= "string" then
    return 0
  end
  return resolveHungerLevel(S.getPlayerID(seatColor), seatColor)
end

--- @return number|nil variant from any seated PC's hudBlindfold condition
local function desiredSharedBlindfoldVariantFromConditions()
  local seated = Player.getPlayers() or {}
  for _, player in ipairs(seated) do
    local color = player and player.color or nil
    if type(color) == "string" then
      local playerID = S.getPlayerID(color)
      if type(playerID) == "string" and playerID ~= "" and playerID ~= C.StorytellerID then
        local conditions = S.getStateVal("playerData", playerID, "conditions")
        if type(conditions) == "table" and type(conditions.hudBlindfold) == "table" then
          local variant = tonumber(conditions.hudBlindfold.variant)
          if variant ~= nil and variant >= 1 and variant <= C.BlindfoldVariantCount then
            return variant
          end
          return 1
        end
      end
    end
  end
  return nil
end

--- Pending shared-blindfold child cleanup delay id (TOR-444 shared panel).
local pendingSharedBlindfoldChildCleanup = nil

local function cancelSharedBlindfoldChildCleanup()
  if pendingSharedBlindfoldChildCleanup ~= nil then
    U.cancel(pendingSharedBlindfoldChildCleanup)
    pendingSharedBlindfoldChildCleanup = nil
  end
end

local function restoreSharedBlindfoldChildDefaults()
  U.setAttribute(SHARED_BLINDFOLD_DISPLAY, "image", "overlay_blindfold_1")
  U.setAttributes(SHARED_BLINDFOLD_DISTRICT, { active = "false", color = "Clear", image = "" })
  U.setAttributes(SHARED_BLINDFOLD_SITE, { active = "false", color = "Clear", image = "" })
end

local function scheduleSharedBlindfoldChildCleanup()
  cancelSharedBlindfoldChildCleanup()
  pendingSharedBlindfoldChildCleanup = U.await(function()
    pendingSharedBlindfoldChildCleanup = nil
    restoreSharedBlindfoldChildDefaults()
  end, BLINDFOLD_HIDE_CHILD_CLEANUP_SEC)
end

--- Arm destination cards before parent UI.show (TOR-425 / TOR-431 / TOR-444 shared).
local function armSharedBlindfoldLocationCards(districtImage, siteImage)
  if type(districtImage) == "string" and type(siteImage) == "string" then
    U.setAttributes(SHARED_BLINDFOLD_DISTRICT, { active = "true", color = "White", image = districtImage })
    U.setAttributes(SHARED_BLINDFOLD_SITE, { active = "true", color = "White", image = siteImage })
    return
  end
  U.setAttributes(SHARED_BLINDFOLD_DISTRICT, { active = "false", color = "Clear", image = "" })
  U.setAttributes(SHARED_BLINDFOLD_SITE, { active = "false", color = "Clear", image = "" })
end

--- @return table array of seated PC seat colors (for visibility audience)
local function seatedPcVisibilityAudience()
  local tokens = {}
  local seen = {}
  for _, player in ipairs(Player.getPlayers() or {}) do
    local color = player and player.color or nil
    if type(color) == "string" and seen[color] ~= true and U.isIn(color, C.PlayerColors) then
      seen[color] = true
      tokens[#tokens + 1] = color
    end
  end
  return tokens
end

--- Shared transition blindfold (TOR-444): one panel, one variant Image via image=.
--- @param variant number|nil 1..N = show; nil = hide
--- @param opts table|nil `{ districtImage?, siteImage?, forceReshow?, touchLocationCards? }`
local function applySharedBlindfold(variant, opts)
  opts = type(opts) == "table" and opts or {}
  local panelId = SHARED_BLINDFOLD_PANEL
  local shouldShow = variant ~= nil
  local prev = lastVisible[panelId]
  local touchCards = opts.touchLocationCards ~= false

  if shouldShow then
    cancelSharedBlindfoldChildCleanup()
    local forceReshow = opts.forceReshow == true
    if forceReshow or prev ~= true then
      U.setAttribute(panelId, "active", "false")
    end
    U.setVisibleTo(panelId, seatedPcVisibilityAudience())
    local v = tonumber(variant) or 1
    if v < 1 then
      v = 1
    end
    if v > C.BlindfoldVariantCount then
      v = C.BlindfoldVariantCount
    end
    if touchCards then
      armSharedBlindfoldLocationCards(opts.districtImage, opts.siteImage)
    end
    if forceReshow or prev ~= true then
      UI.show(panelId)
    end
    -- After UI.show: parent show re-applies XML child attrs (display defaults to overlay_blindfold_1).
    U.setAttribute(SHARED_BLINDFOLD_DISPLAY, "image", "overlay_blindfold_" .. tostring(v))
    U.setAttribute(SHARED_BLINDFOLD_DISPLAY, "active", "true")
    U.setAttribute(SHARED_BLINDFOLD_DISPLAY, "color", "White")
    lastVisible[panelId] = true
    return
  end

  if prev == true then
    UI.hide(panelId)
    lastVisible[panelId] = false
    scheduleSharedBlindfoldChildCleanup()
  elseif prev == nil then
    lastVisible[panelId] = false
  end
end

--- Show one blindfold variant for all seated PCs (shared panel, TOR-444).
--- @param variant number 1..C.BlindfoldVariantCount
--- @param opts table|nil `{ districtImage?, siteImage?, forceReshow? }`
function HO.applyBlindfoldVariantForSeatedPlayers(variant, opts)
  local v = tonumber(variant)
  if v == nil or v < 1 or v > C.BlindfoldVariantCount then
    return
  end
  opts = type(opts) == "table" and opts or {}
  applySharedBlindfold(v, {
    forceReshow = opts.forceReshow == true,
    touchLocationCards = true,
    districtImage = opts.districtImage,
    siteImage = opts.siteImage,
  })
end

--- Keep hunger smoke synced to hunger threshold:
--- on for hunger >= 4; off for hunger < 4.
--- @param seatColor string
--- @param hungerLevel number
local function syncHungerSmokeForSeat(seatColor, hungerLevel)
  if type(seatColor) ~= "string" then
    return
  end
  local hg = tonumber(hungerLevel) or 0
  if hg < 0 then
    hg = 0
  end
  if hg > 5 then
    hg = 5
  end
  local shouldBeOn = hg >= 4
  local state = shouldBeOn and "on" or "off"
  O.SetHungerSmokeState(seatColor, state, 0)
end

--- @param elementId string
--- @param shouldShow boolean
local function applyOverlayVisibility(elementId, shouldShow)
  if type(elementId) ~= "string" or type(shouldShow) ~= "boolean" then
    return
  end
  local prev = lastVisible[elementId]
  if prev == shouldShow then
    return
  end
  -- Default XML state is hidden; avoid a redundant hide on first sync
  if prev == nil and not shouldShow then
    lastVisible[elementId] = false
    return
  end
  if shouldShow then
    UI.show(elementId)
  else
    UI.hide(elementId)
  end
  lastVisible[elementId] = shouldShow
end

--- Resolve the hunger tier overlay that should be visible for one seat (0..5).
--- Shared hunger resolver for overlay reconcile (same runtime hunger as other HUD paths).
--- @param seatColor string e.g. "Red"
--- @return number
function HO.resolveHungerLevelForSeat(seatColor)
  if type(seatColor) ~= "string" then
    return 0
  end
  local playerID = S.getPlayerID(seatColor)
  local want = computeDesiredVisibility(playerID, seatColor)
  return desiredHungerLevelFromWant(want, seatColor)
end

--- Clears incremental visibility memory for one seat so the next syncAll() reapplies UI.show/hide.
--- Use after automated stat changes (e.g. Rouse) when overlays can desync from lastVisible.
--- @param seatColor string e.g. "Brown"
function HO.invalidateSeatCache(seatColor)
  if type(seatColor) ~= "string" then
    return
  end
  for _, eid in ipairs(allManagedOverlayIdsForSeat(seatColor)) do
    lastVisible[eid] = nil
  end
  lastHungerImageBySeat[seatColor] = nil
  lastDesiredVisibilityFpBySeat[seatColor] = nil
end

--- Reconcile condition/hunger overlays and hunger smoke for one seat.
--- @param seatColor string e.g. "Red"
--- @param opts table|nil `{ force = boolean? }`
function HO.reconcileForSeat(seatColor, opts)
  if type(seatColor) ~= "string" then
    return
  end
  opts = type(opts) == "table" and opts or {}
  local fp = overlayInputFingerprintForSeat(seatColor)
  local playerID = S.getPlayerID(seatColor)
  local want = computeDesiredVisibility(playerID, seatColor)
  local hungerLevel = resolveHungerLevel(playerID, seatColor)
  local fpSkip = opts.force ~= true and lastDesiredVisibilityFpBySeat[seatColor] == fp

  -- Fingerprint skip must not leave world smoke / XmlUI hunger stale after layout
  -- repositions smoke or TTS hide fails (BUG 7 / BUG 8).
  if fpSkip then
    applyHungerOverlay(seatColor, hungerLevel)
    syncHungerSmokeForSeat(seatColor, hungerLevel)
    return
  end

  local ids = allManagedOverlayIdsForSeat(seatColor)
  local hungerId = hungerOverlayIdForSeat(seatColor)
  for _, eid in ipairs(ids) do
    if eid ~= hungerId then
      if want[eid] ~= true then
        applyOverlayVisibility(eid, false)
      end
    end
  end
  for _, eid in ipairs(ids) do
    if eid ~= hungerId then
      if want[eid] == true then
        applyOverlayVisibility(eid, true)
      end
    end
  end
  applyHungerOverlay(seatColor, hungerLevel)
  syncHungerSmokeForSeat(seatColor, hungerLevel)
  lastDesiredVisibilityFpBySeat[seatColor] = fp
end

--- Refresh overlay visibility for every player color row; then shared transition blindfold.
--- @param opts table|nil forwarded to `HO.reconcileForSeat` (e.g. `{ force = true }`)
function HO.syncAll(opts)
  opts = type(opts) == "table" and opts or {}
  for _, seatColor in ipairs(C.PlayerColors) do
    HO.reconcileForSeat(seatColor, opts)
  end
  local sharedVariant = desiredSharedBlindfoldVariantFromConditions()
  local panelPrev = lastVisible[SHARED_BLINDFOLD_PANEL]
  local leaveCardsAlone = sharedVariant ~= nil and panelPrev == true
  applySharedBlindfold(sharedVariant, {
    touchLocationCards = not leaveCardsAlone,
    forceReshow = opts.force == true and sharedVariant ~= nil,
  })
end

return HO
