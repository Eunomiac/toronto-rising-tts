--[[
    Game phase lifecycle (TOR-143).

    Top-level: Intermission → Play → Spotlight → End → Intermission.
    Play subphases (free switch): Main / Downtime / Memoriam.

    Enter/exit events are registry step builders consumed by U.chain
    (exit of old phase, then state mutate, then enter of new). Append steps
    to Phases.onEnter / Phases.onExit / onEnterSub / onExitSub without
    changing advanceTo control flow.
]]

local Phases = {}

local C = require("lib.constants")
local U = require("lib.util")
local S = require("core.state")

local SESSION_START_HEAL_PANEL = "sessionStartHeal_panel"
local HEAL_BROADCAST_HOLD_SEC = 6
local INTERMISSION_THEME_FADE_SEC = 2
--- Intermission → Play: TR_Loop fade-out while Music C overture starts immediately (TOR-497).
local INTERMISSION_TO_PLAY_LOOP_FADE_SEC = 0.5
--- End → Intermission: wait after showing the global cover so FadeIn (and camera) can finish
--- before no-scene table/skybox work (TOR-502).
local INTERMISSION_BLINDFOLD_SETTLE_SEC = 2
--- Per-step U.chain cap. Must exceed Play-enter explode wait (~71.5s); default chainWait is 60s.
local PHASE_ADVANCE_CHAIN_MAX_WAIT_SEC = (tonumber(C.SessionStartIntroDurationSec) or 71) + 15

--- Single in-flight top-level transition token.
local advancing = false

--- True while `Phases.advanceTo` / `advanceNext` U.chain is in flight (exit → mutate → enter).
function Phases.isAdvancing()
    return advancing == true
end

--- @type table<string, fun(ctx: table): table>
Phases.onExit = {}
--- @type table<string, fun(ctx: table): table>
Phases.onEnter = {}
--- @type table<string, fun(ctx: table): table>
Phases.onExitSub = {}
--- @type table<string, fun(ctx: table): table>
Phases.onEnterSub = {}

local function emptySteps(_ctx)
    return {}
end

local function appendSteps(dest, src)
    if type(src) ~= "table" then
        return
    end
    for i = 1, #src do
        dest[#dest + 1] = src[i]
    end
end

local function buildSteps(registry, phase, ctx)
    local builder = registry[phase]
    if type(builder) ~= "function" then
        return {}
    end
    local steps = builder(ctx)
    if type(steps) ~= "table" then
        return {}
    end
    return steps
end

local function nextPhaseInSequence(current)
    local seq = C.PhaseSequence
    if type(seq) ~= "table" or #seq < 1 then
        return C.Phases.INTERMISSION
    end
    local idx = nil
    for i = 1, #seq do
        if seq[i] == current then
            idx = i
            break
        end
    end
    if idx == nil then
        return seq[1]
    end
    local nextIdx = idx + 1
    if nextIdx > #seq then
        nextIdx = 1
    end
    return seq[nextIdx]
end

--- Spaced unicode roman numerals for session overlay (TOR-263 / TOR-143).
--- @param n number
--- @return string
function Phases.romanize(n)
    local v = math.floor(tonumber(n) or 0)
    if v < 1 then
        return ""
    end
    if v > 3999 then
        v = 3999
    end
    local map = {
        { 1000, "M" },
        { 900, "CM" },
        { 500, "D" },
        { 400, "CD" },
        { 100, "C" },
        { 90, "XC" },
        { 50, "L" },
        { 40, "XL" },
        { 10, "X" },
        { 9, "IX" },
        { 5, "V" },
        { 4, "IV" },
        { 1, "I" },
    }
    local parts = {}
    for i = 1, #map do
        local value = map[i][1]
        local numeral = map[i][2]
        while v >= value do
            parts[#parts + 1] = numeral
            v = v - value
        end
    end
    return table.concat(parts, " ")
end

function Phases.incrementSessionNum()
    local n = tonumber(S.getStateVal("sessionNum")) or 1
    S.setSessionNum(n + 1)
end

--- Call Global-script helpers for `overlay_globalBlindfold_panel` only.
--- Never touch per-player transition blindfolds (`hudBlindfold` / panel_overlay_blindfold).
local function callGlobalBlindfoldHelper(name)
    local fn = rawget(_G, name)
    if type(fn) == "function" then
        fn()
        return true
    end
    U.AlertGM("Phases: missing Global helper `" .. tostring(name) .. "`")
    return true
end

--- Hide global blindfold (Play exit, connect outside Intermission, explode sequence).
function Phases.hideGlobalBlindfold(_ctx)
    return callGlobalBlindfoldHelper("hideStartupLoadingOverlaysForPhases")
end

--- Show global blindfold (Intermission enter).
function Phases.showGlobalBlindfold(_ctx)
    local SE = require("core.session_explode")
    if type(SE.resetLayers) == "function" then
        SE.resetLayers()
    end
    return callGlobalBlindfoldHelper("showStartupLoadingOverlaysForPhases")
end

--- Connect outside Intermission: hide global blindfold (shared overlay — not per-seat).
--- @param player Player|nil unused; kept for call-site clarity
function Phases.lowerBlindfoldForConnectingPlayer(player)
    if player == nil or not U.isPlayer(player) then
        return
    end
    Phases.hideGlobalBlindfold(nil)
end

function Phases.applyAllLightsDark(_ctx)
    S.setStateVal("dark", "currentScene")
    S.setStateVal("AdminDark", "sessionScene", "lightingPresetKey")
    S.setStateVal(nil, "sceneTransition")
    local Scenes = require("core.scenes")
    if type(Scenes.invalidateReconcileCache) == "function" then
        Scenes.invalidateReconcileCache()
    end
    local Sync = require("core.sync")
    Sync.full({ reason = "phase_intermission_dark", skipSoundscape = true })
    return true
end

--- End → Intermission: drop the cover and start the audio handoff in one step (TOR-506).
--- Outgoing session audio fades out while TR_Loop fades in; wait covers both plus cover settle.
--- Does not `stopAll` — that would hard-cut the outgoing fade.
function Phases.beginIntermissionCoverAndTheme(_ctx)
    -- End cover art on the stacked global image (session explode resets this on next Play load).
    U.setAttribute("overlay_globalBlindfold", "image", "overlay_blindfold_end")
    Phases.showGlobalBlindfold(_ctx)
    local Soundscape = require("core.soundscape")
    local key = C.IntermissionThemeFeaturedKey or "TR_Loop"
    local ok, msg = Soundscape.playFeaturedMusic(key, {
        incomingFadeSeconds = INTERMISSION_THEME_FADE_SEC,
        outgoingFadeSeconds = INTERMISSION_THEME_FADE_SEC,
    })
    if ok ~= true then
        U.AlertGM("Intermission theme: " .. tostring(msg or "playFeaturedMusic failed"))
    end
    -- Weather leftovers (Main/location already started fading via outgoingFadeSeconds).
    if type(Soundscape.fadeOutTransitionAmbient) == "function" then
        Soundscape.fadeOutTransitionAmbient({ seconds = INTERMISSION_THEME_FADE_SEC })
    end
    if type(Soundscape.commitEagerSteadyState) == "function" then
        Soundscape.commitEagerSteadyState(ok == true)
    elseif type(Soundscape.markReconciledToCurrentState) == "function" then
        Soundscape.markReconciledToCurrentState()
    end
    local waitSec = INTERMISSION_BLINDFOLD_SETTLE_SEC
    if INTERMISSION_THEME_FADE_SEC > waitSec then
        waitSec = INTERMISSION_THEME_FADE_SEC
    end
    return waitSec
end

--- Starts looping TR_Loop on the featured lane (Intermission ambient).
--- TOR-366: always fade in from volume 0 (silent arm + incomingFadeSeconds).
function Phases.startIntermissionThemePlaylistLoop(_ctx)
    local Soundscape = require("core.soundscape")
    if type(Soundscape.stopAll) == "function" then
        Soundscape.stopAll()
    end
    local key = C.IntermissionThemeFeaturedKey or "TR_Loop"
    local ok, msg = Soundscape.playFeaturedMusic(key, {
        incomingFadeSeconds = INTERMISSION_THEME_FADE_SEC,
    })
    if ok ~= true then
        U.AlertGM("Intermission theme: " .. tostring(msg or "playFeaturedMusic failed"))
    end
    if type(Soundscape.commitEagerSteadyState) == "function" then
        Soundscape.commitEagerSteadyState(ok == true)
    elseif type(Soundscape.markReconciledToCurrentState) == "function" then
        Soundscape.markReconciledToCurrentState()
    end
    return true
end

--- Load-time Intermission ambient: hard-reset emitters then fade in TR_Loop (no cover to sync with).
function Phases.reconcileIntermissionAmbientOnLoad()
    if S.getStateVal("currentPhase") ~= C.Phases.INTERMISSION then
        return false
    end
    Phases.applyAllLightsDark(nil)
    return Phases.startIntermissionThemePlaylistLoop(nil)
end

function Phases.freezeClock(_ctx)
    S.setStateVal(false, "sessionScene", "clock", "useRealTime")
    S.setStateVal(0, "sessionScene", "clock", "speed")
    local GameStateOverlay = require("core.game_state_overlay")
    if type(GameStateOverlay.stopTicker) == "function" then
        GameStateOverlay.stopTicker()
    end
    if type(GameStateOverlay.reconcileFromState) == "function" then
        GameStateOverlay.reconcileFromState()
    end
    return true
end

function Phases.applyNoSceneDefault(_ctx, opts)
    opts = type(opts) == "table" and opts or {}
    local Scenes = require("core.scenes")
    Scenes.applyDefaultNoSceneEnvironment({
        reason = opts.reason or "phase_play_enter",
        skipTransitionBlindfold = true,
        skipSoundscape = opts.skipSoundscape == true,
    })
    return true
end

--- Play → Spotlight: staged transition cover (same lead-in as scene Apply). Destination cards stay Clear.
--- @param ctx table|nil
--- @return number|boolean
local function runSpotlightEnterFromPlayTransition(ctx)
    local HUDBF = require("core.hud_blindfold")
    local SS = require("core.soundscape")
    local Scenes = require("core.scenes")
    local Spotlight = require("core.spotlight")
    local mood = S.getStateVal("soundscape", "musicMood")
    HUDBF.runStagedTransition({
        fadeOut = function()
            if type(SS.fadeOutTransitionAmbient) == "function" then
                SS.fadeOutTransitionAmbient({
                    seconds = HUDBF.TRANSITION_FADE_OUT_SEC,
                    skipBackground = mood == "main",
                })
            end
        end,
        work = function()
            return Spotlight.applyEnterWorld()
        end,
        fadeIn = function()
            if type(SS.beginTransitionFadeWindow) == "function" then
                SS.beginTransitionFadeWindow(HUDBF.TRANSITION_FADE_IN_SEC)
            end
            if type(Scenes.applyMainOnlySoundscape) == "function" then
                Scenes.applyMainOnlySoundscape({ skipMoodIfAlreadyMain = true })
            end
            if type(SS.endTransitionFadeWindow) == "function" then
                SS.endTransitionFadeWindow()
            end
        end,
    })
    if type(HUDBF.estimateStagedTransitionSec) == "function" then
        return HUDBF.estimateStagedTransitionSec()
    end
    return (HUDBF.BLINDFOLD_DOWN_COMPLETE_SEC or 4)
        + (HUDBF.TRANSITION_FADE_OUT_SEC or 1)
        + (HUDBF.TRANSITION_SETTLE_DELAY_SEC or 10)
end

--- Spotlight → End: staged transition cover. Park carousel under the cover; keep Table A and Main audio.
--- @param ctx table|nil
--- @return number|boolean
local function runSpotlightExitToEndTransition(ctx)
    local HUDBF = require("core.hud_blindfold")
    local Spotlight = require("core.spotlight")
    HUDBF.runStagedTransition({
        fadeOut = function()
            -- Keep Main playing; do not fade location/weather again (already main-only from Spotlight enter).
        end,
        work = function()
            return Spotlight.applyExitWorld()
        end,
        fadeIn = function()
            -- Keep Main. Table B0 + Generic skybox already ran in applyExitWorld (skipSoundscape).
        end,
    })
    if type(HUDBF.estimateStagedTransitionSec) == "function" then
        return HUDBF.estimateStagedTransitionSec()
    end
    return (HUDBF.BLINDFOLD_DOWN_COMPLETE_SEC or 4)
        + (HUDBF.TRANSITION_FADE_OUT_SEC or 1)
        + (HUDBF.TRANSITION_SETTLE_DELAY_SEC or 10)
end

--- Intermission → Play: solo Host auto-enables DEBUG Assume Players Connected (TOR-429).
--- @param ctx table|nil
--- @return boolean
function Phases.maybeEnableAssumePlayersConnectedForSoloHost(ctx)
    ctx = type(ctx) == "table" and ctx or {}
    if ctx.from ~= C.Phases.INTERMISSION then
        return true
    end
    local PlayerConnection = require("core.player_connection")
    if type(PlayerConnection.enableAssumePlayersConnectedIfSoloHost) ~= "function" then
        return true
    end
    if PlayerConnection.enableAssumePlayersConnectedIfSoloHost() then
        U.AlertGM("Assume players connected: ON (solo Host)")
    end
    return true
end

--- Play enter: Intermission AdminDark → OutdoorDim under the global cover (no SetTableTo).
--- Table/skybox prep already ran on Intermission enter (TOR-497).
--- Ambient/main lights apply in Scenes.reconcileFromState; player seat lights need
--- L.reconcileAllPlayers because U.applyLightingPreset only stores the seat preset map (TOR-504).
function Phases.applyPlayEnterNoSceneLights(_ctx)
    S.setStateVal("default", "currentScene")
    S.setStateVal(nil, "sceneTransition")
    local Scenes = require("core.scenes")
    if type(Scenes.invalidateReconcileCache) == "function" then
        Scenes.invalidateReconcileCache()
    end
    if type(Scenes.syncSessionLightingPresetForLocation) == "function" then
        Scenes.syncSessionLightingPresetForLocation()
    end
    if type(Scenes.reconcileFromState) == "function" then
        Scenes.reconcileFromState({ force = true })
    end
    local L = require("core.lighting")
    if type(L.invalidateReconcileCache) == "function" then
        L.invalidateReconcileCache()
    end
    if type(L.reconcileAllPlayers) == "function" then
        L.reconcileAllPlayers({ force = true })
    end
    return true
end

--- Intermission → Play: fade TR_Loop 0.5s and immediately start the Music C overture at full volume.
--- Returns true immediately so lighting can run under the cover without delaying the sting.
--- @param _ctx table|nil
--- @return boolean
function Phases.fireSessionIntro(_ctx)
    local Soundscape = require("core.soundscape")
    local fadeSec = INTERMISSION_TO_PLAY_LOOP_FADE_SEC

    local okStop, stopMsg = Soundscape.stopFeaturedMusic({
        fadeSeconds = fadeSec,
        resumeBackground = false,
    })
    if okStop ~= true then
        U.AlertGM("Intermission→Play Loop fade-out: " .. tostring(stopMsg or "stopFeaturedMusic failed"))
    end

    local key = C.SessionStartIntroKey or "TR_SessionStart"
    local okPlay, playMsg = Soundscape.playSessionIntro(key, { fadeSeconds = 0 })
    if okPlay ~= true then
        U.AlertGM("Session start overture: " .. tostring(playMsg or "playSessionIntro failed"))
    end
    if type(Soundscape.commitEagerSteadyState) == "function" then
        Soundscape.commitEagerSteadyState(okPlay == true)
    end
    return true
end

--- Seconds to keep Play-enter waiting after the overture and explode start.
--- Matches SessionExplode.sequenceDurationSec (cover hide + reset live inside that sequence).
function Phases.sessionIntroBlindfoldHoldSec(_ctx)
    local SE = require("core.session_explode")
    return SE.sequenceDurationSec()
end

--- After the overture finishes: clear the intro latch and fade in Main (Play default).
function Phases.startPlayMainAfterSessionIntro(_ctx)
    local Soundscape = require("core.soundscape")
    if type(Soundscape.finishSessionIntro) == "function" then
        Soundscape.finishSessionIntro()
    end
    local Scenes = require("core.scenes")
    if type(Scenes.applyMainOnlySoundscape) == "function" then
        Scenes.applyMainOnlySoundscape()
    else
        S.setStateVal("main", "soundscape", "musicMood")
        Soundscape.setMusicMood("main")
    end
    if type(Soundscape.commitEagerSteadyState) == "function" then
        Soundscape.commitEagerSteadyState(true)
    end
    return true
end

local function healAmountForPlayer(playerID)
    local ES = require("lib.effective_stats")
    local ctx = ES.forPlayer(playerID)
    local resolve = tonumber(ctx.dotRating("resolve")) or 0
    local composure = tonumber(ctx.dotRating("composure")) or 0
    local amt = resolve
    if composure > amt then
        amt = composure
    end
    if amt < 0 then
        amt = 0
    end
    return math.floor(amt)
end

function Phases.runSessionStartWillpowerHeal(_ctx)
    local P = require("lib.pc_stats")
    local anyHealed = false
    local colors = C.PlayerColors or { "Brown", "Orange", "Pink", "Purple", "Red" }
    for i = 1, #colors do
        local color = colors[i]
        local containerId = "sessionStartHeal_playerContainer_" .. color
        local amountId = "sessionStartHeal_amount_" .. color
        if type(UI.setAttribute) == "function" then
            UI.setAttribute(containerId, "active", "false")
        end
        local playerID = S.getPlayerID(color)
        if type(playerID) == "string" and playerID ~= C.StorytellerID then
            local stats = S.getStateVal("playerData", playerID, "stats")
            local superficial = 0
            if type(stats) == "table" and type(stats.willpower) == "table" then
                superficial = tonumber(stats.willpower.superficial) or 0
            end
            local amount = healAmountForPlayer(playerID)
            if superficial > 0 and amount > 0 then
                local heal = amount
                if heal > superficial then
                    heal = superficial
                end
                P.applyDamageOrHeal(color, "willpower", -heal, 0)
                anyHealed = true
                if type(UI.setAttribute) == "function" then
                    UI.setAttribute(containerId, "active", "true")
                end
                if type(UI.setValue) == "function" then
                    UI.setValue(amountId, tostring(heal))
                end
                local Sync = require("core.sync")
                if type(Sync.player) == "function" then
                    Sync.player(color)
                end
            end
        end
    end
    if not anyHealed then
        return true
    end
    if type(UI.setAttribute) == "function" then
        UI.setAttribute(SESSION_START_HEAL_PANEL, "active", "true")
    end
    if type(UI.show) == "function" then
        UI.show(SESSION_START_HEAL_PANEL)
    end
    return HEAL_BROADCAST_HOLD_SEC
end

local function hideSessionStartHealPanel()
    if type(UI.hide) == "function" then
        UI.hide(SESSION_START_HEAL_PANEL)
    end
    if type(UI.setAttribute) == "function" then
        UI.setAttribute(SESSION_START_HEAL_PANEL, "active", "false")
    end
    return true
end

function Phases.hideSessionStartHealPanel()
    return hideSessionStartHealPanel()
end

-- Registry: empty by default; overwrite with real builders below.
for _, phase in pairs(C.Phases) do
    Phases.onExit[phase] = emptySteps
    Phases.onEnter[phase] = emptySteps
end
for _, sub in pairs(C.PlaySubPhases) do
    Phases.onExitSub[sub] = emptySteps
    Phases.onEnterSub[sub] = emptySteps
end

Phases.onEnter[C.Phases.INTERMISSION] = function(ctx)
    return {
        function()
            return Phases.beginIntermissionCoverAndTheme(ctx)
        end,
        function()
            return Phases.applyNoSceneDefault(ctx, {
                reason = "phase_intermission_enter",
                skipSoundscape = true,
            })
        end,
        function()
            return Phases.applyAllLightsDark(ctx)
        end,
    }
end

Phases.onEnter[C.Phases.PLAY] = function(ctx)
    return {
        function()
            -- Before lighting apply so chronicle seats stay present under TOR-293.
            return Phases.maybeEnableAssumePlayersConnectedForSoloHost(ctx)
        end,
        function()
            -- Phase is already PLAY (set before enter steps). Idempotent re-assert so any
            -- applyGlobalBlindfoldFromPhase race during the phase flip cannot lift early (TOR-363);
            -- no FadeIn when already up (TOR-398).
            return Phases.showGlobalBlindfold(ctx)
        end,
        function()
            -- 0.5s Loop fade + immediate Music C sting; explode starts on the same beat.
            Phases.fireSessionIntro(ctx)
            local SE = require("core.session_explode")
            SE.play()
            return true
        end,
        function()
            -- Lighting only (AdminDark → OutdoorDim) while the sting and explode are already playing.
            return Phases.applyPlayEnterNoSceneLights(ctx)
        end,
        function()
            return Phases.sessionIntroBlindfoldHoldSec(ctx)
        end,
        function()
            return Phases.startPlayMainAfterSessionIntro(ctx)
        end,
        function()
            return Phases.runSessionStartWillpowerHeal(ctx)
        end,
        function()
            return hideSessionStartHealPanel()
        end,
    }
end

Phases.onExit[C.Phases.PLAY] = function(ctx)
    return {
        function()
            local SE = require("core.session_explode")
            SE.cancel()
            return Phases.hideGlobalBlindfold(ctx)
        end,
    }
end

Phases.onEnter[C.Phases.SPOTLIGHT] = function(ctx)
    return {
        function()
            return runSpotlightEnterFromPlayTransition(ctx)
        end,
    }
end

Phases.onExit[C.Phases.SPOTLIGHT] = function(ctx)
    return {
        function()
            -- Default Advance path is Spotlight → End. Park carousel under cover; keep Main (TOR-98).
            if type(ctx) == "table" and ctx.to ~= nil and ctx.to ~= C.Phases.END then
                return Phases.applyNoSceneDefault(ctx, { reason = "phase_spotlight_exit" })
            end
            return runSpotlightExitToEndTransition(ctx)
        end,
    }
end

Phases.onExit[C.Phases.END] = function(ctx)
    return {
        function()
            Phases.incrementSessionNum()
            return true
        end,
        -- Global blindfold is restored on Intermission enter (not per-player transition blinds).
    }
end

local function syncPhaseUi()
    local M = require("core.main")
    if type(M.syncPhase) == "function" then
        M.syncPhase()
    end
    if type(UpdateUIDisplays) == "function" then
        UpdateUIDisplays({ phase = true, gameStateOverlay = true })
    end
    if type(syncStorytellerPhaseButtons) == "function" then
        syncStorytellerPhaseButtons()
    end
end

--- Promote to Play without enter/exit events (scene Apply already owns the world).
function Phases.ensurePlayPhaseForSceneApply()
    local phase = S.getStateVal("currentPhase")
    if phase == C.Phases.PLAY then
        return
    end
    S.setCurrentPhase(C.Phases.PLAY)
    S.setPlaySubPhase(C.PlaySubPhases.MAIN)
    syncPhaseUi()
end

--- @param newPhase string
--- @param opts table|nil unused reserved
--- @return boolean
function Phases.advanceTo(newPhase, opts)
    opts = type(opts) == "table" and opts or {}
    -- Close ST toolbar panels first so Advance UI is not stuck open through heavy enter work (TOR-364).
    local StorytellerPanelUI = require("core.storyteller_panel_ui")
    if type(StorytellerPanelUI.closeAllPanels) == "function" then
        StorytellerPanelUI.closeAllPanels()
    end
    if type(newPhase) ~= "string" or not U.isIn(newPhase, C.Phases) then
        U.AlertGM("Phases.advanceTo: Invalid phase '" .. tostring(newPhase) .. "'")
        return false
    end
    if advancing then
        U.AlertGM("Phases.advanceTo: transition already in progress")
        return false
    end

    local oldPhase = S.getStateVal("currentPhase")
    if oldPhase == newPhase then
        print("Phases: already in " .. tostring(newPhase))
        return true
    end

    advancing = true
    local ctx = {
        from = oldPhase,
        to = newPhase,
        opts = opts,
    }

    local steps = {}
    -- Yield one frame after close so the toolbar paints before exit/enter work (TOR-404).
    steps[#steps + 1] = function()
        return 0.05
    end
    appendSteps(steps, buildSteps(Phases.onExit, oldPhase, ctx))
    steps[#steps + 1] = function()
        S.setCurrentPhase(newPhase)
        if newPhase == C.Phases.PLAY then
            S.setPlaySubPhase(C.PlaySubPhases.MAIN)
        end
        return true
    end
    appendSteps(steps, buildSteps(Phases.onEnter, newPhase, ctx))
    steps[#steps + 1] = function()
        print("Phases: Advanced " .. tostring(oldPhase) .. " → " .. tostring(newPhase))
        return true
    end

    U.chain(steps, {
        maxWait = PHASE_ADVANCE_CHAIN_MAX_WAIT_SEC,
        onComplete = function(ok, detail)
            advancing = false
            syncPhaseUi()
            if ok ~= true then
                U.AlertGM("Phase advance stopped (" .. tostring(detail or "unknown") .. "). Cover or music may still be mid-sequence.")
            end
        end,
    })
    return true
end

function Phases.advanceNext()
    local current = S.getStateVal("currentPhase")
    return Phases.advanceTo(nextPhaseInSequence(current))
end

--- Free switch among Play subphases (no top-level enter/exit).
--- @param subPhase string
--- @return boolean
function Phases.setPlaySubPhase(subPhase)
    if S.getStateVal("currentPhase") ~= C.Phases.PLAY then
        U.AlertGM("Phases.setPlaySubPhase: only valid during Play")
        return false
    end
    if type(subPhase) ~= "string" or not U.isIn(subPhase, C.PlaySubPhases) then
        U.AlertGM("Phases.setPlaySubPhase: Invalid subphase '" .. tostring(subPhase) .. "'")
        return false
    end
    local oldSub = S.getStateVal("playSubPhase")
    if oldSub == subPhase then
        return true
    end
    local ctx = { from = oldSub, to = subPhase }
    local steps = {}
    appendSteps(steps, buildSteps(Phases.onExitSub, oldSub, ctx))
    steps[#steps + 1] = function()
        S.setPlaySubPhase(subPhase)
        return true
    end
    appendSteps(steps, buildSteps(Phases.onEnterSub, subPhase, ctx))
    steps[#steps + 1] = function()
        syncPhaseUi()
        return true
    end
    U.chain(steps)
    return true
end

function Phases.isAdvancing()
    return advancing == true
end

return Phases
