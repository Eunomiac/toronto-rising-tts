--[[
    Game phase lifecycle (TOR-143).

    Top-level: Intermission → Play → Spotlight → End → Intermission.
    Play subphases (free switch): Main / Downtime / Memoriam.

    Enter/exit events are registry step builders consumed by U.chain
    (exit of old phase, then state mutate, then enter of new). Append steps
    to Phases.onEnter / Phases.onExit / onEnterSub / onExitSub without
    changing advanceTo control flow.
]]

local Phases = {}

local C = require("lib.constants")
local U = require("lib.util")
local S = require("core.state")

local SESSION_START_HEAL_PANEL = "sessionStartHeal_panel"
local SESSION_COVER_IMAGE_ID = "overlay_sessionStartSplash"
local SESSION_COVER_PANEL_ID = "overlay_sessionStartSplash_panel"
local SESSION_START_BLACKOUT_ID = "overlay_sessionStart_blackoutPanel"
local SESSION_NUMBER_IMAGE_ID = "overlay_sessionNumber"
local SESSION_TITLE_IMAGE_ID = "overlay_sessionTitle"
local HEAL_BROADCAST_HOLD_SEC = 6
local INTERMISSION_THEME_FADE_SEC = 2
--- End→Intermission blackout (`overlay_blackoutPanel` FadeIn/FadeOut is 5s; hold is one second longer).
local END_INTERMISSION_BLACKOUT_ID = "overlay_blackoutPanel"
local END_INTERMISSION_BLACKOUT_FADE_SEC = 5
local END_INTERMISSION_BLACKOUT_HOLD_SEC = 6
--- TR_Loop starts when the blackout begins FadeOut; duration matches that FadeOut (not the generic Intermission 2s).
local END_INTERMISSION_THEME_FADE_SEC = END_INTERMISSION_BLACKOUT_FADE_SEC
--- Per-step U.chain cap is computed in advanceTo from SessionExplode.maxPlayEnterWaitSec + 15
--- so a longer per-session song is not killed by the default 60s chainWait (TOR-501 / TOR-531).

--- Single in-flight top-level transition token.
local advancing = false
--- Shared with `U.chain` so debug snap can abort a mid-Play intro without cycling phases.
local advanceCancel = { cancelled = false, reason = nil }
--- Phases panel: when true, Intermission→Play skips Music C and runs the splash
--- at songDuration 0. Host-only preference; resets on Save & Play.
local useQuickSessionStartTransition = false

--- @param on boolean
function Phases.setUseQuickSessionStartTransition(on)
    useQuickSessionStartTransition = on == true
end

--- @return boolean
function Phases.useQuickSessionStartTransition()
    return useQuickSessionStartTransition == true
end

--- True while `Phases.advanceTo` / `advanceNext` U.chain is in flight (exit → mutate → enter).
function Phases.isAdvancing()
    return advancing == true
end

--- Best-effort abort of the in-flight Advance chain (explode wait, Main fade, heal overlay).
-- @param reason string|nil Stored on the chain cancel registry (e.g. `"debug_reset"`).
-- @return boolean true if a transition was in flight
function Phases.abortAdvance(reason)
    if advancing ~= true then
        return false
    end
    advanceCancel.cancelled = true
    advanceCancel.reason = reason or "aborted"
    return true
end

--- @type table<string, fun(ctx: table): table>
Phases.onExit = {}
--- @type table<string, fun(ctx: table): table>
Phases.onEnter = {}
--- @type table<string, fun(ctx: table): table>
Phases.onExitSub = {}
--- @type table<string, fun(ctx: table): table>
Phases.onEnterSub = {}

local function emptySteps(_ctx)
    return {}
end

local function appendSteps(dest, src)
    if type(src) ~= "table" then
        return
    end
    for i = 1, #src do
        dest[#dest + 1] = src[i]
    end
end

local function buildSteps(registry, phase, ctx)
    local builder = registry[phase]
    if type(builder) ~= "function" then
        return {}
    end
    local steps = builder(ctx)
    if type(steps) ~= "table" then
        return {}
    end
    return steps
end

local function nextPhaseInSequence(current)
    local seq = C.PhaseSequence
    if type(seq) ~= "table" or #seq < 1 then
        return C.Phases.INTERMISSION
    end
    local idx = nil
    for i = 1, #seq do
        if seq[i] == current then
            idx = i
            break
        end
    end
    if idx == nil then
        return seq[1]
    end
    local nextIdx = idx + 1
    if nextIdx > #seq then
        nextIdx = 1
    end
    return seq[nextIdx]
end

--- Spaced unicode roman numerals for session overlay (TOR-263 / TOR-143).
--- @param n number
--- @return string
function Phases.romanize(n)
    local v = math.floor(tonumber(n) or 0)
    if v < 1 then
        return ""
    end
    if v > 3999 then
        v = 3999
    end
    local map = {
        { 1000, "M" },
        { 900, "CM" },
        { 500, "D" },
        { 400, "CD" },
        { 100, "C" },
        { 90, "XC" },
        { 50, "L" },
        { 40, "XL" },
        { 10, "X" },
        { 9, "IX" },
        { 5, "V" },
        { 4, "IV" },
        { 1, "I" },
    }
    local parts = {}
    for i = 1, #map do
        local value = map[i][1]
        local numeral = map[i][2]
        while v >= value do
            parts[#parts + 1] = numeral
            v = v - value
        end
    end
    return table.concat(parts, " ")
end

function Phases.incrementSessionNum()
    local n = tonumber(S.getStateVal("sessionNum")) or 1
    S.setSessionNum(n + 1)
end

--- Normalize sessionNum for CustomUIAsset image names (TOR-561).
-- @param sessionNum number|nil
-- @return number
local function normalizeSessionNum(sessionNum)
    local n = math.floor(tonumber(sessionNum) or tonumber(S.getStateVal("sessionNum")) or 1)
    if n < 1 then
        n = 1
    end
    return n
end

--- Session that just ended (set on End exit before increment). Used for end splash (TOR-566).
local pendingEndedSessionNum = nil

--- Remember the outgoing session before `incrementSessionNum` on End exit.
-- @param sessionNum number|nil
function Phases.stashEndedSessionNumForSplash(sessionNum)
    pendingEndedSessionNum = normalizeSessionNum(sessionNum)
end

--- Session index for `overlay_sessionEndSplash_<N>` after End → Intermission.
--- Prefers the stash from End exit; otherwise `sessionNum - 1` (post-increment fallback).
-- @return number
function Phases.endedSessionNumForSplash()
    if pendingEndedSessionNum ~= nil then
        return pendingEndedSessionNum
    end
    local n = normalizeSessionNum(nil) - 1
    if n < 1 then
        n = 1
    end
    return n
end

--- Session-start splash CustomUIAsset name for `overlay_sessionStartSplash`.
-- @param sessionNum number|nil
-- @return string
function Phases.sessionBlindfoldImageName(sessionNum)
    return "overlay_sessionStartSplash_" .. tostring(normalizeSessionNum(sessionNum))
end

--- Session-end splash CustomUIAsset name for End→Intermission global cover.
-- @param sessionNum number|nil  When nil, uses `endedSessionNumForSplash()` (TOR-566).
-- @return string
function Phases.endBlindfoldImageName(sessionNum)
    local n = sessionNum
    if n == nil then
        n = Phases.endedSessionNumForSplash()
    end
    return "overlay_sessionEndSplash_" .. tostring(normalizeSessionNum(n))
end

--- Per-session number / title CustomUIAsset names (session-start explode stack).
-- @param sessionNum number|nil
-- @return string, string
function Phases.sessionNumberAndTitleImageNames(sessionNum)
    local n = tostring(normalizeSessionNum(sessionNum))
    return "overlay_sessionNumber_" .. n, "overlay_sessionTitle_" .. n
end

--- Set session-start splash, number, and title Images for the given session.
-- Does not show or hide panels. Does **not** write the global cover Image — scene transitions
-- own that Image, and End→Intermission sets `overlay_sessionEndSplash_<N>` in showEnd (TOR-566).
-- Start splash / number / title start `active=false` in XML so a missing image does not flash white.
-- @param sessionNum number|nil
-- @return boolean
function Phases.applySessionBlindfoldImages(sessionNum)
    local n = normalizeSessionNum(sessionNum)
    local numName, titleName = Phases.sessionNumberAndTitleImageNames(n)
    -- Parent class defaults inactive; splash art is invisible without this (black backing only).
    UI.setAttributes(SESSION_COVER_PANEL_ID, { active = "true" })
    UI.setAttributes(SESSION_START_BLACKOUT_ID, { active = "false" })
    UI.setAttributes(SESSION_COVER_IMAGE_ID, {
        image = Phases.sessionBlindfoldImageName(n),
        active = "true",
    })
    UI.setAttributes(SESSION_NUMBER_IMAGE_ID, {
        image = numName,
        active = "true",
    })
    UI.setAttributes(SESSION_TITLE_IMAGE_ID, {
        image = titleName,
        active = "true",
    })
    return true
end

--- Call Global-script helpers for session-start / global cover panels only.
--- Never touch condition overlays (`hudBlindfold` bookkeeping is separate).
local function callGlobalBlindfoldHelper(name)
    local fn = rawget(_G, name)
    if type(fn) == "function" then
        fn()
        return true
    end
    U.AlertGM("Phases: missing Global helper `" .. tostring(name) .. "`")
    return true
end

--- Hide session-start overlay and non-persistent global blindfold.
function Phases.hideGlobalBlindfold(_ctx)
    return callGlobalBlindfoldHelper("hideStartupLoadingOverlaysForPhases")
end

--- Show session-start overlay (`overlay_sessionStart_panel`) — cold Intermission / debug only.
function Phases.showGlobalBlindfold(_ctx)
    local SE = require("core.session_explode")
    if type(SE.resetLayers) == "function" then
        SE.resetLayers()
    end
    return callGlobalBlindfoldHelper("showStartupLoadingOverlaysForPhases")
end

--- Show global blindfold with end splash for End → Intermission (persistent until next load).
function Phases.showEndGlobalBlindfold(_ctx)
    return callGlobalBlindfoldHelper("showEndGlobalBlindfoldForPhases")
end

--- Connect outside Intermission: hide global blindfold (shared overlay — not per-seat).
--- @param player Player|nil unused; kept for call-site clarity
function Phases.lowerBlindfoldForConnectingPlayer(player)
    if player == nil or not U.isPlayer(player) then
        return
    end
    Phases.hideGlobalBlindfold(nil)
end

function Phases.applyAllLightsDark(_ctx)
    S.setStateVal("dark", "currentScene")
    S.setStateVal("AdminDark", "sessionScene", "lightingPresetKey")
    S.setStateVal(nil, "sceneTransition")
    local Scenes = require("core.scenes")
    if type(Scenes.invalidateReconcileCache) == "function" then
        Scenes.invalidateReconcileCache()
    end
    local Sync = require("core.sync")
    Sync.full({ reason = "phase_intermission_dark", skipSoundscape = true })
    return true
end

--- End → Intermission: TR_Loop fades in while every other lane fades out.
--- Does not `stopAll` — that would hard-cut the outgoing fade. Does not lift the end splash.
--- Returns immediately; the fades run for `opts.fadeSeconds` (default INTERMISSION_THEME_FADE_SEC).
--- The Advance chain owns the waits.
--- @param _ctx table|nil
--- @param opts table|nil `{ fadeSeconds?: number }` — End→Intermission uses blackout FadeOut length
function Phases.beginIntermissionThemeHandoff(_ctx, opts)
    opts = type(opts) == "table" and opts or {}
    local fadeSec = tonumber(opts.fadeSeconds)
    if fadeSec == nil or fadeSec < 0 then
        fadeSec = INTERMISSION_THEME_FADE_SEC
    end
    local Soundscape = require("core.soundscape")
    local key = C.IntermissionThemeFeaturedKey or "TR_Loop"
    local ok, msg = Soundscape.playFeaturedMusic(key, {
        incomingFadeSeconds = fadeSec,
        outgoingFadeSeconds = fadeSec,
    })
    if ok ~= true then
        U.AlertGM("Intermission theme: " .. tostring(msg or "playFeaturedMusic failed"))
    end
    if type(Soundscape.fadeOutTransitionAmbient) == "function" then
        Soundscape.fadeOutTransitionAmbient({
            seconds = fadeSec,
            silenceAfter = true,
        })
    end
    if type(Soundscape.stopSessionIntro) == "function" then
        Soundscape.stopSessionIntro({ fadeSeconds = fadeSec })
    end
    if type(Soundscape.commitEagerSteadyState) == "function" then
        Soundscape.commitEagerSteadyState(ok == true)
    elseif type(Soundscape.markReconciledToCurrentState) == "function" then
        Soundscape.markReconciledToCurrentState()
    end
    return true
end

--- @return table `{ x, y, z }` table-origin X/Z plus snapshot or live Y
local function particleEmitterRestorePosition(obj)
    local G = require("lib.guids")
    local tableKey = S.getStateVal("seatLayout", "currentTableKey")
    local originX, originZ = 0, 0
    if type(tableKey) == "string" and type(C.Tables) == "table" then
        local cfg = C.Tables[tableKey]
        if type(cfg) == "table" and cfg.centerPoint ~= nil then
            originX = tonumber(cfg.centerPoint.x) or 0
            originZ = tonumber(cfg.centerPoint.z) or 0
        end
    end
    local y = nil
    local guid = G.GUIDS.PARTICLE_EMITTER
    if type(guid) == "string" then
        local snap = S.getStateVal("hiddenObjects", guid)
        if type(snap) == "table" and type(snap.position) == "table" then
            y = tonumber(snap.position.y)
        end
    end
    if (type(y) ~= "number" or y <= (C.HIDDEN_OBJECT_WORLD_Y or -200) + 1) and obj ~= nil and obj.getPosition ~= nil then
        local live = obj.getPosition()
        if (type(live) == "userdata" or type(live) == "table") and type(live.y) == "number"
            and live.y > (C.HIDDEN_OBJECT_WORLD_Y or -200) + 1 then
            y = live.y
        end
    end
    if type(y) ~= "number" then
        y = 0
    end
    return { x = originX, y = y, z = originZ }
end

--- Hide the rain emitter off Play; restore on Play. Scatter keeps ownership while Scatter is on (TOR-581).
function Phases.reconcileParticleEmitterFromPhase()
    local G = require("lib.guids")
    local O = require("core.objects")
    local guid = G.GUIDS and G.GUIDS.PARTICLE_EMITTER or nil
    if type(guid) ~= "string" or guid == "" then
        return false
    end
    local obj = G.getObject(guid)
    if obj == nil then
        return false
    end
    local Occupancy = require("lib.scatter_occupancy")
    if Occupancy.isScatterLayoutActive() == true then
        return true
    end
    if S.getStateVal("currentPhase") == C.Phases.PLAY then
        if O.isHiddenObject(obj) then
            O.restoreObject(obj, { position = particleEmitterRestorePosition(obj) })
        end
        return true
    end
    if not O.isHiddenObject(obj) then
        O.hideObject(obj)
    end
    return true
end

--- Live library scene → Main; otherwise Downtime (TOR-527).
--- @return string
function Phases.playSubPhaseForLiveScene()
    local SceneLibrary = require("core.scene_library")
    if type(SceneLibrary.hasLiveSceneOnTable) == "function" and SceneLibrary.hasLiveSceneOnTable() == true then
        return C.PlaySubPhases.MAIN
    end
    return C.PlaySubPhases.DOWNTIME
end

--- @return boolean
function Phases.isPlayDowntime()
    return S.getStateVal("currentPhase") == C.Phases.PLAY
        and S.getStateVal("playSubPhase") == C.PlaySubPhases.DOWNTIME
end

--- First Intermission→Play Downtime (no live scene) uses prologue overlay copy (TOR-598).
--- @param on boolean
local function writeSessionStartDowntime(on)
    S.setStateVal(on == true, "sessionStartDowntime")
end

--- Copy chronicle present-day (or live session clock) into `gameState.downtimeClock`. Does not write present-day.
function Phases.copyPresentDayIntoDowntimeClock()
    local pd = S.getStateVal("presentDayClock")
    local copy = nil
    if type(pd) == "table" then
        copy = U.clone(pd, true)
    end
    if type(copy) ~= "table" then
        local live = S.getStateVal("sessionScene", "clock")
        if type(live) == "table" then
            copy = U.clone(live, true)
        end
    end
    S.setStateVal(copy, "downtimeClock")
    return true
end

--- When already Play, switch Main/Downtime to match live-scene presence (no-op if already correct).
function Phases.syncPlaySubPhaseToLiveScene()
    if S.getStateVal("currentPhase") ~= C.Phases.PLAY then
        return false
    end
    return Phases.setPlaySubPhase(Phases.playSubPhaseForLiveScene())
end

--- Starts looping TR_Loop on the featured lane (Intermission ambient).
--- TOR-366: always fade in from volume 0 (silent arm + incomingFadeSeconds).
function Phases.startIntermissionThemePlaylistLoop(_ctx)
    local Soundscape = require("core.soundscape")
    if type(Soundscape.stopAll) == "function" then
        Soundscape.stopAll()
    end
    local key = C.IntermissionThemeFeaturedKey or "TR_Loop"
    local ok, msg = Soundscape.playFeaturedMusic(key, {
        incomingFadeSeconds = INTERMISSION_THEME_FADE_SEC,
    })
    if ok ~= true then
        U.AlertGM("Intermission theme: " .. tostring(msg or "playFeaturedMusic failed"))
    end
    if type(Soundscape.commitEagerSteadyState) == "function" then
        Soundscape.commitEagerSteadyState(ok == true)
    elseif type(Soundscape.markReconciledToCurrentState) == "function" then
        Soundscape.markReconciledToCurrentState()
    end
    return true
end

--- Load-time Intermission ambient: hard-reset emitters then fade in TR_Loop (no cover to sync with).
function Phases.reconcileIntermissionAmbientOnLoad()
    if S.getStateVal("currentPhase") ~= C.Phases.INTERMISSION then
        return false
    end
    Phases.applyAllLightsDark(nil)
    return Phases.startIntermissionThemePlaylistLoop(nil)
end

function Phases.freezeClock(_ctx)
    S.setStateVal(false, "sessionScene", "clock", "useRealTime")
    S.setStateVal(0, "sessionScene", "clock", "speed")
    local GameStateOverlay = require("core.game_state_overlay")
    if type(GameStateOverlay.stopTicker) == "function" then
        GameStateOverlay.stopTicker()
    end
    if type(GameStateOverlay.reconcileFromState) == "function" then
        GameStateOverlay.reconcileFromState()
    end
    return true
end

function Phases.applyNoSceneDefault(_ctx, opts)
    opts = type(opts) == "table" and opts or {}
    local Scenes = require("core.scenes")
    Scenes.applyDefaultNoSceneEnvironment({
        reason = opts.reason or "phase_play_enter",
        skipTransitionBlindfold = true,
        skipSoundscape = opts.skipSoundscape == true,
        randomizeSeating = true,
    })
    return true
end

--- Play → Spotlight: staged transition cover (same lead-in as scene Apply). Destination cards stay Clear.
--- @param ctx table|nil
--- @return number|boolean
local function runSpotlightEnterFromPlayTransition(ctx)
    local HUDBF = require("core.hud_blindfold")
    local SS = require("core.soundscape")
    local Scenes = require("core.scenes")
    local Spotlight = require("core.spotlight")
    local mood = S.getStateVal("soundscape", "musicMood")
    HUDBF.runStagedTransition({
        fadeOut = function()
            if type(SS.fadeOutTransitionAmbient) == "function" then
                SS.fadeOutTransitionAmbient({
                    seconds = HUDBF.TRANSITION_FADE_OUT_SEC,
                    skipBackground = mood == "main",
                })
            end
        end,
        work = function()
            return Spotlight.applyEnterWorld()
        end,
        fadeIn = function()
            if type(SS.beginTransitionFadeWindow) == "function" then
                SS.beginTransitionFadeWindow(HUDBF.TRANSITION_FADE_IN_SEC)
            end
            if type(Scenes.applyMainOnlySoundscape) == "function" then
                Scenes.applyMainOnlySoundscape({ skipMoodIfAlreadyMain = true })
            end
            if type(SS.endTransitionFadeWindow) == "function" then
                SS.endTransitionFadeWindow()
            end
        end,
    })
    if type(HUDBF.estimateStagedTransitionSec) == "function" then
        return HUDBF.estimateStagedTransitionSec()
    end
    return (HUDBF.BLINDFOLD_DOWN_COMPLETE_SEC or 4)
        + (HUDBF.TRANSITION_FADE_OUT_SEC or 1)
        + (HUDBF.TRANSITION_SETTLE_DELAY_SEC or 10)
end

--- Spotlight → End: staged transition cover. Park carousel under the cover; keep Table A and Main audio.
--- @param ctx table|nil
--- @return number|boolean
local function runSpotlightExitToEndTransition(ctx)
    local HUDBF = require("core.hud_blindfold")
    local Spotlight = require("core.spotlight")
    HUDBF.runStagedTransition({
        fadeOut = function()
            -- Keep Main playing; do not fade location/weather again (already main-only from Spotlight enter).
        end,
        work = function()
            return Spotlight.applyExitWorld()
        end,
        fadeIn = function()
            -- Keep Main. Table B0 + Generic skybox already ran in applyExitWorld (skipSoundscape).
        end,
    })
    if type(HUDBF.estimateStagedTransitionSec) == "function" then
        return HUDBF.estimateStagedTransitionSec()
    end
    return (HUDBF.BLINDFOLD_DOWN_COMPLETE_SEC or 4)
        + (HUDBF.TRANSITION_FADE_OUT_SEC or 1)
        + (HUDBF.TRANSITION_SETTLE_DELAY_SEC or 10)
end

--- Intermission → Play: solo Host auto-enables DEBUG Assume Players Connected (TOR-429).
--- @param ctx table|nil
--- @return boolean
function Phases.maybeEnableAssumePlayersConnectedForSoloHost(ctx)
    ctx = type(ctx) == "table" and ctx or {}
    if ctx.from ~= C.Phases.INTERMISSION then
        return true
    end
    local PlayerConnection = require("core.player_connection")
    if type(PlayerConnection.enableAssumePlayersConnectedIfSoloHost) ~= "function" then
        return true
    end
    if PlayerConnection.enableAssumePlayersConnectedIfSoloHost() then
        U.AlertGM("Assume players connected: ON (solo Host)")
    end
    return true
end

--- Play enter: Intermission AdminDark → OutdoorDim under the global cover (no SetTableTo).
--- Table/skybox prep already ran on Intermission enter (TOR-497).
--- Ambient/main lights apply in Scenes.reconcileFromState; player seat lights need
--- L.reconcileAllPlayers because U.applyLightingPreset only stores the seat preset map (TOR-504).
--- Runs before explode/sting so this force-reconcile cannot hitch the cover lerp (TOR-535).
--- Seat lights snap instantly (`transitionTime = 0`) so the default 2s lerp cannot overlap
--- the explode (TOR-536).
function Phases.applyPlayEnterNoSceneLights(_ctx)
    S.setStateVal("default", "currentScene")
    S.setStateVal(nil, "sceneTransition")
    local Scenes = require("core.scenes")
    if type(Scenes.invalidateReconcileCache) == "function" then
        Scenes.invalidateReconcileCache()
    end
    if type(Scenes.syncSessionLightingPresetForLocation) == "function" then
        Scenes.syncSessionLightingPresetForLocation()
    end
    if type(Scenes.reconcileFromState) == "function" then
        Scenes.reconcileFromState({ force = true })
    end
    local L = require("core.lighting")
    if type(L.invalidateReconcileCache) == "function" then
        L.invalidateReconcileCache()
    end
    if type(L.reconcileAllPlayers) == "function" then
        L.reconcileAllPlayers({ force = true, transitionTime = 0 })
    end
    return true
end

--- After the overture finishes: clear the intro latch and fade in Main (Play default).
function Phases.startPlayMainAfterSessionIntro(_ctx)
    local Soundscape = require("core.soundscape")
    if type(Soundscape.finishSessionIntro) == "function" then
        Soundscape.finishSessionIntro()
    end
    local Scenes = require("core.scenes")
    if type(Scenes.applyMainOnlySoundscape) == "function" then
        Scenes.applyMainOnlySoundscape()
    else
        S.setStateVal("main", "soundscape", "musicMood")
        Soundscape.setMusicMood("main")
    end
    if type(Soundscape.commitEagerSteadyState) == "function" then
        Soundscape.commitEagerSteadyState(true)
    end
    return true
end

local function healAmountForPlayer(playerID)
    local ES = require("lib.effective_stats")
    local ctx = ES.forPlayer(playerID)
    local resolve = tonumber(ctx.dotRating("resolve")) or 0
    local composure = tonumber(ctx.dotRating("composure")) or 0
    local amt = resolve
    if composure > amt then
        amt = composure
    end
    if amt < 0 then
        amt = 0
    end
    return math.floor(amt)
end

function Phases.runSessionStartWillpowerHeal(_ctx)
    local P = require("lib.pc_stats")
    local anyHealed = false
    local colors = C.PlayerColors or { "Brown", "Orange", "Pink", "Purple", "Red" }
    for i = 1, #colors do
        local color = colors[i]
        local containerId = "sessionStartHeal_playerContainer_" .. color
        local amountId = "sessionStartHeal_amount_" .. color
        if type(UI.setAttribute) == "function" then
            UI.setAttribute(containerId, "active", "false")
        end
        local playerID = S.getPlayerID(color)
        if type(playerID) == "string" and playerID ~= C.StorytellerID then
            local stats = S.getStateVal("playerData", playerID, "stats")
            local superficial = 0
            if type(stats) == "table" and type(stats.willpower) == "table" then
                superficial = tonumber(stats.willpower.superficial) or 0
            end
            local amount = healAmountForPlayer(playerID)
            if superficial > 0 and amount > 0 then
                local heal = amount
                if heal > superficial then
                    heal = superficial
                end
                P.applyDamageOrHeal(color, "willpower", -heal, 0)
                anyHealed = true
                if type(UI.setAttribute) == "function" then
                    UI.setAttribute(containerId, "active", "true")
                end
                if type(UI.setValue) == "function" then
                    UI.setValue(amountId, tostring(heal))
                end
                local Sync = require("core.sync")
                if type(Sync.player) == "function" then
                    Sync.player(color)
                end
            end
        end
    end
    if not anyHealed then
        return true
    end
    if type(UI.setAttribute) == "function" then
        UI.setAttribute(SESSION_START_HEAL_PANEL, "active", "true")
    end
    if type(UI.show) == "function" then
        UI.show(SESSION_START_HEAL_PANEL)
    end
    return HEAL_BROADCAST_HOLD_SEC
end

local function hideSessionStartHealPanel()
    if type(UI.hide) == "function" then
        UI.hide(SESSION_START_HEAL_PANEL)
    end
    if type(UI.setAttribute) == "function" then
        UI.setAttribute(SESSION_START_HEAL_PANEL, "active", "false")
    end
    return true
end

function Phases.hideSessionStartHealPanel()
    return hideSessionStartHealPanel()
end

-- Registry: empty by default; overwrite with real builders below.
for _, phase in pairs(C.Phases) do
    Phases.onExit[phase] = emptySteps
    Phases.onEnter[phase] = emptySteps
end
for _, sub in pairs(C.PlaySubPhases) do
    Phases.onExitSub[sub] = emptySteps
    Phases.onEnterSub[sub] = emptySteps
end

Phases.onEnterSub[C.PlaySubPhases.DOWNTIME] = function(_ctx)
    return {
        function()
            Phases.copyPresentDayIntoDowntimeClock()
            return true
        end,
    }
end

Phases.onEnter[C.Phases.INTERMISSION] = function(ctx)
    return {
        function()
            -- Blackout FadeIn only; hold until opaque before splash + theme (no TR_Loop under black).
            callGlobalBlindfoldHelper("beginEndIntermissionCoverHoldForPhases")
            if type(UI.show) == "function" then
                UI.show(END_INTERMISSION_BLACKOUT_ID)
            end
            return END_INTERMISSION_BLACKOUT_HOLD_SEC
        end,
        function()
            -- Splash under opaque blackout; start TR_Loop as blackout FadeOut begins (same duration).
            callGlobalBlindfoldHelper("showEndGlobalBlindfoldInstantForPhases")
            Phases.beginIntermissionThemeHandoff(ctx, { fadeSeconds = END_INTERMISSION_THEME_FADE_SEC })
            if type(UI.hide) == "function" then
                UI.hide(END_INTERMISSION_BLACKOUT_ID)
            end
            return END_INTERMISSION_BLACKOUT_FADE_SEC
        end,
        function()
            if type(U.setAttribute) == "function" then
                U.setAttribute(END_INTERMISSION_BLACKOUT_ID, "active", "false")
            end
            local Main = require("core.main")
            if type(Main.snapDefaultCamerasAfterLayout) == "function" then
                Main.snapDefaultCamerasAfterLayout("ALL")
            end
            return true
        end,
        function()
            return Phases.applyNoSceneDefault(ctx, {
                reason = "phase_intermission_enter",
                skipSoundscape = true,
            })
        end,
        function()
            Phases.reconcileParticleEmitterFromPhase()
            return Phases.applyAllLightsDark(ctx)
        end,
    }
end

--- Paint Play HUD while the global cover is still up so the explode hide does not
--- reveal a blank overlay (TOR-532). Phase is already PLAY (set before enter steps).
--- Overlay and player HUD live behind the cover; they can be shown at any time.
-- @param _ctx table|nil
-- @return boolean
function Phases.armPlayHudBehindCover(_ctx)
    if type(UpdateUIDisplays) == "function" then
        UpdateUIDisplays({
            phase = true,
            gameStateOverlay = true,
            playerHud = true,
            overlays = true,
        })
    end
    return true
end

Phases.onEnter[C.Phases.PLAY] = function(ctx)
    local steps = {
        function()
            -- Before lighting apply so chronicle seats stay present under TOR-293.
            return Phases.maybeEnableAssumePlayersConnectedForSoloHost(ctx)
        end,
        function()
            -- Phase is already PLAY (set before enter steps). Idempotent re-assert so any
            -- applyGlobalBlindfoldFromPhase race during the phase flip cannot lift early (TOR-363);
            -- no FadeIn when already up (TOR-398).
            return Phases.showGlobalBlindfold(ctx)
        end,
        function()
            return Phases.armPlayHudBehindCover(ctx)
        end,
        function()
            -- OutdoorDim + seat lights behind the cover before explode/sting (TOR-535).
            -- Then wait so TTS can finish those applies before fade/explode (TOR-536).
            Phases.applyPlayEnterNoSceneLights(ctx)
            return C.SessionStartPlayEnterSettleSec
        end,
        function()
            if S.getStateVal("playSubPhase") == C.PlaySubPhases.DOWNTIME then
                Phases.copyPresentDayIntoDowntimeClock()
            end
            Phases.reconcileParticleEmitterFromPhase()
            return true
        end,
    }
    steps[#steps + 1] = function()
        -- Splash after lights. Quick Transition skips Music C and uses songDuration 0.
        local SE = require("core.session_explode")
        if Phases.useQuickSessionStartTransition() then
            return SE.playAttribute(0)
        end
        return SE.playAttribute()
    end
    steps[#steps + 1] = function()
        return Phases.startPlayMainAfterSessionIntro(ctx)
    end
    steps[#steps + 1] = function()
        return Phases.runSessionStartWillpowerHeal(ctx)
    end
    steps[#steps + 1] = function()
        return hideSessionStartHealPanel()
    end
    return steps
end

Phases.onExit[C.Phases.PLAY] = function(ctx)
    return {
        function()
            local SE = require("core.session_explode")
            SE.cancel()
            return Phases.hideGlobalBlindfold(ctx)
        end,
    }
end

Phases.onEnter[C.Phases.SPOTLIGHT] = function(ctx)
    return {
        function()
            Phases.reconcileParticleEmitterFromPhase()
            return runSpotlightEnterFromPlayTransition(ctx)
        end,
    }
end

Phases.onExit[C.Phases.SPOTLIGHT] = function(ctx)
    return {
        function()
            -- Default Advance path is Spotlight → End. Park carousel under cover; keep Main (TOR-98).
            if type(ctx) == "table" and ctx.to ~= nil and ctx.to ~= C.Phases.END then
                return Phases.applyNoSceneDefault(ctx, { reason = "phase_spotlight_exit" })
            end
            return runSpotlightExitToEndTransition(ctx)
        end,
    }
end

Phases.onEnter[C.Phases.END] = function(_ctx)
    return {
        function()
            return Phases.reconcileParticleEmitterFromPhase()
        end,
    }
end

Phases.onExit[C.Phases.END] = function(ctx)
    return {
        function()
            -- Stash before increment so End→Intermission splash uses the session that just ended (TOR-566).
            Phases.stashEndedSessionNumForSplash(nil)
            Phases.incrementSessionNum()
            return true
        end,
        -- Global blindfold is restored on Intermission enter (not per-player transition blinds).
    }
end

local function syncPhaseUi()
    local M = require("core.main")
    if type(M.syncPhase) == "function" then
        M.syncPhase()
    end
    if type(UpdateUIDisplays) == "function" then
        UpdateUIDisplays({ phase = true, gameStateOverlay = true })
    end
    if type(syncStorytellerPhaseButtons) == "function" then
        syncStorytellerPhaseButtons()
    end
end

--- Debug: snap to Intermission so Intermission→Play can be re-tested without Spotlight/End.
--- Does not move tables, skyboxes, or seat piles. Restores the session-start cover (not end cover).
-- @return boolean
function Phases.debugSnapToIntermission()
    Phases.abortAdvance("debug_reset")
    local SE = require("core.session_explode")
    if type(SE.cancel) == "function" then
        SE.cancel()
    end
    S.setCurrentPhase(C.Phases.INTERMISSION)
    writeSessionStartDowntime(false)
    Phases.applySessionBlindfoldImages(nil)
    Phases.showGlobalBlindfold(nil)
    hideSessionStartHealPanel()
    Phases.startIntermissionThemePlaylistLoop(nil)
    syncPhaseUi()
    return true
end

--- Promote to Play without enter/exit events (scene Apply already owns the world).
--- Always couples Main/Downtime to whether a library scene is live (TOR-527).
function Phases.ensurePlayPhaseForSceneApply()
    local desired = Phases.playSubPhaseForLiveScene()
    local phase = S.getStateVal("currentPhase")
    if phase == C.Phases.PLAY then
        Phases.setPlaySubPhase(desired)
        return
    end
    S.setCurrentPhase(C.Phases.PLAY)
    S.setPlaySubPhase(desired)
    syncPhaseUi()
end

--- @param newPhase string
--- @param opts table|nil unused reserved
--- @return boolean
function Phases.advanceTo(newPhase, opts)
    opts = type(opts) == "table" and opts or {}
    -- Close ST toolbar panels first so Advance UI is not stuck open through heavy enter work (TOR-364).
    local StorytellerPanelUI = require("core.storyteller_panel_ui")
    if type(StorytellerPanelUI.closeAllPanels) == "function" then
        StorytellerPanelUI.closeAllPanels()
    end
    if type(newPhase) ~= "string" or not U.isIn(newPhase, C.Phases) then
        U.AlertGM("Phases.advanceTo: Invalid phase '" .. tostring(newPhase) .. "'")
        return false
    end
    if advancing then
        U.AlertGM("Phases.advanceTo: transition already in progress")
        return false
    end

    local oldPhase = S.getStateVal("currentPhase")
    if oldPhase == newPhase then
        print("Phases: already in " .. tostring(newPhase))
        return true
    end

    advancing = true
    advanceCancel.cancelled = false
    advanceCancel.reason = nil
    local ctx = {
        from = oldPhase,
        to = newPhase,
        opts = opts,
    }

    local steps = {}
    -- Yield one frame after close so the toolbar paints before exit/enter work (TOR-404).
    steps[#steps + 1] = function()
        return 0.05
    end
    appendSteps(steps, buildSteps(Phases.onExit, oldPhase, ctx))
    steps[#steps + 1] = function()
        S.setCurrentPhase(newPhase)
        if newPhase == C.Phases.PLAY then
            local sub = Phases.playSubPhaseForLiveScene()
            S.setPlaySubPhase(sub)
            writeSessionStartDowntime(
                oldPhase == C.Phases.INTERMISSION and sub == C.PlaySubPhases.DOWNTIME
            )
        else
            writeSessionStartDowntime(false)
        end
        return true
    end
    appendSteps(steps, buildSteps(Phases.onEnter, newPhase, ctx))
    steps[#steps + 1] = function()
        print("Phases: Advanced " .. tostring(oldPhase) .. " → " .. tostring(newPhase))
        return true
    end

    local SEWait = require("core.session_explode")
    local PHASE_ADVANCE_CHAIN_MAX_WAIT_SEC = SEWait.maxPlayEnterWaitSec() + 15
    U.chain(steps, {
        maxWait = PHASE_ADVANCE_CHAIN_MAX_WAIT_SEC,
        cancelRegistry = advanceCancel,
        onComplete = function(ok, detail)
            advancing = false
            syncPhaseUi()
            if ok ~= true and detail ~= "debug_reset" then
                U.AlertGM("Phase advance stopped (" .. tostring(detail or "unknown") .. "). Cover or music may still be mid-sequence.")
            end
        end,
    })
    return true
end

function Phases.advanceNext()
    local current = S.getStateVal("currentPhase")
    return Phases.advanceTo(nextPhaseInSequence(current))
end

--- Free switch among Play subphases (no top-level enter/exit).
--- @param subPhase string
--- @return boolean
function Phases.setPlaySubPhase(subPhase)
    if S.getStateVal("currentPhase") ~= C.Phases.PLAY then
        U.AlertGM("Phases.setPlaySubPhase: only valid during Play")
        return false
    end
    if type(subPhase) ~= "string" or not U.isIn(subPhase, C.PlaySubPhases) then
        U.AlertGM("Phases.setPlaySubPhase: Invalid subphase '" .. tostring(subPhase) .. "'")
        return false
    end
    local oldSub = S.getStateVal("playSubPhase")
    if oldSub == subPhase then
        return true
    end
    local ctx = { from = oldSub, to = subPhase }
    local steps = {}
    appendSteps(steps, buildSteps(Phases.onExitSub, oldSub, ctx))
    steps[#steps + 1] = function()
        S.setPlaySubPhase(subPhase)
        if subPhase ~= C.PlaySubPhases.DOWNTIME then
            writeSessionStartDowntime(false)
        end
        return true
    end
    appendSteps(steps, buildSteps(Phases.onEnterSub, subPhase, ctx))
    steps[#steps + 1] = function()
        syncPhaseUi()
        return true
    end
    U.chain(steps)
    return true
end

return Phases
