--[[
    NPC on-demand spawning, paired spotlights, and gameboard/reconciler integration.
    Figurines + lights exist only while an NPC is on the stage, at a seat, or in Scatter; the reconciler
    spawns them (`core/npc_spawn.ttslua`) and destroys them when the NPC leaves (TOR-707).
    Data: lib/npcs_data.ttslua (NPCS.characters, NPCS.lights).
    Spec: .dev/NPC Object Spawning & Spotlighting/NPC Object Overview.md
    Related: .dev/NPC Object Spawning & Spotlighting/NPC Light Object Data.jsonc; .dev/Game State Data.jsonc;
    .dev/Chronicle Data/NPCS_*.md (content keys); .dev/DEBUG_FILE_LOGGING.md.
]]

local NPCS = {}

local U = require("lib.util")
local S = require("core.state")
local C = require("lib.constants")
local L = require("core.lighting")
local DATA = require("lib.npcs_data")
-- Build D.genericNpcs from the sheet catalog rows that have art in lib/npc_art_urls.ttslua.
DATA.initGenericNPCs()
local NpcSpawn = require("core.npc_spawn")
local SRI = require("lib.seat-role-identity")
local G = require("lib.guids")
local MapPins = require("core.map_pins")
local O = require("core.objects")

--- NPC-only roster (PCs flagged `isPC` are excluded). Spawning and stage tokens are keyed off this,
--- so PC characters never generate NPC figurines or stage tokens.
--- PC-inclusive lookups use `DATA.characters` directly.
NPCS.characters = DATA.getNpcCharacters()
NPCS.lights = DATA.lights or {}
NPCS.stageLights = DATA.stageLights or {}

local TAG_FIG = NpcSpawn.TAG_FIG
local TAG_LIT = NpcSpawn.TAG_LIT
local GM_PREFIX = NpcSpawn.GM_PREFIX

--- `areaKey` for table seats (`applyNpcPairPhysicalPresentation` seat ImageScalar).
local SEAT_PLACEMENT_KEY = "seat"

--- Forward declarations for reconcile pipeline (defined later in this module).
local resolveNpcPlacementIntent
local occupiedNpcSeatsFingerprint
local applyNpcFigureTooltip

--- Sentinel `areaKey` for a freshly spawned pair still hidden under the table, waiting for its
--- stage / seat / Scatter move (same reconcile pass, or a Dashboard prewarm while its image loads).
local SPAWN_PARK_AREA_KEY = "__spawnPark__"
--- Sentinel `areaKey` for free-placement figurines driven by `npcWorld.placements` (gameboard).
local STAGE_BOARD_AREA_KEY = "__stage_board__"
NPCS.STAGE_BOARD_AREA_KEY = STAGE_BOARD_AREA_KEY
--- Sentinel `areaKey` for Scatter Mode stage figurines (world poses, not STAGE_BOARD u/v).
local SCATTER_AREA_KEY = "__scatter__"
NPCS.SCATTER_AREA_KEY = SCATTER_AREA_KEY

--- Unified NPC reconcile fingerprint (placements + seats + table + presence).
local lastNpcReconcileFingerprint = nil

--- Last successful layout commit for Step Three skip verification.
--- `commitKey` adds per-seat `physicalSeatAllowed` + PC/NPC occupancy so the commit can skip
--- `RSL.SyncTable` when nothing seat-bound changed.
local lastNpcLayoutCommit = {
    tableKey = "",
    fingerprint = "",
    commitKey = "",
}

--- When true, defer async `requestSeatLayoutSync`; orchestrator runs synchronous layout commit.
local npcReconcileInProgress = false

--- Set by Steps Two/Three when they clear or assign a seat this pass; forces the layout commit.
local npcSeatWorkThisPass = false

--- Dashboard prewarm holds (character key → count): parked spawns waiting for their image, not despawned.
local prewarmHoldCount = {}

--- One-shot layout context for `lib.rotational-seat-layout` during orchestrated reconcile.
local npcReconcileLayoutContext = nil

--- While true, instance uses spotlight mode until mouse up (not persisted).
local spotlightHeld = {}
--- TOR-238 hold-preview: figurine treated as SPOTLIGHT for family dim (not persisted).
local spotlightPreviewHeld = {}
--- Runtime companion dim while a same-snap-family NPC is SPOTLIGHT (TOR-473). Not written to placements.
local familyOffSpotlight = {}
--- Transient companion dim during TOR-238 hold preview (separate from state-backed `familyOffSpotlight`).
local familyOffSpotlightPreview = {}

--- Spawn callback only: `buildResolvedLightModeTable` prefers this object over `G.getObject` (GUID index can lag the live `fig`).
local lightAlignFigOverride = {}
--- Bumped when a new deferred stage light-align sequence starts; stale sequences no-op on completion.
local deferredLightAlignGeneration = {}
--- Seat→stage `reload()` snapshot: bounds must grow before spotlight Y align (ImageScalar leads mesh).
local pendingStageImageScalarReload = {}

--- Custom_Assetbundle spotlights: `L.GetLight` can be true while `loading_custom` is still true; component `set` calls are then ignored (matches `U.await` object-resting checks in `lib.util`).
--- @param lightGuid string
--- @param reg string `npcLight_<guid>`
--- @return boolean
local function npcSpotlightReadyForApply(lightGuid, reg)
    if U.Type(lightGuid) ~= "string" or lightGuid == "" or U.Type(reg) ~= "string" or reg == "" then
        return false
    end
    local litObj = G.getObject(lightGuid)
    if litObj == nil then
        return false
    end
    if litObj.loading_custom == true then
        return false
    end
    return L.GetLight(reg, true) ~= nil
end

--- After figurine `reload()` from seat ImageScalar → registry scalar: wall-clock settle before bounds-based spotlight Y (TTS mesh lags scalar).
local NPC_LIGHT_POST_READY_DELAY_SEC = 1.5
--- Minimum figurine `getBounds().size.y` before bounds-based spotlight Y (guards `image_scalar` + `reload()` race).
local NPC_FIGURINE_LIGHT_ALIGN_MIN_BOUNDS_Y = 10
--- Min `bounds.size.y / alignScalar` for off-seat placement (seat mesh at scalar 53 can pass a 0.75× gate while scalar already reads 60).
local NPC_FIGURINE_LIGHT_ALIGN_MIN_BOUNDS_SCALAR_RATIO = 0.88
--- Upper bound on bounds height vs expected ImageScalar — only for sub-seat scalars (TOR-315).
local NPC_FIGURINE_LIGHT_ALIGN_MAX_BOUNDS_SCALAR = 1.35
--- Apply max-bounds gate only when stage ImageScalar is well below seat scalar (53).
local NPC_FIGURINE_LIGHT_ALIGN_MAX_SCALAR_BELOW_SEAT = 45
--- Defer sequence wall-clock cap; fallback apply so spotlights cannot stay OFF forever.
local NPC_STAGE_LIGHT_DEFER_TIMEOUT_SEC = 20
--- After figurine bounds pass, brief settle before `buildResolvedLightModeTable` (stage reposition; shorter than spawn).
local NPC_STAGE_LIGHT_POST_BOUNDS_DELAY_SEC = 0.25

--- Wall-clock cap on a Dashboard prewarm image wait before the edit applies anyway.
local NPC_PREWARM_MAX_WAIT_SEC = 15

--- Custom Figurine ImageScalar at table seats (TTS figurine custom-property scale — not Transform `setScale`).
local NPC_SEAT_FIGURINE_IMAGE_SCALAR = 53

--- Baseline registry scalar for bounds-based spotlight Y gate (defer until bounds tall enough).
local NPC_FIGURINE_LIGHT_BASELINE_SCALAR = 53

--- Fallback pooled figurine spotlight placement (world units) when `positioning.deltaUp` /
--- `positioning.deltaInward` are omitted from a light mode's `positioning` block (TOR-266).
local NPC_FIGURINE_LIGHT_ABOVE_TOP_Y = 5
local NPC_FIGURINE_LIGHT_INWARD_XZ = 3

--- Tolerance when comparing figurine ImageScalar before skipping `reload()`.
local FIGURINE_IMAGE_SCALAR_EPS = 0.05

--- @param base table|nil
--- @param override table|nil
--- @return table
local function deepMerge(base, override)
    local out = U.clone(base) or {}
    if U.Type(override) ~= "table" then
        return out
    end
    for k, v in pairs(override or {}) do
        if U.Type(v) == "table" and U.Type(out[k]) == "table" then
            out[k] = deepMerge(out[k], v)
        else
            out[k] = v
        end
    end
    return out
end

--- @return table
local function getInstances()
    local t = S.getStateVal("npcs", "instances")
    if U.Type(t) ~= "table" then
        return {}
    end
    return t
end

--- Runtime O(1) lookup: figurine GUID → npc instance name (TOR-197).
local figurineGuidToNpcName = {}

--- Rebuild figurine GUID cache from persisted instances (after load or bulk replace).
local function rebuildFigurineGuidCache()
    figurineGuidToNpcName = {}
    for npcName, rec in pairs(getInstances()) do
        if U.Type(npcName) == "string" and U.Type(rec) == "table" then
            local figGuid = rec.figurineGuid
            if U.Type(figGuid) == "string" and figGuid ~= "" then
                figurineGuidToNpcName[figGuid] = npcName
            end
        end
    end
end

--- @param npcName string
--- @param prevRec table|nil
--- @param newRec table|nil
local function syncFigurineGuidCacheForRecord(npcName, prevRec, newRec)
    if U.Type(prevRec) == "table" then
        local prevGuid = prevRec.figurineGuid
        if U.Type(prevGuid) == "string" and prevGuid ~= "" and figurineGuidToNpcName[prevGuid] == npcName then
            figurineGuidToNpcName[prevGuid] = nil
        end
    end
    if U.Type(newRec) == "table" then
        local newGuid = newRec.figurineGuid
        if U.Type(newGuid) == "string" and newGuid ~= "" then
            figurineGuidToNpcName[newGuid] = npcName
        end
    end
end

--- @return table<string, string|boolean>
local function getOccupiedNpcSeatMap()
    local seatLayout = S.getStateVal("seatLayout")
    if U.Type(seatLayout) ~= "table" then
        return {}
    end
    local slots = seatLayout.occupiedNPCSlots
    if U.Type(slots) ~= "table" then
        return {}
    end
    return slots
end

--- @param occupied table<string, string|boolean>
local function setOccupiedNpcSeatMap(occupied)
    S.setStateVal(occupied, "seatLayout", "occupiedNPCSlots")
end

--- @param instances table
local function setAllInstances(instances)
    S.setStateVal(instances, "npcs", "instances")
    rebuildFigurineGuidCache()
end

--- @param npcName string
--- @param rec table|nil
local function setInstanceRecord(npcName, rec)
    local prev = getInstances()[npcName]
    syncFigurineGuidCacheForRecord(npcName, prev, rec)
    local all = U.clone(getInstances())
    all[npcName] = rec
    S.setStateVal(all, "npcs", "instances")
end

--- @param npcName string
--- @return string|nil
local function findSeatByNpcKey(npcName)
    if U.Type(npcName) ~= "string" or npcName == "" then
        return nil
    end
    local occupied = getOccupiedNpcSeatMap()
    for _, seatKey in ipairs(C.NPCSeats or {}) do
        if occupied[seatKey] == npcName then
            return seatKey
        end
    end
    return nil
end

--- @param seatKey string
--- @return string|boolean|nil
local function getSeatOccupant(seatKey)
    if U.Type(seatKey) ~= "string" or seatKey == "" then
        return nil
    end
    return getOccupiedNpcSeatMap()[seatKey]
end

--- @param seatKey string
--- @return boolean
local function isValidNpcSeatKey(seatKey)
    return U.Type(seatKey) == "string" and U.isIn(seatKey, C.NPCSeats or {})
end

--- Keep `sessionScene.seatSlots` aligned when gameboard seating mutates `occupiedNPCSlots`.
--- @param seatKey string
--- @param npcName string|nil character key when assigned; nil clears the row to `slotEmpty`
local function syncSeatSlotAuthoringForNpcSeat(seatKey, npcName)
    if not isValidNpcSeatKey(seatKey) then
        return
    end
    local ss = S.getStateVal("sessionScene", "seatSlots")
    if U.Type(ss) ~= "table" then
        ss = {}
    else
        ss = U.clone(ss, true)
    end
    if U.Type(npcName) ~= "string" or npcName == "" then
        ss[seatKey] = { slotEmpty = true }
    else
        local row = ss[seatKey]
        if U.Type(row) ~= "table" then
            row = {}
        else
            row = U.clone(row, true)
        end
        row.characterKey = npcName
        row.slotEmpty = nil
        ss[seatKey] = row
    end
    S.setStateVal(ss, "sessionScene", "seatSlots")
end

--- @param npcName string
--- @return boolean
local function validateNpcNameKey(npcName)
    return U.Type(npcName) == "string" and string.match(npcName, "^[%a_][%w_]*$") ~= nil
end

--- Runtime generic roster entries (`isGeneric`); their figurines spawn from `lib/npc_art_urls.ttslua` like named NPCs.
--- @param npcName string|nil
--- @return boolean
local function characterIsGeneric(npcName)
    if U.Type(npcName) ~= "string" or npcName == "" then
        return false
    end
    local def = NPCS.characters[npcName]
    return U.Type(def) == "table" and def.isGeneric == true
end

--- Destroy one NPC spotlight object and drop its light-mode registration + `gameState.lights` row.
--- @param lightGuid string|nil
local function destroyNpcLight(lightGuid)
    if U.Type(lightGuid) ~= "string" or lightGuid == "" then
        return
    end
    local lit = G.getObject(lightGuid)
    if lit ~= nil then
        lit.destruct()
    end
    O.forgetHiddenObject(lightGuid)
    local reg = "npcLight_" .. lightGuid
    L.unregisterLightModeEntry(reg)
    local lights = S.getStateVal("lights")
    if U.Type(lights) == "table" and lights[reg] ~= nil then
        lights = U.clone(lights)
        lights[reg] = nil
        S.setStateVal(lights, "lights")
    end
end

local seatSyncQueued = false

local function requestSeatLayoutSync()
    if npcReconcileInProgress then
        return
    end
    if seatSyncQueued then
        return
    end
    local rsl = require("lib.rotational-seat-layout")
    if rsl ~= nil and type(rsl.isLayoutSyncCurrent) == "function" and rsl.isLayoutSyncCurrent() then
        return
    end
    seatSyncQueued = true
    U.await(function()
        seatSyncQueued = false
        if rsl ~= nil and type(rsl.isLayoutSyncCurrent) == "function" and rsl.isLayoutSyncCurrent() then
            return
        end
        if rsl ~= nil and type(rsl.SyncTable) == "function" then
            rsl.SyncTable()
        end
    end, 0.08)
end

--- Viewer colors for NPC seat presence hide/show (all seated players + spectators).
--- @return string[]
local function allViewerColorsForInvisibility()
    local out = { "White", "Black", "Grey" }
    for i = 1, #(C.PlayerColors or {}) do
        out[#out + 1] = C.PlayerColors[i]
    end
    return out
end

--- Narrative presence for one seat (`seatSlots.isPresent` wins over `seatPresent`).
--- @param seatKey string
--- @return boolean
local function resolveSeatPresenceForSeat(seatKey)
    local ss = S.getStateVal("sessionScene", "seatSlots")
    if U.Type(ss) == "table" then
        local row = ss[seatKey]
        if U.Type(row) == "table" and row.isPresent ~= nil then
            return row.isPresent ~= false
        end
    end
    local sp = S.getStateVal("sessionScene", "seatPresent")
    if U.Type(sp) == "table" and sp[seatKey] ~= nil then
        return sp[seatKey] ~= false
    end
    return true
end

--- Assigned NPC character for a seat from validated `occupiedNPCSlots`.
--- @param seatKey string
--- @return string|nil
local function resolveAssignedCharacterForSeat(seatKey)
    local occ = getOccupiedNpcSeatMap()[seatKey]
    if U.Type(occ) == "string" and occ ~= "" then
        return occ
    end
    return nil
end

--- True when `occupiedNPCSlots[seatKey]` is assigned and that character has a control-board stage row.
--- @param seatKey string
--- @return boolean
local function isNpcSeatOccupantStageBound(seatKey)
    if not isValidNpcSeatKey(seatKey) then
        return false
    end
    local occupant = resolveAssignedCharacterForSeat(seatKey)
    if U.Type(occupant) ~= "string" or occupant == "" then
        return false
    end
    local placements = S.getStateVal("sessionScene", "npcWorld", "placements")
    if U.Type(placements) ~= "table" then
        return false
    end
    local row = placements[occupant]
    return U.Type(row) == "table" and tonumber(row.u) ~= nil and tonumber(row.v) ~= nil
end

--- @param seatKey string
--- @return string
local function seatTagForKey(seatKey)
    return seatKey .. "Object"
end

--- @param fig Object|nil
--- @param seatKey string
--- @return boolean
local function figurineHasSeatTag(fig, seatKey)
    if fig == nil or fig.getTags == nil then
        return false
    end
    local want = seatTagForKey(seatKey)
    local tags = fig.getTags() or {}
    if U.Type(tags) ~= "table" then
        return false
    end
    for _, t in ipairs(tags) do
        if t == want then
            return true
        end
    end
    return false
end

--- @param fig Object|nil
--- @return boolean
local function figurineHasAnySeatTag(fig)
    if fig == nil or fig.getTags == nil then
        return false
    end
    local tags = fig.getTags() or {}
    if U.Type(tags) ~= "table" then
        return false
    end
    for _, sk in ipairs(C.NPCSeats or {}) do
        if figurineHasSeatTag(fig, sk) then
            return true
        end
    end
    return false
end

--- @param npcName string
--- @return boolean
local function npcInstanceInStageArea(npcName)
    local rec = getInstances()[npcName]
    if U.Type(rec) ~= "table" then
        return false
    end
    return rec.areaKey == STAGE_BOARD_AREA_KEY or rec.areaKey == SCATTER_AREA_KEY
end

--- Stage figurine (gameboard `placements` or Scatter pose).
--- @param npcName string
--- @return boolean
local function npcInstanceOnStage(npcName)
    return npcInstanceInStageArea(npcName)
end

--- @param seatKey string
--- @return boolean
local function isNpcPhysicallyAtSeat(seatKey)
    for _, rec in pairs(getInstances()) do
        if U.Type(rec) == "table" and rec.seatedSeatKey == seatKey then
            return true
        end
    end
    local tag = seatTagForKey(seatKey)
    local objs = getObjectsWithTag(tag)
    if U.Type(objs) ~= "table" then
        return false
    end
    for i = 1, #objs do
        local o = objs[i]
        if o ~= nil and NPCS.isPooledFigurineObject(o) and figurineHasSeatTag(o, seatKey) then
            return true
        end
    end
    return false
end

--- @param obj Object|nil
--- @return boolean
local function hasNpcInstanceGmNotes(obj)
    if not U.isGameObject(obj) then
        return false
    end
    local desc = ""
    if obj.getDescription ~= nil then
        desc = tostring(obj.getDescription() or "")
    end
    if desc == "" and obj.getGMNotes ~= nil then
        desc = tostring(obj.getGMNotes() or "")
    end
    return string.find(desc, GM_PREFIX, 1, true) ~= nil
end

--- True for spawned NPC `Figurine_Custom` cutouts.
--- Stage / Scatter / parked: `npc_figurine` tag + `npcInstance:` GM Notes. Table seat: seat `*Object` tag + `SEAT_FIGURE_<seat>` GM Notes (same identity model as PC figurines).
--- @param obj Object|nil
--- @return boolean
function NPCS.isPooledFigurineObject(obj)
    if not U.isGameObject(obj) then
        return false
    end
    if obj.hasTag ~= nil and obj.hasTag("spotlight_figurine") == true then
        return false
    end
    if obj.getCustomObject == nil or U.Type(obj.getCustomObject()) ~= "table" then
        return false
    end
    local hasFigTag = obj.hasTag ~= nil and obj.hasTag(TAG_FIG) == true
    if not hasFigTag and not figurineHasAnySeatTag(obj) then
        return false
    end
    if hasNpcInstanceGmNotes(obj) then
        return true
    end
    local guid = obj.getGUID and obj.getGUID() or ""
    if guid ~= "" then
        for _, rec in pairs(getInstances()) do
            if U.Type(rec) == "table" and rec.figurineGuid == guid then
                return true
            end
        end
    end
    return false
end

--- Homeland seat assigned in `occupiedNPCSlots` and character has a control-board stage placement row (TOR-178 phase C).
--- @param seatKey string
--- @return boolean
function NPCS.isNpcSeatOccupantStageBound(seatKey)
    return isNpcSeatOccupantStageBound(seatKey)
end

--- Fingerprint of stage-bound homeland seats (placements + occupied slots); gates duplicate homeland light reconcile on skip path.
--- @return string
local function homelandStageBoundSpotlightsFingerprint()
    local parts = {}
    for _, seatKey in ipairs(C.NPCSeats or {}) do
        if isNpcSeatOccupantStageBound(seatKey) then
            parts[#parts + 1] = seatKey .. "=OFF"
        end
    end
    table.sort(parts)
    return table.concat(parts, "\n")
end

local lastHomelandStageBoundSpotlightsFingerprint = nil

--- Reconcile homeland workshop seat lights for every assigned NPC seat (state-derived priority).
--- Used on orchestrator fingerprint skip and RSL layout tail when orchestrator is inactive.
local function reconcileNpcHomelandSeatSpotlightsWhenStageBound()
    local fp = homelandStageBoundSpotlightsFingerprint()
    if fp == lastHomelandStageBoundSpotlightsFingerprint then
        return
    end
    for _, seatKey in ipairs(C.NPCSeats or {}) do
        if resolveAssignedCharacterForSeat(seatKey) ~= nil then
            L.reconcileForPlayer(seatKey)
        end
    end
    lastHomelandStageBoundSpotlightsFingerprint = fp
end

function NPCS.reconcileHomelandSeatSpotlightsForStageBound()
    reconcileNpcHomelandSeatSpotlightsWhenStageBound()
end

--- Clear homeland spotlight reconcile skip cache (e.g. `Sync.invalidateAllReconcileCaches`).
function NPCS.invalidateHomelandStageBoundSpotlightsCache()
    lastHomelandStageBoundSpotlightsFingerprint = nil
end

--- Show a stage `npc_light` (`O.restoreObject` only, incl. Storyteller).
--- @param lit Object|nil
local function restoreNpcLight(lit)
    if U.isGameObject(lit) then
        O.restoreObject(lit, { locked = true, interactable = false })
    end
end

--- Seated NPCs have no stage spotlight (workshop seat lights own the table): destroy the paired light.
--- Cancels pending deferred stage light-align sequences.
--- @param npcName string
local function dropNpcLightForSeat(npcName)
    if U.Type(npcName) ~= "string" or npcName == "" then
        return
    end
    deferredLightAlignGeneration[npcName] = (deferredLightAlignGeneration[npcName] or 0) + 1
    pendingStageImageScalarReload[npcName] = nil
    local rec = getInstances()[npcName]
    if U.Type(rec) ~= "table" then
        return
    end
    destroyNpcLight(rec.lightGuid)
    rec = U.clone(rec)
    rec.lightGuid = nil
    rec.npcLightMode = "OFF"
    setInstanceRecord(npcName, rec)
end

--- NPC figurines stay TTS-locked at all times (players cannot drag); `rec.locked` is Storyteller "pin" for script moves only.
--- @param fig Object|nil
local function ensureNpcFigurinePhysicsLocked(fig)
    if U.isGameObject(fig) and fig.setLock ~= nil then
        fig.setLock(true)
    end
end

--- Custom Figurine `ImageScalar` from `figurine.scale` in npcs_data (spawn data + spotlight bounds gating).
--- Not Transform scale (spawned pairs stay at Transform scale 1).
--- @param npcName string
--- @return number
local function figurineImageScalarForNpc(npcName)
    local def = NPCS.characters[npcName]
    local figDef = U.Type(def) == "table" and def.figurine or nil
    local scalar = tonumber(figDef and figDef.scale)
    if scalar == nil or scalar ~= scalar or scalar < 1 then
        scalar = 8
    end
    if scalar > 500 then
        scalar = 500
    end
    return scalar
end

--- ImageScalar expected for the NPC's current placement (seat 53 vs registry off-seat scale).
--- @param npcName string
--- @return number
local function expectedFigurineImageScalarForNpcPlacement(npcName)
    local rec = getInstances()[npcName]
    if U.Type(rec) == "table" and rec.areaKey == SEAT_PLACEMENT_KEY then
        return NPC_SEAT_FIGURINE_IMAGE_SCALAR
    end
    return figurineImageScalarForNpc(npcName)
end

--- Read current Custom Figurine ImageScalar (custom-property card scale), not Transform scale.
--- @param fig Object|nil
--- @return number|nil
local function readFigurineImageScalar(fig)
    if not U.isGameObject(fig) then
        return nil
    end
    if fig.getData ~= nil then
        local data = fig.getData()
        if U.Type(data) == "table" and U.Type(data.CustomImage) == "table" then
            local ci = data.CustomImage
            local fromData = tonumber(ci.ImageScalar) or tonumber(ci.ImageScale)
            if fromData ~= nil then
                return fromData
            end
        end
    end
    if fig.getCustomObject ~= nil then
        local co = fig.getCustomObject()
        if U.Type(co) == "table" then
            local fromCo = tonumber(co.image_scalar) or tonumber(co.card_scale) or tonumber(co.scale)
            if fromCo ~= nil then
                return fromCo
            end
        end
    end
    return nil
end

--- @param current number|nil
--- @param target number
--- @return boolean
local function figurineImageScalarMatches(current, target)
    if current == nil or target == nil then
        return false
    end
    return math.abs(current - target) <= FIGURINE_IMAGE_SCALAR_EPS
end

--- Apply figurine ImageScalar when it differs; requires `setCustomObject` + `reload()`.
--- @param fig Object|nil
--- @param targetScalar number
--- @return boolean reloaded
local function applyFigurineImageScalarIfNeeded(fig, targetScalar)
    if not U.isGameObject(fig) or fig.setCustomObject == nil or fig.reload == nil then
        return false
    end
    local target = tonumber(targetScalar)
    if target == nil or target ~= target or target < 1 then
        return false
    end
    if target > 500 then
        target = 500
    end
    if figurineImageScalarMatches(readFigurineImageScalar(fig), target) then
        return false
    end
    local co = fig.getCustomObject()
    if U.Type(co) ~= "table" then
        return false
    end
    local image = co.image
    if U.Type(image) ~= "string" or image == "" then
        return false
    end
    local params = {
        image = image,
        image_secondary = co.image_secondary or image,
        image_scalar = target,
    }
    fig.setCustomObject(params)
    fig.reload()
    return true
end

--- Seat vs off-seat ImageScalar for pooled NPC figurines (TOR-223).
--- @param fig Object|nil
--- @param npcName string|nil
--- @param areaKey string
--- @return boolean reloaded
local function applyNpcFigurineImageScalarForPlacement(fig, npcName, areaKey)
    if not U.isGameObject(fig) or U.Type(npcName) ~= "string" or npcName == "" then
        return false
    end
    if areaKey == SEAT_PLACEMENT_KEY then
        pendingStageImageScalarReload[npcName] = nil
        return applyFigurineImageScalarIfNeeded(fig, NPC_SEAT_FIGURINE_IMAGE_SCALAR)
    end
    local priorSy = nil
    if fig.getBounds ~= nil then
        local b = fig.getBounds()
        if b ~= nil and b.size ~= nil then
            priorSy = b.size.y or b.size[2]
        end
    end
    local targetScalar = figurineImageScalarForNpc(npcName)
    local reloaded = applyFigurineImageScalarIfNeeded(fig, targetScalar)
    if reloaded and U.Type(priorSy) == "number" and priorSy > 0 then
        pendingStageImageScalarReload[npcName] = {
            priorSy = priorSy,
            targetScalar = targetScalar,
            reloadAt = os.clock(),
        }
    end
    return reloaded
end

--- Custom mesh loaded and ImageScalar matches placement (not mid-reload).
--- @param fig Object|nil
--- @param npcName string
--- @return boolean
local function npcFigurineScalarReady(fig, npcName)
    if not U.isGameObject(fig) then
        return false
    end
    if fig.loading_custom == true then
        return false
    end
    return figurineImageScalarMatches(
        readFigurineImageScalar(fig),
        expectedFigurineImageScalarForNpcPlacement(npcName)
    )
end

--- When ImageScalar already reads registry target but `getBounds` still reflects seat scalar 53 mesh.
--- @param fig Object|nil
--- @param npcName string
--- @param cy number
--- @param sy number
--- @return number cyOut, number syOut
local function correctFigurineBoundsForRegistryScalar(fig, npcName, cy, sy)
    if not U.isGameObject(fig) or U.Type(npcName) ~= "string" or npcName == "" then
        return cy, sy
    end
    local alignScalar = figurineImageScalarForNpc(npcName)
    if alignScalar <= NPC_SEAT_FIGURINE_IMAGE_SCALAR then
        return cy, sy
    end
    if not figurineImageScalarMatches(readFigurineImageScalar(fig), alignScalar) then
        return cy, sy
    end
    local minExpectedSy = alignScalar * NPC_FIGURINE_LIGHT_ALIGN_MIN_BOUNDS_SCALAR_RATIO
    if sy >= minExpectedSy * 1.01 then
        return cy, sy
    end
    local scale = alignScalar / NPC_SEAT_FIGURINE_IMAGE_SCALAR
    local correctedSy = sy * scale
    return cy + (correctedSy - sy) / 2, correctedSy
end

--- Bounds tall enough for spotlight Y from `getBounds` (not a stale seat-scalar mesh).
--- @param fig Object|nil
--- @param npcName string
--- @return boolean
local function npcFigurineBoundsHeightReady(fig, npcName)
    if not U.isGameObject(fig) or fig.getBounds == nil then
        return false
    end
    local b = fig.getBounds()
    if b == nil or b.size == nil then
        return false
    end
    local cy = b.center.y or b.center[2] or 0
    local sy = b.size.y or b.size[2] or 0
    cy, sy = correctFigurineBoundsForRegistryScalar(fig, npcName, cy, sy)
    local alignScalar = expectedFigurineImageScalarForNpcPlacement(npcName)
    local minRatio = alignScalar > NPC_SEAT_FIGURINE_IMAGE_SCALAR
        and NPC_FIGURINE_LIGHT_ALIGN_MIN_BOUNDS_SCALAR_RATIO
        or 0.75
    local minSy = math.max(
        NPC_FIGURINE_LIGHT_ALIGN_MIN_BOUNDS_Y,
        alignScalar * minRatio
    )
    if sy < minSy then
        return false
    end
    -- TOR-315: reject stale seat-height mesh only when target scalar is below seat (53).
    -- Registry scalars (50–70) legitimately exceed 1.35×alignScalar; global max blocked all lights.
    if alignScalar < NPC_FIGURINE_LIGHT_ALIGN_MAX_SCALAR_BELOW_SEAT then
        local maxSy = alignScalar * NPC_FIGURINE_LIGHT_ALIGN_MAX_BOUNDS_SCALAR
        if sy > maxSy then
            return false
        end
    end
    return true
end

--- Active presentation for a placed pair (stage / Scatter / seat): tooltip (on at seats, else lit-only),
--- TTS lock, placement ImageScalar, and unhide when the pair was spawned hidden under the table.
--- @param fig Object|nil
--- @param lit Object|nil
--- @param areaKey string
--- @param npcName string|nil
--- @return boolean true when ImageScalar `reload()` was triggered
local function applyNpcPairPhysicalPresentation(fig, lit, areaKey, npcName)
    if areaKey == SEAT_PLACEMENT_KEY then
        if U.isGameObject(fig) and fig.tooltip ~= nil then
            fig.tooltip = true
        end
    elseif U.Type(npcName) == "string" then
        applyNpcFigureTooltip(npcName, fig)
    end
    ensureNpcFigurinePhysicsLocked(fig)
    local reloaded = applyNpcFigurineImageScalarForPlacement(fig, npcName, areaKey) == true
    if U.isGameObject(fig) and O.isHiddenObject(fig) then
        O.restoreObject(fig, { locked = true, interactable = false })
    end
    if U.isGameObject(lit) and O.isHiddenObject(lit) then
        O.restoreObject(lit, { locked = true, interactable = false })
    end
    return reloaded
end

--- Spawn + hide the paired stage spotlight under the table and register its light modes.
--- @param npcName string
--- @return string lightGuid
local function spawnNpcLight(npcName)
    local lit = NpcSpawn.spawnLight(npcName)
    local lg = lit.getGUID()
    O.hideObject(lit)
    if lit.AssetBundle ~= nil and lit.AssetBundle.playLoopingEffect ~= nil then
        L.applySpotlightObjectIndicator(lit)
    else
        L.ensureSpotlightObjectTag(lit)
    end
    L.registerNpcSpotlightModes(npcName, lg)
    return lg
end

--- Stage / Scatter pairs need a light; seated NPCs dropped theirs. Spawns one when missing.
--- @param npcName string
local function ensureNpcLight(npcName)
    local rec = getInstances()[npcName]
    if U.Type(rec) ~= "table" then
        return
    end
    if U.Type(rec.lightGuid) == "string" and G.getObject(rec.lightGuid) ~= nil then
        return
    end
    destroyNpcLight(rec.lightGuid)
    rec = U.clone(rec)
    rec.lightGuid = spawnNpcLight(npcName)
    setInstanceRecord(npcName, rec)
end

--- Spawn a hidden figurine (+ light unless seat-bound) under the table and record the instance
--- at `SPAWN_PARK_AREA_KEY`; the caller moves it to its stage / seat / Scatter pose.
--- @param npcName string
--- @param opts table|nil `{ forSeat? }` seat-bound spawns use seat ImageScalar and no light
--- @return table rec
local function spawnNpcInstance(npcName, opts)
    local def = NPCS.characters[npcName]
    if U.Type(def) ~= "table" then
        error("[NPCS] spawnNpcInstance: unknown NPC " .. tostring(npcName), 2)
    end
    local forSeat = U.Type(opts) == "table" and opts.forSeat == true
    local fig = NpcSpawn.spawnFigurine(npcName, {
        displayName = def.fullName or def.name or npcName,
        imageScalar = forSeat and NPC_SEAT_FIGURINE_IMAGE_SCALAR or figurineImageScalarForNpc(npcName),
        isGeneric = def.isGeneric == true,
    })
    O.hideObject(fig)
    local rec = {
        figurineGuid = fig.getGUID(),
        areaKey = SPAWN_PARK_AREA_KEY,
        slotIndex = 0,
        npcLightMode = "OFF",
        locked = false,
    }
    if not forSeat then
        rec.lightGuid = spawnNpcLight(npcName)
    end
    setInstanceRecord(npcName, rec)
    return rec
end

--- Destroy an NPC's figurine + light and drop its instance record and runtime light holds.
--- @param npcName string
local function despawnNpcInstance(npcName)
    local rec = getInstances()[npcName]
    spotlightHeld[npcName] = nil
    spotlightPreviewHeld[npcName] = nil
    familyOffSpotlight[npcName] = nil
    familyOffSpotlightPreview[npcName] = nil
    lightAlignFigOverride[npcName] = nil
    pendingStageImageScalarReload[npcName] = nil
    deferredLightAlignGeneration[npcName] = (deferredLightAlignGeneration[npcName] or 0) + 1
    if U.Type(rec) == "table" then
        if U.Type(rec.figurineGuid) == "string" and rec.figurineGuid ~= "" then
            local fig = G.getObject(rec.figurineGuid)
            if fig ~= nil then
                fig.destruct()
            end
            O.forgetHiddenObject(rec.figurineGuid)
        end
        destroyNpcLight(rec.lightGuid)
    end
    setInstanceRecord(npcName, nil)
end

--- Live instance for `npcName`: the existing pair, or a fresh hidden spawn (replacing a record whose
--- figurine no longer exists in the world).
--- @param npcName string
--- @param spawnOpts table|nil forwarded to `spawnNpcInstance`
--- @return table rec
local function ensureLiveNpcInstance(npcName, spawnOpts)
    local rec = getInstances()[npcName]
    if U.Type(rec) == "table" and G.getObject(rec.figurineGuid or "") ~= nil then
        return rec
    end
    if rec ~= nil then
        despawnNpcInstance(npcName)
    end
    return spawnNpcInstance(npcName, spawnOpts)
end

--- Swap figurine tags for table-seat layout (`SEAT_FIGURE` role) and drop the paired stage spotlight.
--- @param fig Object
--- @param npcName string
--- @param seatKey string
local function applyNpcFigurineSeatIdentity(fig, npcName, seatKey)
    local def = NPCS.characters[npcName]
    local seatTag = seatTagForKey(seatKey)
    local tags = fig.getTags and fig.getTags() or {}
    if U.Type(tags) ~= "table" then
        tags = {}
    end
    local out = {}
    for _, t in ipairs(tags) do
        if t ~= TAG_FIG then
            table.insert(out, t)
        end
    end
    local hasSeatTag = false
    for _, t in ipairs(out) do
        if t == seatTag then
            hasSeatTag = true
            break
        end
    end
    if not hasSeatTag then
        table.insert(out, seatTag)
    end
    if fig.setTags ~= nil then
        fig.setTags(out)
    end
    if fig.setName ~= nil and def ~= nil then
        fig.setName(def.fullName or def.name or npcName)
    end
    SRI.setRoleColorIdentity(fig, "SEAT_FIGURE", seatKey)
    applyNpcPairPhysicalPresentation(fig, nil, SEAT_PLACEMENT_KEY, npcName)
    dropNpcLightForSeat(npcName)
end

--- Restore `npc_figurine` tag after leaving a table seat; reset GM Notes to `npcInstance:` identity.
--- @param fig Object
--- @param npcName string|nil When omitted, resolved from instance record or `npcInstance:` GM Notes.
local function clearNpcFigurineSeatIdentity(fig, npcName)
    local tags = fig.getTags and fig.getTags() or {}
    if U.Type(tags) ~= "table" then
        tags = {}
    end
    local out = {}
    for _, t in ipairs(tags) do
        local drop = false
        for _, sk in ipairs(C.NPCSeats or {}) do
            if t == seatTagForKey(sk) then
                drop = true
                break
            end
        end
        if not drop then
            table.insert(out, t)
        end
    end
    local hasFigTag = false
    for _, t in ipairs(out) do
        if t == TAG_FIG then
            hasFigTag = true
            break
        end
    end
    if not hasFigTag then
        table.insert(out, TAG_FIG)
    end
    if fig.setTags ~= nil then
        fig.setTags(out)
    end
    if U.Type(npcName) ~= "string" or npcName == "" then
        if U.isGameObject(fig) then
            local guid = fig.getGUID and fig.getGUID() or ""
            if guid ~= "" then
                for name, rec in pairs(getInstances()) do
                    if U.Type(rec) == "table" and rec.figurineGuid == guid then
                        npcName = name
                        break
                    end
                end
            end
            if (U.Type(npcName) ~= "string" or npcName == "") and fig.getGMNotes ~= nil then
                local notes = tostring(fig.getGMNotes() or "")
                npcName = string.match(notes, "^" .. GM_PREFIX .. "(.+)$")
            end
        end
    end
    if U.Type(npcName) == "string" and npcName ~= "" and fig.setGMNotes ~= nil then
        fig.setGMNotes(GM_PREFIX .. npcName)
    end
end

--- @param npcName string
--- @param rec table|nil
--- @return boolean
local function npcIsEffectivelySpotlit(npcName, rec)
    if spotlightHeld[npcName] == true or spotlightPreviewHeld[npcName] == true then
        return true
    end
    return U.Type(rec) == "table" and rec.npcLightMode == "SPOTLIGHT"
end

--- Effective mode written to `gameState.lights` / applied to the world (includes runtime OFFSPOTLIGHT).
--- @param npcName string
--- @param desiredMode string|nil placement/steady mode OFF|STANDARD|SPOTLIGHT
--- @return string
local function effectiveAppliedLightModeKey(npcName, desiredMode)
    if spotlightHeld[npcName] == true or spotlightPreviewHeld[npcName] == true then
        return "SPOTLIGHT"
    end
    if familyOffSpotlight[npcName] == true or familyOffSpotlightPreview[npcName] == true then
        return "OFFSPOTLIGHT"
    end
    if U.Type(desiredMode) == "string" and desiredMode ~= "" then
        return desiredMode
    end
    return "STANDARD"
end

--- Off-seat figurine tooltip follows its light: hidden while the NPC stands dark (effective mode OFF), shown
--- while lit. Seated figurines are left to the seat presence reconcile.
--- @param npcName string
--- @param fig Object|nil the NPC's figurine when the caller already holds it
applyNpcFigureTooltip = function(npcName, fig)
    local rec = getInstances()[npcName]
    if U.Type(rec) ~= "table" or (U.Type(rec.seatedSeatKey) == "string" and isValidNpcSeatKey(rec.seatedSeatKey)) then
        return
    end
    fig = fig or G.getObject(rec.figurineGuid or "")
    if not U.isGameObject(fig) or fig.tooltip == nil then
        return
    end
    local lit = effectiveAppliedLightModeKey(npcName, rec.npcLightMode or "STANDARD") ~= "OFF"
    if fig.tooltip ~= lit then
        fig.tooltip = lit
    end
end

--- Other stage NPCs sharing the same snap `familyId` (excludes `npcName`).
--- @param npcName string
--- @return string[]
local function collectStageFamilySiblingKeys(npcName)
    local rec = getInstances()[npcName]
    if U.Type(rec) ~= "table" or rec.areaKey ~= STAGE_BOARD_AREA_KEY or U.Type(rec.stagePlacement) ~= "table" then
        return {}
    end
    local Gameboard = require("core.npc_gameboard")
    if type(Gameboard.resolvePlacementSnapCatalogEntry) ~= "function" then
        return {}
    end
    local entry = Gameboard.resolvePlacementSnapCatalogEntry(rec.stagePlacement.u, rec.stagePlacement.v)
    if U.Type(entry) ~= "table" then
        return {}
    end
    local familyId = entry.familyId
    if U.Type(familyId) ~= "string" or familyId == "" then
        return {}
    end
    local keys = {}
    for name, other in pairs(getInstances()) do
        if name ~= npcName
            and U.Type(other) == "table"
            and other.areaKey == STAGE_BOARD_AREA_KEY
            and U.Type(other.stagePlacement) == "table"
        then
            local otherEntry = Gameboard.resolvePlacementSnapCatalogEntry(other.stagePlacement.u, other.stagePlacement.v)
            if U.Type(otherEntry) == "table" and otherEntry.familyId == familyId then
                keys[#keys + 1] = name
            end
        end
    end
    return keys
end

--- Persist `gameState.lights` mode for a pooled NPC spotlight (no world apply).
--- @param npcName string
--- @param desiredMode string OFF|STANDARD|SPOTLIGHT
local function syncStageNpcLightState(npcName, desiredMode)
    local rec = getInstances()[npcName]
    if U.Type(rec) ~= "table" or U.Type(rec.lightGuid) ~= "string" or rec.lightGuid == "" then
        return
    end
    local reg = NPCS.lightRegistryName(rec.lightGuid)
    local modeKey = effectiveAppliedLightModeKey(npcName, desiredMode)
    if L.LIGHTMODES[reg] == nil then
        L.registerNpcSpotlightModes(npcName, rec.lightGuid)
    end
    S.setStateVal(modeKey, "lights", reg)
end

--- Cancel pending `deferNpcSpotlightAlignedToFigurine` sequences (e.g. before lerp commit or immediate re-apply).
--- @param npcName string
function NPCS.cancelDeferredSpotlightAlign(npcName)
    if U.Type(npcName) == "string" and npcName ~= "" then
        deferredLightAlignGeneration[npcName] = (deferredLightAlignGeneration[npcName] or 0) + 1
        pendingStageImageScalarReload[npcName] = nil
    end
end

--- Resolve spotlight from figurine bounds after presentation (placement ImageScalar applied).
--- @param npcName string
--- @param fig Object|nil
--- @param transitionTime number|nil
local function applyNpcSpotlightAlignedToFigurine(npcName, fig, transitionTime)
    if not U.isGameObject(fig) then
        return
    end
    local rec = getInstances()[npcName]
    if U.Type(rec) ~= "table" or U.Type(rec.lightGuid) ~= "string" or rec.lightGuid == "" then
        return
    end
    local reg = NPCS.lightRegistryName(rec.lightGuid)
    if L.LIGHTMODES[reg] == nil then
        L.registerNpcSpotlightModes(npcName, rec.lightGuid)
    end
    L.invalidateReconcileCacheForRef(reg)
    lightAlignFigOverride[npcName] = fig
    local modeKey = effectiveAppliedLightModeKey(npcName, rec.npcLightMode or "STANDARD")
    S.setStateVal(modeKey, "lights", reg)
    applyNpcFigureTooltip(npcName, fig)
    local modeTable = NPCS.buildResolvedLightModeTable(npcName, modeKey)
    lightAlignFigOverride[npcName] = nil
    -- Inline mode table (not named-mode reconcile): fingerprint includes pose so a stale
    -- "n:STANDARD" stamp cannot skip wake after a respawn or seat → stage move (TOR-315).
    if U.Type(modeTable) == "table" then
        L.SetLightMode(reg, modeTable, nil, transitionTime or 0)
    else
        NPCS.applyCurrentLightMode(npcName, transitionTime, { force = true })
    end
end

--- @param fig Object|nil
--- @param lit Object|nil
--- @param npcName string
--- @return boolean
local function npcPooledSpotlightReadyForApply(fig, lit, npcName)
    if not npcFigurineScalarReady(fig, npcName) then
        return false
    end
    if not U.isGameObject(lit) then
        return true
    end
    local lg = lit.getGUID and lit.getGUID() or ""
    local reg = NPCS.lightRegistryName(lg)
    return npcSpotlightReadyForApply(lg, reg)
end

--- @param npcName string
--- @return boolean
local function npcStageImageScalarReloadPending(npcName)
    return U.Type(pendingStageImageScalarReload[npcName]) == "table"
end

--- @param npcName string
--- @return boolean
local function npcStageImageScalarReloadSettled(npcName)
    local pending = pendingStageImageScalarReload[npcName]
    if U.Type(pending) ~= "table" then
        return true
    end
    local reloadAt = tonumber(pending.reloadAt)
    if reloadAt == nil then
        return true
    end
    return (os.clock() - reloadAt) >= NPC_LIGHT_POST_READY_DELAY_SEC
end

--- Stage spotlight: scalar + mesh bounds + pooled light component (no scalar-only early Y).
--- @param fig Object|nil
--- @param lit Object|nil
--- @param npcName string
--- @return boolean
local function npcStageSpotlightAlignReady(fig, lit, npcName)
    if not npcPooledSpotlightReadyForApply(fig, lit, npcName) then
        return false
    end
    if npcStageImageScalarReloadPending(npcName) and not npcStageImageScalarReloadSettled(npcName) then
        return false
    end
    if not npcFigurineBoundsHeightReady(fig, npcName) then
        return false
    end
    if npcStageImageScalarReloadPending(npcName) then
        pendingStageImageScalarReload[npcName] = nil
    end
    return true
end

--- Apply current stage light mode to state + visibility; reconcile when scalar + spotlight component are ready.
--- @param npcName string
--- @param fig Object|nil
--- @param lit Object|nil
--- @param transitionTime number|nil
local function applyStageNpcSpotlightNow(npcName, fig, lit, transitionTime)
    if U.Type(npcName) ~= "string" or npcName == "" or not U.isGameObject(fig) then
        return
    end
    NPCS.cancelDeferredSpotlightAlign(npcName)
    restoreNpcLight(lit)
    local rec = getInstances()[npcName]
    if U.Type(rec) == "table" then
        syncStageNpcLightState(npcName, rec.npcLightMode or "STANDARD")
        applyNpcFigureTooltip(npcName, fig)
    end
    if npcStageSpotlightAlignReady(fig, lit, npcName) then
        applyNpcSpotlightAlignedToFigurine(npcName, fig, transitionTime or 0)
    end
end

--- Wait for figurine mesh bounds (`loading_custom` / `getBounds`) before spotlight Y align (stage placement race).
--- @param npcName string
--- @param fig Object|nil
--- @param lit Object|nil
--- @param transitionTime number|nil
local function deferNpcSpotlightAlignedToFigurine(npcName, fig, lit, transitionTime)
    if not U.isGameObject(fig) then
        return
    end
    deferredLightAlignGeneration[npcName] = (deferredLightAlignGeneration[npcName] or 0) + 1
    local gen = deferredLightAlignGeneration[npcName]
    -- An ImageScalar `reload()` replaces the figurine object (same GUID), so every step looks it up again.
    local figGuid = fig.getGUID()
    local deferLit = lit
    local deferTrans = transitionTime
    local deferName = npcName
    local function liveFig()
        return G.getObject(figGuid)
    end
    U.chain({
        function()
            return 0
        end,
        function()
            return function()
                if deferredLightAlignGeneration[deferName] ~= gen then
                    return true
                end
                return npcStageSpotlightAlignReady(liveFig(), deferLit, deferName)
            end
        end,
        function()
            if deferredLightAlignGeneration[deferName] == gen then
                applyNpcSpotlightAlignedToFigurine(deferName, liveFig(), deferTrans)
            end
            return 0
        end,
        function()
            return NPC_STAGE_LIGHT_POST_BOUNDS_DELAY_SEC
        end,
        function()
            return function()
                if deferredLightAlignGeneration[deferName] ~= gen then
                    return true
                end
                return npcFigurineBoundsHeightReady(liveFig(), deferName)
            end
        end,
        function()
            if deferredLightAlignGeneration[deferName] == gen then
                applyNpcSpotlightAlignedToFigurine(deferName, liveFig(), deferTrans)
            end
            return 0
        end,
    }, {
        sequenceTimeoutSeconds = NPC_STAGE_LIGHT_DEFER_TIMEOUT_SEC,
        onComplete = function(_ok, detail)
            if deferredLightAlignGeneration[deferName] ~= gen then
                return
            end
            if detail == "sequence_timeout" then
                applyNpcSpotlightAlignedToFigurine(deferName, liveFig(), deferTrans)
            end
        end,
    })
end

--- Shortest angular distance in degrees (yaw wraps at 360).
--- @param a number|nil
--- @param b number|nil
--- @return number
local function yawDiffDeg(a, b)
    local da = tonumber(a) or 0
    local db = tonumber(b) or 0
    local d = math.abs(da - db) % 360
    if d > 180 then
        d = 360 - d
    end
    return d
end

--- @param stored table|nil last applied stage pose on the instance record
--- @param placement table current intent `{ u, v, groundLevel? }`
--- @return boolean
local function stagePlacementMatchesRecord(stored, placement)
    if type(stored) ~= "table" or type(placement) ~= "table" then
        return false
    end
    local u = tonumber(placement.u)
    local v = tonumber(placement.v)
    if u == nil or v == nil then
        return false
    end
    local du = math.abs((tonumber(stored.u) or 0) - u)
    local dv = math.abs((tonumber(stored.v) or 0) - v)
    if du >= 0.002 or dv >= 0.002 then
        return false
    end
    if (tonumber(stored.groundLevel) or nil) ~= (tonumber(placement.groundLevel) or nil) then
        return false
    end
    local Gameboard = require("core.npc_gameboard")
    local derivedYaw = 0
    if type(Gameboard.placementBoardRelYawDeg) == "function" then
        derivedYaw = Gameboard.placementBoardRelYawDeg(u, v)
    end
    return yawDiffDeg(stored.yaw, derivedYaw) < 1
end

--- @param placement table
--- @return string OFF|STANDARD|SPOTLIGHT
local function normalizedStageNpcLightMode(placement)
    local mode = placement.npcLightMode
    if mode == "OFF" or mode == "STANDARD" or mode == "SPOTLIGHT" then
        return mode
    end
    return "STANDARD"
end

--- Seat identity + layout sync: figurine pose comes from rotational layout (`SEAT_FIGURE` role).
--- @param figurine Object
--- @param npcName string
--- @param seatKey string
--- @param opts table|nil optional `deferLayoutSync`
--- @return boolean, string|nil
local function prepareNpcFigurineForSeat(figurine, npcName, seatKey, opts)
    opts = U.Type(opts) == "table" and opts or {}
    if not U.isGameObject(figurine) then
        return false, "Missing figurine for seat " .. tostring(seatKey) .. "."
    end
    applyNpcFigurineSeatIdentity(figurine, npcName, seatKey)
    if opts.deferLayoutSync ~= true then
        requestSeatLayoutSync()
    end
    return true, nil
end

--- Physical teardown for one NPC seat; optional state retention (Step Two case 3).
--- The figurine stays live: Step Five moves it to the stage / Scatter or despawns it.
--- @param seatKey string
--- @param opts table|nil `{ retainAssignment?: boolean, skipLayoutSync?: boolean }`
--- @return boolean, string|nil
local function clearNpcSeatPhysical(seatKey, opts)
    opts = U.Type(opts) == "table" and opts or {}
    if not isValidNpcSeatKey(seatKey) then
        return false, "Invalid NPC seat key."
    end
    local retainAssignment = opts.retainAssignment == true
    local toClear = {}
    local seen = {}
    for name, r in pairs(getInstances()) do
        if U.Type(name) == "string" and U.Type(r) == "table" and r.seatedSeatKey == seatKey then
            toClear[#toClear + 1] = name
            seen[name] = true
        end
    end
    local tag = seatTagForKey(seatKey)
    local tagged = getObjectsWithTag(tag)
    if U.Type(tagged) == "table" then
        for i = 1, #tagged do
            local o = tagged[i]
            if o ~= nil and NPCS.isPooledFigurineObject(o) then
                for name, r in pairs(getInstances()) do
                    if not seen[name] and U.Type(r) == "table" and r.figurineGuid == o.getGUID() then
                        toClear[#toClear + 1] = name
                        seen[name] = true
                        break
                    end
                end
            end
        end
    end
    if not retainAssignment then
        local occupied = U.clone(getOccupiedNpcSeatMap())
        occupied[seatKey] = false
        setOccupiedNpcSeatMap(occupied)
        syncSeatSlotAuthoringForNpcSeat(seatKey, nil)
    end
    for i = 1, #toClear do
        local name = toClear[i]
        local r = getInstances()[name]
        if U.Type(r) == "table" then
            local fig = G.getObject(r.figurineGuid or "")
            if fig ~= nil then
                clearNpcFigurineSeatIdentity(fig, name)
            end
            r.seatedSeatKey = nil
            setInstanceRecord(name, r)
        end
    end
    if opts.skipLayoutSync ~= true then
        requestSeatLayoutSync()
    end
    return true, nil
end

--- @param seatKey string
--- @return boolean, string|nil
local function clearNpcSeat(seatKey)
    return clearNpcSeatPhysical(seatKey, { retainAssignment = false })
end

--- @param seatKey string
--- @param intent table
--- @return boolean
local function seatNeedsPlacement(seatKey, intent)
    if U.Type(intent) ~= "table" or U.Type(intent.bySeat) ~= "table" then
        return true
    end
    local seatInfo = intent.bySeat[seatKey]
    if U.Type(seatInfo) ~= "table" or seatInfo.physicalSeatAllowed ~= true then
        return false
    end
    local npcName = seatInfo.assignedCharacter
    if U.Type(npcName) ~= "string" or npcName == "" then
        return false
    end
    local rec = getInstances()[npcName]
    if U.Type(rec) ~= "table" then
        return true
    end
    local fig = G.getObject(rec.figurineGuid or "")
    if fig == nil then
        return true
    end
    if not figurineHasSeatTag(fig, seatKey) then
        return true
    end
    if rec.seatedSeatKey ~= seatKey then
        return true
    end
    if rec.areaKey == SPAWN_PARK_AREA_KEY or npcInstanceInStageArea(npcName) then
        return true
    end
    local tableKey = S.getStateVal("seatLayout", "currentTableKey") or ""
    local fp = occupiedNpcSeatsFingerprint()
    if lastNpcLayoutCommit.tableKey ~= tableKey or lastNpcLayoutCommit.fingerprint ~= fp then
        return true
    end
    return false
end

--- @param npcName string
--- @param seatKey string
--- @param opts table|nil optional `deferLayoutSync`, `blockAreaBound`
--- @return boolean, string|nil
local function assignNpcToSeat(npcName, seatKey, opts)
    opts = U.Type(opts) == "table" and opts or {}
    if U.Type(npcName) ~= "string" or string.match(npcName, "^[%a_][%w_]*$") == nil then
        return false, "Invalid NPC name."
    end
    if NPCS.characters[npcName] == nil then
        return false, "Unknown NPC: " .. tostring(npcName)
    end
    if not isValidNpcSeatKey(seatKey) then
        return false, "Invalid NPC seat key."
    end
    if opts.blockAreaBound == true then
        local intent = resolveNpcPlacementIntent()
        local ci = intent.byCharacter[npcName]
        if U.Type(ci) == "table" and ci.target == "stage" then
            return false, "NPC is stage-bound and cannot be seated."
        end
    end
    local rec = ensureLiveNpcInstance(npcName, { forSeat = true })
    if rec.areaKey == STAGE_BOARD_AREA_KEY then
        -- TOR-178 phase B: keep figurine at stage pose; Step Three + layout commit seats directly.
        rec.stagePlacement = nil
        setInstanceRecord(npcName, rec)
    end
    if U.Type(rec.seatedSeatKey) == "string" and rec.seatedSeatKey ~= seatKey then
        local prevFig = G.getObject(rec.figurineGuid or "")
        if prevFig ~= nil then
            clearNpcFigurineSeatIdentity(prevFig, npcName)
        end
        rec.seatedSeatKey = nil
        setInstanceRecord(npcName, rec)
    end
    local occupied = U.clone(getOccupiedNpcSeatMap())
    local prev = occupied[seatKey]
    if U.Type(prev) == "string" and prev ~= "" and prev ~= npcName then
        clearNpcSeat(seatKey)
        occupied = getOccupiedNpcSeatMap()
    end
    for _, key in ipairs(C.NPCSeats or {}) do
        if occupied[key] == npcName then
            occupied[key] = false
            local otherFig = G.getObject(rec.figurineGuid or "")
            if otherFig ~= nil then
                clearNpcFigurineSeatIdentity(otherFig, npcName)
            end
        end
    end
    occupied[seatKey] = npcName
    setOccupiedNpcSeatMap(occupied)
    syncSeatSlotAuthoringForNpcSeat(seatKey, npcName)
    local fig = G.getObject(rec.figurineGuid or "")
    local placedOk, placedErr = prepareNpcFigurineForSeat(fig, npcName, seatKey, opts)
    if not placedOk then
        return false, placedErr
    end
    rec = getInstances()[npcName]
    rec.seatedSeatKey = seatKey
    rec.stagePlacement = nil
    rec.areaKey = SEAT_PLACEMENT_KEY
    rec.npcLightMode = "STANDARD"
    setInstanceRecord(npcName, rec)
    return true, nil
end

local isNpcLocked

--- @param npcName string
function NPCS.getInstanceRecord(npcName)
    return getInstances()[npcName]
end

--- Registry key used in L.LIGHTMODES and gameState.lights.
--- @param lightGuid string
--- @return string
function NPCS.lightRegistryName(lightGuid)
    return "npcLight_" .. tostring(lightGuid)
end

--- Place figurine at gameboard `placements` world pose (STAGE_BOARD u,v,yaw).
--- @param figurine Object
--- @param placement table `{ u, v, yaw? }`
function NPCS.applyFigurinePlacementAtWorld(figurine, placement)
    if not U.isGameObject(figurine) or type(placement) ~= "table" then
        return
    end
    local Gameboard = require("core.npc_gameboard")
    local u = tonumber(placement.u)
    local v = tonumber(placement.v)
    if u == nil or v == nil then
        return
    end
    local groundLevel = tonumber(placement.groundLevel)
    if groundLevel == nil and type(Gameboard.groundLevelForSnapUv) == "function" then
        groundLevel = Gameboard.groundLevelForSnapUv(u, v)
    end
    local pos = Gameboard.worldFromUv(u, v, {
        groundLevel = groundLevel,
    })
    figurine.setPosition(pos)
    local relYaw = Gameboard.placementBoardRelYawDeg(u, v)
    local yawDeg = relYaw
    if type(Gameboard.stageFigurineWorldYawDeg) == "function" then
        yawDeg = Gameboard.stageFigurineWorldYawDeg(relYaw)
    end
    figurine.setRotation(Vector(0, yawDeg, 0))
    ensureNpcFigurinePhysicsLocked(figurine)
    local notes = ""
    if figurine.getGMNotes ~= nil then
        notes = tostring(figurine.getGMNotes() or "")
    end
    local displayName = figurine.getName and figurine.getName() or "?"
    print(string.format(
        "[NPCS] figurine stage placement %s (%s) u=%.4f v=%.4f ringYaw=%.1f worldYaw=%.1f ground=%.3f → world (%.2f, %.2f, %.2f)",
        tostring(displayName),
        notes ~= "" and notes or "?",
        u,
        v,
        relYaw,
        yawDeg,
        tonumber(groundLevel) or 0,
        pos.x,
        pos.y,
        pos.z
    ))
end

--- Place an NPC figurine at a Scatter Mode world pose (not STAGE_BOARD u/v), spawning the pair first when needed.
--- World Y is stage/playfield `FLOOR_Y` (NPC feet). Seated PC piles do not use this.
--- @param npcName string
--- @param pose table `{ position, rotation }`
--- @param opts table|nil `{ npcLightMode?, skipSeatSync? }`
--- @return boolean, string|nil
function NPCS.moveNpcToScatterPose(npcName, pose, opts)
    opts = U.Type(opts) == "table" and opts or {}
    if type(npcName) ~= "string" or npcName == "" or U.Type(pose) ~= "table" then
        return false, "Invalid scatter pose."
    end
    local rec = ensureLiveNpcInstance(npcName)
    if isNpcLocked(rec) then
        return false, "NPC is locked in place. Unlock before moving."
    end
    local skipSeatSync = opts.skipSeatSync == true
    if U.Type(rec.seatedSeatKey) == "string" and isValidNpcSeatKey(rec.seatedSeatKey) then
        local seatFig = G.getObject(rec.figurineGuid or "")
        if seatFig ~= nil then
            clearNpcFigurineSeatIdentity(seatFig, npcName)
        end
        rec.seatedSeatKey = nil
        setInstanceRecord(npcName, rec)
    end
    ensureNpcLight(npcName)
    rec = getInstances()[npcName]
    local fig = G.getObject(rec.figurineGuid or "")
    local lit = G.getObject(rec.lightGuid or "")
    local ScatterLayout = require("lib.scatter_layout")
    local floorY = ScatterLayout.floorY()
    local srcPos = pose.position
    local pos = Vector({
        x = tonumber(srcPos and (srcPos.x or srcPos[1])) or 0,
        y = floorY,
        z = tonumber(srcPos and (srcPos.z or srcPos[3])) or 0,
    })
    local rot = Vector(pose.rotation)
    -- Unhide / scale before the final pose so restoreObject cannot overwrite FLOOR_Y.
    local reloaded = applyNpcPairPhysicalPresentation(fig, lit, SCATTER_AREA_KEY, npcName)
    fig.setPosition(pos)
    fig.setRotation(rot)
    ensureNpcFigurinePhysicsLocked(fig)
    rec.areaKey = SCATTER_AREA_KEY
    rec.slotIndex = 0
    rec.stagePlacement = nil
    rec.npcLightMode = normalizedStageNpcLightMode({ npcLightMode = opts.npcLightMode or rec.npcLightMode or "STANDARD" })
    setInstanceRecord(npcName, rec)
    applyStageNpcSpotlightNow(npcName, fig, lit, 0)
    deferNpcSpotlightAlignedToFigurine(npcName, fig, lit, 0)
    if reloaded == true then
        local settleName = npcName
        local settlePos = Vector({ x = pos.x, y = pos.y, z = pos.z })
        local settleRot = Vector({ x = rot.x, y = rot.y, z = rot.z })
        U.chain({
            function()
                return function()
                    local f = G.getObject((getInstances()[settleName] or {}).figurineGuid or "")
                    return f ~= nil and f.loading_custom ~= true
                end
            end,
            function()
                local f = G.getObject((getInstances()[settleName] or {}).figurineGuid or "")
                local l = G.getObject((getInstances()[settleName] or {}).lightGuid or "")
                if f ~= nil then
                    f.setPosition(settlePos)
                    f.setRotation(settleRot)
                    ensureNpcFigurinePhysicsLocked(f)
                    applyStageNpcSpotlightNow(settleName, f, l, 0)
                end
            end,
        })
    end
    if not skipSeatSync then
        requestSeatLayoutSync()
    end
    return true, nil
end

--- Normalize a mode `color` field to TTS `Color` when stored as `{ r, g, b }` (save-safe state).
--- @param mode table
local function normalizeMergedModeColor(mode)
    if U.Type(mode) ~= "table" then
        return
    end
    local c = mode.color
    if c == nil then
        return
    end
    if type(c) == "userdata" or (U.Type(c) == "table" and type(c.get) == "function") then
        return
    end
    if U.Type(c) == "table" then
        local r = tonumber(c.r or c[1])
        local g = tonumber(c.g or c[2])
        local b = tonumber(c.b or c[3])
        if r ~= nil and g ~= nil and b ~= nil then
            local a = tonumber(c.a or c[4])
            if a ~= nil then
                mode.color = Color(r, g, b, a)
            else
                mode.color = Color(r, g, b)
            end
        end
    end
end

--- @param npcName string
--- @param modeKey string
--- @return table
function NPCS.getMergedModeDefinition(npcName, modeKey)
    local def = NPCS.characters[npcName]
    local globalMode = NPCS.lights[modeKey] or {}
    local per = def and def.lighting and def.lighting[modeKey] or nil
    local merged = deepMerge(globalMode, per)
    local rec = getInstances()[npcName]
    if U.Type(rec) == "table" and rec.areaKey == STAGE_BOARD_AREA_KEY then
        local stageOverride = NPCS.stageLights[modeKey]
        if U.Type(stageOverride) == "table" then
            merged = deepMerge(merged, stageOverride)
        end
    end
    -- Live DEBUG overrides win last (TOR-471): `gameState.debug.npcLightModes[modeKey]`.
    local debugOverride = S.getStateVal("debug", "npcLightModes", modeKey)
    if U.Type(debugOverride) == "table" then
        merged = deepMerge(merged, debugOverride)
    end
    normalizeMergedModeColor(merged)
    return merged
end

--- Resolve light world pose from a figurine's live bounds + a `positioning` block (TOR-416 lock-on).
--- @param fig Object
--- @param positioning table|nil
--- @param npcName string|nil used for ImageScalar bounds correction
--- @return table|nil `{ position, lookAtTarget, rotation }`
function NPCS.resolveFigurineLightPose(fig, positioning, npcName)
    if not U.isGameObject(fig) or U.Type(positioning) ~= "table" then
        return nil
    end
    local b = fig.getBounds()
    if b == nil or b.center == nil or b.size == nil then
        return nil
    end
    local cx = b.center.x or b.center[1] or 0
    local cy = b.center.y or b.center[2] or 0
    local cz = b.center.z or b.center[3] or 0
    local sy = b.size.y or b.size[2] or 1
    if U.Type(npcName) == "string" and npcName ~= "" then
        cy, sy = correctFigurineBoundsForRegistryScalar(fig, npcName, cy, sy)
    end
    local topY = cy + sy / 2
    local px, pz = cx, cz
    local len2 = px * px + pz * pz
    local inv = (len2 > 1e-6) and (1 / math.sqrt(len2)) or 0
    local lightPos
    if positioning.deltaUp ~= nil or positioning.deltaInward ~= nil then
        -- `deltaUp` above bounds top, `deltaInward` toward origin in XZ.
        local deltaUp = tonumber(positioning.deltaUp) or NPC_FIGURINE_LIGHT_ABOVE_TOP_Y
        local deltaInward = tonumber(positioning.deltaInward) or NPC_FIGURINE_LIGHT_INWARD_XZ
        lightPos = Vector(
            px + (-px * inv) * deltaInward,
            topY + deltaUp,
            pz + (-pz * inv) * deltaInward
        )
    elseif positioning.positionYShift ~= nil or positioning.distance ~= nil then
        -- Legacy: `positionYShift` fraction below bounds top, `distance` radial (negative = inward).
        local posFrac = tonumber(positioning.positionYShift) or 0.3
        local dist = tonumber(positioning.distance) or -15
        lightPos = Vector(
            px + (px * inv) * dist,
            topY - posFrac * sy,
            pz + (pz * inv) * dist
        )
    end
    if lightPos == nil then
        return nil
    end
    local faceY = cy
    if positioning.lookAtYShift ~= nil then
        faceY = topY - (tonumber(positioning.lookAtYShift) or 0) * sy
    end
    local lookAtTarget = Vector(cx, faceY, cz)
    return {
        position = lightPos,
        lookAtTarget = lookAtTarget,
        rotation = U.lookAtRotation(lightPos, lookAtTarget),
    }
end

--- Normalize positioning to lerpable `deltaUp` / `deltaInward` / `lookAtYShift` (TOR-416).
--- Legacy `distance` / `positionYShift` map to approximate deltas for mid-lerp blends.
--- @param positioning table|nil
--- @return table|nil
function NPCS.normalizeLightPositioningForLerp(positioning)
    if U.Type(positioning) ~= "table" then
        return nil
    end
    if positioning.deltaUp ~= nil or positioning.deltaInward ~= nil then
        return {
            deltaUp = tonumber(positioning.deltaUp) or NPC_FIGURINE_LIGHT_ABOVE_TOP_Y,
            deltaInward = tonumber(positioning.deltaInward) or NPC_FIGURINE_LIGHT_INWARD_XZ,
            lookAtYShift = tonumber(positioning.lookAtYShift) or 0.1,
        }
    end
    if positioning.positionYShift ~= nil or positioning.distance ~= nil then
        local dist = tonumber(positioning.distance) or -15
        return {
            deltaUp = NPC_FIGURINE_LIGHT_ABOVE_TOP_Y,
            deltaInward = math.abs(dist),
            lookAtYShift = tonumber(positioning.lookAtYShift) or 0.1,
        }
    end
    return nil
end

--- Lerp two normalized positioning tables (TOR-416).
--- @param a table|nil
--- @param b table|nil
--- @param t number 0..1
--- @return table|nil
function NPCS.lerpLightPositioning(a, b, t)
    local na = NPCS.normalizeLightPositioningForLerp(a)
    local nb = NPCS.normalizeLightPositioningForLerp(b)
    if na == nil and nb == nil then
        return nil
    end
    na = na or nb
    nb = nb or na
    t = math.max(0, math.min(1, tonumber(t) or 0))
    return {
        deltaUp = na.deltaUp + (nb.deltaUp - na.deltaUp) * t,
        deltaInward = na.deltaInward + (nb.deltaInward - na.deltaInward) * t,
        lookAtYShift = na.lookAtYShift + (nb.lookAtYShift - na.lookAtYShift) * t,
    }
end

--- Resolve full mode table (scalars + pose) for an NPC light mode against a figurine.
--- @param npcName string
--- @param modeKey string
--- @param figOverride Object|nil
--- @return table|nil
function NPCS.resolveNpcLightPose(npcName, modeKey, figOverride)
    local rec = NPCS.getInstanceRecord(npcName)
    if rec == nil then
        return nil
    end
    local fig = figOverride
    if fig == nil or not U.isGameObject(fig) then
        fig = lightAlignFigOverride[npcName]
    end
    if fig == nil or not U.isGameObject(fig) then
        fig = G.getObject(rec.figurineGuid or "")
    end
    if fig == nil then
        return nil
    end
    local mode = NPCS.getMergedModeDefinition(npcName, modeKey)
    local out = U.clone(mode) or {}
    out.positioning = nil
    local positioning = mode.positioning
    if U.Type(positioning) ~= "table" then
        return out
    end
    local pose = NPCS.resolveFigurineLightPose(fig, positioning, npcName)
    if pose == nil then
        return out
    end
    -- Scatter: figurine yaw is flipped +180 vs look-at-G. Light placement uses world-origin
    -- "inward", so rotate the light XZ around the figurine 180° to keep NPC+light a rigid body.
    if U.Type(rec) == "table" and rec.areaKey == SCATTER_AREA_KEY and pose.position ~= nil then
        local b = fig.getBounds()
        local fx = (b and b.center and (b.center.x or b.center[1])) or (pose.lookAtTarget and pose.lookAtTarget.x) or 0
        local fz = (b and b.center and (b.center.z or b.center[3])) or (pose.lookAtTarget and pose.lookAtTarget.z) or 0
        local lp = pose.position
        local lx = tonumber(lp.x or lp[1]) or 0
        local ly = tonumber(lp.y or lp[2]) or 0
        local lz = tonumber(lp.z or lp[3]) or 0
        pose.position = Vector(2 * fx - lx, ly, 2 * fz - lz)
        if pose.lookAtTarget ~= nil then
            pose.rotation = U.lookAtRotation(pose.position, pose.lookAtTarget)
        end
    end
    out.position = pose.position
    out.rotation = pose.rotation
    -- Ephemeral: SetLightMode couples pos→lookAt during transitions (TOR-369 / TOR-416).
    out.lookAtTarget = pose.lookAtTarget
    return out
end

--- @param npcName string
--- @param modeKey string
--- @return table|nil mode table with position, rotation Vectors
function NPCS.buildResolvedLightModeTable(npcName, modeKey)
    return NPCS.resolveNpcLightPose(npcName, modeKey, nil)
end

--- Ensure pooled spotlight registry includes OFFSPOTLIGHT (TOR-473).
--- @param npcName string
--- @param lightGuid string
local function ensureNpcSpotlightModesRegistered(npcName, lightGuid)
    local reg = NPCS.lightRegistryName(lightGuid)
    if L.LIGHTMODES[reg] == nil then
        L.registerNpcSpotlightModes(npcName, lightGuid)
        return
    end
    if L.LIGHTMODES[reg].OFFSPOTLIGHT == nil then
        L.registerNpcSpotlightModes(npcName, lightGuid)
    end
end

--- Dim / restore same-family stage lights around SPOTLIGHT figurines (TOR-473).
--- OFFSPOTLIGHT is runtime-only (`familyOffSpotlight`); never written to placement scans.
--- @param transitionTime number|nil
--- @param opts table|nil `{ force?: boolean, skipFamilyReconcile?: boolean, flagsOnly?: boolean, skipInFlight?: boolean }`
function NPCS.reconcileFamilyOffSpotlight(transitionTime, opts)
    opts = type(opts) == "table" and opts or {}
    if opts.skipFamilyReconcile == true then
        return
    end
    if transitionTime == nil then
        transitionTime = 0.35
    end
    local desired = {}
    for name, rec in pairs(getInstances()) do
        if U.Type(name) == "string"
            and U.Type(rec) == "table"
            and rec.areaKey == STAGE_BOARD_AREA_KEY
            and (spotlightHeld[name] == true or rec.npcLightMode == "SPOTLIGHT")
        then
            local siblings = collectStageFamilySiblingKeys(name)
            for i = 1, #siblings do
                local sib = siblings[i]
                local srec = getInstances()[sib]
                if U.Type(srec) == "table"
                    and srec.npcLightMode ~= "OFF"
                    and not npcIsEffectivelySpotlit(sib, srec)
                    and not (U.Type(srec.seatedSeatKey) == "string" and isValidNpcSeatKey(srec.seatedSeatKey))
                then
                    desired[sib] = true
                end
            end
        end
    end

    local StageLerp = nil
    if opts.skipInFlight == true then
        StageLerp = require("core.npc_stage_lerp")
    end

    local function shouldSkipWorldApply(npcName)
        if opts.flagsOnly == true then
            return true
        end
        if opts.skipInFlight == true
            and type(StageLerp) == "table"
            and type(StageLerp.isNpcInFlight) == "function"
            and StageLerp.isNpcInFlight(npcName) == true
        then
            return true
        end
        return false
    end

    for name, _ in pairs(desired) do
        local was = familyOffSpotlight[name] == true
        familyOffSpotlight[name] = true
        if (not was or opts.force == true) and not shouldSkipWorldApply(name) then
            NPCS.applyCurrentLightMode(name, transitionTime, {
                force = opts.force == true,
                skipFamilyReconcile = true,
            })
        end
    end
    local leaving = {}
    for name, _ in pairs(familyOffSpotlight) do
        if desired[name] ~= true then
            leaving[#leaving + 1] = name
        end
    end
    for i = 1, #leaving do
        local name = leaving[i]
        familyOffSpotlight[name] = nil
        if not shouldSkipWorldApply(name) then
            NPCS.applyCurrentLightMode(name, transitionTime, {
                force = opts.force == true,
                skipFamilyReconcile = true,
            })
        end
    end
end

--- TOR-238 hold-preview companion dims (transient; does not write `gameState.lights` OFFSPOTLIGHT).
--- @param spotlitName string|nil character key under preview, or nil to clear
--- @param transitionTime number|nil
function NPCS.syncFamilyOffSpotlightPreview(spotlitName, transitionTime)
    if transitionTime == nil then
        transitionTime = 0.12
    end
    local L = require("core.lighting")
    for name, _ in pairs(spotlightPreviewHeld) do
        spotlightPreviewHeld[name] = nil
    end
    if U.Type(spotlitName) == "string" and spotlitName ~= "" then
        spotlightPreviewHeld[spotlitName] = true
    end

    local desired = {}
    if U.Type(spotlitName) == "string" and spotlitName ~= "" and spotlightPreviewHeld[spotlitName] == true then
        local siblings = collectStageFamilySiblingKeys(spotlitName)
        for i = 1, #siblings do
            local sib = siblings[i]
            local srec = getInstances()[sib]
            if U.Type(srec) == "table"
                and srec.npcLightMode ~= "OFF"
                and not npcIsEffectivelySpotlit(sib, srec)
                and not (U.Type(srec.seatedSeatKey) == "string" and isValidNpcSeatKey(srec.seatedSeatKey))
            then
                desired[sib] = true
            end
        end
    end

    local function applyTransientMode(npcName, modeKey)
        local rec = getInstances()[npcName]
        if U.Type(rec) ~= "table" or U.Type(rec.lightGuid) ~= "string" or rec.lightGuid == "" then
            return
        end
        ensureNpcSpotlightModesRegistered(npcName, rec.lightGuid)
        local modeTable = NPCS.buildResolvedLightModeTable(npcName, modeKey)
        if U.Type(modeTable) ~= "table" then
            return
        end
        L.applyTransientLightMode(NPCS.lightRegistryName(rec.lightGuid), modeTable, {
            transitionTime = transitionTime,
        })
    end

    for name, _ in pairs(desired) do
        local was = familyOffSpotlightPreview[name] == true
        familyOffSpotlightPreview[name] = true
        if not was and familyOffSpotlight[name] ~= true then
            applyTransientMode(name, "OFFSPOTLIGHT")
        end
    end
    local leaving = {}
    for name, _ in pairs(familyOffSpotlightPreview) do
        if desired[name] ~= true then
            leaving[#leaving + 1] = name
        end
    end
    for i = 1, #leaving do
        local name = leaving[i]
        familyOffSpotlightPreview[name] = nil
        if familyOffSpotlight[name] ~= true then
            local rec = getInstances()[name]
            local steady = (U.Type(rec) == "table" and rec.npcLightMode) or "STANDARD"
            applyTransientMode(name, effectiveAppliedLightModeKey(name, steady))
        end
    end
end

--- @param npcName string
--- @param transitionTime number|nil
--- @param opts table|nil `{ force?: boolean, skipFamilyReconcile?: boolean }`
function NPCS.applyCurrentLightMode(npcName, transitionTime, opts)
    opts = type(opts) == "table" and opts or {}
    local rec = NPCS.getInstanceRecord(npcName)
    if rec == nil or rec.lightGuid == nil then
        return
    end
    if U.Type(rec.seatedSeatKey) == "string" and isValidNpcSeatKey(rec.seatedSeatKey) then
        return
    end
    local reg = NPCS.lightRegistryName(rec.lightGuid)
    local modeKey = effectiveAppliedLightModeKey(npcName, rec.npcLightMode or "STANDARD")
    ensureNpcSpotlightModesRegistered(npcName, rec.lightGuid)
    if transitionTime == nil then
        transitionTime = 0.35
    end
    if opts.force == true then
        L.invalidateReconcileCacheForRef(reg)
    end
    -- State-first mutation; lighting module reconcile owns live-world writes.
    S.setStateVal(modeKey, "lights", reg)
    L.reconcileLightRef(reg, transitionTime, { force = opts.force == true })
    applyNpcFigureTooltip(npcName)
    if opts.skipFamilyReconcile ~= true then
        NPCS.reconcileFamilyOffSpotlight(transitionTime, {
            force = opts.force == true,
        })
    end
end

--- Re-apply each spawned NPC's current light mode (used after scene transitions that force OFF).
--- @param transitionTime number|nil
--- @param opts table|nil `{ force?: boolean }` — when true, bypass lighting reconcile cache (DEBUG mode tunes).
function NPCS.reapplyAllCurrentLightModes(transitionTime, opts)
    opts = type(opts) == "table" and opts or {}
    local instances = getInstances()
    for npcName, rec in pairs(instances) do
        if U.Type(npcName) == "string" and U.Type(rec) == "table" and U.Type(rec.lightGuid) == "string" and rec.lightGuid ~= "" then
            NPCS.applyCurrentLightMode(npcName, transitionTime, {
                force = opts.force == true,
                skipFamilyReconcile = true,
            })
        end
    end
    NPCS.reconcileFamilyOffSpotlight(transitionTime, { force = opts.force == true })
end

--- @param obj Object
--- @return string|nil
function NPCS.resolveNpcNameFromFigurine(obj)
    if obj == nil then
        return nil
    end
    local notes = obj.getGMNotes and obj.getGMNotes() or ""
    local name = string.match(notes, "^" .. GM_PREFIX .. "(.+)$")
    local guid = obj.getGUID and obj.getGUID() or ""
    if name then
        if guid ~= "" then
            figurineGuidToNpcName[guid] = name
        end
        return name
    end
    if guid == "" then
        return nil
    end
    local cached = figurineGuidToNpcName[guid]
    if cached ~= nil then
        return cached
    end
    rebuildFigurineGuidCache()
    return figurineGuidToNpcName[guid]
end

--- Called when a figurine may have moved (drop or script move).
--- @param obj Object
function NPCS.onObjectDropped(obj)
    if not NPCS.isPooledFigurineObject(obj) then
        return
    end
    local npcName = NPCS.resolveNpcNameFromFigurine(obj)
    if npcName then
        ensureNpcFigurinePhysicsLocked(obj)
        NPCS.applyCurrentLightMode(npcName, 0)
    end
end

--- Normalized rows from `sessionScene.npcWorld.placements` (gameboard schema v3).
--- @return table[]
local function collectSessionStagePlacements()
    local out = {}
    local placements = S.getStateVal("sessionScene", "npcWorld", "placements")
    if type(placements) ~= "table" then
        return out
    end
    local keys = U.getKeys(placements)
    table.sort(keys)
    for _, characterKey in ipairs(keys) do
        local row = placements[characterKey]
        if type(row) == "table" and type(characterKey) == "string" and characterKey ~= "" then
            local u = tonumber(row.u)
            local v = tonumber(row.v)
            if u ~= nil and v ~= nil then
                local lm = row.npcLightMode
                if lm ~= "OFF" and lm ~= "STANDARD" and lm ~= "SPOTLIGHT" then
                    lm = "STANDARD"
                end
                local groundLevel = tonumber(row.groundLevel)
                if groundLevel == nil then
                    local Gameboard = require("core.npc_gameboard")
                    if type(Gameboard.groundLevelForSnapUv) == "function" then
                        groundLevel = Gameboard.groundLevelForSnapUv(u, v)
                    end
                end
                local placementRow = {
                    characterKey = characterKey,
                    u = u,
                    v = v,
                    yaw = tonumber(row.yaw) or 0,
                    npcLightMode = lm,
                }
                if groundLevel ~= nil then
                    placementRow.groundLevel = groundLevel
                end
                out[#out + 1] = placementRow
            end
        end
    end
    return out
end

--- @return table[]
function NPCS.collectSessionStagePlacements()
    return collectSessionStagePlacements()
end

--- @return string
local function sessionNpcWorldFingerprint()
    local lines = {}
    for _, pl in ipairs(collectSessionStagePlacements()) do
        local lm = pl.npcLightMode or ""
        lines[#lines + 1] = string.format(
            "p:%s:%.4f:%.4f:%.1f:%s:%.3f",
            pl.characterKey,
            pl.u,
            pl.v,
            pl.yaw or 0,
            lm,
            tonumber(pl.groundLevel) or 0
        )
    end
    table.sort(lines)
    return table.concat(lines, "\n")
end

--- @return boolean
local function npcWorldHasPlacementIntent()
    return #collectSessionStagePlacements() > 0
end

--- Fingerprint of `seatLayout.occupiedNPCSlots` (from session `seatSlots` via `S.validateState`).
--- @return string
occupiedNpcSeatsFingerprint = function()
    local lines = {}
    local occupied = getOccupiedNpcSeatMap()
    for _, seatKey in ipairs(C.NPCSeats or {}) do
        local slotValue = occupied[seatKey]
        if slotValue == false then
            slotValue = ""
        end
        lines[#lines + 1] = seatKey .. "=" .. tostring(slotValue or "")
    end
    table.sort(lines)
    return table.concat(lines, "\n")
end

--- Unified reconcile fingerprint: placements + seats + table + NPC presence + PC occupancy.
--- PC `tableSlot` / Absent must be included so Apply that only moves PC tokens still
--- reaches Step Three `commitNpcSeatLayout` (TOR-513).
--- @return string
local function npcReconcileFingerprint()
    local lines = {}
    lines[#lines + 1] = "phase:" .. tostring(S.getStateVal("currentPhase") or "")
    lines[#lines + 1] = "npcWorld:\n" .. sessionNpcWorldFingerprint()
    lines[#lines + 1] = "seats:\n" .. occupiedNpcSeatsFingerprint()
    local tableKey = S.getStateVal("seatLayout", "currentTableKey")
    lines[#lines + 1] = "table:" .. tostring(tableKey or "")
    local scatterLines = {}
    local ScatterLayout = require("lib.scatter_layout")
    local pack = S.getStateVal("sessionScene", "scatterPlacements")
    if U.Type(pack) == "table" then
        for i = 1, ScatterLayout.groupCount() do
            local areaKey = ScatterLayout.areaKeyForGroup(i)
            local area = pack[areaKey]
            if U.Type(area) == "table" then
                if U.Type(area.orbitCharacters) == "table" then
                    for npcKey, row in pairs(area.orbitCharacters) do
                        if type(npcKey) == "string" then
                            scatterLines[#scatterLines + 1] = string.format(
                                "o:%s:%s:%d:%s",
                                areaKey,
                                npcKey,
                                math.floor(tonumber(row and row.slot) or 0),
                                tostring(row and row.npcLightMode or "")
                            )
                        end
                    end
                end
                if U.Type(area.centerCharacters) == "table" then
                    for pcKey, row in pairs(area.centerCharacters) do
                        if type(pcKey) == "string" then
                            scatterLines[#scatterLines + 1] = string.format(
                                "c:%s:%s:%d:%s",
                                areaKey,
                                pcKey,
                                math.floor(tonumber(row and row.slot) or 0),
                                tostring(row and row.characterKey or "")
                            )
                        end
                    end
                end
            end
        end
    end
    table.sort(scatterLines)
    lines[#lines + 1] = "scatter:\n" .. table.concat(scatterLines, "\n")
    for _, seatKey in ipairs(C.NPCSeats or {}) do
        lines[#lines + 1] = "present:" .. seatKey .. "=" .. tostring(resolveSeatPresenceForSeat(seatKey))
    end
    local FSL = require("lib.figurine_seat_layout")
    lines[#lines + 1] = "occupancy:\n" .. FSL.occupancyFingerprint()
    return table.concat(lines, "\n")
end

--- Step Zero: resolve placement intent from authoring inputs (read-only).
--- True only for characters in the NPC-managed roster (PCs flagged `isPC` and unknown keys excluded).
--- The reconciler spawns/seats figurines from this intent, so PC keys from stale `placements` rows
--- must not leak in. Every instance without a stage / seat / Scatter target resolves to `none` (despawn).
--- @param name string|nil
--- @return boolean
local function isNpcManagedCharacter(name)
    return U.Type(name) == "string" and name ~= "" and NPCS.characters[name] ~= nil
end

--- Spotlight and End have no live NPC stage. Leftover placement rows must not keep figurines up.
--- @return boolean
local function narrativeNpcStageOpen()
    local phase = S.getStateVal("currentPhase")
    return phase ~= C.Phases.SPOTLIGHT and phase ~= C.Phases.END
end

--- @return table `{ byCharacter, bySeat, tableKey }`
resolveNpcPlacementIntent = function()
    local byCharacter = {}
    local stageOpen = narrativeNpcStageOpen()
    if stageOpen then
        for _, pl in ipairs(collectSessionStagePlacements()) do
            if isNpcManagedCharacter(pl.characterKey) then
                byCharacter[pl.characterKey] = {
                    target = "stage",
                    u = pl.u,
                    v = pl.v,
                    yaw = pl.yaw,
                    npcLightMode = pl.npcLightMode,
                    groundLevel = pl.groundLevel,
                }
            end
        end

        -- Scatter Mode owns orbit (and playing-NPC) figurines via scatterPlacements, not npcWorld.placements.
        local ScatterMode = require("core.scatter_mode")
        if ScatterMode.isActive() then
            local ScatterLayout = require("lib.scatter_layout")
            local pack = S.getStateVal("sessionScene", "scatterPlacements")
            if U.Type(pack) == "table" then
                for i = 1, ScatterLayout.groupCount() do
                    local area = pack[ScatterLayout.areaKeyForGroup(i)]
                    if U.Type(area) == "table" then
                        if U.Type(area.orbitCharacters) == "table" then
                            for npcKey, _ in pairs(area.orbitCharacters) do
                                if isNpcManagedCharacter(npcKey) then
                                    byCharacter[npcKey] = {
                                        target = "scatter",
                                        npcLightMode = "STANDARD",
                                    }
                                end
                            end
                        end
                        if U.Type(area.centerCharacters) == "table" then
                            for _, crow in pairs(area.centerCharacters) do
                                if U.Type(crow) == "table"
                                    and crow.isPlayingNPC == true
                                    and isNpcManagedCharacter(crow.characterKey)
                                then
                                    byCharacter[crow.characterKey] = {
                                        target = "scatter",
                                        npcLightMode = "STANDARD",
                                    }
                                end
                            end
                        end
                    end
                end
            end
        end
    end

    local tableKey = S.getStateVal("seatLayout", "currentTableKey")
    local tableCfg = U.Type(tableKey) == "string" and C.Tables[tableKey] or nil
    local FSL = require("lib.figurine_seat_layout")
    local bySeat = {}

    for _, seatKey in ipairs(C.NPCSeats or {}) do
        local assignedChar = resolveAssignedCharacterForSeat(seatKey)
        local assigned = U.Type(assignedChar) == "string" and assignedChar ~= ""
        local tableHasSlot = FSL.seatIsOnTable(seatKey, tableCfg)
        local present = resolveSeatPresenceForSeat(seatKey)
        local ciAssigned = assigned and U.Type(byCharacter[assignedChar]) == "table" and byCharacter[assignedChar] or nil
        local areaBound = ciAssigned ~= nil
            and (ciAssigned.target == "stage" or ciAssigned.target == "scatter")
        local physicalSeatAllowed = assigned and tableHasSlot and not areaBound
        bySeat[seatKey] = {
            assigned = assigned,
            assignedCharacter = assignedChar,
            tableHasSlot = tableHasSlot,
            present = present,
            physicalSeatAllowed = physicalSeatAllowed,
            areaBoundOccupant = areaBound and assignedChar or nil,
        }
        if assigned and not areaBound and byCharacter[assignedChar] == nil
            and isNpcManagedCharacter(assignedChar) then
            if tableHasSlot then
                byCharacter[assignedChar] = { target = "seat", seatKey = seatKey }
            else
                byCharacter[assignedChar] = { target = "none", pendingSeatKey = seatKey }
            end
        end
    end

    for name, _ in pairs(getInstances()) do
        if byCharacter[name] == nil then
            byCharacter[name] = { target = "none" }
        end
    end

    return {
        byCharacter = byCharacter,
        bySeat = bySeat,
        tableKey = tableKey,
    }
end

--- @param opts table|nil
--- @param stepNum number
--- @return boolean
local function reconcileStepEnabled(opts, stepNum)
    local only = opts.onlySteps
    if U.Type(only) ~= "table" or #only < 1 then
        return true
    end
    for i = 1, #only do
        if only[i] == stepNum then
            return true
        end
    end
    return false
end

--- Step One: despawn stage / Scatter NPCs that resolved intent no longer places anywhere.
--- Stage → seat, stage → stage, and Scatter retargets keep their objects (Steps Three / Five move them).
--- @param intent table
--- @return boolean allOk
local function reconcileStepOneAreaRemovals(intent)
    for name, rec in pairs(U.clone(getInstances())) do
        if U.Type(rec) == "table" and npcInstanceOnStage(name) then
            local ci = intent.byCharacter[name]
            if U.Type(ci) ~= "table" or ci.target == "none" then
                despawnNpcInstance(name)
            end
        end
    end
    return true
end

--- @param seatKey string
--- @return string|nil npcName physically at seat, if any
local function physicalOccupantAtSeat(seatKey)
    for name, rec in pairs(getInstances()) do
        if U.Type(rec) == "table" and rec.seatedSeatKey == seatKey then
            return name
        end
    end
    local tag = seatTagForKey(seatKey)
    local tagged = getObjectsWithTag(tag)
    if U.Type(tagged) == "table" then
        for i = 1, #tagged do
            local o = tagged[i]
            if o ~= nil and NPCS.isPooledFigurineObject(o) and figurineHasSeatTag(o, seatKey) then
                for name, rec in pairs(getInstances()) do
                    if U.Type(rec) == "table" and rec.figurineGuid == o.getGUID() then
                        return name
                    end
                end
            end
        end
    end
    return nil
end

--- Step Two: remove NPCs from table seats per resolved intent.
--- @param intent table
--- @return boolean allOk
local function reconcileStepTwoSeatRemovals(intent)
    local allOk = true
    for _, seatKey in ipairs(C.NPCSeats or {}) do
        local info = intent.bySeat[seatKey]
        if U.Type(info) == "table" then
            if not (info.assigned and not info.present) then
                local physicalName = physicalOccupantAtSeat(seatKey)
                local atSeat = physicalName ~= nil
                if not info.assigned then
                    if atSeat then
                        npcSeatWorkThisPass = true
                        local ok, err = clearNpcSeatPhysical(seatKey, { retainAssignment = false, skipLayoutSync = true })
                        if not ok then
                            allOk = false
                            print("[NPCS] step2 unassign clear " .. tostring(seatKey) .. ": " .. tostring(err))
                        end
                    end
                elseif U.Type(info.assignedCharacter) == "string" and physicalName ~= nil and physicalName ~= info.assignedCharacter then
                    npcSeatWorkThisPass = true
                    local ok, err = clearNpcSeatPhysical(seatKey, { retainAssignment = false, skipLayoutSync = true })
                    if not ok then
                        allOk = false
                        print("[NPCS] step2 wrong occupant " .. tostring(seatKey) .. ": " .. tostring(err))
                    end
                elseif not info.physicalSeatAllowed and atSeat then
                    local retain = false
                    if info.assigned then
                        if not info.tableHasSlot then
                            retain = true
                        elseif U.Type(info.areaBoundOccupant) == "string" and info.areaBoundOccupant ~= "" then
                            retain = true
                        end
                    end
                    npcSeatWorkThisPass = true
                    local ok, err = clearNpcSeatPhysical(seatKey, {
                        retainAssignment = retain,
                        skipLayoutSync = true,
                    })
                    if not ok then
                        allOk = false
                        print("[NPCS] step2 physical off " .. tostring(seatKey) .. ": " .. tostring(err))
                    end
                end
            end
        end
    end
    return allOk
end

--- Layout commit A: synchronous table layout using orchestrator context.
--- The RSL layout fingerprint ignores stage / Scatter occupants, so the commit forces
--- `RSL.SyncTable` itself — but only when seat-bound inputs changed (TOR-210 / TOR-668).
--- When skipped, the layout's light/overlay tail still runs so PC presence lights stay state-derived.
--- @param intent table
--- @param force boolean orchestrator `force`
local function commitNpcSeatLayout(intent, force)
    local physicalSeatAllowedBySeat = {}
    local psaLines = {}
    for _, seatKey in ipairs(C.NPCSeats or {}) do
        local info = intent.bySeat[seatKey]
        if U.Type(info) == "table" then
            physicalSeatAllowedBySeat[seatKey] = info.physicalSeatAllowed == true
        end
        psaLines[#psaLines + 1] = seatKey .. "=" .. tostring(physicalSeatAllowedBySeat[seatKey] == true)
    end
    local tableKey = S.getStateVal("seatLayout", "currentTableKey")
    local tableKeyStr = U.Type(tableKey) == "string" and tableKey or ""
    local seatFingerprint = occupiedNpcSeatsFingerprint()
    local FSL = require("lib.figurine_seat_layout")
    local commitKey = table.concat({
        tableKeyStr,
        seatFingerprint,
        table.concat(psaLines, ","),
        FSL.occupancyFingerprint(),
    }, "\n")
    local rsl = require("lib.rotational-seat-layout")
    local mustLayout = force == true
        or npcSeatWorkThisPass
        or commitKey ~= lastNpcLayoutCommit.commitKey
        or not rsl.isLayoutSyncCurrent(tableKey)
    if mustLayout then
        npcReconcileLayoutContext = {
            physicalSeatAllowedBySeat = physicalSeatAllowedBySeat,
        }
        rsl.SyncTable(tableKey, { force = true })
        npcReconcileLayoutContext = nil
    else
        L.reconcileAllPlayers({ skipNpcSeats = true, skipStageBoundNpcSeats = true })
        require("core.hud_overlays").syncAll()
    end
    require("lib.sync_trace").report("NPCS.commitNpcSeatLayout", {
        outcome = mustLayout and "layout" or "skipped",
        seatWork = tostring(npcSeatWorkThisPass),
    })
    lastNpcLayoutCommit = {
        tableKey = tableKeyStr,
        fingerprint = seatFingerprint,
        commitKey = commitKey,
    }
end

--- Step Three: seat-bound NPCs onto table seats (tags only; layout commit follows).
--- @param intent table
--- @param force boolean orchestrator `force`
--- @return boolean allOk
local function reconcileStepThreeSeatPlacements(intent, force)
    local allOk = true
    for _, seatKey in ipairs(C.NPCSeats or {}) do
        if seatNeedsPlacement(seatKey, intent) then
            local info = intent.bySeat[seatKey]
            local npcName = info and info.assignedCharacter
            if U.Type(npcName) == "string" and npcName ~= "" then
                npcSeatWorkThisPass = true
                local ok, err = assignNpcToSeat(npcName, seatKey, {
                    deferLayoutSync = true,
                    blockAreaBound = true,
                })
                if not ok then
                    allOk = false
                    print(
                        "[NPCS] step3 seat "
                            .. tostring(seatKey)
                            .. " for "
                            .. tostring(npcName)
                            .. ": "
                            .. tostring(err)
                    )
                end
            end
        end
    end
    commitNpcSeatLayout(intent, force)
    return allOk
end

--- Step Four: narrative presence visibility; homeland seat lights via state-derived priority (all assigned NPC seats).
--- @param intent table
local function reconcileSeatNarrativePresenceFromIntent(intent)
    local O = require("core.objects")
    if type(O.reconcilePcSeatHiddenObjectsFromState) == "function" then
        O.reconcilePcSeatHiddenObjectsFromState()
    end

    local hideColors = allViewerColorsForInvisibility()
    for _, seatKey in ipairs(C.NPCSeats or {}) do
        local info = intent.bySeat[seatKey]
        if U.Type(info) == "table" and info.assigned == true then
            local visible = info.present == true
            local tag = seatTagForKey(seatKey)
            local objs = getObjectsWithTag(tag)
            if U.Type(objs) == "table" then
                for i = 1, #objs do
                    local obj = objs[i]
                    if obj ~= nil and obj.setInvisibleTo ~= nil then
                        if visible then
                            obj.setInvisibleTo({})
                        else
                            obj.setInvisibleTo(hideColors)
                        end
                        if NPCS.isPooledFigurineObject(obj) and obj.tooltip ~= nil then
                            obj.tooltip = visible
                        end
                    end
                end
            end
            L.reconcileForPlayer(seatKey)
        end
    end
end

--- Step Five (a): gameboard `placements` on STAGE_BOARD.
--- @param intent table
--- @param opts table|nil `{ reason?, animateStageMoves?, deferUiRefresh? }`
--- @return boolean allOk
local function reconcileStepFiveStagePlacements(intent, opts)
    opts = U.Type(opts) == "table" and opts or {}
    local ScatterMode = require("core.scatter_mode")
    if narrativeNpcStageOpen() and ScatterMode.isActive() then
        ScatterMode.applyWorldLayout()
        return true
    end
    local allOk = true
    local lerpCandidates = {}
    local skipCounts = {}
    local stageTargetCount = 0
    local NPCStageLerp = require("core.npc_stage_lerp")
    for name, ci in pairs(intent.byCharacter) do
        if U.Type(ci) == "table" and ci.target == "stage" then
            stageTargetCount = stageTargetCount + 1
            local placement = {
                u = ci.u,
                v = ci.v,
                yaw = ci.yaw,
                npcLightMode = ci.npcLightMode,
                groundLevel = ci.groundLevel,
            }
            local modeOpt = {
                skipUiRefresh = true,
                skipSeatSync = true,
            }
            local rec = getInstances()[name]
            local lerpCandidate, skipReason = NPCStageLerp.evaluateCandidate(name, rec, placement, opts)
            if lerpCandidate ~= nil then
                lerpCandidates[#lerpCandidates + 1] = lerpCandidate
            else
                if type(skipReason) == "string" and skipReason ~= "" then
                    skipCounts[skipReason] = (skipCounts[skipReason] or 0) + 1
                end
                local ok, err = NPCS.moveNpcToStagePlacement(name, placement, modeOpt)
                if not ok then
                    allOk = false
                    print("[NPCS] step5 stage placement " .. tostring(name) .. ": " .. tostring(err))
                end
            end
        end
    end
    if #lerpCandidates > 0 then
        NPCStageLerp.runQueued(lerpCandidates)
    else
        if stageTargetCount > 0 then
            local parts = {}
            for reason, count in pairs(skipCounts) do
                parts[#parts + 1] = tostring(reason) .. "=" .. tostring(count)
            end
            table.sort(parts)
            print("[NPCStageLerp] no animations for " .. tostring(stageTargetCount)
                .. " stage target(s); snaps used. skips: "
                .. (#parts > 0 and table.concat(parts, ", ") or "none"))
        end
        NPCS.reconcileFamilyOffSpotlight(0.35, { force = true })
    end
    return allOk
end

--- Step Five (b): despawn every instance with no stage / seat / Scatter target (intent `none`),
--- except Dashboard prewarm spawns still waiting for their image.
--- @param intent table
local function reconcileStepFiveDespawnUntargeted(intent)
    for name, _ in pairs(U.clone(getInstances())) do
        local ci = intent.byCharacter[name]
        if (U.Type(ci) ~= "table" or ci.target == "none") and prewarmHoldCount[name] == nil then
            despawnNpcInstance(name)
        end
    end
end

--- Unified NPC reconcile orchestrator (Steps Zero–Five). See `.dev/NPC Object Spawning & Spotlighting/NPC Reconciler Procedure.md`.
--- @param opts table|nil `{ deferUiRefresh?, force?, onlySteps?, reason?, animateStageMoves? }`
function NPCS.reconcileAllFromState(opts)
    opts = U.Type(opts) == "table" and opts or {}
    local deferUiRefresh = opts.deferUiRefresh == true
    local force = opts.force == true

    local fp = npcReconcileFingerprint()
    if not force and fp == lastNpcReconcileFingerprint then
        --- Tail reconcilers with own fingerprint gates — same as full path end (TOR-178 / TOR-201).
        --- Skipping these violated sync contract when homeland cache was invalidated alone.
        reconcileNpcHomelandSeatSpotlightsWhenStageBound()
        require("core.stage_tokens").reconcileFromState()
        require("lib.sync_trace").report("NPCS.reconcileAllFromState", {
            force = "false",
            reason = tostring(opts.reason or ""),
            outcome = "skipped",
        })
        return
    end

    if force then
        lastHomelandStageBoundSpotlightsFingerprint = nil
    end

    local intent = resolveNpcPlacementIntent()
    local allOk = true
    npcReconcileInProgress = true
    npcSeatWorkThisPass = false

    if reconcileStepEnabled(opts, 1) then
        if not reconcileStepOneAreaRemovals(intent) then
            allOk = false
        end
    end
    if reconcileStepEnabled(opts, 2) then
        if not reconcileStepTwoSeatRemovals(intent) then
            allOk = false
        end
    end
    if reconcileStepEnabled(opts, 3) then
        if not reconcileStepThreeSeatPlacements(intent, force) then
            allOk = false
        end
    end
    if reconcileStepEnabled(opts, 4) then
        reconcileSeatNarrativePresenceFromIntent(intent)
    end
    if reconcileStepEnabled(opts, 5) then
        if not reconcileStepFiveStagePlacements(intent, opts) then
            allOk = false
        end
        reconcileStepFiveDespawnUntargeted(intent)
    end

    npcReconcileInProgress = false

    if allOk then
        lastNpcReconcileFingerprint = fp
    else
        print("[NPCS] reconcileAllFromState incomplete; fingerprint not committed (will retry on next Sync.full)")
    end

    require("core.stage_tokens").reconcileFromState({ force = force })
    require("lib.sync_trace").report("NPCS.reconcileAllFromState", {
        force = tostring(force),
        reason = tostring(opts.reason or ""),
        outcome = "ran",
    })
end

--- Read-only placement intent for debug/tests.
--- @return table
function NPCS.resolveNpcPlacementIntent()
    return resolveNpcPlacementIntent()
end

--- One-shot layout context for rotational seat layout during orchestrated reconcile.
--- @return table|nil
function NPCS.getReconcileLayoutContext()
    return npcReconcileLayoutContext
end

--- True while `NPCS.reconcileAllFromState` is running (layout/light deferral for stage-bound homelands).
--- @return boolean
function NPCS.isReconcileOrchestratorInProgress()
    return npcReconcileInProgress
end

--- @param npcName string
--- @return boolean
function NPCS.isSpotlightHeld(npcName)
    return spotlightHeld[npcName] == true
end

--- @param npcName string
--- @return boolean
function NPCS.isFamilyOffSpotlight(npcName)
    return familyOffSpotlight[npcName] == true or familyOffSpotlightPreview[npcName] == true
end

--- Temporary figurine override for `buildResolvedLightModeTable` during stage lerp bake.
--- @param npcName string
--- @param fig Object|nil
function NPCS.setLightAlignFigOverride(npcName, fig)
    if fig == nil or not U.isGameObject(fig) then
        lightAlignFigOverride[npcName] = nil
    else
        lightAlignFigOverride[npcName] = fig
    end
end

--- Apply stage presentation + spotlight reconcile after TOR-173 lerp (figurine pose already at target).
--- @param npcName string
--- @param transitionTime number|nil
function NPCS.finalizeStageLerpWorld(npcName, transitionTime)
    if U.Type(npcName) ~= "string" or npcName == "" then
        return
    end
    local rec = getInstances()[npcName]
    if U.Type(rec) ~= "table" then
        return
    end
    local fig = G.getObject(rec.figurineGuid or "")
    local lit = G.getObject(rec.lightGuid or "")
    if not U.isGameObject(fig) then
        return
    end
    applyNpcPairPhysicalPresentation(fig, lit, STAGE_BOARD_AREA_KEY, npcName)
    applyStageNpcSpotlightNow(npcName, fig, lit, transitionTime)
    deferNpcSpotlightAlignedToFigurine(npcName, fig, lit, transitionTime or 0)
end

--- Commit stage placement + light mode to state without moving world objects (TOR-173 lerp prep).
--- @param npcName string
--- @param placement table
--- @return boolean
function NPCS.commitStagePlacementState(npcName, placement)
    if type(placement) ~= "table" then
        return false
    end
    local rec = getInstances()[npcName]
    if rec == nil then
        return false
    end
    local desiredMode = normalizedStageNpcLightMode(placement)
    rec.areaKey = STAGE_BOARD_AREA_KEY
    rec.slotIndex = 0
    local Gameboard = require("core.npc_gameboard")
    local derivedYaw = 0
    if type(Gameboard.placementBoardRelYawDeg) == "function" then
        derivedYaw = Gameboard.placementBoardRelYawDeg(placement.u, placement.v)
    end
    rec.stagePlacement = {
        u = tonumber(placement.u),
        v = tonumber(placement.v),
        yaw = derivedYaw,
        groundLevel = tonumber(placement.groundLevel),
    }
    rec.npcLightMode = desiredMode
    setInstanceRecord(npcName, rec)
    syncStageNpcLightState(npcName, desiredMode)
    return true
end

--- Move an NPC to a gameboard stage placement, spawning its figurine + light first when needed.
--- @param npcName string
--- @param placement table `{ u, v, yaw?, npcLightMode? }`
--- @param opts table|nil
--- @return boolean, string|nil
function NPCS.moveNpcToStagePlacement(npcName, placement, opts)
    opts = U.Type(opts) == "table" and opts or {}
    local skipSeatSync = opts.skipSeatSync == true
    if type(placement) ~= "table" then
        return false, "Invalid stage placement."
    end
    local rec = ensureLiveNpcInstance(npcName)
    if isNpcLocked(rec) then
        return false, "NPC is locked in place. Unlock before moving."
    end
    local didUnseat = false
    if U.Type(rec.seatedSeatKey) == "string" and isValidNpcSeatKey(rec.seatedSeatKey) then
        local seatFig = G.getObject(rec.figurineGuid or "")
        if seatFig ~= nil then
            clearNpcFigurineSeatIdentity(seatFig, npcName)
        end
        rec.seatedSeatKey = nil
        setInstanceRecord(npcName, rec)
        didUnseat = true
    elseif figurineHasAnySeatTag(G.getObject(rec.figurineGuid or "")) then
        clearNpcFigurineSeatIdentity(G.getObject(rec.figurineGuid), npcName)
        didUnseat = true
    end
    ensureNpcLight(npcName)
    rec = getInstances()[npcName]
    local fig = G.getObject(rec.figurineGuid or "")
    local lit = G.getObject(rec.lightGuid or "")
    local desiredMode = normalizedStageNpcLightMode(placement)
    if opts.force ~= true
        and rec.areaKey == STAGE_BOARD_AREA_KEY
        and stagePlacementMatchesRecord(rec.stagePlacement, placement)
    then
        if rec.npcLightMode == desiredMode then
            return true, nil
        end
        rec.npcLightMode = desiredMode
        setInstanceRecord(npcName, rec)
        applyStageNpcSpotlightNow(npcName, fig, lit, 0)
        deferNpcSpotlightAlignedToFigurine(npcName, fig, lit, 0)
        return true, nil
    end
    NPCS.applyFigurinePlacementAtWorld(fig, placement)
    rec.areaKey = STAGE_BOARD_AREA_KEY
    rec.slotIndex = 0
    local Gameboard = require("core.npc_gameboard")
    local derivedYaw = 0
    if type(Gameboard.placementBoardRelYawDeg) == "function" then
        derivedYaw = Gameboard.placementBoardRelYawDeg(placement.u, placement.v)
    end
    rec.stagePlacement = {
        u = tonumber(placement.u),
        v = tonumber(placement.v),
        yaw = derivedYaw,
        groundLevel = tonumber(placement.groundLevel),
    }
    rec.npcLightMode = desiredMode
    setInstanceRecord(npcName, rec)
    applyNpcPairPhysicalPresentation(fig, lit, STAGE_BOARD_AREA_KEY, npcName)
    applyStageNpcSpotlightNow(npcName, fig, lit, 0)
    deferNpcSpotlightAlignedToFigurine(npcName, fig, lit, 0)
    if didUnseat and not skipSeatSync then
        requestSeatLayoutSync()
    end
    return true, nil
end

--- Single-NPC stage lerp entry (Apply-only eligibility); batch path uses `NPCStageLerp.runQueued`.
--- @param npcName string
--- @param placement table
--- @param opts table|nil `{ reason?, animateStageMoves? }`
--- @return boolean, string|nil
function NPCS.moveNpcToStagePlacementLerp(npcName, placement, opts)
    opts = U.Type(opts) == "table" and opts or {}
    local rec = getInstances()[npcName]
    local NPCStageLerp = require("core.npc_stage_lerp")
    local candidate = NPCStageLerp.evaluateCandidate(npcName, rec, placement, opts)
    if candidate == nil then
        return NPCS.moveNpcToStagePlacement(npcName, placement, opts)
    end
    NPCStageLerp.runQueued({ candidate })
    return true, nil
end

--- Destroy one NPC's figurine + light and drop its instance record (scene removal, generic delete, reset).
--- @param npcName string
--- @param opts table|nil `{ skipSeatSync? }`
function NPCS.despawnNpc(npcName, opts)
    if getInstances()[npcName] == nil then
        return
    end
    despawnNpcInstance(npcName)
    if not (U.Type(opts) == "table" and opts.skipSeatSync == true) then
        requestSeatLayoutSync()
    end
end

--- True when `npcName` has no live figurine yet, or its figurine is still a parked spawn whose image may
--- be loading (a Dashboard edit should wait on `NPCS.prewarmNpcs` before moving it).
--- @param npcName string
--- @return boolean
function NPCS.needsPrewarm(npcName)
    local rec = getInstances()[npcName]
    if U.Type(rec) ~= "table" or G.getObject(rec.figurineGuid or "") == nil then
        return true
    end
    return rec.areaKey == SPAWN_PARK_AREA_KEY
end

--- Spawn hidden figurines (and lights unless `forSeat`) for `keys` that lack a live instance, then call
--- `onReady` once every figurine image has loaded or after `NPC_PREWARM_MAX_WAIT_SEC`. Held spawns survive
--- Step Five (b) until then. `onReady` is expected to write state and reconcile; afterwards any released key
--- that ended up with no target is despawned.
--- @param keys string[]
--- @param onReady function
--- @param opts table|nil `{ forSeat? }`
function NPCS.prewarmNpcs(keys, onReady, opts)
    U.Assert("NPCS.prewarmNpcs", onReady, "function")
    local spawnOpts = { forSeat = U.Type(opts) == "table" and opts.forSeat == true }
    local figGuids = {}
    for _, key in ipairs(keys) do
        local rec = ensureLiveNpcInstance(key, spawnOpts)
        prewarmHoldCount[key] = (prewarmHoldCount[key] or 0) + 1
        table.insert(figGuids, rec.figurineGuid)
    end
    local deadline = os.time() + NPC_PREWARM_MAX_WAIT_SEC
    local timedOut = false
    U.chain({
        function()
            return function()
                if os.time() >= deadline then
                    timedOut = true
                    return true
                end
                for _, guid in ipairs(figGuids) do
                    local fig = G.getObject(guid)
                    if fig ~= nil and not NpcSpawn.figurineLoaded(fig) then
                        return false
                    end
                end
                return true
            end
        end,
        function()
            for _, key in ipairs(keys) do
                local n = (prewarmHoldCount[key] or 1) - 1
                prewarmHoldCount[key] = n > 0 and n or nil
            end
            if timedOut then
                print("[NPCS] Prewarm: figurine images still loading after " .. NPC_PREWARM_MAX_WAIT_SEC
                    .. "s (" .. table.concat(keys, ", ") .. "); applying anyway.")
            end
            onReady()
            local intent = resolveNpcPlacementIntent()
            for _, key in ipairs(keys) do
                local ci = intent.byCharacter[key]
                if prewarmHoldCount[key] == nil and getInstances()[key] ~= nil
                    and (U.Type(ci) ~= "table" or ci.target == "none") then
                    despawnNpcInstance(key)
                end
            end
        end,
    }, { maxWait = NPC_PREWARM_MAX_WAIT_SEC + 5 })
end

function NPCS.destroyAllWorldAndState()
    for _, name in ipairs(U.getKeys(getInstances())) do
        despawnNpcInstance(name)
    end
    setAllInstances({})
    local lights = U.clone(S.getStateVal("lights") or {})
    for k, _ in pairs(lights) do
        if U.Type(k) == "string" and string.sub(k, 1, 9) == "npcLight_" then
            lights[k] = nil
        end
    end
    S.setStateVal(lights, "lights")
    requestSeatLayoutSync()
end

--- @param npcName string
function NPCS.toggleOffStandard(npcName)
    local rec = getInstances()[npcName]
    if rec == nil then
        return
    end
    if rec.npcLightMode == "OFF" then
        rec.npcLightMode = "STANDARD"
    else
        rec.npcLightMode = "OFF"
    end
    setInstanceRecord(npcName, rec)
    -- Instant transition avoids overlapping coroutine sequences stomping enable/intensity.
    NPCS.applyCurrentLightMode(npcName, 0)
end

--- @param npcName string
function NPCS.spotlightPress(npcName)
    spotlightHeld[npcName] = true
    NPCS.applyCurrentLightMode(npcName, 0)
end

--- @param npcName string
function NPCS.spotlightRelease(npcName)
    spotlightHeld[npcName] = nil
    NPCS.applyCurrentLightMode(npcName, 0)
end

--- @param rec table|nil
--- @return boolean
--- Storyteller "pin in place" for script-driven stage moves. Independent of TTS `setLock` (always on).
isNpcLocked = function(rec)
    if U.Type(rec) ~= "table" then
        return false
    end
    return rec.locked == true or tostring(rec.locked) == "true"
end

--- Narrative presence for an NPC table seat (`seatSlots.isPresent` wins over `seatPresent`).
--- @param seatKey string
--- @return boolean
function NPCS.resolveSeatNarrativePresence(seatKey)
    if not isValidNpcSeatKey(seatKey) then
        return true
    end
    return resolveSeatPresenceForSeat(seatKey)
end

--- Writes `seatSlots.isPresent` and mirrored `seatPresent` for any seat key (NPC seat or PC color).
--- Caller validates the seat key; this is the shared mutation used by NPC + PC presence setters.
--- @param seatKey string
--- @param present boolean
local function writeSeatNarrativePresence(seatKey, present)
    local wasPresent = resolveSeatPresenceForSeat(seatKey)
    local ss = S.getStateVal("sessionScene", "seatSlots")
    if U.Type(ss) ~= "table" then
        ss = {}
    end
    local row = ss[seatKey]
    if U.Type(row) ~= "table" then
        row = {}
    else
        row = U.clone(row, true)
    end
    row.isPresent = present == true
    ss = U.clone(ss, true)
    ss[seatKey] = row
    S.setStateVal(ss, "sessionScene", "seatSlots")

    local sp = S.getStateVal("sessionScene", "seatPresent")
    if U.Type(sp) ~= "table" then
        sp = {}
    end
    sp = U.clone(sp, true)
    sp[seatKey] = present == true
    S.setStateVal(sp, "sessionScene", "seatPresent")
    if U.isIn(seatKey, C.PlayerColors or {}) then
        MapPins.onSeatPresenceChanged(seatKey, wasPresent, present == true)
    end
    local SceneLibrary = require("core.scene_library")
    if type(SceneLibrary.mirrorActiveLibrarySessionSceneFromLiveIfLinked) == "function" then
        SceneLibrary.mirrorActiveLibrarySessionSceneFromLiveIfLinked()
    end
end

--- Writes `seatSlots.isPresent` and mirrored `seatPresent` for one NPC seat.
--- @param seatKey string
--- @param present boolean
--- @return boolean
function NPCS.setNpcSeatNarrativePresence(seatKey, present)
    if not isValidNpcSeatKey(seatKey) then
        return false
    end
    writeSeatNarrativePresence(seatKey, present)
    return true
end

--- Narrative presence for a PC seat (player color). Same `seatSlots`/`seatPresent` slice as NPC seats.
--- @param color string player color in `C.PlayerColors`
--- @return boolean
function NPCS.resolvePlayerSeatPresence(color)
    if not U.isIn(color, C.PlayerColors or {}) then
        return true
    end
    return resolveSeatPresenceForSeat(color)
end

--- Set a PC seat's narrative presence (TOR-236).
--- @param color string player color in `C.PlayerColors`
--- @param present boolean
--- @return boolean
function NPCS.setPlayerSeatPresence(color, present)
    if not U.isIn(color, C.PlayerColors or {}) then
        return false
    end
    writeSeatNarrativePresence(color, present)
    return true
end

--- Sanitize `npcs.instances`, register spotlights, and repair seated NPC rows from saved state.
--- Call after `S.InitializeGameState`, before `L.InitLights`. Orphan `gameState.lights` keys are pruned by `L.cleanupLightsState`.
--- Seated NPCs have no paired light (`lightGuid` nil); stage / Scatter rows carry both GUIDs.
--- IMPORTANT: Never drop instance rows when `G.getObject` is nil on the first onLoad frame — objects can
--- appear slightly later; dropping them removed all NPC state and made Storyteller buttons no-ops.
--- The reconciler respawns a pair whose figurine is gone when the NPC still has a stage / seat target.
function NPCS.registerRestoredInstancesFromState()
    local inst = getInstances()
    local cleaned = {}
    for name, rec in pairs(inst) do
        if U.Type(rec) == "table" and U.Type(rec.figurineGuid) == "string" and rec.figurineGuid ~= "" then
            if rec.npcLightMode ~= "OFF" and rec.npcLightMode ~= "STANDARD" then
                rec.npcLightMode = "STANDARD"
            end
            if rec.locked ~= true then
                rec.locked = false
            end
            cleaned[name] = rec
            local fig = G.getObject(rec.figurineGuid)
            if fig ~= nil then
                ensureNpcFigurinePhysicsLocked(fig)
            end
            local lit = U.Type(rec.lightGuid) == "string" and G.getObject(rec.lightGuid) or nil
            if lit ~= nil then
                L.ensureSpotlightObjectTag(lit)
                L.registerNpcSpotlightModes(name, rec.lightGuid)
            end
        end
    end
    setAllInstances(cleaned)
    local occupied = getOccupiedNpcSeatMap()
    for _, seatKey in ipairs(C.NPCSeats or {}) do
        local occupant = occupied[seatKey]
        if U.Type(occupant) == "string" and occupant ~= "" then
            ---@cast occupant string
            local seatRec = getInstances()[occupant]
            if U.Type(seatRec) == "table" then
                seatRec.seatedSeatKey = seatKey
                setInstanceRecord(occupant, seatRec)
                local fig = G.getObject(seatRec.figurineGuid or "")
                if fig ~= nil then
                    local pOk, pErr = prepareNpcFigurineForSeat(fig, occupant, seatKey)
                    if not pOk then
                        print("[NPCS] restore seat placement failed for "
                            .. tostring(occupant)
                            .. " / "
                            .. tostring(seatKey)
                            .. ": "
                            .. tostring(pErr))
                    end
                end
            end
        end
    end
    requestSeatLayoutSync()
end

--- Save/load bootstrap entry point: generic roster from membership, then instance registration.
function NPCS.restoreAfterStateLoad()
    local GenericNpcs = require("core.generic_npcs")
    GenericNpcs.registerFromMembership()
    NPCS.registerRestoredInstancesFromState()
end

--- Recursive stats text for Storyteller (console or UI).
--- @param npcName string
--- @param maxDepth number|nil
--- @return string
function NPCS.displayStats(npcName, maxDepth)
    maxDepth = maxDepth or 10
    local def = NPCS.characters[npcName]
    if def == nil or def.stats == nil then
        return "No stats for " .. tostring(npcName)
    end
    local lines = {}

    --- @param v any
    --- @param indent number
    --- @param depth number
    local function walk(v, indent, depth)
        if depth > maxDepth then
            table.insert(lines, string.rep("  ", indent) .. "...")
            return
        end
        local t = U.Type(v)
        if t == "table" then
            local isArray = true
            local maxn = 0
            for k, _ in pairs(v) do
                if U.Type(k) ~= "number" then
                    isArray = false
                    break
                end
                if k > maxn then
                    maxn = k
                end
            end
            if isArray and maxn > 0 then
                for i = 1, maxn do
                    if v[i] ~= nil then
                        walk(v[i], indent, depth + 1)
                    end
                end
            else
                for k, val in pairs(v) do
                    table.insert(lines, string.rep("  ", indent) .. tostring(k) .. ":")
                    walk(val, indent + 1, depth + 1)
                end
            end
        elseif t == "string" or t == "number" or t == "boolean" then
            table.insert(lines, string.rep("  ", indent) .. tostring(v))
        else
            table.insert(lines, string.rep("  ", indent) .. "(" .. t .. ")")
        end
    end

    table.insert(lines, (def.fullName or npcName) .. " — stats")
    walk(def.stats, 0, 0)
    return table.concat(lines, "\n")
end

--- Runtime-only roster entry for generic NPCs (TOR-560). Spawned on demand like named NPCs.
--- @param characterKey string
--- @param displayName string
function NPCS.registerGenericCharacter(characterKey, displayName)
    if not validateNpcNameKey(characterKey) then
        error("[NPCS] registerGenericCharacter: invalid key " .. tostring(characterKey), 2)
    end
    if U.Type(displayName) ~= "string" or displayName == "" then
        displayName = characterKey
    end
    NPCS.characters[characterKey] = {
        name = characterKey,
        fullName = displayName,
        -- Card Scale (ImageScalar); matches named NPC default in npcs_data. Per-key overrides later.
        figurine = { scale = 53 },
        isGeneric = true,
    }
end

--- @param characterKey string
function NPCS.unregisterGenericCharacter(characterKey)
    if U.Type(characterKey) ~= "string" or characterKey == "" then
        return
    end
    local def = NPCS.characters[characterKey]
    if type(def) == "table" and def.isGeneric == true then
        NPCS.characters[characterKey] = nil
    end
end

--- @param characterKey string|nil
--- @return boolean
function NPCS.isGenericCharacter(characterKey)
    if U.Type(characterKey) ~= "string" then
        return false
    end
    local def = NPCS.characters[characterKey]
    return type(def) == "table" and def.isGeneric == true
end

return NPCS