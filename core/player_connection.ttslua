--[[
  Connection-driven seat occupancy (TOR-293). Canonical model:
  docs/solutions/seat-occupancy-and-connection.md

  Connection is the only authority for `seatSlots[color].absentFromSession` (not connected).
  - Connect (incl. late join, load): clear the flag and seat the PC at once.
  - Mid-session disconnect: darken the seat only (effective presence false).
  - Connection checkpoint (under blindfold cover / load): a PC still disconnected becomes an
    unoccupied seat — no chair, satellites parked, control token stashed beneath the board.

  Debug connection mode (`debug.assumeConnected`): "Assume Connected" reads per-seat
  `debug.simulatedConnection[color]` (default connected) instead of Steam.
]]

local PC = {}

local S = require("core.state")
local C = require("lib.constants")
local U = require("lib.util")

--- True in the Debug panel's "Assume Connected" mode; false in "By Connection Status".
--- @return boolean
function PC.isAssumeConnectedMode()
  return S.getStateVal("debug", "assumeConnected") == true
end

--- @param on boolean
function PC.setAssumeConnectedMode(on)
  S.setStateVal(on == true, "debug", "assumeConnected")
end

--- Simulated connection for a PC seat in Assume Connected mode (default connected).
--- @param color string
--- @return boolean
function PC.isSimulatedConnected(color)
  local map = S.getStateVal("debug", "simulatedConnection")
  return not (U.Type(map) == "table" and map[color] == false)
end

--- @param color string
--- @param connected boolean
function PC.setSimulatedConnected(color, connected)
  local map = S.getStateVal("debug", "simulatedConnection")
  if U.Type(map) ~= "table" then
    map = {}
    S.setStateVal(map, "debug", "simulatedConnection")
  end
  if connected == true then
    map[color] = nil
  else
    map[color] = false
  end
end

--- Steam id mapped to this PC seat color in `C.PlayerData`, or nil if not a chronicle seat.
--- @param color string
--- @return string|nil
function PC.steamIdForSeatColor(color)
  if type(color) ~= "string" or color == "" then
    return nil
  end
  if type(C.PlayerData) ~= "table" then
    return nil
  end
  for steamId, row in pairs(C.PlayerData) do
    if type(steamId) == "string" and type(row) == "table" and row.color == color then
      return steamId
    end
  end
  return nil
end

--- True when a Player with this Steam id is connected (any seat color).
--- @param steamId string
--- @return boolean
local function isSteamIdConnected(steamId)
  if type(steamId) ~= "string" or steamId == "" then
    return false
  end
  for _, player in ipairs(Player.getPlayers()) do
    if U.isPlayer(player) and tostring(player.steam_id) == steamId then
      return true
    end
  end
  return false
end

--- Real Steam connection for a PC seat, ignoring the debug mode.
--- Non-chronicle PC colors → true (no Steam lock).
--- @param color string
--- @return boolean
local function isSteamSeatConnected(color)
  local steamId = PC.steamIdForSeatColor(color)
  if steamId == nil then
    return true
  end
  return isSteamIdConnected(steamId)
end

--- Connection for a PC seat under the current debug mode (ignores narrative presence).
--- @param color string
--- @return boolean
function PC.isSeatConnected(color)
  if PC.isAssumeConnectedMode() then
    return PC.isSimulatedConnected(color)
  end
  return isSteamSeatConnected(color)
end

--- Unoccupied PC seat: `absentFromSession` (not connected at a checkpoint).
--- @param color string
--- @return boolean
function PC.isSeatUnoccupied(color)
  local ss = S.getStateVal("sessionScene", "seatSlots")
  local row = U.Type(ss) == "table" and ss[color] or nil
  return U.Type(row) == "table" and row.absentFromSession == true
end

--- Narrative presence only (`seatSlots.isPresent` / `seatPresent`).
--- @param color string
--- @return boolean
function PC.narrativePcSeatPresent(color)
  if type(color) ~= "string" or color == "" then
    return false
  end
  local ss = S.getStateVal("sessionScene", "seatSlots")
  if U.Type(ss) == "table" then
    local row = ss[color]
    if U.Type(row) == "table" and row.isPresent ~= nil then
      return row.isPresent ~= false
    end
  end
  local sp = S.getStateVal("sessionScene", "seatPresent")
  if U.Type(sp) == "table" and sp[color] ~= nil then
    return sp[color] ~= false
  end
  return true
end

--- Effective PC presence (seat lit): narrative AND connected. Does not write `isPresent`.
--- @param color string
--- @return boolean
function PC.effectivePcSeatPresent(color)
  if not PC.narrativePcSeatPresent(color) then
    return false
  end
  return PC.isSeatConnected(color)
end

--- Resolve chronicle PC color from a disconnected/connecting Player.
--- @param player Player|nil
--- @return string|nil
function PC.chronicleSeatColorForPlayer(player)
  if not U.isPlayer(player) then
    return nil
  end
  local steamId = tostring(player.steam_id or "")
  if steamId == "" then
    return nil
  end
  local row = C.PlayerData and C.PlayerData[steamId]
  if type(row) ~= "table" or type(row.color) ~= "string" then
    return nil
  end
  if not U.isIn(row.color, C.PlayerColors or {}) then
    return nil
  end
  return row.color
end

--- Reconcile world from effective presence for occupied PC seats (no library write).
--- Unoccupied seats keep their parked satellites; only HUD/lights resync.
--- @param color string|nil When nil, all PC seats.
function PC.reconcileEffectivePresence(color)
  local Sync = require("core.sync")
  local O = require("core.objects")
  local colors = {}
  if type(color) == "string" and color ~= "" then
    colors[1] = color
  else
    for _, c in ipairs(C.PlayerColors or {}) do
      colors[#colors + 1] = c
    end
  end
  for _, c in ipairs(colors) do
    if not PC.isSeatUnoccupied(c) then
      O.applyPcSeatHiddenObjectPresence(c, PC.effectivePcSeatPresent(c))
    end
    Sync.player(c)
  end
end

--- Scatter: unoccupied PCs leave their group; occupied PCs without a group join an empty one.
local function syncScatterPackToOccupancy()
  local Occupancy = require("lib.scatter_occupancy")
  if not Occupancy.isScatterLayoutActive() then
    return
  end
  local pack = S.getStateVal("sessionScene", "scatterPlacements")
  if U.Type(pack) == "table" then
    Occupancy.reconcilePcConnectionInPack(pack, S.getStateVal("sessionScene", "seatSlots"))
  end
end

--- Re-lay the table (or Scatter groups) and mirror control tokens after occupancy changed.
local function relayoutAfterOccupancyChange()
  S.validateState()
  syncScatterPackToOccupancy()
  local RSL = require("lib.rotational-seat-layout")
  RSL.invalidateLayoutSyncCache()
  RSL.SyncTable(nil, { force = true })
  local Gameboard = require("core.npc_gameboard")
  Gameboard.reconcileControlBoardFromState({ force = true, forceTokenMirror = true })
end

--- Seat a PC who is (or simulates being) connected: unoccupied → occupied at once, no blindfold.
--- Already-occupied seats only re-light.
--- @param color string
--- @param opts table|nil `{ skipRelayout = boolean }` (batch callers relayout once)
--- @return boolean relayoutNeeded
function PC.handleSeatConnected(color, opts)
  opts = opts or {}
  if not U.isIn(color, C.PlayerColors or {}) then
    return false
  end
  local seated = false
  if PC.isSeatUnoccupied(color) and PC.isSeatConnected(color) then
    local FSL = require("lib.figurine_seat_layout")
    local ok, err = FSL.seatConnectedPlayer(color)
    if not ok then
      U.AlertGM("Connection: " .. tostring(err))
      return false
    end
    seated = true
  end
  if seated and opts.skipRelayout ~= true then
    relayoutAfterOccupancyChange()
  end
  if opts.skipRelayout ~= true then
    PC.reconcileEffectivePresence(color)
  end
  return seated
end

--- Mid-session disconnect: darken the seat only. The checkpoint decides unoccupied.
--- @param color string
function PC.handleSeatDisconnected(color)
  if not U.isIn(color, C.PlayerColors or {}) then
    return
  end
  PC.reconcileEffectivePresence(color)
end

--- State only: every occupied PC seat that is not connected becomes unoccupied.
--- @return string[] colors newly unoccupied
local function markDisconnectedSeatsUnoccupied()
  local FSL = require("lib.figurine_seat_layout")
  local changed = {}
  for _, color in ipairs(C.PlayerColors or {}) do
    if not PC.isSeatUnoccupied(color) and not PC.isSeatConnected(color) then
      FSL.markPlayerDisconnected(color)
      changed[#changed + 1] = color
    end
  end
  return changed
end

--- Connection checkpoint (under blindfold cover): every occupied PC seat that is not connected
--- becomes unoccupied (`absentFromSession`, no chair, satellites parked, token stashed).
--- @return string[] colors newly unoccupied
function PC.applyConnectionCheckpoint()
  local FSL = require("lib.figurine_seat_layout")
  local changed = markDisconnectedSeatsUnoccupied()
  if #changed == 0 then
    return changed
  end
  for i = 1, #changed do
    FSL.setOccupantPileVisible(changed[i], false)
  end
  relayoutAfterOccupancyChange()
  for i = 1, #changed do
    require("core.sync").player(changed[i])
  end
  return changed
end

--- Run a connection-source change (debug mode switch, simulated toggle) and fire the same
--- handlers a real connect / disconnect would: newly connected seats are seated at once
--- (one relayout for the batch), newly disconnected seats only darken.
--- @param mutate fun()
local function applyConnectionSourceChange(mutate)
  local before = {}
  for _, color in ipairs(C.PlayerColors or {}) do
    before[color] = PC.isSeatConnected(color)
  end
  mutate()
  local seatedAny = false
  for _, color in ipairs(C.PlayerColors or {}) do
    if PC.isSeatConnected(color) and before[color] ~= true then
      if PC.handleSeatConnected(color, { skipRelayout = true }) then
        seatedAny = true
      end
    end
  end
  if seatedAny then
    relayoutAfterOccupancyChange()
  end
  PC.reconcileEffectivePresence(nil)
end

--- Debug panel: switch between "Assume Connected" and "By Connection Status".
--- @param on boolean true = Assume Connected
function PC.switchAssumeConnectedMode(on)
  applyConnectionSourceChange(function()
    PC.setAssumeConnectedMode(on)
  end)
end

--- PCs panel (Assume Connected only): simulate one PC connecting or disconnecting.
--- @param color string
--- @param connected boolean
--- @return boolean false when not in Assume Connected mode (no-op)
function PC.simulateSeatConnection(color, connected)
  if not PC.isAssumeConnectedMode() then
    return false
  end
  applyConnectionSourceChange(function()
    PC.setSimulatedConnected(color, connected)
  end)
  return true
end

--- Session start (load), state only — the startup table sync lays out chairs and parks
--- unoccupied piles, and startup Sync/board reconcile mirror tokens. Checkpoint, then seat
--- everyone connected.
function PC.applySessionStartOccupancyState()
  markDisconnectedSeatsUnoccupied()
  local FSL = require("lib.figurine_seat_layout")
  for _, color in ipairs(C.PlayerColors or {}) do
    if PC.isSeatUnoccupied(color) and PC.isSeatConnected(color) then
      local ok, err = FSL.seatConnectedPlayer(color)
      if not ok then
        U.AlertGM("Connection: " .. tostring(err))
      end
    end
  end
  S.validateState()
  syncScatterPackToOccupancy()
end

return PC
