--[[
    Stage map facade (TOR-423 / TOR-687).

    Stage placements live in `gameState.sessionScene.npcWorld.placements` as u,v on the stage map; the
    Storyteller Dashboard writes them (`core.npc_stage_apply`). This facade re-exports the u,v maths
    (`core.npc_gameboard_board`, `core.npc_gameboard_snaps`) and the spotlight hold hotkey.
]]

local Gameboard = {}

local Board = require("core.npc_gameboard_board")
local Snaps = require("core.npc_gameboard_snaps")
local Spotlight = require("core.npc_gameboard_spotlight")

Gameboard.worldFromUv = Board.worldFromUv
Gameboard.stageFigurineWorldYawDeg = Board.stageFigurineWorldYawDeg

Gameboard.groundLevelForSnapUv = Snaps.groundLevelForSnapUv
Gameboard.placementBoardRelYawDeg = Snaps.placementBoardRelYawDeg
Gameboard.resolvePlacementSnapCatalogEntry = Snaps.resolvePlacementSnapCatalogEntry
Gameboard.stageLerpFamilyGroupSortKey = Snaps.stageLerpFamilyGroupSortKey
Gameboard.stageAreaGroupForPlacement = Snaps.stageAreaGroupForPlacement
Gameboard.orderFamilySnapsForAnchorSpread = Snaps.orderFamilySnapsForAnchorSpread

Gameboard.onControlBoardSpotlightHotkey = Spotlight.onControlBoardSpotlightHotkey

return Gameboard
