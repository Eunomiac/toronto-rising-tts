--[[
    Storyteller PCs panel: transient buffers + apply actions; refreshes global UI labels.
]]
---@diagnostic disable: undefined-global
local PCST = {}
local C = require("lib.constants")
local S = require("core.state")
local P = require("lib.pc_stats")
local Conditions = require("core.conditions")
local PCS = require("lib.pcs_data")
local U = require("lib.util")
local Sync = require("core.sync")
local CI = require("lib.csheet_identity")
local CSL = require("core.csheet_slices")
local HUDP = require("core.hud_player")
local XpLog = require("core.xp_log")
local PlayerConnection = require("core.player_connection")
local PanelUI = require("core.storyteller_panel_ui")

--- @type table<string, table>
local buffers = {}

--- @param color string
--- @return table
local function buf(color)
  if buffers[color] == nil then
    buffers[color] = {
      hAgg = 0,
      hSup = 0,
      wAgg = 0,
      wSup = 0,
      hum = 0,
      hunger = 0
    }
  end
  return buffers[color]
end

--- @param color string
--- @return string|nil
local function playerIdForColor(color)
  return C.GetPlayerID(color)
end

--- Last refreshed slice fingerprint per seat color and page (`CSL.compute`).
--- @type table<string, table<number, string>>
local lastSheetSliceFp = {}

--- Forget sheet slice fingerprints so the next refresh calls every page (one color, or all).
--- @param seatColor string|nil
function PCST.invalidateCharacterSheetCache(seatColor)
  if type(seatColor) == "string" then
    lastSheetSliceFp[seatColor] = nil
  else
    lastSheetSliceFp = {}
  end
end

--- Refresh the CSHEET pages for a seat color whose slice changed since the last refresh.
--- Page 3 gets `forceRebuild` when its slice changed, because its own fingerprint cannot see
--- project stake quantities.
--- @param seatColor string e.g. "Brown"
--- @param opts table|nil `{ force = true }` calls every page regardless of slice fingerprints
function PCST.refreshCharacterSheetsForColor(seatColor, opts)
  if type(seatColor) ~= "string" then
    return
  end
  local tag = CI.seatColorObjectTag(seatColor)
  if tag == nil then
    return
  end
  local force = type(opts) == "table" and opts.force == true
  local slices = CSL.compute(seatColor)
  local prev = lastSheetSliceFp[seatColor]
  local changed = {}
  local anyChanged = false
  for _, pageNum in ipairs(CSL.PAGES) do
    local now = slices ~= nil and slices[pageNum] or nil
    if force or slices == nil or prev == nil or prev[pageNum] ~= now then
      changed[pageNum] = true
      anyChanged = true
    end
  end
  lastSheetSliceFp[seatColor] = slices
  local changedList = {}
  for _, pageNum in ipairs(CSL.PAGES) do
    if changed[pageNum] then
      changedList[#changedList + 1] = tostring(pageNum)
    end
  end
  require("lib.sync_trace").report("PCST.refreshCharacterSheetsForColor", {
    color = seatColor,
    pages = anyChanged and table.concat(changedList, ",") or "none",
    outcome = anyChanged and "ran" or "skipped",
  })
  if anyChanged then
    local tagged = getObjectsWithTag(tag)
    if type(tagged) == "table" then
      for _, obj in ipairs(tagged) do
        if obj ~= nil then
          local pageNum, pageColor = CI.readPageRoleFromObject(obj)
          if type(pageColor) == "string" and changed[pageNum]
              and CI.seatColorMatchesPageRole(seatColor, pageColor) then
            if pageNum == 3 and prev ~= nil then
              obj.call("refreshFromGameState", { forceRebuild = true })
            else
              obj.call("refreshFromGameState")
            end
          end
        end
      end
    end
  end
  HUDP.reconcilePrincesCourtTrackersForPanelSeat(seatColor)
end

--- Refresh every seat's CSHEET objects (after scene/location reconcile with skipPresentation).
--- @param opts table|nil passed to `refreshCharacterSheetsForColor`
function PCST.refreshAllCharacterSheets(opts)
  for _, col in ipairs(C.PlayerColors or {}) do
    PCST.refreshCharacterSheetsForColor(col, opts)
  end
end

local function safeSetValue(elementId, text)
  UI.setValue(elementId, tostring(text))
end

--- @param elementId string
--- @param attr string
--- @param val string|number|boolean
local function safeSetAttr(elementId, attr, val)
  U.setAttribute(elementId, attr, tostring(val))
end

local CONNECTION_BTN_COLORS_ON = "#1E5A2A|#2A7038|#3A9048|rgba(0.1,0.3,0.12,0.5)"
local CONNECTION_BTN_COLORS_OFF = "#6A1E1E|#822828|#A03434|rgba(0.35,0.1,0.1,0.5)"

--- Debug panel connection-mode button: green "Assume Connected" / yellow "By Connection Status".
function PCST.refreshConnectionModeButton()
  if PlayerConnection.isAssumeConnectedMode() then
    UI.setClass("debug_connectionMode", "hud_storyteller_button toggled_active")
  else
    UI.setClass("debug_connectionMode", "hud_storyteller_button toggled_inactive")
  end
end

--- Normalize Desire text: whitespace-only → "" (TOR-97).
--- @param raw any
--- @return string
function PCST.normalizeDesire(raw)
  if type(raw) ~= "string" then
    return ""
  end
  local trimmed = string.match(raw, "^%s*(.-)%s*$") or ""
  if trimmed == "" then
    return ""
  end
  return trimmed
end

--- Full class list for page1 Desire InputField (passed to UI.setClass as the names arg).
--- Unset → "player_desire player_desire_unset"; set → "player_desire" (TOR-97).
--- @param desire string|nil
--- @return string
function PCST.desireInputClass(desire)
  if PCST.normalizeDesire(desire) == "" then
    return "player_desire player_desire_unset"
  end
  return "player_desire"
end

--- Read stored Desire for a seat (nil/missing → "").
--- @param color string
--- @return string
function PCST.getDesireForColor(color)
  local pid = playerIdForColor(color)
  if pid == nil or pid == C.StorytellerID then
    return ""
  end
  return PCST.normalizeDesire(S.getStateVal("playerData", pid, "desire"))
end

--- Persist Desire and announce the seat (`Sync.player`).
--- @param color string
--- @param rawText any
--- @param opts table|nil `{ refreshSheets = false }` — typing in the CSHEET Desire field: that page
---   already shows the text, so only the ST row repaints (no per-keystroke seat announce)
--- @return string normalized desire
function PCST.setDesireForColor(color, rawText, opts)
  local pid = playerIdForColor(color)
  if pid == nil or pid == C.StorytellerID then
    return ""
  end
  local desire = PCST.normalizeDesire(rawText)
  S.setStateVal(desire, "playerData", pid, "desire")
  if type(opts) == "table" and opts.refreshSheets == false then
    PCST.refreshRow(color)
  else
    Sync.player(color)
  end
  return desire
end

--- Chronicle character display name for a seat (PlayerData.charName or PCS.name).
--- @param pid string|nil
--- @return string
local function characterFullNameForPlayerId(pid)
  if type(pid) ~= "string" or pid == "" or pid == C.StorytellerID then
    return ""
  end
  local row = C.PlayerData[pid]
  if type(row) ~= "table" then
    return ""
  end
  local cn = row.charName
  if type(cn) == "string" and cn ~= "" then
    return cn
  end
  local ck = row.charKey
  if type(ck) == "string" and ck ~= "" then
    local pc = PCS.getPC(ck)
    if type(pc) == "table" and type(pc.name) == "string" and pc.name ~= "" then
      return pc.name
    end
  end
  return ""
end

--- Refresh labels for one PC row from state + buffers. No-op while the PCs panel is hidden;
--- opening the panel repaints every row.
--- @param color string
function PCST.refreshRow(color)
  if not PanelUI.isPanelVisible("pcs") then
    require("lib.sync_trace").report("PCST.refreshRow", { outcome = "skipped", reason = "hidden" })
    return
  end
  local pid = playerIdForColor(color)
  local charFull = characterFullNameForPlayerId(pid)
  safeSetValue("pcs_charFullName_" .. color, charFull ~= "" and charFull or "—")

  local deferAutoSeat = S.getStateVal("connectionControls", "deferAutoSeatByColor", color) == true
  U.setAttributes("pcs_deferAutoSeat_" .. color, { isOn = deferAutoSeat })
  local deferConnect = S.getStateVal("connectionControls", "deferConnectByColor", color) == true
  U.setAttributes("pcs_deferConnect_" .. color, { isOn = deferConnect })

  local assumeConnected = PlayerConnection.isAssumeConnectedMode()
  local simulatedConnected = PlayerConnection.isSimulatedConnected(color)
  U.setAttributes("pcs_" .. color .. "_connection", {
    active = assumeConnected and "true" or "false",
    text = simulatedConnected and "Connected" or "Disconnected",
    colors = simulatedConnected and CONNECTION_BTN_COLORS_ON or CONNECTION_BTN_COLORS_OFF,
  })

  if pid == nil or pid == C.StorytellerID then
    safeSetValue("pcs_hungerDots_" .. color, "")
    safeSetValue("pcs_desire_" .. color, "—")
    safeSetAttr("pcs_" .. color .. "_frenzyToggle", "text", "—")
    safeSetAttr("pcs_" .. color .. "_blindfoldToggle", "text", "—")
    return
  end

  local b = buf(color)
  safeSetValue("pcs_hpTrack_" .. color, P.formatDamageTrackText(color, "health"))
  safeSetValue("pcs_wpTrack_" .. color, P.formatDamageTrackText(color, "willpower"))
  safeSetValue("pcs_humTrack_" .. color, P.formatHumanityTrackText(color))

  safeSetValue("pcs_xpVal_" .. color, tostring(XpLog.getCurrentXp(pid)))

  local desire = PCST.normalizeDesire(S.getStateVal("playerData", pid, "desire"))
  safeSetValue("pcs_desire_" .. color, desire ~= "" and desire or "—")

  safeSetValue("pcs_hungerDots_" .. color, P.formatHungerDotLine(color))

  local torporOn = S.getStateVal("playerData", pid, "conditions", "torpor") ~= nil
  -- Short label avoids narrow Text wrapping one character per line next to the Torpor button.
  safeSetValue("pcs_torporLabel_" .. color, torporOn and "● active" or "○ clear")

  local frenzyOn = S.getStateVal("playerData", pid, "conditions", "hudFrenzy") ~= nil
  local blindOn = S.getStateVal("playerData", pid, "conditions", "hudBlindfold") ~= nil
  safeSetAttr("pcs_" .. color .. "_frenzyToggle", "text", frenzyOn and "Frenzy●" or "Frenzy○")
  safeSetAttr("pcs_" .. color .. "_blindfoldToggle", "text", blindOn and "Blind●" or "Blind○")

  safeSetValue("pcs_bufHPA_" .. color, string.format("%+d", b.hAgg))
  safeSetValue("pcs_bufHPS_" .. color, string.format("%+d", b.hSup))
  safeSetValue("pcs_bufWPA_" .. color, string.format("%+d", b.wAgg))
  safeSetValue("pcs_bufWPS_" .. color, string.format("%+d", b.wSup))
  safeSetValue("pcs_bufHum_" .. color, string.format("%+d", b.hum))
  safeSetValue("pcs_bufHunger_" .. color, string.format("%+d", b.hunger))
end

function PCST.refreshAllRows()
  if not PanelUI.isPanelVisible("pcs") then
    require("lib.sync_trace").report("PCST.refreshAllRows", { outcome = "skipped", reason = "hidden" })
    return
  end
  for _, col in ipairs(C.PlayerColors) do
    PCST.refreshRow(col)
  end
end

--- @param player Player|nil
--- @param _button any
--- @param id string|nil
function PCST.onHudClick(player, _button, id)
  if type(id) ~= "string" then
    return
  end
  local color, action = id:match("^pcs_(%a+)_(.+)$")
  if not color or not action then
    return
  end

  local b = buf(color)
  local pid = playerIdForColor(color)
  if pid == nil and action ~= "noop" then
    U.AlertGM("PC panel: no player for color " .. color)
    return
  end
  local announce = false

  if action == "hpAggUp" then
    b.hAgg = b.hAgg + 1
  elseif action == "hpAggDown" then
    b.hAgg = b.hAgg - 1
  elseif action == "hpSupUp" then
    b.hSup = b.hSup + 1
  elseif action == "hpSupDown" then
    b.hSup = b.hSup - 1
  elseif action == "hpApply" then
    P.applyDamageOrHeal(color, "health", b.hSup, b.hAgg)
    b.hSup = 0
    b.hAgg = 0
    announce = true
  elseif action == "wpAggUp" then
    b.wAgg = b.wAgg + 1
  elseif action == "wpAggDown" then
    b.wAgg = b.wAgg - 1
  elseif action == "wpSupUp" then
    b.wSup = b.wSup + 1
  elseif action == "wpSupDown" then
    b.wSup = b.wSup - 1
  elseif action == "wpApply" then
    P.applyDamageOrHeal(color, "willpower", b.wSup, b.wAgg)
    b.wSup = 0
    b.wAgg = 0
    announce = true
  elseif action == "humUp" then
    b.hum = b.hum + 1
  elseif action == "humDown" then
    b.hum = b.hum - 1
  elseif action == "humApply" then
    P.applyHumanityStainDelta(color, b.hum)
    b.hum = 0
    announce = true
  elseif action == "humClear" then
    P.clearHumanityStains(color)
    b.hum = 0
    announce = true
  elseif action == "humBaseUp" then
    P.applyHumanityBaseDelta(color, 1)
    announce = true
  elseif action == "humBaseDown" then
    P.applyHumanityBaseDelta(color, -1)
    announce = true
  elseif action == "xpOpen" then
    local XpModal = require("core.xp_log_modal")
    XpModal.open(color)
  elseif action == "hungerUp" then
    b.hunger = b.hunger + 1
  elseif action == "hungerDown" then
    b.hunger = b.hunger - 1
  elseif action == "hungerApply" then
    if pid then
      local cur = tonumber(S.getPlayerVal(color, "hunger")) or 0
      local nx = math.max(0, math.min(C.MAX_HUNGER or 5, cur + b.hunger))
      S.setPlayerVal(color, "hunger", nx)
    end
    b.hunger = 0
    Sync.player(color, { forceOverlays = true })
    return
  elseif action == "torporClear" then
    P.storytellerClearTorpor(color)
    announce = true
  elseif action == "frenzyToggle" then
    -- Conditions.* announce the seat themselves (Conditions.afterChange → Sync.player).
    if S.getStateVal("playerData", pid, "conditions", "hudFrenzy") ~= nil then
      Conditions.clear(pid, "hudFrenzy")
    else
      Conditions.setManual(pid, "hudFrenzy", true)
    end
    return
  elseif action == "blindfoldToggle" then
    if S.getStateVal("playerData", pid, "conditions", "hudBlindfold") ~= nil then
      Conditions.clear(pid, "hudBlindfold")
    else
      -- TOR-368: raise blindfold first; snap camera after overlay settle.
      Conditions.setManual(pid, "hudBlindfold", { variant = math.random(1, 6) })
      local Main = require("core.main")
      if type(Main.snapDefaultCamerasAfterLayout) == "function" then
        U.await(function()
          Main.snapDefaultCamerasAfterLayout(color)
        end, 1.5)
      end
    end
    return
  elseif action == "desireClear" then
    PCST.setDesireForColor(color, "")
    return
  elseif action == "autoSeat" then
    local Main = require("core.main")
    Main.manualAssignSeatForColor(color)
  elseif action == "connect" then
    local Main = require("core.main")
    Main.manualRunPlayerConnect(color)
  end

  if announce then
    Sync.player(color)
  else
    -- Buffer-only clicks (and seat / connect actions, which announce through their own flows).
    PCST.refreshRow(color)
  end
end
return PCST
