trimString = function(s)
    if type(s) ~= "string" then
        return ""
    end
    local t = string.gsub(s, "^%s+", "")
    t = string.gsub(t, "%s+$", "")
    return t
end

setAttr = function(id, attr, val)
    U.setAttribute(id, attr, tostring(val))
end

setAttrs = function(id, attrs)
    U.setAttributes(id, attrs)
end

presentDayYear = function()
    local pd = S.getStateVal("presentDayClock")
    if type(pd) ~= "table" then
        return nil
    end
    local year = tonumber(pd.year)
    if year == nil then
        return nil
    end
    return math.floor(year)
end

panelDisplay = function(entry, panelKey)
    if type(entry) ~= "table" then
        return nil
    end
    local panel = entry[panelKey]
    if type(panel) ~= "table" then
        return nil
    end
    local display = trimString(panel.display)
    if display == "" then
        return nil
    end
    return display
end

npcLabelFromSlot = function(slot)
    if type(slot) ~= "table" then
        return nil
    end
    local label = trimString(slot.label)
    if label == "" then
        return nil
    end
    return label
end

characterDisplayName = function(def, key)
    if type(def) == "table" then
        local fullName = trimString(def.fullName)
        if fullName ~= "" then
            return fullName
        end
        local name = trimString(def.name)
        if name ~= "" then
            return name
        end
    end
    return tostring(key)
end

resolveLibraryNpc = function(raw)
    local needle = trimString(raw)
    if needle == "" then
        return nil, "Enter an NPC key, or pick a name from the list."
    end
    local characters = NPCS_DATA.characters or {}
    local key = needle
    local def = characters[key]
    if type(def) ~= "table" then
        key = NPCS_DATA.resolveCharacterKeyByDisplayName(needle)
        if type(key) == "string" then
            def = characters[key]
        end
    end
    if type(def) ~= "table" then
        return nil, "No NPC matches `" .. needle .. "`."
    end
    if def.isPC == true then
        return nil, "`" .. needle .. "` is a player character, not an NPC."
    end
    return {
        key = key,
        label = characterDisplayName(def, key),
    }, nil
end

parseSpecificDate = function(raw)
    local text = trimString(raw)
    if text == "" then
        return nil
    end
    local monName, dayStr, yearStr = string.match(text, "^(%a+)%s+(%d+),%s*(%d+)$")
    if monName == nil then
        return nil
    end
    local month = MONTH_ABBR[string.lower(monName)]
    local day = tonumber(dayStr)
    local year = tonumber(yearStr)
    if month == nil or day == nil or year == nil then
        return nil
    end
    return {
        month = month,
        day = math.floor(day),
        year = math.floor(year),
    }
end

formatFullDate = function(year, month, day)
    local monthName = MONTH_NAMES[month] or ("Month " .. tostring(month))
    return monthName .. " " .. tostring(day) .. ", " .. tostring(year)
end

