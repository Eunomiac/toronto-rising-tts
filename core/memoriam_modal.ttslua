--[[
    Memoriam configuration popup (TOR-539).

    Draft lives in this module until Advance. Cancel / Main / Downtime leave the
    Play subphase unchanged. Advance prints the collected payload, then
    Phases.setPlaySubPhase(Memoriam). LUT / skybox / overlay remain TOR-101.

    Agent guidance: .dev/Phases/Phases Overview.md; C.getMemoriamSkyboxesForCharacter.
]]

local MemoriamModal = {}

local C = require("lib.constants")
local U = require("lib.util")
local S = require("core.state")
local NarrativeCalendar = require("lib.narrative_calendar")
local NPCS_DATA = require("lib.npcs_data")

local SLIDER_MAX = 1200
local MIN_PERIOD_UNITS = 10
local BAR_SLOT_COUNT = 30
local SCENE_COLUMN_COUNT = 14
local NPC_PICKER_SLOTS = 10

local PANEL_KEYS = { "panelA", "panelB", "panelC", "panelD" }
local PC_KEYS = { "lucien", "rashid", "aishe", "fomorach", "blackCaesar" }

local PC_DISPLAY = {
    lucien = "Lord Lucien",
    rashid = "Rashid Abdulrahman",
    aishe = "Aishe Tache",
    fomorach = "Fomórach",
    blackCaesar = "Black Caesar",
}

local DISPLAY_TO_KEY = {
    ["Lord Lucien"] = "lucien",
    ["Rashid Abdulrahman"] = "rashid",
    ["Aishe Tache"] = "aishe",
    ["Fomórach"] = "fomorach",
    ["Black Caesar"] = "blackCaesar",
}

local MONTH_NAMES = {
    "January", "February", "March", "April", "May", "June",
    "July", "August", "September", "October", "November", "December",
}

local MONTH_ABBR = {
    jan = 1, feb = 2, mar = 3, apr = 4, may = 5, jun = 6,
    jul = 7, aug = 8, sep = 9, oct = 10, nov = 11, dec = 12,
}

local PERIOD_COLOR_A = "#777777"
local PERIOD_COLOR_B = "#CCCCCC"
local GAP_COLOR = "#000000"
local CURRENT_PERIOD_COLOR = "#FFDD00"
local BUTTON_DEFAULT_COLOR = "#999999"
local BUTTON_HIGHLIGHT_COLOR = "#00FF00"
local BUTTON_SELECTED_COLOR = "#FFFF00"
local BUTTON_DUMMY_COLOR = "#000000"
local EMPTY_NPC_TEXT = "—"

local modalOpen = false
local subjectKey = nil
local catalogEntries = {}
local segments = {}
local sliderValue = SLIDER_MAX
local currentSegmentIndex = nil
local selectedPeriodIndex = nil
local selectedPanelKey = nil
local assignments = {}
local pickerTargetKey = nil
local npcInputDraft = ""
local pickerNpcLabels = {}
local lastRandomYear = nil
local lastRandomMonth = nil
local lastRandomDay = nil
local lastRandomSegmentIndex = nil
local dateDisplay = ""

local trimString
local setAttr
local setAttrs
local presentDayYear
local panelDisplay
local npcLabelFromSlot
local characterDisplayName
local resolveLibraryNpc
local parseSpecificDate
local formatFullDate
local resetDraft
local hidePicker
local hideConfiguration
local paintBar
local applyDateAndHighlights
local fillSceneGrid
local clearNpcAssignments
local fillPickerFromPeriod
local showNpcAssignmentRows
local configureForSubject
local mapSliderToSegment
local calendarYearInSegment
local encodePayload
local missingAdvanceReasons

trimString = function(s)
    if type(s) ~= "string" then
        return ""
    end
    local t = string.gsub(s, "^%s+", "")
    t = string.gsub(t, "%s+$", "")
    return t
end

setAttr = function(id, attr, val)
    U.setAttribute(id, attr, tostring(val))
end

setAttrs = function(id, attrs)
    U.setAttributes(id, attrs)
end

presentDayYear = function()
    local pd = S.getStateVal("presentDayClock")
    if type(pd) ~= "table" then
        return nil
    end
    local year = tonumber(pd.year)
    if year == nil then
        return nil
    end
    return math.floor(year)
end

panelDisplay = function(entry, panelKey)
    if type(entry) ~= "table" then
        return nil
    end
    local panel = entry[panelKey]
    if type(panel) ~= "table" then
        return nil
    end
    local display = trimString(panel.display)
    if display == "" then
        return nil
    end
    return display
end

npcLabelFromSlot = function(slot)
    if type(slot) ~= "table" then
        return nil
    end
    local label = trimString(slot.label)
    if label == "" then
        return nil
    end
    return label
end

characterDisplayName = function(def, key)
    if type(def) == "table" then
        local fullName = trimString(def.fullName)
        if fullName ~= "" then
            return fullName
        end
        local name = trimString(def.name)
        if name ~= "" then
            return name
        end
    end
    return tostring(key)
end

resolveLibraryNpc = function(raw)
    local needle = trimString(raw)
    if needle == "" then
        return nil, "Enter an NPC key, or pick a name from the list."
    end
    local characters = NPCS_DATA.characters or {}
    local key = needle
    local def = characters[key]
    if type(def) ~= "table" then
        key = NPCS_DATA.resolveCharacterKeyByDisplayName(needle)
        if type(key) == "string" then
            def = characters[key]
        end
    end
    if type(def) ~= "table" then
        return nil, "No NPC matches `" .. needle .. "`."
    end
    if def.isPC == true then
        return nil, "`" .. needle .. "` is a player character, not an NPC."
    end
    return {
        key = key,
        label = characterDisplayName(def, key),
    }, nil
end

parseSpecificDate = function(raw)
    local text = trimString(raw)
    if text == "" then
        return nil
    end
    local monName, dayStr, yearStr = string.match(text, "^(%a+)%s+(%d+),%s*(%d+)$")
    if monName == nil then
        return nil
    end
    local month = MONTH_ABBR[string.lower(monName)]
    local day = tonumber(dayStr)
    local year = tonumber(yearStr)
    if month == nil or day == nil or year == nil then
        return nil
    end
    return {
        month = month,
        day = math.floor(day),
        year = math.floor(year),
    }
end

formatFullDate = function(year, month, day)
    local monthName = MONTH_NAMES[month] or ("Month " .. tostring(month))
    return monthName .. " " .. tostring(day) .. ", " .. tostring(year)
end

resetDraft = function()
    subjectKey = nil
    catalogEntries = {}
    segments = {}
    sliderValue = SLIDER_MAX
    currentSegmentIndex = nil
    selectedPeriodIndex = nil
    selectedPanelKey = nil
    assignments = {}
    pickerTargetKey = nil
    npcInputDraft = ""
    pickerNpcLabels = {}
    lastRandomYear = nil
    lastRandomMonth = nil
    lastRandomDay = nil
    lastRandomSegmentIndex = nil
    dateDisplay = ""
end

hidePicker = function()
    pickerTargetKey = nil
    npcInputDraft = ""
    setAttr("memoriam_modal_npc_assignment_grid_container", "active", "false")
    setAttr("memoriam_modal_npc_assignment_input", "text", "")
end

hideConfiguration = function()
    setAttr("memoriam_modal_period_selection", "active", "false")
    setAttr("db_memoriam_scene_selection_grid", "active", "false")
    setAttr("memoriam_modal_npc_assignment", "active", "false")
    hidePicker()
end

local function snapWidthsToTotal(raw, total)
    local n = #raw
    local floors = {}
    local fracs = {}
    local sum = 0
    for i = 1, n do
        local value = raw[i]
        if value < 0 then
            value = 0
        end
        local floored = math.floor(value)
        floors[i] = floored
        fracs[i] = value - floored
        sum = sum + floored
    end
    local remain = total - sum
    local order = {}
    for i = 1, n do
        order[i] = i
    end
    if remain > 0 then
        table.sort(order, function(a, b)
            if fracs[a] ~= fracs[b] then
                return fracs[a] > fracs[b]
            end
            return a < b
        end)
        for k = 1, remain do
            local idx = order[k]
            if idx ~= nil then
                floors[idx] = floors[idx] + 1
            end
        end
    elseif remain < 0 then
        table.sort(order, function(a, b)
            if floors[a] ~= floors[b] then
                return floors[a] > floors[b]
            end
            return a < b
        end)
        local need = -remain
        local k = 1
        while need > 0 and k <= n do
            local idx = order[k]
            if floors[idx] > 0 then
                floors[idx] = floors[idx] - 1
                need = need - 1
            else
                k = k + 1
            end
        end
    end
    return floors
end

local function normalizeSegmentWidths(list)
    local totalYears = 0
    for i = 1, #list do
        totalYears = totalYears + list[i].duration
    end
    if totalYears <= 0 then
        return false, "That character's timeline has no duration to map."
    end

    local raw = {}
    for i = 1, #list do
        raw[i] = list[i].duration / totalYears * SLIDER_MAX
    end

    local deficit = 0
    for i = 1, #list do
        if list[i].kind == "period" and raw[i] < MIN_PERIOD_UNITS then
            deficit = deficit + (MIN_PERIOD_UNITS - raw[i])
            raw[i] = MIN_PERIOD_UNITS
        end
    end

    if deficit > 0 then
        local surplusTotal = 0
        for i = 1, #list do
            if list[i].kind == "period" and raw[i] > MIN_PERIOD_UNITS then
                surplusTotal = surplusTotal + (raw[i] - MIN_PERIOD_UNITS)
            end
        end
        if surplusTotal > 0 then
            local take = deficit
            if take > surplusTotal then
                take = surplusTotal
            end
            for i = 1, #list do
                if list[i].kind == "period" and raw[i] > MIN_PERIOD_UNITS then
                    local share = (raw[i] - MIN_PERIOD_UNITS) / surplusTotal * take
                    raw[i] = raw[i] - share
                end
            end
            deficit = deficit - take
        end
        if deficit > 0.01 then
            local gapTotal = 0
            for i = 1, #list do
                if list[i].kind == "gap" then
                    gapTotal = gapTotal + raw[i]
                end
            end
            if gapTotal > 0 then
                local take = deficit
                if take > gapTotal then
                    take = gapTotal
                end
                for i = 1, #list do
                    if list[i].kind == "gap" and gapTotal > 0 then
                        raw[i] = raw[i] - (raw[i] / gapTotal * take)
                    end
                end
            end
        end
    end

    local widths = snapWidthsToTotal(raw, SLIDER_MAX)
    for i = 1, #list do
        list[i].width = widths[i]
    end
    return true, nil
end

local function buildTimeline(entries, presentYear)
    local ranges = {}
    for i = 1, #entries do
        local entry = entries[i]
        local startYear = tonumber(entry.startYear)
        local endYear = tonumber(entry.endYear)
        if startYear == nil then
            return nil, "Memoriam period `" .. tostring(entry.key) .. "` is missing startYear."
        end
        startYear = math.floor(startYear)
        if endYear == nil then
            endYear = startYear
        else
            endYear = math.floor(endYear)
        end
        if endYear < startYear then
            endYear = startYear
        end
        ranges[#ranges + 1] = {
            start = startYear,
            finish = endYear + 1,
            entry = entry,
            periodIndex = i,
        }
    end

    for i = 1, #ranges - 1 do
        local a = ranges[i]
        local b = ranges[i + 1]
        if a.finish > b.start then
            local mid = (b.start + a.finish) / 2
            a.finish = mid
            b.start = mid
        end
    end

    local presentEnd = presentYear + 1
    local firstStart = ranges[1].start
    if firstStart > presentEnd then
        return nil, "That character's earliest Memoriam year is after the present-day clock."
    end

    local kept = {}
    for i = 1, #ranges do
        local r = ranges[i]
        if r.start < presentEnd then
            if r.finish > presentEnd then
                r.finish = presentEnd
            end
            if r.finish > r.start then
                kept[#kept + 1] = r
            end
        end
    end
    if #kept < 1 then
        return nil, "No Memoriam periods fall on or before the present-day clock."
    end

    local out = {}
    local cursor = kept[1].start
    local ri = 1
    while ri <= #kept do
        local r = kept[ri]
        if cursor < r.start then
            out[#out + 1] = {
                kind = "gap",
                calendarStart = cursor,
                calendarEnd = r.start,
                duration = r.start - cursor,
            }
            cursor = r.start
        end
        out[#out + 1] = {
            kind = "period",
            calendarStart = r.start,
            calendarEnd = r.finish,
            duration = r.finish - r.start,
            entry = r.entry,
            periodIndex = r.periodIndex,
            periodColorIndex = r.periodIndex,
        }
        cursor = r.finish
        ri = ri + 1
    end
    if cursor < presentEnd then
        out[#out + 1] = {
            kind = "gap",
            calendarStart = cursor,
            calendarEnd = presentEnd,
            duration = presentEnd - cursor,
        }
    end

    if #out > BAR_SLOT_COUNT then
        return nil, "This timeline needs " .. tostring(#out) .. " bar slots; only " .. tostring(BAR_SLOT_COUNT) .. " exist."
    end
    if #entries > SCENE_COLUMN_COUNT then
        return nil, "This character has " .. tostring(#entries) .. " periods; the scene grid only has " .. tostring(SCENE_COLUMN_COUNT) .. " columns."
    end

    local ok, err = normalizeSegmentWidths(out)
    if not ok then
        return nil, err
    end
    return out, nil
end

mapSliderToSegment = function(value)
    local pos = tonumber(value)
    if pos == nil then
        pos = 0
    end
    if pos < 0 then
        pos = 0
    elseif pos > SLIDER_MAX then
        pos = SLIDER_MAX
    end
    local cursor = 0
    for i = 1, #segments do
        local width = segments[i].width or 0
        local nextPos = cursor + width
        if pos < nextPos or i == #segments then
            local t = 0
            if width > 0 then
                t = (pos - cursor) / width
                if t < 0 then
                    t = 0
                elseif t > 1 then
                    t = 1
                end
            end
            return i, t, pos
        end
        cursor = nextPos
    end
    return nil, 0, pos
end

calendarYearInSegment = function(seg, t)
    local span = (seg.calendarEnd or 0) - (seg.calendarStart or 0)
    local yearFloat = (seg.calendarStart or 0) + span * (t or 0)
    local year = math.floor(yearFloat)
    local lastYear = math.floor((seg.calendarEnd or year) - 0.0001)
    if year > lastYear then
        year = lastYear
    end
    local firstYear = math.floor(seg.calendarStart or year)
    if year < firstYear then
        year = firstYear
    end
    return year
end

local function periodBaseColor(periodColorIndex)
    if (periodColorIndex % 2) == 1 then
        return PERIOD_COLOR_A
    end
    return PERIOD_COLOR_B
end

paintBar = function()
    for i = 1, BAR_SLOT_COUNT do
        local id = "memoriam_period_" .. tostring(i)
        local seg = segments[i]
        if seg == nil then
            setAttrs(id, {
                active = "false",
                minWidth = "0",
            })
        else
            local color = GAP_COLOR
            if seg.kind == "period" then
                color = periodBaseColor(seg.periodColorIndex or i)
                if currentSegmentIndex == i then
                    color = CURRENT_PERIOD_COLOR
                end
            end
            setAttrs(id, {
                active = "true",
                minWidth = tostring(seg.width or 0),
                color = color,
            })
        end
    end
end

local function sceneButtonId(periodIndex, panelKey)
    return "memoriam_period_" .. tostring(periodIndex) .. "_" .. panelKey .. "_button"
end

local function applySceneButtonState(periodIndex, panelKey, defined, label)
    local id = sceneButtonId(periodIndex, panelKey)
    if not defined then
        if panelKey == "panelC" or panelKey == "panelD" then
            setAttrs(id, {
                active = "true",
                interactable = "false",
                text = "",
                color = BUTTON_DUMMY_COLOR,
                class = "memoriam_modal_scene_selection_button",
            })
        else
            setAttrs(id, {
                active = "false",
                interactable = "false",
                text = "",
                class = "memoriam_modal_scene_selection_button",
            })
        end
        return
    end
    local isSelected = selectedPeriodIndex == periodIndex and selectedPanelKey == panelKey
    local currentSeg = currentSegmentIndex ~= nil and segments[currentSegmentIndex] or nil
    local inCurrentPeriod = currentSeg ~= nil and currentSeg.kind == "period" and currentSeg.periodIndex == periodIndex
    local className = "memoriam_modal_scene_selection_button"
    local color = BUTTON_DEFAULT_COLOR
    if isSelected then
        className = "memoriam_modal_scene_selection_button selection_button_selected"
        color = BUTTON_SELECTED_COLOR
    elseif inCurrentPeriod then
        className = "memoriam_modal_scene_selection_button selection_button_highlighted"
        color = BUTTON_HIGHLIGHT_COLOR
    end
    setAttrs(id, {
        active = "true",
        interactable = "true",
        text = label,
        color = color,
        class = className,
    })
end

fillSceneGrid = function()
    for periodIndex = 1, SCENE_COLUMN_COUNT do
        local entry = catalogEntries[periodIndex]
        if entry == nil then
            for p = 1, #PANEL_KEYS do
                local id = sceneButtonId(periodIndex, PANEL_KEYS[p])
                setAttrs(id, {
                    active = "false",
                    interactable = "false",
                    text = "",
                    class = "memoriam_modal_scene_selection_button",
                })
            end
        else
            for p = 1, #PANEL_KEYS do
                local panelKey = PANEL_KEYS[p]
                local label = panelDisplay(entry, panelKey)
                applySceneButtonState(periodIndex, panelKey, label ~= nil, label or "")
            end
        end
    end
end

applyDateAndHighlights = function()
    local segIndex, t, pos = mapSliderToSegment(sliderValue)
    sliderValue = pos
    currentSegmentIndex = segIndex
    local seg = segIndex ~= nil and segments[segIndex] or nil
    if seg == nil then
        dateDisplay = ""
        setAttr("memoriam_modal_selected_date", "text", "")
        paintBar()
        fillSceneGrid()
        return
    end

    local year = calendarYearInSegment(seg, t)
    local month
    local day
    if seg.kind == "period" and type(seg.entry) == "table" then
        local specific = parseSpecificDate(seg.entry.specificDate)
        if specific ~= nil then
            year = specific.year
            month = specific.month
            day = specific.day
            lastRandomYear = year
            lastRandomMonth = month
            lastRandomDay = day
            lastRandomSegmentIndex = segIndex
        end
    end
    if month == nil then
        if lastRandomSegmentIndex == segIndex and lastRandomYear == year and lastRandomMonth ~= nil and lastRandomDay ~= nil then
            month = lastRandomMonth
            day = lastRandomDay
        else
            month = math.random(1, 12)
            local dim = NarrativeCalendar.daysInMonth(year, month)
            day = math.random(1, dim)
            lastRandomYear = year
            lastRandomMonth = month
            lastRandomDay = day
            lastRandomSegmentIndex = segIndex
        end
    end
    dateDisplay = formatFullDate(year, month, day)
    setAttr("memoriam_modal_selected_date", "text", dateDisplay)
    paintBar()
    fillSceneGrid()
end

clearNpcAssignments = function()
    assignments = {}
    for i = 1, #PC_KEYS do
        local key = PC_KEYS[i]
        setAttr("memoriam_modal_npc_assignment_" .. key .. "_npc_name", "text", EMPTY_NPC_TEXT)
    end
    hidePicker()
end

fillPickerFromPeriod = function(periodIndex)
    pickerNpcLabels = {}
    local entry = catalogEntries[periodIndex]
    local npcs = type(entry) == "table" and entry.npcs or nil
    local filled = 0
    if type(npcs) == "table" then
        for i = 1, #npcs do
            local label = npcLabelFromSlot(npcs[i])
            if label ~= nil then
                filled = filled + 1
                if filled <= NPC_PICKER_SLOTS then
                    pickerNpcLabels[filled] = label
                end
            end
        end
    end
    for slot = 1, NPC_PICKER_SLOTS do
        local id = "memoriam_modal_npc_assignment_memoriamNPC_" .. tostring(slot)
        local label = pickerNpcLabels[slot]
        if label == nil then
            setAttrs(id, {
                active = "false",
                text = "",
            })
        else
            setAttrs(id, {
                active = "true",
                text = label,
            })
        end
    end
end

showNpcAssignmentRows = function()
    setAttr("memoriam_modal_npc_assignment", "active", "true")
    for i = 1, #PC_KEYS do
        local key = PC_KEYS[i]
        local rowId = "memoriam_modal_npc_assignment_" .. key
        if key == subjectKey then
            setAttr(rowId, "active", "false")
        else
            setAttr(rowId, "active", "true")
        end
    end
end

configureForSubject = function(characterKey)
    local presentYear = presentDayYear()
    if presentYear == nil then
        U.AlertGM("Set the present-day clock before configuring Memoriam.")
        hideConfiguration()
        return
    end
    local entries = C.getMemoriamSkyboxesForCharacter(characterKey)
    if type(entries) ~= "table" or #entries < 1 then
        U.AlertGM("No Memoriam periods are defined for that character.")
        hideConfiguration()
        return
    end
    local built, err = buildTimeline(entries, presentYear)
    if built == nil then
        U.AlertGM(err or "Could not build that character's Memoriam timeline.")
        hideConfiguration()
        return
    end

    subjectKey = characterKey
    catalogEntries = entries
    segments = built
    selectedPeriodIndex = nil
    selectedPanelKey = nil
    sliderValue = SLIDER_MAX
    lastRandomYear = nil
    lastRandomMonth = nil
    lastRandomDay = nil
    lastRandomSegmentIndex = nil
    clearNpcAssignments()

    setAttr("memoriam_modal_period_selection", "active", "true")
    setAttr("db_memoriam_scene_selection_grid", "active", "true")
    setAttr("memoriam_modal_npc_assignment", "active", "false")
    setAttr("memoriam_modal_period_selection_slider", "value", tostring(SLIDER_MAX))
    applyDateAndHighlights()
end

encodePayload = function(payload)
    if JSON ~= nil and type(JSON.encode) == "function" then
        return JSON.encode(payload)
    end
    return tostring(payload.subjectKey)
end

missingAdvanceReasons = function()
    local missing = {}
    if subjectKey == nil or subjectKey == "" then
        missing[#missing + 1] = "a character"
    end
    local seg = currentSegmentIndex ~= nil and segments[currentSegmentIndex] or nil
    if seg == nil or seg.kind ~= "period" then
        missing[#missing + 1] = "a time period (move the slider out of a gap)"
    end
    if selectedPeriodIndex == nil or selectedPanelKey == nil then
        missing[#missing + 1] = "a scene panel"
    end
    return missing
end

function MemoriamModal.isOpen()
    return modalOpen == true
end

function MemoriamModal.open()
    if S.getStateVal("currentPhase") ~= C.Phases.PLAY then
        U.AlertGM("Memoriam can only be configured during Play.")
        return
    end
    resetDraft()
    modalOpen = true
    hideConfiguration()
    setAttr("memoriam_modal_selected_date", "text", "")
    setAttr("memoriam_modal_pc_selection", "value", " ")
    setAttr("memoriam_modal", "active", "true")
end

function MemoriamModal.close()
    modalOpen = false
    hidePicker()
    setAttr("memoriam_modal", "active", "false")
    resetDraft()
end

function MemoriamModal.onPcDropdown(value)
    if not modalOpen then
        return
    end
    local label = trimString(value)
    if label == "" then
        subjectKey = nil
        catalogEntries = {}
        segments = {}
        selectedPeriodIndex = nil
        selectedPanelKey = nil
        hideConfiguration()
        setAttr("memoriam_modal_selected_date", "text", "")
        return
    end
    local key = DISPLAY_TO_KEY[label]
    if key == nil then
        U.AlertGM("Unknown Memoriam character: " .. label)
        return
    end
    configureForSubject(key)
end

function MemoriamModal.onSlider(value)
    if not modalOpen or subjectKey == nil then
        return
    end
    sliderValue = tonumber(value) or sliderValue
    applyDateAndHighlights()
end

function MemoriamModal.onSceneButton(id)
    if not modalOpen or subjectKey == nil then
        return
    end
    local periodStr, panelLetter = string.match(tostring(id or ""), "^memoriam_period_(%d+)_panel([ABCD])_button$")
    local periodIndex = tonumber(periodStr)
    if periodIndex == nil or panelLetter == nil then
        return
    end
    local panelKey = "panel" .. panelLetter
    local entry = catalogEntries[periodIndex]
    local label = panelDisplay(entry, panelKey)
    if label == nil then
        return
    end
    selectedPeriodIndex = periodIndex
    selectedPanelKey = panelKey
    clearNpcAssignments()
    fillPickerFromPeriod(periodIndex)
    showNpcAssignmentRows()
    applyDateAndHighlights()
end

function MemoriamModal.onNpcPlus(id)
    if not modalOpen or selectedPeriodIndex == nil then
        return
    end
    local key = string.match(tostring(id or ""), "^memoriam_modal_npc_assignment_([A-Za-z]+)_button$")
    if key == nil or key == subjectKey then
        return
    end
    local known = false
    for i = 1, #PC_KEYS do
        if PC_KEYS[i] == key then
            known = true
            break
        end
    end
    if not known then
        return
    end
    pickerTargetKey = key
    npcInputDraft = ""
    setAttr("memoriam_modal_npc_assignment_input", "text", "")
    setAttr("memoriam_modal_npc_assignment_label", "text", "Assigning To: " .. (PC_DISPLAY[key] or key))
    setAttr("memoriam_modal_npc_assignment_grid_container", "active", "true")
end

function MemoriamModal.onNpcPick(id)
    if not modalOpen or pickerTargetKey == nil then
        return
    end
    local slotStr = string.match(tostring(id or ""), "^memoriam_modal_npc_assignment_memoriamNPC_(%d+)$")
    local slot = tonumber(slotStr)
    local label = slot ~= nil and pickerNpcLabels[slot] or nil
    if label == nil then
        return
    end
    assignments[pickerTargetKey] = {
        kind = "memoriam",
        label = label,
    }
    setAttr("memoriam_modal_npc_assignment_" .. pickerTargetKey .. "_npc_name", "text", label)
    hidePicker()
end

function MemoriamModal.onNpcInput(value)
    npcInputDraft = tostring(value or "")
end

function MemoriamModal.onNpcConfirm()
    if not modalOpen or pickerTargetKey == nil then
        return
    end
    local resolved, err = resolveLibraryNpc(npcInputDraft)
    if resolved == nil then
        U.AlertGM(err or "That NPC key is not in the library.")
        return
    end
    assignments[pickerTargetKey] = {
        kind = "library",
        key = resolved.key,
        label = resolved.label,
    }
    setAttr("memoriam_modal_npc_assignment_" .. pickerTargetKey .. "_npc_name", "text", resolved.label)
    hidePicker()
end

function MemoriamModal.onNpcCancel()
    hidePicker()
end

function MemoriamModal.onCancel()
    MemoriamModal.close()
end

function MemoriamModal.onConfirm()
    if not modalOpen then
        return
    end
    local missing = missingAdvanceReasons()
    if #missing > 0 then
        U.AlertGM("Memoriam needs " .. table.concat(missing, ", ") .. " before Advance.")
        return
    end
    local seg = segments[currentSegmentIndex]
    local assignmentOut = {}
    for i = 1, #PC_KEYS do
        local key = PC_KEYS[i]
        if key ~= subjectKey then
            local row = assignments[key]
            if type(row) == "table" then
                assignmentOut[key] = {
                    kind = row.kind,
                    key = row.key,
                    label = row.label,
                }
            end
        end
    end
    local payload = {
        subjectKey = subjectKey,
        date = dateDisplay,
        sliderValue = sliderValue,
        skyboxKey = seg.entry.key,
        periodIndex = selectedPeriodIndex,
        panel = selectedPanelKey,
        assignments = assignmentOut,
    }
    print("[Memoriam] " .. encodePayload(payload))
    MemoriamModal.close()
    local Phases = require("core.phases")
    Phases.setPlaySubPhase(C.PlaySubPhases.MEMORIAM)
end

return MemoriamModal
