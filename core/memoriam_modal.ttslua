local function snapWidthsToTotal(raw, total)
    local n = #raw
    local floors = {}
    local fracs = {}
    local sum = 0
    for i = 1, n do
        local value = raw[i]
        if value < 0 then
            value = 0
        end
        local floored = math.floor(value)
        floors[i] = floored
        fracs[i] = value - floored
        sum = sum + floored
    end
    local remain = total - sum
    local order = {}
    for i = 1, n do
        order[i] = i
    end
    if remain > 0 then
        table.sort(order, function(a, b)
            if fracs[a] ~= fracs[b] then
                return fracs[a] > fracs[b]
            end
            return a < b
        end)
        for k = 1, remain do
            local idx = order[k]
            if idx ~= nil then
                floors[idx] = floors[idx] + 1
            end
        end
    elseif remain < 0 then
        table.sort(order, function(a, b)
            if floors[a] ~= floors[b] then
                return floors[a] > floors[b]
            end
            return a < b
        end)
        local need = -remain
        local k = 1
        while need > 0 and k <= n do
            local idx = order[k]
            if floors[idx] > 0 then
                floors[idx] = floors[idx] - 1
                need = need - 1
            else
                k = k + 1
            end
        end
    end
    return floors
end

local function normalizeSegmentWidths(list)
    local totalYears = 0
    for i = 1, #list do
        totalYears = totalYears + list[i].duration
    end
    if totalYears <= 0 then
        return false, "That character's timeline has no duration to map."
    end

    local raw = {}
    for i = 1, #list do
        raw[i] = list[i].duration / totalYears * SLIDER_MAX
    end

    local deficit = 0
    for i = 1, #list do
        if list[i].kind == "period" and raw[i] < MIN_PERIOD_UNITS then
            deficit = deficit + (MIN_PERIOD_UNITS - raw[i])
            raw[i] = MIN_PERIOD_UNITS
        end
    end

    if deficit > 0 then
        local surplusTotal = 0
        for i = 1, #list do
            if list[i].kind == "period" and raw[i] > MIN_PERIOD_UNITS then
                surplusTotal = surplusTotal + (raw[i] - MIN_PERIOD_UNITS)
            end
        end
        if surplusTotal > 0 then
            local take = deficit
            if take > surplusTotal then
                take = surplusTotal
            end
            for i = 1, #list do
                if list[i].kind == "period" and raw[i] > MIN_PERIOD_UNITS then
                    local share = (raw[i] - MIN_PERIOD_UNITS) / surplusTotal * take
                    raw[i] = raw[i] - share
                end
            end
            deficit = deficit - take
        end
        if deficit > 0.01 then
            local gapTotal = 0
            for i = 1, #list do
                if list[i].kind == "gap" then
                    gapTotal = gapTotal + raw[i]
                end
            end
            if gapTotal > 0 then
                local take = deficit
                if take > gapTotal then
                    take = gapTotal
                end
                for i = 1, #list do
                    if list[i].kind == "gap" and gapTotal > 0 then
                        raw[i] = raw[i] - (raw[i] / gapTotal * take)
                    end
                end
            end
        end
    end

    local widths = snapWidthsToTotal(raw, SLIDER_MAX)
    local pxRaw = {}
    for i = 1, #list do
        list[i].width = widths[i]
        pxRaw[i] = widths[i] * BAR_PIXEL_TOTAL / SLIDER_MAX
    end
    local px = snapWidthsToTotal(pxRaw, BAR_PIXEL_TOTAL)
    for i = 1, #list do
        list[i].barPx = px[i]
    end
    return true, nil
end

local function buildTimeline(entries, presentYear)
    local ranges = {}
    for i = 1, #entries do
        local entry = entries[i]
        local startYear = tonumber(entry.startYear)
        local endYear = tonumber(entry.endYear)
        if startYear == nil then
            return nil, "Memoriam period `" .. tostring(entry.key) .. "` is missing startYear."
        end
        startYear = math.floor(startYear)
        if endYear == nil then
            endYear = startYear
        else
            endYear = math.floor(endYear)
        end
        if endYear < startYear then
            endYear = startYear
        end
        ranges[#ranges + 1] = {
            start = startYear,
            finish = endYear + 1,
            entry = entry,
            periodIndex = i,
        }
    end

    local presentEnd = presentYear + 1
    local firstStart = ranges[1].start
    if firstStart > presentEnd then
        return nil, "That character's earliest Memoriam year is after the present-day clock."
    end

    local kept = {}
    for i = 1, #ranges do
        local r = ranges[i]
        if r.start < presentEnd then
            if r.finish > presentEnd then
                r.finish = presentEnd
            end
            if r.finish > r.start then
                kept[#kept + 1] = r
            end
        end
    end
    if #kept < 1 then
        return nil, "No Memoriam periods fall on or before the present-day clock."
    end

    firstStart = kept[1].start
    for i = 2, #kept do
        if kept[i].start < firstStart then
            firstStart = kept[i].start
        end
    end

    local function winnerForYear(year)
        local best = nil
        for i = 1, #kept do
            local r = kept[i]
            if year >= r.start and year < r.finish then
                if best == nil then
                    best = r
                else
                    local spanR = r.finish - r.start
                    local spanB = best.finish - best.start
                    if spanR < spanB then
                        best = r
                    elseif spanR == spanB then
                        if r.start > best.start then
                            best = r
                        elseif r.start == best.start and r.periodIndex > best.periodIndex then
                            best = r
                        end
                    end
                end
            end
        end
        return best
    end

    local function sameWinner(a, b)
        if a == nil and b == nil then
            return true
        end
        if a == nil or b == nil then
            return false
        end
        return a.periodIndex == b.periodIndex
    end

    local out = {}
    local yearCursor = firstStart
    while yearCursor < presentEnd do
        local winner = winnerForYear(yearCursor)
        local runStart = yearCursor
        yearCursor = yearCursor + 1
        while yearCursor < presentEnd do
            if not sameWinner(winner, winnerForYear(yearCursor)) then
                break
            end
            yearCursor = yearCursor + 1
        end
        if winner == nil then
            out[#out + 1] = {
                kind = "gap",
                calendarStart = runStart,
                calendarEnd = yearCursor,
                duration = yearCursor - runStart,
            }
        else
            out[#out + 1] = {
                kind = "period",
                calendarStart = runStart,
                calendarEnd = yearCursor,
                duration = yearCursor - runStart,
                entry = winner.entry,
                periodIndex = winner.periodIndex,
                periodColorIndex = winner.periodIndex,
            }
        end
    end

    if #out > BAR_SLOT_COUNT then
        return nil, "This timeline needs " .. tostring(#out) .. " bar slots; only " .. tostring(BAR_SLOT_COUNT) .. " exist."
    end
    if #entries > SCENE_COLUMN_COUNT then
        return nil, "This character has " .. tostring(#entries) .. " periods; the scene grid only has " .. tostring(SCENE_COLUMN_COUNT) .. " columns."
    end

    local ok, err = normalizeSegmentWidths(out)
    if not ok then
        return nil, err
    end
    return out, nil
end

mapSliderToSegment = function(value)
    local pos = tonumber(value)
    if pos == nil then
        pos = 0
    end
    if pos < 0 then
        pos = 0
    elseif pos > SLIDER_MAX then
        pos = SLIDER_MAX
    end
    local cursor = 0
    for i = 1, #segments do
        local width = segments[i].width or 0
        local nextPos = cursor + width
        if pos < nextPos or i == #segments then
            local t = 0
            if width > 0 then
                t = (pos - cursor) / width
                if t < 0 then
                    t = 0
                elseif t > 1 then
                    t = 1
                end
            end
            return i, t, pos
        end
        cursor = nextPos
    end
    return nil, 0, pos
end

calendarYearInSegment = function(seg, t)
    local span = (seg.calendarEnd or 0) - (seg.calendarStart or 0)
    local yearFloat = (seg.calendarStart or 0) + span * (t or 0)
    local year = math.floor(yearFloat)
    local lastYear = math.floor((seg.calendarEnd or year) - 0.0001)
    if year > lastYear then
        year = lastYear
    end
    local firstYear = math.floor(seg.calendarStart or year)
    if year < firstYear then
        year = firstYear
    end
    return year
end

currentPeriodIndex = function()
    local seg = currentSegmentIndex ~= nil and segments[currentSegmentIndex] or nil
    if seg ~= nil and seg.kind == "period" then
        return seg.periodIndex
    end
    return nil
end

exclusiveYearsForPeriod = function(periodIndex)
    local years = {}
    for i = 1, #segments do
        local seg = segments[i]
        if seg.kind == "period" and seg.periodIndex == periodIndex then
            local y0 = math.floor(seg.calendarStart)
            local y1 = math.floor(seg.calendarEnd) - 1
            for y = y0, y1 do
                years[#years + 1] = y
            end
        end
    end
    return years
end

sliderValueForYearInPeriod = function(periodIndex, year)
    local cursor = 0
    for i = 1, #segments do
        local seg = segments[i]
        local width = seg.width or 0
        if seg.kind == "period" and seg.periodIndex == periodIndex then
            local y0 = math.floor(seg.calendarStart)
            local y1 = math.floor(seg.calendarEnd) - 1
            if year >= y0 and year <= y1 then
                local span = (seg.calendarEnd or 0) - (seg.calendarStart or 0)
                local t = 0.5
                if span > 0 then
                    t = ((year + 0.5) - seg.calendarStart) / span
                    if t < 0 then
                        t = 0
                    elseif t > 1 then
                        t = 1
                    end
                end
                local pos = cursor + t * width
                if width > 0 and pos >= cursor + width then
                    pos = cursor + width - 0.001
                end
                return pos, i
            end
        end
        cursor = cursor + width
    end
    return nil, nil
end

jumpSliderToPeriod = function(periodIndex)
    local years = exclusiveYearsForPeriod(periodIndex)
    if #years < 1 then
        U.AlertGM("That period has no years left after nested periods take priority.")
        return false
    end
    local entry = catalogEntries[periodIndex]
    local year
    local month
    local day
    local specific = parseSpecificDate(type(entry) == "table" and entry.specificDate or nil)
    if specific ~= nil then
        for i = 1, #years do
            if years[i] == specific.year then
                year = specific.year
                month = specific.month
                day = specific.day
                break
            end
        end
    end
    if year == nil then
        year = years[math.random(1, #years)]
        month = math.random(1, 12)
        local dim = NarrativeCalendar.daysInMonth(year, month)
        day = math.random(1, dim)
    end
    local pos, segIndex = sliderValueForYearInPeriod(periodIndex, year)
    if pos == nil then
        U.AlertGM("Could not map that period onto the slider.")
        return false
    end
    pos = math.floor(pos + 0.5)
    if pos < 0 then
        pos = 0
    elseif pos > SLIDER_MAX then
        pos = SLIDER_MAX
    end
    sliderValue = pos
    lastRandomYear = year
    lastRandomMonth = month
    lastRandomDay = day
    lastRandomSegmentIndex = segIndex
    setAttr("memoriam_modal_period_selection_slider", "value", tostring(pos))
    return true
end

local function periodBaseColor(periodColorIndex)
    if (periodColorIndex % 2) == 1 then
        return PERIOD_COLOR_A
    end
    return PERIOD_COLOR_B
end

paintBar = function()
    local n = #segments
    local highlightPeriod = currentPeriodIndex()
    for vis = 1, BAR_SLOT_COUNT do
        local id = "memoriam_period_" .. tostring(vis)
        local seg = (vis <= n) and segments[vis] or nil
        if seg == nil then
            setAttrs(id, {
                active = "false",
                minWidth = "0",
            })
        else
            local color = GAP_COLOR
            if seg.kind == "period" then
                color = periodBaseColor(seg.periodColorIndex or seg.periodIndex or vis)
                if highlightPeriod ~= nil and seg.periodIndex == highlightPeriod then
                    color = CURRENT_PERIOD_COLOR
                end
            end
            setAttrs(id, {
                active = "true",
                minWidth = tostring(seg.barPx or 0),
                color = color,
            })
        end
    end
end

local function sceneButtonId(periodIndex, panelKey)
    return "memoriam_period_" .. tostring(periodIndex) .. "_" .. panelKey .. "_button"
end

-- Class list drives highlight/selected color from XML Defaults. Do not write `color`
-- here: U.setAttributes also restores a button's last color, which would override
-- the class. Dummy C/D cells are the exception (explicit black).
local function applyPanelButton(id, className, attrs)
    attrs.fontSize = attrs.fontSize or PANEL_BUTTON_FONT_SIZE
    attrs.fontStyle = attrs.fontStyle or PANEL_BUTTON_FONT_STYLE
    UI.setAttributes(id, attrs)
    UI.setClass(id, className)
end

local function applySceneButtonState(periodIndex, panelKey, defined, label)
    local id = sceneButtonId(periodIndex, panelKey)
    if not defined then
        if panelKey == "panelC" or panelKey == "panelD" then
            applyPanelButton(id, "memoriam_modal_scene_selection_button", {
                active = "true",
                interactable = "false",
                text = "",
                color = BUTTON_DUMMY_COLOR,
            })
        else
            applyPanelButton(id, "memoriam_modal_scene_selection_button", {
                active = "false",
                interactable = "false",
                text = "",
            })
        end
        return
    end
    local isSelected = selectedPeriodIndex == periodIndex and selectedPanelKey == panelKey
    local currentSeg = currentSegmentIndex ~= nil and segments[currentSegmentIndex] or nil
    local inCurrentPeriod = currentSeg ~= nil and currentSeg.kind == "period" and currentSeg.periodIndex == periodIndex
    local className = "memoriam_modal_scene_selection_button"
    if isSelected then
        className = "memoriam_modal_scene_selection_button selection_button_selected"
    elseif inCurrentPeriod then
        className = "memoriam_modal_scene_selection_button selection_button_highlighted"
    end
    applyPanelButton(id, className, {
        active = "true",
        interactable = "true",
        text = label,
    })
end

applyJustSmokeButtonState = function()
    local className = "memoriam_modal_scene_selection_button selection_button_highlighted"
    if selectedJustSmoke then
        className = "memoriam_modal_scene_selection_button selection_button_selected"
    end
    applyPanelButton(JUST_SMOKE_BUTTON_ID, className, {
        active = "true",
        interactable = "true",
        text = "Just Smoke",
    })
end

fillSceneGrid = function()
    for periodIndex = 1, SCENE_COLUMN_COUNT do
        local entry = catalogEntries[periodIndex]
        if entry == nil then
            for p = 1, #PANEL_KEYS do
                local id = sceneButtonId(periodIndex, PANEL_KEYS[p])
                applyPanelButton(id, "memoriam_modal_scene_selection_button", {
                    active = "false",
                    interactable = "false",
                    text = "",
                })
            end
        else
            for p = 1, #PANEL_KEYS do
                local panelKey = PANEL_KEYS[p]
                local label = panelDisplay(entry, panelKey)
                applySceneButtonState(periodIndex, panelKey, label ~= nil, label or "")
            end
        end
    end
    applyJustSmokeButtonState()
end

applyDateAndHighlights = function()
    local segIndex, t, pos = mapSliderToSegment(sliderValue)
    sliderValue = pos
    currentSegmentIndex = segIndex
    local seg = segIndex ~= nil and segments[segIndex] or nil
    if seg == nil then
        dateDisplay = ""
        locationDisplay = ""
        setAttr("memoriam_modal_selected_date", "text", "")
        setAttr("memoriam_modal_selected_location", "text", "")
        paintBar()
        fillSceneGrid()
        return
    end

    if not selectedJustSmoke and selectedPeriodIndex ~= nil then
        local newPeriod = nil
        if seg.kind == "period" then
            newPeriod = seg.periodIndex
        end
        if newPeriod ~= selectedPeriodIndex then
            selectedPeriodIndex = nil
            selectedPanelKey = nil
            hideNpcAssignment()
        end
    end

    local year = calendarYearInSegment(seg, t)
    local month
    local day
    if seg.kind == "period" and type(seg.entry) == "table" then
        local specific = parseSpecificDate(seg.entry.specificDate)
        if specific ~= nil then
            local y0 = math.floor(seg.calendarStart)
            local y1 = math.floor(seg.calendarEnd) - 1
            if specific.year >= y0 and specific.year <= y1 then
                year = specific.year
                month = specific.month
                day = specific.day
                lastRandomYear = year
                lastRandomMonth = month
                lastRandomDay = day
                lastRandomSegmentIndex = segIndex
            end
        end
    end
    if month == nil then
        if lastRandomSegmentIndex == segIndex and lastRandomYear == year and lastRandomMonth ~= nil and lastRandomDay ~= nil then
            month = lastRandomMonth
            day = lastRandomDay
        else
            month = math.random(1, 12)
            local dim = NarrativeCalendar.daysInMonth(year, month)
            day = math.random(1, dim)
            lastRandomYear = year
            lastRandomMonth = month
            lastRandomDay = day
            lastRandomSegmentIndex = segIndex
        end
    end
    dateDisplay = formatFullDate(year, month, day)
    locationDisplay = ""
    if seg.kind == "period" then
        locationDisplay = periodLocation(seg.entry)
    end
    setAttr("memoriam_modal_selected_date", "text", dateDisplay)
    setAttr("memoriam_modal_selected_location", "text", locationDisplay)
    paintBar()
    fillSceneGrid()
end

clearNpcAssignments = function()
    assignments = {}
    for i = 1, #PC_KEYS do
        local key = PC_KEYS[i]
        setAttr("memoriam_modal_npc_assignment_" .. key .. "_npc_name", "text", EMPTY_NPC_TEXT)
    end
    hidePicker()
end

fillPickerFromPeriod = function(periodIndex)
    pickerNpcLabels = {}
    local entry = catalogEntries[periodIndex]
    local npcs = type(entry) == "table" and entry.npcs or nil
    local filled = 0
    if type(npcs) == "table" then
        for i = 1, #npcs do
            local label = npcLabelFromSlot(npcs[i])
            if label ~= nil then
                filled = filled + 1
                if filled <= NPC_PICKER_SLOTS then
                    pickerNpcLabels[filled] = label
                end
            end
        end
    end
    for slot = 1, NPC_PICKER_SLOTS do
        local id = "memoriam_modal_npc_assignment_memoriamNPC_" .. tostring(slot)
        local label = pickerNpcLabels[slot]
        if label == nil then
            setAttrs(id, {
                active = "false",
                text = "",
            })
        else
            setAttrs(id, {
                active = "true",
                text = label,
            })
        end
    end
end

showNpcAssignmentRows = function()
    setAttr("memoriam_modal_npc_assignment", "active", "true")
    for i = 1, #PC_KEYS do
        local key = PC_KEYS[i]
        local rowId = "memoriam_modal_npc_assignment_" .. key
        if key == subjectKey then
            setAttr(rowId, "active", "false")
        else
            setAttr(rowId, "active", "true")
        end
    end
end

configureForSubject = function(characterKey)
    local presentYear = presentDayYear()
    if presentYear == nil then
        U.AlertGM("Set the present-day clock before configuring Memoriam.")
        hideConfiguration()
        return
    end
    local entries = C.getMemoriamSkyboxesForCharacter(characterKey)
    if type(entries) ~= "table" or #entries < 1 then
        U.AlertGM("No Memoriam periods are defined for that character.")
        hideConfiguration()
        return
    end
    local built, err = buildTimeline(entries, presentYear)
    if built == nil then
        U.AlertGM(err or "Could not build that character's Memoriam timeline.")
        hideConfiguration()
        return
    end

    subjectKey = characterKey
    catalogEntries = entries
    segments = built
    selectedPeriodIndex = nil
    selectedPanelKey = nil
    selectedJustSmoke = false
    sliderValue = SLIDER_MAX
    lastRandomYear = nil
    lastRandomMonth = nil
    lastRandomDay = nil
    lastRandomSegmentIndex = nil
    locationDisplay = ""
    clearNpcAssignments()

    setAttr("memoriam_modal_period_selection", "active", "true")
    setAttr("memoriam_modal_scene_selection", "active", "true")
    setAttr("memoriam_modal_npc_assignment", "active", "false")
    setAttr("memoriam_modal_period_selection_slider", "direction", "LeftToRight")
    setAttr("memoriam_modal_period_selection_slider", "maxValue", tostring(SLIDER_MAX))
    setAttr("memoriam_modal_period_selection_slider", "value", tostring(SLIDER_MAX))
    applyDateAndHighlights()
end

encodePayload = function(payload)
    if JSON ~= nil and type(JSON.encode) == "function" then
        return JSON.encode(payload)
    end
    return tostring(payload.subjectKey)
end

missingAdvanceReasons = function()
    local missing = {}
    if subjectKey == nil or subjectKey == "" then
        missing[#missing + 1] = "a character"
    end
    if selectedJustSmoke then
        return missing
    end
    local seg = currentSegmentIndex ~= nil and segments[currentSegmentIndex] or nil
    if seg == nil or seg.kind ~= "period" then
        missing[#missing + 1] = "a time period (move the slider out of a gap)"
    end
    if selectedPeriodIndex == nil or selectedPanelKey == nil then
        missing[#missing + 1] = "a scene panel"
    end
    return missing
end

function MemoriamModal.isOpen()
    return modalOpen == true
end

function MemoriamModal.open()
    if S.getStateVal("currentPhase") ~= C.Phases.PLAY then
        U.AlertGM("Memoriam can only be configured during Play.")
        return
    end
    resetDraft()
    modalOpen = true
    hideConfiguration()
    setAttr("memoriam_modal_selected_date", "text", "")
    setAttr("memoriam_modal_selected_location", "text", "")
    setAttr("memoriam_modal_pc_selection", "value", " ")
    setAttr("memoriam_modal", "active", "true")
end

function MemoriamModal.close()
    modalOpen = false
    hidePicker()
    setAttr("memoriam_modal", "active", "false")
    resetDraft()
end

function MemoriamModal.onPcDropdown(value)
    if not modalOpen then
        return
    end
    local label = trimString(value)
    if label == "" then
        subjectKey = nil
        catalogEntries = {}
        segments = {}
        selectedPeriodIndex = nil
        selectedPanelKey = nil
        selectedJustSmoke = false
        hideConfiguration()
        setAttr("memoriam_modal_selected_date", "text", "")
        setAttr("memoriam_modal_selected_location", "text", "")
        return
    end
    local key = DISPLAY_TO_KEY[label]
    if key == nil then
        U.AlertGM("Unknown Memoriam character: " .. label)
        return
    end
    configureForSubject(key)
end

function MemoriamModal.onSlider(value)
    if not modalOpen or subjectKey == nil then
        return
    end
    sliderValue = tonumber(value) or sliderValue
    applyDateAndHighlights()
end

function MemoriamModal.onSceneButton(id)
    if not modalOpen or subjectKey == nil then
        return
    end
    local periodStr, panelLetter = string.match(tostring(id or ""), "^memoriam_period_(%d+)_panel([ABCD])_button$")
    local periodIndex = tonumber(periodStr)
    if periodIndex == nil or panelLetter == nil then
        return
    end
    local panelKey = "panel" .. panelLetter
    local entry = catalogEntries[periodIndex]
    local label = panelDisplay(entry, panelKey)
    if label == nil then
        return
    end
    if currentPeriodIndex() ~= periodIndex then
        if not jumpSliderToPeriod(periodIndex) then
            return
        end
    end
    selectedJustSmoke = false
    selectedPeriodIndex = periodIndex
    selectedPanelKey = panelKey
    clearNpcAssignments()
    fillPickerFromPeriod(periodIndex)
    showNpcAssignmentRows()
    applyDateAndHighlights()
end

function MemoriamModal.onJustSmoke()
    if not modalOpen or subjectKey == nil then
        return
    end
    selectedJustSmoke = true
    selectedPeriodIndex = nil
    selectedPanelKey = nil
    clearNpcAssignments()
    fillPickerFromPeriod(nil)
    showNpcAssignmentRows()
    applyDateAndHighlights()
end

function MemoriamModal.onNpcPlus(id)
    if not modalOpen or (selectedPeriodIndex == nil and not selectedJustSmoke) then
        return
    end
    local key = string.match(tostring(id or ""), "^memoriam_modal_npc_assignment_([A-Za-z]+)_button$")
    if key == nil or key == subjectKey then
        return
    end
    local known = false
    for i = 1, #PC_KEYS do
        if PC_KEYS[i] == key then
            known = true
            break
        end
    end
    if not known then
        return
    end
    pickerTargetKey = key
    npcInputDraft = ""
    setAttr("memoriam_modal_npc_assignment_input", "text", "")
    setAttr("memoriam_modal_npc_assignment_label", "text", "Assigning To: " .. (PC_DISPLAY[key] or key))
    setAttr("memoriam_modal_npc_assignment_grid_container", "active", "true")
end

function MemoriamModal.onNpcPick(id)
    if not modalOpen or pickerTargetKey == nil then
        return
    end
    local slotStr = string.match(tostring(id or ""), "^memoriam_modal_npc_assignment_memoriamNPC_(%d+)$")
    local slot = tonumber(slotStr)
    local label = slot ~= nil and pickerNpcLabels[slot] or nil
    if label == nil then
        return
    end
    assignments[pickerTargetKey] = {
        kind = "memoriam",
        label = label,
    }
    setAttr("memoriam_modal_npc_assignment_" .. pickerTargetKey .. "_npc_name", "text", label)
    hidePicker()
end

function MemoriamModal.onNpcInput(value)
    npcInputDraft = tostring(value or "")
end

function MemoriamModal.onNpcConfirm()
    if not modalOpen or pickerTargetKey == nil then
        return
    end
    local resolved, err = resolveLibraryNpc(npcInputDraft)
    if resolved == nil then
        U.AlertGM(err or "That NPC key is not in the library.")
        return
    end
    assignments[pickerTargetKey] = {
        kind = "library",
        key = resolved.key,
        label = resolved.label,
    }
    setAttr("memoriam_modal_npc_assignment_" .. pickerTargetKey .. "_npc_name", "text", resolved.label)
    hidePicker()
end

function MemoriamModal.onNpcCancel()
    hidePicker()
end

function MemoriamModal.onCancel()
    MemoriamModal.close()
end

function MemoriamModal.onConfirm()
    if not modalOpen then
        return
    end
    local missing = missingAdvanceReasons()
    if #missing > 0 then
        U.AlertGM("Memoriam needs " .. table.concat(missing, ", ") .. " before Advance.")
        return
    end
    local seg = segments[currentSegmentIndex]
    local assignmentOut = {}
    for i = 1, #PC_KEYS do
        local key = PC_KEYS[i]
        if key ~= subjectKey then
            local row = assignments[key]
            if type(row) == "table" then
                assignmentOut[key] = {
                    kind = row.kind,
                    key = row.key,
                    label = row.label,
                }
            end
        end
    end
    local payload
    if selectedJustSmoke then
        payload = {
            subjectKey = subjectKey,
            date = dateDisplay,
            location = locationDisplay,
            sliderValue = sliderValue,
            justSmoke = true,
            panel = copyJustSmokePanel(),
            assignments = assignmentOut,
        }
    else
        payload = {
            subjectKey = subjectKey,
            date = dateDisplay,
            location = locationDisplay,
            sliderValue = sliderValue,
            skyboxKey = seg.entry.key,
            periodIndex = selectedPeriodIndex,
            panel = selectedPanelKey,
            assignments = assignmentOut,
        }
    end
    print("[Memoriam] " .. encodePayload(payload))
    MemoriamModal.close()
    local Phases = require("core.phases")
    Phases.setPlaySubPhase(C.PlaySubPhases.MEMORIAM)
end

return MemoriamModal
