--[[
    Scatter Mode runtime (TOR-572). Global `require` only — never from object scripts.

    Table-change into `C.Tables["Scatter"]` (`shape = SCATTER`): swap CONTROL_BOARD art
    (wait until the recreated tile is mesh-ready before snaps/XmlUI), hide tables/chairs,
    clear polar snaps (debug calibration snaps only while measuring holes), auto-park tokens
    on measured holes, pose figurines.
]]

local C = require("lib.constants")
local U = require("lib.util")
local S = require("core.state")
local G = require("lib.guids")
local DATA = require("lib.npc_gameboard_data")
local ScatterLayout = require("lib.scatter_layout")

local ScatterMode = {}

ScatterMode.TABLE_KEY = "Scatter"

--- Last CONTROL_BOARD custom image URL applied by ScatterMode (fingerprint vs Sync.full).
local lastAppliedBoardImageUrl = nil
--- Bumped when a new CONTROL_BOARD `reload()` wait starts so a stale wait cannot finish after leave/enter.
local boardReloadGeneration = 0
local CONTROL_BOARD_RELOAD_WAIT_SEC = 20

local finishScatterBoardAfterReload
local finishStandardBoardAfterReload
local applyDebugCalibrationSnapsIfAny
local reapplyControlBoardCatalogVisibility

--- In-memory inferred holes per group for debug snap points (Scatter play has none).
local debugHolesByGroup = {}

local function scatterCfg()
    local scatter = C.Tables and C.Tables["Scatter"] or C.Scatter
    if U.Type(scatter) ~= "table" then
        error("scatter_mode: C.Tables[\"Scatter\"] is missing")
    end
    return scatter
end

local function boardNpcHoleCount()
    return math.floor(tonumber(scatterCfg().BOARD_NPC_HOLE_COUNT) or 12)
end

--- @return boolean
function ScatterMode.isActive()
    local Occupancy = require("lib.scatter_occupancy")
    local key = S.getStateVal("seatLayout", "currentTableKey")
    if Occupancy.isScatterTableKey(key) then
        return true
    end
    local mode = S.getStateVal("sessionScene", "placementMode")
    return mode == "scatter"
end

--- @param color string
--- @return string|nil pcKey
local function pcKeyForColor(color)
    if type(color) ~= "string" then
        return nil
    end
    for _, row in pairs(C.PlayerData or {}) do
        if U.Type(row) == "table" and row.color == color and type(row.charKey) == "string" and row.charKey ~= "" then
            return row.charKey
        end
    end
    return nil
end

--- @param pcKey string
--- @return string|nil color
local function colorForPcKey(pcKey)
    if type(pcKey) ~= "string" or pcKey == "" then
        return nil
    end
    for _, row in pairs(C.PlayerData or {}) do
        if U.Type(row) == "table" and row.charKey == pcKey and type(row.color) == "string" then
            return row.color
        end
    end
    return nil
end

--- @return table scatterPlacements
local function livePlacements()
    local pack = S.getStateVal("sessionScene", "scatterPlacements")
    if U.Type(pack) ~= "table" then
        pack = ScatterLayout.emptyPlacements()
        S.setStateVal(pack, "sessionScene", "scatterPlacements")
    end
    for i = 1, ScatterLayout.groupCount() do
        local key = ScatterLayout.areaKeyForGroup(i)
        if U.Type(pack[key]) ~= "table" then
            pack[key] = { centerCharacters = {}, orbitCharacters = {} }
        end
        if U.Type(pack[key].centerCharacters) ~= "table" then
            pack[key].centerCharacters = {}
        end
        if U.Type(pack[key].orbitCharacters) ~= "table" then
            pack[key].orbitCharacters = {}
        end
    end
    return pack
end

--- @param groupIndex number
--- @return table area
local function areaForGroup(groupIndex)
    local pack = livePlacements()
    local key = ScatterLayout.areaKeyForGroup(groupIndex)
    return pack[key]
end

--- Remove a PC or NPC character key from every scatter area.
--- @param characterKey string
local function removeCharacterFromAllGroups(characterKey)
    if type(characterKey) ~= "string" or characterKey == "" then
        return
    end
    local pack = livePlacements()
    for i = 1, ScatterLayout.groupCount() do
        local area = pack[ScatterLayout.areaKeyForGroup(i)]
        if U.Type(area) == "table" then
            if U.Type(area.centerCharacters) == "table" then
                area.centerCharacters[characterKey] = nil
            end
            if U.Type(area.orbitCharacters) == "table" then
                area.orbitCharacters[characterKey] = nil
            end
        end
    end
end

--- Public: free board/orbit slots when a control token leaves a scatter hole (pick-up or off-parchment drop).
--- @param characterKey string|nil
function ScatterMode.clearCharacterOccupancy(characterKey)
    removeCharacterFromAllGroups(characterKey)
end

--- @return table|nil D.SCATTER_BOARD
local function scatterBoardData()
    return DATA.SCATTER_BOARD
end

--- @param groupIndex number
--- @return table|nil area row from D.SCATTER_BOARD
local function measuredArea(groupIndex)
    local board = scatterBoardData()
    if U.Type(board) ~= "table" or U.Type(board.areas) ~= "table" then
        return nil
    end
    local key = ScatterLayout.areaKeyForGroup(groupIndex)
    local row = board.areas[key]
    if U.Type(row) ~= "table" then
        return nil
    end
    return row
end

--- @param groupIndex number
--- @return boolean
function ScatterMode.groupIsCalibrated(groupIndex)
    local row = measuredArea(groupIndex)
    if row == nil then
        return false
    end
    if row.calibrated == true and U.Type(row.gold) == "table" and U.Type(row.whites) == "table" and U.Type(row.npcHoles) == "table" then
        return #row.whites >= 4 and #row.npcHoles >= 1
    end
    return false
end

--- @param hole table `{ localX, localY, localZ }`
--- @param board Object
--- @return Vector
local function holeLocalToWorld(board, hole)
    local Board = require("core.npc_gameboard_board")
    local localPos = Vector({
        x = tonumber(hole.localX) or 0,
        y = tonumber(hole.localY) or 0,
        z = tonumber(hole.localZ) or 0,
    })
    return Board.boardLocalToWorld(board, localPos)
end

--- Gold + four whites (UL, +90, +180, +270) + NPC ring. Slot 3 = gold; 1,2,4,5 = whites in dump order.
--- @param groupIndex number
--- @param board Object
--- @return table|nil `{ gold, whites, npcHoles, pcHolesBySlot }`
local function resolvedHoles(groupIndex, board)
    if not ScatterMode.groupIsCalibrated(groupIndex) then
        return nil
    end
    local row = measuredArea(groupIndex)
    local pcHolesBySlot = {
        [3] = row.gold,
        [1] = row.whites[1],
        [2] = row.whites[2],
        [4] = row.whites[3],
        [5] = row.whites[4],
    }
    return {
        gold = row.gold,
        whites = row.whites,
        npcHoles = row.npcHoles,
        pcHolesBySlot = pcHolesBySlot,
        originWorld = holeLocalToWorld(board, row.gold),
    }
end

--- @param a table local hole
--- @param b Vector world or local
--- @return number
local function localDistSq(a, b)
    local ax = tonumber(a.localX or a.x) or 0
    local az = tonumber(a.localZ or a.z) or 0
    local bx = tonumber(b.localX or b.x) or 0
    local bz = tonumber(b.localZ or b.z) or 0
    local dx = ax - bx
    local dz = az - bz
    return dx * dx + dz * dz
end

--- @param board Object
--- @param token Object
--- @return table local `{ x, y, z }`
local function tokenBoardLocal(board, token)
    local Board = require("core.npc_gameboard_board")
    local loc = Board.boardWorldToLocal(board, token.getPosition())
    return {
        x = loc.x or loc[1] or 0,
        y = loc.y or loc[2] or 0,
        z = loc.z or loc[3] or 0,
        localX = loc.x or loc[1] or 0,
        localY = loc.y or loc[2] or 0,
        localZ = loc.z or loc[3] or 0,
    }
end

--- Gold hole (calibrated) or parametric origin UV (pre-calibration) as a board-local point.
--- @param board Object
--- @param groupIndex number
--- @return table|nil
local function groupGoldLocal(board, groupIndex)
    if ScatterMode.groupIsCalibrated(groupIndex) then
        local holes = resolvedHoles(groupIndex, board)
        if holes ~= nil then
            return holes.gold
        end
    end
    local row = measuredArea(groupIndex)
    if row == nil or U.Type(row.origin) ~= "table" then
        return nil
    end
    local u = tonumber(row.origin.u)
    local v = tonumber(row.origin.v)
    if u == nil or v == nil then
        return nil
    end
    local Board = require("core.npc_gameboard_board")
    local lp = Board.boardLocalFromUv(board, u, v)
    return {
        x = lp.x or lp[1] or 0,
        y = lp.y or lp[2] or 0,
        z = lp.z or lp[3] or 0,
        localX = lp.x or lp[1] or 0,
        localY = lp.y or lp[2] or 0,
        localZ = lp.z or lp[3] or 0,
    }
end

--- Nearest of the six group gold origins (measured gold, or origin UV before calibration).
--- @param board Object
--- @param localPos table
--- @return number|nil groupIndex
local function nearestGroupIndex(board, localPos)
    local bestI = nil
    local bestD = nil
    for i = 1, ScatterLayout.groupCount() do
        local gold = groupGoldLocal(board, i)
        if gold ~= nil then
            local d = localDistSq(gold, localPos)
            if bestD == nil or d < bestD then
                bestD = d
                bestI = i
            end
        end
    end
    return bestI
end

local function scatterTokenScale()
    local s = scatterCfg().TOKEN_SCALE or { x = 0.5, y = 1, z = 0.5 }
    return tonumber(s.x) or 0.5, tonumber(s.y) or 1, tonumber(s.z) or 0.5
end

local function controlBoardSnapYawOffsetDeg()
    local row = DATA.CONTROL_BOARD_SEAT_ROW
    return tonumber(row and row.snapYawOffsetDeg) or 180
end

--- @param token Object
--- @param board Object
--- @param hole table
local function parkTokenOnHole(token, board, hole)
    if token == nil or hole == nil then
        return
    end
    local Board = require("core.npc_gameboard_board")
    local Tokens = require("core.npc_gameboard_tokens")
    local world = holeLocalToWorld(board, hole)
    token.setPosition(world)
    local sx, sy, sz = scatterTokenScale()
    if type(token.setScale) == "function" then
        token.setScale(Vector({ x = sx, y = sy, z = sz }))
    end
    local faceUp = Tokens.tokenRotationIsFaceUp(token) == true
    token.setRotation(Tokens.rotationForNpcControlToken(Board.objectYawDeg(board), controlBoardSnapYawOffsetDeg(), faceUp))
    if type(token.setLock) == "function" then
        token.setLock(false)
    end
    token.interactable = true
end

reapplyControlBoardCatalogVisibility = function()
    local O = require("core.objects")
    local Board = require("core.npc_gameboard_board")
    if type(O.applyActiveVisibility) ~= "function" then
        return
    end
    O.applyActiveVisibility(Board.getControlBoard())
    O.applyActiveVisibility(Board.getControlBoardPalette())
end

--- @param url string
--- @return boolean reloaded
local function applyControlBoardImage(url)
    if type(url) ~= "string" or url == "" then
        return false
    end
    local Board = require("core.npc_gameboard_board")
    local board = Board.getControlBoard()
    if not Board.isGameObject(board) or board.setCustomObject == nil or board.reload == nil then
        return false
    end
    local current = nil
    if board.getCustomObject ~= nil then
        local co = board.getCustomObject()
        if U.Type(co) == "table" and type(co.image) == "string" then
            current = co.image
        end
    end
    if lastAppliedBoardImageUrl == url or current == url then
        lastAppliedBoardImageUrl = url
        return false
    end
    local co = board.getCustomObject()
    if U.Type(co) ~= "table" then
        co = {}
    end
    board.setCustomObject({
        image = url,
        image_secondary = co.image_secondary or url,
        image_scalar = co.image_scalar,
    })
    -- Do not keep or use this userdata after reload(); TTS recreates the tile.
    board.reload()
    lastAppliedBoardImageUrl = url
    return true
end

--- @return boolean
local function controlBoardMeshReady()
    local Board = require("core.npc_gameboard_board")
    return Board.isMeshReady(Board.getControlBoard())
end

--- Wait until CONTROL_BOARD exists and is not `loading_custom`, then run `fn`.
--- @param fn function
local function runAfterControlBoardReady(fn)
    if type(fn) ~= "function" then
        return
    end
    boardReloadGeneration = boardReloadGeneration + 1
    local gen = boardReloadGeneration
    U.chain({
        function()
            return 0
        end,
        function()
            return function()
                if gen ~= boardReloadGeneration then
                    return true
                end
                return controlBoardMeshReady()
            end
        end,
        function()
            if gen ~= boardReloadGeneration then
                return
            end
            if not controlBoardMeshReady() then
                U.AlertGM("Scatter: CONTROL_BOARD did not finish reloading — board art or snaps may be stale.")
                return
            end
            fn()
        end,
    }, {
        sequenceTimeoutSeconds = CONTROL_BOARD_RELOAD_WAIT_SEC,
        onComplete = function(_ok, detail)
            if gen ~= boardReloadGeneration then
                return
            end
            if detail == "sequence_timeout" then
                U.AlertGM("Scatter: timed out waiting for CONTROL_BOARD after the board-art swap.")
            end
        end,
    })
end

local function appendDebugSnapPoint(points, hole)
    if hole == nil or type(points) ~= "table" then
        return
    end
    local lx = tonumber(hole.localX or hole.x)
    local ly = tonumber(hole.localY or hole.y) or 0.2
    local lz = tonumber(hole.localZ or hole.z)
    if lx == nil or lz == nil then
        return
    end
    points[#points + 1] = {
        position = { lx, ly, lz },
        rotation = { 0, controlBoardSnapYawOffsetDeg(), 0 },
        rotation_snap = true,
    }
end

--- Debug-only: snap points at every inferred hole so Snap mode can confirm calibration.
--- Scatter play still has no polar snaps; these exist only while a calibration dump is in memory.
applyDebugCalibrationSnapsIfAny = function()
    local Board = require("core.npc_gameboard_board")
    local board = Board.getControlBoard()
    if not Board.isMeshReady(board) or board.setSnapPoints == nil then
        return false
    end
    local points = {}
    for _, holes in pairs(debugHolesByGroup) do
        if U.Type(holes) == "table" then
            appendDebugSnapPoint(points, holes.gold)
            local whites = holes.whites or {}
            for i = 1, #whites do
                appendDebugSnapPoint(points, whites[i])
            end
            local npcHoles = holes.npcHoles or {}
            for i = 1, #npcHoles do
                appendDebugSnapPoint(points, npcHoles[i])
            end
        end
    end
    if #points < 1 then
        return false
    end
    board.setSnapPoints(points)
    return true
end

ScatterMode.applyDebugCalibrationSnapsIfAny = function()
    return applyDebugCalibrationSnapsIfAny()
end

--- Keep inferred holes for this group and install debug snaps (does not write D.SCATTER_BOARD).
--- @param groupIndex number
--- @param inferred table `{ gold, whites, npcHoles }`
--- @return boolean snapsInstalled
function ScatterMode.rememberDebugCalibrationHoles(groupIndex, inferred)
    local gi = math.floor(tonumber(groupIndex) or 0)
    if gi < 1 or U.Type(inferred) ~= "table" then
        return false
    end
    debugHolesByGroup[gi] = inferred
    return applyDebugCalibrationSnapsIfAny()
end

local function clearPolarSnaps()
    local Board = require("core.npc_gameboard_board")
    local Snaps = require("core.npc_gameboard_snaps")
    local board = Board.getControlBoard()
    if Board.isMeshReady(board) and board.setSnapPoints ~= nil then
        if applyDebugCalibrationSnapsIfAny() ~= true then
            board.setSnapPoints({})
        end
    end
    if type(Snaps.clearPolarSnapInstallFingerprint) == "function" then
        Snaps.clearPolarSnapInstallFingerprint()
    end
end

local function restorePolarSnaps()
    local Gameboard = require("core.npc_gameboard")
    if type(Gameboard.installPolarSnaps) == "function" then
        Gameboard.installPolarSnaps(nil, { force = true })
    end
end

local function hideAllPhysicalTables()
    local RSL = require("lib.rotational-seat-layout")
    if type(RSL.applyAllTablesVisualState) == "function" then
        RSL.applyAllTablesVisualState(nil, {})
    end
end

--- @return string[]
local function scatterObjectsToHideGuids()
    local list = scatterCfg().objectsToHide
    if U.Type(list) ~= "table" then
        return {}
    end
    local out = {}
    for i = 1, #list do
        local guid = list[i]
        if type(guid) == "string" and guid ~= "" then
            out[#out + 1] = guid
        end
    end
    return out
end

--- Park every `C.Scatter.objectsToHide` GUID via `O.hideObject`.
local function applyScatterObjectsToHide()
    local O = require("core.objects")
    local guids = scatterObjectsToHideGuids()
    for i = 1, #guids do
        local obj = G.getObject(guids[i])
        if obj ~= nil then
            O.hideObject(obj)
        end
    end
end

--- Restore scatter hide-list objects via `O.restoreObject`.
local function restoreScatterObjectsToHide()
    local O = require("core.objects")
    local guids = scatterObjectsToHideGuids()
    for i = 1, #guids do
        local obj = G.getObject(guids[i])
        if obj ~= nil and O.isHiddenObject(obj) then
            O.restoreObject(obj)
        end
    end
end

--- BOTTOM_FOG: TTS object state 2 while Scatter is active, state 1 otherwise.
--- Authored at y ≈ −350 — never park via `O.hideObject` (park-Y threshold would misfire).
--- @param scatterActive boolean
local function applyBottomFogState(scatterActive)
    local guid = G.GUIDS and G.GUIDS.BOTTOM_FOG
    if type(guid) ~= "string" or guid == "" then
        return
    end
    local obj = G.getObject(guid)
    if obj == nil then
        return
    end
    if type(obj.setState) ~= "function" then
        U.AlertGM("Scatter: BOTTOM_FOG has no setState.")
        return
    end
    obj.setState(scatterActive == true and 2 or 1)
end

--- THE_FLOOR + TABLE_PLINTH: visibility-only (stay at playfield Y). Scatter → hide from PC seats +
--- White/Grey; otherwise visible to everyone. Not `O.hideObject` (would bury at −200).
--- @param scatterActive boolean
local function applyScatterPlayfieldVisibility(scatterActive)
    local O = require("core.objects")
    local colors = {}
    if scatterActive == true then
        colors = U.clone(C.HideFromPcSeatsAndSpectators, false) or {
            "Brown", "Orange", "Red", "Pink", "Purple", "White", "Grey",
        }
    end
    local guids = { G.GUIDS.THE_FLOOR, G.GUIDS.TABLE_PLINTH }
    for i = 1, #guids do
        local guid = guids[i]
        if type(guid) == "string" and guid ~= "" then
            local obj = G.getObject(guid)
            if obj ~= nil and obj.setInvisibleTo ~= nil and O.isHiddenObject(obj) ~= true then
                obj.setInvisibleTo(colors)
            end
        end
    end
end

--- World chrome that follows Scatter active/inactive (fog state + floor/plinth visibility).
--- @param scatterActive boolean
local function applyScatterWorldChrome(scatterActive)
    applyBottomFogState(scatterActive)
    applyScatterPlayfieldVisibility(scatterActive)
end

--- Keep Y; write X/Z only.
--- @param guid string
--- @param x number
--- @param z number
local function setGuidXZ(guid, x, z)
    local obj = G.getObject(guid)
    if obj == nil or type(obj.getPosition) ~= "function" or type(obj.setPosition) ~= "function" then
        return
    end
    local pos = obj.getPosition()
    obj.setPosition({ x = x, y = pos.y, z = z })
end

--- Floor, plinth, and rain emitter already follow `C.Tables[*].centerPoint` on a normal table
--- switch. STAGE_BOARD does not — it is moved to Scatter's origin here and restored on leave.
local function applyScatterPlayfieldOrigin()
    local RSL = require("lib.rotational-seat-layout")
    local origin = ScatterLayout.centerPoint()
    if type(RSL.syncSharedFloorAndPlinthToTableOrigin) == "function" then
        RSL.syncSharedFloorAndPlinthToTableOrigin({ centerPoint = origin })
    end
    setGuidXZ(G.GUIDS.STAGE_BOARD, origin.x, origin.z)
    if type(RSL.applyTableConfigObjectPositions) == "function" then
        RSL.applyTableConfigObjectPositions(scatterCfg())
    end
end

local function restoreStageBoardHome()
    local home = scatterCfg().STAGE_BOARD_HOME_XZ
    local x = 0
    local z = 62.0977
    if U.Type(home) == "table" then
        x = tonumber(home.x or home[1]) or x
        z = tonumber(home.z or home[3]) or z
    end
    setGuidXZ(G.GUIDS.STAGE_BOARD, x, z)
end

local function hideChairForOccupant(occupantKey)
    local FSL = require("lib.figurine_seat_layout")
    local tag = occupantKey .. "Object"
    local objs = getObjectsWithTag(tag) or {}
    local SRI = require("lib.seat-role-identity")
    for i = 1, #objs do
        local obj = objs[i]
        if obj ~= nil and U.isGameObject(obj) then
            local disp = SRI.readRoleColorIdentity(obj)
            local roleKey = disp and SRI.parseRoleAndSuffix(disp) or nil
            if roleKey == "SEAT_CHAIR" then
                local O = require("core.objects")
                O.hideObject(obj)
            end
        end
    end
end

local function shortestSignedDelta(fromDeg, toDeg)
    local d = (tonumber(toDeg) or 0) - (tonumber(fromDeg) or 0)
    while d > 180 do
        d = d - 360
    end
    while d < -180 do
        d = d + 360
    end
    return d
end

--- Bury NPC1–4 chair piles (no table seats in Scatter).
local function hideNpcSeatPiles()
    local FSL = require("lib.figurine_seat_layout")
    for _, npc in ipairs(C.NPCSeats or {}) do
        FSL.setOccupantPileVisible(npc, false)
    end
end

--- @param groupIndex number
--- @return table occupiedSlots
local function occupiedPcSlots(groupIndex)
    local area = areaForGroup(groupIndex)
    local used = {}
    if U.Type(area.centerCharacters) == "table" then
        for _, row in pairs(area.centerCharacters) do
            if U.Type(row) == "table" then
                local slot = math.floor(tonumber(row.slot) or 0)
                if slot >= 1 and slot <= 5 then
                    used[slot] = true
                end
            end
        end
    end
    return used
end

--- @param groupIndex number
--- @return table<number, boolean> used npc hole slots 1..N
local function occupiedNpcHoleSlots(groupIndex)
    local area = areaForGroup(groupIndex)
    local used = {}
    local maxHole = boardNpcHoleCount()
    if U.Type(area.orbitCharacters) == "table" then
        for _, row in pairs(area.orbitCharacters) do
            if U.Type(row) == "table" then
                local slot = math.floor(tonumber(row.slot) or 0)
                if slot >= 1 and slot <= maxHole then
                    used[slot] = true
                end
            end
        end
    end
    return used
end

local function nextFreeNpcHoleSlot(groupIndex)
    local used = occupiedNpcHoleSlots(groupIndex)
    local maxHole = boardNpcHoleCount()
    for slot = 1, maxHole do
        if used[slot] ~= true then
            return slot
        end
    end
    return maxHole + 1
end

--- Sorted NPC keys in a group (by slot, then key) for world re-spacing.
--- @param groupIndex number
--- @return string[]
local function npcKeysInJoinOrder(groupIndex)
    local area = areaForGroup(groupIndex)
    local rows = {}
    if U.Type(area.orbitCharacters) == "table" then
        for npcKey, row in pairs(area.orbitCharacters) do
            if type(npcKey) == "string" then
                rows[#rows + 1] = {
                    key = npcKey,
                    slot = math.floor(tonumber(row and row.slot) or 9999),
                }
            end
        end
    end
    table.sort(rows, function(a, b)
        if a.slot ~= b.slot then
            return a.slot < b.slot
        end
        return a.key < b.key
    end)
    local keys = {}
    for i = 1, #rows do
        keys[i] = rows[i].key
    end
    return keys
end

--- Place stage NPC figurine + light at a computed scatter pose.
--- @param npcName string
--- @param pose table `{ position, rotation }`
--- @param lightMode string|nil
local function placeNpcAtScatterPose(npcName, pose, lightMode)
    local NPCS = require("core.npcs")
    if type(NPCS.moveNpcToScatterPose) == "function" then
        NPCS.moveNpcToScatterPose(npcName, pose, {
            npcLightMode = lightMode or "STANDARD",
            skipSeatSync = true,
        })
        return
    end
    U.AlertGM("Scatter: NPCS.moveNpcToScatterPose is missing — cannot pose " .. tostring(npcName))
end

--- @param tableSlot number packed slot key from applyWorldLayout
--- @return number world slot 1–5
local function worldSlotFromPackedTableSlot(tableSlot)
    return ((math.floor(tonumber(tableSlot) or 0) - 1) % 10) + 1
end

--- Direct figurine pose (same path as NPC scatter placement) before satellite layout.
--- @param color string
--- @param frame table `{ position, rotation }`
local function movePcFigurineToScatterPose(color, frame)
    if type(color) ~= "string" or U.Type(frame) ~= "table" then
        return
    end
    local guid = G.GUIDS and G.GUIDS["SEAT_FIGURE_" .. string.upper(color)]
    local fig = type(guid) == "string" and G.getObject(guid) or nil
    if fig == nil then
        return
    end
    local pos = Vector(frame.position)
    local rot = Vector(frame.rotation)
    local FSL = require("lib.figurine_seat_layout")
    local figOff = FSL.lookupOffset(color, "SEAT_FIGURE")
    if figOff ~= nil and tonumber(figOff.defaultY) ~= nil then
        pos = Vector({ x = pos.x, y = figOff.defaultY, z = pos.z })
    end
    fig.setPosition(pos)
    fig.setRotation(rot)
end

--- @param occupants table
--- @return table|nil occupant at packed world slot 3 (center)
local function centerOccupant(occupants)
    for i = 1, #occupants do
        if worldSlotFromPackedTableSlot(occupants[i].tableSlot) == 3 then
            return occupants[i]
        end
    end
    return occupants[1]
end

local function applyScatterPlayerCameras(occupants)
    local Main = require("core.main")
    if type(Main.setCamera) ~= "function" then
        return
    end
    for i = 1, #occupants do
        local color = occupants[i].occupantKey
        if type(color) == "string" and color ~= "" then
            Main.setCamera(color, "default")
        end
    end
end

local function applyPcRigs(framesBySlot, occupants)
    local FSL = require("lib.figurine_seat_layout")
    local RSL = require("lib.rotational-seat-layout")
    local tableA = C.Tables and C.Tables["Table A"] or nil
    local refFig = tableA and tableA.referenceFigurine or {
        position = Vector({ 0, ScatterLayout.floorY(), 0 }),
        rotation = Vector({ 0, 180, 0 }),
    }
    local center = ScatterLayout.centerPoint()
    local seatRigidByKey = {}
    local slot1Rigid = nil
    local packedFrames = {}
    for slot, frame in pairs(framesBySlot) do
        local yaw = tonumber(frame.rotation.y) or 0
        local refYaw = tonumber(refFig.rotation.y) or 180
        local deltaDeg = shortestSignedDelta(refYaw, yaw)
        local rigidCenter = center
        local groupIndex = math.floor(tonumber(frame.groupIndex) or 0)
        if groupIndex >= 1 then
            local P = ScatterLayout.pcGroupOrigin(groupIndex)
            if P ~= nil then
                rigidCenter = P
            end
        end
        local rotated = U.frameAfterRigidYawAboutCenter(rigidCenter, refFig, deltaDeg)
        local shift = Vector(frame.position) - Vector(rotated.position)
        --- Cameras must yaw about the same center used for this rigid (PC group origin), not World Origin.
        local rigid = { deltaDeg = deltaDeg, shift = shift, centerPoint = rigidCenter }
        local poseFrame = {
            position = Vector(frame.position),
            rotation = Vector(frame.rotation),
        }
        packedFrames[slot] = { frame = poseFrame, rigid = rigid }
        if worldSlotFromPackedTableSlot(slot) == 3 then
            slot1Rigid = rigid
        end
    end
    for i = 1, #occupants do
        local occ = occupants[i]
        local packed = packedFrames[occ.tableSlot]
        if packed ~= nil then
            movePcFigurineToScatterPose(occ.occupantKey, packed.frame)
            seatRigidByKey[occ.occupantKey] = packed.rigid
            if slot1Rigid == nil and worldSlotFromPackedTableSlot(occ.tableSlot) == 3 then
                slot1Rigid = packed.rigid
            end
        end
    end
    FSL.applyOccupantRigs({
        framesBySlot = packedFrames,
        occupants = occupants,
        seatRigidByKey = seatRigidByKey,
        slot1Rigid = slot1Rigid or { deltaDeg = 0, shift = Vector(0, 0, 0) },
        centerPoint = center,
    }, {
        moveHandZone = RSL.moveHandZoneAndContainedCards,
        skipRoleKeys = { SEAT_CHAIR = true },
    })
    for i = 1, #occupants do
        hideChairForOccupant(occupants[i].occupantKey)
    end
    hideNpcSeatPiles()
    local centerOcc = centerOccupant(occupants)
    local refKey = (centerOcc and centerOcc.occupantKey) or "Red"
    local computed = {
        referenceSeatKey = refKey,
        referencePlayerColor = refKey,
        seatRigidByKey = seatRigidByKey,
        slot1Rigid = slot1Rigid or seatRigidByKey[refKey] or { deltaDeg = 0, shift = Vector(0, 0, 0) },
        centerPoint = center,
        seatToPositionMap = {},
    }
    for i = 1, #occupants do
        computed.seatToPositionMap[occupants[i].occupantKey] = occupants[i].tableSlot
    end
    if type(RSL.applyCameraModesFromComputed) == "function" then
        RSL.applyCameraModesFromComputed(computed, { tableCfg = tableA })
    end
    applyScatterPlayerCameras(occupants)
end

--- Apply PC satellites + NPC stage poses from live scatterPlacements.
function ScatterMode.applyWorldLayout()
    local pack = livePlacements()
    local framesBySlot = {}
    local occupants = {}
    local occupiedColors = {}
    for i = 1, ScatterLayout.groupCount() do
        local area = pack[ScatterLayout.areaKeyForGroup(i)]
        local pcPoses = ScatterLayout.pcSlotPoses(i)
        local poseBySlot = {}
        if type(pcPoses) == "table" then
            for p = 1, #pcPoses do
                poseBySlot[pcPoses[p].slot] = pcPoses[p]
            end
        end
        if U.Type(area) == "table" and U.Type(area.centerCharacters) == "table" then
            for pcKey, row in pairs(area.centerCharacters) do
                local color = colorForPcKey(pcKey)
                local slot = math.floor(tonumber(row and row.slot) or 0)
                local pose = poseBySlot[slot]
                if color ~= nil and pose ~= nil then
                    occupiedColors[color] = true
                    framesBySlot[slot + (i - 1) * 10] = {
                        position = pose.position,
                        rotation = pose.rotation,
                        groupIndex = i,
                    }
                    occupants[#occupants + 1] = {
                        occupantKey = color,
                        tableSlot = slot + (i - 1) * 10,
                    }
                end
            end
        end
        local npcKeys = npcKeysInJoinOrder(i)
        local npcPoses = ScatterLayout.npcPoses(i, #npcKeys)
        for n = 1, #npcKeys do
            local pose = npcPoses[n]
            if pose ~= nil then
                placeNpcAtScatterPose(npcKeys[n], pose, "STANDARD")
            end
        end
    end
    local FSL = require("lib.figurine_seat_layout")
    if #occupants > 0 then
        applyPcRigs(framesBySlot, occupants)
    else
        for _, color in ipairs(C.PlayerColors or {}) do
            FSL.setOccupantPileVisible(color, false)
        end
        hideNpcSeatPiles()
    end
    for _, color in ipairs(C.PlayerColors or {}) do
        if occupiedColors[color] ~= true then
            FSL.setOccupantPileVisible(color, false)
        end
    end
    local NPCS = require("core.npcs")
    if type(NPCS.reconcilePreloadPoolHideFromState) == "function" then
        NPCS.reconcilePreloadPoolHideFromState()
    end
end

--- Park every control token that has a scatterPlacements row onto its hole.
function ScatterMode.parkTokensFromState()
    local Board = require("core.npc_gameboard_board")
    local Tokens = require("core.npc_gameboard_tokens")
    local board = Board.getControlBoard()
    if not Board.isMeshReady(board) then
        return
    end
    local pack = livePlacements()
    for i = 1, ScatterLayout.groupCount() do
        if not ScatterMode.groupIsCalibrated(i) then
            -- Keep tokens where they are until this group is calibrated.
        else
            local holes = resolvedHoles(i, board)
            local area = pack[ScatterLayout.areaKeyForGroup(i)]
            if holes ~= nil and U.Type(area) == "table" then
                if U.Type(area.centerCharacters) == "table" then
                    for pcKey, row in pairs(area.centerCharacters) do
                        local color = colorForPcKey(pcKey)
                        local slot = math.floor(tonumber(row and row.slot) or 0)
                        local hole = holes.pcHolesBySlot[slot]
                        if color ~= nil and hole ~= nil then
                            local token = nil
                            for _, obj in ipairs(getObjectsWithTag(DATA.TAG_PC_CONTROL_TOKEN) or {}) do
                                if Tokens.resolvePcTokenSeatColor(obj) == color then
                                    token = obj
                                    break
                                end
                            end
                            if token ~= nil then
                                parkTokenOnHole(token, board, hole)
                            end
                        end
                    end
                end
                if U.Type(area.orbitCharacters) == "table" then
                    for npcKey, row in pairs(area.orbitCharacters) do
                        local slot = math.floor(tonumber(row and row.slot) or 0)
                        local hole = holes.gold
                        if slot >= 1 and slot <= #(holes.npcHoles or {}) then
                            hole = holes.npcHoles[slot]
                        end
                        local token = Tokens.controlTokenForCharacterKey(npcKey)
                        if token ~= nil and hole ~= nil then
                            parkTokenOnHole(token, board, hole)
                        end
                    end
                end
            end
        end
    end
end

local boardFinishInProgress = false

finishScatterBoardAfterReload = function()
    if boardFinishInProgress then
        return
    end
    boardFinishInProgress = true
    clearPolarSnaps()
    applyScatterObjectsToHide()
    applyScatterWorldChrome(true)
    ScatterMode.parkTokensFromState()
    local Gameboard = require("core.npc_gameboard")
    if type(Gameboard.reconcileControlBoardFromState) == "function" then
        Gameboard.reconcileControlBoardFromState({ force = true })
    end
    boardFinishInProgress = false
end

finishStandardBoardAfterReload = function()
    if boardFinishInProgress then
        return
    end
    boardFinishInProgress = true
    restorePolarSnaps()
    applyScatterWorldChrome(false)
    local Gameboard = require("core.npc_gameboard")
    if type(Gameboard.reconcileControlBoardFromState) == "function" then
        Gameboard.reconcileControlBoardFromState({ force = true })
    end
    boardFinishInProgress = false
end

--- CONTROL_BOARD Scatter art + empty polar snaps (fingerprinted image; no reload when URL matches).
--- After a real `reload()`, snaps/token park wait until the new tile is mesh-ready.
function ScatterMode.applyBoardChrome()
    hideAllPhysicalTables()
    applyScatterObjectsToHide()
    applyScatterWorldChrome(true)
    local reloaded = applyControlBoardImage(scatterCfg().CONTROL_BOARD_IMAGE_SCATTER)
    if reloaded then
        runAfterControlBoardReady(finishScatterBoardAfterReload)
        return
    end
    if controlBoardMeshReady() then
        clearPolarSnaps()
    end
    reapplyControlBoardCatalogVisibility()
end

--- CONTROL_BOARD image, snaps, tables, tokens (fingerprinted image).
function ScatterMode.reconcileControlBoardFromState(board, opts)
    opts = opts or {}
    ScatterMode.applyBoardChrome()
    local Board = require("core.npc_gameboard_board")
    local live = Board.getControlBoard()
    if not Board.isMeshReady(live) then
        return
    end
    if opts.skipTokenPark ~= true then
        ScatterMode.parkTokensFromState()
    end
    local Reconcile = require("core.npc_gameboard_reconcile")
    if type(Reconcile.syncControlBoardSnapsToggleLabel) == "function" then
        Reconcile.syncControlBoardSnapsToggleLabel(live)
    end
    if type(Reconcile.syncControlBoardModeToolbar) == "function" then
        Reconcile.syncControlBoardModeToolbar(live)
    end
end

function ScatterMode.enter(opts)
    opts = opts or {}
    local Occupancy = require("lib.scatter_occupancy")
    if opts.translateFromStandard == true then
        Occupancy.prepareEnterFromStandard()
    end
    if opts.authored == true then
        S.setStateVal(true, "sessionScene", "scatterAuthored")
        S.setStateVal(nil, "seatLayout", "scatterRestore")
    end
    S.setStateVal("scatter", "sessionScene", "placementMode")
    S.setStateVal(ScatterMode.TABLE_KEY, "seatLayout", "currentTableKey")
    S.setStateVal(ScatterMode.TABLE_KEY, "sessionScene", "tableKey")
    S.setStateVal({}, "seatLayout", "occupiedNPCSlots")
    livePlacements()
    local npcWorld = S.getStateVal("sessionScene", "npcWorld")
    if U.Type(npcWorld) == "table" then
        npcWorld.placements = {}
    end
    applyScatterPlayfieldOrigin()
    ScatterMode.applyWorldLayout()
    applyScatterObjectsToHide()
    applyScatterWorldChrome(true)
    ScatterMode.applyBoardChrome()
    if controlBoardMeshReady() then
        ScatterMode.parkTokensFromState()
    end
end

function ScatterMode.leave(opts)
    opts = opts or {}
    restoreScatterObjectsToHide()
    applyScatterWorldChrome(false)
    debugHolesByGroup = {}
    restoreStageBoardHome()
    S.setStateVal("standard", "sessionScene", "placementMode")
    if S.getStateVal("seatLayout", "currentTableKey") == ScatterMode.TABLE_KEY then
        S.setStateVal(nil, "seatLayout", "currentTableKey")
    end
    local reloaded = applyControlBoardImage(scatterCfg().CONTROL_BOARD_IMAGE_STANDARD)
    if reloaded then
        runAfterControlBoardReady(finishStandardBoardAfterReload)
        return
    end
    restorePolarSnaps()
    reapplyControlBoardCatalogVisibility()
end

--- Control tokens actually on CONTROL_BOARD (box cast above the tile, plus tight surface fallback).
--- Palette tokens are never included. ST-initiated calibrate / Apply only — not drop.
--- @param board Object
--- @return table
local function controlTokensOnScatterBoard(board)
    local Board = require("core.npc_gameboard_board")
    local Tokens = require("core.npc_gameboard_tokens")
    local function isTok(obj)
        return Tokens.isPcControlToken(obj) == true or Tokens.isNpcControlToken(obj) == true
    end
    local seen = {}
    local out = {}
    local function add(obj)
        if obj == nil or obj.getGUID == nil then
            return
        end
        local g = obj.getGUID()
        if type(g) ~= "string" or seen[g] == true then
            return
        end
        seen[g] = true
        out[#out + 1] = obj
    end
    local above = Board.objectsAboveControlBoard(board, isTok)
    for i = 1, #(above or {}) do
        add(above[i])
    end
    for _, tag in ipairs({ DATA.TAG_PC_CONTROL_TOKEN, DATA.TAG_NPC_CONTROL_TOKEN }) do
        for _, obj in ipairs(getObjectsWithTag(tag) or {}) do
            if isTok(obj) and Board.isTokenOnMinimapTokenSurface(board, obj) then
                add(obj)
            end
        end
    end
    return out
end

ScatterMode.controlTokensOnScatterBoard = controlTokensOnScatterBoard

--- Apply NOW: read tokens on CONTROL_BOARD into scatterPlacements, then world layout.
function ScatterMode.applyFromControlBoard()
    local Board = require("core.npc_gameboard_board")
    local Tokens = require("core.npc_gameboard_tokens")
    local board = Board.getControlBoard()
    if not Board.isMeshReady(board) then
        return false, "CONTROL_BOARD not found"
    end
    local anyCalibrated = false
    for i = 1, ScatterLayout.groupCount() do
        if ScatterMode.groupIsCalibrated(i) then
            anyCalibrated = true
            break
        end
    end
    if not anyCalibrated then
        U.AlertGM("Scatter Apply: calibrate each group with DEBUG.calibrateScatterGroup(n) first.")
        return false, "scatter groups not calibrated"
    end
    local pack = ScatterLayout.emptyPlacements()
    S.setStateVal(pack, "sessionScene", "scatterPlacements")

    local function considerPc(token)
        if not Tokens.isPcControlToken(token) then
            return
        end
        local color = Tokens.resolvePcTokenSeatColor(token)
        local pcKey = color and pcKeyForColor(color) or nil
        if pcKey == nil then
            return
        end
        local loc = tokenBoardLocal(board, token)
        local gi = nearestGroupIndex(board, loc)
        if gi == nil then
            U.AlertGM("Scatter Apply: calibrate this group before parking PC tokens.")
            return
        end
        local holes = resolvedHoles(gi, board)
        if holes == nil then
            return
        end
        removeCharacterFromAllGroups(pcKey)
        local area = pack[ScatterLayout.areaKeyForGroup(gi)]
        local used = {}
        for _, row in pairs(area.centerCharacters) do
            if U.Type(row) == "table" then
                local s = math.floor(tonumber(row.slot) or 0)
                if s >= 1 and s <= 5 then
                    used[s] = true
                end
            end
        end
        -- Match drop handler: first PC → slot 3; joins pick the nearest *free* hole (not abort on gold).
        local slot = nil
        local bestD = nil
        for s, hole in pairs(holes.pcHolesBySlot) do
            if hole ~= nil and used[s] ~= true then
                local d = localDistSq(hole, loc)
                if bestD == nil or d < bestD then
                    bestD = d
                    slot = s
                end
            end
        end
        if slot == nil then
            slot = ScatterLayout.nextFreePcWorldSlot(used)
        end
        if slot == nil then
            U.AlertGM("Scatter Apply: group " .. tostring(gi) .. " already has five PCs.")
            return
        end
        area.centerCharacters[pcKey] = {
            slot = slot,
            isPlayingNPC = false,
            isPresent = true,
        }
    end

    local function considerNpc(token)
        if not Tokens.isNpcControlToken(token) then
            return
        end
        local npcKey = Tokens.resolveTokenCharacterKey(token)
        if type(npcKey) ~= "string" or npcKey == "" then
            return
        end
        local loc = tokenBoardLocal(board, token)
        local gi = nearestGroupIndex(board, loc)
        if gi == nil then
            U.AlertGM("Scatter Apply: calibrate this group before parking NPC tokens.")
            return
        end
        local holes = resolvedHoles(gi, board)
        if holes == nil then
            return
        end
        local bestSlot = nil
        local bestD = nil
        for slot = 1, #(holes.npcHoles or {}) do
            local d = localDistSq(holes.npcHoles[slot], loc)
            if bestD == nil or d < bestD then
                bestD = d
                bestSlot = slot
            end
        end
        local area = pack[ScatterLayout.areaKeyForGroup(gi)]
        if bestSlot ~= nil then
            for _, row in pairs(area.orbitCharacters) do
                if U.Type(row) == "table" and math.floor(tonumber(row.slot) or 0) == bestSlot then
                    bestSlot = nil
                    break
                end
            end
        end
        if bestSlot == nil then
            bestSlot = nextFreeNpcHoleSlot(gi)
        end
        area.orbitCharacters[npcKey] = {
            slot = bestSlot,
            npcLightMode = "STANDARD",
        }
    end

    for _, token in ipairs(controlTokensOnScatterBoard(board)) do
        considerPc(token)
        considerNpc(token)
    end

    ScatterMode.parkTokensFromState()
    ScatterMode.applyWorldLayout()
    local Sync = require("core.sync")
    Sync.npcs({ reason = "scatter_apply" })
    return true, nil
end

--- Drop branch: nearest group + assign stable slot + park. World wait for Apply.
--- @param token Object
--- @param isPc boolean
--- @return boolean handled
function ScatterMode.onControlTokenDropped(token, isPc)
    if not ScatterMode.isActive() then
        return false
    end
    local Board = require("core.npc_gameboard_board")
    local Tokens = require("core.npc_gameboard_tokens")
    local board = Board.getControlBoard()
    if not Board.isGameObject(board) or not Board.isTokenOverMinimapParchment(board, token) then
        return false
    end
    local loc = tokenBoardLocal(board, token)
    local gi = nearestGroupIndex(board, loc)
    if gi == nil then
        U.AlertGM("Scatter: could not match a group. Calibrate with DEBUG.calibrateScatterGroup(n).")
        return true
    end
    if not ScatterMode.groupIsCalibrated(gi) then
        U.AlertGM(
            "Scatter: calibrate group "
                .. tostring(gi)
                .. " with DEBUG.calibrateScatterGroup("
                .. tostring(gi)
                .. ") before auto-parking tokens."
        )
        return true
    end
    local holes = resolvedHoles(gi, board)
    if holes == nil then
        U.AlertGM("Scatter: calibrate group " .. tostring(gi) .. " before auto-parking tokens.")
        return true
    end
    if isPc then
        local color = Tokens.resolvePcTokenSeatColor(token)
        local pcKey = color and pcKeyForColor(color) or nil
        if pcKey == nil then
            return true
        end
        removeCharacterFromAllGroups(pcKey)
        local used = occupiedPcSlots(gi)
        local slot = ScatterLayout.nextFreePcWorldSlot(used)
        if slot == nil then
            U.AlertGM("Scatter group " .. tostring(gi) .. " already has five PCs.")
            return true
        end
        local area = areaForGroup(gi)
        area.centerCharacters[pcKey] = {
            slot = slot,
            isPlayingNPC = false,
            isPresent = true,
        }
        local hole = holes.pcHolesBySlot[slot]
        if hole ~= nil then
            parkTokenOnHole(token, board, hole)
        end
    else
        local npcKey = Tokens.resolveTokenCharacterKey(token)
        if type(npcKey) ~= "string" or npcKey == "" then
            return true
        end
        removeCharacterFromAllGroups(npcKey)
        local holeSlot = nextFreeNpcHoleSlot(gi)
        local area = areaForGroup(gi)
        area.orbitCharacters[npcKey] = {
            slot = holeSlot,
            npcLightMode = "STANDARD",
        }
        local hole = holes.gold
        if holeSlot >= 1 and holeSlot <= #(holes.npcHoles or {}) then
            hole = holes.npcHoles[holeSlot]
        end
        parkTokenOnHole(token, board, hole)
    end
    return true
end

--- Rotate `pt` around `gold` in world XZ (clockwise from above). CONTROL_BOARD is scaled
--- 2:1 (X vs Z); a circle in board-local units is an ellipse on the parchment, so derived
--- whites and NPC holes must be stepped in world space, then converted back with positionToLocal.
--- @param board Object
--- @param gold table
--- @param pt table
--- @param deg number
--- @return table
local function rotateWorldAroundGold(board, gold, pt, deg)
    local gW = holeLocalToWorld(board, gold)
    local pW = holeLocalToWorld(board, pt)
    local gx = gW.x or gW[1] or 0
    local gy = gW.y or gW[2] or 0
    local gz = gW.z or gW[3] or 0
    local dx = (pW.x or pW[1] or 0) - gx
    local dz = (pW.z or pW[3] or 0) - gz
    local r = math.sqrt(dx * dx + dz * dz)
    local az = math.deg(math.atan2(dx, dz))
    local rotated = U.rotateAroundPoint({ x = gx, y = gy, z = gz }, r, az + deg, gy)
    local Board = require("core.npc_gameboard_board")
    local loc = Board.boardWorldToLocal(board, rotated)
    local lx = loc.x or loc[1] or 0
    local ly = loc.y or loc[2] or 0
    local lz = loc.z or loc[3] or 0
    return {
        localX = lx,
        localY = ly,
        localZ = lz,
        x = lx,
        y = ly,
        z = lz,
    }
end

local function holeWithUv(board, localHole)
    local Board = require("core.npc_gameboard_board")
    local loc = Vector({
        x = localHole.localX,
        y = localHole.localY,
        z = localHole.localZ,
    })
    local u, v = Board.uvFromBoardLocal(board, loc)
    return {
        localX = localHole.localX,
        localY = localHole.localY,
        localZ = localHole.localZ,
        u = u,
        v = v,
    }
end

--- Infer whites + NPC ring from three measured anchors. Used by DEBUG.calibrateScatterGroup.
--- @param board Object
--- @param gold table
--- @param ulWhite table
--- @param topNpc table
--- @return table `{ gold, whites, npcHoles }`
function ScatterMode.inferHolesFromAnchors(board, gold, ulWhite, topNpc)
    local goldH = holeWithUv(board, gold)
    local whites = { holeWithUv(board, ulWhite) }
    for _, deg in ipairs({ 90, 180, 270 }) do
        whites[#whites + 1] = holeWithUv(board, rotateWorldAroundGold(board, gold, ulWhite, deg))
    end
    local npcHoles = {}
    local count = boardNpcHoleCount()
    local step = 360 / count
    for i = 0, count - 1 do
        npcHoles[#npcHoles + 1] = holeWithUv(board, rotateWorldAroundGold(board, gold, topNpc, i * step))
    end
    return {
        gold = goldH,
        whites = whites,
        npcHoles = npcHoles,
    }
end

--- Geometric sort of three board-local positions: shortest edge is gold–white;
--- of those two, gold is farther from the remaining (NPC) point. Independent of board yaw / art-up.
--- @param locals table[]
--- @return table gold, table ul, table topNpc
function ScatterMode.sortCalibrationLocals(locals)
    if type(locals) ~= "table" or #locals ~= 3 then
        error("scatter_mode: calibration needs exactly three local positions")
    end
    local function xzDistSq(a, b)
        local ax = tonumber(a.x or a.localX) or 0
        local az = tonumber(a.z or a.localZ) or 0
        local bx = tonumber(b.x or b.localX) or 0
        local bz = tonumber(b.z or b.localZ) or 0
        local dx = ax - bx
        local dz = az - bz
        return dx * dx + dz * dz
    end
    local pairA = { 1, 2 }
    local pairB = { 1, 3 }
    local pairC = { 2, 3 }
    local bestPair = pairA
    local bestD = xzDistSq(locals[1], locals[2])
    local d13 = xzDistSq(locals[1], locals[3])
    if d13 < bestD then
        bestD = d13
        bestPair = pairB
    end
    local d23 = xzDistSq(locals[2], locals[3])
    if d23 < bestD then
        bestPair = pairC
    end
    local npcIndex = 6 - bestPair[1] - bestPair[2]
    local npc = locals[npcIndex]
    local a = locals[bestPair[1]]
    local b = locals[bestPair[2]]
    local gold = a
    local ul = b
    if xzDistSq(a, npc) < xzDistSq(b, npc) then
        gold = b
        ul = a
    end
    return gold, ul, npc
end

--- Scatter group 1–6 when this NPC occupies a group (orbit, or a PC portraying them).
--- @param characterKey string|nil
--- @return number|nil
function ScatterMode.groupIndexForNpcCharacter(characterKey)
    if type(characterKey) ~= "string" or characterKey == "" then
        return nil
    end
    local pack = livePlacements()
    for i = 1, ScatterLayout.groupCount() do
        local area = pack[ScatterLayout.areaKeyForGroup(i)]
        if U.Type(area) == "table" then
            if U.Type(area.orbitCharacters) == "table" and area.orbitCharacters[characterKey] ~= nil then
                return i
            end
            if U.Type(area.centerCharacters) == "table" then
                for _, row in pairs(area.centerCharacters) do
                    if U.Type(row) == "table"
                        and row.isPlayingNPC == true
                        and row.characterKey == characterKey then
                        return i
                    end
                end
            end
        end
    end
    return nil
end

function ScatterMode.applyObjectsToHide()
    applyScatterObjectsToHide()
    applyScatterWorldChrome(true)
end

function ScatterMode.pcKeyForColor(color)
    return pcKeyForColor(color)
end

function ScatterMode.colorForPcKey(pcKey)
    return colorForPcKey(pcKey)
end

return ScatterMode
