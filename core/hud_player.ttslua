--- Player HUD (Right Sidebar + per-seat camera / location dock overlays) handlers
-- This module provides:
-- - Global UI event handlers referenced by `ui/player/panel_right_sidebar.xml` and `ui/player/panel_overlay_camera.xml` (generated from `ui/.templates/panel_overlay_camera.xml`)
-- - State-driven show/hide for core panels, reference panels, and right sidebar button active layers
-- - Click-and-hold behavior for non-nested reference panels (temporary overlays)
--
-- State paths (per plan):
-- - `playerData.hud.activeCorePanel` : "sheet" | nil
-- - `playerData.hud.reference.<key>` :
--    - nested: `princesCourt` is a table (nil = closed). A saved `coteries` table is closed.
--    - nestedless: booleans (true = persistent-open; currently defaults to false)
-- - `playerData.hud.reference.princesCourtPage` : 1|2|3 (default 1; persists while panel closed)
--
-- Agent guidance: .dev/HUDs & Overlays/Player HUD Overview.md; .dev/TESTING.md.

local U = require("lib.util")
local C = require("lib.constants")
local S = require("core.state")
local Main = require("core.main")
local L = require("core.lighting")
local ES = require("lib.effective_stats")
local PSC = require("lib.pc_sheet_collect")
local Coterie = require("core.coterie")

local HUDP = {}

-- PlayerID -> temporary nestedless reference panel key for click-and-hold
-- While this is set, Update will override the visible reference panel.
local tempHoldRefByPlayerID = {}

-- Seat color -> true while the location icon is hovered / held for site-hub overview.
local locationDockHoverBySeatColor = {}
local locationHubHoldBySeatColor = {}

--- Clear click-and-hold reference state that cannot survive a connection, cover transition, or
--- full XmlUI remount. With no seat, clears every player; otherwise clears only that seat.
--- @param seatColor string|nil
function HUDP.clearTemporaryReferenceHolds(seatColor)
    if type(seatColor) == "string" and seatColor ~= "" then
        local pid = S.getPlayerID(seatColor)
        if type(pid) == "string" and pid ~= "" then
            tempHoldRefByPlayerID[pid] = nil
        end
        locationDockHoverBySeatColor[seatColor] = nil
        locationHubHoldBySeatColor[seatColor] = nil
        return
    end
    tempHoldRefByPlayerID = {}
    locationDockHoverBySeatColor = {}
    locationHubHoldBySeatColor = {}
end

-- PlayerID -> currently hovered right-sidebar base button id (overlay is id.."_hover")
-- Used so UpdateUIDisplays doesn't wipe hover highlight.
local currentHoverBaseIdByPlayerID = {}


--- `gameStateOverlay_*` location dock stacked images: elementId -> last visibility bool.
local lastLocationDockUiCache = {}


--- Shared Court tracker attr cache (elementId .. "\0" .. attrName) -> last applied string (TOR-444).
local lastPrincesCourtTrackerUiAttrs = {}

--- panelSeatColor -> fingerprint of tracker inputs (skip XmlUI when unchanged; TOR-377).
local lastPrincesCourtTrackerFpByColumn = {}

--- Lua-side visibility unions for shared Court root + page panels (TOR-444).
--- Do not trust live UI.getAttribute after showTo/hideFrom — stale reads left prior spreads
--- active (e.g. page2 next still visible on the last double-page / pages 5–6).
local princesCourtRootAudience = {}
local princesCourtPageAudience = { {}, {}, {} }


--- Element id -> last applied custom UI `image` ref for location-dock cards.
local lastSiteCardImageByElementId = {}

--- @param s string|nil
--- @return string
local function trimHudKey(s)
    if type(s) ~= "string" then
        return ""
    end
    return string.gsub(string.gsub(s, "^%s+", ""), "%s+$", "")
end

--- Resolves the Custom UI `image` ref (`siteCard_<key>`) for `sessionScene.siteKey`.
--- Unknown or invalid `siteKey` returns nil (caller hides the site card without error).
--- @param siteKey string|nil
--- @return string|nil
local function resolveSiteCardImageRefForSiteKey(siteKey)
    if type(siteKey) ~= "string" then
        return nil
    end
    local sk = trimHudKey(siteKey)
    if sk == "" or type(C.Sites[sk]) ~= "table" then
        return nil
    end
    return "siteCard_" .. sk
end

--- Sets or clears the Custom UI `image` on a site card Image; skips redundant `UI.setAttribute` writes when setting a ref.
--- When clearing, writes `image=""` if a non-nil ref was previously applied for this element.
--- @param elementId string
--- @param imageRef string|nil
local function applySiteCardImageIfChanged(elementId, imageRef)
    if type(elementId) ~= "string" then
        return
    end
    local trimmed = nil
    if type(imageRef) == "string" then
        trimmed = trimHudKey(imageRef)
    end
    if trimmed == nil or trimmed == "" then
        if lastSiteCardImageByElementId[elementId] ~= nil then
            if UI ~= nil and UI.setAttribute ~= nil then
                UI.setAttribute(elementId, "image", "")
            end
        end
        lastSiteCardImageByElementId[elementId] = nil
        return
    end
    if lastSiteCardImageByElementId[elementId] == trimmed then
        return
    end
    if UI ~= nil and UI.setAttribute ~= nil then
        UI.setAttribute(elementId, "image", trimmed)
    end
    lastSiteCardImageByElementId[elementId] = trimmed
end


-- Allowed nestedless top-level reference keys (from the spec)
local NESTEDLESS_REF_KEYS = {
    chronicleTenets = true,
    rolls = true,
    socialCombat = true,
    physicalCombat = true,
    threats = true,
    frenzy = true,
    recovery = true,
    resonance = true,
    advantages = true,
    memoriam = true,
    projects = true,
    experience = true
}

--- Sets a UI element's `active` attribute.
-- @param elementID string
-- @param isActive boolean
local function setActive(elementID, isActive)
    if type(elementID) ~= "string" then
        return
    end
    U.setAttribute(elementID, "active", isActive and "true" or "false")
end

--- Shared nestedless ref audiences (TOR-444). refKey → { [seatColor] = true }
local nestedlessRefAudienceByKey = {}

--- Show/hide one shared nestedless ref Image for a seat via visibility unions.
-- Always writes showTo/hideFrom (change-guarded) so remounts that reset XML audience still heal.
-- @param refKey string
-- @param seatColor string
-- @param shouldShow boolean
local function applyNestedlessRefForSeat(refKey, seatColor, shouldShow)
    if type(refKey) ~= "string" or type(seatColor) ~= "string" then
        return
    end
    local elementID = "playerHud_refPanel_" .. refKey
    local aud = nestedlessRefAudienceByKey[refKey]
    if type(aud) ~= "table" then
        aud = {}
        nestedlessRefAudienceByKey[refKey] = aud
    end
    if shouldShow == true then
        aud[seatColor] = true
        U.showTo(elementID, seatColor)
        setActive(elementID, true)
        return
    end
    aud[seatColor] = nil
    U.hideFrom(elementID, seatColor)
    local any = false
    for _color, _flag in pairs(aud) do
        any = true
        break
    end
    if not any then
        setActive(elementID, false)
    end
end

--- Clamps Prince's Court reference page to 1–3.
-- @param page number|nil
-- @return number
local function normalizePrincesCourtPage(page)
    local n = math.floor(tonumber(page) or 1)
    if n < 1 then
        return 1
    end
    if n > 3 then
        return 3
    end
    return n
end

--- @param audienceSet table<string, boolean>
--- @return string[]
local function audienceSetToTokens(audienceSet)
    local tokens = {}
    if type(audienceSet) ~= "table" then
        return tokens
    end
    for _, col in ipairs(C.PlayerColors or {}) do
        if audienceSet[col] == true then
            tokens[#tokens + 1] = col
        end
    end
    return tokens
end

--- @param audienceSet table<string, boolean>
--- @return boolean
local function audienceSetNonEmpty(audienceSet)
    if type(audienceSet) ~= "table" then
        return false
    end
    for _, on in pairs(audienceSet) do
        if on == true then
            return true
        end
    end
    return false
end

--- Applies Prince's Court page panel visibility for one HUD seat (shared tree, TOR-444).
-- Three panels = three double-page spreads (facing pages 1–2 / 3–4 / 5–6). Page 1 has next only;
-- page 3 has prev only. Concurrent viewers may sit on different spreads via per-panel visibility unions.
-- @param seatColor string
-- @param showPanel boolean court reference open
-- @param page number 1|2|3
local function applyPrincesCourtPageVisibility(seatColor, showPanel, page)
    if type(seatColor) ~= "string" then
        return
    end
    local rootId = "playerHud_refPanel_princesCourt"
    local targetPage = normalizePrincesCourtPage(page)

    if showPanel == true then
        princesCourtRootAudience[seatColor] = true
    else
        princesCourtRootAudience[seatColor] = nil
    end
    U.setVisibleTo(rootId, audienceSetToTokens(princesCourtRootAudience))
    if audienceSetNonEmpty(princesCourtRootAudience) then
        setActive(rootId, true)
    else
        setActive(rootId, false)
    end

    for p = 1, 3 do
        local panelId = "playerHud_refPanel_PrincesCourt_page" .. p
        local aud = princesCourtPageAudience[p]
        local show = showPanel == true and p == targetPage
        if show then
            aud[seatColor] = true
        else
            aud[seatColor] = nil
        end
        U.setVisibleTo(panelId, audienceSetToTokens(aud))
        -- Visibility unions are the only audience authority. Do not UI.show / UI.hide:
        -- those re-apply XML defaults and can drop the gate, revealing the shared Court
        -- to every client until the sidebar is toggled (TOR-663).
        if audienceSetNonEmpty(aud) then
            setActive(panelId, true)
        else
            setActive(panelId, false)
        end
    end
end

--- Shows one Prince's Court page panel when the reference is open.
-- @param seatColor string
-- @param ref table|nil `playerData.hud.reference`
-- @param showPanel boolean
local function reconcilePrincesCourtPagesFromState(seatColor, ref, showPanel)
    if type(seatColor) ~= "string" then
        return
    end
    local page = normalizePrincesCourtPage(type(ref) == "table" and ref.princesCourtPage or nil)
    applyPrincesCourtPageVisibility(seatColor, showPanel, page)
end

--- Refresh Prince's Court page panels from persisted state for one seat.
-- @param seatColor string HUD owner seat
-- @param playerID string storage id
function HUDP.reconcilePrincesCourtPagesForSeat(seatColor, playerID)
    if type(seatColor) ~= "string" or type(playerID) ~= "string" or playerID == "" then
        return
    end
    local ref = S.getStateVal("playerData", playerID, "hud", "reference")
    local showPanel = type(ref) == "table" and type(ref.princesCourt) == "table"
    local page = normalizePrincesCourtPage(type(ref) == "table" and ref.princesCourtPage or nil)
    applyPrincesCourtPageVisibility(seatColor, showPanel, page)
end

--- Coalesce clear-then-fill pairs: last write wins per (id, attr).
-- @param updates table[]
-- @return table[] ordered entries { id, attributes }
-- @return string fingerprint of net desired attrs
local function coalescePrincesCourtTrackerUpdates(updates)
    local coalescedOrder = {}
    local coalescedById = {}
    if type(updates) ~= "table" then
        return coalescedOrder, ""
    end
    for _, u in ipairs(updates) do
        local id = u.id
        local attrs = u.attributes
        if type(id) == "string" and type(attrs) == "table" then
            local entry = coalescedById[id]
            if entry == nil then
                entry = { id = id, attributes = {} }
                coalescedById[id] = entry
                coalescedOrder[#coalescedOrder + 1] = entry
            end
            for attrName, attrVal in pairs(attrs) do
                entry.attributes[attrName] = attrVal
            end
        end
    end
    local fpParts = {}
    for i = 1, #coalescedOrder do
        local u = coalescedOrder[i]
        local attrs = u.attributes
        fpParts[#fpParts + 1] = u.id .. "=" .. tostring(attrs.active) .. "," .. tostring(attrs.image)
    end
    return coalescedOrder, table.concat(fpParts, "|")
end

--- Apply coalesced Prince's Court tracker diffs to Global UI (incremental cache).
-- @param coalesced table[]
local function applyCoalescedPrincesCourtTrackerUpdates(coalesced)
    if type(coalesced) ~= "table" then
        return
    end
    local cache = lastPrincesCourtTrackerUiAttrs
    for i = 1, #coalesced do
        local u = coalesced[i]
        local id = u.id
        local attrs = u.attributes
        for attrName, attrVal in pairs(attrs) do
            local cacheKey = id .. "\0" .. attrName
            local sval = tostring(attrVal)
            if cache[cacheKey] ~= sval then
                U.setAttribute(id, attrName, sval)
                cache[cacheKey] = sval
            end
        end
    end
end

--- @return boolean true if any PC HUD has Prince's Court open on page 1
local function anyHudHasPrincesCourtPage1()
    for _, seatColor in ipairs(C.PlayerColors or {}) do
        local pid = S.getPlayerID(seatColor)
        if type(pid) == "string" and pid ~= "" then
            local ref = S.getStateVal("playerData", pid, "hud", "reference")
            if type(ref) == "table" and type(ref.princesCourt) == "table"
                and normalizePrincesCourtPage(ref.princesCourtPage) == 1 then
                return true
            end
        end
    end
    return false
end

--- Resolve stats-backed tracker visibility for one Prince's Court column (shared tree).
-- @param panelSeatColor string column seat (Purple, Pink, …)
local function reconcilePrincesCourtTrackerColumn(panelSeatColor)
    if type(panelSeatColor) ~= "string" then
        return
    end
    local pid = S.getPlayerID(panelSeatColor)
    local updates
    if type(pid) == "string" and pid ~= "" then
        local ctx = ES.forPlayer(pid)
        updates = PSC.collectPrincesCourtTrackerUpdates(ctx.stats, ctx.statChanges, panelSeatColor, nil)
    else
        updates = PSC.collectPrincesCourtTrackerUpdates(nil, nil, panelSeatColor, nil)
    end
    local coalesced, fp = coalescePrincesCourtTrackerUpdates(updates)
    if lastPrincesCourtTrackerFpByColumn[panelSeatColor] == fp then
        return
    end
    applyCoalescedPrincesCourtTrackerUpdates(coalesced)
    lastPrincesCourtTrackerFpByColumn[panelSeatColor] = fp
end

--- Refresh all five tracker columns on the shared Prince's Court page 1.
-- @param hudSeatColor string|nil ignored (kept for call-site compat)
function HUDP.reconcilePrincesCourtTrackersForHudSeat(hudSeatColor)
    for _, panelSeatColor in ipairs(C.PlayerColors or {}) do
        reconcilePrincesCourtTrackerColumn(panelSeatColor)
    end
end

--- Refresh one tracker column after that seat's CSHEET refresh (shared tree).
-- @param panelSeatColor string
function HUDP.reconcilePrincesCourtTrackersForPanelSeat(panelSeatColor)
    if type(panelSeatColor) ~= "string" then
        return
    end
    if not anyHudHasPrincesCourtPage1() then
        return
    end
    reconcilePrincesCourtTrackerColumn(panelSeatColor)
end

--- Refresh the full Prince's Court tracker grid.
function HUDP.reconcileAllPrincesCourtTrackers()
    HUDP.reconcilePrincesCourtTrackersForHudSeat(nil)
end

--- After Global `UI.setXml`, Court pages and tracker dots are the baked defaults again, and the
--- tracker caches still hold the pre-remount values so a normal reconcile would skip them.
function HUDP.reapplyPrincesCourtAfterXmlRemount()
    lastPrincesCourtTrackerUiAttrs = {}
    lastPrincesCourtTrackerFpByColumn = {}
    princesCourtRootAudience = {}
    princesCourtPageAudience = { {}, {}, {} }
    for _, seatColor in ipairs(C.PlayerColors or {}) do
        local pid = S.getPlayerID(seatColor)
        if type(pid) == "string" and pid ~= "" then
            HUDP.reconcilePrincesCourtPagesForSeat(seatColor, pid)
        end
    end
    if anyHudHasPrincesCourtPage1() then
        HUDP.reconcileAllPrincesCourtTrackers()
    end
end

--- Sets right-sidebar button chrome via XmlUI `color` on the base Image (TOR-444).
-- Priority: active > hover > idle. No `_hover` / `_active` sibling Images.
local SIDEBAR_BTN_COLOR_IDLE = "#C9C9C9"
local SIDEBAR_BTN_COLOR_HOVER = "#FFFFFF"
local SIDEBAR_BTN_COLOR_ACTIVE = "#C00000"
local lastSidebarBtnColorById = {}

--- @param elementID string base button id (no _hover/_active suffix)
--- @param isActive boolean
--- @param isHovered boolean
local function applySidebarButtonChrome(elementID, isActive, isHovered)
    if type(elementID) ~= "string" then
        return
    end
    local color = SIDEBAR_BTN_COLOR_IDLE
    if isActive == true then
        color = SIDEBAR_BTN_COLOR_ACTIVE
    elseif isHovered == true then
        color = SIDEBAR_BTN_COLOR_HOVER
    end
    if lastSidebarBtnColorById[elementID] == color then
        return
    end
    lastSidebarBtnColorById[elementID] = color
    U.setAttribute(elementID, "color", color)
end

--- Whether a right-sidebar base button id is in the "active" chrome state for this seat.
-- @param playerID string
-- @param seatColor string|nil
-- @param baseId string
-- @return boolean
local function sidebarButtonIsActive(playerID, seatColor, baseId)
    if type(playerID) ~= "string" or type(baseId) ~= "string" or type(seatColor) ~= "string" then
        return false
    end
    local pData = S.getPlayerData and S.getPlayerData(playerID) or nil
    if type(pData) ~= "table" or type(pData.hud) ~= "table" then
        return false
    end
    local hud = pData.hud
    local ref = hud.reference
    if type(ref) ~= "table" then
        return false
    end
    local tempRefKey = tempHoldRefByPlayerID[playerID]
    local showRefKey = nil
    if type(tempRefKey) == "string" then
        showRefKey = tempRefKey
    elseif type(ref.princesCourt) == "table" then
        showRefKey = "princesCourt"
    else
        for k, _ in pairs(NESTEDLESS_REF_KEYS) do
            if ref[k] == true then
                showRefKey = k
                break
            end
        end
    end
    if type(showRefKey) ~= "string" then
        return false
    end
    return baseId == ("playerHud_RSidebarBtn_ref_" .. showRefKey .. "_" .. seatColor)
end


--- Location-dock stacked images. Off uses active="false" so TTS skips the subtree.
-- @param elementID string
-- @param isVisible boolean
local function setMapStackImageVisibility(elementID, isVisible)
    if type(elementID) ~= "string" or type(isVisible) ~= "boolean" then
        return
    end
    if isVisible then
        U.setAttribute(elementID, "active", "true")
        U.setAttribute(elementID, "color", "#FFFFFF")
    else
        U.setAttribute(elementID, "active", "false")
    end
end


--- Location dock (`panel_overlay_location.xml`): incremental stacked Image visibility.
-- @param elementID string
-- @param desired boolean
-- @param applyFn function(elementID, isVisible)
local function applyLocationDockCachedBool(elementID, desired, applyFn)
    if type(elementID) ~= "string" or type(desired) ~= "boolean" or type(applyFn) ~= "function" then
        return
    end
    if lastLocationDockUiCache[elementID] == desired then
        return
    end
    applyFn(elementID, desired)
    lastLocationDockUiCache[elementID] = desired
end

--- Live session site key for location-dock art (district / site / hub).
--- @return string trimmed siteKey, or ""
local function resolveLocationDockSiteKey()
    return trimHudKey(S.getStateVal("sessionScene", "siteKey"))
end

--- @param seatColor string
--- @return string|nil `siteHub_<stem>` when the live site is in a known hub
local function resolveLocationDockHubImageRef(seatColor)
    if type(seatColor) ~= "string" then
        return nil
    end
    local sessionS = resolveLocationDockSiteKey()
    if sessionS == "" then
        return nil
    end
    if type(C.resolveSiteHubImageRefForSiteKey) ~= "function" then
        return nil
    end
    return C.resolveSiteHubImageRefForSiteKey(sessionS)
end

--- Per-seat location popout: district + site cards on hover; site hub overview while held (hub sites only).
-- @param seatColor string HUD owner seat
local function reconcileLocationDockCardsFromState(seatColor)
    if type(seatColor) ~= "string" then
        return
    end
    local dockDistrictId = "gameStateOverlay_districtCard_current_" .. seatColor
    local dockSiteId = "gameStateOverlay_siteCard_current_" .. seatColor
    local dockHubId = "gameStateOverlay_siteHub_current_" .. seatColor
    local hubRef = resolveLocationDockHubImageRef(seatColor)
    local showHub = locationHubHoldBySeatColor[seatColor] == true and type(hubRef) == "string"

    if showHub then
        applySiteCardImageIfChanged(dockDistrictId, nil)
        applyLocationDockCachedBool(dockDistrictId, false, setMapStackImageVisibility)
        applySiteCardImageIfChanged(dockSiteId, nil)
        applyLocationDockCachedBool(dockSiteId, false, setMapStackImageVisibility)
        applySiteCardImageIfChanged(dockHubId, hubRef)
        applyLocationDockCachedBool(dockHubId, true, setMapStackImageVisibility)
        return
    end

    applySiteCardImageIfChanged(dockHubId, nil)
    applyLocationDockCachedBool(dockHubId, false, setMapStackImageVisibility)

    local sessionD = trimHudKey(S.getStateVal("sessionScene", "districtKey"))
    if sessionD == "" or type(C.Districts) ~= "table" or type(C.Districts[sessionD]) ~= "table" then
        applySiteCardImageIfChanged(dockDistrictId, nil)
        applyLocationDockCachedBool(dockDistrictId, false, setMapStackImageVisibility)
    else
        applySiteCardImageIfChanged(dockDistrictId, "districtCard_" .. sessionD)
        applyLocationDockCachedBool(dockDistrictId, true, setMapStackImageVisibility)
    end
    local sessionS = resolveLocationDockSiteKey()
    local dockRef = (sessionS ~= "") and resolveSiteCardImageRefForSiteKey(sessionS) or nil
    if type(dockRef) ~= "string" then
        applySiteCardImageIfChanged(dockSiteId, nil)
        applyLocationDockCachedBool(dockSiteId, false, setMapStackImageVisibility)
    else
        applySiteCardImageIfChanged(dockSiteId, dockRef)
        applyLocationDockCachedBool(dockSiteId, true, setMapStackImageVisibility)
    end
end

--- Returns the storage player id and seat color for a given `player`.
-- Storage id (steam / host id) is authoritative for `gameState.playerData` keys.
-- TTS `player.color` is the current seat; `pData.color` is the assigned chronicle seat and may differ during testing.
-- @param player Player|string
-- @return string|nil playerID
-- @return string|nil color TTS seat when available, else stored `pData.color`
local function getPlayerIDAndColor(player)
    if player == nil then
        return nil, nil
    end
    local playerID = S.getStorageID and S.getStorageID(player) or nil
    if not playerID then
        playerID = S.getPlayerID and S.getPlayerID(player) or nil
    end
    local color = nil
    if type(player) == "userdata" and player.color then
        color = tostring(player.color)
    end
    if color == nil then
        local pData = S.getPlayerData and S.getPlayerData(player) or nil
        if type(pData) == "table" then
            color = pData.color
        end
    end
    if type(color) ~= "string" then
        color = nil
    end
    return playerID, color
end

--- Parses right sidebar base button id to determine what action it represents.
-- @param id string
-- @param color string
-- @return table|nil { kind = "core"|"reference", coreKey = "sheet" } or { kind="reference", refKey=..., nested=bool }
local function parseRightSidebarId(id, color)
    if type(id) ~= "string" then
        return nil
    end

    if id:find("_core_sheet_") ~= nil then
        return { kind = "core", coreKey = "sheet" }
    end

    if id:find("_ref_princesCourt_") ~= nil then
        return { kind = "reference", refKey = "princesCourt", nested = true }
    end

    -- Nestedless / other references: extract between "playerHud_RSidebarBtn_ref_" and "_<Color>"
    local refPrefix = "playerHud_RSidebarBtn_ref_"
    local suffix = "_" .. tostring(color or "")
    if color and id:sub(1, #refPrefix) == refPrefix and id:sub(-#suffix) == suffix then
        local refKey = id:sub(#refPrefix + 1, #id - #suffix)
        if NESTEDLESS_REF_KEYS[refKey] == true then
            return { kind = "reference", refKey = refKey, nested = false }
        end
    end

    return nil
end


--- Parses the HUD owner seat color from a Prince's Court nav button id suffix.
-- @param id string
-- @return string|nil
local function parseSeatColorFromPrincesCourtNavId(id)
    if type(id) ~= "string" then
        return nil
    end
    for _, col in ipairs(C.PlayerColors or {}) do
        local suffix = "_" .. col
        if #id > #suffix and id:sub(-#suffix) == suffix then
            return col
        end
    end
    return nil
end

--- Parses target page from shared Court nav id: `playerHud_navigate_page<N>_(prev|next)`.
-- @param id string
-- @return number|nil
local function parsePrincesCourtTargetPageFromNavigateId(id)
    if type(id) ~= "string" then
        return nil
    end
    local prefix = "playerHud_navigate_page"
    if id:sub(1, #prefix) ~= prefix then
        return nil
    end
    local rest = id:sub(#prefix + 1)
    local underscorePos = rest:find("_", 1, true)
    if underscorePos == nil or underscorePos <= 1 then
        return nil
    end
    local fromPageStr = rest:sub(1, underscorePos - 1)
    local direction = rest:sub(underscorePos + 1)
    if direction ~= "prev" and direction ~= "next" then
        return nil
    end
    local fromPage = tonumber(fromPageStr)
    if fromPage == nil then
        return nil
    end
    local delta = direction == "prev" and -1 or 1
    return normalizePrincesCourtPage(fromPage + delta)
end

--- Shows/hides the UI for one player.
-- - Core panels: controlled by `playerData.hud.activeCorePanel`
-- - Reference panels: only one visible at a time
-- - Right sidebar button active layers: mirror the currently-visible panel
-- @param player Player
-- @param color string
function HUDP.updatePlayerUI(player, color)
    local playerID, resolvedColor = getPlayerIDAndColor(player)
    local seatColor = color or resolvedColor
    if not playerID or type(seatColor) ~= "string" then
        return
    end

    local pData = S.getPlayerData and (S.getPlayerData(playerID) or S.getPlayerData(player)) or nil
    if type(pData) ~= "table" or type(pData.hud) ~= "table" or type(pData.hud.reference) ~= "table" then
        return
    end

    local hud = pData.hud
    local ref = hud.reference

    local currentHoverBaseId = currentHoverBaseIdByPlayerID[playerID]

    -- Apply temporary nestedless hold override (click-and-hold)
    local tempRefKey = tempHoldRefByPlayerID[playerID]
    local showRefKey = nil
    if type(tempRefKey) == "string" then
        showRefKey = tempRefKey
    else
        -- Persistent nested reference panels. A saved coteries menu is closed.
        if type(ref.princesCourt) == "table" then
            showRefKey = "princesCourt"
        else
            -- Persistent nestedless reference panels (currently default false)
            local orderedKeys = {
                "chronicleTenets",
                "socialCombat",
                "physicalCombat",
                "frenzy",
                "rolls",
                "memoriam",
                "projects",
                "experience"
            }
            for _, k in ipairs(orderedKeys) do
                if ref[k] == true then
                    showRefKey = k
                    break
                end
            end
        end
    end

    -- Core panels. A saved "map" panel is treated as closed.
    local activeCore = hud.activeCorePanel
    if activeCore == "map" then
        activeCore = nil
    end
    setActive("playerHud_corePanel_sheet_" .. seatColor, activeCore == "sheet")

    reconcileLocationDockCardsFromState(seatColor)

    -- Top-level reference panels
    local showPrincesCourtRef = showRefKey == "princesCourt"
    reconcilePrincesCourtPagesFromState(seatColor, ref, showPrincesCourtRef)
    if showPrincesCourtRef and normalizePrincesCourtPage(ref.princesCourtPage) == 1 then
        HUDP.reconcilePrincesCourtTrackersForHudSeat(seatColor)
    end
    Coterie.reconcileForHudSeat(seatColor)

    for refKey, _ in pairs(NESTEDLESS_REF_KEYS) do
        applyNestedlessRefForSeat(refKey, seatColor, showRefKey == refKey)
    end

    -- Right sidebar chrome: tint base Images (active > hover > idle). TOR-444.
    local function chrome(baseId, isActive)
        applySidebarButtonChrome(baseId, isActive == true, currentHoverBaseId == baseId)
    end
    chrome("playerHud_RSidebarBtn_ref_princesCourt_" .. seatColor, showRefKey == "princesCourt")
    for refKey, _ in pairs(NESTEDLESS_REF_KEYS) do
        chrome("playerHud_RSidebarBtn_ref_" .. refKey .. "_" .. seatColor, showRefKey == refKey)
    end

    -- Camera overlay: one row per other PC seat when that seat is occupied (see `ui/.templates/panel_overlay_camera.xml`).
    for _, rowSeat in ipairs(C.PlayerColors or {}) do
        local rowId = "cameraControls_otherControls" .. rowSeat .. "_" .. seatColor
        if rowSeat == seatColor then
            setActive(rowId, false)
        else
            local otherPid = S.getPlayerID(rowSeat)
            local occupied = type(otherPid) == "string" and otherPid ~= ""
            setActive(rowId, occupied)
        end
    end
end


--- Shows/updates all players.
function HUDP.updateAllUI()
    Main.forPlayers(function(player, color)
        HUDP.updatePlayerUI(player, color)
    end)
end

--- One-shot during first `Sync.full` bootstrap: `panel_overlay_camera.xml` defaults every
--- `cameraControls_otherControls<Row>_<Hud>` row to active so the generator stays simple.
--- Turn off diagonal ids (`cameraControls_otherControlsPink_Pink`, etc.) so a seat never sees
--- their own row in the "other players" column before `HUDP.updatePlayerUI` runs.
function HUDP.reconcileCameraOverlaySelfMatchRowsFromXmlDefaults()
    if UI == nil or UI.setAttribute == nil then
        return
    end
    for _, seat in ipairs(C.PlayerColors or {}) do
        local rowId = "cameraControls_otherControls" .. seat .. "_" .. seat
        U.setAttribute(rowId, "active", "false")
    end
end

--- Parses `cameraControl_*_<seatColor>` id into a `Main.setCamera` mode key (per-seat or suffixed universal).
-- @param id string
-- @param seatColor string HUD owner seat (Brown, Orange, …)
-- @return string|nil
local function parseCameraControlIdToMode(id, seatColor)
    if type(id) ~= "string" or type(seatColor) ~= "string" then
        return nil
    end
    local suffix = "_" .. seatColor
    if id:sub(-#suffix) ~= suffix then
        return nil
    end
    local head = "cameraControl_"
    if id:sub(1, #head) ~= head then
        return nil
    end
    local body = id:sub(#head + 1, #id - #suffix)
    if body == "default" then
        return "default"
    end
    if body == "diceTray" then
        return "diceTray"
    end
    if body == "sheet" then
        return "sheet"
    end
    if body:sub(1, #"dice") == "dice" then
        local otherSeat = body:sub(#"dice" + 1)
        if otherSeat ~= "" and U.isIn(otherSeat, C.PlayerColors) then
            return "diceTray" .. otherSeat
        end
    end
    if body:sub(1, #"sheet") == "sheet" then
        local otherSeat = body:sub(#"sheet" + 1)
        if otherSeat ~= "" and U.isIn(otherSeat, C.PlayerColors) then
            return "sheet" .. otherSeat
        end
    end
    return nil
end

--- @param id string e.g. `popout_cameraPanel_Red`
--- @return string|nil
local function parseSeatColorFromPopoutCameraId(id)
    if type(id) ~= "string" then
        return nil
    end
    local prefix = "popout_cameraPanel_"
    if id:sub(1, #prefix) ~= prefix then
        return nil
    end
    local col = id:sub(#prefix + 1)
    if col == "" or not U.isIn(col, C.PlayerColors) then
        return nil
    end
    return col
end

--- TTS Image tint: `color` rgba (see `ui/player/panel_overlays_defaults.xml` `alpha_control`).
local CAMERA_ALPHA_CONTROL_RGBA_FULL = "rgba(1, 1, 1, 1)"
local CAMERA_ALPHA_CONTROL_RGBA_IDLE = "rgba(1, 1, 1, 0.15)"

--- After closing the camera picker, force idle tint on inner `alpha_control` buttons
--- (hover can leave a control at full opacity without a matching mouse exit).
--- `popout_cameraPanel_*` stays full-alpha always (blocks TTS chrome the author wants blocked).
--- @param seatColor string HUD owner seat (Brown, Orange, …)
local function resetCameraOverlayAlphaTintsForSeat(seatColor)
    if type(seatColor) ~= "string" or UI == nil or UI.setAttributes == nil then
        return
    end
    local idle = { color = CAMERA_ALPHA_CONTROL_RGBA_IDLE }
    local ids = {
        "cameraControl_default_" .. seatColor,
        "cameraControl_diceTray_" .. seatColor,
        "cameraControl_sheet_" .. seatColor,
    }
    for _, rowSeat in ipairs(C.PlayerColors or {}) do
        ids[#ids + 1] = "cameraControl_dice" .. rowSeat .. "_" .. seatColor
        ids[#ids + 1] = "cameraControl_sheet" .. rowSeat .. "_" .. seatColor
    end
    for _, elemId in ipairs(ids) do
        U.setAttributes(elemId, idle)
    end
    U.setAttributes("popout_cameraPanel_" .. seatColor, { color = CAMERA_ALPHA_CONTROL_RGBA_FULL })
end

--- @param seatColor string
local function setCameraControlsPanelExpanded(seatColor, expanded)
    if type(seatColor) ~= "string" then
        return
    end
    setActive("playerHud_overlay_cameraControls_" .. seatColor, expanded)
    if expanded == false then
        resetCameraOverlayAlphaTintsForSeat(seatColor)
    end
end

--- Overlay camera icon: quick left-click snaps to default; hold 1s opens the picker (TOR-597).
local CAMERA_PICKER_HOLD_SEC = 1
local cameraPickerHoldGenBySeat = {}
--- "pending" while the button is held; "opened" after the 1s picker hold fires.
local cameraPickerHoldStateBySeat = {}

local function isOverlayCameraRightClick(value)
    return value == "-2" or value == -2
end

local function bumpCameraPickerHold(seatColor)
    local nextGen = (cameraPickerHoldGenBySeat[seatColor] or 0) + 1
    cameraPickerHoldGenBySeat[seatColor] = nextGen
    return nextGen
end

--- Right-click cycle through occupied polar stage areas (TOR-538 / TOR-562). Apply resets this.
local stageLookCycleIndexBySeat = {}

local STAGE_LOOK_AREA_ORDER = {
    "Center",
    "Center Left",
    "Center Right",
    "Mid Center",
    "Mid Left",
    "Mid Right",
    "Far Center-Left",
    "Far Center-Right",
    "Far Left",
    "Far Right",
}

function HUDP.resetStageLookCycle()
    stageLookCycleIndexBySeat = {}
end

--- @param catalog table[]
--- @param ringIndex number
--- @return table[] `{ familyId, u }`
local function polarFamiliesOnRingByU(catalog, ringIndex)
    local seen = {}
    local rows = {}
    for i = 1, #catalog do
        local entry = catalog[i]
        if type(entry) == "table"
            and type(entry.familyId) == "string"
            and entry.familyId ~= ""
            and tonumber(entry.ringIndex) == ringIndex
        then
            if seen[entry.familyId] ~= true then
                seen[entry.familyId] = true
                local u = tonumber(entry.u)
                if entry.isAnchor == true then
                    u = tonumber(entry.u)
                end
                rows[#rows + 1] = { familyId = entry.familyId, u = u or 0.5 }
            end
        end
    end
    for i = 1, #rows do
        local familyId = rows[i].familyId
        for j = 1, #catalog do
            local entry = catalog[j]
            if type(entry) == "table" and entry.familyId == familyId and entry.isAnchor == true then
                rows[i].u = tonumber(entry.u) or rows[i].u
                break
            end
        end
    end
    table.sort(rows, function(a, b)
        if math.abs(a.u - b.u) > 1e-6 then
            return a.u < b.u
        end
        return a.familyId < b.familyId
    end)
    return rows
end

--- @param catalog table[]
--- @param familyId string
--- @return string|nil named polar area
local function polarAreaNameForFamily(catalog, familyId)
    local ring = nil
    local u = 0.5
    for i = 1, #catalog do
        local entry = catalog[i]
        if type(entry) == "table" and entry.familyId == familyId then
            ring = tonumber(entry.ringIndex)
            if entry.isAnchor == true then
                u = tonumber(entry.u) or u
                break
            end
            u = tonumber(entry.u) or u
        end
    end
    if ring == 3 then
        return "Far Left"
    end
    if ring == 6 then
        return "Far Right"
    end
    if ring == 4 then
        return "Far Center-Left"
    end
    if ring == 5 then
        return "Far Center-Right"
    end
    if ring == 1 or ring == 2 then
        local rows = polarFamiliesOnRingByU(catalog, ring)
        local centerId = nil
        local centerU = 0.5
        local bestDist = math.huge
        for i = 1, #rows do
            local dist = math.abs(rows[i].u - 0.5)
            if dist < bestDist then
                bestDist = dist
                centerId = rows[i].familyId
                centerU = rows[i].u
            end
        end
        if familyId == centerId then
            if ring == 1 then
                return "Center"
            end
            return "Mid Center"
        end
        if u < centerU then
            if ring == 1 then
                return "Center Left"
            end
            return "Mid Left"
        end
        if ring == 1 then
            return "Center Right"
        end
        return "Mid Right"
    end
    return nil
end

--- @param catalog table[]
--- @return table[] occupied area names in STAGE_LOOK_AREA_ORDER, each `{ areaName, characterKey, fig }`
local function collectOccupiedStageLookTargets(catalog)
    local NPCS = require("core.npcs")
    local Gmod = require("lib.guids")
    local placements = S.getStateVal("sessionScene", "npcWorld", "placements")
    if type(placements) ~= "table" then
        return {}
    end
    local bestByArea = {}
    for characterKey, row in pairs(placements) do
        if type(characterKey) == "string" and characterKey ~= "" and type(row) == "table" then
            local u = tonumber(row.u)
            local v = tonumber(row.v)
            if u ~= nil and v ~= nil then
                local bestEntry = nil
                local bestDist = math.huge
                for i = 1, #catalog do
                    local entry = catalog[i]
                    if type(entry) == "table" and type(entry.familyId) == "string" and entry.familyId ~= "" then
                        local eu = tonumber(entry.u)
                        local ev = tonumber(entry.v)
                        if eu ~= nil and ev ~= nil then
                            local du = eu - u
                            local dv = ev - v
                            local dist = du * du + dv * dv
                            if dist < bestDist then
                                bestDist = dist
                                bestEntry = entry
                            end
                        end
                    end
                end
                local areaName = bestEntry ~= nil and polarAreaNameForFamily(catalog, bestEntry.familyId) or nil
                if type(areaName) == "string" then
                    local rec = NPCS.getInstanceRecord(characterKey)
                    local fig = nil
                    if type(rec) == "table" and type(rec.figurineGuid) == "string" then
                        fig = Gmod.getObject(rec.figurineGuid)
                    end
                    if U.isGameObject(fig) then
                        local familyK = tonumber(bestEntry.familyK) or 99
                        local isAnchor = bestEntry.isAnchor == true
                        local scoreU = tonumber(bestEntry.u) or 0.5
                        local prev = bestByArea[areaName]
                        local take = prev == nil
                        if prev ~= nil then
                            local prevCenter = math.abs(prev.scoreU - 0.5)
                            local thisCenter = math.abs(scoreU - 0.5)
                            if thisCenter < prevCenter - 1e-6 then
                                take = true
                            elseif math.abs(thisCenter - prevCenter) <= 1e-6 then
                                if isAnchor and prev.isAnchor ~= true then
                                    take = true
                                elseif isAnchor == prev.isAnchor and math.abs(familyK) < math.abs(prev.familyK) then
                                    take = true
                                end
                            end
                        end
                        if take then
                            bestByArea[areaName] = {
                                characterKey = characterKey,
                                familyK = familyK,
                                isAnchor = isAnchor,
                                scoreU = scoreU,
                                fig = fig,
                            }
                        end
                    end
                end
            end
        end
    end
    local out = {}
    for i = 1, #STAGE_LOOK_AREA_ORDER do
        local name = STAGE_LOOK_AREA_ORDER[i]
        local rec = bestByArea[name]
        if rec ~= nil then
            out[#out + 1] = { areaName = name, characterKey = rec.characterKey, fig = rec.fig }
        end
    end
    return out
end

--- Right-click: clone default lookAt, raise focus, yaw toward lead figurine on the horizon, then FirstPerson (TOR-562).
--- @param player Player
--- @param seatColor string
local function applyOverlayCameraStageLook(player, seatColor)
    local Board = require("core.npc_gameboard_board")
    local Snaps = require("core.npc_gameboard_snaps")
    local board = Board.getControlBoard()
    local occupied = {}
    if Board.isGameObject(board) then
        local catalog = Snaps.buildControlBoardSnapCatalog(board, nil)
        occupied = collectOccupiedStageLookTargets(catalog)
    end
    if #occupied == 0 then
        Main.lookAtNPC(player, nil)
        stageLookCycleIndexBySeat[seatColor] = 0
        return
    end
    local last = tonumber(stageLookCycleIndexBySeat[seatColor]) or 0
    local nextIndex = last + 1
    if nextIndex > #occupied then
        nextIndex = 1
    end
    stageLookCycleIndexBySeat[seatColor] = nextIndex
    local target = occupied[nextIndex]
    local fig = target.fig
    local npcPos = nil
    if U.isGameObject(fig) and fig.getPosition ~= nil then
        npcPos = fig.getPosition()
    end
    Main.lookAtNPC(player, npcPos)
end

-- ============================================================================
-- Global UI EVENT HANDLERS (referenced by XML)
-- ============================================================================

--- Per-seat camera popout / control buttons: hover brightens `alpha_control` Images (`ui/.templates/panel_overlay_camera.xml`).
function HUD_alphaControl_hoverOn(player, value, id)
    if type(id) ~= "string" then
        return
    end
    U.setAttributes(id, { color = CAMERA_ALPHA_CONTROL_RGBA_FULL })
end

--- Restore idle tint for `alpha_control` Images (matches XML default on `alpha_control`).
function HUD_alphaControl_hoverOff(player, value, id)
    if type(id) ~= "string" then
        return
    end
    U.setAttributes(id, { color = CAMERA_ALPHA_CONTROL_RGBA_IDLE })
end

--- Overlay camera icon press. Left-click starts a 1s hold to open the picker
--- without changing the camera. Right-click is handled on `onClick`.
function HUD_popoutCameraControl_mouseDown(player, value, id)
    if type(id) ~= "string" or isOverlayCameraRightClick(value) then
        return
    end
    local seatColor = parseSeatColorFromPopoutCameraId(id)
    if seatColor == nil then
        return
    end
    cameraPickerHoldStateBySeat[seatColor] = "pending"
    local gen = bumpCameraPickerHold(seatColor)
    U.await(function()
        if cameraPickerHoldGenBySeat[seatColor] ~= gen then
            return
        end
        cameraPickerHoldStateBySeat[seatColor] = "opened"
        setCameraControlsPanelExpanded(seatColor, true)
    end, CAMERA_PICKER_HOLD_SEC)
end

--- Overlay camera icon release. Quick left-click snaps to `default` ThirdPerson
--- and leaves the picker closed. After a hold-open, release does not move the camera.
function HUD_popoutCameraControl_mouseUp(player, value, id)
    if type(id) ~= "string" or isOverlayCameraRightClick(value) then
        return
    end
    local seatColor = parseSeatColorFromPopoutCameraId(id)
    if seatColor == nil then
        return
    end
    local state = cameraPickerHoldStateBySeat[seatColor]
    bumpCameraPickerHold(seatColor)
    cameraPickerHoldStateBySeat[seatColor] = nil
    if state == "opened" then
        return
    end
    if state ~= "pending" then
        return
    end
    Main.setCamera(player, "default")
    setCameraControlsPanelExpanded(seatColor, false)
end

--- Leaving the icon mid-press cancels the hold without snapping the camera.
function HUD_popoutCameraControl_mouseExit(player, value, id)
    if type(id) ~= "string" then
        return
    end
    local seatColor = parseSeatColorFromPopoutCameraId(id)
    if seatColor == nil then
        return
    end
    if cameraPickerHoldStateBySeat[seatColor] ~= "pending" then
        return
    end
    bumpCameraPickerHold(seatColor)
    cameraPickerHoldStateBySeat[seatColor] = nil
end

--- Right-click (`-2`) FirstPerson at elevated default focus, yawed toward the next occupied stage NPC (TOR-562).
--- Left-click is handled by mouseDown / mouseUp (TOR-597).
function HUD_popoutCameraControl_click(player, value, id)
    if type(id) ~= "string" then
        return
    end
    local seatColor = parseSeatColorFromPopoutCameraId(id)
    if seatColor == nil then
        return
    end
    if not isOverlayCameraRightClick(value) then
        return
    end
    bumpCameraPickerHold(seatColor)
    cameraPickerHoldStateBySeat[seatColor] = nil
    applyOverlayCameraStageLook(player, seatColor)
    setCameraControlsPanelExpanded(seatColor, false)
end

--- Apply a camera preset for the clicking player and collapse the picker.
--- MAIN (`cameraControl_default_*`): left → `default`; right → `wideFacing`.
function HUD_cameraControl_click(player, value, id)
    if type(id) ~= "string" then
        return
    end
    local _, seatColor = getPlayerIDAndColor(player)
    if type(seatColor) ~= "string" then
        return
    end
    local mode = parseCameraControlIdToMode(id, seatColor)
    if mode == nil then
        print(("[HUD Player] HUD_cameraControl_click: unrecognized control id %q for seat %s"):format(id, seatColor))
        setCameraControlsPanelExpanded(seatColor, false)
        return
    end
    -- XmlUI onClick value: "-1" left, "-2" right (TTS UI Attributes).
    if mode == "default" and (value == "-2" or value == -2) then
        mode = "wideFacing"
    end
    Main.setCamera(player, mode)
    setCameraControlsPanelExpanded(seatColor, false)
end

--- @param id string e.g. `popout_locationPanel_Red`
--- @return string|nil
local function parseSeatColorFromPopoutLocationPanelId(id)
    if type(id) ~= "string" then
        return nil
    end
    local prefix = "popout_locationPanel_"
    if id:sub(1, #prefix) ~= prefix then
        return nil
    end
    local col = id:sub(#prefix + 1)
    if col == "" or not U.isIn(col, C.PlayerColors) then
        return nil
    end
    return col
end

--- Per-seat lower-left location popout: hover shows district + site cards.
--- Hold shows the site hub overview when the live site belongs to a hub; otherwise hold is a no-op.
--- Popout stays full-alpha always (blocks TTS chrome the author wants blocked).
function HUD_locationOverlay_hoverOn(player, value, id)
    local seat = parseSeatColorFromPopoutLocationPanelId(id)
    if seat == nil then
        return
    end
    locationDockHoverBySeatColor[seat] = true
    setActive("gameStateOverlay_locationPanel_" .. seat, true)
    reconcileLocationDockCardsFromState(seat)
end

--- Mouse left the popout: clear hold and collapse the location panel.
function HUD_locationOverlay_hoverOff(player, value, id)
    local seat = parseSeatColorFromPopoutLocationPanelId(id)
    if seat == nil then
        return
    end
    locationDockHoverBySeatColor[seat] = nil
    locationHubHoldBySeatColor[seat] = nil
    setActive("gameStateOverlay_locationPanel_" .. seat, false)
    reconcileLocationDockCardsFromState(seat)
end

--- Mouse down on the location icon: hub sites swap the dock to the hub overview while held.
function HUD_locationOverlay_mouseDown(player, value, id)
    local seat = parseSeatColorFromPopoutLocationPanelId(id)
    if seat == nil then
        return
    end
    local hubRef = resolveLocationDockHubImageRef(seat)
    if type(hubRef) ~= "string" then
        return
    end
    locationHubHoldBySeatColor[seat] = true
    setActive("gameStateOverlay_locationPanel_" .. seat, true)
    reconcileLocationDockCardsFromState(seat)
end

--- Mouse up on the location icon: leave hub overview; restore cards if still hovered.
function HUD_locationOverlay_mouseUp(player, value, id)
    local seat = parseSeatColorFromPopoutLocationPanelId(id)
    if seat == nil then
        return
    end
    locationHubHoldBySeatColor[seat] = nil
    if locationDockHoverBySeatColor[seat] == true then
        setActive("gameStateOverlay_locationPanel_" .. seat, true)
        reconcileLocationDockCardsFromState(seat)
        return
    end
    setActive("gameStateOverlay_locationPanel_" .. seat, false)
    reconcileLocationDockCardsFromState(seat)
end

--- Hover on: tint the sidebar base button (TOR-444; no _hover sibling Image).
function HUD_playerRightSidebar_hoverOn(player, value, id)
    if type(id) ~= "string" then
        return
    end
    local playerID, color = getPlayerIDAndColor(player)
    if type(playerID) ~= "string" then
        return
    end
    currentHoverBaseIdByPlayerID[playerID] = id
    applySidebarButtonChrome(id, sidebarButtonIsActive(playerID, color, id), true)
end

--- Hover off: restore idle/active tint from HUD state.
function HUD_playerRightSidebar_hoverOff(player, value, id)
    if type(id) ~= "string" then
        return
    end
    local playerID, color = getPlayerIDAndColor(player)
    if type(playerID) ~= "string" then
        return
    end
    currentHoverBaseIdByPlayerID[playerID] = nil
    applySidebarButtonChrome(id, sidebarButtonIsActive(playerID, color, id), false)
end

--- Mouse down on a sidebar base button.
-- Implements:
-- - Core panel toggles (persistent)
-- - Prince's Court toggle (persistent nested panel)
-- - Nestedless reference panels (click-and-hold temporary overlay)
function HUD_playerRightSidebar_mouseDown(player, value, id)
    local playerID, color = getPlayerIDAndColor(player)
    if not playerID or type(id) ~= "string" then
        return
    end
    if type(color) ~= "string" then
        -- Fallback: try to parse color from id suffix
        color = S.getPlayerData and (S.getPlayerData(player) or {}).color or nil
    end

    local action = parseRightSidebarId(id, color)
    if action == nil then
        return
    end

    -- Clicking any right-sidebar button cancels an existing temp hold unless it's itself a nestedless hold.
    if action.kind ~= "reference" or action.nested == true then
        tempHoldRefByPlayerID[playerID] = nil
    end

    if action.kind == "core" then
        local current = S.getStateVal("playerData", playerID, "hud", "activeCorePanel")
        local nextVal = nil
        if current == action.coreKey then
            nextVal = nil
        else
            nextVal = action.coreKey
        end
        S.setStateVal(nextVal, "playerData", playerID, "hud", "activeCorePanel")
        HUDP.updatePlayerUI(player, color)
        return
    end

    if action.kind == "reference" then
        if action.nested == true then
            local currentRefVal = S.getStateVal("playerData", playerID, "hud", "reference", action.refKey)
            local isOpen = type(currentRefVal) == "table"

            if isOpen then
                S.setStateVal(nil, "playerData", playerID, "hud", "reference", action.refKey)
            else
                -- Open this nested panel and close a saved coteries menu plus the hold-to-show panels.
                S.setStateVal({}, "playerData", playerID, "hud", "reference", action.refKey)
                S.setStateVal(nil, "playerData", playerID, "hud", "reference", "coteries")
                S.setStateVal(nil, "playerData", playerID, "hud", "activeCorePanel")

                -- Nestedless persistent panels: force hidden
                for nestedlessKey, _ in pairs(NESTEDLESS_REF_KEYS) do
                    S.setStateVal(false, "playerData", playerID, "hud", "reference", nestedlessKey)
                end
            end

            HUDP.updatePlayerUI(player, color)
            return
        end

        -- Nestedless reference panels: click-and-hold temporary overlay
        if action.nested == false then
            tempHoldRefByPlayerID[playerID] = action.refKey
            HUDP.updatePlayerUI(player, color)
        end
    end
end

--- Mouse up on a sidebar base button.
-- Implements:
-- - Restore persistent reference panel after nestedless hold ends
function HUD_playerRightSidebar_mouseUp(player, value, id)
    local playerID, color = getPlayerIDAndColor(player)
    if not playerID or type(id) ~= "string" then
        return
    end

    local action = parseRightSidebarId(id, color)
    if action == nil then
        return
    end

    if action.kind == "reference" and action.nested == false then
        -- Nestedless references are "hold-to-show" overlays.
        -- Clear the temp hold on *any* mouseUp for any nestedless ref button.
        -- This prevents a stuck overlay when the player drags off one nestedless panel
        -- and releases on a different nestedless panel.
        if tempHoldRefByPlayerID[playerID] ~= nil then
            tempHoldRefByPlayerID[playerID] = nil
            HUDP.updatePlayerUI(player, color)
        end
    else
        -- Safety: if a temp hold somehow exists, clear it for non-nestedless interactions.
        tempHoldRefByPlayerID[playerID] = nil
        HUDP.updatePlayerUI(player, color)
    end
end

local PRINCES_COURT_NAV_COLOR_IDLE = "rgba(1, 1, 1, 0.25)"
local PRINCES_COURT_NAV_COLOR_HOVER = "rgba(1, 1, 1, 1)"

--- Prince's Court nav button hover: full-opacity tint for affordance.
function HUD_playerPrincesCourt_nav_hoverOn(player, value, id)
    if type(id) ~= "string" or id:sub(1, #"playerHud_navigate_page") ~= "playerHud_navigate_page" then
        return
    end
    UI.setAttribute(id, "color", PRINCES_COURT_NAV_COLOR_HOVER)
end

--- Prince's Court nav button hover off: restore semi-transparent default.
function HUD_playerPrincesCourt_nav_hoverOff(player, value, id)
    if type(id) ~= "string" or id:sub(1, #"playerHud_navigate_page") ~= "playerHud_navigate_page" then
        return
    end
    UI.setAttribute(id, "color", PRINCES_COURT_NAV_COLOR_IDLE)
end

--- Prince's Court page navigation button (shared tree — seat from clicker, TOR-444).
function HUD_playerPrincesCourt_navigate(player, value, id)
    if type(id) ~= "string" then
        return
    end

    local playerID, hudSeatColor = getPlayerIDAndColor(player)
    if type(playerID) ~= "string" or playerID == "" or type(hudSeatColor) ~= "string" then
        return
    end

    local targetPage = parsePrincesCourtTargetPageFromNavigateId(id)
    if targetPage == nil then
        return
    end

    S.setStateVal(targetPage, "playerData", playerID, "hud", "reference", "princesCourtPage")
    HUDP.reconcilePrincesCourtPagesForSeat(hudSeatColor, playerID)
    -- updatePlayerUI reconciles trackers when page == 1; avoid duplicate clear-then-fill (TOR-377).
    HUDP.updatePlayerUI(player, hudSeatColor)
end

local DOMAIN_CLAIMS_DIVIDER_ID = "divider_domainClaims"
local DOMAIN_CLAIMS_DIVIDER_IMAGE = "divider_domainClaims"
local DOMAIN_CLAIMS_DIVIDER_IMAGE_HOVER = "divider_domainClaimsClear"

local function isDividerDomainClaimsId(id)
    return id == DOMAIN_CLAIMS_DIVIDER_ID
end

--- Prince's Court page 2: domain claims divider hover — swap to clear variant.
function HUD_playerPrincesCourt_domainClaimsDivider_hoverOn(player, value, id)
    if not isDividerDomainClaimsId(id) then
        return
    end
    UI.setAttribute(id, "image", DOMAIN_CLAIMS_DIVIDER_IMAGE_HOVER)
end

--- Prince's Court page 2: domain claims divider hover off — restore default art.
function HUD_playerPrincesCourt_domainClaimsDivider_hoverOff(player, value, id)
    if not isDividerDomainClaimsId(id) then
        return
    end
    UI.setAttribute(id, "image", DOMAIN_CLAIMS_DIVIDER_IMAGE)
end


--- Scatter Mode control strip (`ui/.templates/panel_scatter_mode_control.xml`).

--- @param id string
--- @return string|nil color
local function parseScatterToggleColor(id)
    if type(id) ~= "string" then
        return nil
    end
    return id:match("^scatterModeControlTogglePad_(%a+)$")
        or id:match("^scatterModeControlToggleHit_(%a+)$")
        or id:match("^scatterModeControlToggle_(%a+)$")
end

--- @param id string
--- @return number|nil groupIndex
--- @return string|nil color
local function parseScatterSelectorId(id)
    if type(id) ~= "string" then
        return nil, nil
    end
    local group, color = id:match("^scatterModeControlGroup(%d+)_selectorHit_(%a+)$")
    if group == nil then
        group, color = id:match("^scatterModeControlGroup(%d+)_selector_(%a+)$")
    end
    local gi = math.floor(tonumber(group) or 0)
    if gi < 1 or gi > 6 or type(color) ~= "string" then
        return nil, nil
    end
    return gi, color
end

--- @param groupIndex number
--- @param color string
--- @return string
local function scatterSelectorImageId(groupIndex, color)
    return "scatterModeControlGroup" .. tostring(groupIndex) .. "_selector_" .. color
end

--- @param color string
--- @return string
local function scatterToggleHitId(color)
    return "scatterModeControlToggleHit_" .. color
end

--- Clicker seat must match the element's color suffix.
--- @param player Player
--- @param color string
--- @return boolean
local function scatterHudClickerMatches(player, color)
    if type(color) ~= "string" then
        return false
    end
    local _, seatColor = getPlayerIDAndColor(player)
    return seatColor == color
end

function HUD_scatterModeControl_toggleHoverOn(player, value, id)
    local color = parseScatterToggleColor(id)
    if not scatterHudClickerMatches(player, color) then
        return
    end
    local ScatterMode = require("core.scatter_mode")
    local open = type(ScatterMode.isControlHudStripOpen) == "function" and ScatterMode.isControlHudStripOpen(color)
    local hitId = scatterToggleHitId(color)
    if open then
        U.setAttribute(hitId, "active", "true")
        return
    end
    U.setAttribute(hitId, "image", "scatterGroupToggle_hover")
end

function HUD_scatterModeControl_toggleHoverOff(player, value, id)
    local color = parseScatterToggleColor(id)
    if not scatterHudClickerMatches(player, color) then
        return
    end
    local ScatterMode = require("core.scatter_mode")
    local open = type(ScatterMode.isControlHudStripOpen) == "function" and ScatterMode.isControlHudStripOpen(color)
    local hitId = scatterToggleHitId(color)
    if open then
        U.setAttribute(hitId, "active", "false")
        return
    end
    U.setAttribute(hitId, "image", "scatterGroupToggle_inactive")
end

function HUD_scatterModeControl_toggleClick(player, value, id)
    local color = parseScatterToggleColor(id)
    if not scatterHudClickerMatches(player, color) then
        return
    end
    local ScatterMode = require("core.scatter_mode")
    if ScatterMode.isActive() ~= true then
        return
    end
    local open = type(ScatterMode.isControlHudStripOpen) == "function" and ScatterMode.isControlHudStripOpen(color)
    ScatterMode.setControlHudStripOpen(color, not open)
    HUD_scatterModeControl_toggleHoverOn(player, value, id)
end

function HUD_scatterModeControl_selectorHoverOn(player, value, id)
    local groupIndex, color = parseScatterSelectorId(id)
    if not scatterHudClickerMatches(player, color) or groupIndex == nil then
        return
    end
    local ScatterMode = require("core.scatter_mode")
    local pcKey = ScatterMode.pcKeyForColor(color)
    local mine = type(pcKey) == "string" and ScatterMode.groupIndexForPcKey(pcKey) or nil
    local imageId = scatterSelectorImageId(groupIndex, color)
    if mine == groupIndex then
        -- Occupied group already shows hover art; pulse with half alpha.
        U.setAttribute(imageId, "color", "rgba(1, 1, 1, 0.5)")
        return
    end
    U.setAttributes(imageId, {
        active = "true",
        image = "scatterGroupSelector_hover",
        color = "rgba(1, 1, 1, 1)",
    })
end

function HUD_scatterModeControl_selectorHoverOff(player, value, id)
    local groupIndex, color = parseScatterSelectorId(id)
    if not scatterHudClickerMatches(player, color) or groupIndex == nil then
        return
    end
    local ScatterMode = require("core.scatter_mode")
    local pcKey = ScatterMode.pcKeyForColor(color)
    local mine = type(pcKey) == "string" and ScatterMode.groupIndexForPcKey(pcKey) or nil
    local imageId = scatterSelectorImageId(groupIndex, color)
    if mine == groupIndex then
        U.setAttributes(imageId, {
            active = "true",
            image = "scatterGroupSelector_hover",
            color = "rgba(1, 1, 1, 1)",
        })
        return
    end
    U.setAttribute(imageId, "active", "false")
end

function HUD_scatterModeControl_selectorClick(player, value, id)
    local groupIndex, color = parseScatterSelectorId(id)
    if not scatterHudClickerMatches(player, color) or groupIndex == nil then
        return
    end
    local ScatterMode = require("core.scatter_mode")
    if ScatterMode.isActive() ~= true then
        return
    end
    local pcKey = ScatterMode.pcKeyForColor(color)
    if type(pcKey) ~= "string" then
        return
    end
    local moved = ScatterMode.movePcToGroup(pcKey, groupIndex)
    if moved == true then
        ScatterMode.setControlHudStripOpen(color, false)
    end
end

return HUDP
