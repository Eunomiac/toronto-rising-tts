--[[
  Scene/table transition blindfold orchestration.
  Picks one random blindfold variant (1..C.BlindfoldVariantCount) shared by all seated players,
  runs synchronous work, then lifts blindfolds after a settle delay.
  Optional destination District/Site cards (TOR-425 / TOR-431) are armed on the parent Panel before
  one UI.show; End scene / table-only / no-location keep cards Clear (invisible if animated).
  Global session blindfold (`overlay_globalBlindfold` in Global.xml) is phase-owned
  (Intermission show / Play hide / connect policy) — never by this module or a timed onLoad hide.
  Agent guidance: .dev/Scene Constructor/Scene Constructor Overview.md; .dev/HUD_FUNCTIONS.md.
]]
---@diagnostic disable: undefined-global

local HUDBF = {}

local S = require("core.state")
local U = require("lib.util")
local C = require("lib.constants")
local Conditions = require("core.conditions")
local HO = require("core.hud_overlays")
local Main = require("core.main")

local TRANSITION_SETTLE_DELAY_SEC = 10
--- Parent Panel FadeIn (`animationDuration` on `playerHud_overlay_blindfold`) — cards delay longer on purpose
--- so players can read the blindfold art before district/site cards cover it.
local BLINDFOLD_SLIDE_IN_SEC = 2
--- District card FadeIn start: XML `showAnimationDelay` on district destination card (site is 4.5s).
local BLINDFOLD_DISTRICT_CARD_DELAY_SEC = 4.0
--- Lead-in before ambient fade-out / heavy work (TOR-476). Starts when district cards begin FadeIn so
--- old ambient crossfades with destination reveal (same clock when cards are Clear / End scene).
--- Floored at parent FadeIn so work never starts during the blindfold panel FadeIn alone.
local BLINDFOLD_DOWN_COMPLETE_SEC = math.max(BLINDFOLD_SLIDE_IN_SEC, BLINDFOLD_DISTRICT_CARD_DELAY_SEC)
--- Default lead-in for `runTransitionAfterLeadIn` (same gate as staged / simple transition).
local TRANSITION_WORK_LEAD_IN_SEC = BLINDFOLD_DOWN_COMPLETE_SEC
--- Staged transition (TOR-147 / TOR-434 / TOR-476): fade-out after card-window lead-in;
--- heavy reconcile (incl. default camera snap, TOR-368) then runs alone; new audio fades in under cover.
local TRANSITION_FADE_OUT_SEC = 1
local TRANSITION_WORK_SETTLE_SEC = 0.75
--- New-location ambient fades in under the blindfold after work (TOR-476), so lift happens with audio full.
local TRANSITION_FADE_IN_SEC = 2.0
--- Exported so soundscape callers can fade ambient out/in over the same windows as the staged transition.
HUDBF.TRANSITION_FADE_OUT_SEC = TRANSITION_FADE_OUT_SEC
HUDBF.TRANSITION_FADE_IN_SEC = TRANSITION_FADE_IN_SEC
HUDBF.BLINDFOLD_DOWN_COMPLETE_SEC = BLINDFOLD_DOWN_COMPLETE_SEC
--- Default post-work settle hold (seconds) for staged / simple transitions.
HUDBF.TRANSITION_SETTLE_DELAY_SEC = TRANSITION_SETTLE_DELAY_SEC
local BLINDFOLD_VARIANT_COUNT = C.BlindfoldVariantCount
local TRANSITION_CONDITION_KEY = "hudBlindfold"

local activeTransitionVariant = nil
local pendingEndDelayId = nil
--- playerIDs that received `hudBlindfold` in the current (or last) beginTransition.
--- Cleared on end even if those players left their seats mid-settle (hotseat orphan fix).
local transitionBlindfoldPlayerIds = {}
--- Custom UI image refs for destination cards while a transition is active (nil when skipped).
local transitionDistrictCardImage = nil
local transitionSiteCardImage = nil

--- @return number 1..C.BlindfoldVariantCount
local function pickRandomVariant()
  return math.random(1, BLINDFOLD_VARIANT_COUNT)
end

--- @param s string|nil
--- @return string
local function trimKey(s)
  if type(s) ~= "string" then
    return ""
  end
  return string.gsub(string.gsub(s, "^%s+", ""), "%s+$", "")
end

--- District Custom UI asset name (`districtCard_<key>`), or nil when unknown.
--- @param districtKey string|nil
--- @return string|nil
local function resolveDistrictCardImage(districtKey)
  local dk = trimKey(districtKey)
  if dk == "" or type(C.Districts) ~= "table" or type(C.Districts[dk]) ~= "table" then
    return nil
  end
  return "districtCard_" .. dk
end

--- Site Custom UI asset name (`C.Sites[*].image` or `siteCard_<key>`), or nil when unknown.
--- @param siteKey string|nil
--- @return string|nil
local function resolveSiteCardImage(siteKey)
  local sk = trimKey(siteKey)
  if sk == "" or type(C.Sites) ~= "table" then
    return nil
  end
  local site = C.Sites[sk]
  if type(site) ~= "table" then
    return nil
  end
  local img = site.image
  if type(img) == "string" then
    img = trimKey(img)
    if img ~= "" then
      return img
    end
  end
  local k = site.key
  if type(k) ~= "string" or trimKey(k) == "" then
    k = sk
  end
  local suffix = trimKey(k)
  -- Never emit `siteCard_` with an empty suffix (invalid Custom UI asset name).
  if suffix == "" then
    return nil
  end
  return "siteCard_" .. suffix
end

--- @param opts table|nil `{ districtKey?, siteKey? }`
--- @return string|nil districtImage, string|nil siteImage — both set only when both keys resolve
local function resolveTransitionLocationCardImages(opts)
  if type(opts) ~= "table" then
    return nil, nil
  end
  local districtImage = resolveDistrictCardImage(opts.districtKey)
  local siteImage = resolveSiteCardImage(opts.siteKey)
  if type(districtImage) ~= "string" or type(siteImage) ~= "string" then
    return nil, nil
  end
  return districtImage, siteImage
end

--- Force destination cards to Clear defaults (no separate UI.hide — parent owns animation, TOR-431).
--- Shared tree (TOR-444): one district/site pair — not per-seat ids.
local function clearTransitionLocationCardDefaultsForAllSeats()
  if type(HO.clearSharedBlindfoldLocationCards) == "function" then
    HO.clearSharedBlindfoldLocationCards()
  end
  transitionDistrictCardImage = nil
  transitionSiteCardImage = nil
end

--- Destination District/Site Custom UI image names for the active transition (nil when none).
--- @return string|nil, string|nil
function HUDBF.getTransitionLocationCardImages()
  if type(transitionDistrictCardImage) == "string" and type(transitionSiteCardImage) == "string" then
    return transitionDistrictCardImage, transitionSiteCardImage
  end
  return nil, nil
end

--- @param fn fun(playerID: string)
local function forEachSeatedPlayer(fn)
  if type(fn) ~= "function" then
    return
  end
  local seated = Player.getPlayers() or {}
  for _, player in ipairs(seated) do
    local color = player and player.color or nil
    local playerID = U.Type(color) == "string" and S.getPlayerID(color) or nil
    if U.Type(playerID) == "string" and playerID ~= C.StorytellerID then
      fn(playerID)
    end
  end
end

--- Clear transition `hudBlindfold` for every playerID recorded at begin (not only currently seated).
--- @param opts table|nil `{ skipAfterChange?: boolean }` forwarded to Conditions.clear
local function clearTrackedTransitionBlindfolds(opts)
  opts = type(opts) == "table" and opts or nil
  for playerID, _ in pairs(transitionBlindfoldPlayerIds) do
    if type(playerID) == "string" and playerID ~= C.StorytellerID then
      Conditions.clear(playerID, TRANSITION_CONDITION_KEY, opts)
    end
  end
  transitionBlindfoldPlayerIds = {}
end

--- @return table<string, boolean> seatColor -> true when a Player occupies that color
local function occupiedSeatColors()
  local occupied = {}
  local seated = Player.getPlayers() or {}
  for _, player in ipairs(seated) do
    local color = player and player.color or nil
    if type(color) == "string" then
      occupied[color] = true
    end
  end
  return occupied
end

--- Drop `hudBlindfold` on PC rows whose seat is empty.
--- Recovers orphans left when a host left a PC seat before transition end; safe while a
--- transition is inactive (manual blindfolds on empty seats are not visible anyway).
function HUDBF.clearBlindfoldsForUnoccupiedPcSeats()
  if activeTransitionVariant ~= nil then
    return
  end
  local occupied = occupiedSeatColors()
  local pd = S.getStateVal("playerData")
  if type(pd) ~= "table" then
    return
  end
  for playerID, row in pairs(pd) do
    if type(playerID) == "string"
      and playerID ~= C.StorytellerID
      and type(row) == "table"
      and type(row.conditions) == "table"
      and row.conditions[TRANSITION_CONDITION_KEY] ~= nil
    then
      local seatColor = row.color
      if type(seatColor) == "string" and occupied[seatColor] ~= true then
        Conditions.clear(playerID, TRANSITION_CONDITION_KEY)
      end
    end
  end
end

--- Reset every seated player to the layout-derived default camera when the pre-lift settle delay starts.
--- TOR-446: lookAt snap only — do not force FirstPerson (reverses TOR-443).
local function setDefaultCameraForSeatedPlayers()
  if type(Main) == "table" and type(Main.setDefaultCameraBeforeBlindfold) == "function" then
    Main.setDefaultCameraBeforeBlindfold("ALL")
    return
  end
  if type(Main) ~= "table" or type(Main.setCamera) ~= "function" then
    error("hud_blindfold: core.main M.setDefaultCameraBeforeBlindfold (or M.setCamera) is required for transition default camera sync")
  end
  local seated = Player.getPlayers() or {}
  for _, player in ipairs(seated) do
    if player ~= nil then
      Main.setCamera(player, "default")
    end
  end
end

--- @return number|nil
function HUDBF.getActiveTransitionVariant()
  return activeTransitionVariant
end

--- Apply transition blindfold HUD conditions for all seated players.
--- Destination District/Site cards (TOR-425 / TOR-431) arm on the parent before one UI.show when
--- both `districtKey` and `siteKey` resolve; otherwise cards stay Clear.
--- Condition writes use `skipAfterChange` so Conditions.afterChange cannot UI.show before arming (TOR-441).
--- Default camera snap is owned by staged/simple settle paths (TOR-368) — not here — so early
--- XmlUI FadeIns are not hitch-frozen by lookAt.
--- @param optsOrVariant number|table|nil
---   number — blindfold variant 1..C.BlindfoldVariantCount
---   table — `{ variant?, districtKey?, siteKey? }` (keys from the *destination* scene; live sessionScene is still old)
function HUDBF.beginTransition(optsOrVariant)
  if pendingEndDelayId ~= nil then
    U.cancel(pendingEndDelayId)
    pendingEndDelayId = nil
  end
  -- Drop prior transition state without per-player afterChange (each would UI.hide/show and
  -- fight the single armed parent UI.show below). Lift uses skipAfterChange + one HO.syncAll.
  clearTrackedTransitionBlindfolds({ skipAfterChange = true })
  -- Reset card attrs before deciding whether this transition arms destination art.
  clearTransitionLocationCardDefaultsForAllSeats()

  local opts = nil
  local variantOptional = nil
  if type(optsOrVariant) == "table" then
    opts = optsOrVariant
    variantOptional = opts.variant
  else
    variantOptional = optsOrVariant
  end

  local variant = tonumber(variantOptional)
  if variant == nil or variant < 1 or variant > BLINDFOLD_VARIANT_COUNT then
    variant = pickRandomVariant()
  end
  activeTransitionVariant = variant

  local districtImage, siteImage = resolveTransitionLocationCardImages(opts)
  if type(districtImage) == "string" and type(siteImage) == "string" then
    transitionDistrictCardImage = districtImage
    transitionSiteCardImage = siteImage
  end

  -- Mutation only: skip afterChange so Conditions cannot UI.show before children are armed.
  forEachSeatedPlayer(function(playerID)
    transitionBlindfoldPlayerIds[playerID] = true
    Conditions.setEvent(playerID, TRANSITION_CONDITION_KEY, { variant = variant }, {
      skipAfterChange = true,
    })
  end)
  -- Single parent UI.show after children are armed (variant + optional cards). forceReshow so a
  -- mid-settle restart always slides in again. TOR-434 lead-in waits still gate heavy work.
  if type(HO.applyBlindfoldVariantForSeatedPlayers) == "function" then
    HO.applyBlindfoldVariantForSeatedPlayers(variant, {
      forceReshow = true,
      districtImage = districtImage,
      siteImage = siteImage,
    })
  else
    HO.syncAll()
  end
end

--- Clear transition blindfold conditions and refresh HUD overlays (parent UI.hide + delayed child reset).
function HUDBF.endTransition()
  if pendingEndDelayId ~= nil then
    U.cancel(pendingEndDelayId)
    pendingEndDelayId = nil
  end
  activeTransitionVariant = nil
  transitionDistrictCardImage = nil
  transitionSiteCardImage = nil

  -- Batch-clear state, then one overlay reconcile owns parent UI.hide (avoid N afterChange hides).
  clearTrackedTransitionBlindfolds({ skipAfterChange = true })
  HUDBF.clearBlindfoldsForUnoccupiedPcSeats()
  -- HO.syncAll → parent UI.hide; child defaults restore after ~3s (do not Clear mid-slide).
  HO.syncAll()

  local PCST = require("core.pc_storyteller_panel")
  if PCST ~= nil and type(PCST.refreshAllRows) == "function" then
    PCST.refreshAllRows()
  end
end

--- @param delaySec number
function HUDBF.scheduleEnd(delaySec)
  if pendingEndDelayId ~= nil then
    U.cancel(pendingEndDelayId)
    pendingEndDelayId = nil
  end
  local d = tonumber(delaySec) or 0
  if d < 0 then
    d = 0
  end
  if d > 0 then
    setDefaultCameraForSeatedPlayers()
  end
  pendingEndDelayId = U.await(function()
    pendingEndDelayId = nil
    HUDBF.endTransition()
  end, d)
end

--- Parse optional duration seconds. Explicit `0` is kept; nil/invalid → default (TOR-435).
--- Do not use `tonumber(x) or default` — Lua treats 0 as falsy.
--- @param raw any
--- @param defaultSec number
--- @return number
local function resolveOptSec(raw, defaultSec)
  local n = tonumber(raw)
  if n == nil then
    return defaultSec
  end
  return n
end

--- Wall-clock estimate for `runStagedTransition` (lead-in + fade-out + settle budget).
--- Used by phase Advance to wait for nested staged work without dual-driving the world.
--- @param opts table|nil same keys as `runStagedTransition`
--- @return number
function HUDBF.estimateStagedTransitionSec(opts)
  opts = opts or {}
  local leadInDelaySec = resolveOptSec(opts.leadInDelaySec, BLINDFOLD_DOWN_COMPLETE_SEC)
  local fadeOutSec = resolveOptSec(opts.fadeOutSec, TRANSITION_FADE_OUT_SEC)
  local settleDelaySec = resolveOptSec(opts.settleDelaySec, TRANSITION_SETTLE_DELAY_SEC)
  return leadInDelaySec + fadeOutSec + settleDelaySec
end

--- Close panel + blindfold immediately; defer heavy work with `U.await` until blindfold-down
--- animations finish (TOR-434), then settle and lift.
--- @param workFn fun(): boolean, string|nil returns success and optional error message
--- @param opts table|nil { leadInDelaySec = number, settleDelaySec = number, variant = number|nil }
function HUDBF.runTransitionAfterLeadIn(workFn, opts)
  if type(workFn) ~= "function" then
    error("hud_blindfold.runTransitionAfterLeadIn: workFn must be a function")
  end
  opts = opts or {}
  local leadInDelaySec = resolveOptSec(opts.leadInDelaySec, TRANSITION_WORK_LEAD_IN_SEC)
  local settleDelaySec = resolveOptSec(opts.settleDelaySec, TRANSITION_SETTLE_DELAY_SEC)

  HUDBF.beginTransition(opts)

  U.await(function()
    local ok, errMsg = workFn()
    if ok ~= true then
      if type(errMsg) == "string" and errMsg ~= "" then
        U.AlertGM(errMsg)
      end
      HUDBF.scheduleEnd(0)
      return
    end
    HUDBF.scheduleEnd(settleDelaySec)
  end, leadInDelaySec)
end

--- Blindfold on → wait for slide/FadeIn → work → settle delay → blindfold off (TOR-434).
--- Work is deferred via `U.chain` so XmlUI animations are not hitch-frozen.
--- @param workFn fun(): boolean, string|nil returns success and optional error message
--- @param opts table|nil `{ settleDelaySec?, variant?, districtKey?, siteKey?, leadInDelaySec? }`
function HUDBF.runTransition(workFn, opts)
  if type(workFn) ~= "function" then
    error("hud_blindfold.runTransition: workFn must be a function")
  end
  opts = opts or {}
  local settleDelaySec = resolveOptSec(opts.settleDelaySec, TRANSITION_SETTLE_DELAY_SEC)
  local leadInDelaySec = resolveOptSec(opts.leadInDelaySec, BLINDFOLD_DOWN_COMPLETE_SEC)

  HUDBF.beginTransition(opts)

  U.chain({
    function()
      return leadInDelaySec
    end,
    function()
      local ok, errMsg = workFn()
      if ok ~= true then
        if type(errMsg) == "string" and errMsg ~= "" then
          U.AlertGM(errMsg)
        end
        HUDBF.scheduleEnd(0)
        return
      end
      HUDBF.scheduleEnd(settleDelaySec)
    end,
  })
end

--- Staged scene transition (TOR-147 / TOR-434 / TOR-476): blindfold down → wait for district-card
--- window → fade-out → heavy work → fade-in under cover → settle → lift (audio already full).
--- Each phase is isolated in time via `U.chain` so XmlUI FadeIn and resource-heavy
--- reconcile never compete (prevents animation hitch).
--- @param phases table `{ fadeOut?: fun(), work?: fun(): boolean, string|nil, fadeIn?: fun() }`
---   - `fadeOut` runs at the district-card FadeIn window (same lead-in when cards are Clear)
---   - `work` returns `ok, errMsg`; on failure the blindfold lifts immediately and `fadeIn` is skipped
---   - default camera snaps at the start of `work` (under full cover; TOR-368) so early FadeIns stay smooth
---   - `fadeIn` runs under the blindfold after work so new ambient is full before lift (TOR-476)
--- @param opts table|nil `{ fadeOutSec?, workSettleSec?, fadeInSec?, settleDelaySec?, leadInDelaySec?, variant?, districtKey?, siteKey? }`
function HUDBF.runStagedTransition(phases, opts)
  if type(phases) ~= "table" then
    error("hud_blindfold.runStagedTransition: phases must be a table")
  end
  opts = opts or {}
  local leadInDelaySec = resolveOptSec(opts.leadInDelaySec, BLINDFOLD_DOWN_COMPLETE_SEC)
  local fadeOutSec = resolveOptSec(opts.fadeOutSec, TRANSITION_FADE_OUT_SEC)
  local workSettleSec = resolveOptSec(opts.workSettleSec, TRANSITION_WORK_SETTLE_SEC)
  local fadeInSec = resolveOptSec(opts.fadeInSec, TRANSITION_FADE_IN_SEC)
  local settleDelaySec = resolveOptSec(opts.settleDelaySec, TRANSITION_SETTLE_DELAY_SEC)

  HUDBF.beginTransition(opts)

  local workFailed = false
  U.chain({
    function()
      -- Hold through parent FadeIn until district-card FadeIn starts (TOR-476 / TOR-434).
      return leadInDelaySec
    end,
    function()
      if type(phases.fadeOut) == "function" then
        phases.fadeOut()
      end
      return fadeOutSec
    end,
    function()
      -- TOR-368: snap default cameras here (with heavy work), not during early lead-in FadeIns.
      setDefaultCameraForSeatedPlayers()
      if type(phases.work) == "function" then
        local ok, errMsg = phases.work()
        if ok ~= true then
          workFailed = true
          if type(errMsg) == "string" and errMsg ~= "" then
            U.AlertGM(errMsg)
          end
        end
      end
      return workFailed and 0 or workSettleSec
    end,
    function()
      -- New-location ambient fades in under the blindfold (TOR-476). Wait fadeInSec so volume
      -- is full before any remaining settle / lift.
      if workFailed then
        return 0
      end
      if type(phases.fadeIn) == "function" then
        phases.fadeIn()
      end
      return fadeInSec
    end,
    function()
      if workFailed then
        HUDBF.scheduleEnd(0)
        return
      end
      -- Remaining post-work down-time after workSettle + fadeIn (may be 0).
      return math.max(0, settleDelaySec - workSettleSec - fadeInSec)
    end,
    function()
      HUDBF.scheduleEnd(0)
    end,
  })
end

return HUDBF
