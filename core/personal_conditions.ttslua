--[[
  Mutations for `playerData.personalConditions` (sheet cards).
  Adding a card can turn a hand-applicable mechanic on. Removing it turns that mechanic off
  only when this card was the one that turned it on.

  Agent guidance: .dev/Conditions Display & Management/Conditions Display & Management Overview.md
]]

local P = {}

local S = require("core.state")
local C = require("lib.constants")
local PC = require("lib.personal_conditions")
local CD = require("lib.condition_defs")

local sceneEpoch = 0

--- @param color string
--- @return string|nil
local function playerId(color)
  local pid = S.getPlayerID(color)
  if type(pid) ~= "string" or pid == "" or pid == C.StorytellerID then
    return nil
  end
  return pid
end

--- @param pid string
--- @return table
local function readList(pid)
  return PC.copyList(S.getStateVal("playerData", pid, "personalConditions"))
end

--- @param pid string
--- @param list table
local function writeList(pid, list)
  S.setStateVal(list, "playerData", pid, "personalConditions")
end

--- The due list lives on the seats slice. Adding or removing a card is announced by the
--- dashboard command's own `Sync.player`; a removal check only needs the list to refresh.
local function markSeatsDirty()
  require("dashboard.push").markWorldDirty({ seats = true })
end

--- @param text unknown
--- @param limit number
--- @return string
local function text(text, limit)
  if type(text) ~= "string" then
    return ""
  end
  if #text > limit then
    return string.sub(text, 1, limit)
  end
  return text
end

--- @param list table
--- @param id string
--- @return table|nil
--- @return number|nil
local function findCard(list, id)
  for i = 1, #list do
    if list[i].id == id then
      return list[i], i
    end
  end
  return nil, nil
end

--- @param list table
--- @return number
local function nextSeq(list)
  local n = 0
  for i = 1, #list do
    local seq = tonumber(list[i].seq) or 0
    if seq > n then
      n = seq
    end
  end
  return n + 1
end

--- @param trigger string
--- @return number
--- @return number
local function duskForTrigger(trigger)
  local _, month, day = string.match(tostring(trigger), "^Clock:(%d+)%-(%d+)%-(%d+)$")
  if month == nil then
    return 19, 0
  end
  local sun = require("lib.toronto_sun").estimate(tonumber(month), tonumber(day))
  local sunset = type(sun) == "table" and sun.sunset or nil
  if type(sunset) ~= "table" then
    return 19, 0
  end
  return tonumber(sunset.hour) or 19, tonumber(sunset.minute) or 0
end

--- @param list table
local function recheckSavedTriggers(list)
  PC.markClock(list, S.getStateVal("presentDayClock"), duskForTrigger)
  if S.getStateVal("currentPhase") == C.Phases.END then
    PC.markSessionEnd(list, tonumber(S.getStateVal("sessionNum")) or 1)
  end
end

--- @param fields table
--- @return string|nil trigger
--- @return string|nil error
local function triggerFromFields(fields)
  local kind = fields.kind
  if kind == "EndOfScene" or kind == "ChangeOfBlood" or kind == "Manual" then
    return kind, nil
  end
  if kind == "EndOfSession" then
    local session = math.floor(tonumber(fields.session) or 0)
    local current = math.floor(tonumber(S.getStateVal("sessionNum")) or 1)
    if session ~= current and session ~= current + 1 and session ~= current + 2 then
      return nil, "End of session must be this session or one of the next two."
    end
    return PC.sessionTrigger(session), nil
  end
  if kind == "Clock" then
    local year = math.floor(tonumber(fields.year) or 0)
    local month = math.floor(tonumber(fields.month) or 0)
    local day = math.floor(tonumber(fields.day) or 0)
    if year < 1 or month < 1 or month > 12 or day < 1 or day > 31 then
      return nil, "Pick a month, day, and year."
    end
    return PC.clockTrigger(year, month, day), nil
  end
  return nil, "Pick how this condition ends."
end

--- @param card table
local function releaseMechanic(pid, card)
  if card.ownsMechanic == true and type(card.condition) == "string" and card.condition ~= "" then
    require("core.conditions").clear(pid, card.condition, { skipAfterChange = true })
  end
end

--- @param color string
--- @return string|nil pid
--- @return string|nil error
local function requirePlayer(color)
  local pid = playerId(color)
  if pid == nil then
    return nil, "No player is seated there."
  end
  return pid, nil
end

--- Hand-applicable mechanics with no extra payload (the other-condition list).
--- @return table[]
function P.manualOptions()
  local out = {}
  for id, def in pairs(CD.Defs) do
    if def.canApplyManually == true and type(def.instanceSchema) ~= "table" then
      out[#out + 1] = { id = id, displayName = def.displayName or id }
    end
  end
  table.sort(out, function(a, b)
    if a.displayName ~= b.displayName then
      return a.displayName < b.displayName
    end
    return a.id < b.id
  end)
  return out
end

--- @param pid string|nil
--- @return table|nil resonance
--- @return table cards
function P.seatView(pid)
  if type(pid) ~= "string" then
    return nil, {}
  end
  local list = readList(pid)
  local resonance = PC.resonanceCard(list)
  local view = nil
  if resonance ~= nil then
    view = {
      temperament = resonance.temperament,
      resonanceType = resonance.resonanceType,
      dyscrasiaTitle = resonance.dyscrasiaTitle or "",
      dyscrasiaDescription = resonance.dyscrasiaDescription or "",
    }
  end
  local cards = {}
  for i = 1, #list do
    local card = list[i]
    if card.displayType ~= "resonance" then
      cards[#cards + 1] = {
        id = card.id,
        title = card.title or "",
        subtitle = card.subtitle or "",
        displayType = card.displayType,
        textColor = PC.normalizeTextColor(card.textColor),
        displayOnSheet = card.displayOnSheet ~= false,
        removalTrigger = card.removalTrigger,
        triggerLabel = PC.triggerLabel(card.removalTrigger),
        duration = card.duration or "",
        condition = card.condition,
      }
    end
  end
  return view, cards
end

--- Due cards for every seat, for the Scenes tab.
--- @return table[]
function P.dueRows()
  local rows = {}
  for _, color in ipairs(C.PlayerColors or {}) do
    local pid = playerId(color)
    if pid ~= nil then
      local catalog = C.PlayerData[pid]
      local name = type(catalog) == "table" and (catalog.playerName or catalog.charKey) or color
      local due = PC.dueCards(readList(pid))
      for i = 1, #due do
        local card = due[i]
        local title = card.title
        if card.displayType == "resonance" then
          title = tostring(card.temperament) .. " " .. tostring(card.resonanceType)
        end
        rows[#rows + 1] = {
          color = color,
          name = name,
          id = card.id,
          title = title or "Condition",
          trigger = PC.triggerLabel(card.removalTrigger),
          pending = card.pending,
          hunger = tonumber(S.getPlayerVal(color, "hunger")) or 0,
        }
      end
    end
  end
  return rows
end

--- @param color string
--- @param temperament string
--- @param resonanceType string
--- @return string|nil error
function P.setResonance(color, temperament, resonanceType)
  local pid, err = requirePlayer(color)
  if pid == nil then
    return err
  end
  if not PC.isTemperament(temperament) or not PC.isResonanceType(resonanceType) then
    return "Unknown resonance."
  end
  local list = readList(pid)
  local existing = PC.resonanceCard(list)
  if existing ~= nil and existing.temperament == temperament and existing.resonanceType == resonanceType then
    for i = #list, 1, -1 do
      if list[i].displayType == "resonance" then
        table.remove(list, i)
      end
    end
    writeList(pid, list)
    markSeatsDirty()
    return nil
  end
  local kept = {}
  for i = 1, #list do
    if list[i].displayType ~= "resonance" then
      kept[#kept + 1] = list[i]
    end
  end
  local seq = nextSeq(kept)
  kept[#kept + 1] = {
    id = "pc-" .. tostring(seq),
    seq = seq,
    appliedOn = PC.clockStamp(S.getStateVal("presentDayClock")),
    displayType = "resonance",
    displayOnSheet = false,
    temperament = temperament,
    resonanceType = resonanceType,
    removalTrigger = "Manual",
    title = "",
    subtitle = "",
    description = "",
    duration = "",
  }
  writeList(pid, kept)
  markSeatsDirty()
  return nil
end

--- @param color string
--- @param title string
--- @param description string
--- @return string|nil error
function P.setDyscrasia(color, title, description)
  local pid, err = requirePlayer(color)
  if pid == nil then
    return err
  end
  local list = readList(pid)
  local card = PC.resonanceCard(list)
  if card == nil then
    return "There is no resonance to attach that dyscrasia to."
  end
  if card.temperament ~= "acutely" then
    return "Only an acute resonance takes a dyscrasia."
  end
  local name = text(title, 80)
  if name == "" then
    card.dyscrasiaTitle = nil
    card.dyscrasiaDescription = nil
  else
    card.dyscrasiaTitle = name
    card.dyscrasiaDescription = text(description, 400)
  end
  writeList(pid, list)
  markSeatsDirty()
  return nil
end

--- @param color string
--- @param fields table
--- @return string|nil error
function P.addCard(color, fields)
  local pid, err = requirePlayer(color)
  if pid == nil then
    return err
  end
  if type(fields) ~= "table" then
    return "Missing condition."
  end
  local displayType = fields.displayType
  if not PC.isSheetType(displayType) then
    return "Pick a condition type."
  end
  local trigger, triggerErr = triggerFromFields(fields)
  if trigger == nil then
    return triggerErr
  end
  if trigger == "ChangeOfBlood" then
    local hunger = tonumber(S.getPlayerVal(color, "hunger")) or 0
    if hunger >= 5 then
      return "Hunger is already 5, so a Change of Blood condition cannot be applied."
    end
  end
  local onSheet = fields.displayOnSheet ~= false
  local list = readList(pid)
  if onSheet and PC.sheetSlotCount(list) >= PC.SHEET_SLOT_COUNT then
      return "The sheet already has eight conditions. Remove one before adding another."
  end
  local conditionId = fields.condition
  local owns = false
  if type(conditionId) == "string" and conditionId ~= "" then
    local def = CD.getDef(conditionId)
    if def.canApplyManually ~= true or type(def.instanceSchema) == "table" then
      return "That mechanic cannot be applied from this list."
    end
    if S.getStateVal("playerData", pid, "conditions", conditionId) == nil then
      require("core.conditions").setManual(pid, conditionId, true, { skipAfterChange = true })
      owns = true
    end
  else
    conditionId = nil
  end
  local seq = nextSeq(list)
  local duration = fields.duration
  if type(duration) ~= "string" then
    duration = PC.durationForTrigger(trigger)
  else
    duration = text(duration, 240)
  end
  list[#list + 1] = {
    id = "pc-" .. tostring(seq),
    seq = seq,
    appliedOn = PC.clockStamp(S.getStateVal("presentDayClock")),
    displayOnSheet = onSheet,
    displayType = displayType,
    textColor = PC.normalizeTextColor(fields.textColor),
    removalTrigger = trigger,
    title = text(fields.title, 80),
    subtitle = text(fields.subtitle, 80),
    description = text(fields.description, 400),
    duration = duration,
    condition = conditionId,
    ownsMechanic = owns,
  }
  recheckSavedTriggers(list)
  writeList(pid, list)
  markSeatsDirty()
  return nil
end

--- @param color string
--- @param id string
--- @return string|nil error
function P.removeCard(color, id)
  local pid, err = requirePlayer(color)
  if pid == nil then
    return err
  end
  local list = readList(pid)
  local card, index = findCard(list, id)
  if card == nil or index == nil then
    return "That condition is no longer on the sheet."
  end
  if card.displayType == "resonance" then
    return "Clear resonance from its own grid."
  end
  releaseMechanic(pid, card)
  table.remove(list, index)
  writeList(pid, list)
  markSeatsDirty()
  return nil
end

--- @param color string
--- @param id string
--- @return string|nil error
function P.confirmDue(color, id)
  local pid, err = requirePlayer(color)
  if pid == nil then
    return err
  end
  local list = readList(pid)
  local card, index = findCard(list, id)
  if card == nil or index == nil or type(card.pending) ~= "string" then
    return "That condition is not waiting to be removed."
  end
  releaseMechanic(pid, card)
  table.remove(list, index)
  writeList(pid, list)
  markSeatsDirty()
  return nil
end

--- @param color string
--- @param id string
--- @return string|nil error
function P.skipDue(color, id)
  local pid, err = requirePlayer(color)
  if pid == nil then
    return err
  end
  local list = readList(pid)
  local card = findCard(list, id)
  if card == nil or type(card.pending) ~= "string" then
    return "That condition is not waiting to be removed."
  end
  PC.skipCard(card)
  writeList(pid, list)
  markSeatsDirty()
  return nil
end

--- @param color string
--- @param id string
--- @param fields table
--- @return string|nil error
function P.editDue(color, id, fields)
  local pid, err = requirePlayer(color)
  if pid == nil then
    return err
  end
  local trigger, triggerErr = triggerFromFields(fields)
  if trigger == nil then
    return triggerErr
  end
  if trigger == "ChangeOfBlood" then
    local hunger = tonumber(S.getPlayerVal(color, "hunger")) or 0
    if hunger >= 5 then
      return "Hunger is already 5, so this cannot become a Change of Blood condition."
    end
  end
  local list = readList(pid)
  local card = findCard(list, id)
  if card == nil or type(card.pending) ~= "string" then
    return "That condition is not waiting to be removed."
  end
  card.removalTrigger = trigger
  local duration = type(fields) == "table" and fields.duration or nil
  card.duration = type(duration) == "string" and text(duration, 240) or PC.durationForTrigger(trigger)
  card.pending = nil
  card.sceneLatch = nil
  card.hungerLatch = nil
  card.sessionLatch = nil
  card.dateLatch = nil
  recheckSavedTriggers(list)
  writeList(pid, list)
  markSeatsDirty()
  return nil
end

--- Narrative leave: the seat was in the scene and is now out, or the scene changed under them.
--- @param color string
function P.onLeftScene(color)
  local pid = playerId(color)
  if pid == nil then
    return
  end
  sceneEpoch = sceneEpoch + 1
  local list = readList(pid)
  if not PC.markSceneLeave(list, sceneEpoch) then
    return
  end
  writeList(pid, list)
  markSeatsDirty()
end

--- Play advanced to Spotlight: everyone still in the scene leaves it.
function P.onPlayToSpotlight()
  local NPCS = require("core.npcs")
  for _, color in ipairs(C.PlayerColors or {}) do
    if NPCS.resolvePlayerSeatPresence(color) then
      P.onLeftScene(color)
    end
  end
end

--- Called with the colors who were present in the scene being replaced.
--- @param wasPresent table color -> boolean
function P.onSceneReplaced(wasPresent)
  if type(wasPresent) ~= "table" then
    return
  end
  for _, color in ipairs(C.PlayerColors or {}) do
    if wasPresent[color] == true then
      P.onLeftScene(color)
    end
  end
end

--- @param color string
--- @param oldHunger number
--- @param newHunger number
function P.onHunger(color, oldHunger, newHunger)
  local pid = playerId(color)
  if pid == nil then
    return
  end
  local list = readList(pid)
  if not PC.markHunger(list, oldHunger, newHunger) then
    return
  end
  writeList(pid, list)
  markSeatsDirty()
end

function P.onSessionEnd()
  local session = tonumber(S.getStateVal("sessionNum")) or 1
  local dirty = false
  for _, color in ipairs(C.PlayerColors or {}) do
    local pid = playerId(color)
    if pid ~= nil then
      local list = readList(pid)
      if PC.markSessionEnd(list, session) then
        writeList(pid, list)
        dirty = true
      end
    end
  end
  if dirty then
    markSeatsDirty()
  end
end

function P.onClock()
  local clock = S.getStateVal("presentDayClock")
  local dirty = false
  for _, color in ipairs(C.PlayerColors or {}) do
    local pid = playerId(color)
    if pid ~= nil then
      local list = readList(pid)
      if PC.markClock(list, clock, duskForTrigger) then
        writeList(pid, list)
        dirty = true
      end
    end
  end
  if dirty then
    markSeatsDirty()
  end
end

--- Load: a date already past dusk, or an End phase already underway, is waiting when the table finishes loading.
--- Startup sync paints the sheets; this does not announce seats on its own.
function P.onLoad()
  local clock = S.getStateVal("presentDayClock")
  local session = tonumber(S.getStateVal("sessionNum")) or 1
  local ending = S.getStateVal("currentPhase") == C.Phases.END
  for _, color in ipairs(C.PlayerColors or {}) do
    local pid = playerId(color)
    if pid ~= nil then
      local list = readList(pid)
      local changed = PC.markClock(list, clock, duskForTrigger)
      if ending and PC.markSessionEnd(list, session) then
        changed = true
      end
      if changed then
        writeList(pid, list)
      end
    end
  end
end

return P
