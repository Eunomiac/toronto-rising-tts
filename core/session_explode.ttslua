--[[
    Session-start cover animation for Intermission → Play (TOR-559 / TOR-567).

    TTS showAnimation / hideAnimation splash (TEST BED runIntroSequence).
    Scales so the intro track and splash end together: timeRatio from
    songDuration vs 148.4s unscaled length, 1s unscalable tail, and 27s
    song lead-in. TR_Loop starts fading at splash start; Music C begins when
    that fade is about 75% done (loop still at ~25% volume). songDuration 0
    (Quick Transition) uses timeRatio 0 and skips Music C. Number/title art
    comes from gameState.sessionNum. The end blackout drops the session-start
    panel and leaves the rest of the HUD in place (no XML remount).
]]

local SessionExplode = {}

local U = require("lib.util")
local C = require("lib.constants")
local S = require("core.state")

local PANEL_ID = "overlay_sessionStart_panel"
local COVER_ID = "overlay_sessionStartSplash"
local BASE_PANEL_ID = "overlay_sessionStartSplash_panel"
local SESSION_NUMBER_ID = "overlay_sessionNumber"
local SESSION_TITLE_ID = "overlay_sessionTitle"
local SESSION_NUMBER_PANEL_ID = "overlay_sessionNumberPanel_6"
local SESSION_TITLE_PANEL_ID = "overlay_sessionTitlePanel_7"
local BLACKOUT_ID = "overlay_sessionStart_blackoutPanel"

-- Attribute-animation author timings (TEST BED runIntroSequence, 2026-09-19).
-- Measured at timeRatio = 1. Number/title wall time is 0–10s with the splash ratio.
local ATTRIBUTE_UNSCALED_FULL_DURATION = 148.4
local ATTRIBUTE_UNSCALABLE_TIME = 1
local ATTRIBUTE_SONG_START_DELAY = 27
local ATTRIBUTE_CHARACTER_SEQUENCE_DURATION = 20
local ATTRIBUTE_CHARACTER_BEAT_SEC = 31
local ATTRIBUTE_NUM_TITLE_MAX_SEC = 10
local ATTRIBUTE_NUM_TITLE_MIN_SEC = 0
--- Music C starts when the TR_Loop fade is this far along (remaining volume = 1 - this).
local ATTRIBUTE_LOOP_FADE_AT_SONG_START = 0.75
local ATTRIBUTE_BLACKOUT_SHOW_SEC = 1
local ATTRIBUTE_PANEL_DOWN_GAP_SEC = 0.5
local ATTRIBUTE_BLACKOUT_HIDE_SEC = 1

local CHARACTER_TEXT_PANEL_DATA = {
  [1] = {
    showAnimation = "SlideIn_Left",
    offsetXY = "900 0",
    scale = "1",
  },
  [2] = {
    showAnimation = "Grow",
    offsetXY = "0 0",
    scale = "0.9",
  },
  [3] = {
    showAnimation = "Grow",
    offsetXY = "0 0",
    scale = "0.9",
  },
  [4] = {
    showAnimation = "SlideIn_Right",
    offsetXY = "-900 0",
    scale = "1",
  },
  [5] = {
    showAnimation = "SlideIn_Bottom",
    offsetXY = "0 500",
    scale = "1",
  },
}

local SPLASH_IDS = {
  "overlay_characterIntroCaption_1",
  "overlay_characterIntroImage_1",
  "overlay_characterIntroCaption_2",
  "overlay_characterIntroImage_2",
  "overlay_characterIntroCaption_3",
  "overlay_characterIntroImage_3",
  "overlay_characterIntroCaption_4",
  "overlay_characterIntroImage_4",
  "overlay_characterIntroCaption_5",
  "overlay_characterIntroImage_5",
  SESSION_NUMBER_ID,
  SESSION_TITLE_ID,
}

local SPLASH_PANEL_IDS = {
  "overlay_characterIntroCaptionPanel_1",
  "overlay_characterIntroImagePanel_1",
  "overlay_characterIntroCaptionPanel_2",
  "overlay_characterIntroImagePanel_2",
  "overlay_characterIntroCaptionPanel_3",
  "overlay_characterIntroImagePanel_3",
  "overlay_characterIntroCaptionPanel_4",
  "overlay_characterIntroImagePanel_4",
  "overlay_characterIntroCaptionPanel_5",
  "overlay_characterIntroImagePanel_5",
  SESSION_NUMBER_PANEL_ID,
  SESSION_TITLE_PANEL_ID
}

local sequenceGen = 0

local attributeStillCurrent
local attributeChainMaxWait

--- Host chrome that sits on top of the splash (TEST BED runIntroSequenceStandalone).
local ST_SESSION_CHROME_IDS = {
  "adminControls",
  "panel_STcamera",
}

local function hideStorytellerSessionChrome()
  for i = 1, #ST_SESSION_CHROME_IDS do
    UI.hide(ST_SESSION_CHROME_IDS[i])
  end
end

local function showStorytellerSessionChrome()
  for i = 1, #ST_SESSION_CHROME_IDS do
    UI.show(ST_SESSION_CHROME_IDS[i])
  end
end

local function hideSessionStartPanel()
  U.setAttributes(PANEL_ID, { active = "false" })
end

local function numTitleWallSec(timeRatio)
  local span = ATTRIBUTE_NUM_TITLE_MAX_SEC - ATTRIBUTE_NUM_TITLE_MIN_SEC
  return (span * timeRatio) + ATTRIBUTE_NUM_TITLE_MIN_SEC
end

--- Session number / title splash.
--- kind: "number" | "title". Title ends on the blackout, then drops the session-start panel.
--- Art name is overlay_sessionNumber_<sessionNum> / overlay_sessionTitle_<sessionNum>.
local function runNumTitleSequence(gen, kind, timeRatio, waitSec)
  local wallSec = numTitleWallSec(timeRatio)
  local isTitle = kind == "title"
  local prefix = isTitle and "overlay_sessionTitle" or "overlay_sessionNumber"
  local containerID = isTitle and SESSION_TITLE_PANEL_ID or SESSION_NUMBER_PANEL_ID
  local bgPanelID = prefix .. "BgPanel"
  local bgImageID = prefix .. "_bg"
  local imagePanelID = prefix .. "ImagePanel"
  local imageID = prefix
  local sessionNum = SessionExplode.resolveAnimationData().sessionNum
  local imageRef = prefix .. "_" .. tostring(sessionNum)

  local fullDuration = 40 * timeRatio
  local leadInBgGrow = 20 * timeRatio
  local leadInBgImage = 27 * timeRatio
  local leadInTextGrow = 27 * timeRatio
  local leadInTextImage = 27 * timeRatio
  local bgGrowExtra = 16 * timeRatio
  local imageGrowExtra = 8 * timeRatio

  U.setAttributes(containerID, {
    color = "rgba(0, 0, 0, 0)",
    scale = "5",
    active = "true",
    hideAnimation = "FadeOut",
    animationDuration = 1,
  })
  U.setAttributes(bgPanelID, {
    active = "true",
    color = "rgba(0, 0, 0, 0)",
    scale = "1",
    showAnimation = "Grow",
    showAnimationDelay = leadInBgGrow,
    animationDuration = fullDuration - leadInBgGrow + bgGrowExtra,
  })
  U.setAttributes(bgImageID, {
    active = "false",
    scale = "3",
    showAnimation = "FadeIn",
    showAnimationDelay = leadInBgImage,
    hideAnimation = "FadeOut",
    animationDuration = 0.5,
  })
  U.setAttributes(imagePanelID, {
    active = "true",
    color = "rgba(0, 0, 0, 0)",
    scale = "1",
    showAnimation = "Grow",
    showAnimationDelay = leadInTextGrow,
    animationDuration = fullDuration - leadInTextGrow + imageGrowExtra,
  })
  U.setAttributes(imageID, {
    active = "false",
    scale = "1",
    showAnimation = "FadeIn",
    hideAnimation = "FadeOut",
    animationDuration = 0.5,
    showAnimationDelay = leadInTextImage,
    image = imageRef,
  })

  local steps = {
    function()
      if not attributeStillCurrent(gen) then
        return 0
      end
      UI.show(containerID)
      UI.show(bgImageID)
      UI.show(imageID)
      return wallSec
    end,
  }
  if isTitle then
    table.insert(steps, function()
      if not attributeStillCurrent(gen) then
        return 0
      end
      return (fullDuration - wallSec) * 0.95
    end)
    table.insert(steps, function()
      if not attributeStillCurrent(gen) then
        return 0
      end
      UI.show(BLACKOUT_ID)
      return ATTRIBUTE_BLACKOUT_SHOW_SEC
    end)
    table.insert(steps, function()
      if not attributeStillCurrent(gen) then
        return 0
      end
      hideSessionStartPanel()
      return ATTRIBUTE_PANEL_DOWN_GAP_SEC
    end)
    table.insert(steps, function()
      if not attributeStillCurrent(gen) then
        return 0
      end
      UI.hide(BLACKOUT_ID)
      return ATTRIBUTE_BLACKOUT_HIDE_SEC
    end)
    table.insert(steps, function()
      if not attributeStillCurrent(gen) then
        return 0
      end
      showStorytellerSessionChrome()
      return 0
    end)
  end
  U.chain(steps, { maxWait = attributeChainMaxWait(waitSec) })
end

local function applyIdleAttrs(id, color)
  U.setAttributes(id, {
    active = "true",
    color = color,
    scale = "1",
    offsetXY = "0 0",
  })
end

--- Restore Intermission look: opaque session cover, splash panels inactive.
--- Splash images stay opaque white (session_splash_* Defaults / attribute-path ready);
--- inactive parents keep them invisible on Intermission.
function SessionExplode.resetLayers()
  showStorytellerSessionChrome()
  U.setAttributes(BASE_PANEL_ID, {
    active = "true",
    color = "rgba(1, 1, 1, 1)",
  })
  applyIdleAttrs(COVER_ID, "rgba(1, 1, 1, 1)")
  for i = 1, #SPLASH_IDS do
    applyIdleAttrs(SPLASH_IDS[i], "rgba(1, 1, 1, 1)")
  end
  for i = 1, #SPLASH_PANEL_IDS do
    local panelId = SPLASH_PANEL_IDS[i]
    local color = "rgba(1, 1, 1, 0)"
    if panelId == SESSION_NUMBER_PANEL_ID or panelId == SESSION_TITLE_PANEL_ID then
      color = "rgba(0, 0, 0, 1)"
    end
    U.setAttributes(panelId, {
      active = "false",
      color = color,
    })
  end
  U.setAttributes(BLACKOUT_ID, { active = "false" })
end

--- Stop an in-flight splash sequence. Does not snap attrs (hide first, then resetLayers when showing Intermission).
function SessionExplode.cancel()
  sequenceGen = sequenceGen + 1
  showStorytellerSessionChrome()
end

--- introKey + songDuration for the current `sessionNum`. Missing index falls back to [1].
-- @return table `{ sessionNum, introKey, songDuration, usedIndex }`
function SessionExplode.resolveAnimationData()
  local sessionNum = math.floor(tonumber(S.getStateVal("sessionNum")) or 1)
  if sessionNum < 1 then
    sessionNum = 1
  end
  local tableData = C.SessionStartAnimationData
  if type(tableData) ~= "table" then
    error("SessionExplode.resolveAnimationData: C.SessionStartAnimationData is missing")
  end
  local usedIndex = sessionNum
  local entry = tableData[sessionNum]
  if type(entry) ~= "table" then
    usedIndex = 1
    entry = tableData[1]
  end
  if type(entry) ~= "table" then
    error("SessionExplode.resolveAnimationData: no animation data for session " ..
    tostring(sessionNum) .. " and index 1 is missing")
  end
  local introKey = entry.introKey
  if type(introKey) ~= "string" or introKey == "" then
    error("SessionExplode.resolveAnimationData: introKey missing for index " .. tostring(usedIndex))
  end
  local songDuration = tonumber(entry.songDuration)
  if songDuration == nil or songDuration <= 0 then
    error("SessionExplode.resolveAnimationData: songDuration must be a positive number of seconds for index " ..
    tostring(usedIndex))
  end
  return {
    sessionNum = sessionNum,
    introKey = introKey,
    songDuration = songDuration,
    usedIndex = usedIndex,
  }
end

--- Scale factor so song end matches splash end (TEST BED runIntroSequence).
--- songDuration 0 (or shorter than the unscalable tail) returns timeRatio 0.
-- @param songDuration number|nil
-- @return number
function SessionExplode.attributeTimeRatio(songDuration)
  if songDuration == nil then
    songDuration = SessionExplode.resolveAnimationData().songDuration
  end
  if type(songDuration) ~= "number" or songDuration < 0 then
    error("SessionExplode.attributeTimeRatio: songDuration must be 0 or a positive number of seconds")
  end
  local scalableSongWindow = (ATTRIBUTE_UNSCALED_FULL_DURATION - ATTRIBUTE_SONG_START_DELAY)
      - ATTRIBUTE_UNSCALABLE_TIME
  if scalableSongWindow <= 0 then
    error("SessionExplode.attributeTimeRatio: scalable song window must be > 0")
  end
  if songDuration < ATTRIBUTE_UNSCALABLE_TIME then
    return 0
  end
  return (songDuration - ATTRIBUTE_UNSCALABLE_TIME) / scalableSongWindow
end

--- Scaled delay from splash start until Music C (ATTRIBUTE_SONG_START_DELAY * timeRatio).
-- @param songDuration number|nil
-- @return number
function SessionExplode.attributeSongLeadInSec(songDuration)
  return ATTRIBUTE_SONG_START_DELAY * SessionExplode.attributeTimeRatio(songDuration)
end

--- Start TR_Loop fading so Music C begins at about 75% of the fade
--- (loop still near 25% volume). Fade finishes during the opening of the sting.
-- @param songDuration number|nil
function SessionExplode.fadeIntermissionLoopForAttributeIntro(songDuration)
  local leadIn = SessionExplode.attributeSongLeadInSec(songDuration)
  local fadeSeconds = 0
  if leadIn > 0 and ATTRIBUTE_LOOP_FADE_AT_SONG_START > 0 then
    fadeSeconds = leadIn / ATTRIBUTE_LOOP_FADE_AT_SONG_START
  end
  local Soundscape = require("core.soundscape")
  local okStop, stopMsg = Soundscape.stopFeaturedMusic({
    fadeSeconds = fadeSeconds,
    resumeBackground = false,
  })
  if okStop ~= true then
    U.AlertGM("Session start Loop fade-out: " .. tostring(stopMsg or "stopFeaturedMusic failed"))
  end
end

--- Wall-clock seconds Play-enter should wait after playAttribute() is started.
-- Covers splash end (song-aligned) plus the overlay hide settle.
-- @param songDuration number|nil
-- @return number
function SessionExplode.attributeSequenceDurationSec(songDuration)
  local timeRatio = SessionExplode.attributeTimeRatio(songDuration)
  local animEnds = ATTRIBUTE_UNSCALABLE_TIME
      + timeRatio * (ATTRIBUTE_UNSCALED_FULL_DURATION - ATTRIBUTE_UNSCALABLE_TIME)
  return animEnds + ATTRIBUTE_BLACKOUT_SHOW_SEC + ATTRIBUTE_PANEL_DOWN_GAP_SEC + ATTRIBUTE_BLACKOUT_HIDE_SEC
end

--- Play-enter U.chain maxWait uses the catalog-length splash (Quick Transition is shorter).
-- @return number
function SessionExplode.maxPlayEnterWaitSec()
  return SessionExplode.attributeSequenceDurationSec()
end

local function fireAttributeSessionIntroAudio()
  local Soundscape = require("core.soundscape")
  local anim = SessionExplode.resolveAnimationData()
  local okPlay, playMsg = Soundscape.playSessionIntro(anim.introKey, { fadeSeconds = 0 })
  if okPlay ~= true then
    U.AlertGM("Session start overture: " .. tostring(playMsg or "playSessionIntro failed"))
  end
  if type(Soundscape.commitEagerSteadyState) == "function" then
    Soundscape.commitEagerSteadyState(okPlay == true)
  end
end

attributeStillCurrent = function(gen)
  return sequenceGen == gen
end

attributeChainMaxWait = function(waitSec)
  return math.max(60, waitSec + 5)
end

local function runCharacterSequence(gen, sequenceNumber, timeRatio, waitSec, playSessionIntro)
  local textPanelID = "overlay_characterIntroCaptionPanel_" .. sequenceNumber
  local imagePanelID = "overlay_characterIntroImagePanel_" .. sequenceNumber
  local textID = "overlay_characterIntroCaption_" .. sequenceNumber
  local imageID = "overlay_characterIntroImage_" .. sequenceNumber
  local textPanelData = CHARACTER_TEXT_PANEL_DATA[sequenceNumber]
  if type(textPanelData) ~= "table" then
    error("SessionExplode.runCharacterSequence: missing panel data for sequence " .. tostring(sequenceNumber))
  end

  U.setAttributes(textPanelID, {
    active = "false",
    showAnimation = textPanelData.showAnimation,
    animationDuration = 60 * timeRatio,
  })
  U.setAttributes(textID, {
    active = "true",
    showAnimation = "FadeIn",
    showAnimationDelay = 34 * timeRatio,
    animationDuration = 4,
    hideAnimation = "FadeOut",
    hideAnimationDelay = 0,
    offsetXY = textPanelData.offsetXY,
    scale = textPanelData.scale,
  })
  U.setAttributes(imagePanelID, {
    active = "false",
    showAnimation = "Grow",
    animationDuration = 35 * timeRatio,
  })
  U.setAttributes(imageID, {
    active = "true",
    showAnimation = "FadeIn",
    showAnimationDelay = 27 * timeRatio,
    animationDuration = 0.5,
    scale = "1",
    hideAnimationDelay = 1.5,
    hideAnimation = "FadeOut",
  })

  U.chain({
    function()
      if not attributeStillCurrent(gen) then
        return 0
      end
      UI.show(textPanelID)
      UI.show(imagePanelID)
      if sequenceNumber == 1 and playSessionIntro then
        U.await(
          function()
            if not attributeStillCurrent(gen) then
              return
            end
            fireAttributeSessionIntroAudio()
          end, ATTRIBUTE_SONG_START_DELAY * timeRatio
        )
      end
      return ATTRIBUTE_CHARACTER_BEAT_SEC * timeRatio
    end,
    function()
      if not attributeStillCurrent(gen) then
        return 0
      end
      UI.hide(textID)
      return 0
    end,
  }, { maxWait = attributeChainMaxWait(waitSec) })
end

local function runAttributeSequences(gen, timeRatio, waitSec, playSessionIntro)
  local characterSequenceDuration = ATTRIBUTE_CHARACTER_SEQUENCE_DURATION * timeRatio
  local numTitleSec = numTitleWallSec(timeRatio)
  local chainFunctions = {}
  for sequenceNumber = 1, 5 do
    table.insert(chainFunctions, function()
      if not attributeStillCurrent(gen) then
        return 0
      end
      runCharacterSequence(gen, sequenceNumber, timeRatio, waitSec, playSessionIntro)
      return characterSequenceDuration
    end)
  end
  table.insert(chainFunctions, function()
    if not attributeStillCurrent(gen) then
      return 0
    end
    runNumTitleSequence(gen, "number", timeRatio, waitSec)
    return numTitleSec
  end)
  table.insert(chainFunctions, function()
    if not attributeStillCurrent(gen) then
      return 0
    end
    runNumTitleSequence(gen, "title", timeRatio, waitSec)
    return numTitleSec
  end)
  U.chain(chainFunctions, { maxWait = attributeChainMaxWait(waitSec) })
end

--- Start the TTS-attribute Intermission→Play animation (TEST BED runIntroSequence).
--- songDuration nil uses C.SessionStartAnimationData for the current sessionNum
--- (session 1 is 71s): fades TR_Loop so Music C starts about 75% through that fade,
--- and plays Music C when the scaled lead-in ends.
--- songDuration 0 (Quick Transition) runs at timeRatio 0 and skips Music C.
--- Returns immediately; wait attributeSequenceDurationSec(songDuration).
-- @param songDuration number|nil
-- @return number attributeSequenceDurationSec
function SessionExplode.playAttribute(songDuration)
  if songDuration == nil then
    songDuration = SessionExplode.resolveAnimationData().songDuration
  end
  if type(songDuration) ~= "number" or songDuration < 0 then
    error("SessionExplode.playAttribute: songDuration must be 0 or a positive number of seconds")
  end
  local timeRatio = SessionExplode.attributeTimeRatio(songDuration)
  local waitSec = SessionExplode.attributeSequenceDurationSec(songDuration)
  local playSessionIntro = songDuration > 0

  sequenceGen = sequenceGen + 1
  local gen = sequenceGen

  hideStorytellerSessionChrome()
  U.setAttributes(PANEL_ID, { active = "true" })
  SessionExplode.fadeIntermissionLoopForAttributeIntro(songDuration)
  runAttributeSequences(gen, timeRatio, waitSec, playSessionIntro)
  return waitSec
end

return SessionExplode
