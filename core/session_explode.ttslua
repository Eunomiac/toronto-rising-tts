--[[
    Session-start cover animation for Intermission → Play (TOR-559 / TOR-567).

    Two paths (Phases panel toggle `phase_sessionStartLerp`):
    - Attribute path (default): TTS showAnimation / hideAnimation only — fewer
      per-frame XmlUI attribute writes for join clients.
    - Lerp path (toggle on): author-tuned U.Lerp explode (TOR-516 / TOR-531).

    Lerp wall-clock times scale by songDuration / C.SessionStartBaseDuration.
    Attribute path (TEST BED runIntroSequence) scales so the intro track and
    splash end together: timeRatio from songDuration vs 140.7s unscaled length,
    15.5s unscalable tail, and 27s song lead-in. TR_Loop fades across that
    scaled lead-in and reaches silence when Music C starts.
]]

local SessionExplode = {}

local U = require("lib.util")
local C = require("lib.constants")
local S = require("core.state")

local PANEL_ID = "overlay_sessionStart_panel"
local COVER_ID = "overlay_sessionStartSplash"
local BASE_PANEL_ID = "overlay_sessionStartSplash_panel"
local FRAME_PANEL_ID = "overlay_sessionSplashFrame_panel"
local SESSION_NUMBER_ID = "overlay_sessionNumber_6"
local SESSION_TITLE_ID = "overlay_sessionTitle_7"
local SESSION_NUMBER_PANEL_ID = "overlay_sessionNumberPanel_6"
local SESSION_TITLE_PANEL_ID = "overlay_sessionTitlePanel_7"

-- Unscaled author timings (71s base). explodeImage and play() apply durationMultiplier.
local DELAY_TIME = 12
local TEXT_DELAY_RATIO = 0.25
local TEXT_FADE_IN = 2
local COVER_SCALE_DUR = 0.8
local PAIR_WAVER_TIME = 12
local PAIR_SCALE_TIME = 1.2
local PAIR_WAVER_SPEED = 0.5
local DEFAULT_WAVER_SPEED = 0.2
local DEFAULT_WAVER_LIMIT = 50
local SESSION_NUM_SCALE_DUR = 4.5
local SESSION_TITLE_SCALE_DUR = 9
local AFTER_TITLE_WAIT = 8.5
local HIDE_SETTLE = 3
local SCALE_END = 2
local DEFAULT_SCALE_EASE = "powerIn"

-- Attribute-animation author timings (TEST BED runIntroSequence).
-- Measured at timeRatio = 1; number/title tail is unscaled (numTitleTimeRatio = 1).
local ATTRIBUTE_UNSCALED_FULL_DURATION = 140.7
local ATTRIBUTE_UNSCALABLE_TIME = 15.5
local ATTRIBUTE_SONG_START_DELAY = 27
local ATTRIBUTE_CHARACTER_SEQUENCE_DURATION = 20
local ATTRIBUTE_HIDE_OVERLAY_SETTLE_SEC = 3

local CHARACTER_TEXT_PANEL_DATA = {
    [1] = {
        showAnimation = "SlideIn_Left",
        offsetXY = "900 0",
        scale = "1",
    },
    [2] = {
        showAnimation = "Grow",
        offsetXY = "0 0",
        scale = "0.9",
    },
    [3] = {
        showAnimation = "Grow",
        offsetXY = "0 0",
        scale = "0.9",
    },
    [4] = {
        showAnimation = "SlideIn_Right",
        offsetXY = "-900 0",
        scale = "1",
    },
    [5] = {
        showAnimation = "SlideIn_Bottom",
        offsetXY = "0 300",
        scale = "1",
    },
}

local SPLASH_IDS = {
    "overlay_characterIntroCaption_1",
    "overlay_characterIntroImage_1",
    "overlay_characterIntroCaption_2",
    "overlay_characterIntroImage_2",
    "overlay_characterIntroCaption_3",
    "overlay_characterIntroImage_3",
    "overlay_characterIntroCaption_4",
    "overlay_characterIntroImage_4",
    "overlay_characterIntroCaption_5",
    "overlay_characterIntroImage_5",
    SESSION_NUMBER_ID,
    SESSION_TITLE_ID,
}

local SPLASH_PANEL_IDS = {
    "overlay_characterIntroCaptionPanel_1",
    "overlay_characterIntroImagePanel_1",
    "overlay_characterIntroCaptionPanel_2",
    "overlay_characterIntroImagePanel_2",
    "overlay_characterIntroCaptionPanel_3",
    "overlay_characterIntroImagePanel_3",
    "overlay_characterIntroCaptionPanel_4",
    "overlay_characterIntroImagePanel_4",
    "overlay_characterIntroCaptionPanel_5",
    "overlay_characterIntroImagePanel_5",
    SESSION_NUMBER_PANEL_ID,
    SESSION_TITLE_PANEL_ID,
    FRAME_PANEL_ID,
}

local explodeGenById = {}
local sequenceGen = 0

local function hideGlobalPanel()
    local fn = rawget(_G, "hideStartupLoadingOverlaysForPhases")
    if type(fn) == "function" then
        fn()
        return
    end
    if type(UI.hide) == "function" then
        UI.hide(PANEL_ID)
    end
end

local function clampWaver(limit, v)
    if v > limit then
        return limit
    end
    if v < -limit then
        return -limit
    end
    return v
end

local function randRange(lo, hi)
    return lo + math.random() * (hi - lo)
end

local function stillCurrent(id, gen)
    return explodeGenById[id] == gen
end

local function applyIdleAttrs(id, color)
    U.setAttributes(id, {
        active = "true",
        color = color,
        scale = "1",
        offsetXY = "0 0",
    })
end

--- Restore Intermission look: opaque session cover, splash panels inactive.
--- Splash images stay opaque white (session_splash_* Defaults / attribute-path ready);
--- inactive parents keep them invisible on Intermission.
function SessionExplode.resetLayers()
    U.setAttributes(BASE_PANEL_ID, {
        active = "true",
        color = "rgba(1, 1, 1, 1)",
    })
    applyIdleAttrs(COVER_ID, "rgba(1, 1, 1, 1)")
    for i = 1, #SPLASH_IDS do
        applyIdleAttrs(SPLASH_IDS[i], "rgba(1, 1, 1, 1)")
    end
    for i = 1, #SPLASH_PANEL_IDS do
        local panelId = SPLASH_PANEL_IDS[i]
        local color = "rgba(1, 1, 1, 0)"
        if panelId == SESSION_NUMBER_PANEL_ID or panelId == SESSION_TITLE_PANEL_ID then
            color = "rgba(0, 0, 0, 1)"
        end
        U.setAttributes(panelId, {
            active = "false",
            color = color,
        })
    end
end

--- Stop in-flight layer lerps. Does not snap attrs (hide first, then resetLayers when showing Intermission).
function SessionExplode.cancel()
    sequenceGen = sequenceGen + 1
    for id, gen in pairs(explodeGenById) do
        explodeGenById[id] = gen + 1
    end
end

--- introKey + songDuration for the current `sessionNum`. Missing index falls back to [1].
-- @return table `{ sessionNum, introKey, songDuration, usedIndex }`
function SessionExplode.resolveAnimationData()
    local sessionNum = math.floor(tonumber(S.getStateVal("sessionNum")) or 1)
    if sessionNum < 1 then
        sessionNum = 1
    end
    local tableData = C.SessionStartAnimationData
    if type(tableData) ~= "table" then
        error("SessionExplode.resolveAnimationData: C.SessionStartAnimationData is missing")
    end
    local usedIndex = sessionNum
    local entry = tableData[sessionNum]
    if type(entry) ~= "table" then
        usedIndex = 1
        entry = tableData[1]
    end
    if type(entry) ~= "table" then
        error("SessionExplode.resolveAnimationData: no animation data for session " .. tostring(sessionNum) .. " and index 1 is missing")
    end
    local introKey = entry.introKey
    if type(introKey) ~= "string" or introKey == "" then
        error("SessionExplode.resolveAnimationData: introKey missing for index " .. tostring(usedIndex))
    end
    local songDuration = tonumber(entry.songDuration)
    if songDuration == nil or songDuration <= 0 then
        error("SessionExplode.resolveAnimationData: songDuration must be a positive number of seconds for index " .. tostring(usedIndex))
    end
    return {
        sessionNum = sessionNum,
        introKey = introKey,
        songDuration = songDuration,
        usedIndex = usedIndex,
    }
end

--- songDuration / C.SessionStartBaseDuration. Omitting songDuration reads the current session.
-- @param songDuration number|nil
-- @return number
function SessionExplode.durationMultiplier(songDuration)
    local base = tonumber(C.SessionStartBaseDuration)
    if base == nil or base <= 0 then
        error("SessionExplode.durationMultiplier: C.SessionStartBaseDuration must be a positive number of seconds")
    end
    if songDuration == nil then
        songDuration = SessionExplode.resolveAnimationData().songDuration
    end
    if type(songDuration) ~= "number" or songDuration <= 0 then
        error("SessionExplode.durationMultiplier: songDuration must be a positive number of seconds")
    end
    return songDuration / base
end

--- Wall-clock seconds the Play-enter chain should wait after play() is started.
-- @param songDuration number|nil
-- @return number
function SessionExplode.sequenceDurationSec(songDuration)
    local mul = SessionExplode.durationMultiplier(songDuration)
    return (DELAY_TIME * 5) * mul + AFTER_TITLE_WAIT * mul + HIDE_SETTLE
end

--- Attribute-path scale factor so song end matches splash end (TEST BED runIntroSequence).
-- @param songDuration number|nil
-- @return number
function SessionExplode.attributeTimeRatio(songDuration)
    if songDuration == nil then
        songDuration = SessionExplode.resolveAnimationData().songDuration
    end
    if type(songDuration) ~= "number" or songDuration <= 0 then
        error("SessionExplode.attributeTimeRatio: songDuration must be a positive number of seconds")
    end
    local scalableSongWindow = (ATTRIBUTE_UNSCALED_FULL_DURATION - ATTRIBUTE_SONG_START_DELAY)
        - ATTRIBUTE_UNSCALABLE_TIME
    if scalableSongWindow <= 0 then
        error("SessionExplode.attributeTimeRatio: scalable song window must be > 0")
    end
    if songDuration < ATTRIBUTE_UNSCALABLE_TIME then
        error(
            "SessionExplode.attributeTimeRatio: songDuration ("
                .. tostring(songDuration)
                .. ") is shorter than unscalableTime ("
                .. tostring(ATTRIBUTE_UNSCALABLE_TIME)
                .. "); cannot align ends by scaling"
        )
    end
    return (songDuration - ATTRIBUTE_UNSCALABLE_TIME) / scalableSongWindow
end

--- Scaled delay from splash start until Music C (ATTRIBUTE_SONG_START_DELAY * timeRatio).
-- @param songDuration number|nil
-- @return number
function SessionExplode.attributeSongLeadInSec(songDuration)
    return ATTRIBUTE_SONG_START_DELAY * SessionExplode.attributeTimeRatio(songDuration)
end

--- Start TR_Loop fading out across the scaled song lead-in so it reaches
--- silence when Music C starts.
-- @param songDuration number|nil
function SessionExplode.fadeIntermissionLoopForAttributeIntro(songDuration)
    local fadeSeconds = SessionExplode.attributeSongLeadInSec(songDuration)
    local Soundscape = require("core.soundscape")
    local okStop, stopMsg = Soundscape.stopFeaturedMusic({
        fadeSeconds = fadeSeconds,
        resumeBackground = false,
    })
    if okStop ~= true then
        U.AlertGM("Session start Loop fade-out: " .. tostring(stopMsg or "stopFeaturedMusic failed"))
    end
end

--- Wall-clock seconds Play-enter should wait after playAttribute() is started.
-- Covers splash end (song-aligned) plus the overlay hide settle.
-- @param songDuration number|nil
-- @return number
function SessionExplode.attributeSequenceDurationSec(songDuration)
    local timeRatio = SessionExplode.attributeTimeRatio(songDuration)
    local animEnds = ATTRIBUTE_UNSCALABLE_TIME
        + timeRatio * (ATTRIBUTE_UNSCALED_FULL_DURATION - ATTRIBUTE_UNSCALABLE_TIME)
    return animEnds + ATTRIBUTE_HIDE_OVERLAY_SETTLE_SEC
end

--- Longer of lerp / attribute waits — Advance chain maxWait must cover either path.
-- @return number
function SessionExplode.maxPlayEnterWaitSec()
    return math.max(
        SessionExplode.sequenceDurationSec(),
        SessionExplode.attributeSequenceDurationSec()
    )
end

--- Waver then scale-and-fade one XmlUI image.
-- @param id string XmlUI element id
-- @param config table|nil Keys: waverTime, scaleTime, waverLimit, waverSpeed, fadeOutRatio, fadeInTime, startDelay, scaleEase, songDuration
function SessionExplode.explodeImage(id, config)
    if type(id) ~= "string" or id == "" then
        error("SessionExplode.explodeImage: id must be a non-empty string")
    end
    if config == nil then
        config = {}
    end
    if type(config) ~= "table" then
        error("SessionExplode.explodeImage: config must be a table")
    end

    local waverTime = config.waverTime
    if waverTime == nil then
        waverTime = PAIR_WAVER_TIME
    end
    local scaleTime = config.scaleTime
    if scaleTime == nil then
        scaleTime = PAIR_SCALE_TIME
    end
    local waverLimit = config.waverLimit
    if waverLimit == nil then
        waverLimit = DEFAULT_WAVER_LIMIT
    end
    local waverSpeed = config.waverSpeed
    if waverSpeed == nil then
        waverSpeed = DEFAULT_WAVER_SPEED
    end
    local fadeOutRatio = config.fadeOutRatio
    if fadeOutRatio == nil then
        fadeOutRatio = 0
    end
    local fadeInTime = config.fadeInTime
    if fadeInTime == nil then
        fadeInTime = 0
    end
    local startDelay = config.startDelay
    if startDelay == nil then
        startDelay = 0
    end
    local scaleEase = config.scaleEase
    if scaleEase == nil then
        scaleEase = DEFAULT_SCALE_EASE
    end
    local songDuration = config.songDuration
    if songDuration == nil then
        songDuration = SessionExplode.resolveAnimationData().songDuration
    end

    if type(songDuration) ~= "number" or songDuration <= 0 then
        error("SessionExplode.explodeImage: songDuration must be a positive number of seconds")
    end
    local durationMultiplier = SessionExplode.durationMultiplier(songDuration)

    if type(waverTime) ~= "number" or waverTime < 0 then
        error("SessionExplode.explodeImage: waverTime must be 0 or a positive number of seconds")
    end
    waverTime = waverTime * durationMultiplier
    if type(scaleTime) ~= "number" or scaleTime <= 0 then
        error("SessionExplode.explodeImage: scaleTime must be a positive number of seconds")
    end
    scaleTime = scaleTime * durationMultiplier
    if type(waverLimit) ~= "number" or waverLimit < 0 then
        error("SessionExplode.explodeImage: waverLimit must be 0 or a positive pixel distance")
    end
    if type(waverSpeed) ~= "number" or waverSpeed <= 0 then
        error("SessionExplode.explodeImage: waverSpeed must be a positive number")
    end
    if type(fadeOutRatio) ~= "number" or fadeOutRatio < 0 or fadeOutRatio > 1 then
        error("SessionExplode.explodeImage: fadeOutRatio must be a number between 0 and 1")
    end
    if type(fadeInTime) ~= "number" or fadeInTime < 0 then
        error("SessionExplode.explodeImage: fadeInTime must be 0 or a positive number of seconds")
    end
    fadeInTime = fadeInTime * durationMultiplier
    if type(startDelay) ~= "number" or startDelay < 0 then
        error("SessionExplode.explodeImage: startDelay must be 0 or a positive number of seconds")
    end
    startDelay = startDelay * durationMultiplier
    if type(scaleEase) ~= "string" or scaleEase == "" then
        error("SessionExplode.explodeImage: scaleEase must be a non-empty ease name (e.g. \"powerIn\", \"powerOut\")")
    end
    if type(U.Lerp) ~= "function" or type(U.chain) ~= "function" then
        error("SessionExplode.explodeImage: U.Lerp / U.chain are not loaded")
    end

    local origWaver = waverTime
    local origScale = scaleTime
    local totalTime = origWaver + origScale
    if startDelay > totalTime then
        error("SessionExplode.explodeImage: startDelay cannot exceed waverTime + scaleTime (" .. tostring(totalTime) .. "s)")
    end
    if startDelay <= waverTime then
        waverTime = waverTime - startDelay
    else
        local scaleEat = startDelay - waverTime
        waverTime = 0
        scaleTime = scaleTime - scaleEat
    end

    local function fadeInAlpha(elapsed)
        if fadeInTime <= 0 then
            return 1
        end
        local a = elapsed / fadeInTime
        if a > 1 then
            return 1
        end
        if a < 0 then
            return 0
        end
        return a
    end

    -- tScale is nil during waver (fade-out is relative to the scale phase only).
    local function fadeOutAlpha(tScale)
        if tScale == nil then
            return 1
        end
        if fadeOutRatio >= 1 then
            return 1
        end
        if tScale <= fadeOutRatio then
            return 1
        end
        return 1 - (tScale - fadeOutRatio) / (1 - fadeOutRatio)
    end

    local function displayAlpha(elapsed, tScale)
        return fadeInAlpha(elapsed) * fadeOutAlpha(tScale)
    end

    local waverUnit
    if waverLimit > 0 then
        local octaves = {}
        local axSum = 0
        local aySum = 0
        local ampLo = { 0.75, 0.25 }
        for i = 1, 2 do
            local ax = ampLo[i] * randRange(0.85, 1.15)
            local ay = ampLo[i] * randRange(0.85, 1.15)
            axSum = axSum + ax
            aySum = aySum + ay
            local speedMul = 1 + (i - 1) * 0.6
            octaves[i] = {
                ax = ax,
                ay = ay,
                wx = randRange(0.7, 1.1) * waverSpeed * speedMul,
                wy = randRange(0.7, 1.1) * waverSpeed * speedMul,
                px = randRange(0, math.pi * 2),
                py = randRange(0, math.pi * 2),
            }
        end
        for i = 1, 2 do
            octaves[i].ax = octaves[i].ax / axSum
            octaves[i].ay = octaves[i].ay / aySum
        end
        waverUnit = function(seconds)
            local x = 0
            local y = 0
            for i = 1, 2 do
                local o = octaves[i]
                x = x + o.ax * math.sin(seconds * o.wx + o.px)
                y = y + o.ay * math.sin(seconds * o.wy + o.py)
            end
            return x, y
        end
    end

    -- Peak offset is the slowest point (velocity 0). Start a quarter-cycle later:
    -- near the zero crossing, already moving at full speed.
    local waverT0 = 0
    if waverUnit ~= nil then
        local bestMag = -1
        local tPeak = 0
        local sampleSpan = (math.pi * 2) / waverSpeed
        for i = 0, 32 do
            local t = (i / 32) * sampleSpan
            local x, y = waverUnit(t)
            local mag = x * x + y * y
            if mag > bestMag then
                bestMag = mag
                tPeak = t
            end
        end
        waverT0 = tPeak + 0.25 * sampleSpan
    end

    explodeGenById[id] = (explodeGenById[id] or 0) + 1
    local gen = explodeGenById[id]

    local lastX = 0
    local lastY = 0
    local startAlpha = 1
    if fadeInTime > 0 then
        startAlpha = 0
    end

    -- Cover explode has no delay/waver: fold the reset into the scale lerp's first (sync)
    -- chain step so U.Lerp starts in the same tick as explodeImage(), not after `return 0`
    -- (numeric 0 still goes through chainWait / a nested coroutine — TOR-533).
    local combineSetupWithScale = startDelay <= 0 and waverTime <= 0 and scaleTime > 0

    local function applyStartAttrs()
        U.setAttributes(id, {
            active = "true",
            color = string.format("rgba(1, 1, 1, %.4f)", startAlpha),
            scale = "1",
            offsetXY = "0 0",
        })
    end

    local steps = {}
    if not combineSetupWithScale then
        table.insert(steps, function()
            applyStartAttrs()
            return 0
        end)
    end

    if startDelay > 0 then
        table.insert(steps, function()
            local holdAlpha = startAlpha
            return U.Lerp(function()
                if not stillCurrent(id, gen) then
                    return
                end
                U.setAttributes(id, {
                    color = string.format("rgba(1, 1, 1, %.4f)", holdAlpha),
                    scale = "1",
                    offsetXY = "0 0",
                })
            end, 0, 1, startDelay, false, "linear")
        end)
    end

    if waverTime > 0 then
        if waverLimit > 0 or fadeInTime > 0 then
            table.insert(steps, function()
                if waverLimit > 0 then
                    local ux, uy = waverUnit(waverT0)
                    lastX = clampWaver(waverLimit, ux * waverLimit)
                    lastY = clampWaver(waverLimit, uy * waverLimit)
                    U.setAttribute(id, "offsetXY", string.format("%.2f %.2f", lastX, lastY))
                end
                return 0
            end)
            table.insert(steps, function()
                return U.Lerp(function(rawT)
                    if not stillCurrent(id, gen) then
                        return
                    end
                    local elapsed = rawT * waverTime
                    if waverLimit > 0 then
                        local ux, uy = waverUnit(elapsed + waverT0)
                        lastX = clampWaver(waverLimit, ux * waverLimit)
                        lastY = clampWaver(waverLimit, uy * waverLimit)
                    end
                    U.setAttributes(id, {
                        offsetXY = string.format("%.2f %.2f", lastX, lastY),
                        color = string.format("rgba(1, 1, 1, %.4f)", displayAlpha(elapsed, nil)),
                    })
                end, 0, 1, waverTime, false, "linear")
            end)
        else
            table.insert(steps, function()
                return waverTime
            end)
        end
    end

    if scaleTime > 0 then
        table.insert(steps, function()
            if combineSetupWithScale then
                applyStartAttrs()
            end
            return U.Lerp(function(t)
                if not stillCurrent(id, gen) then
                    return
                end
                local elapsed = waverTime + t * scaleTime
                local scale = 1 + t * (SCALE_END - 1)
                local x = lastX * (1 - t)
                local y = lastY * (1 - t)
                U.setAttributes(id, {
                    scale = string.format("%.4f", scale),
                    color = string.format("rgba(1, 1, 1, %.4f)", displayAlpha(elapsed, t)),
                    offsetXY = string.format("%.2f %.2f", x, y),
                })
            end, 0, 1, scaleTime, false, scaleEase)
        end)
    end

    table.insert(steps, function()
        if not stillCurrent(id, gen) then
            return
        end
        local endAlpha = displayAlpha(waverTime + scaleTime, 1)
        U.setAttributes(id, {
            scale = tostring(SCALE_END),
            color = string.format("rgba(1, 1, 1, %.4f)", endAlpha),
            offsetXY = "0 0",
        })
    end)

    U.chain(steps, { maxWait = math.max(60, origWaver + origScale + 5) })
end

local function explodePair(index, songDuration)
    SessionExplode.explodeImage("overlay_characterIntroImage_" .. tostring(index), {
        waverTime = PAIR_WAVER_TIME,
        scaleTime = PAIR_SCALE_TIME,
        waverSpeed = PAIR_WAVER_SPEED,
        songDuration = songDuration,
    })
    SessionExplode.explodeImage("overlay_characterIntroCaption_" .. tostring(index), {
        waverTime = PAIR_WAVER_TIME,
        scaleTime = PAIR_SCALE_TIME,
        waverLimit = 0,
        startDelay = DELAY_TIME * TEXT_DELAY_RATIO,
        fadeInTime = TEXT_FADE_IN,
        songDuration = songDuration,
    })
end

--- Start the Intermission→Play explode. Returns immediately; wait sequenceDurationSec() on the caller.
-- @return number sequenceDurationSec
function SessionExplode.play()
    local anim = SessionExplode.resolveAnimationData()
    local songDuration = anim.songDuration
    local mul = SessionExplode.durationMultiplier(songDuration)
    local delayTime = DELAY_TIME * mul
    local afterTitleWait = AFTER_TITLE_WAIT * mul
    local waitSec = SessionExplode.sequenceDurationSec(songDuration)

    sequenceGen = sequenceGen + 1
    local gen = sequenceGen
    for id, idGen in pairs(explodeGenById) do
        explodeGenById[id] = idGen + 1
    end
    SessionExplode.resetLayers()
    -- Cover lerp starts here (same tick as play()) so Play enter can fire the sting
    -- immediately after, on the opening drum (TOR-533).
    SessionExplode.explodeImage(COVER_ID, {
        waverTime = 0,
        scaleTime = COVER_SCALE_DUR,
        songDuration = songDuration,
    })

    U.chain({
        function()
            if sequenceGen ~= gen then
                return
            end
            explodePair(1, songDuration)
            return delayTime
        end,
        function()
            if sequenceGen ~= gen then
                return
            end
            explodePair(2, songDuration)
            return delayTime
        end,
        function()
            if sequenceGen ~= gen then
                return
            end
            explodePair(3, songDuration)
            return delayTime
        end,
        function()
            if sequenceGen ~= gen then
                return
            end
            explodePair(4, songDuration)
            return delayTime
        end,
        function()
            if sequenceGen ~= gen then
                return
            end
            explodePair(5, songDuration)
            return delayTime
        end,
        function()
            if sequenceGen ~= gen then
                return
            end
            SessionExplode.explodeImage(SESSION_NUMBER_ID, {
                waverTime = 0,
                scaleTime = SESSION_NUM_SCALE_DUR,
                waverLimit = 0,
                scaleEase = "linear",
                fadeOutRatio = 0.55,
                songDuration = songDuration,
            })
            return 0
        end,
        function()
            if sequenceGen ~= gen then
                return
            end
            SessionExplode.explodeImage(SESSION_TITLE_ID, {
                waverTime = 0,
                scaleTime = SESSION_TITLE_SCALE_DUR,
                waverLimit = 0,
                songDuration = songDuration,
            })
            return afterTitleWait
        end,
        function()
            if sequenceGen ~= gen then
                return
            end
            hideGlobalPanel()
            return HIDE_SETTLE
        end,
        function()
            if sequenceGen ~= gen then
                return
            end
            SessionExplode.resetLayers()
        end,
    }, { maxWait = math.max(60, waitSec + 5) })

    return waitSec
end

local function fireAttributeSessionIntroAudio()
    local Soundscape = require("core.soundscape")
    local anim = SessionExplode.resolveAnimationData()
    local okPlay, playMsg = Soundscape.playSessionIntro(anim.introKey, { fadeSeconds = 0 })
    if okPlay ~= true then
        U.AlertGM("Session start overture: " .. tostring(playMsg or "playSessionIntro failed"))
    end
    if type(Soundscape.commitEagerSteadyState) == "function" then
        Soundscape.commitEagerSteadyState(okPlay == true)
    end
end

local function attributeStillCurrent(gen)
    return sequenceGen == gen
end

local function attributeChainMaxWait(waitSec)
    return math.max(60, waitSec + 5)
end

--- Session number (suffix 6) / title (suffix 7). Number/title tail uses timeRatio 1.
local function runNumTitleSequence(gen, sequencePrefix, sequenceSuffix, numTitleTimeRatio, waitSec)
    if numTitleTimeRatio == nil then
        numTitleTimeRatio = 1
    end
    local numTitleSequenceDuration = 10 * numTitleTimeRatio

    local containerPanelID = sequencePrefix .. "Panel_" .. sequenceSuffix
    local bgPanel1ID = sequencePrefix .. "BgPanel_1"
    local bgImage1ID = sequencePrefix .. "Bg_1"
    local imagePanelID = sequencePrefix .. "ImagePanel_" .. sequenceSuffix
    local imageID = sequencePrefix .. "_" .. sequenceSuffix

    U.setAttributes("overlay_sessionNumberBg_1", { image = "overlay_globalBlindfold_17", active = "true" })
    U.setAttributes("overlay_sessionTitleBg_1", { image = "overlay_globalBlindfold_20", active = "true" })

    U.setAttributes(containerPanelID, {
        color = "rgba(0, 0, 0, 0)",
        scale = "3",
        active = "true",
        hideAnimation = "Shrink",
        animationDuration = numTitleSequenceDuration * 16,
    })

    U.setAttributes(bgPanel1ID, {
        color = "rgba(0, 0, 0, 0)",
        scale = "4",
        showAnimation = "Grow",
        animationDuration = numTitleSequenceDuration * 2,
    })
    U.setAttributes(bgImage1ID, {
        scale = "2",
        showAnimation = "FadeIn",
        hideAnimation = "FadeOut",
        animationDuration = 1 * numTitleTimeRatio,
        showAnimationDelay = 0.15 * numTitleSequenceDuration,
    })

    U.setAttributes(imagePanelID, {
        color = "rgba(0, 0, 0, 0)",
        scale = "1",
        showAnimation = "Grow",
        animationDuration = numTitleSequenceDuration * 2,
    })
    U.setAttributes(imageID, {
        active = "true",
        scale = "1",
        showAnimation = "FadeIn",
        hideAnimation = "FadeOut",
        animationDuration = 2 * numTitleTimeRatio,
        showAnimationDelay = 0.1 * numTitleSequenceDuration,
    })

    U.chain({
        function()
            if not attributeStillCurrent(gen) then
                return 0
            end
            UI.show(bgPanel1ID)
            UI.show(imagePanelID)
            return 0.8 * numTitleSequenceDuration * numTitleTimeRatio
        end,
        function()
            if not attributeStillCurrent(gen) then
                return 0
            end
            UI.hide(bgImage1ID)
            UI.hide(imageID)
            return 2.5 * numTitleTimeRatio
        end,
        function()
            if not attributeStillCurrent(gen) then
                return 0
            end
            if sequenceSuffix == "7" then
                hideGlobalPanel()
            end
            return ATTRIBUTE_HIDE_OVERLAY_SETTLE_SEC
        end,
        function()
            if not attributeStillCurrent(gen) then
                return 0
            end
            if sequenceSuffix == "7" then
                SessionExplode.resetLayers()
            end
            return 0
        end,
    }, { maxWait = attributeChainMaxWait(waitSec) })
end

local function runCharacterSequence(gen, sequenceNumber, timeRatio, waitSec)
    local textPanelID = "overlay_characterIntroCaptionPanel_" .. sequenceNumber
    local imagePanelID = "overlay_characterIntroImagePanel_" .. sequenceNumber
    local textID = "overlay_characterIntroCaption_" .. sequenceNumber
    local imageID = "overlay_characterIntroImage_" .. sequenceNumber
    local textPanelData = CHARACTER_TEXT_PANEL_DATA[sequenceNumber]
    if type(textPanelData) ~= "table" then
        error("SessionExplode.runCharacterSequence: missing panel data for sequence " .. tostring(sequenceNumber))
    end

    U.setAttributes(textPanelID, {
        active = "false",
        showAnimation = textPanelData.showAnimation,
        animationDuration = 60 * timeRatio,
    })
    U.setAttributes(textID, {
        active = "true",
        showAnimation = "FadeIn",
        showAnimationDelay = 34 * timeRatio,
        animationDuration = 4,
        hideAnimation = "FadeOut",
        hideAnimationDelay = 0,
        offsetXY = textPanelData.offsetXY,
        scale = textPanelData.scale,
    })
    U.setAttributes(imagePanelID, {
        active = "false",
        showAnimation = "Grow",
        animationDuration = 35 * timeRatio,
    })
    U.setAttributes(imageID, {
        active = "true",
        showAnimation = "FadeIn",
        showAnimationDelay = 27 * timeRatio,
        animationDuration = 0.5,
        scale = "1",
        hideAnimationDelay = 1.5,
        hideAnimation = "FadeOut",
    })

    if sequenceNumber == 1 then
        U.setAttributes(FRAME_PANEL_ID, {
            active = "false",
            showAnimation = "FadeIn",
            animationDuration = 0.5,
            showAnimationDelay = 27 * timeRatio,
        })
        U.setAttributes("overlay_sessionSplashFrame", { active = "true" })
    end

    U.chain({
        function()
            if not attributeStillCurrent(gen) then
                return 0
            end
            UI.show(textPanelID)
            UI.show(imagePanelID)
            if sequenceNumber == 1 then
                UI.show(FRAME_PANEL_ID)
                U.await(function()
                    if not attributeStillCurrent(gen) then
                        return
                    end
                    fireAttributeSessionIntroAudio()
                end, ATTRIBUTE_SONG_START_DELAY * timeRatio)
            end
            return 39 * timeRatio
        end,
        function()
            if not attributeStillCurrent(gen) then
                return 0
            end
            UI.hide(textID)
            return 6 * timeRatio
        end,
        function()
            if not attributeStillCurrent(gen) then
                return 0
            end
            U.setAttributes(imagePanelID, { color = "#000000" })
            UI.hide(imageID)
            if sequenceNumber == 5 then
                U.chain({
                    function()
                        if not attributeStillCurrent(gen) then
                            return 0
                        end
                        runNumTitleSequence(gen, "overlay_sessionNumber", "6", 1, waitSec)
                        U.setAttributes("overlay_sessionSplashFrame", { active = "false" })
                        return 5
                    end,
                    function()
                        if not attributeStillCurrent(gen) then
                            return 0
                        end
                        runNumTitleSequence(gen, "overlay_sessionTitle", "7", 1, waitSec)
                        return 0
                    end,
                }, { maxWait = attributeChainMaxWait(waitSec) })
            end
            return 0
        end,
    }, { maxWait = attributeChainMaxWait(waitSec) })
end

local function runAttributeSequences(gen, timeRatio, waitSec)
    local characterSequenceDuration = ATTRIBUTE_CHARACTER_SEQUENCE_DURATION * timeRatio
    local chainFunctions = {}
    for sequenceNumber = 1, 5 do
        table.insert(chainFunctions, function()
            if not attributeStillCurrent(gen) then
                return 0
            end
            runCharacterSequence(gen, sequenceNumber, timeRatio, waitSec)
            return characterSequenceDuration
        end)
    end
    U.chain(chainFunctions, { maxWait = attributeChainMaxWait(waitSec) })
end

--- Start the TTS-attribute Intermission→Play animation (TEST BED runIntroSequence).
--- Starts fading TR_Loop immediately across the scaled song lead-in, and plays
--- Music C when that lead-in ends (pair 1).
--- Returns immediately; wait attributeSequenceDurationSec().
-- @param songDuration number|nil
-- @return number attributeSequenceDurationSec
function SessionExplode.playAttribute(songDuration)
    if songDuration == nil then
        songDuration = SessionExplode.resolveAnimationData().songDuration
    end
    local timeRatio = SessionExplode.attributeTimeRatio(songDuration)
    local waitSec = SessionExplode.attributeSequenceDurationSec(songDuration)

    sequenceGen = sequenceGen + 1
    local gen = sequenceGen
    for id, idGen in pairs(explodeGenById) do
        explodeGenById[id] = idGen + 1
    end

    U.setAttributes(PANEL_ID, { active = "true" })
    SessionExplode.fadeIntermissionLoopForAttributeIntro(songDuration)
    runAttributeSequences(gen, timeRatio, waitSec)
    return waitSec
end

return SessionExplode
